Ragebot.Runtime.AutoDelayValue = nil
Ragebot.Runtime.AutoDelayRate = nil
Ragebot.Runtime.AutoDelayProfileKey = nil

function Ragebot.NormalizeShotDelay(Value)
    Value = tonumber(Value) or 0.03
    return Clamp(Floor(Value * 100 + 0.5) / 100, tonumber(Ragebot.ManualDelayMin) or 0, tonumber(Ragebot.ManualDelayMax) or 100)
end

function Ragebot.NormalizeAutoShotDelay(Value)
    Value = tonumber(Value) or 0.03
    return Clamp(Floor(Value * 1000 + 0.5) / 1000, tonumber(Ragebot.AutoDelayMin) or 0, tonumber(Ragebot.AutoDelayMax) or 0.50)
end

function Ragebot.GetDelayTool(Tool)
    if Tool and Tool.Parent and Ragebot.IsGun(Tool) then
        return Tool
    end
    local State = Ragebot.Runtime and Ragebot.Runtime.FireState
    local StateTool = type(State) == "table" and State.Tool or nil
    if StateTool and StateTool.Parent and Ragebot.IsGun(StateTool) then
        return StateTool
    end
    local Character = LocalPlayer.Character
    local Equipped = Character and Character:FindFirstChildOfClass("Tool")
    if Equipped and Ragebot.IsGun(Equipped) then
        return Equipped
    end
    return nil
end

function Ragebot.GetOriginalWeaponConfig(Tool)
    Tool = Ragebot.GetDelayTool(Tool)
    if not Tool then return nil end
    local Module = Tool:FindFirstChild("Config")
    if not Module or not Module:IsA("ModuleScript") then return nil end
    local Success, Config = Shared.SafeCall(require, Module)
    if not Success or type(Config) ~= "table" then return nil end
    RegisterAtramentaWeaponConfigSource(Config)
    return Config
end

function Ragebot.GetAutoDelayWeaponKey(Tool, Config)
    local Name = type(Config) == "table" and rawget(Config, "Name") or nil
    if type(Name) ~= "string" or Name == "" then Name = Tool and Tool.Name or "" end
    return Lower(tostring(Name)):gsub("[^%w]", "")
end

function Ragebot.GetStaticAutoDelayProfile(Tool)
    Tool = Ragebot.GetDelayTool(Tool)
    if not Tool then return nil, nil end
    local Config = Ragebot.GetOriginalWeaponConfig(Tool)
    local Key = Ragebot.GetAutoDelayWeaponKey(Tool, Config)
    local ProfileName = Ragebot.AutoDelayProfileKeys and Ragebot.AutoDelayProfileKeys[Key] or nil
    local ProfileDelay = ProfileName and Ragebot.AutoDelayProfiles and Ragebot.AutoDelayProfiles[ProfileName] or nil
    if type(ProfileDelay) ~= "number" then
        return nil, Key
    end
    return Ragebot.NormalizeAutoShotDelay(ProfileDelay), ProfileName
end

function Ragebot.GetAutoShotDelay(Tool)
    Tool = Ragebot.GetDelayTool(Tool)
    local Manual = Ragebot.NormalizeShotDelay(Ragebot.Settings.Delay)
    if not Tool then return Manual end
    local AutoDelay, Key = Ragebot.GetStaticAutoDelayProfile(Tool)
    Ragebot.Runtime.AutoDelayTool = Tool
    Ragebot.Runtime.AutoDelayProfileKey = Key
    Ragebot.Runtime.AutoDelayRate = nil
    if type(AutoDelay) ~= "number" then
        Ragebot.Runtime.AutoDelayValue = Manual
        return Manual
    end
    Ragebot.Runtime.AutoDelayValue = AutoDelay
    return AutoDelay
end

function Ragebot.GetShotDelay(Tool)
    if Ragebot.Settings.AutoDelay == true then
        return Ragebot.GetAutoShotDelay(Tool)
    end
    return Ragebot.NormalizeShotDelay(Ragebot.Settings.Delay)
end

function Ragebot.GetEffectiveShotInterval(Tool)
    return Max(Ragebot.GetShotDelay(Tool), tonumber(Ragebot.MinShotInterval) or (1 / 240))
end

function Ragebot.GetShotRate(Tool)
    local Interval = Ragebot.GetEffectiveShotInterval(Tool)
    if Interval <= 0 then return 240 end
    return Clamp(1 / Interval, 1 / Max(tonumber(Ragebot.ManualDelayMax) or 100, 1), 240)
end

function Ragebot.InvalidateAutoDelay(Tool)
    if Tool == nil or Ragebot.Runtime.AutoDelayTool == Tool then
        Ragebot.Runtime.AutoDelayTool = nil
        Ragebot.Runtime.AutoDelayValue = nil
        Ragebot.Runtime.AutoDelayRate = nil
        Ragebot.Runtime.AutoDelayProfileKey = nil
    end
end

function Ragebot.SetAutoDelayEnabled(Value)
    Ragebot.Settings.AutoDelay = Value == true
    Ragebot.InvalidateAutoDelay()
    Ragebot.ResetFireTimer()
    local Tool = Ragebot.GetDelayTool()
    if Tool then Ragebot.ApplyFireRate(Tool) end
    return Ragebot.Settings.AutoDelay
end

function Ragebot.GetFireState()
    local State = Ragebot.Runtime.FireState
    if type(State) ~= "table" then
        State = {Revision = 8, Generation = 0, Running = false, PendingShot = nil, Tool = nil, Target = nil, LastFireAt = 0, NextFireAt = 0, LastInterval = nil}
        Ragebot.Runtime.FireState = State
    end
    State.Revision = 9
    State.Generation = tonumber(State.Generation) or 0
    State.LastFireAt = tonumber(State.LastFireAt) or 0
    State.NextFireAt = tonumber(State.NextFireAt) or 0
    return State
end

function Ragebot.StopFireLoop(ResetClock)
    local State = Ragebot.GetFireState()
    State.Generation += 1
    State.Running = false
    State.PendingShot = nil
    State.Tool = nil
    State.Target = nil
    State.LastInterval = nil
    if ResetClock == true then
        State.LastFireAt = 0
        State.NextFireAt = 0
    end
end

function Ragebot.ResetFireTimer()
    local State = Ragebot.GetFireState()
    local Interval = Ragebot.GetEffectiveShotInterval()
    local Now = Clock()
    State.LastInterval = Interval
    if State.LastFireAt > 0 then
        State.NextFireAt = Max(Now, State.LastFireAt + Interval)
    else
        State.NextFireAt = Now
    end
end

function Ragebot.SetShotDelay(Value)
    local ShotDelay = Ragebot.NormalizeShotDelay(Value)
    Ragebot.Settings.Delay = ShotDelay
    Ragebot.Settings.ShotDelay = ShotDelay
    Ragebot.InvalidateAutoDelay()
    Ragebot.ResetFireTimer()
    local Character = LocalPlayer.Character
    local Tool = Character and Character:FindFirstChildOfClass("Tool")
    if Ragebot.IsGun(Tool) then Ragebot.ApplyFireRate(Tool) end
    return ShotDelay
end

function Ragebot.GetQueuedShot(SeedShot)
    if type(SeedShot) ~= "table" or not SeedShot.Target or not SeedShot.Target.Character then
        return nil
    end
    if not IsCombatTargetAllowed(SeedShot.Target) then
        return nil
    end
    return SeedShot
end

function Ragebot.ValidateShotRoute(Shot, FromPosition, ToPosition, LocalCharacter, TargetCharacter)
    if type(Shot) ~= "table" or typeof(FromPosition) ~= "Vector3" or typeof(ToPosition) ~= "Vector3" then
        return false
    end
    if Shot.Direct == true or Shot.TPHit == true then
        return Ragebot.IsDirectShotClear(FromPosition, ToPosition, TargetCharacter) == true
    end
    if Shot.Wallbang == true or Shot.MatrixWallbang == true or Shot.MatrixRoute
            == true then
        local IgnoreList = Ragebot.GetWallbangWorldIgnoreList(LocalCharacter, TargetCharacter)
        return Ragebot.ValidateWallbangCandidate(FromPosition, ToPosition, IgnoreList) == true
    end
    return false
end

function Ragebot.StartFireLoop()
    local State = Ragebot.GetFireState()
    if State.Running == true then
        return true
    end
    State.Generation += 1
    local Generation = State.Generation
    State.Running = true
    if State.NextFireAt <= 0 then State.NextFireAt = Clock() end
    Spawn(
        function()
            while Ragebot.Enabled == true and State.Generation
                    == Generation do
                local SeedShot = State.PendingShot
                local Tool = State.Tool
                if type(SeedShot) ~= "table" or not Tool or not Tool.Parent or not Ragebot.IsGun(Tool) then
                    break
                end
                local Target = SeedShot.Target
                if not Target or State.Target ~= Target or not Target.Parent or not Target.Character or not IsCombatTargetAllowed(Target) then
                    break
                end
                local ServerAmmo = Ragebot.GetServerAmmoValue(Tool)
                if type(ServerAmmo) == "number" and ServerAmmo <= 0 then
                    if Ragebot.Settings.AutoReload
                        == true then
                        Ragebot.RequestReload(Tool, true)
                    end
                    State.PendingShot = nil
                    break
                end
                local Interval = Ragebot.GetEffectiveShotInterval(Tool)
                if type(State.LastInterval) ~= "number" or Abs(State.LastInterval - Interval) > 0.000001 then
                    State.LastInterval = Interval
                    if State.LastFireAt > 0 then
                        State.NextFireAt = Max(Clock(), State.LastFireAt + Interval)
                    elseif State.NextFireAt <= 0 then
                        State.NextFireAt = Clock()
                    end
                end
                local Now = Clock()
                if Now < State.NextFireAt then
                    RunService.Heartbeat:Wait()
                    continue
                end
                local DueCount = 1
                for _ = 1, DueCount do
                    if Ragebot.Enabled ~= true or State.Generation
                            ~= Generation then
                        break
                    end
                    local LiveSeed = State.PendingShot
                    if type(LiveSeed)
                        ~= "table" or LiveSeed.Target
                            ~= State.Target then
                        break
                    end
                    local LiveShot = Ragebot.GetQueuedShot(LiveSeed)
                    if not LiveShot then
                        State.PendingShot = nil
                        break
                    end
                    Ragebot.Runtime.ActiveShot = LiveShot
                    local Fired = Ragebot.Fire({Shot = LiveShot, SuppressAutoReload = true}) == true
                    if not Fired then
                        State.PendingShot = nil
                        break
                    end
                    local SentAt = tonumber(Ragebot.Runtime.LastShotAt) or Clock()
                    State.LastFireAt = SentAt
                    Interval = Ragebot.GetEffectiveShotInterval(Tool)
                    State.LastInterval = Interval
                    State.NextFireAt = SentAt + Interval
                    local RemainingAmmo = Ragebot.GetServerAmmoValue(Tool)
                    if type(RemainingAmmo) == "number" and RemainingAmmo <= 0 then
                        if Ragebot.Settings.AutoReload
                            == true then
                            Ragebot.RequestReload(Tool, true)
                        end
                        State.PendingShot = nil
                        break
                    end
                end
                if State.PendingShot == nil then
                    break
                end
                RunService.Heartbeat:Wait()
            end
            if State.Generation
                == Generation then
                State.Running = false
                if State.PendingShot
                    == nil then
                    State.Tool = nil
                    State.Target = nil
                end
                Ragebot.Runtime.ActiveShot = nil
            end
        end)
    return true
end

function Ragebot.QueueShot(Shot, Tool)
    if Ragebot.Enabled ~= true or type(Shot) ~= "table" or not Shot.Target or not Tool or not Ragebot.IsGun(Tool) then
        return false
    end
    local State = Ragebot.GetFireState()
    if Ragebot.Runtime.RateTool ~= Tool or (Ragebot.Settings.AutoDelay == true and Ragebot.Runtime.AutoDelayTool ~= Tool) then Ragebot.ApplyFireRate(Tool) end
    State.PendingShot = Shot
    State.Tool = Tool
    State.Target = Shot.Target
    if State.NextFireAt <= 0 then State.NextFireAt = Clock() end
    return Ragebot.StartFireLoop()
end

function Ragebot.GetTPHitShotInterval(Profile)

    return Max(Ragebot.GetEffectiveShotInterval(), Max(tonumber(Profile and Profile.ShotInterval) or 0.018, 0.008))
end

function Ragebot.GetTPHitDistanceProfile(WorldDistance)
    local Distance = Max(tonumber(WorldDistance) or 0, 0)
    local Far = Clamp(Distance / 800, 0, 1)
    return {WorldDistance = Distance, Far = Far, Radius = 3.15 + 1.15 * Far, Height = 0.12 + 0.32 * Far, PreHold = 0.040 + 0.045 * Far, ShotHold = 0.008 + 0.012 * Far,
        PostHold = 0.018 + 0.025 * Far, ReturnHold = 0.025 + 0.025 * Far, ShotInterval = 0.018 + 0.008 * Far, Pipeline = 1, AckTimeout = 0.11 + 0.09 * Far}
end
function Ragebot.GetTPHitOrbitCandidate(Target, TargetRoot, Angle, Profile)
    if not Target or not TargetRoot or not TargetRoot.Parent then return nil, nil end
    Profile = type(Profile) == "table" and Profile or Ragebot.GetTPHitDistanceProfile(0)
    local TargetPosition = Ragebot.GetRouteTargetPosition(Target, TargetRoot) or TargetRoot.Position
    local Radius = Max(tonumber(Profile.Radius) or 3.15, 1.5)
    local Height = tonumber(Profile.Height) or 0.12
    local A = tonumber(Angle) or 0
    local Position = TargetRoot.Position + NewVector3(Cos(A) * Radius, Height, Sin(A) * Radius)
    return Position, Ragebot.FindDirectShot(Position, Target, TargetPosition)
end
function Ragebot.UpdateTPHitOrbit(State, Target, TargetRoot, HoldPosition)
    if type(State) ~= "table" or not Target or not TargetRoot or not TargetRoot.Parent then return nil end
    local Origin = typeof(HoldPosition) == "Vector3" and HoldPosition or (State.Root and State.Root.Position)
    if typeof(Origin) ~= "Vector3" then return nil end
    local TargetPosition = Ragebot.GetRouteTargetPosition(Target, TargetRoot) or TargetRoot.Position
    return Ragebot.FindDirectShot(Origin, Target, TargetPosition)
end
function Ragebot.GetTPHitCandidate(Target, LocalRoot, TargetRoot, ClientPositionOverride)
    if not Target or not LocalRoot or not TargetRoot or not LocalRoot.Parent or not TargetRoot.Parent then return nil, nil, nil end
    local ClientPosition = typeof(ClientPositionOverride) == "Vector3" and ClientPositionOverride or LocalRoot.Position
    local WorldDistance = (ClientPosition - TargetRoot.Position).Magnitude
    local Profile = Ragebot.GetTPHitDistanceProfile(WorldDistance)
    Ragebot.Runtime.TPHitRouteCache = type(Ragebot.Runtime.TPHitRouteCache) == "table" and Ragebot.Runtime.TPHitRouteCache or setmetatable({}, {__mode = "k"})
    local Cache = Ragebot.Runtime.TPHitRouteCache[Target]
    local TargetPosition = Ragebot.GetRouteTargetPosition(Target, TargetRoot) or TargetRoot.Position
    if type(Cache) == "table" and typeof(Cache.Offset) == "Vector3" then
        local CachedPosition = TargetRoot.Position + Cache.Offset
        local CachedShot = Ragebot.FindDirectShot(CachedPosition, Target, TargetPosition)
        if CachedShot then return CachedPosition, CachedShot, Profile end
    end
    local Delta = ClientPosition - TargetRoot.Position
    local BaseAngle = Atan2(Delta.Z, Delta.X)
    local GoldenAngle = Pi * (3 - Sqrt(5))
    for Index = 0, 7 do
        local Position, Shot = Ragebot.GetTPHitOrbitCandidate(Target, TargetRoot, BaseAngle + Index * GoldenAngle, Profile)
        if Shot then
            Ragebot.Runtime.TPHitRouteCache[Target] = {Offset = Position - TargetRoot.Position, Time = Clock()}
            return Position, Shot, Profile
        end
    end
    return nil, nil, Profile
end
function Ragebot.RequestTPHitServerPublish(State, Value)
    if type(State) ~= "table" then return false end
    if typeof(Value) == "Vector3" then
        State.TeleportPosition = Value
        State.ActivePosition = Value
        State.ServerPosition = Value
        State.ShotOrigin = Value
    end
    if typeof(State.ServerPosition) ~= "Vector3" then return false end
    State.ServerPositionGeneration = (tonumber(State.ServerPositionGeneration) or 0) + 1
    State.ServerPacketPatched = false
    State.ServerPacketPatchFailed = false
    State.PendingPulseGeneration = State.ServerPositionGeneration
    State.PulseRepeatCount = 0
    State.PulseRepeatTarget = 2
    State.ServerPublishUntil = Clock() + 0.30
    return true
end

function Ragebot.ApplyTPHitTransform(State, Value)
    return Ragebot.RequestTPHitServerPublish(State, Value)
end

function Ragebot.WaitForTPHitServerPacket(State, Timeout, AliveCallback)
    if type(State) ~= "table" then return false end
    local WantedGeneration = tonumber(State.ServerPositionGeneration) or 0
    local Deadline = Clock() + Clamp(tonumber(Timeout) or 0.24, 0.05, 0.60)
    while Clock() < Deadline do
        if type(AliveCallback) == "function" and AliveCallback() ~= true then return false end
        if State.ServerPacketPatched == true and (tonumber(State.ServerPacketPatchedGeneration) or -1) >= WantedGeneration then
            return true
        end
        RunService.Heartbeat:Wait()
    end
    return State.ServerPacketPatched == true and (tonumber(State.ServerPacketPatchedGeneration) or -1) >= WantedGeneration
end

function Ragebot.HasTPHitNetworkOwnership(State)
    if type(State) ~= "table" then return false end
    local Root = State.Root
    local Character = State.Character or LocalPlayer.Character
    if not Root or not Root.Parent or Character ~= LocalPlayer.Character then return false end
    if Root:GetAttribute("NO_NETWORK_OWNER") == true then return false end
    if type(isnetworkowner) == "function" then
        local Success, Owned = Shared.SafeCall(isnetworkowner, Root)
        if Success and Owned == false then return false end
    end
    return true
end

function Ragebot.PrimeTPHitNetworkOwnership(State)
    return Ragebot.HasTPHitNetworkOwnership(State)
end

function Ragebot.SetTPHitNetworkSleeping(State, Sleeping)
    if type(State) ~= "table" then return false end
    local Root = State.Root
    if not Root or not Root.Parent or type(sethiddenproperty) ~= "function" then
        State.NetworkSleepSupported = false
        return false
    end
    local Success = Shared.SafeCall(sethiddenproperty, Root, "NetworkIsSleeping", Sleeping == true)
    if Success == true then
        State.NetworkSleepSupported = true
        State.NetworkSleeping = Sleeping == true
        return true
    end
    State.NetworkSleepSupported = false
    return false
end

function Ragebot.SetTPHitSenderRate(State, Value)
    if type(State) ~= "table" or type(setfflag) ~= "function" then return false end
    local Success = Shared.SafeCall(setfflag, "S2PhysicsSenderRate", tostring(Value))
    return Success == true
end

function Ragebot.CaptureTPHitNetworkState(State)
    if type(State) ~= "table" then return false end
    State.NetworkSleepSupported = type(sethiddenproperty) == "function"
    State.NetworkSleeping = false
    State.SenderRateSupported = type(setfflag) == "function"
    State.SenderRateOriginal = State.SenderRateSupported and "60" or nil
    if type(getfflag) == "function" then
        local Success, Value = Shared.SafeCall(getfflag, "S2PhysicsSenderRate")
        if Success then State.SenderRateOriginal = tostring(Value) end
    end
    State.NetworkOwned = Ragebot.HasTPHitNetworkOwnership(State)
    return State.NetworkOwned == true
end

function Ragebot.EnableTPHitMovementExemption(State)
    if type(State) ~= "table" then return false end
    local Character = State.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or not Humanoid.Parent then return false end
    State.Humanoid = Humanoid
    local HadCTP = false
    Shared.SafeCall(function() HadCTP = CollectionService:HasTag(Humanoid, "CTP") == true end)
    State.HadCTP = HadCTP
    if not HadCTP then
        local Added = Shared.SafeCall(CollectionService.AddTag, CollectionService, Humanoid, "CTP")
        State.AddedCTP = Added == true
    end
    local ExistingNWO = Humanoid:FindFirstChild("NWO")
    State.HadNWO = ExistingNWO ~= nil
    if not ExistingNWO then
        local Marker = NewInstance("BoolValue")
        Marker.Name = "NWO"
        Marker.Value = true
        Marker.Parent = Humanoid
        State.NWOMarker = Marker
    end
    return true
end

function Ragebot.DisableTPHitMovementExemption(State)
    if type(State) ~= "table" then return false end
    local Humanoid = State.Humanoid
    if State.NWOMarker and State.NWOMarker.Parent then State.NWOMarker:Destroy() end
    State.NWOMarker = nil
    if State.AddedCTP == true and Humanoid and Humanoid.Parent then Shared.SafeCall(CollectionService.RemoveTag, CollectionService, Humanoid, "CTP") end
    State.AddedCTP = false
    return true
end

function Ragebot.GetTPHitServerCFrame(State)
    if type(State) ~= "table" or typeof(State.ServerPosition) ~= "Vector3" then return nil end
    local Root = State.Root
    local Base = Root and Root.Parent and Root.CFrame or State.RenderCFrame
    local Rotation = typeof(Base) == "CFrame" and (Base - Base.Position) or NewCFrame()
    return NewCFrame(State.ServerPosition) * Rotation
end

function Ragebot.ApplyTPHitServerSample(State)
    return type(State) == "table" and State.TPHitDesync == true and State.PulseInFlightGeneration ~= nil
end

function Ragebot.RestoreTPHitRenderSample(State, Final)
    if type(State) ~= "table" then return false end
    local Root = State.Root
    if not Root or not Root.Parent then return false end
    if typeof(State.PulseClientCFrame) == "CFrame" then Root.CFrame = State.PulseClientCFrame end
    if typeof(State.PulseLinearVelocity) == "Vector3" then Root.AssemblyLinearVelocity = State.PulseLinearVelocity end
    if typeof(State.PulseAngularVelocity) == "Vector3" then Root.AssemblyAngularVelocity = State.PulseAngularVelocity end
    State.RenderCFrame = Root.CFrame
    State.RenderPosition = Root.Position
    State.LinearVelocity = Root.AssemblyLinearVelocity
    State.AngularVelocity = Root.AssemblyAngularVelocity
    return true
end

function Ragebot.BeginTPHitLocalView(State)
    return type(State) == "table"
end

function Ragebot.EndTPHitLocalView(State)
    return type(State) == "table"
end

function Ragebot.StartTPHitDesyncRuntime(State)
    if type(State) ~= "table" or State.TPHitDesync ~= true then return false end
    local Root = State.Root
    if not Root or not Root.Parent or not Ragebot.CaptureTPHitNetworkState(State) then return false end
    if VelocityDesync and VelocityDesync.SpoofApplied then RestoreVelocityDesyncSpoof() end
    Ragebot.EnableTPHitMovementExemption(State)
    State.NetworkMode = State.NetworkSleepSupported and "SourceSleepPulse" or (State.SenderRateSupported and "SenderPulse" or "OneFramePulse")
    State.ServerPacketPatched = false
    State.ServerPacketPatchFailed = false
    State.ServerPacketPatchedGeneration = 0
    State.PendingPulseGeneration = nil
    State.PulseInFlightGeneration = nil
    State.RenderCFrame = Root.CFrame
    State.RenderPosition = Root.Position
    local PreSignal = RunService.PreSimulation or RunService.Stepped
    State.TPHitPreConnection = PreSignal:Connect(function()
        if State.TPHitDesync ~= true or State.Root ~= Root or not Root.Parent then return end
        local Generation = tonumber(State.PendingPulseGeneration)
        if not Generation or Generation <= (tonumber(State.ServerPacketPatchedGeneration) or 0) then return end
        if State.PulseInFlightGeneration then return end
        State.PulseClientCFrame = Root.CFrame
        State.PulseLinearVelocity = Root.AssemblyLinearVelocity
        State.PulseAngularVelocity = Root.AssemblyAngularVelocity
        State.RenderCFrame = State.PulseClientCFrame
        State.RenderPosition = State.PulseClientCFrame.Position
        Ragebot.SetTPHitSenderRate(State, 240)
        Ragebot.SetTPHitNetworkSleeping(State, false)
        local ServerCFrame = Ragebot.GetTPHitServerCFrame(State)
        if not ServerCFrame then
            State.ServerPacketPatchFailed = true
            return
        end
        Root.CFrame = ServerCFrame
        State.PulseInFlightGeneration = Generation
        State.ServerPacketPatched = false
        State.ServerPacketPatchedAt = 0
    end)
    local RestoreSignal = RunService.PreRender or RunService.RenderStepped
    State.TPHitRenderConnection = RestoreSignal:Connect(function()
        if not State.PulseInFlightGeneration then return end
        local Generation = State.PulseInFlightGeneration
        Ragebot.SetTPHitNetworkSleeping(State, true)
        Ragebot.RestoreTPHitRenderSample(State, false)
        if State.SenderRateOriginal then
            Ragebot.SetTPHitSenderRate(State, State.SenderRateOriginal)
            SyncAtramentaPhysicsSenderRate()
        end
        State.PulseRepeatCount = (tonumber(State.PulseRepeatCount) or 0) + 1
        State.PulseInFlightGeneration = nil
        if State.PulseRepeatCount >= Max(Floor(tonumber(State.PulseRepeatTarget) or 2), 1) then
            State.ServerPacketPatched = true
            State.ServerPacketPatchedGeneration = Generation
            State.ServerPacketPatchedAt = Clock()
            State.ServerPacketPatchedCount = (tonumber(State.ServerPacketPatchedCount) or 0) + 1
            State.LastServerPosition = State.ServerPosition
        end
    end)
    Ragebot.BeginTPHitLocalView(State)
    Ragebot.RequestTPHitServerPublish(State, State.ServerPosition)
    return true
end

function Ragebot.StopTPHitDesyncRuntime(State, Final)
    if type(State) ~= "table" then return false end
    State.TPHitDesync = false
    if State.TPHitPreConnection then Shared.SafeDisconnect(State.TPHitPreConnection); State.TPHitPreConnection = nil end
    if State.TPHitRenderConnection then Shared.SafeDisconnect(State.TPHitRenderConnection); State.TPHitRenderConnection = nil end
    Ragebot.RestoreTPHitRenderSample(State, Final == true)
    Ragebot.SetTPHitNetworkSleeping(State, false)
    if State.SenderRateOriginal then
        Ragebot.SetTPHitSenderRate(State, State.SenderRateOriginal)
        SyncAtramentaPhysicsSenderRate()
    end
    Ragebot.DisableTPHitMovementExemption(State)
    Ragebot.EndTPHitLocalView(State)
    State.NetworkMode = "Restore"
    State.ServerPublishUntil = 0
    State.PendingPulseGeneration = nil
    State.PulseInFlightGeneration = nil
    State.ServerPacketPatched = false
    return true
end

function Ragebot.ApplyTPHitReturnTransform(State, Final)
    if type(State) ~= "table" then return false end
    if Final == true then return Ragebot.StopTPHitDesyncRuntime(State, true) end
    return Ragebot.RestoreTPHitRenderSample(State, false)
end

function Ragebot.RestoreTPHitState(State)
    if type(State) ~= "table" then return false end
    if State.RestoreFinished == true then return true end
    if State.RestoreStarted == true then return State.RestoreFinished == true end
    State.RestoreStarted = true
    State.Returning = true
    Ragebot.StopTPHitDesyncRuntime(State, true)
    State.Returning = false
    State.Restored = true
    State.RestoreFinished = true
    return true
end

function Ragebot.CancelTPHit()
    Ragebot.Runtime.TPHitToken = (tonumber(Ragebot.Runtime.TPHitToken) or 0) + 1
    local State = Ragebot.Runtime.ModeMoveState
    if type(State) == "table" then Ragebot.Runtime.TPHitBusy = true end
    Ragebot.RestoreTPHitState(State)
    if Ragebot.Runtime.ModeMoveState == State then Ragebot.Runtime.ModeMoveState = nil end
    Ragebot.Runtime.TPHitBusy = false
    Ragebot.Runtime.TPHitThread = nil
end

function Ragebot.GetTPHitTargetState(Target, Tool)
    if not Target or Target.Parent ~= Players then return true, "target_invalid", nil, nil, nil end
    if not Tool or not Tool.Parent or not Ragebot.IsGun(Tool) then return true, "tool_invalid", nil, nil, nil end
    local TargetCharacter = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    if not TargetCharacter or not TargetCharacter.Parent then return true, "character_invalid", nil, nil, nil end
    local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")
    if not TargetRoot then return true, "root_invalid", TargetCharacter, nil, nil end
    local Humanoid = TargetCharacter:FindFirstChildOfClass("Humanoid")
    if Humanoid and Humanoid.Health <= 0 then
        return true, "dead", TargetCharacter, TargetRoot, Ragebot.GetAmmo(Tool)
    end
    local IsDowned = false
    if type(CombatChecks) == "table" and type(CombatChecks.IsDowned) == "function" then
        local Success, Result = Shared.SafeCall(CombatChecks.IsDowned, Target, TargetCharacter)
        IsDowned = Success == true and Result == true
    end
    if not IsDowned and type(Shared.IsAtramentaPlayerActuallyDowned) == "function" then
        local Success, Result = Shared.SafeCall(Shared.IsAtramentaPlayerActuallyDowned, Target)
        IsDowned = Success == true and Result == true
    end
    if IsDowned then
        return true, "downed", TargetCharacter, TargetRoot, Ragebot.GetAmmo(Tool)
    end
    local Ammo = Ragebot.GetAmmo(Tool)
    if not Ammo or typeof(Ammo.Value) ~= "number" then return true, "ammo_invalid", TargetCharacter, TargetRoot, Ammo end
    if Ammo.Value <= 0 then return true, "mag_empty", TargetCharacter, TargetRoot, Ammo end
    return false, nil, TargetCharacter, TargetRoot, Ammo
end

function Ragebot.PrepareTPHitLiveShot(State, Target, LocalRoot, TargetRoot)
    if type(State) ~= "table" or not Target or not LocalRoot or not TargetRoot then return nil end
    local Origin = State.ServerPosition
    if typeof(Origin) ~= "Vector3" then return nil end
    local TargetPosition = Ragebot.GetRouteTargetPosition(Target, TargetRoot) or TargetRoot.Position
    local Shot = Ragebot.FindDirectShot(Origin, Target, TargetPosition)
    if not Shot then return nil end
    Shot.Origin = Origin
    Shot.TPHit = true
    Shot.Stage = "TPHit"
    Shot.Wallbang = false
    Shot.OriginOffset = EmptyVector3
    Shot.RenderRootPosition = State.RenderPosition
    Shot.ServerPosition = Origin
    Shot.ShotOrigin = Origin
    State.ShotOrigin = Origin
    return Shot
end

function Ragebot.RunTPHit(Target)
    if Ragebot.Enabled ~= true or tostring(Ragebot.Settings.Mode or "Normal") ~= "TP Hit" then return false end
    if Ragebot.Runtime.TPHitBusy == true then return false end
    if not Target or not Target.Character or not IsCombatTargetAllowed(Target) then return false end
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local LocalRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    local Tool = Character and Character:FindFirstChildOfClass("Tool")
    local TargetCharacter = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild("HumanoidRootPart")
    if not Humanoid or Humanoid.Health <= 0 or not LocalRoot or not TargetRoot or not Ragebot.IsGun(Tool) then return false end
    local Ammo = Ragebot.GetAmmo(Tool)
    if not Ammo or typeof(Ammo.Value) ~= "number" or Ammo.Value <= 0 then
        Ragebot.RequestReload(Tool)
        return false
    end
    local ClientA = LocalRoot.Position
    local ServerB, CandidateShot, Profile = Ragebot.GetTPHitCandidate(Target, LocalRoot, TargetRoot, ClientA)
    if typeof(ServerB) ~= "Vector3" or not CandidateShot then return false end
    Ragebot.Runtime.TPHitToken = (tonumber(Ragebot.Runtime.TPHitToken) or 0) + 1
    local Token = Ragebot.Runtime.TPHitToken
    local State = {Token = Token, Root = LocalRoot, Character = Character, Humanoid = Humanoid, SavedPosition = ClientA, RenderPosition = ClientA,
        RenderCFrame = LocalRoot.CFrame, LinearVelocity = LocalRoot.AssemblyLinearVelocity, AngularVelocity = LocalRoot.AssemblyAngularVelocity, TeleportPosition = ServerB,
        ActivePosition = ServerB, ServerPosition = ServerB, ShotOrigin = ServerB, TPHitDesync = true, NetworkMode = "PendingSourcePulse", ServerPositionGeneration = 0,
        ServerPacketPatchedGeneration = 0, ServerPacketPatched = false, ServerPacketCalibrating = true, ServerPacketPatchFailed = false, ServerPacketPatchedCount = 0,
        ServerPublishUntil = 0, Target = Target, Tool = Tool, Profile = Profile, ReturnHold = Profile.ReturnHold, Restored = false, RestoreStarted = false,
        RestoreFinished = false}
    Ragebot.Runtime.TPHitBusy = true
    Ragebot.Runtime.ModeMoveState = State
    if not Ragebot.StartTPHitDesyncRuntime(State) then
        Ragebot.Runtime.ModeMoveState = nil
        Ragebot.Runtime.TPHitBusy = false
        return false
    end
    Ragebot.Runtime.TPHitThread = Spawn(function()
        local Fired = false
        Shared.SafeCall(function()
            local function Alive()
                return Ragebot.Enabled == true and tostring(Ragebot.Settings.Mode or "Normal") == "TP Hit" and Ragebot.Runtime.TPHitToken == Token
                    and Ragebot.Runtime.ModeMoveState == State and LocalPlayer.Character == Character and LocalRoot.Parent ~= nil and Tool.Parent ~= nil
                    and Target.Parent == Players
            end
            local FirstPublishTimeout = Max(tonumber(Profile.AckTimeout) or 0.18, 0.16) + 0.12
            if not Ragebot.WaitForTPHitServerPacket(State, FirstPublishTimeout, Alive) then
                State.FinishReason = State.ServerPacketPatchFailed and "physics_patch_failed" or "physics_patch_timeout"
                return
            end
            local LastShotAt = 0
            while Alive() do
                local Finished, Reason, LiveCharacter, LiveRoot, LiveAmmo = Ragebot.GetTPHitTargetState(Target, Tool)
                if Finished then
                    State.FinishReason = Reason
                    break
                end
                local CurrentAmmo = Max(Floor(tonumber(LiveAmmo and LiveAmmo.Value) or 0), 0)
                if CurrentAmmo <= 0 then
                    State.FinishReason = "Ammo"
                    break
                end
                State.RenderCFrame = LocalRoot.CFrame
                State.RenderPosition = LocalRoot.Position
                State.LinearVelocity = LocalRoot.AssemblyLinearVelocity
                State.AngularVelocity = LocalRoot.AssemblyAngularVelocity
                local CurrentTime = Clock()
                local ShotInterval = Ragebot.GetTPHitShotInterval(Profile)
                if CurrentTime - LastShotAt >= ShotInterval then
                    TargetCharacter = LiveCharacter
                    TargetRoot = LiveRoot
                    if LastShotAt > 0 then
                        Ragebot.RequestTPHitServerPublish(State, State.ServerPosition)
                        if not Ragebot.WaitForTPHitServerPacket(State, Max(tonumber(Profile.AckTimeout) or 0.18, 0.12), Alive) then
                            State.FinishReason = "physics_republish_timeout"
                            break
                        end
                    end
                    local LiveShot = TargetRoot and Ragebot.PrepareTPHitLiveShot(State, Target, LocalRoot, TargetRoot) or nil
                    if not LiveShot then
                        local NewPosition, NewShot = Ragebot.GetTPHitCandidate(Target, LocalRoot, TargetRoot, State.RenderPosition)
                        if typeof(NewPosition) ~= "Vector3" or not NewShot then break end
                        Ragebot.ApplyTPHitTransform(State, NewPosition)
                        local Republished = Ragebot.WaitForTPHitServerPacket(State, Max(tonumber(Profile.AckTimeout) or 0.18, 0.12), Alive)
                        LiveShot = Republished and Ragebot.PrepareTPHitLiveShot(State, Target, LocalRoot, TargetRoot) or nil
                    end
                    if LiveShot then
                        Ragebot.Runtime.ActiveShot = LiveShot
                        Ragebot.LastStage = "TPHit"
                        Ragebot.LastScanCount = 1
                        local Before = tonumber(Ragebot.Runtime.LastShotAt) or 0
                        local ShotFired = Ragebot.Fire({SuppressAutoReload = true, Shot = LiveShot}) == true or (tonumber(Ragebot.Runtime.LastShotAt) or 0) > Before
                        if ShotFired then
                            Fired = true
                            LastShotAt = tonumber(Ragebot.Runtime.LastShotAt) or Clock()
                        end
                    end
                end
                RunService.Heartbeat:Wait()
            end
            if Fired and Alive() then
                local HoldUntil = Clock() + Max(tonumber(Profile.PostHold) or 0.018, 0)
                while Alive() and Clock() < HoldUntil do RunService.Heartbeat:Wait() end
            end
        end)
        if Fired and Ragebot.Settings.AutoReload == true and Tool and Tool.Parent then
            local LiveAmmo = Ragebot.GetAmmo(Tool)
            if LiveAmmo and typeof(LiveAmmo.Value) == "number" and LiveAmmo.Value <= 1 then Ragebot.RequestReload(Tool) end
        end
        Ragebot.RestoreTPHitState(State)
        if Ragebot.Runtime.ModeMoveState == State then Ragebot.Runtime.ModeMoveState = nil end
        if Ragebot.Runtime.TPHitToken == Token then
            Ragebot.Runtime.TPHitBusy = false
            Ragebot.Runtime.TPHitThread = nil
        end
        if not Fired and Ragebot.Runtime.ActiveShot and Ragebot.Runtime.ActiveShot.TPHit == true then Ragebot.Runtime.ActiveShot = nil end
    end)
    return true
end

function Ragebot.UpdateRage()
    if Ragebot.Enabled ~= true then
        Ragebot.Runtime.ActiveShot = nil
        return
    end
    if Ragebot.Settings.AutoReload == true then Ragebot.RefreshReload() end
    local MoveState = Ragebot.Runtime.ModeMoveState
    local Target = tostring(Ragebot.Settings.Mode or "Normal") == "TP Hit" and Ragebot.Runtime.TPHitBusy == true and type(MoveState) == "table" and MoveState.Target
        or Ragebot.GetTarget()
    if Target then Ragebot.CurrentTarget = Target end
    if not Target or not Target.Character then
        Ragebot.Runtime.ActiveShot = nil
        Ragebot.CurrentTarget = nil
        Ragebot.StopFireLoop(false)
        if Ragebot.Runtime.Wallbang then Ragebot.ResetWallbangState() end
        return
    end
    local Character = LocalPlayer.Character
    local MyRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    local TargetCharacter = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild("HumanoidRootPart")
    if not MyRoot or not TargetRoot then
        Ragebot.Runtime.ActiveShot = nil
        return
    end
    Ragebot.CurrentTarget = Target
    local FireState = Ragebot.GetFireState()
    if FireState.Target and FireState.Target
            ~= Target then
        Ragebot.StopFireLoop(false)
    end
    if tostring(Ragebot.Settings.Mode or "Normal") == "TP Hit" then
        Ragebot.Runtime.ActiveShot = nil
        Ragebot.StopFireLoop(false)
        if Ragebot.Runtime.Wallbang then Ragebot.ResetWallbangState() end
        Ragebot.RunTPHit(Target)
        return
    end
    local MyPosition = Ragebot.GetPosition()
    local TargetPosition = Ragebot.GetRouteTargetPosition(Target, TargetRoot) or TargetRoot.Position
    local Shot = Ragebot.FindDirectShot(MyPosition, Target, TargetPosition)
    if Shot then
        Ragebot.Runtime.ActiveShot = Shot
        Ragebot.LastStage = "Direct"
        Ragebot.LastScanCount = 1
        local Tool = Character and Character:FindFirstChildOfClass("Tool")
        Ragebot.QueueShot(Shot, Tool)
        return
    end
    local Wallbang = Ragebot.Runtime.Wallbang
    if not Wallbang or Wallbang.Enabled ~= true then
        Ragebot.Runtime.ActiveShot = nil
        Ragebot.LastStage = "Blocked"
        Ragebot.LastScanCount = 1
        Ragebot.StopFireLoop(false)
        return
    end
    local Now = Clock()
    if Now - (tonumber(Wallbang.LastScan) or 0) < 1 / Max(tonumber(Wallbang.ScanRate) or 60, 1) then
        Ragebot.Runtime.ActiveShot = nil
        return
    end
    Wallbang.LastScan = Now
    local Checks, Stage
    Shot, Checks, Stage = Ragebot.FindWallbangShot(MyPosition, Target, TargetPosition)
    Ragebot.Runtime.ActiveShot = Shot
    Ragebot.LastStage = Stage or "FakeShoot"
    Ragebot.LastScanCount = tonumber(Checks) or 0
    if Shot then
        local Tool = Character and Character:FindFirstChildOfClass("Tool")
        Ragebot.QueueShot(Shot, Tool)
    end
end
function Ragebot.GenerateShotKey(Length)
    local Result = ""
    Length = Max(Floor(tonumber(Length) or 30), 0)
    for _ = 1, Length do
        Result = Result .. StringChar(Math.random(97, 122))
    end
    return Result
end

function Ragebot.RegisterRageFeedbackShot(TargetCharacter, TargetPart, ShotToken, Tool, OriginPosition, Direction, HitPosition, Metadata)
    if type(Shared.RegisterLocalAttack) ~= "function" then
        return nil
    end
    if type(Shared.RegisterAttackTool) == "function" then Shared.RegisterAttackTool(Tool) end
    local Attack = Shared.RegisterLocalAttack(TargetCharacter, TargetPart, ShotToken, Tool, "RageBot", OriginPosition, Direction)
    if type(Attack) ~= "table" then
        return nil
    end
    Metadata = type(Metadata) == "table" and Metadata or {}
    Attack.Source = "RageBot"
    Attack.Origin = typeof(OriginPosition) == "Vector3" and OriginPosition or Attack.Origin
    Attack.VisualOrigin = Attack.Origin
    Attack.Direction = typeof(Direction) == "Vector3" and Direction or Attack.Direction
    Attack.PacketOrigin = Attack.Origin
    Attack.PacketDirection = Attack.Direction
    Attack.HitPosition = typeof(HitPosition) == "Vector3" and HitPosition or Attack.HitPosition
    Attack.DamageHitPosition = Attack.HitPosition
    Attack.TargetPositionAtFire = Attack.HitPosition or Attack.TargetPositionAtFire
    Attack.Wallbang = Metadata.Wallbang == true
    Attack.MatrixWallbang = Metadata.MatrixWallbang == true
    Attack.MatrixRoute = Metadata.MatrixRoute == true
    Attack.MatrixAnchorName = Metadata.AnchorName
    Attack.MatrixAnchorPartName = Metadata.AnchorPartName
    Attack.Stage = Metadata.Stage
    Attack.RageRemoteSent = false
    Attack.DamagePacketSent = false
    Ragebot.ReportedShots = type(Ragebot.ReportedShots) == "table" and Ragebot.ReportedShots or {}
    Ragebot.ReportedShots[tostring(ShotToken)] = Attack
    local ReportKey = tostring(ShotToken)
    Delay((tonumber(AttackConfirmationState.Window) or 4.2) + 0.35, function()
        if type(Ragebot.ReportedShots) == "table" and Ragebot.ReportedShots[ReportKey] == Attack then Ragebot.ReportedShots[ReportKey] = nil end
    end)
    return Attack
end

function Ragebot.MarkRageFeedbackRemote(Attack, ShotToken, OriginPosition, Direction)
    if type(Attack) ~= "table" then
        return false
