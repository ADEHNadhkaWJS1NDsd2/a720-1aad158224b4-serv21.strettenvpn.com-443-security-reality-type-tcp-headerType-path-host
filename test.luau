ResolveTrackedCharacter = function(Player, PreferredCharacter)
    if not Player then return nil end
    local Now = Clock()
    local function Valid(Character)
        if not Character or not Character:IsA("Model") or not Character.Parent then return false end
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local Root = ResolverGetRootPart(Character)
        return Humanoid ~= nil and Humanoid.Health > 0 and Root ~= nil and Root:IsA("BasePart")
    end
    local Cache = Res.CharacterResolveCache[Player]
    local Character
    if Valid(PreferredCharacter) then Character = PreferredCharacter
    elseif Valid(Player.Character) then Character = Player.Character
    elseif type(Cache) == "table" and Valid(Cache.Character) and Now - (tonumber(Cache.Time) or 0) <= 0.35 then Character = Cache.Character
    else
        local WorldCharacters, NormalCharacters = ResolverGetCharacterFolders(Now)
        local WorldCharacter = WorldCharacters and WorldCharacters:FindFirstChild(Player.Name)
        local NormalCharacter = NormalCharacters and NormalCharacters:FindFirstChild(Player.Name)
        if Valid(WorldCharacter) then Character = WorldCharacter elseif Valid(NormalCharacter) then Character = NormalCharacter end
    end
    Res.CharacterResolveCache[Player] = {Character = Character, Time = Now}
    return Character
end
