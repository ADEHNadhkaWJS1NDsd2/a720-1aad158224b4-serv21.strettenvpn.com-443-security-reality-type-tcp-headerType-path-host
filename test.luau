    local Sizes = {{NewUDim2(1, 0, 0, 46), NewUDim2(0, 0, 0, 0)}, {NewUDim2(1, 0, 0, 46), NewUDim2(0, 0, 1, -46)}, {NewUDim2(0, 46, 1, 0), NewUDim2(0, 0, 0, 0)}, {NewUDim2(0, 46, 1, 0), NewUDim2(1, -46, 0, 0)}}
    for _, Data in ipairs(Sizes) do
