function HitFeedbackRuntimeState.GetBulletTracerLightningBasis(Direction)
    local Unit = Direction.Unit local Reference = Abs(Unit.Y) < 0.92 and NewVector3(0, 1, 0) or NewVector3(1, 0, 0) local Right = Unit:Cross(Reference)
    if Right.Magnitude <= 0.001 then Right = Unit:Cross(NewVector3(0, 0, 1)) end
    Right = Right.Magnitude > 0.001 and Right.Unit or NewVector3(1, 0, 0)
    local Up = Right:Cross(Unit)
    Up = Up.Magnitude > 0.001 and Up.Unit or NewVector3(0, 1, 0)
    return Unit, Right, Up
end
