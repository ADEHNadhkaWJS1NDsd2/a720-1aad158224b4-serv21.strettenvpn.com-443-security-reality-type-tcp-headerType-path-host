function ExtendedVisuals:SaveCharacterAppearance(Part)
    if not Part or not Part.Parent or self.Character.SavedParts[Part] then return end
    self.Character.SavedParts[Part] = {Color = Part.Color, Material = Part.Material, MaterialVariant = Part.MaterialVariant, Reflectance = Part.Reflectance,
        Transparency = Part.Transparency, LocalTransparencyModifier = Part.LocalTransparencyModifier, TextureID = Part:IsA("MeshPart") and Part.TextureID or nil,
        UsePartColor = Part:IsA("UnionOperation") and Part.UsePartColor or nil}
end
function Shared.GetAtramentaCharacterMaterialEnum(MaterialName)
    return tostring(MaterialName or "Neon") == "ForceField" and Enum.Material.ForceField or Enum.Material.Neon
end

function Shared.GetPhysicalHbeOriginal(Part)
    return nil
end

function Shared.GetPhysicalHbeVisualEntry(Part)
    return nil
end

function Shared.GetPhysicalHbeVisualSize(Part)
    if not Part or not Part:IsA("BasePart") then return nil end
    return Part.Size
end

function Shared.GetPhysicalHbeVisualPart(Part)
    return Part
end

function Shared.ApplyAtramentaCharacterMaterialPart(Part, MaterialName, Color, Transparency, Saved)
    if not Part or not Part.Parent or not Part:IsA("BasePart") then return false end
    local MaterialEnum = Shared.GetAtramentaCharacterMaterialEnum(MaterialName)
    Part.Color = typeof(Color) == "Color3" and Color or NewRGB(249, 217, 255)
    Part.Material = Part.Name == "Head" and Enum.Material.ForceField or MaterialEnum
    Part.MaterialVariant = ""
    Part.Reflectance = 0
    if Part:IsA("UnionOperation") then Part.UsePartColor = true end
    if Part:IsA("MeshPart") and type(Saved) == "table" and Saved.TextureID ~= nil then
        if Part:FindFirstAncestorOfClass("Accessory") then
            Part.TextureID = ""
        else
            Part.TextureID = Saved.TextureID
        end
    end
    local HbeOriginal = Shared.GetPhysicalHbeOriginal(Part)
    local SavedTransparency = HbeOriginal and tonumber(HbeOriginal.Transparency) or (type(Saved) == "table" and tonumber(Saved.Transparency) or nil)
    local DisplayTransparency = SavedTransparency ~= 1 and Clamp(tonumber(Transparency) or 0.20, 0, 0.95) or 1
    if HbeOriginal then
        Part.Transparency = 1
        Part.LocalTransparencyModifier = 0
        local Entry = Shared.GetPhysicalHbeVisualEntry(Part)
        local VisualClone = Entry and Entry.Clone or nil
        if VisualClone and VisualClone.Parent and VisualClone:IsA("BasePart") then
            VisualClone.Color = Part.Color
            VisualClone.Material = Part.Material
            VisualClone.MaterialVariant = Part.MaterialVariant
            VisualClone.Reflectance = Part.Reflectance
            VisualClone.Transparency = DisplayTransparency
            VisualClone.LocalTransparencyModifier = tonumber(HbeOriginal.LocalTransparencyModifier) or 0
        end
    else
        Part.Transparency = DisplayTransparency
    end
    return true
end

function Shared.RestoreAtramentaCharacterMaterialPart(Part, Data)
    if not Part or not Part.Parent or not Part:IsA("BasePart") or type(Data) ~= "table" then return false end
    if typeof(Data.Color) == "Color3" then Part.Color = Data.Color end
    if Data.Material then Part.Material = Data.Material end
    Part.MaterialVariant = Data.MaterialVariant or ""
    if Data.Reflectance ~= nil then Part.Reflectance = Data.Reflectance end
    if Part:IsA("MeshPart") and Data.TextureID ~= nil then Part.TextureID = Data.TextureID end
    if Part:IsA("UnionOperation") and Data.UsePartColor ~= nil then Part.UsePartColor = Data.UsePartColor end
    local HbeOriginal = Shared.GetPhysicalHbeOriginal(Part)
    if HbeOriginal then
        Part.Transparency = 1
        Part.LocalTransparencyModifier = 0
        local Entry = Shared.GetPhysicalHbeVisualEntry(Part)
        local VisualClone = Entry and Entry.Clone or nil
        if VisualClone and VisualClone.Parent and VisualClone:IsA("BasePart") then
            VisualClone.Color = Part.Color
            VisualClone.Material = Part.Material
            VisualClone.MaterialVariant = Part.MaterialVariant
            VisualClone.Reflectance = Part.Reflectance
            VisualClone.Transparency = tonumber(HbeOriginal.Transparency) or 0
            VisualClone.LocalTransparencyModifier = tonumber(HbeOriginal.LocalTransparencyModifier) or 0
        end
    else
        if Data.Transparency ~= nil then Part.Transparency = Data.Transparency end
        if Data.LocalTransparencyModifier ~= nil then Part.LocalTransparencyModifier = Data.LocalTransparencyModifier end
    end
    return true
end
function ExtendedVisuals:RestoreCharacterAppearancePart(Part)
    local Data = Part and self.Character.SavedParts[Part] if not Data then return end
    if Part.Parent then Shared.RestoreAtramentaCharacterMaterialPart(Part, Data) end
    self.Character.SavedParts[Part] = nil
end
function ExtendedVisuals:ApplyCharacterMeshTextures(Part, ForceNoTexture)
    if not Part or not Part.Parent then return end
    local NoTexture = self.Character.NoTexture == true or ForceNoTexture == true
    local function ApplyMeshTextureState(Object)
        if Object:IsA("SpecialMesh") or Object:IsA("FileMesh") then
            local Saved = self.Character.SavedMeshTextures[Object]
            if Saved == nil then
                Saved = {TextureId = Object.TextureId}
                self.Character.SavedMeshTextures[Object] = Saved
            end
            if NoTexture then Object.TextureId = "" else
                Object.TextureId = Saved.TextureId or ""
                self.Character.SavedMeshTextures[Object] = nil
            end
        elseif Object:IsA("Decal") or Object:IsA("Texture") then
            local Saved = self.Character.SavedMeshTextures[Object]
            if Saved == nil then
                Saved = {Texture = Object.Texture}
                self.Character.SavedMeshTextures[Object] = Saved
            end
            if NoTexture then Object.Texture = "" else
                Object.Texture = Saved.Texture or ""
                self.Character.SavedMeshTextures[Object] = nil
            end
        elseif Object:IsA("SurfaceAppearance") then
            local Saved = self.Character.SavedMeshTextures[Object]
            if Saved == nil then
                Saved = {ColorMap = Object.ColorMap, MetalnessMap = Object.MetalnessMap, NormalMap = Object.NormalMap, RoughnessMap = Object.RoughnessMap}
                self.Character.SavedMeshTextures[Object] = Saved
            end
            if NoTexture then
                Object.ColorMap = ""
                Object.MetalnessMap = ""
                Object.NormalMap = ""
                Object.RoughnessMap = ""
            else
                Object.ColorMap = Saved.ColorMap or ""
                Object.MetalnessMap = Saved.MetalnessMap or ""
                Object.NormalMap = Saved.NormalMap or ""
                Object.RoughnessMap = Saved.RoughnessMap or ""
                self.Character.SavedMeshTextures[Object] = nil
            end
        end
    end
    for _, Object in ipairs(Part:GetDescendants()) do ApplyMeshTextureState(Object) end
    for _, Object in ipairs(Part:GetChildren()) do ApplyMeshTextureState(Object) end
end
function ExtendedVisuals:RestoreCharacterMeshTextures()
    for Object, Saved in pairs(self.Character.SavedMeshTextures) do
        if Object and Object.Parent and type(Saved) == "table" then
            if Object:IsA("SpecialMesh") or Object:IsA("FileMesh") then
                Object.TextureId = Saved.TextureId or ""
            elseif Object:IsA("Decal") or Object:IsA("Texture") then
                Object.Texture = Saved.Texture or ""
            elseif Object:IsA("SurfaceAppearance") then
                Object.ColorMap = Saved.ColorMap or ""
