function Shared.GetWeaponIconAssetID(Asset)
    if type(Asset) ~= "string" then return nil end
    local Id = tonumber(Asset:match("(%d+)"))
    return Id and Floor(Id) or nil
end
function Shared.FetchWeaponIconData(Asset)
    local AssetId = Shared.GetWeaponIconAssetID(Asset)
    if not AssetId then return nil end
    local ApiUrl = "https://thumbnails.roblox.com/v1/assets?assetIds=" .. tostring(AssetId) .. "&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false"
    local Json = RequestProfileData(ApiUrl)
    if type(Json) ~= "string" then return nil end
    local DecodeSuccess, Decoded = Shared.SafeCall(function()
        return GetService(Game, "HttpService"):JSONDecode(Json)
    end)
    if not DecodeSuccess or type(Decoded) ~= "table" or type(Decoded.data) ~= "table" or type(Decoded.data[1]) ~= "table" then return nil end
    local ImageUrl = Decoded.data[1].imageUrl
    if type(ImageUrl) ~= "string" or ImageUrl == "" then return nil end
    local Data = RequestProfileData(ImageUrl)
    if type(Data) ~= "string" or #Data <= 64 then return nil end
    return Data
end
function Shared.QueueWeaponIconData(Data)
    if type(Data) ~= "table" then return end
    local Asset = Data.ToolIconAsset
    if type(Asset) ~= "string" or Asset == "" then
        Data.WeaponIconData = nil
        Data.WeaponIconDataAsset = nil
        Data.WeaponIconAppliedAsset = nil
        return
    end
    if Data.WeaponIconDataAsset == Asset and type(Data.WeaponIconData) == "string" and #Data.WeaponIconData > 64 then return end
    local AssetId = Shared.GetWeaponIconAssetID(Asset)
    if not AssetId then return end
    local Entry = Shared.WeaponIconDataCache[AssetId]
    local CurrentTime = Clock()
    if type(Entry) == "table" then
        if type(Entry.Data) == "string" and #Entry.Data > 64 then
            Data.WeaponIconData = Entry.Data
            Data.WeaponIconDataAsset = Asset
            return
        end
        if Entry.Loading == true or CurrentTime < (tonumber(Entry.RetryAt) or 0) then return end
    else
        Entry = {}
        Shared.WeaponIconDataCache[AssetId] = Entry
    end
    Entry.Loading = true
    Spawn(function()
        local IconData = Shared.FetchWeaponIconData(Asset)
        Entry.Loading = false
        if type(IconData) == "string" and #IconData > 64 then
            Entry.Data = IconData
            Entry.RetryAt = 0
            if Data.ToolIconAsset == Asset then
                Data.WeaponIconData = IconData
                Data.WeaponIconDataAsset = Asset
                Data.WeaponIconAppliedAsset = nil
            end
        else
            Entry.RetryAt = Clock() + 30
        end
    end)
end
function Shared.RefreshEquippedWeaponOverlayIcon(Data, Visible)
    if type(Data) ~= "table" or type(Data.OverlayPrimitives) ~= "table" then return end
    local OverlayPrimitives = Data.OverlayPrimitives
    local Icon = OverlayPrimitives.WeaponIcon
    if not Icon then
        Icon = Shared.CreateOverlayPrimitive("Image", {Visible = false, Transparency = 1, ZIndex = 5})
        OverlayPrimitives.WeaponIcon = Icon
    end
    if not Icon then return end
    local ShouldShow = Visible == true and Visuals.Player.Weapon == true and Visuals.Player.WeaponIcon == true
        and type(Data.ToolIconAsset) == "string" and Data.ToolIconAsset ~= ""
    if not ShouldShow then
        Icon.Visible = false
        return
    end
    if Data.WeaponIconDataAsset ~= Data.ToolIconAsset or type(Data.WeaponIconData) ~= "string" then Shared.QueueWeaponIconData(Data) end
    if type(Data.WeaponIconData) == "string" and #Data.WeaponIconData > 64 and Data.WeaponIconAppliedAsset ~= Data.ToolIconAsset then
        local Applied = Shared.SafeCall(function() Icon.Data = Data.WeaponIconData end)
        if Applied then Data.WeaponIconAppliedAsset = Data.ToolIconAsset end
    end
    Icon.Visible = Data.WeaponIconAppliedAsset == Data.ToolIconAsset
    if Icon.Visible then
        local IconSize = Clamp(Visuals.Player.WeaponIconSize, 10, 40)
        Shared.SetOverlayProperty(Icon, "Color", Visuals.Player.WeaponIconColor)
        Shared.SetOverlayProperty(Icon, "Transparency", 1)
        Shared.SetOverlayProperty(Icon, "Size", NewVector2(IconSize, IconSize))
    end
end
