function Shared.QueueTargetCharacterRegistration(Player, Character)
    Spawn(function()
        local ResolvedCharacter = ResolveTrackedCharacter(Player, Character)
        if not ResolvedCharacter or not ResolvedCharacter:FindFirstChildOfClass("Humanoid") then
            local Signals = {Player and Player.CharacterAdded or nil, Player and Shared.GetPropertyChangedSignalSafe(Player, "Character") or nil,
                Character and Character.ChildAdded or nil, Character and Character.AncestryChanged or nil,
                HitVisualWorldCharacters and HitVisualWorldCharacters.ChildAdded or nil}
            Shared.WaitForConditionSignal(function()
                ResolvedCharacter = ResolveTrackedCharacter(Player, Player and Player.Character or Character)
                return not Player or not Player.Parent or ResolvedCharacter ~= nil and ResolvedCharacter:FindFirstChildOfClass("Humanoid") ~= nil
            end, 10, Signals)
        end
        Shared.RegisterTargetCharacter(Player, ResolvedCharacter)
    end)
end
