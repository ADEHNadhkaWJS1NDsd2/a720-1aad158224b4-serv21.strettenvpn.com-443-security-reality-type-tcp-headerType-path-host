function PlayerVisuals.Chams.IsCylinderPart(Part)
    return Part and Part:IsA("BasePart") and Part.Name == "Head"
end

function PlayerVisuals.Chams.ApplyAdornmentGeometry(Object, Part, Size)
    if not Object or not Part or typeof(Size) ~= "Vector3" then
        return false
    end
    if Object:IsA("CylinderHandleAdornment") then
        local Diameter = Sqrt(Max(Size.X, 0.001) * Max(Size.Z, 0.001))
        Object.Radius = Diameter * 0.5
        Object.Height = Size.Y
        Object.Angle = 360
        Object.InnerRadius = 0
        Object.CFrame = Angles(Rad(90), 0, 0)
        Object.SizeRelativeOffset = EmptyVector3
        return true
    end
    if Object:IsA("BoxHandleAdornment") then
        Object.Size = Size
        Object.CFrame = NewCFrame()
        return true
    end
    return false
end

function PlayerVisuals.Chams.CreateAdornment(Part, Name, ZIndex)
    if not Part or not Part:IsA("BasePart") then return nil end
    local VisualSize = PlayerVisuals.GetBodyVisualSize(Part)
    if typeof(VisualSize) ~= "Vector3" then return nil end
    local VisualPart = Shared.GetPhysicalHbeVisualPart(Part)
    if not VisualPart or not VisualPart:IsA("BasePart") then VisualPart = Part end
    local Object
    if PlayerVisuals.Chams.IsCylinderPart(Part) then
        Object = NewInstance("CylinderHandleAdornment")
    else
        Object = NewInstance("BoxHandleAdornment")
    end
    Object.Name = tostring(Name or "Layer")
    Object.Adornee = VisualPart
    if not PlayerVisuals.Chams.ApplyAdornmentGeometry(Object, Part, VisualSize) then
        Object:Destroy()
        return nil
    end
    Object.AlwaysOnTop = true
    Object.ZIndex = Floor(tonumber(ZIndex) or 5)
    Object.Color3 = NewColor3(1, 1, 1)
    Object.Transparency = 1
    Object.Visible = false
    return Object
end

function PlayerVisuals.Chams.CreatePart(Data, Part)
    local Folder = Data and Data.PlayerChamFolder
    if not Folder or not Folder.Parent or not PlayerVisuals.IsBodyPart(Data.Character, Part) then
        return
    end
    local Old = Data.PlayerChamLayers and Data.PlayerChamLayers[Part]
    if type(Old) == "table" then
        for Key, Object in pairs(Old) do
            if Key ~= "Part" and typeof(Object) == "Instance" and Object.Parent then Object:Destroy() end
        end
    end
    local Core = PlayerVisuals.Chams.CreateAdornment(Part, "Core", 8)
    local InnerGlow = PlayerVisuals.Chams.CreateAdornment(Part, "InnerGlow", 6)
    local OuterGlow = PlayerVisuals.Chams.CreateAdornment(Part, "OuterGlow", 4)
    if not Core or not InnerGlow or not OuterGlow then
        if Core then Core:Destroy() end
        if InnerGlow then InnerGlow:Destroy() end
        if OuterGlow then OuterGlow:Destroy() end
        return
    end
    Core.Parent = Folder
    InnerGlow.Parent = Folder
    OuterGlow.Parent = Folder
    local Entry = {Part = Part, Core = Core, InnerGlow = InnerGlow, OuterGlow = OuterGlow}
    Data.PlayerChamLayers[Part] = Entry
    Data.Chams[Part] = Core
    Data.ChamsGlowShells[Part] = InnerGlow
    Data.ChamsSoftGlowShells[Part] = OuterGlow
    Data.PlayerChamApplied = nil
end

function PlayerVisuals.Chams.Bind(Data)
    local Character = Data and Data.Character
    if not Data or not Character or not Character.Parent then return false end
    if Data.PlayerChamCharacter == Character and Data.PlayerChamFolder and Data.PlayerChamFolder.Parent then
        Data.PlayerChamLayers = type(Data.PlayerChamLayers) == "table" and Data.PlayerChamLayers or {}
        for _, Object in ipairs(Character:GetChildren()) do
            if PlayerVisuals.IsBodyPart(Character, Object) then
                local Entry = Data.PlayerChamLayers[Object]
                local Broken = type(Entry) ~= "table" or not Entry.Core or not Entry.Core.Parent or not Entry.InnerGlow or not Entry.InnerGlow.Parent
                    or not Entry.OuterGlow or not Entry.OuterGlow.Parent
                if Broken then PlayerVisuals.Chams.CreatePart(Data, Object) end
            end
        end
        return true
    end
    PlayerVisuals.Chams.Destroy(Data)
    Data.PlayerChamCharacter = Character
    Data.PlayerChamLayers = {}
    Data.PlayerChamConnections = {}
    Data.Chams = {}
    Data.ChamsGlowShells = {}
    Data.ChamsSoftGlowShells = {}
    local Folder = NewInstance("Folder")
    Folder.Name = "AtramentaChams"
    Folder.Parent = Shared.GetCamera() or workspace
    Data.PlayerChamFolder = Folder
    Data.ChamsHolder = Folder
    Data.ChamsGlowHolder = Folder
    for _, Object in ipairs(Character:GetChildren()) do
        if PlayerVisuals.IsBodyPart(Character, Object) then PlayerVisuals.Chams.CreatePart(Data, Object) end
    end
    Data.PlayerChamConnections.ChildAdded = Character.ChildAdded:Connect(function(Object)
        if PlayerVisuals.IsBodyPart(Character, Object) then
            PlayerVisuals.Chams.CreatePart(Data, Object)
            PlayerVisuals.QueueUpdate(Data, false)
        end
    end)
    Data.PlayerChamConnections.ChildRemoved = Character.ChildRemoved:Connect(function(Object)
        local Entry = Data.PlayerChamLayers and Data.PlayerChamLayers[Object]
        if Entry then
            for Key, Value in pairs(Entry) do
                if Key ~= "Part" and typeof(Value) == "Instance" and Value.Parent then Value:Destroy() end
            end
            Data.PlayerChamLayers[Object] = nil
            Data.Chams[Object] = nil
            Data.ChamsGlowShells[Object] = nil
            Data.ChamsSoftGlowShells[Object] = nil
            Data.PlayerChamApplied = nil
        end
    end)
    Data.PlayerChamConnections.Ancestry = Character.AncestryChanged:Connect(function()
        if not Character.Parent then PlayerVisuals.Chams.Destroy(Data) end
    end)
    return true
end

function PlayerVisuals.Chams.GetLayerGeometry(Part, Settings, GlowStrength)
    local BaseSize = PlayerVisuals.GetBodyVisualSize(Part)
    if typeof(BaseSize) ~= "Vector3" then BaseSize = Part.Size end
    local GlowSize = Clamp(tonumber(Settings.GlowSize) or 30, 8, 48)
    local SizeAlpha = (GlowSize - 8) / 40
    local StrengthAlpha = Clamp((tonumber(GlowStrength) or 1.45) / 2.5, 0, 1)
    local CoreInflate = 0.015
    local InnerInflate = 0.055 + SizeAlpha * 0.085 + StrengthAlpha * 0.025
    local OuterInflate = 0.13 + SizeAlpha * 0.17 + StrengthAlpha * 0.045
    if PlayerVisuals.Chams.IsCylinderPart(Part) then
        CoreInflate = 0.010
        InnerInflate *= 0.72
        OuterInflate *= 0.62
    end
    local CoreSize = BaseSize + NewVector3(CoreInflate, CoreInflate, CoreInflate)
    local InnerSize = BaseSize + NewVector3(InnerInflate, InnerInflate, InnerInflate)
    local OuterSize = BaseSize + NewVector3(OuterInflate, OuterInflate, OuterInflate)
    return CoreSize, InnerSize, OuterSize
end

function PlayerVisuals.Chams.ApplyInfiniteStaminaState(Data, Visible, Tier, StyleVisible)
    if not Data or not PlayerVisuals.Chams.Bind(Data) then return end
    local Settings = Visuals.Player.Chams
    if type(StyleVisible) ~= "boolean" then StyleVisible = Settings.VisibilityCheck == true and PlayerVisuals.GetVisibility(Data, false) or true end
    local CoreColor, CoreTransparency = PlayerVisuals.GetChamStyle(StyleVisible)
    local GlowColor = typeof(Settings.GlowColor) == "Color3" and Settings.GlowColor or CoreColor
    local GlowEnabled = Settings.Glow == true
    local ThroughWalls = Settings.ThroughWalls == true
    local Occluded = Settings.VisibilityCheck == true and StyleVisible ~= true
    local GlowTransparency = Clamp(tonumber(Settings.GlowTransparency) or 0.64, 0, 0.95)
    local GlowStrength = Clamp(tonumber(Settings.GlowStrength) or 1.45, 0.2, 2.5)
    local Strength01 = Clamp((GlowStrength - 0.2) / 2.3, 0, 1)
    local InnerTransparency = Clamp(GlowTransparency + 0.06 - Strength01 * 0.10, 0.30, 0.94)
    local OuterTransparency = Clamp(GlowTransparency + 0.22 - Strength01 * 0.08, 0.52, 0.975)
    local CoreEnabled = (tonumber(Tier) or 0) > 0 and Visible ~= false and (not Occluded or ThroughWalls)
    for Part, Entry in pairs(Data.PlayerChamLayers) do
        if not Part or not Part.Parent or type(Entry) ~= "table" then
            if Data.PlayerChamLayers then Data.PlayerChamLayers[Part] = nil end
            continue
        end
        local Core = Entry.Core
        local InnerGlow = Entry.InnerGlow
        local OuterGlow = Entry.OuterGlow
        if not Core or not InnerGlow or not OuterGlow then
            PlayerVisuals.Chams.CreatePart(Data, Part)
            continue
        end
        local CoreSize, InnerSize, OuterSize = PlayerVisuals.Chams.GetLayerGeometry(Part, Settings, GlowStrength)
        local VisualPart = Shared.GetPhysicalHbeVisualPart(Part)
        if not VisualPart or not VisualPart:IsA("BasePart") then VisualPart = Part end
        if Core.Adornee ~= VisualPart then Core.Adornee = VisualPart end
        if InnerGlow.Adornee ~= VisualPart then InnerGlow.Adornee = VisualPart end
        if OuterGlow.Adornee ~= VisualPart then OuterGlow.Adornee = VisualPart end
        local PartColor = CoreColor
        local PartGlowColor = Occluded and CoreColor or GlowColor
        PlayerVisuals.Chams.ApplyAdornmentGeometry(Core, Part, CoreSize)
        Core.Color3 = PartColor
        Core.Transparency = Clamp(CoreTransparency, 0, 0.98)
        Core.AlwaysOnTop = ThroughWalls
        Core.Visible = CoreEnabled
        PlayerVisuals.Chams.ApplyAdornmentGeometry(InnerGlow, Part, InnerSize)
        InnerGlow.Color3 = PartGlowColor
        InnerGlow.Transparency = InnerTransparency
        InnerGlow.AlwaysOnTop = ThroughWalls
        InnerGlow.Visible = CoreEnabled and GlowEnabled
        PlayerVisuals.Chams.ApplyAdornmentGeometry(OuterGlow, Part, OuterSize)
        OuterGlow.Color3 = PartGlowColor
        OuterGlow.Transparency = OuterTransparency
        OuterGlow.AlwaysOnTop = ThroughWalls
        OuterGlow.Visible = CoreEnabled and GlowEnabled
    end
    Data.ChamsRenderActive = CoreEnabled
    Data.ChamAppliedVisible = CoreEnabled
    Data.ChamStyleVisible = StyleVisible
    Data.PlayerChamApplied = {Tier = Tier, CoreColor = CoreColor, CoreTransparency = CoreTransparency, GlowColor = GlowColor, GlowEnabled = GlowEnabled,
        GlowTransparency = GlowTransparency, GlowStrength = GlowStrength, GlowSize = Settings.GlowSize, ThroughWalls = ThroughWalls,
        Renderer = "ThreeLayerHandleAdornment+HeadCylinder"}
end

function PlayerVisuals.Chams.SetVisible(Data, Visible)
    if not Data or type(Data.PlayerChamLayers) ~= "table" then return end
    local Settings = Visuals.Player.Chams
    local GlowEnabled = Settings.Glow == true
    local Show = Visible == true
    for _, Entry in pairs(Data.PlayerChamLayers) do
        if type(Entry) ~= "table" then continue end
        if Entry.Core then Entry.Core.Visible = Show end
        if Entry.InnerGlow then Entry.InnerGlow.Visible = Show and GlowEnabled end
        if Entry.OuterGlow then Entry.OuterGlow.Visible = Show and GlowEnabled end
    end
    Data.ChamsRenderActive = Show
end

function PlayerVisuals.Chams.GetTier(Data)
    if not Data or not Data.Root or not Data.Root.Parent then return 0, Infinite end
    local CameraObject = Shared.GetCamera()
    local CameraCFrame = CameraObject and Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    local ViewOrigin = typeof(CameraCFrame) == "CFrame" and CameraCFrame.Position or CameraObject and CameraObject.CFrame.Position
    if not ViewOrigin then return 0, Infinite end
    local Distance = (Data.Root.Position - ViewOrigin).Magnitude
    local MaxDistance = Max(tonumber(Visuals.Player.MaxDistance) or 1200, 1)
    if Distance > MaxDistance then return 0, Distance end
    if Data.Player == Shared.GetActiveConfirmedCombatTarget() then return 3, Distance end
    if Distance <= 350 then return 3, Distance end
    if Distance <= 750 then return 2, Distance end
    return 1, Distance
end

function PlayerVisuals.Material.DestroyProxyModel(Data)

    if not Data then return end
    if type(Data.PlayerMaterialSourceTransparency) == "table" then
        for Source, Value in pairs(Data.PlayerMaterialSourceTransparency) do
            if Source and Source.Parent and Source:IsA("BasePart") and type(Value) == "number" then Source.LocalTransparencyModifier = Value end
        end
    end
    if type(Data.PlayerMaterialExternalTransparency) == "table" then
        for Source, Value in pairs(Data.PlayerMaterialExternalTransparency) do
            if Source and Source.Parent and Source:IsA("BasePart") and type(Value) == "number" then Source.LocalTransparencyModifier = Value end
        end
    end
    if Data.PlayerMaterialModel and Data.PlayerMaterialModel.Parent then Data.PlayerMaterialModel:Destroy() end
    Data.PlayerMaterialModel = nil
    Data.PlayerMaterialProxies = nil
    Data.PlayerMaterialSourceTransparency = nil
    Data.PlayerMaterialExternalTransparency = nil
end

function PlayerVisuals.Material.Disconnect(Data)
    if not Data or type(Data.PlayerMaterialConnections) ~= "table" then return end
    for _, Connection in pairs(Data.PlayerMaterialConnections) do
        if typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    end
    Data.PlayerMaterialConnections = {}
end

function PlayerVisuals.Material.GetAccessory(Object)
