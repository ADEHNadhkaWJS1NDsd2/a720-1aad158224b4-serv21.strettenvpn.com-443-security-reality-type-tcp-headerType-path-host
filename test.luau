                    ["ValidateLibrarySource"] = "text/plain,*/*", ["Cache-Control"] = "no-cache", ["User-Agent"] = "Atramenta.rip"}})
            local Source = Success and Shared.ExtractHTTPBody(Response) or nil
            local Valid = ValidateLibrarySource(Source)
            if Valid then return Valid end
            Errors[#Errors + 1] = Success and ("request returned " .. typeof(Response)) or tostring(Response)
        end
    end
    local HttpGetAttempts = {function() return Game:HttpGet(RuntimeConfig.LibraryUrl, true) end,
        function() return Game.HttpGet(game, RuntimeConfig.LibraryUrl, true) end, function() return Game:HttpGetAsync(RuntimeConfig.LibraryUrl) end}
    for _, Attempt in ipairs(HttpGetAttempts) do
        local Success, Response = Shared.SafeCall(Attempt)
        local Source = Success and Shared.ExtractHTTPBody(Response) or nil
        local Valid = ValidateLibrarySource(Source)
        if Valid then return Valid end
        Errors[#Errors + 1] = Success and ("HttpGet returned " .. typeof(Response)) or tostring(Response)
    end
    local Success, Response = Shared.SafeCall(function()
        return HttpService:GetAsync(RuntimeConfig.LibraryUrl, true)
    end)
    local Source = Success and Shared.ExtractHTTPBody(Response) or nil
    local Valid = ValidateLibrarySource(Source)
    if Valid then return Valid end
    Errors[#Errors + 1] = Success and ("GetAsync returned " .. typeof(Response)) or tostring(Response)
    return nil, Concat(Errors, " | ")
end

function Shared.LoadUIFramework()
    local LibrarySource, RequestError = Shared.FetchLibrarySource()
    if not Shared.IsValidLibrarySource(LibrarySource) then Shared.FailRuntime("invalid library source: " .. tostring(RequestError or "no compatible source")) end
    local LibraryChunk, CompileError = loadstring(LibrarySource, "@AtramentaLibrary")
    if type(LibraryChunk) ~= "function" then Shared.FailRuntime("library compile failed: " .. tostring(CompileError)) end
    local ExecuteSuccess, LibraryResult = Shared.SafeCall(LibraryChunk)
    LibraryChunk = nil
    LibrarySource = nil
    if not ExecuteSuccess then Shared.FailRuntime("library execution failed: " .. tostring(LibraryResult)) end
    if type(LibraryResult) ~= "table" then LibraryResult = rawget(AtramentaEnvironment, "Library") end
    if type(LibraryResult) ~= "table" then Shared.FailRuntime("library returned invalid object") end
    local RequiredMethods = {"Window", "Notification", "Watermark", "KeybindList", "PlayerList", "Panel", "ThemePanel", "ConfigurationPanel", "GetConfig", "LoadConfig", "SaveConfig", "LoadConfigFile", "DeleteConfig", "ListConfigs", "SetDescription"}
    for _, MethodName in ipairs(RequiredMethods) do
        if type(LibraryResult[MethodName]) ~= "function" then Shared.FailRuntime("library API missing " .. MethodName) end
    end
    return LibraryResult
end
