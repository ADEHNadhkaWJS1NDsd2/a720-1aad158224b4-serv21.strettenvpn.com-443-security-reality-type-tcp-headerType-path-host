function StopWorldESPRepair()
    local Connection = Visuals.WorldESP.RepairConnection
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    Visuals.WorldESP.RepairConnection = nil
    Visuals.WorldESP.RepairClock = 0
end
function StartWorldESPRepair()
    if Visuals.WorldESP.RepairConnection then return end
    Visuals.WorldESP.RepairClock = 0
    Visuals.WorldESP.RepairConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if Visuals.WorldESP.Safes ~= true and Visuals.WorldESP.Cash ~= true and Visuals.WorldESP.Dropped ~= true then
            StopWorldESPRepair()
            return
        end
        Visuals.WorldESP.RepairClock += Clamp(tonumber(DeltaTime) or 0, 0, 0.1)
        local Interval = Max(tonumber(Visuals.WorldESP.RepairInterval) or 1, 0.25)
        if Visuals.WorldESP.RepairClock < Interval then return end
        Visuals.WorldESP.RepairClock = Visuals.WorldESP.RepairClock % Interval
        Shared.SafeCall(UpdateWorldESP, false)
    end)
end
function ClearWorldESPLabels()
    StopWorldESPRepair()
    DisconnectWorldESPEvents()
    ClearWorldESPKind(nil)
    local CurrentPlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or PlayerGui
