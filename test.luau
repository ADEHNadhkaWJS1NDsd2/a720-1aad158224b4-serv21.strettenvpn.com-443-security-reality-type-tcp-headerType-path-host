function Shared.GetLocalShotEvidenceScore(Shot)
    if type(Shot) ~= "table" then return 0 end
    local Score = 0
    if Shot.RemoteConfirmed == true then Score += 5 end
    if Shot.AmmoConfirmed == true then Score += 4 end
    if Shot.SignalConfirmed == true then Score += 5 end
    if Shot.RageRemoteSent == true then Score += 4 end
    if Shot.DamagePacketSent == true then Score += 3 end
    if Shot.Token ~= nil then Score += 1 end
    if Shot.LocalIntent == true then Score += 1 end
    local Source = Shared.NormalizeLocalAttackSource(Shot.Source)
    if Source == "RageBot" or Source == "SilentAim" or Source == "HBE" then Score += 1 end
    return Score
end
function Shared.IsOwnedLocalShot(Shot, Minimum)
