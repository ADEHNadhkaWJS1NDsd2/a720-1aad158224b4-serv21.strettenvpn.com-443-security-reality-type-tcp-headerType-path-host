function Shared.GetPlayerESPVisualPartGeometry(Part)
    if not Part or not Part:IsA("BasePart") then return nil, nil end
    local VisualCFrame = Part.CFrame
    local VisualSize = Shared.GetPhysicalHbeVisualSize(Part) or Part.Size
    local CanonicalSize = GetESPR6CanonicalPartSize(Part)
    if typeof(CanonicalSize) == "Vector3" then
        local TooSmall = VisualSize.X < CanonicalSize.X * 0.40 or VisualSize.Y < CanonicalSize.Y * 0.40 or VisualSize.Z < CanonicalSize.Z * 0.40
        local TooLarge = VisualSize.X > CanonicalSize.X * 2.20 or VisualSize.Y > CanonicalSize.Y * 2.20 or VisualSize.Z > CanonicalSize.Z * 2.20
        if TooSmall or TooLarge then VisualSize = CanonicalSize end
    end
    if Part.Name == "Head" then
        local Mesh = Part:FindFirstChildWhichIsA("SpecialMesh")
        if Mesh and typeof(Mesh.Offset) == "Vector3" then VisualCFrame = VisualCFrame * NewCFrame(Mesh.Offset) end
    end
    return VisualCFrame, VisualSize
end
function Shared.ScalePlayerESPBox(Position, Size, Scale, Padding)
    if typeof(Position) ~= "Vector2" or typeof(Size) ~= "Vector2" then return nil, nil end
    Scale = Clamp(tonumber(Scale) or 1, 0.60, 1.50)
    Padding = Max(tonumber(Padding) or 0, 0)
    local Center = Position + Size * 0.5
    local NewSize = NewVector2(Max(Size.X * Scale + Padding * 2, 4), Max(Size.Y * Scale + Padding * 2, 8))
    return Center - NewSize * 0.5, NewSize
end

function Shared.ProjectPlayerESPLocalBounds(CameraObject, RootCFrame, Minimum, Maximum)
    if not CameraObject or typeof(RootCFrame) ~= "CFrame" or typeof(Minimum) ~= "Vector3" or typeof(Maximum) ~= "Vector3" then
        return nil
    end
    local CameraCFrame = Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    if typeof(CameraCFrame) ~= "CFrame" then return nil end
    local ToRoot = RootCFrame.Position - CameraCFrame.Position
    local RootDistance = ToRoot.Magnitude
    if RootDistance <= 0.001 or CameraCFrame.LookVector:Dot(ToRoot / RootDistance) <= 0 then
        return nil
    end
    local MinX, MinY = Infinite, Infinite
    local MaxX, MaxY = -Infinite, -Infinite
    for XIndex = 0, 1 do
        local X = XIndex == 0 and Minimum.X or Maximum.X
        for YIndex = 0, 1 do
            local Y = YIndex == 0 and Minimum.Y or Maximum.Y
            for ZIndex = 0, 1 do
                local Z = ZIndex == 0 and Minimum.Z or Maximum.Z
                local WorldPoint = RootCFrame:PointToWorldSpace(NewVector3(X, Y, Z))
                local CameraDelta = WorldPoint - CameraCFrame.Position
                if CameraDelta:Dot(CameraCFrame.LookVector) <= 0.05 then return nil end
                local Screen = Shared.PlayerESPWorldToViewportPoint(CameraObject, WorldPoint)
                if Screen.Z <= 0.05 then return nil end
                MinX = Min(MinX, Screen.X)
                MinY = Min(MinY, Screen.Y)
                MaxX = Max(MaxX, Screen.X)
                MaxY = Max(MaxY, Screen.Y)
            end
        end
    end
    if MinX == Infinite or MinY == Infinite or MaxX == -Infinite or MaxY == -Infinite then
        return nil
    end
    return NewVector2(MinX, MinY), NewVector2(Max(MaxX - MinX, 2), Max(MaxY - MinY, 4))
end
function Shared.GetPlayerESPWorldBounds(Data)
