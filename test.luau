function Shared.ApplyOverlayPrimitive(Object)
    if type(Object) ~= "table" or Object.__destroyed == true then return false end
    local Gui = rawget(Object, "__gui")
    if not Gui or not Gui.Parent then return false end
    local Kind = rawget(Object, "__kind")
    local Properties = rawget(Object, "__properties")
    if type(Properties) ~= "table" then return false end

    local Visible = Properties.Visible == true
    Gui.Visible = Visible
    Gui.ZIndex = Clamp(Floor(tonumber(Properties.ZIndex) or 1), 1, 100)

    local Opacity = Clamp(tonumber(Properties.Transparency) or 1, 0, 1)
    local Color = typeof(Properties.Color) == "Color3" and Properties.Color or NewColor3(1, 1, 1)

    if Kind == "Line" then
        local From = typeof(Properties.From) == "Vector2" and Properties.From or EmptyVector2
        local To = typeof(Properties.To) == "Vector2" and Properties.To or From
        local Delta = To - From
        local Length = Delta.Magnitude
        local Thickness = Max(tonumber(Properties.Thickness) or 1, 0.5)
        Gui.AnchorPoint = NewVector2(0.5, 0.5)
        Gui.Position = FromOffset((From.X + To.X) * 0.5, (From.Y + To.Y) * 0.5)
        Gui.Size = FromOffset(Max(Length, 0.5), Thickness)
        Gui.Rotation = Length > 0.001 and Deg(Atan2(Delta.Y, Delta.X)) or 0
        Gui.BackgroundColor3 = Color
        Gui.BackgroundTransparency = 1 - Opacity
    elseif Kind == "Square" then
        local Position = typeof(Properties.Position) == "Vector2" and Properties.Position or EmptyVector2
        local Size = typeof(Properties.Size) == "Vector2" and Properties.Size or EmptyVector2
        local Filled = Properties.Filled == true
        Gui.AnchorPoint = EmptyVector2
        Gui.Position = FromOffset(Position.X, Position.Y)
        Gui.Size = FromOffset(Max(Size.X, 0), Max(Size.Y, 0))
        Gui.BackgroundColor3 = Color
        Gui.BackgroundTransparency = Filled and (1 - Opacity) or 1
        local Stroke = rawget(Object, "__stroke")
        if Stroke then
            Stroke.Enabled = not Filled
            Stroke.Color = Color
            Stroke.Thickness = Max(tonumber(Properties.Thickness) or 1, 0.5)
            Stroke.Transparency = 1 - Opacity
        end
    elseif Kind == "Circle" then
        local Position = typeof(Properties.Position) == "Vector2" and Properties.Position or EmptyVector2
        local Radius = Max(tonumber(Properties.Radius) or 0, 0)
        local Filled = Properties.Filled == true
        Gui.AnchorPoint = NewVector2(0.5, 0.5)
        Gui.Position = FromOffset(Position.X, Position.Y)
        Gui.Size = FromOffset(Radius * 2, Radius * 2)
        Gui.BackgroundColor3 = Color
        Gui.BackgroundTransparency = Filled and (1 - Opacity) or 1
        local Stroke = rawget(Object, "__stroke")
        if Stroke then
            Stroke.Enabled = not Filled
            Stroke.Color = Color
            Stroke.Thickness = Max(tonumber(Properties.Thickness) or 1, 0.5)
            Stroke.Transparency = 1 - Opacity
        end
    elseif Kind == "Text" then
        local Position = typeof(Properties.Position) == "Vector2" and Properties.Position or EmptyVector2
        local Center = Properties.Center == true
        local TextSize = Shared.GetOverlayTextSize(Properties.Size)
        Gui.AnchorPoint = Center and NewVector2(0.5, 0) or EmptyVector2
        Gui.Position = FromOffset(Position.X, Position.Y)
        Gui.Size = FromOffset(500, TextSize + 6)
        Gui.Text = tostring(Properties.Text or "")
        Gui.TextSize = TextSize
        Gui.TextColor3 = Color
        Gui.TextTransparency = 1 - Opacity
        Gui.TextXAlignment = Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
        Gui.TextStrokeColor3 = typeof(Properties.OutlineColor) == "Color3" and Properties.OutlineColor or NewColor3(0, 0, 0)
        Gui.TextStrokeTransparency = Properties.Outline == true and Clamp(1 - Opacity + 0.15, 0, 1) or 1
    elseif Kind == "Image" then
        local Position = typeof(Properties.Position) == "Vector2" and Properties.Position or EmptyVector2
        local Size = typeof(Properties.Size) == "Vector2" and Properties.Size or EmptyVector2
        Gui.AnchorPoint = EmptyVector2
        Gui.Position = FromOffset(Position.X, Position.Y)
        Gui.Size = FromOffset(Max(Size.X, 0), Max(Size.Y, 0))
        Gui.ImageColor3 = Color
        Gui.ImageTransparency = 1 - Opacity
        local Data = Properties.Data
        if type(Data) == "string" and (StringFind(Data, "rbxasset", 1, true) == 1 or StringFind(Data, "rbxthumb", 1, true) == 1 or StringFind(Data, "http", 1, true) == 1) then
            Gui.Image = Data
        end
        local Corner = rawget(Object, "__corner")
        if Corner then
            local Rounding = Max(tonumber(Properties.Rounding) or 0, 0)
            Corner.CornerRadius = NewUDim(0, Rounding)
        end
    end
    return true
end

function Shared.CreateOverlayPrimitive(PrimitiveType, Properties)
    local Root = Shared.GetOverlayPrimitiveRoot()
    if not Root then return nil end

    Shared.OverlayPrimitiveSerial += 1
    local Gui
    local Stroke
    local Corner

    if PrimitiveType == "Text" then
        Gui = NewInstance("TextLabel")
        Gui.BackgroundTransparency = 1
        Gui.BorderSizePixel = 0
        Gui.TextScaled = false
        Gui.TextWrapped = false
        if typeof(EspUiFont) == "Font" then
            Gui.FontFace = EspUiFont
        else
            Gui.Font = Enum.Font.Code
        end
        Gui.TextYAlignment = Enum.TextYAlignment.Top
    elseif PrimitiveType == "Image" then
        Gui = NewInstance("ImageLabel")
        Gui.BackgroundTransparency = 1
        Gui.BorderSizePixel = 0
        Gui.ScaleType = Enum.ScaleType.Fit
        Corner = NewInstance("UICorner")
        Corner.Parent = Gui
    else
        Gui = NewInstance("Frame")
        Gui.BorderSizePixel = 0
        if PrimitiveType == "Square" or PrimitiveType == "Circle" then
            Stroke = NewInstance("UIStroke")
            Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            Stroke.Parent = Gui
        end
        if PrimitiveType == "Circle" then
            Corner = NewInstance("UICorner")
            Corner.CornerRadius = NewUDim(1, 0)
            Corner.Parent = Gui
        end
    end

    Gui.Name = "Primitive" .. tostring(Shared.OverlayPrimitiveSerial)
    Gui.Visible = false
    Gui.Parent = Root

    local Object = {
        __overlayPrimitive = true,
        __destroyed = false,
        __kind = PrimitiveType,
        __gui = Gui,
        __stroke = Stroke,
        __corner = Corner,
        __properties = {}
    }

    local Meta
    Meta = {
        __index = function(Self, Key)
            if Key == "Destroy" or Key == "Remove" then
                return function()
                    if rawget(Self, "__destroyed") == true then return end
                    rawset(Self, "__destroyed", true)
                    local CurrentGui = rawget(Self, "__gui")
                    if CurrentGui then
                        pcall(function() CurrentGui:Destroy() end)
                    end
                    rawset(Self, "__gui", nil)
                end
            end
            if Key == "TextBounds" and PrimitiveType == "Text" then
                local CurrentGui = rawget(Self, "__gui")
                if CurrentGui and CurrentGui.Parent then
                    local Success, Bounds = pcall(function() return CurrentGui.TextBounds end)
                    if Success and typeof(Bounds) == "Vector2" then return Bounds end
                end
                local P = rawget(Self, "__properties")
                return NewVector2(#tostring(P.Text or "") * Shared.GetOverlayTextSize(P.Size) * 0.55, Shared.GetOverlayTextSize(P.Size))
            end
            local P = rawget(Self, "__properties")
            return P and P[Key] or nil
        end,
        __newindex = function(Self, Key, Value)
            if Sub(tostring(Key), 1, 2) == "__" then
                rawset(Self, Key, Value)
                return
            end
            local P = rawget(Self, "__properties")
            P[Key] = Value
            Shared.ApplyOverlayPrimitive(Self)
        end
    }
    setmetatable(Object, Meta)

    Object.Visible = false
    for Property, Value in pairs(Properties or {}) do
        Object[Property] = Value
    end
    Shared.ApplyOverlayPrimitive(Object)
    return Object
end

function Shared.IsOverlayPrimitive(Object)
    return type(Object) == "table" and rawget(Object, "__overlayPrimitive") == true and rawget(Object, "__destroyed") ~= true
        and rawget(Object, "__gui") ~= nil and rawget(Object, "__gui").Parent ~= nil
end

function Shared.SetOverlayProperty(Object, Property, Value)
    if not Shared.IsOverlayPrimitive(Object) then return false end
    local Success = pcall(function() Object[Property] = Value end)
    return Success == true
end

function Shared.GetOverlayProperty(Object, Property)
    if not Shared.IsOverlayPrimitive(Object) then return nil, false end
    local Success, Value = pcall(function() return Object[Property] end)
    return Success and Value or nil, Success
end

function Shared.DestroyOverlayPrimitive(Object)
    if not Object then return end
    local Success, Destroy = pcall(function() return Object.Destroy end)
    if Success and type(Destroy) == "function" then pcall(Destroy, Object) end
end

