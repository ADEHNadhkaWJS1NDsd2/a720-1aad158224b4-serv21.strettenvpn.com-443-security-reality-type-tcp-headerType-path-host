function ExtendedVisuals:EmitJumpCircle(Position)
    if not self.JumpCircles.Enabled or typeof(Position) ~= "Vector3" then return end
    local Holder = NewInstance("Part")
    Holder.Name = "AtramentaJumpCircle"
    Holder.Anchored = true
    Holder.CanCollide = false
    Holder.CanTouch = false
    Holder.CanQuery = false
    Holder.CastShadow = false
    Holder.Transparency = 1
    Holder.Size = NewVector3(0.1, 0.1, 0.1)
    Holder.CFrame = NewCFrame(Position + NewVector3(0, 0.035, 0))
    Holder.Parent = workspace
    local Segments = Clamp(Floor(tonumber(self.JumpCircles.Segments) or 28), 12, 48) local Attachments = Table.create(Segments)
    local Beams = Table.create(Segments) local StartRadius = 0.65
    for Index = 1, Segments do
        local Angle = ((Index - 1) / Segments) * Pi * 2 local Attachment = NewInstance("Attachment")
        Attachment.Name = "Point" .. tostring(Index)
        Attachment.Position = NewVector3(Cos(Angle) * StartRadius, 0, Sin(Angle) * StartRadius)
        Attachment.Parent = Holder
        Attachments[Index] = Attachment
    end
    for Index = 1, Segments do
        local Beam = NewInstance("Beam")
        Beam.Name = "Segment" .. tostring(Index)
        Beam.Attachment0 = Attachments[Index]
        Beam.Attachment1 = Attachments[Index % Segments + 1]
        Beam.FaceCamera = true
        Beam.LightEmission = 1
        Beam.LightInfluence = 0
        Beam.Width0 = self.JumpCircles.Width
        Beam.Width1 = self.JumpCircles.Width
        Beam.Color = ColorSequence.new(self.JumpCircles.Color)
        Beam.Transparency = NumberSequence.new(0.06)
        Beam.Parent = Holder
        Beams[Index] = Beam
    end
    self.JumpCircles.Active[#self.JumpCircles.Active + 1] = {Holder = Holder, Attachments = Attachments, Beams = Beams, Time = 0, Segments = Segments,
        StartRadius = StartRadius}
end
function ExtendedVisuals:GetJumpCircleLandingPosition(Character, RootPart)
    if not Character or not RootPart then return nil end
    local Params = NewRaycastParams()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = {Character}
    Params.IgnoreWater = false
    local Result = Workspace:Raycast(RootPart.Position + NewVector3(0, 1.0, 0), NewVector3(0, -12, 0), Params)
    if Result then return Result.Position + Result.Normal * 0.035 end
    return RootPart.Position - NewVector3(0, 2.85, 0)
end
function ExtendedVisuals:UpdateJumpCircles(DeltaTime)
    local Circles = self.JumpCircles
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if Circles.Enabled and Humanoid and RootPart then
        local FloorMaterial = Humanoid.FloorMaterial
        local State = Humanoid:GetState()
        local VelocityY = RootPart.AssemblyLinearVelocity.Y
        local Grounded = FloorMaterial ~= Enum.Material.Air
        local Jumping = State == Enum.HumanoidStateType.Jumping or VelocityY > 2.2
        if Circles.Character ~= Character then
            Circles.Character = Character
            Circles.LastFloor = FloorMaterial
            Circles.WasAirborne = not Grounded
            Circles.JumpArmed = false
            Circles.JumpStartedAt = 0
            Circles.AirborneStartedAt = not Grounded and Clock() or 0
        else
            local PreviousGrounded = Circles.LastFloor ~= nil and Circles.LastFloor ~= Enum.Material.Air
            local TookOff = PreviousGrounded and not Grounded
            local Landed = not PreviousGrounded and Grounded
            if Grounded and Jumping and not Circles.JumpArmed then
                Circles.JumpArmed = true
                Circles.JumpStartedAt = Clock()
            end
            if TookOff then
                Circles.WasAirborne = true
                Circles.AirborneStartedAt = Clock()
                if Jumping then
                    Circles.JumpArmed = true
                    if Circles.JumpStartedAt <= 0 then Circles.JumpStartedAt = Clock() end
                end
            elseif not Grounded then
                if not Circles.WasAirborne then Circles.AirborneStartedAt = Clock() end
                Circles.WasAirborne = true
                if not Circles.JumpArmed and (State == Enum.HumanoidStateType.Jumping or VelocityY > 1.2) then
                    Circles.JumpArmed = true
                    Circles.JumpStartedAt = Clock()
                end
            end
            if Landed then
                local Now = Clock()
                local AirTime = Circles.AirborneStartedAt > 0 and Now - Circles.AirborneStartedAt or 0
                local JumpAge = Circles.JumpStartedAt > 0 and Now - Circles.JumpStartedAt or Infinite
                local ValidJump = Circles.WasAirborne == true and Circles.JumpArmed == true and AirTime >= 0.06 and JumpAge <= 3.5
                if ValidJump then
                    local LandingPosition = self:GetJumpCircleLandingPosition(Character, RootPart)
                    if LandingPosition then self:EmitJumpCircle(LandingPosition) end
                end
                Circles.WasAirborne = false
                Circles.JumpArmed = false
                Circles.JumpStartedAt = 0
                Circles.AirborneStartedAt = 0
            end
            Circles.LastFloor = FloorMaterial
        end
    else
        if not Character or not Circles.Enabled then
            Circles.Character = Character
            Circles.LastFloor = Humanoid and Humanoid.FloorMaterial or nil
            Circles.WasAirborne = false
            Circles.JumpArmed = false
            Circles.JumpStartedAt = 0
            Circles.AirborneStartedAt = 0
        end
    end
    local Duration = Max(tonumber(Circles.Duration) or 0.48, 0.08)
    local MaximumRadius = Max(tonumber(Circles.Radius) or 7, 1)
    local Width = Max(tonumber(Circles.Width) or 0.075, 0.01)
    for Index = #Circles.Active, 1, -1 do
        local Entry = Circles.Active[Index]
        if not Entry or not Entry.Holder or not Entry.Holder.Parent then
            Remove(Circles.Active, Index)
        else
            Entry.Time += DeltaTime
            local Alpha = Clamp(Entry.Time / Duration, 0, 1)
            local Ease = 1 - (1 - Alpha) ^ 3
            local Radius = Entry.StartRadius + (MaximumRadius - Entry.StartRadius) * Ease
            local Transparency = Clamp(0.04 + Alpha ^ 1.35 * 0.96, 0, 1)
            local BeamWidth = Width * (1 - Alpha * 0.45)
            for PointIndex = 1, Entry.Segments do
                local Attachment = Entry.Attachments[PointIndex]
                if Attachment and Attachment.Parent then
                    local Angle = ((PointIndex - 1) / Entry.Segments) * Pi * 2
                    Attachment.Position = NewVector3(Cos(Angle) * Radius, 0, Sin(Angle) * Radius)
                end
                local Beam = Entry.Beams[PointIndex]
                if Beam and Beam.Parent then
                    Beam.Color = ColorSequence.new(Circles.Color)
                    Beam.Width0 = BeamWidth
                    Beam.Width1 = BeamWidth
                    Beam.Transparency = NumberSequence.new(Transparency)
                end
            end
            if Alpha >= 1 then
                Entry.Holder:Destroy()
                Remove(Circles.Active, Index)
            end
        end
    end
end
