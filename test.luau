    Copy.VelocityDesyncOffset = Copy.VelocityDesync and (typeof(VelocityDesync.AppliedOffset) == "Vector3" and VelocityDesync.AppliedOffset or VelocityDesync.CurrentOffset) or nil
    Copy.VelocityDesyncFakeVelocity = Copy.VelocityDesync and VelocityDesync.FakeVelocity or nil
