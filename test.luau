    local ShowAmmo = Visuals.Player.Ammo.Enabled and type(AmmoCurrent) == "number" and type(AmmoMaximum) == "number" and AmmoMaximum > 0
    local AmmoOffset = GetPlayerESPPreviewOffset("Ammo")
    Ui.AmmoBack.Visible = ShowAmmo
    Ui.Ammo.Visible = ShowAmmo
