SilentAimHitboxDefinitions = {{Name = "Head", Parts = {"Head"}},
    {Name = "Chest", Parts = {"UpperTorso", "Torso"}}, {Name = "Stomach", Parts = {"LowerTorso", "Torso", "HumanoidRootPart"}},
    {Name = "Root", Parts = {"HumanoidRootPart"}}, {Name = "Left Arm", Parts = {"LeftUpperArm", "LeftLowerArm", "LeftHand", "Left Arm"}},
    {Name = "Right Arm", Parts = {"RightUpperArm", "RightLowerArm", "RightHand", "Right Arm"}},
    {Name = "Left Leg", Parts = {"LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "Left Leg"}},
    {Name = "Right Leg", Parts = {"RightUpperLeg", "RightLowerLeg", "RightFoot", "Right Leg"}}}
