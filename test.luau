function Ragebot.GetTargetScreenParts(Character)
    if not Character then return {} end
    local Parts = {}
    local Seen = {}
    local function Add(Part)
        if Part and Part:IsA("BasePart") and not Seen[Part] then
            Seen[Part] = true
            Parts[#Parts + 1] = Part
        end
    end
    Add(Character:FindFirstChild(tostring(Ragebot.Settings.TargetPart or "Head")))
    Add(Character:FindFirstChild("Head"))
    Add(Character:FindFirstChild("Torso"))
    Add(Character:FindFirstChild("HumanoidRootPart"))
    return Parts
