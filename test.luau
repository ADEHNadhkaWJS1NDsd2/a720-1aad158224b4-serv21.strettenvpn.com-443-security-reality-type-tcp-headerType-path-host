function ResolveCombatPosition(Player, Character, TargetPart, PredictionTime, Settings, Context)
    if not Character or not TargetPart or not TargetPart:IsA("BasePart") then return nil, nil, 0, 0 end
    Settings = Settings or {} Context = type(Context) == "table" and Context or {}
    local TimeValue = Clamp(tonumber(PredictionTime) or 0, 0, Res.MaximumPrediction)
    local Root = Context.Root or ResolverGetRootPart(Character) local Humanoid = Context.Humanoid or Character:FindFirstChildOfClass("Humanoid")
    local Reported = Root and (Root.AssemblyLinearVelocity or Root.Velocity or EmptyVector3) or EmptyVector3
    Reported = ResolverClampVector(Reported, 240)
    local UseResolver = Context.ResolverEnabled if UseResolver == nil then UseResolver = Settings.Resolver ~= false end
    local Velocity, Data = Reported, nil
    if UseResolver == true and Player then Velocity, Data = ResolverGetMovementVelocity(Player, Character, Settings) end
    if Humanoid and Humanoid.FloorMaterial ~= Enum.Material.Air and Abs(Velocity.Y) < 9 then Velocity = NewVector3(Velocity.X, 0, Velocity.Z) end
    local Ticks = 0
    if UseResolver == true and Data and Settings.AdaptiveExtrapolation ~= false then
        local LeadTicks, LeadTime = ResolverGetLeadVelocity(Data, Settings)
        Ticks = LeadTicks
        TimeValue = Clamp(TimeValue + LeadTime * 0.35, 0, Res.MaximumPrediction)
    end
    local Position = TargetPart.Position + Velocity * TimeValue
    return Position, Data, Ticks, TimeValue
end
