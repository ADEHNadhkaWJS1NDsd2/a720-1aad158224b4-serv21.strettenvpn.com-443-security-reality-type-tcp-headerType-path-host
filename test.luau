function AutoBlockGetMeleeConfig(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return nil
    end
    if type(GetMeleeAuraConfig)
        == "function" then
        local Config = GetMeleeAuraConfig(Tool)
        if type(Config) == "table" and type(Config.Mains) == "table" then
            return Config
        end
    end
    local Module = Tool:FindFirstChild("Config") or Tool:FindFirstChild("Config", true)
    if Module and Module:IsA("ModuleScript") then
        local Success, Config = Shared.SafeCall(require, Module)
        if Success and type(Config) == "table" and type(Config.Mains) == "table" then
            return Config
        end
    end
    return nil
end

function AutoBlockToolCanBlock(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return false
    end
    local Cached = AutoBlockState.BlockCache[Tool]
    if Cached ~= nil then
        return Cached == true
    end
    local Config = AutoBlockGetMeleeConfig(Tool)
    if type(Config) == "table" then
        local Settings = Config.BlockSettings
        if type(Settings) == "table" then
            local CanBlock = Settings.Enabled == true
            AutoBlockState.BlockCache[Tool] = CanBlock
            return CanBlock
        end
    end
    if Tool:GetAttribute("CanBlock") == false then
        AutoBlockState.BlockCache[Tool] = false
        return false
    end
    local Anims = Tool:FindFirstChild("AnimsFolder")
    local CanBlock = Tool:GetAttribute("CanBlock") == true or (Anims and (Anims:FindFirstChild("BlockStart") or Anims:FindFirstChild("BlockIdle"))) ~= nil
    AutoBlockState.BlockCache[Tool] = CanBlock == true
    return CanBlock == true
end

function AutoBlockGetAttackWindow(Config)
    if type(Config) ~= "table" or type(Config.Mains) ~= "table" then
        return 0.34
    end
    local Maximum = 0.24
    for Key, Stage in pairs(Config.Mains) do
        if type(Key) == "string" and Key:match("^S%d+$") and type(Stage) == "table" then
            local SwingWait = Max(tonumber(Stage.SwingWait) or 0, 0)
            local SwingTime = Max(tonumber(Stage.SwingTime) or 0.12, 0)
            Maximum = Max(Maximum, SwingWait + SwingTime + 0.10)
        end
    end
    return Clamp(Maximum, 0.24, 1.35)
end

function AutoBlockBuildAttackAnimationCache(Tool, Config)
    local Cached = AutoBlockState.AttackAnimationCache[Tool]
    if type(Cached) == "table" and Cached.Parent
            == Tool.Parent then
        return Cached
    end
    local Data = {Parent = Tool.Parent, Ids = {}, Names = {}}
    local Folder = Tool:FindFirstChild("AnimsFolder")
    if Folder then
        for _, Object in ipairs(Folder:GetDescendants()) do
            if Object:IsA("Animation") then
                local Name = Lower(Object.Name)
                local Offensive = StringFind(Name, "slash", 1, true) or StringFind(Name, "swing", 1, true) or StringFind(Name, "attack", 1, true) or StringFind(Name, "lunge",
                        1, true) or StringFind(Name, "heavy", 1, true) or Name == "m3"
                if Offensive then
                    Data.Names[Name] = true
                    local Id = tostring(Object.AnimationId or "")
                    if Id ~= "" then Data.Ids[Id] = true end
                end
            end
        end
    end
    local SlashStages = type(Config) == "table" and Clamp(Floor(tonumber(Config.SlashStages) or 8), 1, 32) or 8
    for Index = 1, SlashStages do
        Data.Names["slash" .. tostring(Index)] = true
    end
    AutoBlockState.AttackAnimationCache[Tool] = Data
    return Data
end

function AutoBlockToolSignalsAttack(Tool)
    if not Tool then
        return false
    end
    local Values = Tool:FindFirstChild("Values")
    if Values then
        for _, Value in ipairs(Values:GetChildren()) do
            if Value:IsA("BoolValue") and Value.Value == true then
                local Name = Lower(tostring(Value.Name))
                if (StringFind(Name, "attack", 1, true) or StringFind(Name, "slash", 1, true) or StringFind(Name, "swing", 1, true) or StringFind(Name, "heavy", 1, true)
                    or Name == "m3") and not StringFind(Name, "block", 1, true) then
                    return true
                end
            end
        end
    end
    local Attributes = Tool:GetAttributes()
    for Name, Value in pairs(Attributes) do
        if Value == true then
            local AttributeLower = Lower(tostring(Name))
            if (StringFind(AttributeLower, "attack", 1, true) or StringFind(AttributeLower, "slash", 1, true) or StringFind(AttributeLower, "swing", 1, true) or StringFind(
                    AttributeLower, "heavy", 1, true) or AttributeLower == "m3") and not StringFind(AttributeLower, "block", 1, true) then
                return true
            end
        end
    end
    return false
end

function AutoBlockAnimationIsAttack(Track, Cache)
    if not Track or type(Cache) ~= "table" then
        return false
    end
    local Name = Lower(tostring(Track.Name or ""))
    if Cache.Names[Name] then
        return true
    end
    if StringFind(Name, "slash", 1, true) or StringFind(Name, "swing", 1, true) or StringFind(Name, "attack", 1, true) or StringFind(Name, "lunge", 1, true) or StringFind(
            Name, "heavy", 1, true) then
        return true
    end
    local Success, AnimationId = Shared.SafeCall(
            function()
                local Animation = Track.Animation
                return Animation and Animation.AnimationId or nil
            end)
    if Success and AnimationId and Cache.Ids[tostring(AnimationId)] then
        return true
    end
    return false
end

function AutoBlockPlayerAttacking(Player, CurrentTime)
    if not Player or not Player.Character then
        return false, nil, nil
    end
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Character = Player.Character
    local Tool = Character:FindFirstChildOfClass("Tool")
    if not Tool or Tool:GetAttribute("Unblockable") == true or Tool:GetAttribute("IgnoreBlock") == true then
        AutoBlockState.AttackUntil[Player] = nil
        return false, nil, nil
    end
    local Config = AutoBlockGetMeleeConfig(Tool)
    if type(Config) ~= "table" or type(Config.Mains) ~= "table" then
        AutoBlockState.AttackUntil[Player] = nil
        return false, Tool, nil
    end
    local Attacking = AutoBlockToolSignalsAttack(Tool)
    if not Attacking then
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if Humanoid then
            local Cache = AutoBlockBuildAttackAnimationCache(Tool, Config)
            for _, Track in ipairs(Humanoid:GetPlayingAnimationTracks()) do
                if AutoBlockAnimationIsAttack(Track, Cache) then
                    Attacking = true
                    break
                end
            end
        end
    end
    if Attacking then AutoBlockState.AttackUntil[Player] = CurrentTime + AutoBlockGetAttackWindow(Config) end
    local HoldUntil = tonumber(AutoBlockState.AttackUntil[Player]) or 0
    return CurrentTime
        <= HoldUntil, Tool, Config
end

function AutoBlockSend(State, Tool)
    local Remote = AutoBlockGetRemote()
    if not Remote or not Tool or not Tool.Parent then
        return false
    end
    local Code = State and "BLSTAX1" or "BZLZSTI2"
    local Success, Accepted = Shared.SafeCall(
            function()
                return Remote:InvokeServer("🍞", tick(), Tool, Code)
            end)
    if not Success then
        return false
    end
    if State then
        return Accepted == true
    end
    return true
end

function AutoBlockRestoreFacing()
    local State = AutoBlockState
    if State.FacingApplied ~= true then
        return
    end
    local Root = State.FacingRoot
    local Rotation = State.FacingRotation
    State.FacingApplied = false
    State.FacingRoot = nil
    State.FacingRotation = nil
    if not Root or not Root.Parent or typeof(Rotation)
            ~= "CFrame" then
        return
    end
    Root.CFrame = NewCFrame(Root.Position) * Rotation
end

function AutoBlockCanSpoofFacing()
    if type(VelocityDesync) == "table" and VelocityDesync.Enabled == true then
        return false
    end
    if type(VelocityDesyncRageOwnsRoot) == "function" and VelocityDesyncRageOwnsRoot() then
        return false
    end
    if Ragebot and Ragebot.Runtime and Ragebot.Runtime.TPHitBusy
            == true then
        return false
    end
    return true
end

function AutoBlockApplyOmniFacing()
    local State = AutoBlockState
    if State.Enabled ~= true or State.Blocking ~= true or State.AutoRotate ~= true or not AutoBlockCanSpoofFacing() then
        return
    end
    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local ThreatRoot = State.ThreatRoot
    if not Root or not Root:IsA("BasePart") or Root.Anchored or not ThreatRoot or not ThreatRoot.Parent or not ThreatRoot:IsA("BasePart") then
        return
    end
    local FlatDelta = NewVector3(ThreatRoot.Position.X - Root.Position.X, 0, ThreatRoot.Position.Z - Root.Position.Z)
    if FlatDelta.Magnitude
        <= 0.001 then
        return
    end
    local Direction = FlatDelta.Unit
    local Dot = Root.CFrame.LookVector:Dot(Direction)
    if Dot >= 0.35 then
        return
    end
    if State.FacingApplied then AutoBlockRestoreFacing() end
    local Current = Root.CFrame
    State.FacingRoot = Root
    State.FacingRotation = Current - Current.Position
    State.FacingApplied = true
    Root.CFrame = LookAt(Root.Position, Root.Position + Direction, Vector3.yAxis)
end

function AutoBlockSetAutoRotate(Enabled)
    local State = AutoBlockState
    State.AutoRotate = Enabled == true
    if State.AutoRotate ~= true then AutoBlockRestoreFacing() end
    return State.AutoRotate
end

function AutoBlockStartFacingRuntime()
    local State = AutoBlockState
    if State.FacingConnection then
        Shared.SafeDisconnect(State.FacingConnection)
        State.FacingConnection = nil
    end
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep("AtramentaAutoBlockFacingRestore")
    end)
    State.FacingConnection = RunService.PreSimulation:Connect(AutoBlockApplyOmniFacing)
    Shared.SafeCall(
        function()
            RunService:BindToRenderStep("AtramentaAutoBlockFacingRestore", 198, AutoBlockRestoreFacing)
        end)
end

function AutoBlockStopFacingRuntime()
    local State = AutoBlockState
    if State.FacingConnection then
        Shared.SafeDisconnect(State.FacingConnection)
        State.FacingConnection = nil
    end
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep("AtramentaAutoBlockFacingRestore")
    end)
    AutoBlockRestoreFacing()
    State.ThreatRoot = nil
    State.ThreatPlayer = nil
    State.ThreatTool = nil
end

function AutoBlockStep()
    local State = AutoBlockState
    if State.Enabled ~= true then
        return
    end
    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Tool = Character and Character:FindFirstChildOfClass("Tool")
    if not Root or not Root:IsA("BasePart") or not Tool or not AutoBlockToolCanBlock(Tool) then
        if State.Blocking and State.BlockingTool then AutoBlockSend(false, State.BlockingTool) end
        State.Blocking = false
        State.BlockingTool = nil
        State.ThreatRoot = nil
        State.ThreatPlayer = nil
        State.ThreatTool = nil
        return
    end
    if State.Blocking and State.BlockingTool and State.BlockingTool
            ~= Tool then
        AutoBlockSend(false, State.BlockingTool)
        State.Blocking = false
        State.BlockingTool = nil
    end
    local Range = Clamp(tonumber(State.Distance) or 15, 1, 15)
    local CurrentTime = Clock()
    local BestPlayer
    local BestRoot
    local BestTool
    local BestDistance = Infinite
    local CachedPlayers = State.Players
    for Index = 1, #CachedPlayers do
        local Player = CachedPlayers[Index]
        if Player and Player.Parent == Players and Player ~= LocalPlayer and IsCombatTargetAllowed(Player) then
            local EnemyCharacter = Player.Character
            local EnemyRoot = EnemyCharacter and EnemyCharacter:FindFirstChild("HumanoidRootPart")
            local EnemyHumanoid = EnemyCharacter and EnemyCharacter:FindFirstChildOfClass("Humanoid")
            if EnemyRoot and EnemyRoot:IsA("BasePart") and EnemyHumanoid and EnemyHumanoid.Health > 0 then
                local Distance = (EnemyRoot.Position - Root.Position).Magnitude
                if Distance <= Range then
                    local Attacking, EnemyTool = AutoBlockPlayerAttacking(Player, CurrentTime)
                    if Attacking and Distance
                            < BestDistance then
                        BestDistance = Distance
                        BestPlayer = Player
                        BestRoot = EnemyRoot
                        BestTool = EnemyTool
                    end
                end
            end
        end
    end
    if BestPlayer then
        State.LastThreat = CurrentTime
        State.ThreatPlayer = BestPlayer
        State.ThreatRoot = BestRoot
        State.ThreatTool = BestTool
        if not State.Blocking then
            if CurrentTime - (tonumber(State.LastSend) or 0)
                >= 0.055 then
                State.LastSend = CurrentTime
                if AutoBlockSend(true, Tool) then
                    State.Blocking = true
                    State.BlockingTool = Tool
                end
            end
        end
        return
    end
    State.ThreatRoot = nil
    State.ThreatPlayer = nil
    State.ThreatTool = nil
    if State.Blocking and CurrentTime - (tonumber(State.LastThreat) or 0)
            > 0.16 then
        AutoBlockSend(false, State.BlockingTool or Tool)
        State.Blocking = false
        State.BlockingTool = nil
        State.LastSend = CurrentTime
    end
end

function AutoBlockEnable()
    local State = AutoBlockState
    if State.Enabled then
        return
    end
    State.Enabled = true
    State.Blocking = false
    State.BlockingTool = nil
    State.LastThreat = 0
    State.LastSend = 0
    Clear(State.Players)
    Clear(State.BlockCache)
    Clear(State.AttackAnimationCache)
    State.AttackUntil = setmetatable({}, {__mode = "k"})
    State.PlayerSet = setmetatable({}, {__mode = "k"})
    local function AddPlayer(Player)
        if not Player or Player == LocalPlayer or State.PlayerSet[Player] then
            return
        end
        State.PlayerSet[Player] = true
        State.Players[#State.Players + 1] = Player
    end
    local function RemovePlayer(Player)
        if not Player or not State.PlayerSet[Player] then
            return
        end
        State.PlayerSet[Player] = nil
        State.AttackUntil[Player] = nil
        for Index = #State.Players, 1, -1 do
            if State.Players[Index] == Player then
                local Last = #State.Players
                State.Players[Index] = State.Players[Last]
                State.Players[Last] = nil
                break
            end
        end
    end
    for _, Player in ipairs(Players:GetPlayers()) do
        AddPlayer(Player)
    end
    if State.PlayerAddedConnection then Shared.SafeDisconnect(State.PlayerAddedConnection) end
    if State.PlayerRemovingConnection then Shared.SafeDisconnect(State.PlayerRemovingConnection) end
    State.PlayerAddedConnection = Players.PlayerAdded:Connect(AddPlayer)
    State.PlayerRemovingConnection = Players.PlayerRemoving:Connect(RemovePlayer)
    if State.Connection then Shared.SafeDisconnect(State.Connection) end
    State.ScanClock = 0
    State.Connection = RunService.Heartbeat:Connect(
            function(DeltaTime)
                State.ScanClock += Clamp(tonumber(DeltaTime) or 0, 0, 0.05)
                if State.ScanClock
                    < 1 / 90 then
                    return
                end
                State.ScanClock = State.ScanClock % (1 / 90)
                AutoBlockStep()
            end)
    AutoBlockStartFacingRuntime()
end

function AutoBlockDisable()
    local State = AutoBlockState
    State.Enabled = false
    if State.Connection then
        Shared.SafeDisconnect(State.Connection)
        State.Connection = nil
    end
    local Character = LocalPlayer.Character
    local Tool = State.BlockingTool or (Character and Character:FindFirstChildOfClass("Tool"))
    if State.Blocking and Tool then AutoBlockSend(false, Tool) end
    State.Blocking = false
    State.BlockingTool = nil
    State.ScanClock = 0
    AutoBlockStopFacingRuntime()
    Clear(State.BlockCache)
    Clear(State.AttackAnimationCache)
    State.AttackUntil = setmetatable({}, {__mode = "k"})
    Clear(State.Players)
    State.PlayerSet = setmetatable({}, {__mode = "k"})
    if State.PlayerAddedConnection then
        Shared.SafeDisconnect(State.PlayerAddedConnection)
        State.PlayerAddedConnection = nil
    end
    if State.PlayerRemovingConnection then
        Shared.SafeDisconnect(State.PlayerRemovingConnection)
        State.PlayerRemovingConnection = nil
    end
end

if type(GunMaterialChamsDisable) == "function" and GunMaterialChamsState.Enabled then Shared.SafeCall(GunMaterialChamsDisable) end
GunMaterialChamsState.Enabled = false
GunMaterialChamsState.RootConnections = setmetatable({}, {__mode = "k"})
GunMaterialChamsState.ActiveRoots = setmetatable({}, {__mode = "k"})
GunMaterialChamsState.StyledObjects = setmetatable({}, {__mode = "k"})
GunMaterialChamsState.StyledRoots = setmetatable({}, {__mode = "k"})
GunMaterialChamsState.RootData = setmetatable({}, {__mode = "k"})
GunMaterialChamsState.Originals = setmetatable({}, {__mode = "k"})
GunMaterialChamsState.Connections = {}
GunMaterialChamsState.LastMaintenance = 0
GunMaterialChamsState.MaintenanceInterval = 0.25
GunMaterialChamsState.RenderName = nil
function GunMaterialChamsGetRoots()
    local Roots = {}
    local ShaderRoots = GetWeaponShaderRoots()
    for Index = 1, #ShaderRoots do
        local RootData = ShaderRoots[Index]
        if RootData and RootData.Root and RootData.Root.Parent then Roots[#Roots + 1] = {Root = RootData.Root, ViewModel = RootData.ViewModel == true} end
    end
    return Roots
end
function GunMaterialChamsRootsEqual(FirstRoots, SecondRoots)
    if type(FirstRoots) ~= "table" or type(SecondRoots) ~= "table" or #FirstRoots ~= #SecondRoots then return false end
    for Index = 1, #FirstRoots do
        if not FirstRoots[Index] or not SecondRoots[Index] or FirstRoots[Index].Root ~= SecondRoots[Index].Root or FirstRoots[Index].ViewModel ~= SecondRoots[Index].ViewModel then return false end
    end
    return true
end
function GunMaterialChamsGetPart(Object)
    if not Object then return nil end
    if Object:IsA("BasePart") then return Object end
    return Object:FindFirstAncestorWhichIsA("BasePart")
end
function GunMaterialChamsPartAllowed(Part, RootData)
    if not Part or not Part:IsA("BasePart") or not RootData or not RootData.Root then return false end
    if RootData.ViewModel then return IsViewModelWeaponPart(Part, RootData.Root) == true end
    return Part:IsDescendantOf(RootData.Root)
end
function GunMaterialChamsObjectAllowed(Object, RootData)
    if not Object or not Object.Parent then return false end
    if Object:GetAttribute("AtramentaVisualLayer") == true or Object.Name == "AtramentaChamAnimation" or Object.Name == "AtramentaWeaponShader" then return false end
    if not (Object:IsA("BasePart") or Object:IsA("SpecialMesh") or Object:IsA("FileMesh") or Object:IsA("SurfaceAppearance")
        or Object:IsA("Texture") or Object:IsA("Decal")) then return false end
    local Part = GunMaterialChamsGetPart(Object)
    return GunMaterialChamsPartAllowed(Part, RootData)
end
function GunMaterialChamsSave(Object)
    if GunMaterialChamsState.Originals[Object] then return GunMaterialChamsState.Originals[Object] end
    local Data = {}
    if Object:IsA("BasePart") then
        Data.Color = Object.Color
        Data.Material = Object.Material
        Data.MaterialVariant = Object.MaterialVariant
        Data.Reflectance = Object.Reflectance
        Data.Transparency = Object.Transparency
        Data.LocalTransparencyModifier = Object.LocalTransparencyModifier
        if Object:IsA("UnionOperation") then Data.UsePartColor = Object.UsePartColor end
        if Object:IsA("MeshPart") then Data.Texture = Object.TextureID end
    elseif Object:IsA("SpecialMesh") or Object:IsA("FileMesh") then
        Data.Texture = Object.TextureId
    elseif Object:IsA("SurfaceAppearance") then
        Data.ColorMap = Object.ColorMap
        Data.NormalMap = Object.NormalMap
        Data.MetalnessMap = Object.MetalnessMap
        Data.RoughnessMap = Object.RoughnessMap
    elseif Object:IsA("Texture") or Object:IsA("Decal") then
        Data.Transparency = Object.Transparency
        Data.Color3 = Object.Color3
    end
    GunMaterialChamsState.Originals[Object] = Data
    return Data
end
function GunMaterialChamsRestoreObject(Object, Forget)
    local Data = GunMaterialChamsState.Originals[Object]
    if Data and Object and Object.Parent then
        if Object:IsA("BasePart") then
            Object.Color = Data.Color
            Object.Material = Data.Material
            Object.MaterialVariant = Data.MaterialVariant or ""
            Object.Reflectance = tonumber(Data.Reflectance) or 0
            Object.Transparency = Data.Transparency
            Object.LocalTransparencyModifier = Data.LocalTransparencyModifier
            if Object:IsA("UnionOperation") and Data.UsePartColor ~= nil then Object.UsePartColor = Data.UsePartColor end
            if Object:IsA("MeshPart") and Data.Texture ~= nil then Object.TextureID = Data.Texture end
        elseif Object:IsA("SpecialMesh") or Object:IsA("FileMesh") then
            if Data.Texture ~= nil then Object.TextureId = Data.Texture end
        elseif Object:IsA("SurfaceAppearance") then
            Object.ColorMap = Data.ColorMap or ""
            Object.NormalMap = Data.NormalMap or ""
            Object.MetalnessMap = Data.MetalnessMap or ""
            Object.RoughnessMap = Data.RoughnessMap or ""
        elseif Object:IsA("Texture") or Object:IsA("Decal") then
            if Data.Transparency ~= nil then Object.Transparency = Data.Transparency end
            if Data.Color3 then Object.Color3 = Data.Color3 end
        end
    end
    if Forget then GunMaterialChamsState.Originals[Object] = nil end
end
function GunMaterialChamsApplyObject(Object, RootData)
    if not GunMaterialChamsState.Enabled or not GunMaterialChamsObjectAllowed(Object, RootData) then return end
    local Original = GunMaterialChamsSave(Object)
    GunMaterialChamsState.StyledObjects[Object] = true
    GunMaterialChamsState.StyledRoots[Object] = RootData.Root
    GunMaterialChamsState.RootData[Object] = RootData
    if Object:IsA("BasePart") then
        local MaterialData = GunMaterialChamsMaterials[tostring(GunMaterialChamsState.Material)] or GunMaterialChamsMaterials.Neon
        local MaterialName = tostring(GunMaterialChamsState.Material or "Neon")
        local JujuNeon = IsJujuNeonMaterial(MaterialName)
        Object.Color = GunMaterialChamsState.Color
        Object.Material = ResolveJujuVisualMaterial(MaterialName, Object.Name)
        Object.MaterialVariant = ""
        Object.Reflectance = MaterialData.Reflectance
        if Original.Transparency == nil or Original.Transparency < 0.99 then Object.Transparency = GunMaterialChamsState.Transparency end
        if RootData.ViewModel then Object.LocalTransparencyModifier = 0 end
        if Object:IsA("UnionOperation") then Object.UsePartColor = true end
        if Object:IsA("MeshPart") then
            if GunMaterialChamsState.NoTexture or JujuNeon then Object.TextureID = ""
            elseif Original.Texture ~= nil then Object.TextureID = Original.Texture end
        end
    elseif Object:IsA("SpecialMesh") or Object:IsA("FileMesh") then
        if GunMaterialChamsState.NoTexture or IsJujuNeonMaterial(GunMaterialChamsState.Material) then Object.TextureId = ""
        elseif Original.Texture ~= nil then Object.TextureId = Original.Texture end
    elseif Object:IsA("SurfaceAppearance") then
        if GunMaterialChamsState.NoTexture or IsJujuNeonMaterial(GunMaterialChamsState.Material) then
            Object.ColorMap = ""
            Object.NormalMap = ""
            Object.MetalnessMap = ""
            Object.RoughnessMap = ""
        else
            Object.ColorMap = Original.ColorMap or ""
            Object.NormalMap = Original.NormalMap or ""
            Object.MetalnessMap = Original.MetalnessMap or ""
            Object.RoughnessMap = Original.RoughnessMap or ""
        end
    elseif Object:IsA("Texture") or Object:IsA("Decal") then
        if GunMaterialChamsState.NoTexture or IsJujuNeonMaterial(GunMaterialChamsState.Material) then Object.Transparency = 1
        elseif Original.Transparency ~= nil then Object.Transparency = Original.Transparency end
    end
end
function GunMaterialChamsDisconnectRoot(Root)
    local Connections = GunMaterialChamsState.RootConnections[Root]
    if type(Connections) == "table" then
        for Index = 1, #Connections do
            local Connection = Connections[Index]
            if Connection then Connection:Disconnect() end
        end
    end
    GunMaterialChamsState.RootConnections[Root] = nil
    GunMaterialChamsState.ActiveRoots[Root] = nil
end
function GunMaterialChamsBindRoot(RootData)
    local Root = RootData and RootData.Root
    if not Root or not Root.Parent then return end
    local Existing = GunMaterialChamsState.ActiveRoots[Root]
    if Existing and Existing.ViewModel == RootData.ViewModel and GunMaterialChamsState.RootConnections[Root] then return end
    if GunMaterialChamsState.RootConnections[Root] then GunMaterialChamsDisconnectRoot(Root) end
    GunMaterialChamsState.ActiveRoots[Root] = RootData
    for _, Object in ipairs(Root:GetDescendants()) do GunMaterialChamsApplyObject(Object, RootData) end
    GunMaterialChamsState.RootConnections[Root] = {Root.DescendantAdded:Connect(function(Object)
            if GunMaterialChamsState.Enabled then GunMaterialChamsApplyObject(Object, RootData) end
        end), Root.DescendantRemoving:Connect(function(Object)
            if GunMaterialChamsState.StyledObjects[Object] then
                GunMaterialChamsRestoreObject(Object, true)
                GunMaterialChamsState.StyledObjects[Object] = nil
                GunMaterialChamsState.StyledRoots[Object] = nil
                GunMaterialChamsState.RootData[Object] = nil
            end
        end)}
end
function GunMaterialChamsRefreshRoots()
    if not GunMaterialChamsState.Enabled then return end
    local Roots = GunMaterialChamsGetRoots()
    local Current = setmetatable({}, {__mode = "k"})
    for Index = 1, #Roots do
        local RootData = Roots[Index]
        Current[RootData.Root] = RootData
        GunMaterialChamsBindRoot(RootData)
    end
    local Stale = {}
    for Root in pairs(GunMaterialChamsState.RootConnections) do
        if not Root.Parent or not Current[Root] then Stale[#Stale + 1] = Root end
    end
    for Index = 1, #Stale do GunMaterialChamsDisconnectRoot(Stale[Index]) end
    GunMaterialChamsState.CurrentRoots = Roots
end
function GunMaterialChamsPruneStyled()
    local Stale = {}
    for Object in pairs(GunMaterialChamsState.StyledObjects) do
        local Root = GunMaterialChamsState.StyledRoots[Object] local RootData = GunMaterialChamsState.RootData[Object]
        if not Object or not Object.Parent or not Root or not Root.Parent or not GunMaterialChamsState.ActiveRoots[Root]
            or not GunMaterialChamsObjectAllowed(Object, RootData) then
            Stale[#Stale + 1] = Object
        end
    end
    for Index = 1, #Stale do
        local Object = Stale[Index]
        GunMaterialChamsRestoreObject(Object, true)
        GunMaterialChamsState.StyledObjects[Object] = nil
        GunMaterialChamsState.StyledRoots[Object] = nil
        GunMaterialChamsState.RootData[Object] = nil
    end
end
function GunMaterialChamsEnforce()
    if not GunMaterialChamsState.Enabled then return end
    for Object in pairs(GunMaterialChamsState.StyledObjects) do
        local Root = GunMaterialChamsState.StyledRoots[Object] local RootData = GunMaterialChamsState.RootData[Object]
        if Root and GunMaterialChamsState.ActiveRoots[Root] and GunMaterialChamsObjectAllowed(Object, RootData) then GunMaterialChamsApplyObject(Object, RootData) end
    end
end
function GunMaterialChamsApply()
    if not GunMaterialChamsState.Enabled then return end
    GunMaterialChamsRefreshRoots()
    GunMaterialChamsPruneStyled()
    GunMaterialChamsEnforce()
end
function GunMaterialChamsRestore()
    local Objects = {}
    for Object in pairs(GunMaterialChamsState.Originals) do Objects[#Objects + 1] = Object end
    for Index = 1, #Objects do GunMaterialChamsRestoreObject(Objects[Index], true) end
