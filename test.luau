    Copy.VelocityDesyncMode = Snapshot.VelocityDesyncMode
    Copy.VelocityDesyncOffset = Snapshot.VelocityDesyncOffset
    Copy.VelocityDesyncFakeVelocity = Snapshot.VelocityDesyncFakeVelocity
    Copy.AntiAim = Snapshot.AntiAim == true
    Copy.AntiAimMode = Snapshot.AntiAimMode
    Copy.BlockedBeforeSend = Snapshot.BlockedBeforeSend
    Copy.RawPayload = Snapshot.RawPayload
    Copy.RawPosition = Snapshot.RawPosition
    local VerificationStatus, VerificationSource, VerificationAge, VerificationReceivePosition = GetAtramentaReplicaVerification(Snapshot.Sequence, CurrentTime)
    Copy.VerificationStatus = VerificationStatus
    Copy.VerificationSource = VerificationSource
    Copy.VerificationAge = VerificationAge
    Copy.VerificationReceivePosition = VerificationReceivePosition
    Copy.Age = Max(0, (tonumber(CurrentTime) or Clock()) - (tonumber(Snapshot.Time) or 0))
    return Copy
end
function PushAtramentaPhysicsPayload(Payload, CurrentTime, Snapshot, Offset, Strategy)
    if type(Payload) ~= "string" or #Payload ~= 12 then return nil end
    local History = DesyncNetworkState.PhysicsHistory
    if type(History) ~= "table" then
        History = {}
        DesyncNetworkState.PhysicsHistory = History
    end
    local Entry = {Time = CurrentTime, Payload = Payload, Offset = tonumber(Offset), Strategy = tostring(Strategy or "OpaqueReplay"), Snapshot =
            CloneAtramentaReplicaSnapshot(Snapshot, CurrentTime)}
    History[#History + 1] = Entry
    local MinimumTime = CurrentTime - 0.85
    while #History > 72 do
        Remove(History, 1)
    end
    while #History > 2 and (tonumber(History[1].Time) or 0) < MinimumTime do
        Remove(History, 1)
    end
    return Entry
end
function GetAtramentaDelayedPhysicsEntry(CurrentTime, Delay, Offset, Strategy)
    local History = DesyncNetworkState.PhysicsHistory
    if type(History) ~= "table" or #History < 2 then return nil end
    local WantedTime = CurrentTime - Clamp(tonumber(Delay) or 0.16, 0.05, 0.40)
    for Index = #History, 1, -1 do
        local Entry = History[Index]
        if type(Entry) == "table" and type(Entry.Payload) == "string" and (Offset == nil or tonumber(Entry.Offset)
                    == tonumber(Offset)) and (Strategy == nil or tostring(Entry.Strategy)
                    == tostring(Strategy)) and (tonumber(Entry.Time) or Infinite) <= WantedTime then
            return Entry
        end
    end
    return nil
end
function GetAtramentaDelayedPhysicsPayload(CurrentTime, Delay)
    local Entry = GetAtramentaDelayedPhysicsEntry(CurrentTime, Delay, nil, nil)
    return Entry and Entry.Payload or nil
end
function RewriteAtramentaPhysicsPacket(Packet, Data, CurrentEntry)
    local CurrentSnapshot = type(CurrentEntry) == "table" and CurrentEntry.Snapshot or nil
    if type(Data) ~= "string" or not IsAtramentaPhysicsPacket(Packet, Data) or type(CurrentSnapshot) ~= "table" or typeof(CurrentSnapshot.RootCFrame) ~= "CFrame" then
        return false, CurrentSnapshot, nil, nil
    end
    local TPState = Ragebot and Ragebot.Runtime and Ragebot.Runtime.ModeMoveState
    local TPHitActive = Ragebot and Ragebot.Runtime and Ragebot.Runtime.TPHitBusy == true and type(TPState) == "table" and TPState.TPHitDesync == true
        and TPState.NetworkMode == "RawPhysicsXYZ" and typeof(TPState.ServerPosition) == "Vector3" and Clock() <= (tonumber(TPState.ServerPublishUntil) or 0)
    local FakePositionActive = false
    if not TPHitActive and not FakePositionActive then
        return false, CurrentSnapshot, nil, nil
    end
    local RootPosition = CurrentSnapshot.RootCFrame.Position
    local Offset = FindAtramentaPhysicsPositionField(Data, RootPosition)
    if not Offset then
        if TPHitActive then TPState.ServerPacketCalibrating = true end
        return false, CurrentSnapshot, FakePositionActive and "FakePositionCalibrating" or "TPHitCalibrating", nil
    end
    if DesyncNetworkState.PhysicsPositionValidated ~= true then
        if TPHitActive then TPState.ServerPacketCalibrating = true end
        return false, CurrentSnapshot, FakePositionActive and "FakePositionCalibrating" or "TPHitCalibrating", Offset
    end
    local ServerPosition
    local Strategy
    if TPHitActive then
        ServerPosition = TPState.ServerPosition
        Strategy = "TPHitRawXYZ"
    else
        ServerPosition = DesyncNetworkState.FakePositionAnchorCFrame.Position
        Strategy = "FakePositionRawXYZ"
    end
    local Packed = PackAtramentaRawVector3(ServerPosition)
    local SetData = Packet and Packet.SetData
    if type(Packed) ~= "string" or #Packed ~= 12 or type(SetData) ~= "function" then
        if TPHitActive then TPState.ServerPacketPatchFailed = true end
        return false, CurrentSnapshot, Strategy .. "Unavailable", Offset
    end
    local NewData = Sub(Data, 1, Offset - 1) .. Packed .. Sub(Data, Offset + 12)
    if #NewData ~= #Data then
        if TPHitActive then TPState.ServerPacketPatchFailed = true end
        return false, CurrentSnapshot, Strategy .. "SizeFail", Offset
    end
    local Success = Shared.SafeCall(SetData, Packet, NewData)
    if Success ~= true then
        if TPHitActive then TPState.ServerPacketPatchFailed = true end
        return false, CurrentSnapshot, Strategy .. "SetDataFail", Offset
    end
    local Delta = ServerPosition - RootPosition
    local EffectiveSnapshot = CloneAtramentaReplicaSnapshot(CurrentSnapshot, Clock()) or CurrentSnapshot
    if type(EffectiveSnapshot) == "table" and typeof(EffectiveSnapshot.RootCFrame) == "CFrame" then
        local RootRotation = EffectiveSnapshot.RootCFrame - EffectiveSnapshot.RootCFrame.Position
        EffectiveSnapshot.RootCFrame = NewCFrame(ServerPosition) * RootRotation
        if type(EffectiveSnapshot.Parts) == "table" then
            for Name, PartCFrame in pairs(EffectiveSnapshot.Parts) do
                if typeof(PartCFrame) == "CFrame" then
                    local PartRotation = PartCFrame - PartCFrame.Position
                    EffectiveSnapshot.Parts[Name] = NewCFrame(PartCFrame.Position + Delta) * PartRotation
                end
            end
        end
    end
    if TPHitActive then
        TPState.ServerPacketCalibrating = false
        TPState.ServerPacketPatchFailed = false
        TPState.ServerPacketPatched = true
        TPState.ServerPacketPatchedAt = Clock()
        TPState.ServerPacketPatchedGeneration = tonumber(TPState.ServerPositionGeneration) or 0
        TPState.ServerPacketPatchedCount = (tonumber(TPState.ServerPacketPatchedCount) or 0) + 1
        TPState.LastServerPosition = ServerPosition
    else
        DesyncNetworkState.FakePositionPatchedPackets = (tonumber(DesyncNetworkState.FakePositionPatchedPackets) or 0) + 1
        DesyncNetworkState.FakePositionLastPatchedAt = Clock()
    end
    return true, EffectiveSnapshot, Strategy, Offset
end

function InstallDesyncNetworkHook()
    local State = rawget(Environment, "AtramentaDesyncRakNet")
    local LegacyState = rawget(Environment, "AtramentaAntiAimRakNet")
    if type(LegacyState) == "table" and LegacyState ~= State then LegacyState.Controller = nil end
    if LegacyState ~= nil then rawset(Environment, "AtramentaAntiAimRakNet", nil) end
    if type(State) ~= "table" then
        State = {Installed = false, ReceiveInstalled = false, Controller = DesyncNetworkState}
        rawset(Environment, "AtramentaDesyncRakNet", State)
    end
    State.Controller = DesyncNetworkState
    local RakNetObject = rawget(Environment, "raknet") or rawget(_G, "raknet")
    local AddSendHook = type(RakNetObject) == "table" and RakNetObject.add_send_hook or nil
    local AddReceiveHook = type(RakNetObject) == "table" and RakNetObject.add_receive_hook or nil
    if type(AddSendHook) ~= "function" then return false end
    if not State.Installed then
        State.Installed = true
        AddSendHook(function(Packet)
                local Controller = State.Controller
                if type(Controller) ~= "table" then return Packet end
                local Data = Packet and Packet.AsString
                if type(Data) ~= "string" then return Packet end
                Controller.SeenPackets = (tonumber(Controller.SeenPackets) or 0) + 1
                Controller.LastPacketTime = Clock()
                Controller.LastPacketSize = #Data
                local MoveState = Ragebot and Ragebot.Runtime and Ragebot.Runtime.ModeMoveState
                local TPHitNetworkActive = Ragebot and Ragebot.Runtime and Ragebot.Runtime.TPHitBusy == true and type(MoveState) == "table" and MoveState.TPHitDesync == true
                    and MoveState.NetworkMode == "RawPhysicsXYZ"
                local NetworkEnabled = BodyHide and (BodyHide.Head == true or BodyHide.Hands == true) or (FlyEnabled == true and FlyMethod == "Velocity") or TPHitNetworkActive
                if not NetworkEnabled then return Packet end
                local IsMovement = IsAtramentaRawMovementRecord(Data)
                local IsPhysics = IsAtramentaPhysicsPacket(Packet, Data)
                local RawMovementWasPatched = false
                if IsMovement then
                    Controller.RawMovementSeen = (tonumber(Controller.RawMovementSeen) or 0) + 1
                    Controller.MatchedPackets = Controller.RawMovementSeen
                    Controller.RawLastPacketSize = #Data
                    Controller.RawLastPacketTime = Clock()
                    RawMovementWasPatched = RewriteAtramentaRawMovementRecord(Packet, Data) == true
                    Data = Packet.AsString or Data
                end
                local PhysicsCurrentEntry local PhysicsEffectiveSnapshot local PhysicsEffectiveOffset local PhysicsEffectiveStrategy
                local PhysicsWasPatched = false
                if IsPhysics then
                    local PhysicsTime = Clock()
                    Controller.PhysicsSeen = (tonumber(Controller.PhysicsSeen) or 0) + 1
                    Controller.PhysicsLastPacketTime = PhysicsTime
                    local CurrentSnapshot = CaptureAtramentaLocalReplicaSnapshot(PhysicsTime)
                    PhysicsCurrentEntry = PushAtramentaPhysicsPacket(Data, PhysicsTime, CurrentSnapshot)
                    PhysicsWasPatched, PhysicsEffectiveSnapshot, PhysicsEffectiveStrategy, PhysicsEffectiveOffset = RewriteAtramentaPhysicsPacket(
                            Packet, Data, PhysicsCurrentEntry)
                    PhysicsEffectiveSnapshot = PhysicsEffectiveSnapshot or CurrentSnapshot
                    PhysicsEffectiveStrategy = PhysicsEffectiveStrategy or "A1Current"
                    PhysicsEffectiveOffset = PhysicsEffectiveOffset or 18
                    Data = Packet.AsString or Data
                end
                local PhysicsWasBlocked = false
                if IsPhysics and not PhysicsWasBlocked and PhysicsEffectiveSnapshot then
                    local FinalData = Packet.AsString or Data
                    local FingerprintOffset = Max(Floor(tonumber(PhysicsEffectiveOffset) or 18), 1)
                    local FinalPayload = type(FinalData) == "string" and FingerprintOffset + 11
                            <= #FinalData and Sub(FinalData, FingerprintOffset, FingerprintOffset + 11) or nil
                    CommitAtramentaLocalServerReplica(PhysicsEffectiveSnapshot, Clock(), FinalPayload, PhysicsWasPatched, PhysicsEffectiveStrategy)
                end
                return Packet
            end)
    end
    if type(AddReceiveHook) == "function" and not State.ReceiveInstalled then
        State.ReceiveInstalled = true
        DesyncNetworkState.ReceiveInstalled = true
        AddReceiveHook(function(Packet)
                if State.Controller == DesyncNetworkState then ProcessAtramentaReceiveVerification(Packet) end
                return Packet
            end)
    end
    return true
end
