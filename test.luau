function RefreshWorldESPEntry(Object, Force)
    local Data = Object and Visuals.WorldESP.Objects[Object]
    if type(Data) ~= "table" then return nil end
    if not Object.Parent or not Data.Billboard or not Data.Billboard.Parent or not Data.Label or not Data.Label.Parent then
        RemoveWorldESPObject(Object)
        return nil
    end
    local Adornee = GetWorldAdornee(Object)
    if not Adornee or not Adornee.Parent then
