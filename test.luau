    if Snapshot[Key] == nil then Snapshot[Key] = Value end
end
function ApplyUniversalEquipObject(Object)
    if typeof(Object) ~= "Instance" then return false end
    local Changed = false
    local Success, Attributes = pcall(function() return Object:GetAttributes() end)
    if Success and type(Attributes) == "table" then
        for Key, Value in pairs(Attributes) do
            if type(Value) == "number" then
                local Mode = GetInstantEquipFieldMode(Key)
                if Mode then
                    CaptureUniversalEquipAttribute(Object, Key, Value)
                    local Target = Mode == "speed" and 10000 or 0
                    if pcall(function() Object:SetAttribute(Key, Target) end) then Changed = true end
                end
            end
        end
    end
    if Object:IsA("NumberValue") or Object:IsA("IntValue") then
        local Mode = GetInstantEquipFieldMode(Object.Name)
        if Mode then
            if GunMods.EquipValueOriginals[Object] == nil then GunMods.EquipValueOriginals[Object] = Object.Value end
            local Target = Mode == "speed" and 10000 or 0
            if pcall(function() Object.Value = Target end) then Changed = true end
        end
    end
    return Changed
end
function RestoreUniversalEquipObjects()
    for Object, Fields in pairs(GunMods.EquipAttributeOriginals) do
        if typeof(Object) == "Instance" and Object.Parent and type(Fields) == "table" then
            for Key, Value in pairs(Fields) do pcall(function() Object:SetAttribute(Key, Value) end) end
        end
    end
    for Object, Value in pairs(GunMods.EquipValueOriginals) do
        if typeof(Object) == "Instance" and Object.Parent and (Object:IsA("NumberValue") or Object:IsA("IntValue")) then pcall(function() Object.Value = Value end) end
    end
end
function IsUniversalEquipConfigModule(Object)
    return typeof(Object) == "Instance" and Object:IsA("ModuleScript") and InstantEquipConfigNames[NormalizeInstantEquipKey(Object.Name)] == true
end
function RegisterUniversalInstantEquipTool(Tool)
    if not Tool or not Tool:IsA("Tool") then return false end
    local Enabled = AtramentaConfig.Weapon.GunMods.InstantEquip == true
    if not Enabled then return false end
    local Changed = ApplyUniversalEquipObject(Tool)
    for _, Object in ipairs(Tool:GetDescendants()) do
        if ApplyUniversalEquipObject(Object) then Changed = true end
        if IsUniversalEquipConfigModule(Object) then
            local Success, Result = pcall(require, Object)
            if Success and type(Result) == "table" and ApplyUniversalEquipTable(Result, 0, nil) then Changed = true end
        end
    end
    local DirectConfig = Tool:FindFirstChild("Config")
    if DirectConfig and DirectConfig:IsA("ModuleScript") then
        local Success, Result = pcall(require, DirectConfig)
        if Success and type(Result) == "table" and ApplyUniversalEquipTable(Result, 0, nil) then Changed = true end
    end
    return Changed
end
