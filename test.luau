function Ragebot.BeginWallbangTimeSlice(MinimumChecks, MaximumChecks, BudgetScale)
    local Wallbang = Ragebot.Runtime.Wallbang
    if type(Wallbang) ~= "table" then
        return 0
    end
    local Minimum = Max(Floor(tonumber(MinimumChecks) or tonumber(Wallbang.ScanMinimumChecks) or 4), 1)
    local Maximum = Max(Floor(tonumber(MaximumChecks) or tonumber(Wallbang.ScanMaximumChecks) or 32), Minimum)
    local Scale = Clamp(tonumber(BudgetScale) or 1, 0.50, 2.00)
    local Now = Clock()
    Wallbang.ScanStartedAt = Now
    Wallbang.ScanMinimumChecks = Minimum
    Wallbang.ScanMaximumChecks = Maximum
    Wallbang.ScanDeadline = Now + Ragebot.GetWallbangScanTimeBudget() * Scale
    Wallbang.ScanTimedOut = false
    return Wallbang.ScanDeadline
end

function Ragebot.IsWallbangTimeSliceExpired(Checks)
    local Wallbang = Ragebot.Runtime.Wallbang
    if type(Wallbang) ~= "table" then
        return false
    end
    Checks = Max(Floor(tonumber(Checks) or 0), 0)
    local Minimum = Max(Floor(tonumber(Wallbang.ScanMinimumChecks) or 4), 1)
    local Maximum = Max(Floor(tonumber(Wallbang.ScanMaximumChecks) or 32), Minimum)
    if Checks < Minimum then
        return false
    end
    if Checks >= Maximum then
        Wallbang.ScanTimedOut = true
        return true
    end
    local Deadline = tonumber(Wallbang.ScanDeadline) or 0
    if Deadline <= 0 then
        return false
    end
    if Checks % 2 ~= 0 then
        return false
    end
    if Clock() >= Deadline then
        Wallbang.ScanTimedOut = true
        return true
    end
    return false
end

