                local Score = -Abs(Age) * 30
                if Shot.RemoteConfirmed == true then Score += 30 end
                if Shot.Token ~= nil then Score += 8 end
                if Shot.SignalConfirmed == true then Score += 5 end
                if Score > BestScore then Best, BestScore = Shot, Score end
            end
        end
    end
    return Best
end
