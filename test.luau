    return Match(Value, "(%d+)")
end
function Shared.GetWeaponMeshSignature(Object)
    if not Object then return nil end
    local MeshTokens = {}
    local MeshSeen = {}
    local function AddMesh(Value)
        local Token = Shared.GetAssetToken(Value)
        if not Token or MeshSeen[Token] then return end
        MeshSeen[Token] = true
        MeshTokens[#MeshTokens + 1] = Token
    end
    local function AddPart(Part)
        if Part:IsA("MeshPart") then
            AddMesh(Part.MeshId)
            AddMesh(Part.TextureID)
        elseif Part:IsA("UnionOperation") then
            local Success, AssetId = Shared.SafeCall(function() return Part.AssetId end)
            if Success then AddMesh(AssetId) end
        end
    end
    if Object:IsA("BasePart") then AddPart(Object) end
    if Object:IsA("SpecialMesh") then
        AddMesh(Object.MeshId)
        AddMesh(Object.TextureId)
    end
    for _, Descendant in ipairs(Object:GetDescendants()) do
        if Descendant:IsA("BasePart") then
            AddPart(Descendant)
        elseif Descendant:IsA("SpecialMesh") then
            AddMesh(Descendant.MeshId)
            AddMesh(Descendant.TextureId)
        end
    end
    Sort(MeshTokens)
    return #MeshTokens > 0 and Concat(MeshTokens, ":") or nil
end
function Shared.RegisterWeaponSignature(Index, Signature, Key)
    if not Signature or not Key then return end
    local Existing = Index[Signature]
    if Existing == nil then
        Index[Signature] = Key
    elseif Existing ~= Key then
        Index[Signature] = false
    end
end
