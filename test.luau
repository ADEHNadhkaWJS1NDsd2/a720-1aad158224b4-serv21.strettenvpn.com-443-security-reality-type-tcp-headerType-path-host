AtramentaExtraState.ShopLookup = type(AtramentaExtraState.ShopLookup) == "table" and AtramentaExtraState.ShopLookup or {Folder = nil, Entries = {}, Count = 0}
function AtramentaExtraRefreshShopLookup()
    local Lookup = AtramentaExtraState.ShopLookup
    local Map = Workspace:FindFirstChild("Map") local Shops = Map and Map:FindFirstChild("Shopz")
    if not Shops then
        Lookup.Folder = nil
        Clear(Lookup.Entries)
        Lookup.Count = 0
        return false
    end
    if Lookup.Folder == Shops and Lookup.Count == #Shops:GetChildren() and #Lookup.Entries > 0 then return true end
    Lookup.Folder = Shops
    Clear(Lookup.Entries)
    local Children = Shops:GetChildren()
    Lookup.Count = #Children
    for _, Shop in ipairs(Children) do
        if typeof(Shop) == "Instance" then
            local Success, MainPart = Shared.SafeCall(function() return Shop:FindFirstChild("MainPart") end)
            if Success and MainPart and MainPart:IsA("BasePart") then
                local ShopName = Lower(tostring(Shop.Name or ""))
                local Legal = StringFind(ShopName, "armor", 1, true) ~= nil or StringFind(ShopName, "legal", 1, true) ~= nil
                Lookup.Entries[#Lookup.Entries + 1] = {Shop = Shop, MainPart = MainPart, StoreType = Legal and "LegalStore" or "IllegalStore"}
            end
        end
    end
    return #Lookup.Entries > 0
end
function AtramentaExtraGetNearestShop(Root, MaximumDistance)
    if not Root or not Root.Parent or not Root:IsA("BasePart") then return nil end
    if not AtramentaExtraRefreshShopLookup() then return nil end
    local BestEntry, BestDistance
    MaximumDistance = Max(tonumber(MaximumDistance) or 15, 0)
    for _, Entry in ipairs(AtramentaExtraState.ShopLookup.Entries) do
        local Shop, MainPart = Entry.Shop, Entry.MainPart
        if Shop and Shop.Parent and MainPart and MainPart.Parent then
            local Distance = (Root.Position - MainPart.Position).Magnitude
            if Distance <= MaximumDistance and (BestDistance == nil or Distance < BestDistance) then
                BestEntry = Entry
                BestDistance = Distance
            end
        end
    end
    if not BestEntry then return nil end
    return BestEntry.Shop, BestEntry.MainPart, BestEntry.StoreType
end
function AtramentaExtraAutoRefillTick()
    local State = AtramentaExtraState.AutoRefill
    if not State.Enabled or Clock() - State.LastRefill < 0.5 then return end
    local Character = LocalPlayer.Character local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Tool = Character and Character:FindFirstChildOfClass("Tool")
    if not Root or not Tool then return end
    local Values = Tool:FindFirstChild("Values") local Current = Values and (Values:FindFirstChild("SERVER_Ammo") or Values:FindFirstChild("Ammo"))
    local Stored = Values and (Values:FindFirstChild("SERVER_StoredAmmo") or Values:FindFirstChild("StoredAmmo"))
    if not Current and not Stored then return end
    local Name = Tool.Name local CurrentValue = Current and tonumber(Current.Value) or nil
    local StoredValue = Stored and tonumber(Stored.Value) or nil local Config = Ragebot.GetWeaponConfig(Tool)
    local MagSize = type(Config) == "table" and tonumber(rawget(Config, "MagSize")) or nil
    if CurrentValue then State.MaxCurrent[Name] = Max(tonumber(State.MaxCurrent[Name]) or CurrentValue, CurrentValue, MagSize or 0) end
    if StoredValue then State.MaxStored[Name] = Max(tonumber(State.MaxStored[Name]) or StoredValue, StoredValue) end
    local NeedsRefill = CurrentValue and State.MaxCurrent[Name] and CurrentValue < State.MaxCurrent[Name]
        or StoredValue and State.MaxStored[Name] and StoredValue < State.MaxStored[Name]
    if not NeedsRefill then return end
    local Events = ReplicatedStorage:FindFirstChild("Events") local Protect = Events and Events:FindFirstChild("BYZERSPROTEC")
    local ShopRemote = Events and Events:FindFirstChild("SSHPRMTE1")
    if not Protect or not ShopRemote then return end
    local Shop, MainPart, StoreType = AtramentaExtraGetNearestShop(Root, 15)
    if not Shop or not MainPart or type(StoreType) ~= "string" then return end
    Shared.SafeCall(function() Protect:FireServer() end)
    local Success = Shared.SafeCall(function()
        return ShopRemote:InvokeServer(StoreType, "Guns", Name, MainPart, "ResupplyAmmo", true)
    end)
    if Success then State.LastRefill = Clock() end
end
function AtramentaExtraDisconnectAutomation(State)
    if type(State) ~= "table" or type(State.Connections) ~= "table" then return end
    for Name, Connection in pairs(State.Connections) do Shared.SafeDisconnect(Connection) State.Connections[Name] = nil end
end
function AtramentaExtraRequestAutoRefill()
    local State = AtramentaExtraState.AutoRefill
    if not State.Enabled or State.Pending then return end
    local Remaining = Max(0, 0.5 - (Clock() - (tonumber(State.LastRefill) or 0)))
    local Token = State.Token
    State.Pending = true
    Delay(Remaining, function()
        if State.Token ~= Token then return end
        State.Pending = false
        if State.Enabled then AtramentaExtraAutoRefillTick() end
    end)
end
function AtramentaExtraBindAutoRefill()
    local State = AtramentaExtraState.AutoRefill
    AtramentaExtraDisconnectAutomation(State)
    if not State.Enabled then return end
    local Character = LocalPlayer.Character
    local function Rebind()
        for _, Name in ipairs({"Current", "Stored", "RootPosition"}) do Shared.SafeDisconnect(State.Connections[Name]) State.Connections[Name] = nil end
        local CurrentCharacter = LocalPlayer.Character
        local Root = CurrentCharacter and CurrentCharacter:FindFirstChild("HumanoidRootPart")
        local Tool = CurrentCharacter and CurrentCharacter:FindFirstChildOfClass("Tool")
        local Values = Tool and Tool:FindFirstChild("Values")
        local Current = Values and (Values:FindFirstChild("SERVER_Ammo") or Values:FindFirstChild("Ammo"))
        local Stored = Values and (Values:FindFirstChild("SERVER_StoredAmmo") or Values:FindFirstChild("StoredAmmo"))
        if Current then State.Connections.Current = Current:GetPropertyChangedSignal("Value"):Connect(AtramentaExtraRequestAutoRefill) end
        if Stored then State.Connections.Stored = Stored:GetPropertyChangedSignal("Value"):Connect(AtramentaExtraRequestAutoRefill) end
        if Root then State.Connections.RootPosition = Root:GetPropertyChangedSignal("Position"):Connect(AtramentaExtraRequestAutoRefill) end
        AtramentaExtraRequestAutoRefill()
    end
    State.Connections.CharacterAdded = LocalPlayer.CharacterAdded:Connect(function() Defer(AtramentaExtraBindAutoRefill) end)
    if Character then
        State.Connections.CharacterChildAdded = Character.ChildAdded:Connect(Rebind)
        State.Connections.CharacterChildRemoved = Character.ChildRemoved:Connect(Rebind)
    end
    Rebind()
end
function AtramentaExtraSetAutoRefill(Value)
    local State = AtramentaExtraState.AutoRefill
    State.Enabled = Value == true
    State.Token += 1
    State.Pending = false
    if State.Enabled then AtramentaExtraBindAutoRefill() else AtramentaExtraDisconnectAutomation(State) end
end
