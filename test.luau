function Shared.FindHitTargetInValue(Value, Visited, Depth)
    if typeof(Value) == "Instance" then
        if Value:IsA("BasePart") then return Shared.GetHumanoidCharacterFromPart(Value), Value end
        if Value:IsA("Humanoid") then
            local Character = Value.Parent
            if Character and Character:IsA("Model") then return Character, Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart") or Character.PrimaryPart end
        end
        if Value:IsA("Model") and Value:FindFirstChildOfClass("Humanoid") then return Value, Value:FindFirstChild("Head") or Value:FindFirstChild("HumanoidRootPart") or Value.PrimaryPart end
        return nil, nil
    end
    if type(Value) ~= "table" or Depth >= 3 or Visited[Value] then return nil, nil end
    Visited[Value] = true
    for Key, NestedValue in pairs(Value) do
        local Character, Part = Shared.FindHitTargetInValue(NestedValue, Visited, Depth + 1)
        if Character and Part then return Character, Part end
        Character, Part = Shared.FindHitTargetInValue(Key, Visited, Depth + 1)
        if Character and Part then return Character, Part end
    end
    return nil, nil
end
function Shared.ResolveHitSignalTarget(...)
    local Arguments = Pack(...)
    local Visited = {}
    for Index = 1, Arguments.n do
        local Character, Part = Shared.FindHitTargetInValue(Arguments[Index], Visited, 0)
        if Character and Part then return Character, Part end
    end
    return nil, nil
end
function Shared.SpawnConfirmedWorldHitmarker(TargetPart, IsHeadshot)
    if not HitFeedbackState.HitmarkerEnabled or not TargetPart or not TargetPart:IsA("BasePart") or not TargetPart.Parent then return end
    local MarkerPart = NewInstance("Part")
    MarkerPart.Name = "AtramentaWorldHitmarker"
    MarkerPart.Size = NewVector3(0.08, 0.08, 0.08)
    MarkerPart.Transparency = 1
    MarkerPart.Anchored = true
    MarkerPart.CanCollide = false
    MarkerPart.CanQuery = false
    MarkerPart.CanTouch = false
    MarkerPart.CFrame = NewCFrame(TargetPart.Position)
    MarkerPart.Parent = workspace
    local Billboard = NewInstance("BillboardGui")
    Billboard.Name = "Marker"
    Billboard.AlwaysOnTop = true
    Billboard.LightInfluence = 0
    Billboard.Size = FromOffset(34, 34)
    Billboard.Adornee = MarkerPart
    Billboard.Parent = MarkerPart
    local Color = IsHeadshot and HitFeedbackState.HeadshotHitmarkerColor or HitFeedbackState.HitmarkerColor
    local Rotations = {45, -45, 45, -45}
    local Positions = {NewUDim2(0.5, 7, 0.5, 7), NewUDim2(0.5, 7, 0.5, -7), NewUDim2(0.5, -7, 0.5, -7), NewUDim2(0.5, -7, 0.5, 7)}
    for Index = 1, 4 do
        local Arm = NewInstance("Frame")
        Arm.AnchorPoint = NewVector2(0.5, 0.5)
        Arm.Position = Positions[Index]
        Arm.Size = FromOffset(10, 2)
        Arm.Rotation = Rotations[Index]
        Arm.BackgroundColor3 = Color
        Arm.BorderSizePixel = 0
        Arm.Parent = Billboard
        TweenService:Create(Arm, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
    end
    Delay(0.24, function()
            if MarkerPart.Parent then MarkerPart:Destroy() end
        end)
end
QueueConfirmedDamage = function(Player, Character, Damage, IsHeadshot, PartName, Shot)
    if not Player or not Character or not Character.Parent or not Damage or Damage <= 0 then return end
    if Shot and Shot.DamageFeedbackPlayed == true then return end
    if Shot and Shot.ConfirmedPartName then
        PartName = Shot.ConfirmedPartName
        IsHeadshot = PartName == "Head"
    end
    if Shot then
        local Source = Shared.NormalizeLocalAttackSource(Shot.Source)
        local WaitForPart = Shot.SignalConfirmed ~= true and Source ~= "RageBot" and Source ~= "HBE" and Shot.DamagePartWaited ~= true
        if WaitForPart then
            Shot.PendingFeedbackDamage = (tonumber(Shot.PendingFeedbackDamage) or 0) + Damage
            Shot.PendingFeedbackPlayer = Player
            Shot.PendingFeedbackCharacter = Character
            Shot.PendingFeedbackPartName = PartName
            if Shot.DamageFeedbackWaitQueued == true then return end
            Shot.DamageFeedbackWaitQueued = true
            Shot.PendingFeedbackDue = Clock() + 0.035
            local Queue = CombatLogRuntime.PendingFeedback
            Queue[#Queue + 1] = Shot
            while #Queue > 256 do Remove(Queue, 1) end
            return
        end
        Shot.DamageFeedbackPlayed = true
    end
    if Shot and Ragebot and type(Ragebot.FinalizeValidationShot) == "function" then Ragebot.FinalizeValidationShot(Shot, true, Damage, "DamageConfirmed") end
    local ExactPartName = Shot and (Shot.ConfirmedPartName or Shot.PartName) or PartName
    if ExactPartName then
        PartName = ExactPartName
        IsHeadshot = PartName == "Head"
    end
    local TargetPart = PartName and Character:FindFirstChild(PartName, true) or IsHeadshot and Character:FindFirstChild("Head", true) or
        Character:FindFirstChild("Torso", true) or Character:FindFirstChild("HumanoidRootPart", true) or Character.PrimaryPart or Character:FindFirstChildWhichIsA("BasePart", true)
    if not TargetPart or not TargetPart:IsA("BasePart") then return end

    if type(CombatLogRuntime.EmitOutgoingHit) == "function" then CombatLogRuntime.EmitOutgoingHit(Player, Character, Shot and Shot.Tool, PartName, Damage, Shot) end
    if type(HitFeedbackRuntimeState.SpawnConfirmedTracer) == "function" then HitFeedbackRuntimeState.SpawnConfirmedTracer(Shot, TargetPart) end
    Shared.SpawnConfirmedWorldHitmarker(TargetPart, IsHeadshot)
    Shared.SpawnConfirmedHitmarker(IsHeadshot)
    Shared.SpawnConfirmedHitImage()
    Shared.QueueConfirmedHitSound(Player, Character, IsHeadshot == true, Shot)
    Shared.SpawnGhostVisual(TargetPart.Position, Character)
    Shared.SpawnDamageIndicator(TargetPart, Damage, IsHeadshot)
    ExtendedVisuals:OnHit(TargetPart, Character, IsHeadshot)
end
function CombatLogRuntime.ProcessPendingFeedback(CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Queue = CombatLogRuntime.PendingFeedback
    local Processed = 0
    for Index = #Queue, 1, -1 do
        if Processed >= 48 then break end
        local Shot = Queue[Index]
        if not Shot or Shot.DamageFeedbackPlayed == true then
            Remove(Queue, Index)
        elseif CurrentTime >= (tonumber(Shot.PendingFeedbackDue) or CurrentTime) then
            Remove(Queue, Index)
            Shot.DamageFeedbackWaitQueued = false
            Shot.DamagePartWaited = true
            local PendingDamage = tonumber(Shot.PendingFeedbackDamage) or 0
            local PendingPlayer = Shot.PendingFeedbackPlayer
            local PendingCharacter = Shot.PendingFeedbackCharacter
            local ExactPartName = Shot.ConfirmedPartName or Shot.PartName or Shot.PendingFeedbackPartName
            Shot.PendingFeedbackDamage = nil
            Shot.PendingFeedbackPlayer = nil
            Shot.PendingFeedbackCharacter = nil
            Shot.PendingFeedbackPartName = nil
            Shot.PendingFeedbackDue = nil
            if PendingPlayer and PendingCharacter and PendingDamage > 0 then
                QueueConfirmedDamage(PendingPlayer, PendingCharacter, PendingDamage, ExactPartName == "Head", ExactPartName, Shot)
            end
            Processed += 1
        end
    end
end
function CombatLogRuntime.GetOutgoingSignalBucket(Player)
    if not Player then return nil end
    local Bucket = CombatLogRuntime.OutgoingSignals[Player]
    if type(Bucket) ~= "table" then
        Bucket = {}
        CombatLogRuntime.OutgoingSignals[Player] = Bucket
    end
    return Bucket
end
function CombatLogRuntime.PruneOutgoingSignals(Player, CurrentTime)
    local Bucket = CombatLogRuntime.OutgoingSignals[Player]
    if type(Bucket) ~= "table" then return end
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Window = Max(tonumber(CombatLogRuntime.OutgoingSignalWindow) or 0.90, 0.20)
    for Index = #Bucket, 1, -1 do
        local Entry = Bucket[Index]
        if not Entry or Entry.Logged == true or CurrentTime - (tonumber(Entry.Time) or 0) > Window then Remove(Bucket, Index) end
    end
    if #Bucket == 0 then CombatLogRuntime.OutgoingSignals[Player] = nil end
end
function CombatLogRuntime.EmitOutgoingHit(Player, Character, Tool, PartName, Damage, Shot, SignalEntry)
    if CombatLogState.Enabled ~= true or CombatLogState.Hits ~= true or not Player or Player == LocalPlayer or not Character then return false end
    if Shot and Shot.CombatLogHitLogged == true then return false end
    if SignalEntry and SignalEntry.Logged == true then return false end
    local CurrentTime = Clock()
    PartName = tostring(PartName or Shot and (Shot.ConfirmedPartName or Shot.PartName) or SignalEntry and SignalEntry.PartName or "Body")
    local DamageNumber = tonumber(Damage)
    if Shot then Shot.CombatLogHitLogged = true end
    if SignalEntry then SignalEntry.Logged = true end
    local PlayerName = CombatLogRuntime.GetDisplayName(Player)
    local WeaponName = CombatLogRuntime.GetWeaponName(Tool or Shot and Shot.Tool, LocalPlayer)
    local LocalRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local TargetRoot = Character:FindFirstChild("HumanoidRootPart")
    local Distance = LocalRoot and TargetRoot and (LocalRoot.Position - TargetRoot.Position).Magnitude or nil
    local DistanceText = CombatLogRuntime.FormatDistance(Distance)
    local Parts = {"[" .. PlayerName .. "]", WeaponName, PartName}
    if DamageNumber and DamageNumber > 0 then Parts[#Parts + 1] = tostring(Max(Floor(DamageNumber + 0.5), 1)) .. " dmg" end
    if DistanceText then Parts[#Parts + 1] = DistanceText .. " st" end
    CombatLogRuntime.Emit("Hit", Concat(Parts, "  ·  "), nil)
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid and Humanoid.Health <= 0 and (not Shot or Shot.KillLogged ~= true) then
        if Shot then Shot.KillLogged = true end
        local KillParts = {"[" .. PlayerName .. "] eliminated", WeaponName, PartName}
        if DistanceText then KillParts[#KillParts + 1] = DistanceText .. " st" end
        CombatLogRuntime.Emit("Kill", Concat(KillParts, "  ·  "), nil)
    end
    return true
end
function CombatLogRuntime.FindOutgoingSignal(Player, Character, CurrentTime)
    local Bucket = CombatLogRuntime.OutgoingSignals[Player]
    if type(Bucket) ~= "table" then return nil end
    CurrentTime = tonumber(CurrentTime) or Clock()
    CombatLogRuntime.PruneOutgoingSignals(Player, CurrentTime)
    Bucket = CombatLogRuntime.OutgoingSignals[Player]
    if type(Bucket) ~= "table" then return nil end
    local Best, BestScore
    for Index = #Bucket, 1, -1 do
        local Entry = Bucket[Index]
        if Entry and Entry.Logged ~= true and (not Character or Entry.Character == Character or Shared.GetPlayerFromTrackedCharacter(Entry.Character) == Player) then
            local Age = CurrentTime - (tonumber(Entry.Time) or CurrentTime)
            if Age >= -0.15 and Age <= (tonumber(CombatLogRuntime.OutgoingSignalWindow) or 0.90) then
                local Score = Abs(Age) - (Entry.ServerConfirmed == true and 0.20 or 0) - (Entry.Shot and 0.05 or 0)
                if BestScore == nil or Score < BestScore then Best, BestScore = Entry, Score end
            end
        end
    end
    return Best
end
function CombatLogRuntime.ConfirmOutgoingSignalDamage(Player, Character, Damage, SignalEntry)
    if not SignalEntry or SignalEntry.Logged == true then return false end
    local Shot = SignalEntry.Shot
    if Shot then
        Shot.DamageConfirmed = true
        Shot.ConfirmedAt = Clock()
        Shot.Resolution = "Hit"
        Shot.OwnershipState = "Owned"
        if SignalEntry.PartName then
            Shot.PartName = SignalEntry.PartName
            Shot.ConfirmedPartName = SignalEntry.PartName
            Shot.ConfirmedTargetPart = SignalEntry.TargetPart or Shot.ConfirmedTargetPart
        end
        Shared.ConfirmMergedRageShots(Shot, Player, Character)
        QueueConfirmedDamage(Player, Character, Damage, SignalEntry.PartName == "Head", SignalEntry.PartName, Shot)
    else
        CombatLogRuntime.EmitOutgoingHit(Player, Character, SignalEntry.Tool, SignalEntry.PartName, Damage, nil, SignalEntry)
    end
    SignalEntry.Logged = true
    return true
end
function CombatLogRuntime.GetOutgoingDamageQueue(Player)
    local Queue = CombatLogRuntime.OutgoingDamage[Player]
    if type(Queue) ~= "table" then
        Queue = {}
        CombatLogRuntime.OutgoingDamage[Player] = Queue
    end
    return Queue
end
function CombatLogRuntime.PopOutgoingDamage(Player, Character, CurrentTime)
    local Queue = CombatLogRuntime.OutgoingDamage[Player]
    if type(Queue) ~= "table" then return nil end
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Window = tonumber(CombatLogRuntime.OutgoingDamageWindow) or 0.40
    local BestIndex, BestAge
    for Index = #Queue, 1, -1 do
        local Entry = Queue[Index]
        local Age = Entry and Abs(CurrentTime - (tonumber(Entry.Time) or CurrentTime)) or math.huge
        if not Entry or CurrentTime - (tonumber(Entry.Time) or 0) > Window then
            Remove(Queue, Index)
        elseif (not Character or Entry.Character == Character) and Age <= Window and (BestAge == nil or Age < BestAge) then
            BestIndex, BestAge = Index, Age
        end
    end
    local Result = BestIndex and Remove(Queue, BestIndex) or nil
    if #Queue == 0 then CombatLogRuntime.OutgoingDamage[Player] = nil end
    return Result
end
function CombatLogRuntime.RecordOutgoingDamage(Player, Character, Damage)
    Damage = tonumber(Damage)
    if not Player or Player == LocalPlayer or not Character or not Damage or Damage <= 0 then return false end
    local CurrentTime = Clock()
    local SignalEntry = CombatLogRuntime.FindOutgoingSignal(Player, Character, CurrentTime)
    if SignalEntry then return CombatLogRuntime.ConfirmOutgoingSignalDamage(Player, Character, Damage, SignalEntry) end
    local Queue = CombatLogRuntime.GetOutgoingDamageQueue(Player)
    Queue[#Queue + 1] = {Time = CurrentTime, Character = Character, Damage = Damage}
    while #Queue > 64 do Remove(Queue, 1) end
    return false
end
function CombatLogRuntime.ResolvePendingSignalEntry(Entry)
    if not Entry or Entry.Logged == true or Entry.ServerConfirmed ~= true then return end
    local Player = Entry.Player
    local Character = Entry.Character
    local DamageEntry = Player and CombatLogRuntime.PopOutgoingDamage(Player, Character, Clock()) or nil
    if DamageEntry then
        CombatLogRuntime.ConfirmOutgoingSignalDamage(Player, Character, DamageEntry.Damage, Entry)
        return
    end
    if Entry.Shot then
        Entry.Shot.DamageConfirmed = true
        Entry.Shot.ConfirmedAt = Clock()
        Entry.Shot.Resolution = "HitSignal"
        Entry.Shot.OwnershipState = "Owned"
    end
    CombatLogRuntime.EmitOutgoingHit(Player, Character, Entry.Tool, Entry.PartName, nil, Entry.Shot, Entry)
end
function CombatLogRuntime.ProcessPendingSignalResolves(CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Queue = CombatLogRuntime.PendingSignalResolves
    local Processed = 0
    for Index = #Queue, 1, -1 do
        if Processed >= 64 then break end
        local Entry = Queue[Index]
        if not Entry or Entry.Logged == true then
            Remove(Queue, Index)
        elseif CurrentTime >= (tonumber(Entry.ResolveDue) or CurrentTime) then
            Remove(Queue, Index)
            Entry.ResolveQueued = false
            CombatLogRuntime.ResolvePendingSignalEntry(Entry)
            Processed += 1
        end
    end
end
function CombatLogRuntime.RecordOutgoingSignal(Tool, SignalName, TargetCharacter, TargetPart, Shot)
    if not TargetCharacter or not TargetPart or not TargetPart:IsA("BasePart") then return false end
    local Player = Shared.GetPlayerFromTrackedCharacter(TargetCharacter)
    if not Player or Player == LocalPlayer then return false end
    local CurrentTime = Clock()
    local PartName = TargetPart.Name
    local Bucket = CombatLogRuntime.GetOutgoingSignalBucket(Player)
    CombatLogRuntime.PruneOutgoingSignals(Player, CurrentTime)
    Bucket = CombatLogRuntime.GetOutgoingSignalBucket(Player)
    local Entry
    if Shot then
        for Index = #Bucket, 1, -1 do
            local Candidate = Bucket[Index]
            if Candidate and Candidate.Logged ~= true and Candidate.Shot == Shot then
                Entry = Candidate
                break
            end
        end
    end
    if not Entry then
        Entry = {Time = CurrentTime, Player = Player, Character = TargetCharacter, TargetPart = TargetPart, PartName = PartName, Tool = Tool, Shot = Shot, Logged = false, ServerConfirmed = false}
        Bucket[#Bucket + 1] = Entry
        while #Bucket > 64 do Remove(Bucket, 1) end
    else
        Entry.Time = CurrentTime
        Entry.Character = TargetCharacter
        Entry.TargetPart = TargetPart
        Entry.PartName = PartName
        Entry.Tool = Tool or Entry.Tool
    end
    if SignalName == "Hitmarker2" then Entry.ServerConfirmed = true end
    local DamageEntry = CombatLogRuntime.PopOutgoingDamage(Player, TargetCharacter, CurrentTime)
    if DamageEntry then return CombatLogRuntime.ConfirmOutgoingSignalDamage(Player, TargetCharacter, DamageEntry.Damage, Entry) end
    if Entry.ServerConfirmed == true and Entry.ResolveQueued ~= true then
        Entry.ResolveQueued = true
        Entry.ResolveDue = CurrentTime + 0.05
        local Queue = CombatLogRuntime.PendingSignalResolves
        Queue[#Queue + 1] = Entry
        while #Queue > 256 do Remove(Queue, 1) end
    end
    return true
end
function Shared.BufferUnconfirmedDamage(Player, Character, Damage)
    local CurrentTime = Clock()
    local Buffered = AttackConfirmationState.BufferedDamage[Player]
    if not Buffered or Buffered.Character ~= Character or CurrentTime - Buffered.Time > AttackConfirmationState.SignalWindow then
        Buffered = {Character = Character, Damage = 0, Time = CurrentTime, Version = 0}
        AttackConfirmationState.BufferedDamage[Player] = Buffered
    end
    Buffered.Damage += Damage
    Buffered.Time = CurrentTime
    Buffered.ExpiresAt = CurrentTime + AttackConfirmationState.SignalWindow
    Buffered.Version += 1
end
function Shared.TryConfirmBufferedDamage(Shot)
    if not Shot or not Shot.Player then return false end
    local Buffered = AttackConfirmationState.BufferedDamage[Shot.Player]
    local CurrentTime = Clock()
    if not Buffered or CurrentTime - Buffered.Time > AttackConfirmationState.SignalWindow or Buffered.Time < (tonumber(Shot.Time) or CurrentTime) - 0.08
        or not(Buffered.Character == Shot.Character or Shared.GetPlayerFromTrackedCharacter(Buffered.Character) == Shot.Player) then
        return false
    end
    if not Shared.CanConfirmShotDamage(Shot, Buffered.Time) then return false end
    AttackConfirmationState.BufferedDamage[Shot.Player] = nil
    Shot.DamageConfirmed = true
    Shot.ConfirmedAt = Clock()
    Shot.Resolution = "Hit"
    Shot.OwnershipState = "Owned"
    Shared.ConfirmMergedRageShots(Shot, Shot.Player, Buffered.Character)
    QueueConfirmedDamage(Shot.Player, Buffered.Character, Buffered.Damage, Shot.PartName == "Head", Shot.PartName, Shot)
    return true
end
function Shared.FindRecentToolShot(Tool, TargetCharacter)
    return Shared.FindBestToolShot(Tool, TargetCharacter)
end
function Shared.HandleConfirmedHitSignal(Tool, SignalName, ...)
    local TargetCharacter, TargetPart = Shared.ResolveHitSignalTarget(...)
    if not TargetCharacter or not TargetPart then
        local MouseTarget = Mouse and Mouse.Target
        TargetPart = MouseTarget
        TargetCharacter = Shared.GetHumanoidCharacterFromPart(MouseTarget)
    end
    local Shot = Shared.FindBestToolShotForSignal(Tool, TargetCharacter)
    if not Shot and TargetCharacter and TargetPart and Tool and IsVerifiedLocalFirearmTool(Tool) then
        local Origin = Shared.GetBulletTracerOrigin(Tool)
        local TargetPosition = TargetPart:IsA("BasePart") and TargetPart.Position or nil
        local Direction = typeof(Origin) == "Vector3" and typeof(TargetPosition) == "Vector3" and TargetPosition - Origin or nil
        Shot = Shared.RegisterLocalAttack(TargetCharacter, TargetPart, nil, Tool, Shared.InferLocalShotSource(TargetCharacter, "Manual"), Origin, Direction)
    end
    if Shot then
        if TargetCharacter and TargetPart then Shared.AttachAttackTarget(Shot, TargetCharacter, TargetPart) end
        Shared.MarkLocalShotSignal(Shot)
        if SignalName == "Hitmarker2" then Shot.ServerSignalConfirmed = true end
    end
    if TargetCharacter and TargetPart then CombatLogRuntime.RecordOutgoingSignal(Tool, SignalName, TargetCharacter, TargetPart, Shot) end
end
function Shared.BindToolHitSignal(Tool, SignalObject)
    if not SignalObject or HitVisualBoundSignals[SignalObject] then return end
    local Signal
    if SignalObject:IsA("BindableEvent") then
        Signal = SignalObject.Event
    elseif SignalObject:IsA("RemoteEvent") then
        Signal = SignalObject.OnClientEvent
    end
    if not Signal then return end
    HitVisualBoundSignals[SignalObject] = true
    local Connections = HitVisualToolConnections[Tool] if not Connections then return end
    Connections[#Connections + 1] = Signal:Connect(function(...) Shared.HandleConfirmedHitSignal(Tool, SignalObject.Name, ...) end)
end
function Shared.RegisterAttackTool(Tool)
    if not Tool or not Tool:IsA("Tool") or HitVisualToolConnections[Tool] then return end
    local Connections = {}
    HitVisualToolConnections[Tool] = Connections
    Connections[#Connections + 1] = Tool.ChildAdded:Connect(function(Child)
        HitFeedbackRuntimeState.BulletTracerWeaponCache[Tool] = nil
        HitFeedbackRuntimeState.BulletTracerMuzzleCache[Tool] = nil
        if Child.Name == "Hitmarker" or Child.Name == "Hitmarker2" then
            Shared.BindToolHitSignal(Tool, Child)
        elseif Child.Name == "Values" or Child.Name == "Config" then
            Defer(Shared.BindBulletTracerAmmo, Tool, Connections)
        end
    end)
    Connections[#Connections + 1] = Tool.AncestryChanged:Connect(function()
        if Tool.Parent then return end
        Shared.DisconnectConnectionList(HitVisualToolConnections[Tool])
        HitVisualToolConnections[Tool] = nil
    end)
    Shared.BindToolHitSignal(Tool, Tool:FindFirstChild("Hitmarker"))
    Shared.BindToolHitSignal(Tool, Tool:FindFirstChild("Hitmarker2"))
    Shared.BindBulletTracerAmmo(Tool, Connections)
end
function Shared.RegisterToolContainer(Container)
    if not Container or HitVisualContainerConnections[Container] then return end
    for _, Child in ipairs(Container:GetChildren()) do Shared.RegisterAttackTool(Child) end
    HitVisualContainerConnections[Container] = Container.ChildAdded:Connect(Shared.RegisterAttackTool)
end
function Shared.RegisterLocalCharacter(Character)
    if not Character then return end
    if HitVisualLocalCharacterContainer and HitVisualLocalCharacterContainer ~= Character then Shared.DisconnectHitVisualContainer(HitVisualLocalCharacterContainer) end
    HitVisualLocalCharacterContainer = Character
    Shared.RegisterToolContainer(Character)
    CombatLogRuntime.BindLocalDamage(Character)
end
function Shared.RegisterTargetCharacter(Player, Character)
    if Player == LocalPlayer or not Player then return end
    Character = ResolveTrackedCharacter(Player, Character)
    if not Character then return end
    CombatLogRuntime.BindEnemyWeaponTracking(Player, Character)
    local Humanoid = Character:FindFirstChildOfClass("Humanoid") or Character:WaitForChild("Humanoid", 5) if not Humanoid then return end
    if HitVisualTrackedCharacters[Player] == Character and HitVisualHumanoidConnections[Player] then return end
    Shared.DisconnectConnection(HitVisualHumanoidConnections[Player])
    AttackConfirmationState.PendingDamage[Player] = nil
    AttackConfirmationState.BufferedDamage[Player] = nil
    HitVisualTrackedCharacters[Player] = Character
    HitVisualPreviousHealth[Player] = Humanoid.Health
    HitVisualHumanoidConnections[Player] = Humanoid.HealthChanged:Connect(function(NewHealth)
        if HitVisualTrackedCharacters[Player] ~= Character then return end
        local PreviousHealth = HitVisualPreviousHealth[Player]
        HitVisualPreviousHealth[Player] = NewHealth
        if type(PreviousHealth) ~= "number" then return end
        local Damage = PreviousHealth - NewHealth
        if Damage <= 0 or not Shared.IsShotTrackingEnabled() then return end
        if CombatLogRuntime.RecordOutgoingDamage(Player, Character, Damage) then return end
        if #AttackConfirmationState.Shots == 0 then return end
        local Confirmation = Shared.FindTargetAwareAttackConfirmation(Player, Character)
        if not Confirmation then
            Shared.BufferUnconfirmedDamage(Player, Character, Damage)
            return
        end
        Confirmation.DamageConfirmed = true
        Confirmation.ConfirmedAt = Clock()
        Confirmation.Resolution = "Hit"
        Confirmation.OwnershipState = "Owned"
        Shared.ConfirmMergedRageShots(Confirmation, Player, Character)
        QueueConfirmedDamage(Player, Character, Damage, Confirmation.PartName == "Head", Confirmation.PartName, Confirmation)
    end)
end
ResetHitFeedbackForRespawn = function()
    if CombatLogRuntime.LocalDamageConnection then
        Shared.SafeDisconnect(CombatLogRuntime.LocalDamageConnection)
        CombatLogRuntime.LocalDamageConnection = nil
    end
    CombatLogRuntime.LocalCharacter = nil
    CombatLogRuntime.LocalHumanoid = nil
    CombatLogRuntime.PreviousLocalHealth = nil
    CombatLogRuntime.RecentEnemyShots = {}
    Clear(CombatLogRuntime.RecentEnemyWeapons)
    CombatLogRuntime.ClearEnemyWeaponTracking()
    CombatLogRuntime.RecentDamageAt = 0
    CombatLogRuntime.IncomingPending = setmetatable({}, {__mode = "k"})
    Clear(CombatLogRuntime.IncomingRecentShots)
    CombatLogRuntime.DamageAccumulator = 0
    CombatLogRuntime.DamageAccumulatorVersion += 1
    CombatLogRuntime.DamageAccumulatorCharacter = nil
    CombatLogRuntime.DamageAccumulatorHumanoid = nil
    CombatLogRuntime.OutgoingSignals = setmetatable({}, {__mode = "k"})
    CombatLogRuntime.OutgoingDamage = setmetatable({}, {__mode = "k"})
    CombatLogRuntime.OutgoingLastLog = setmetatable({}, {__mode = "k"})
    Clear(AttackConfirmationState.Shots)
    Clear(AttackConfirmationState.ByToken)
    AttackConfirmationState.Serial = 0
    Clear(AttackConfirmationState.PendingDamage)
    Clear(AttackConfirmationState.BufferedDamage)
    Clear(CombatLogRuntime.PendingMisses)
    Clear(CombatLogRuntime.PendingSignalResolves)
    Clear(CombatLogRuntime.PendingFeedback)
    Clear(CombatLogRuntime.LogQueue)
    CombatLogRuntime.LogQueueHead = 1
    CombatLogRuntime.LogQueueTail = 0
    for Object in pairs(HitFeedbackRuntimeState.ActiveObjects) do
        Shared.SafeCall(function() if Object and Object.Parent then Object:Destroy() end end)
    end
    Clear(HitFeedbackRuntimeState.ActiveObjects)
    Clear(HitFeedbackRuntimeState.BulletTracerMuzzleCache)
    Clear(HitFeedbackRuntimeState.BulletTracerAmmoObjects)
    Clear(HitFeedbackRuntimeState.BulletTracerAmmoSuppression)
    Clear(HitFeedbackRuntimeState.BulletTracerWeaponCache)
    Clear(HitFeedbackRuntimeState.BulletTracerLastSpawn)
    Clear(HitFeedbackRuntimeState.BulletTracerLastRemoteShot)
    Clear(HitFeedbackRuntimeState.BulletTracerLastAmmoDecrease)
    Clear(HitFeedbackRuntimeState.BulletTracerPendingRemote)
    HitFeedbackRuntimeState.ActiveBulletTracers = 0
    HitFeedbackRuntimeState.FinishSerial += 1
    HitFeedbackRuntimeState.FinishTokens = setmetatable({}, {__mode = "k"})
    for Tool, Connections in pairs(HitVisualToolConnections) do
        Shared.DisconnectConnectionList(Connections)
        HitVisualToolConnections[Tool] = nil
    end
    if HitVisualLocalCharacterContainer then
        Shared.DisconnectHitVisualContainer(HitVisualLocalCharacterContainer)
        HitVisualLocalCharacterContainer = nil
    end
    HitVisualBoundSignals = setmetatable({}, {__mode = "k"})
    RefreshLocalShotTracking()
end
DestroyHitFeedbackRuntime = function()
    if CombatLogRuntime.LocalDamageConnection then
        Shared.SafeDisconnect(CombatLogRuntime.LocalDamageConnection)
        CombatLogRuntime.LocalDamageConnection = nil
    end
    if CombatLogRuntime.EnemyVisualizeConnection then
        Shared.SafeDisconnect(CombatLogRuntime.EnemyVisualizeConnection)
        CombatLogRuntime.EnemyVisualizeConnection = nil
    end
    CombatLogRuntime.ClearEnemyWeaponTracking()
    Clear(CombatLogRuntime.RecentEnemyWeapons)
    for _, Connection in ipairs(CombatLogRuntime.EnemyShotConnections) do
        if Connection then Shared.SafeDisconnect(Connection) end
    end
