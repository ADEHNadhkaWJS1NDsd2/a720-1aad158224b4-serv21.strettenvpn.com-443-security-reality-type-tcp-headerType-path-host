    DesyncNetworkState.LocalServerReplica = Copy
    DesyncNetworkState.LocalServerReplicaLastSend = tonumber(CurrentTime) or Clock()
    DesyncNetworkState.LocalServerReplicaBlocked = 0
    if Copy.RawPayload and typeof(Copy.RawPosition) == "Vector3" then
        DesyncNetworkState.LastSentPhysicsPayload = Copy.RawPayload
        DesyncNetworkState.LastSentPhysicsPosition = Copy.RawPosition
        DesyncNetworkState.LastSentPhysicsTime = tonumber(CurrentTime) or Clock()
        RegisterAtramentaPendingReplica(Copy.Sequence, Copy.RawPayload, Copy.RawPosition, tonumber(CurrentTime) or Clock(), WasPatched == true
                and ((Copy.PhysicsStrategy == "RawXYZ" and "PatchedSent" or "ReplaySent")) or "Outbound")
    end
    return true
end
function GetAtramentaLocalServerReplicaSnapshot(CurrentTime)
    local Snapshot = DesyncNetworkState.LocalServerReplica
