function ExtendedVisuals:HideCharacterPart(Part)
    if not Part or not Part.Parent then return end
    local Data = self.Character.HiddenParts[Part]
    if not Data then
        local SavedAppearance = self.Character.SavedParts[Part]
        local Transparency = SavedAppearance and SavedAppearance.Transparency or Part.Transparency
        if InvisibilityEnabled and Transparency < 1 then Transparency = 0 end
        Data = {Transparency = Transparency}
        self.Character.HiddenParts[Part] = Data
    end
    Part.Transparency = 1
end
function ExtendedVisuals:RestoreHiddenCharacterPart(Part)
    local Data = Part and self.Character.HiddenParts[Part] if not Data then return end
    if Part.Parent then
        local Transparency = tonumber(Data.Transparency)
        if Transparency == nil then Transparency = 0 end
        if InvisibilityEnabled and Transparency < 1 then Transparency = 0.5 end
        Part.Transparency = Clamp(Transparency, 0, 1)
    end
    self.Character.HiddenParts[Part] = nil
end
function ExtendedVisuals:RestoreCharacterParts()
    local PartSnapshots = {}
    local ClothingSnapshots = {}
    local TextureSnapshots = {}
    for Part, Data in pairs(self.Character.SavedParts) do PartSnapshots[Part] = Data end
    for Object, Data in pairs(self.Character.SavedClothing) do ClothingSnapshots[Object] = Data end
    for Object, Data in pairs(self.Character.SavedMeshTextures) do TextureSnapshots[Object] = Data end
    for Part in pairs(self.Character.SavedParts) do self:RestoreCharacterAppearancePart(Part) end
    for Part in pairs(self.Character.HiddenParts) do self:RestoreHiddenCharacterPart(Part) end
    self:RestoreCharacterClothing()
    self:RestoreCharacterMeshTextures()
    self.Character.SavedParts = setmetatable({}, {__mode = "k"})
    self.Character.SavedClothing = setmetatable({}, {__mode = "k"})
    self.Character.SavedMeshTextures = setmetatable({}, {__mode = "k"})
    self.Character.HiddenParts = setmetatable({}, {__mode = "k"})
    local function RestoreReplayVisuals()
        if self.Character.MaterialEnabled == true then return end
        for Part, Data in pairs(PartSnapshots) do
            if Part and Part.Parent then Shared.SafeCall(Shared.RestoreAtramentaCharacterMaterialPart, Part, Data) end
        end
        for Object, Data in pairs(ClothingSnapshots) do
            if Object and Object.Parent and type(Data) == "table" and Data.Property then Shared.SafeCall(function() Object[Data.Property] = Data.Value or "" end) end
        end
        for Object, Saved in pairs(TextureSnapshots) do
            if not Object or not Object.Parent then continue end
            if type(Saved) == "table" then
                if Object:IsA("SpecialMesh") or Object:IsA("FileMesh") then
                    Shared.SafeCall(function() Object.TextureId = Saved.TextureId or "" end)
                elseif Object:IsA("Decal") or Object:IsA("Texture") then
                    Shared.SafeCall(function() Object.Texture = Saved.Texture or "" end)
                elseif Object:IsA("SurfaceAppearance") then
                    Shared.SafeCall(function()
                        Object.ColorMap = Saved.ColorMap or ""
                        Object.MetalnessMap = Saved.MetalnessMap or ""
                        Object.NormalMap = Saved.NormalMap or ""
                        Object.RoughnessMap = Saved.RoughnessMap or ""
                    end)
                end
            end
        end
    end
    Defer(RestoreReplayVisuals)
    Delay(0.10, RestoreReplayVisuals)
end
function ExtendedVisuals:NormalizeCharacterTransparency(Character)
    if InvisibilityEnabled then return end
    Character = Character or LocalPlayer.Character
    if not Character then return end
    local BodyNames = {Head = true, Torso = true, UpperTorso = true, LowerTorso = true, ["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
        LeftUpperArm = true, LeftLowerArm = true, LeftHand = true, RightUpperArm = true, RightLowerArm = true, RightHand = true,
        LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true, RightUpperLeg = true, RightLowerLeg = true, RightFoot = true}
    for _, Part in ipairs(Character:GetDescendants()) do
        if Part:IsA("BasePart") and BodyNames[Part.Name] and Abs(Part.Transparency - 0.5) <= 0.001 then Part.Transparency = 0 end
    end
end
function ExtendedVisuals:ClearCharacterObjectCache()
