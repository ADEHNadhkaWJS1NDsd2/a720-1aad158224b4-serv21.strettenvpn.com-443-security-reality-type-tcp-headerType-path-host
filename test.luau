function Shared.IsConfirmedKillState(Player, Character, Shot)
    if not Player or Player.Parent ~= Players then return true end
    if not Character or not Character.Parent or Player.Character ~= Character then return true end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or not Humanoid.Parent or Humanoid.Health <= 0 or Humanoid:GetState() == Enum.HumanoidStateType.Dead then return true end
    if Shot and Shot.TargetWasDowned == true then
        local Downed = Shared.GetAtramentaDownedObject(Player)
        if not Downed or Downed.Value ~= true then return true end
    end
    return false
end
function Shared.QueueConfirmedHitSound(Player, Character, IsHeadshot, Shot)

    if Shot and Shot.DamageConfirmed ~= true then return end
    if Shot and (Shot.HitSoundPlayed == true or Shot.HitSoundQueued == true) then return end
    if Shot then Shot.HitSoundQueued = true end
    Spawn(function()
        local WasDowned = Shot and Shot.TargetWasDowned == true
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local Downed = Player and Shared.GetAtramentaDownedObject(Player) or nil
        local Signals = {Character and Character.AncestryChanged or nil, Player and Shared.GetPropertyChangedSignalSafe(Player, "Character") or nil,
            Humanoid and Shared.GetPropertyChangedSignalSafe(Humanoid, "Health") or nil, Downed and Shared.GetPropertyChangedSignalSafe(Downed, "Value") or nil}
        local IsKill = Shared.IsConfirmedKillState(Player, Character, Shot)
        if not IsKill then
            Shared.WaitForConditionSignal(function() return Shared.IsConfirmedKillState(Player, Character, Shot) end, WasDowned and 0.32 or 0.12, Signals)
            IsKill = Shared.IsConfirmedKillState(Player, Character, Shot)
        end
        if Shot then
            if Shot.HitSoundPlayed == true then return end
            Shot.HitSoundQueued = false
            Shot.HitSoundPlayed = true
            Shot.KillConfirmed = IsKill == true
            if IsKill then Shot.FinishSoundPlayed = true end
        end
        Shared.PlayConfirmedHitSound(IsHeadshot == true, IsKill == true)
    end)
end
