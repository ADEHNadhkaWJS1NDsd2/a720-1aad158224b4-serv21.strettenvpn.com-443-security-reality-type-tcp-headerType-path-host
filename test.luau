function CombatLogRuntime.RememberEnemyWeapon(Player, Tool, Config, SourceType)
    if not Player or Player == LocalPlayer then return nil end
    local Name
    if Tool and typeof(Tool) == "Instance" then
        local Current = Tool
        while Current and Current ~= game do
            if Current:IsA("Tool") then
                Name = CombatLogRuntime.CleanWeaponName(Current.Name)
                Tool = Current
                break
            end
            Current = Current.Parent
        end
    end
    if (not Name or Name == "unknown") and type(Config) == "table" then
        local ConfigName = rawget(Config, "Name")
        if type(ConfigName) == "string" and ConfigName ~= "" then Name = CombatLogRuntime.CleanWeaponName(ConfigName) end
    end
    if Name and Name ~= "unknown" then
        CombatLogRuntime.RecentEnemyWeapons[Player] = {Name = Name, Tool = Tool, Time = Clock(), SourceType = SourceType}
        return Name
    end
    return nil
end
function CombatLogRuntime.GetRecentEnemyWeapon(Player, MaximumAge)
    local Entry = Player and CombatLogRuntime.RecentEnemyWeapons[Player] or nil
    if type(Entry) ~= "table" or type(Entry.Name) ~= "string" then return nil end
    if Clock() - (tonumber(Entry.Time) or 0) > Max(tonumber(MaximumAge) or 5, 0.1) then return nil end
    return CombatLogRuntime.CleanWeaponName(Entry.Name), Entry.Tool, Entry.SourceType
end
function CombatLogRuntime.GetWeaponName(Tool, Player, SourceType)
    if Tool and typeof(Tool) == "Instance" then
        local Current = Tool
        while Current and Current ~= game do
            if Current:IsA("Tool") then
                local Name = CombatLogRuntime.CleanWeaponName(Current.Name)
                if Player then CombatLogRuntime.RememberEnemyWeapon(Player, Current, nil, SourceType) end
                return Name
            end
            Current = Current.Parent
        end
    elseif type(Tool) == "table" then
        local ConfigName = rawget(Tool, "Name")
        if type(ConfigName) == "string" and ConfigName ~= "" then return CombatLogRuntime.CleanWeaponName(ConfigName) end
    end
    local Character = Player and ResolveTrackedCharacter(Player, Player.Character) or nil
    local Equipped = Character and Character:FindFirstChildOfClass("Tool")
    if Equipped then
        local Name = CombatLogRuntime.CleanWeaponName(Equipped.Name)
        CombatLogRuntime.RememberEnemyWeapon(Player, Equipped, nil, SourceType)
        return Name
    end
    local RecentName = CombatLogRuntime.GetRecentEnemyWeapon(Player, 6)
    if RecentName then return RecentName end
    SourceType = tostring(SourceType or "")
    if SourceType == "Bullet" then return "firearm" end
    if SourceType == "Melee" then return "melee" end
    if SourceType == "Explosive" then return "explosive" end
    return "damage"
end
function CombatLogRuntime.FormatDistance(Value)
    Value = tonumber(Value)
    if not Value or Value ~= Value or Value == Infinite or Value == -Infinite then return nil end
    if Value >= 100 then return tostring(Floor(Value + 0.5)) end
    return Format("%.1f", Value)
end
