    for Index = 1, 72 do
        local Line = Shared.CreateOverlayPrimitive("Line", {Visible = false, Thickness = Clamp(tonumber(Ragebot.Settings.FOVThickness) or 2, 1, 8),
            Transparency = Clamp(tonumber(Ragebot.Settings.FOVGradientTransparency) or 0.72, 0, 1)})
        if Line then Ragebot.FOVGradientLines[#Ragebot.FOVGradientLines + 1] = Line end
    end
