        Desired += NewVector3((Math.random() * 2 - 1) * Spread, (Math.random() * 2 - 1) * Spread, (Math.random() * 2 - 1) * Spread)
        if PredictionTime <= 0 and not PartSuspicious then Desired = GetCriminologySilentAimSafePoint(Part, Desired, 0.035) or Desired end
    end
    if AtramentaConfig.Aim.SilentAimPoint == "Closest Point" and not PartSuspicious and PredictionTime <= 0 then
        Desired = GetCriminologySilentAimStablePoint(Part, Desired) or Desired
