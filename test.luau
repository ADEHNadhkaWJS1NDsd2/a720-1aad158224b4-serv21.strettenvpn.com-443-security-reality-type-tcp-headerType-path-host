function ResolverRuntime.Heartbeat(DeltaTime)
    ResolverRuntime.Accumulator += Max(tonumber(DeltaTime) or 0, 0)
    if ResolverRuntime.Accumulator < ResolverRuntime.Interval then return end
    ResolverRuntime.Accumulator %= ResolverRuntime.Interval
    local Aim = AtramentaConfig and AtramentaConfig.Aim
    local Player
    local ResolverSettings
    if Aim and Aim.AimbotEnabled == true and Aim.AimbotResolver == true then Player, ResolverSettings = Aim.AimbotLockedTarget or Aim.CurrentTarget, Aim end
    if not Player and Aim and Aim.SilentEnabled == true and Aim.SilentResolver == true then Player, ResolverSettings = Aim.SilentAimLockedTarget or Aim.CurrentTarget, Aim end
    if not Player and Ragebot and Ragebot.Enabled == true and Ragebot.Settings and Ragebot.Settings.Resolver == true then
        Player, ResolverSettings = Ragebot.LockedTarget or Ragebot.CurrentTarget or Ragebot.Runtime and Ragebot.Runtime.Target, Ragebot.Runtime.SimulationSettings
    end
    if typeof(Player) == "Instance" and Player:IsA("Player") and Player ~= LocalPlayer then
        local Character = ResolveTrackedCharacter(Player, Player.Character)
        if Character then ResolverSampleMotion(Player, Character, ResolverSettings or {}) end
    end
end
