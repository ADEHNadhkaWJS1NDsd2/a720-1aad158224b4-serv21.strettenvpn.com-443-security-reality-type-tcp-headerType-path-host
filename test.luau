    end
    return Root and Shared.GetKnownWeaponKey(Root.Name) or nil
end
function Shared.BuildWeaponSignatureIndex()
    local CurrentTime = Clock()
    if type(Shared.WeaponSignatureIndex) == "table" and CurrentTime - Shared.WeaponSignatureBuiltAt < 45 then
        return Shared.WeaponSignatureIndex
    end
    local Index = {}
    local Roots = {ReplicatedStorage, LocalPlayer.Backpack, LocalPlayer.Character}
    for RootIndex = 1, #Roots do
        local Root = Roots[RootIndex]
        if Root then
            for _, Candidate in ipairs(Root:GetDescendants()) do
                if Candidate:IsA("Tool") or Candidate:IsA("Model") or Candidate:IsA("Folder") then
                    local Key = Shared.GetWeaponCandidateKey(Candidate, Root)
                    if Key then Shared.RegisterWeaponSignature(Index, Shared.GetWeaponMeshSignature(Candidate), Key) end
                end
            end
        end
    end
    Shared.WeaponSignatureIndex = Index
    Shared.WeaponSignatureBuiltAt = CurrentTime
    return Index
end
function Shared.ResolveWeaponSignatureKey(Object)
    local Signature = Shared.GetWeaponMeshSignature(Object)
    if not Signature then return nil end
    local Key = Shared.BuildWeaponSignatureIndex()[Signature]
    return type(Key) == "string" and Key or nil
end
function Shared.InvalidateDroppedWeaponIdentity(Object)
