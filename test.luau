function Shared.GetShotRayDistance(Shot, WorldPosition)
    if type(Shot) ~= "table" or typeof(WorldPosition) ~= "Vector3" or typeof(Shot.Origin) ~= "Vector3"
        or typeof(Shot.Direction) ~= "Vector3" or Shot.Direction.Magnitude <= 0.001 then return Infinite, nil end
    local Direction = Shot.Direction.Unit
    local Delta = WorldPosition - Shot.Origin
    local Along = Delta:Dot(Direction)
    if Along < -2 then return Infinite, Along end
    local Maximum = AttackConfirmationState.ShotRange
    if typeof(Shot.HitPosition) == "Vector3" then Maximum = Max((Shot.HitPosition - Shot.Origin).Magnitude + 8, 8) end
    if Along > Maximum then return Infinite, Along end
    local Closest = Shot.Origin + Direction * Max(Along, 0)
    return (WorldPosition - Closest).Magnitude, Along
end
function Shared.GetShotDamageCandidateScore(Shot, Player, Character, CurrentTime)
    if type(Shot) ~= "table" or Shot.DamageConfirmed == true or Shot.Discarded == true then return nil end
    CurrentTime = tonumber(CurrentTime) or Clock()
    if not Shared.CanConfirmShotDamage(Shot, CurrentTime) then return nil end
    local Age = CurrentTime - (tonumber(Shot.Time) or CurrentTime)
    if Shot.Player and Player and Shot.Player ~= Player then return nil end
    if Shot.Character and Character and Shot.Character ~= Character and Shared.GetPlayerFromTrackedCharacter(Shot.Character) ~= Player then return nil end
    local Score = Shared.GetLocalShotEvidenceScore(Shot) * 12 - Max(Age, 0) * 15
    local ExactTarget = Shot.Player == Player or Shot.Character == Character
    if ExactTarget then Score += 90 end
    if Shot.SignalConfirmed == true then Score += 35 end
    if Shot.RemoteConfirmed == true then Score += 24 end
    if Shot.AmmoConfirmed == true then Score += 18 end
    if Shot.Token ~= nil then Score += 6 end
    if not ExactTarget and Character then
        local Root = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Head") or Character.PrimaryPart
        if not Root or not Root:IsA("BasePart") then return nil end
        local RayDistance = Shared.GetShotRayDistance(Shot, Root.Position)
        local Threshold = Clamp(Root.Size.Magnitude * 0.9 + 2.2, 3.2, 7.5)
        if RayDistance > Threshold then return nil end
        Score += 52 - RayDistance * 6
    end
    local ActiveTarget = Shared.GetActiveConfirmedCombatTarget and Shared.GetActiveConfirmedCombatTarget() or nil
    local Source = Shared.NormalizeLocalAttackSource(Shot.Source)
    if ActiveTarget == Player and (Source == "RageBot" or Source == "SilentAim" or Source == "Aimbot") then Score += 20 end
    return Score
end
function Shared.FindBestOwnedShot(Player, Character, Tool, CurrentTime)
    Shared.CleanupAttackConfirmations()
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Best, BestScore = nil, -Infinite
    for Index = #AttackConfirmationState.Shots, 1, -1 do
        local Shot = AttackConfirmationState.Shots[Index]
        if Shot and (not Tool or Shot.Tool == Tool) then
            local Score = Shared.GetShotDamageCandidateScore(Shot, Player, Character, CurrentTime)
            if Score and Score > BestScore then Best, BestScore = Shot, Score end
        end
    end
    return Best, BestScore
end
function Shared.FindBestAmmoShot(Tool, CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
