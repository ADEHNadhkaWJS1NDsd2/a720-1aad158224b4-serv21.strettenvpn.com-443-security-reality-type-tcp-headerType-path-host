function KeepJoint(Joint)
    if not Joint or not Joint:IsA("Motor6D") or BodyHide.Saved[Joint] then return end
    BodyHide.Saved[Joint] = {C0 = Joint.C0, C1 = Joint.C1, Transform = Joint.Transform}
end

function RestoreBodyHide()
    for Joint, Data in pairs(BodyHide.Saved) do
        if Joint and Joint.Parent and type(Data) == "table" then
            if typeof(Data.C0) == "CFrame" then Joint.C0 = Data.C0 end
            if typeof(Data.C1) == "CFrame" then Joint.C1 = Data.C1 end
            if typeof(Data.Transform) == "CFrame" then Joint.Transform = Data.Transform end
        end
        BodyHide.Saved[Joint] = nil
    end
end

