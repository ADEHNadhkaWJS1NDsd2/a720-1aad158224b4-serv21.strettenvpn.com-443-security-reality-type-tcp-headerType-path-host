function Shared.ReadWeaponConfigKey(Container)
    if not Container then return nil end
    local Config = Container:FindFirstChild("Config", true)
    if not Config or not Config:IsA("ModuleScript") then return nil end
    local Success, Data = Shared.SafeCall(require, Config)
    if not Success or type(Data) ~= "table" then return nil end
    local Key = Shared.GetKnownWeaponKey(Data.Name)
    if Key then return Key end
    return Shared.GetKnownWeaponKey(Data.DisplayName)
