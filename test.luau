function Ragebot.GetGameConfig()
    if type(Ragebot.GameGetConfig) == "function" then
        return Ragebot.GameGetConfig
    end
    local NewModules = ReplicatedStorage:FindFirstChild("NewModules")
    local SharedModules = NewModules and NewModules:FindFirstChild("Shared")
    local Extensions = SharedModules and SharedModules:FindFirstChild("Extensions")
    local Module = Extensions and Extensions:FindFirstChild("GetConfig")
    if Module and Module:IsA("ModuleScript") then
        local Success, Getter = Shared.SafeCall(require, Module)
        if Success and type(Getter) == "function" then
            Ragebot.GameGetConfig = Getter
            return Getter
        end
    end
    return nil
end

function Ragebot.GetWeaponConfigModule(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return nil
    end
    local Cached = Ragebot.WeaponConfigModuleCache[Tool]
    if Cached and Cached.Parent and Cached:IsDescendantOf(Tool) then
        return Cached
    end
    local Module = Tool:FindFirstChild("Config")
    if Module and Module:IsA("ModuleScript") then
        Ragebot.WeaponConfigModuleCache[Tool] = Module
        return Module
    end
    return nil
end

function Ragebot.IsMeleeConfig(Config)
    return type(Config) == "table" and type(Config.Mains) == "table" and (tonumber(Config.SlashStages) ~= nil or type(Config.Mains.S1) == "table")
end

function Ragebot.HasFirearmEvidence(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return false
    end
    if Tool:GetAttribute("__IsGUN") == true then
        return true
    end
    if type(IsVerifiedLocalFirearmTool) == "function" and IsVerifiedLocalFirearmTool(Tool) then
        return true
    end
    local Values = Tool:FindFirstChild("Values")
    if Values then
        if Values:FindFirstChild("SERVER_Ammo") or Values:FindFirstChild("SERVER_StoredAmmo") then
            return true
        end
        if Tool:FindFirstChild("Hitmarker") and (Values:FindFirstChild("Ammo") or Values:FindFirstChild("StoredAmmo")) then
            return true
        end
    end
    return false
end

function Ragebot.GetWeaponConfig(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return nil
    end
    local Cached = Ragebot.WeaponConfigCache[Tool]
    if type(Cached) == "table" then
        if Ragebot.IsMeleeConfig(Cached) then
            return nil
        end
        return Cached
    end
    local ConfigModule = Ragebot.GetWeaponConfigModule(Tool)
    if ConfigModule then
        local Success, Config = Shared.SafeCall(require, ConfigModule)
        if Success and type(Config) == "table" then
            if Ragebot.IsMeleeConfig(Config) then
                Ragebot.WeaponConfigCache[Tool] = Config
                return nil
            end
            Ragebot.WeaponConfigCache[Tool] = Config
            return Config
        end
    end
    if not Ragebot.HasFirearmEvidence(Tool) then
        return nil
    end
    local Now = Clock()
    local RetryAt = tonumber(Ragebot.WeaponConfigFailureUntil[Tool]) or 0
    if Now < RetryAt then
        return nil
    end
    local Getter = Ragebot.GetGameConfig()
    if type(Getter) == "function" then
        local Success, Config = Shared.SafeCall(Getter, Tool.Name)
        if Success and type(Config) == "table" and not Ragebot.IsMeleeConfig(Config) then
            Ragebot.WeaponConfigCache[Tool] = Config
            Ragebot.WeaponConfigFailureUntil[Tool] = nil
            return Config
        end
    end
    Ragebot.WeaponConfigFailureUntil[Tool] = Now + 1.50
    return nil
end

function Ragebot.IsGun(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return false
    end
    if Ragebot.HasFirearmEvidence(Tool) then
        return true
    end
    return Ragebot.GetWeaponConfig(Tool) ~= nil
end
