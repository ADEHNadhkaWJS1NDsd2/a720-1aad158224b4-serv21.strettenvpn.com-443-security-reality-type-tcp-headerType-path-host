                Object.NormalMap = Saved.NormalMap or ""
                Object.RoughnessMap = Saved.RoughnessMap or ""
            end
        elseif Object and Object.Parent and type(Saved) == "string" and (Object:IsA("SpecialMesh") or Object:IsA("FileMesh")) then
            Object.TextureId = Saved
        end
        self.Character.SavedMeshTextures[Object] = nil
    end
end
function ExtendedVisuals:SaveCharacterClothing(Object, Property)
