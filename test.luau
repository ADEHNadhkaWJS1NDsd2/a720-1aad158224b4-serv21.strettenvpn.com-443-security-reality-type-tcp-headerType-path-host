function ApplyWorldLightingCore()
    if not Visuals.World.Enabled then return end
    local Original = Visuals.World.Original
    local TechnologyName = tostring(Visuals.World.Technology or "Future")
    local TechnologyValue = Enum.Technology[TechnologyName]
    if typeof(TechnologyValue) == "EnumItem" then Shared.SetLightingTechnology(TechnologyValue) end
    if Visuals.World.AmbienceEnabled then
        Shared.SetWorldProperty(Lighting, "Ambient", Visuals.World.Ambient)
        Shared.SetWorldProperty(Lighting, "OutdoorAmbient", Visuals.World.OutdoorAmbient)
    elseif Original then
        Shared.SetWorldProperty(Lighting, "Ambient", Original.Ambient)
        Shared.SetWorldProperty(Lighting, "OutdoorAmbient", Original.OutdoorAmbient)
    end
    if Visuals.World.ColorShiftEnabled then
        Shared.SetWorldProperty(Lighting, "ColorShift_Top", Visuals.World.ColorShiftTop)
        Shared.SetWorldProperty(Lighting, "ColorShift_Bottom", Visuals.World.ColorShiftBottom)
    elseif Original then
        Shared.SetWorldProperty(Lighting, "ColorShift_Top", Original.ColorShiftTop)
        Shared.SetWorldProperty(Lighting, "ColorShift_Bottom", Original.ColorShiftBottom)
    end
    Shared.SetWorldProperty(Lighting, "Brightness", Visuals.World.Brightness)
    if Visuals.World.TimeLock then Shared.SetWorldProperty(Lighting, "ClockTime", Visuals.World.ClockTime) end
    if Visuals.World.ExposureEnabled then
        Shared.SetWorldProperty(Lighting, "ExposureCompensation", Clamp(tonumber(Visuals.World.ExposureCompensation) or 0, -5, 5))
    elseif Original then
        Shared.SetWorldProperty(Lighting, "ExposureCompensation", Original.ExposureCompensation)
    end
    Shared.SetWorldProperty(Lighting, "GlobalShadows", Visuals.World.GlobalShadows == true)
    Shared.SetWorldProperty(Lighting, "ShadowSoftness", Clamp(tonumber(Visuals.World.ShadowSoftness) or 0.5, 0, 1))
    Shared.SetWorldProperty(Lighting, "EnvironmentDiffuseScale", Clamp(tonumber(Visuals.World.EnvironmentDiffuseScale) or 1, 0, 1))
    Shared.SetWorldProperty(Lighting, "EnvironmentSpecularScale", Clamp(tonumber(Visuals.World.EnvironmentSpecularScale) or 1, 0, 1))
    if Visuals.World.FogEnabled then
        local FogDistance = Max(tonumber(Visuals.World.FogDistance) or 900, 25)
        local FogStart = Clamp(tonumber(Visuals.World.FogStart) or 20, 0, Max(FogDistance - 1, 0))
        Shared.SetWorldProperty(Lighting, "FogColor", Visuals.World.FogColor)
        Shared.SetWorldProperty(Lighting, "FogStart", FogStart)
        Shared.SetWorldProperty(Lighting, "FogEnd", FogDistance)
    elseif Original then
        Shared.SetWorldProperty(Lighting, "FogColor", Original.FogColor)
        Shared.SetWorldProperty(Lighting, "FogStart", Original.FogStart)
        Shared.SetWorldProperty(Lighting, "FogEnd", Original.FogEnd)
    end
