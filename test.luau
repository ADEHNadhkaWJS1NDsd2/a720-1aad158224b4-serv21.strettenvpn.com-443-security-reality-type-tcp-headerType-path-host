function GetHeavyESPUpdateInterval(PlayerCount)
    PlayerCount = Max(Floor(tonumber(PlayerCount) or 0), 0)
    if PlayerCount >= 32 then return 1 / 18 end
    if PlayerCount >= 24 then return 1 / 20 end
    if PlayerCount >= 16 then return 1 / 24 end
    return 1 / 30
end

function GetHeavyESPBatchDivisor(PlayerCount)
    PlayerCount = Max(Floor(tonumber(PlayerCount) or 0), 0)
    if PlayerCount >= 30 then return 12 end
    if PlayerCount >= 24 then return 10 end
    if PlayerCount >= 18 then return 8 end
    if PlayerCount >= 12 then return 6 end
    if PlayerCount >= 7 then return 4 end
    return 3
end
