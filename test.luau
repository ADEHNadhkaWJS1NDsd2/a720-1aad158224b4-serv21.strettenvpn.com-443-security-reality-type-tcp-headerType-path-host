function PlayerVisuals.QueueUpdate(Data, Bloom)
    if not Data then return end
    Data.PlayerVisualQueueBloom = Data.PlayerVisualQueueBloom == true or Bloom == true
    if Data.PlayerVisualUpdateQueued == true then return end
    Data.PlayerVisualUpdateQueued = true
    Defer(function()
        if not Data then return end
        Data.PlayerVisualUpdateQueued = false
        local UpdateBloomNow = Data.PlayerVisualQueueBloom == true
        Data.PlayerVisualQueueBloom = false
        if Data.Player and Data.Player.Parent == Players then Shared.SafeCall(ApplyPlayerChamData, Data, true) end
        if UpdateBloomNow then Shared.SafeCall(PlayerVisuals.UpdateBloom) end
    end)
end

