        end
    end
    Data.PlayerChamConnections = {}
    if type(Data.PlayerChamLayers) == "table" then
        for Part, Entry in pairs(Data.PlayerChamLayers) do
            if type(Entry) == "table" then
                for Key, Object in pairs(Entry) do
                    if Key ~= "Part" and typeof(Object) == "Instance" and Object.Parent then Object:Destroy() end
                end
            end
            Data.PlayerChamLayers[Part] = nil
        end
    end
    if Data.PlayerChamFolder and Data.PlayerChamFolder.Parent then Data.PlayerChamFolder:Destroy() end
    Data.PlayerChamFolder = nil
    Data.PlayerChamCharacter = nil
    Data.PlayerChamLayers = {}
    Data.PlayerChamApplied = nil
    Data.ChamsRenderActive = false
    Data.ChamsHolder = nil
    Data.ChamsGlowHolder = nil
    Data.Chams = {}
    Data.ChamsGlowShells = {}
    Data.ChamsSoftGlowShells = {}
    Data.ChamsHeadMeshLayers = {}
end

