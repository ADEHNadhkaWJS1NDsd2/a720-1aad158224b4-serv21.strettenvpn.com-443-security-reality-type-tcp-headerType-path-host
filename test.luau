function ResolverSampleMotion(Player, Character, Settings)
    if not Player or not Character then return nil end
    local Root = ResolverGetRootPart(Character)
    if not Root or not Root:IsA("BasePart") then return nil end
    local Data = ResolverGetState(Player, Character) local Now = Clock() local Dt = Now - (tonumber(Data.LastTime) or Now)
    local Reported = Root.AssemblyLinearVelocity or Root.Velocity or EmptyVector3
    local Humanoid = Character:FindFirstChildOfClass("Humanoid") local WalkSpeed = Humanoid and tonumber(Humanoid.WalkSpeed) or 16
    local MaxSpeed = Clamp(Max(90, WalkSpeed * 7, ResolverReadVector(Reported) and Reported.Magnitude * 1.5 or 0), 90, 240)
    Reported = ResolverClampVector(Reported, MaxSpeed)
    Data.RawVelocity = Reported
    if Dt < Res.MovementUpdateInterval then return Data end
    if Dt > Res.MaximumDelta then return ResolverResetState(Data, Character, Root, Now) end
    local Position = Root.Position local Delta = Position - (Data.LastPosition or Position)
    if Delta.Magnitude > Res.TeleportDistance then
        ResolverResetState(Data, Character, Root, Now)
        Data.RawVelocity = Reported Data.Velocity = Reported
        return Data
    end
    local Observed = ResolverClampVector(Delta / Max(Dt, Res.MinimumDelta), MaxSpeed)
    local Horizontal = NewVector3(Delta.X, 0, Delta.Z).Magnitude
    if Horizontal < Max(0.015, Dt * 0.45) and Abs(Delta.Y) < Max(0.02, Dt * 0.65) then
        Data.Stationary = Min((tonumber(Data.Stationary) or 0) + 1, 8)
    else
        Data.Stationary = 0
    end
    if (tonumber(Data.Stationary) or 0) >= 2 and Observed.Magnitude < 4 then Observed = EmptyVector3 end
    local Previous = ResolverReadVector(Data.Velocity) and Data.Velocity or Observed
    local Difference = (Observed - Reported).Magnitude
    local ObservedMagnitude = Observed.Magnitude
    local ReportedMagnitude = Reported.Magnitude
    local DirectionMismatch = ObservedMagnitude > 6 and ReportedMagnitude > 6 and Observed:Dot(Reported) <= 0
    local MagnitudeMismatch = Difference > Max(24, ObservedMagnitude * 1.35 + 10)
    local SuspiciousVelocity = DirectionMismatch or MagnitudeMismatch
    local Measured = SuspiciousVelocity and Observed or Reported:Lerp(Observed, 0.84)
    local Alpha = Clamp(1 - Exp(-18 * Dt), 0.20, 0.82)
    local Velocity = Previous:Lerp(Measured, Alpha)
    if Humanoid and Humanoid.FloorMaterial ~= Enum.Material.Air and Abs(Velocity.Y) < 9 then Velocity = NewVector3(Velocity.X, 0, Velocity.Z) end
    local PreviousAcceleration = ResolverReadVector(Data.Acceleration) and Data.Acceleration or EmptyVector3
    local Acceleration = ResolverClampVector((Velocity - Previous) / Max(Dt, Res.MinimumDelta), 120)
    Data.Acceleration = PreviousAcceleration:Lerp(Acceleration, Clamp(Dt * 8, 0.08, 0.30))
    Data.Velocity = ResolverClampVector(Velocity, MaxSpeed)
    Data.ResolvedVelocity = Data.Velocity
    Data.LastPosition = Position
    Data.LastTime = Now
    return Data
end
function ResolverGetMovementVelocity(Player, Character, Settings)
    local Root = ResolverGetRootPart(Character)
