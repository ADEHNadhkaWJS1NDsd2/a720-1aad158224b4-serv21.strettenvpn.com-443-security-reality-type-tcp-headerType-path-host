local function EnsureAtramentaNexaFont()
    local Path = type(Library.FontPath) == "function" and Library:FontPath("nexa_font.ttf") or "Atramenta.rip/Fonts/nexa_font.ttf"
    if type(isfile) == "function" and isfile(Path) then return Path end
    if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Atramenta.rip/Fonts") then Shared.SafeCall(makefolder, "Atramenta.rip/Fonts") end
    if type(writefile) ~= "function" then return Path end
    local Body = DecodeBase64Data(EmbeddedNexaFontBase64)
    if #Body > 1024 then Shared.SafeCall(writefile, Path, Body) end
    EmbeddedNexaFontBase64 = nil
    return Path
end
