function Shared.SafeDisconnect(Connection)
    if Connection == nil then return false end
    if typeof(Connection) == "RBXScriptConnection" then
        return pcall(function()
            if Connection.Connected then Connection:Disconnect() end
        end)
    end
    local Success, Method = pcall(function() return Connection.Disconnect end)
    if Success and type(Method) == "function" then
        return pcall(Method, Connection)
    end
    return false
end

function Shared.SafeCall(Function, ...)
    if type(Function) ~= "function" then return false, nil end
    local Arguments = Pack(...)
    local Results = Pack(xpcall(function()
        return Function(Unpack(Arguments, 1, Arguments.n))
    end, function(Error)
        return tostring(Error)
    end))
    if Results[1] ~= true then return false, Results[2] end
    return true, Unpack(Results, 2, Results.n)
end
