function UpdateAtramentaVelocityFlyCorrection(RootPart, CurrentTime)
    if not RootPart or not RootPart:IsA("BasePart") then return end
    local PreviousPosition = DesyncNetworkState.FlyPreviousPosition
    local PreviousTime = tonumber(DesyncNetworkState.FlyPreviousTime) or 0
    local AppliedVelocity = DesyncNetworkState.FlyAppliedVelocity
    local CurrentPosition = RootPart.Position
    DesyncNetworkState.FlyPreviousPosition = CurrentPosition
    DesyncNetworkState.FlyPreviousTime = CurrentTime
    if typeof(PreviousPosition) ~= "Vector3" or PreviousTime <= 0 or typeof(AppliedVelocity) ~= "Vector3" then return end
    local DeltaTime = CurrentTime - PreviousTime
    if DeltaTime <= 0 or DeltaTime > 0.18 then return end
    local ExpectedPosition = PreviousPosition + AppliedVelocity * DeltaTime
    local ErrorDistance = (CurrentPosition - ExpectedPosition).Magnitude
    DesyncNetworkState.FlyLastCorrectionError = ErrorDistance
    local ActualDelta = CurrentPosition - PreviousPosition
    local Moving = AppliedVelocity.Magnitude >= 4
    local OppositeSnap = Moving and ActualDelta.Magnitude >= 1 and ActualDelta:Dot(AppliedVelocity) < 0
    if ErrorDistance >= 4.25 or OppositeSnap then
        DesyncNetworkState.FlyCorrectionCount = (tonumber(DesyncNetworkState.FlyCorrectionCount) or 0) + 1
        DesyncNetworkState.FlyCorrectionScale = Max((tonumber(DesyncNetworkState.FlyCorrectionScale) or 1) * 0.78, 0.42)
        DesyncNetworkState.FlyCorrectionUntil = CurrentTime + 0.38
    elseif CurrentTime >= (tonumber(DesyncNetworkState.FlyCorrectionUntil) or 0) then
        DesyncNetworkState.FlyCorrectionScale = Min((tonumber(DesyncNetworkState.FlyCorrectionScale) or 1) + DeltaTime * 0.12, 1)
    end
end
