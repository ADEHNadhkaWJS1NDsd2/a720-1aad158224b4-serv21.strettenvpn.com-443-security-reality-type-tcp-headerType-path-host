    return {{Points.Head, Points.Neck}, {Points.Neck, Points.Chest}, {Points.Chest, Points.Waist}, {Points.Chest, Points.LeftShoulder}, {Points.LeftShoulder, Points.LeftHand},
        {Points.Chest, Points.RightShoulder}, {Points.RightShoulder, Points.RightHand}, {Points.Waist, Points.LeftHip}, {Points.LeftHip, Points.LeftFoot},
        {Points.Waist, Points.RightHip}, {Points.RightHip, Points.RightFoot}}
