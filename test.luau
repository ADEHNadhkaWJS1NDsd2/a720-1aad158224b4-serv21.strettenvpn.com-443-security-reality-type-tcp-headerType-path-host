function CaptureBodyHideVisual(Character)
    if not Character or not Character.Parent or not BacktrackVisuals or type(BacktrackVisuals.CaptureParts) ~= "function" then return end
    local Root = ResolverGetRootPart(Character)
    if not Root then return end
    BodyHide.VisualReferenceState = type(BodyHide.VisualReferenceState) == "table" and BodyHide.VisualReferenceState or {}
    local Parts = BacktrackVisuals:CaptureParts(Character, BodyHide.VisualReferenceState)
    if type(Parts) ~= "table" or next(Parts) == nil then return end
    BodyHide.VisualSnapshot = {Time = Clock(), Character = Character, RootCFrame = Root.CFrame, Parts = Parts}
