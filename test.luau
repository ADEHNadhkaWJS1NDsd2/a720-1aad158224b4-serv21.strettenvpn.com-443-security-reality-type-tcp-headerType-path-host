    function ApplyPlayerESPElement(Name, Value)
        Name = tostring(Name)
        Value = Value == true
        if Name == "Box" then
            Visuals.Player.Boxes = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Box then Data.OverlayPrimitives.Box.Visible = false end
                    if Data.OverlayPrimitives.BoxOutline then Data.OverlayPrimitives.BoxOutline.Visible = false end
                    if Data.CornersReady then
                        for Index = 1, 8 do
                            if Data.Corners[Index] then Data.Corners[Index].Visible = false end
                            if Data.CornerOutlines[Index] then Data.CornerOutlines[Index].Visible = false end
                        end
                    end
                    if Data.UiEsp then
                        if Data.UiEsp.Box then Data.UiEsp.Box.Visible = false end
                        if Data.UiEsp.BoxOutline then Data.UiEsp.BoxOutline.Visible = false end
                        if type(Data.UiEsp.Corners) == "table" then
                            for _, Corner in ipairs(Data.UiEsp.Corners) do Corner.Visible = false end
                        end
                    end
                end
            end
        elseif Name == "Fill" then
            Visuals.Player.Fill = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Fill then Data.OverlayPrimitives.Fill.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Fill then Data.UiEsp.Fill.Visible = false end
                end
            end
        elseif Name == "Name" then
            Visuals.Player.Names = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Name then Data.OverlayPrimitives.Name.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Name then Data.UiEsp.Name.Visible = false end
                end
            end
        elseif Name == "Avatar" then
            Visuals.Player.ProfilePicture = Value
            if Value and false then
                for _, Data in ipairs(Visuals.Player.List) do
                    Shared.EnsureProfilePictureOverlay(Data)
                    QueueProfilePicture(Data)
                end
            elseif not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.ProfilePicture then Data.OverlayPrimitives.ProfilePicture.Visible = false end
                    if Data.OverlayPrimitives.ProfilePictureBack then Data.OverlayPrimitives.ProfilePictureBack.Visible = false end
                    if Data.UiEsp and Data.UiEsp.AvatarBack then Data.UiEsp.AvatarBack.Visible = false end
                end
            end
        elseif Name == "Health Bar" then
            Visuals.Player.HealthBar = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    for _, Key in ipairs({"HealthBack", "HealthDelayed", "Health"}) do
                        if Data.OverlayPrimitives[Key] then Data.OverlayPrimitives[Key].Visible = false end
                    end
                    if Data.UiEsp then
                        for _, Key in ipairs({"HealthBack", "HealthDelayed", "Health"}) do
                            if Data.UiEsp[Key] then Data.UiEsp[Key].Visible = false end
                        end
                    end
                end
            end
        elseif Name == "Health Text" then
            Visuals.Player.HealthText = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.HealthText then Data.OverlayPrimitives.HealthText.Visible = false end
                    if Data.UiEsp and Data.UiEsp.HealthText then Data.UiEsp.HealthText.Visible = false end
                end
            end
        elseif Name == "Weapon" then
            Visuals.Player.Weapon = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Weapon then Data.OverlayPrimitives.Weapon.Visible = false end
                    if Data.OverlayPrimitives.WeaponIcon then Data.OverlayPrimitives.WeaponIcon.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Weapon then Data.UiEsp.Weapon.Visible = false end
                    if Data.UiEsp and Data.UiEsp.WeaponIcon then Data.UiEsp.WeaponIcon.Visible = false end
                end
            end
        elseif Name == "Ammo" then
            Visuals.Player.Ammo.Enabled = Value
