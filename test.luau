function IsGunConfigTable(Value)
    if type(Value) ~= "table" then return false end
    local FireRate = rawget(Value, "FireRate")
    local Spread = rawget(Value, "Spread")
    local Recoil = rawget(Value, "Recoil")
    local MagSize = rawget(Value, "MagSize")
    return type(FireRate) == "number" and (type(Spread) == "number" or type(Recoil) == "number" or type(MagSize) == "number")
end

function CaptureGunConfig(Config)
    local Existing = GunMods.ConfigOriginals[Config]
    if type(Existing) == "table" then return Existing end
    local Snapshot = {Entries = {}, Lookup = setmetatable({}, {__mode = "k"})}
    local function Capture(TableValue, Key)
        if type(TableValue) ~= "table" then return end
        local Success, Value = pcall(rawget, TableValue, Key)
        if not Success or Value == nil then return end
        if type(Value) == "table" or type(Value) == "function" or type(Value) == "thread" or type(Value) == "userdata" then return end
        local Lookup = Snapshot.Lookup[TableValue]
        if type(Lookup) ~= "table" then Lookup = {} Snapshot.Lookup[TableValue] = Lookup end
        if Lookup[Key] ~= nil then return end
        Lookup[Key] = Value
        Snapshot.Entries[#Snapshot.Entries + 1] = {Table = TableValue, Key = Key, Value = Value}
    end
    for Index = 1, #GunConfigTopFields do Capture(Config, GunConfigTopFields[Index]) end
    for SectionName, Fields in pairs(GunConfigNestedFields) do
        local Section = rawget(Config, SectionName)
        if type(Section) == "table" then
            for Index = 1, #Fields do Capture(Section, Fields[Index]) end
        end
    end
    GunMods.ConfigOriginals[Config] = Snapshot
    return Snapshot
end

function GetGunOriginal(Config, SectionName, Key)
    local Snapshot = CaptureGunConfig(Config)
    local TableValue = SectionName and rawget(Config, SectionName) or Config
    local Lookup = type(TableValue) == "table" and Snapshot.Lookup[TableValue] or nil
    return type(Lookup) == "table" and Lookup[Key] or nil
end

function SetGunConfigField(Config, SectionName, Key, Value)
    local TableValue = SectionName and rawget(Config, SectionName) or Config
    if type(TableValue) ~= "table" or rawget(TableValue, Key) == nil then return false end
    return pcall(function() TableValue[Key] = Value end)
end

function RestoreGunConfig(Config)
    local Snapshot = GunMods.ConfigOriginals[Config]
    if type(Snapshot) ~= "table" or type(Snapshot.Entries) ~= "table" then return end
    for Index = 1, #Snapshot.Entries do
        local Entry = Snapshot.Entries[Index]
        if type(Entry) == "table" and type(Entry.Table) == "table" then pcall(function() Entry.Table[Entry.Key] = Entry.Value end) end
    end
end

function GetRecoilScale()
    local WeaponState = AtramentaConfig and AtramentaConfig.Weapon
    local Settings = WeaponState and WeaponState.GunMods
    if type(Settings) ~= "table" or Settings.NoRecoil ~= true then return 1 end
    if tostring(Settings.RecoilMode or "No Recoil") == "No Recoil" then return 0 end
    return 1 - Clamp(tonumber(Settings.RecoilReduction) or 100, 0, 100) / 100
end

function ApplyGunConfigTable(WeaponConfig)
    if not IsGunConfigTable(WeaponConfig) then return false end
    CaptureGunConfig(WeaponConfig)
    RestoreGunConfig(WeaponConfig)
    local WeaponState = AtramentaConfig and AtramentaConfig.Weapon
    local Settings = WeaponState and WeaponState.GunMods
    if type(WeaponState) ~= "table" or type(Settings) ~= "table" then return false end
    local Active = WeaponState.Enabled == true
    local RageRate = AtramentaRageFireRate.Enabled == true
    if Active then
        local RecoilScale = GetRecoilScale()
        if Settings.NoRecoil == true then
            local Original = tonumber(GetGunOriginal(WeaponConfig, nil, "Recoil"))
            if Original then SetGunConfigField(WeaponConfig, nil, "Recoil", Original * RecoilScale) end
            if RecoilScale <= 0.001 then
                SetGunConfigField(WeaponConfig, nil, "CameraRecoilingEnabled", false)
                SetGunConfigField(WeaponConfig, nil, "AngleX_Min", 0)
                SetGunConfigField(WeaponConfig, nil, "AngleX_Max", 0)
                SetGunConfigField(WeaponConfig, nil, "AngleY_Min", 0)
                SetGunConfigField(WeaponConfig, nil, "AngleY_Max", 0)
                SetGunConfigField(WeaponConfig, nil, "AngleZ_Min", 0)
                SetGunConfigField(WeaponConfig, nil, "AngleZ_Max", 0)
                SetGunConfigField(WeaponConfig, nil, "RecoilRedution", 0)
                SetGunConfigField(WeaponConfig, "SprayLerp", "Enabled", false)
            end
        end
        if Settings.NoSpread == true then
            SetGunConfigField(WeaponConfig, nil, "Spread", 0)
            SetGunConfigField(WeaponConfig, nil, "CrouchSpreadReduction", 1)
            SetGunConfigField(WeaponConfig, nil, "WalkSpreadIncrease", 1)
            SetGunConfigField(WeaponConfig, "AimSettings", "SpreadReductionP", 1)
            SetGunConfigField(WeaponConfig, "Customs", "LaserAccuracy", 1)
            SetGunConfigField(WeaponConfig, "SniperSettings", "WalkSpread", 0)
        elseif Settings.Spread == true then
            SetGunConfigField(WeaponConfig, nil, "Spread", Max(tonumber(Settings.SpreadAmount) or 0, 0))
            SetGunConfigField(WeaponConfig, nil, "CrouchSpreadReduction", 1)
            SetGunConfigField(WeaponConfig, nil, "WalkSpreadIncrease", 1)
            SetGunConfigField(WeaponConfig, "AimSettings", "SpreadReductionP", 1)
            SetGunConfigField(WeaponConfig, "Customs", "LaserAccuracy", 1)
            SetGunConfigField(WeaponConfig, "SniperSettings", "WalkSpread", 0)
        end
        if Settings.InstantCharge == true then
            SetGunConfigField(WeaponConfig, nil, "ChargeTime", 0.01)
            SetGunConfigField(WeaponConfig, nil, "DelayBeforeFiring", 0)
            SetGunConfigField(WeaponConfig, "ChargeUpSettings", "ChargeTime", 0.01)
            SetGunConfigField(WeaponConfig, "ChargeUpSettings", "ChargeDB", 0.01)
            SetGunConfigField(WeaponConfig, "ChargeUpSettings", "ChargeAnimTimeAdd", 0)
        end
        if Settings.InfiniteRange == true then
            SetGunConfigField(WeaponConfig, nil, "Range", 99999)
            SetGunConfigField(WeaponConfig, nil, "Dropoff", 0)
            SetGunConfigField(WeaponConfig, nil, "DropoffDistance", 99999)
        end
        if Settings.NoSlowdown == true then
            SetGunConfigField(WeaponConfig, nil, "ReloadSlowDown", 0)
            SetGunConfigField(WeaponConfig, "SlowDown", "Enabled", false)
            SetGunConfigField(WeaponConfig, "SlowDown", "Amount", 0)
            SetGunConfigField(WeaponConfig, "FireSlowDown", "Enabled", false)
            SetGunConfigField(WeaponConfig, "FireSlowDown", "Amount", 0)
            SetGunConfigField(WeaponConfig, "FireSlowDown", "Time", 0)
            SetGunConfigField(WeaponConfig, "AimSettings", "SlowDown", 0)
        end
        if Settings.NoScopeGlint == true then SetGunConfigField(WeaponConfig, "Customs", "ScopeGlint", false) end
    end
    if Settings.InstantEquip == true then
        SetGunConfigField(WeaponConfig, nil, "EquipTime", 0)
        SetGunConfigField(WeaponConfig, nil, "EquipAnimSpeed", 10000)
        ApplyUniversalEquipTable(WeaponConfig, 0, nil)
    end
    local MaxFireRate = RageRate or Active and Settings.InstantBullet == true
    if MaxFireRate then
        local FireRate = 99999
        SetGunConfigField(WeaponConfig, nil, "FireRate", FireRate)
        SetGunConfigField(WeaponConfig, "FireModeSettings", "SemiRate", FireRate)
        SetGunConfigField(WeaponConfig, "FireModeSettings", "AutoRate", FireRate)
        SetGunConfigField(WeaponConfig, "FireModeSettings", "BurstRate", FireRate)
        SetGunConfigField(WeaponConfig, "FireModeSettings", "BurstDRate", FireRate)
        SetGunConfigField(WeaponConfig, "Customs", "MinAutoFireTime", 0)
    end
    return true
end
