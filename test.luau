    self:RestoreCharacterParts()
    self.Character.ActiveCharacter = nil
end
function ExtendedVisuals:UpdateCharacter()
    local Character = LocalPlayer.Character
    if not Character then return end
    if self.Character.ActiveCharacter ~= Character then
        self:RestoreCharacterParts()
        self:NormalizeCharacterTransparency(Character)
        self.Character.ActiveCharacter = Character
        self.Character.SavedParts = setmetatable({}, {__mode = "k"})
        self.Character.HiddenParts = setmetatable({}, {__mode = "k"})
        self:BindCharacterObjectCache(Character)
        self.Character.Dirty = true
    end
    local Enabled = self.Character.MaterialEnabled or self.Character.Headless or self.Character.Korblox
    if not Enabled then
        if next(self.Character.SavedParts) or next(self.Character.HiddenParts) or next(self.Character.SavedMeshTextures) or next(self.Character.SavedClothing) then
            self:RestoreCharacterParts()
        end
        return
    end
    local MaterialName = tostring(self.Character.Material or "Neon")
    if MaterialName ~= "Neon" and MaterialName ~= "ForceField" then self.Character.Material = "Neon" end
    local CachedObjects = self.Character.CachedObjects
    if type(CachedObjects) ~= "table" or #CachedObjects == 0 then
        self:BindCharacterObjectCache(Character)
        CachedObjects = self.Character.CachedObjects
    end
    local DeadObjects = 0
    for _, Object in ipairs(CachedObjects) do
        if not Object or not Object.Parent or not Object:IsDescendantOf(Character) then
            DeadObjects += 1
        elseif Object:IsA("BasePart") and not Object:FindFirstAncestorOfClass("Tool") then
            if self.Character.MaterialEnabled then
                self:SaveCharacterAppearance(Object)
                local Saved = self.Character.SavedParts[Object]
                Shared.ApplyAtramentaCharacterMaterialPart(Object, MaterialName, self.Character.Color, self.Character.Transparency, Saved)
            else
                self:RestoreCharacterAppearancePart(Object)
            end
            local Hide = (self.Character.Headless and self:IsHeadlessPart(Object)) or (self.Character.Korblox and self:IsKorbloxPart(Object))
            if Hide then self:HideCharacterPart(Object) else self:RestoreHiddenCharacterPart(Object) end
        end
    end
    if self.Character.MaterialEnabled then
        self:ApplyCharacterClothing(Character, true)
    else
        self:RestoreCharacterClothing()
        self:RestoreCharacterMeshTextures()
    end
    if DeadObjects > 0 then
        local WriteIndex = 1
        local CachedSet = self.Character.CachedObjectSet
        for ReadIndex = 1, #CachedObjects do
            local Object = CachedObjects[ReadIndex]
            if Object and Object.Parent and Object:IsDescendantOf(Character) and CachedSet[Object] then
                CachedObjects[WriteIndex] = Object
                WriteIndex += 1
            elseif Object then
                CachedSet[Object] = nil
            end
        end
        for Index = #CachedObjects, WriteIndex, -1 do CachedObjects[Index] = nil end
    end
    self.Character.Dirty = false
end
function ExtendedVisuals:RefreshCharacterMaterialRender()
