    local function AttachCompactColor(Control, Options)
        if not Control or type(Options) ~= "table" then return nil end
        if type(Control.Colorpicker) == "function" then
            return Control:Colorpicker(Options)
        end
        return nil
    end
    local ElementsSection = VisualESP:Section({Name = "Elements", Side = 2})
    local function AddESPElement(Name, Default, ColorOptions, DisplayName)
        local FlagName = PlayerESPElementFlags[Name]
        local Toggle = ElementsSection:Toggle({Name = DisplayName or Name, Flag = FlagName, Default = Default == true,
            Callback = function(Value) ApplyPlayerESPElement(Name, Value == true) end})
        if type(ColorOptions) == "table" then
            if ColorOptions.Flag then
                AttachCompactColor(Toggle, ColorOptions)
            else
                for _, Options in ipairs(ColorOptions) do AttachCompactColor(Toggle, Options) end
            end
        end
        return Toggle
    end
