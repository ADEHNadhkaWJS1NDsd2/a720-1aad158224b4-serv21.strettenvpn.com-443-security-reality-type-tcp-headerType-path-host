function GetCriminologySilentAimTarget()
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return nil, nil, nil end
    local MousePosition = SilentAimGetMousePosition()
    local Radius = Max(tonumber(AtramentaConfig.Aim.FOV) or 120, 1)
    local RayParameters = GetCriminologySilentAimRayParams()
    local SelectionMode = tostring(AtramentaConfig.Aim.SilentHitboxMode or "Priority")
    if SelectionMode ~= "Closest" and SelectionMode ~= "Priority" then SelectionMode = "Priority" end
    local function EvaluateCandidate(PlayerObject, Character, Candidate)
        if type(Candidate) ~= "table" then return nil end
        local TargetPart = Candidate.Part
        if not TargetPart or not TargetPart:IsA("BasePart") or not TargetPart.Parent then return nil end
        local SelectionPosition = GetCriminologySilentAimSelectionPosition(PlayerObject, Character, TargetPart)
        if typeof(SelectionPosition) ~= "Vector3" then return nil end
        local ScreenPosition, OnScreen = CameraObject:WorldToViewportPoint(SelectionPosition)
        if not OnScreen or ScreenPosition.Z <= 0 then return nil end
        local Distance = (MousePosition - NewVector2(ScreenPosition.X, ScreenPosition.Y)).Magnitude
        if Distance >= Radius then return nil end
        local AimPosition = GetCriminologySilentAimPartPosition(PlayerObject, Character, TargetPart)
        if typeof(AimPosition) ~= "Vector3" then return nil end
        if RayParameters then
            local Origin = CameraObject.CFrame.Position
            local Result = Workspace:Raycast(Origin, AimPosition - Origin, RayParameters)
            if Result and (not Result.Instance or not Result.Instance:IsDescendantOf(Character)) then
                return nil
            end
        end
        return {Distance = Distance, Character = Character, Part = TargetPart,
            Position = AimPosition, Group = Candidate.Group, Priority = tonumber(Candidate.Priority) or Infinite}
    end
    local function EvaluateTarget(PlayerObject)
        if PlayerObject == LocalPlayer or not IsCombatTargetAllowed(PlayerObject) then return nil end
        local Character = ResolveTrackedCharacter(PlayerObject, PlayerObject.Character) or PlayerObject.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        if not Character or not Humanoid or Humanoid.Health <= 0 then return nil end
        if not CombatChecks.Passes(PlayerObject, Character, AtramentaConfig.Aim) then return nil end
        local Candidates = GetCriminologySilentAimCandidates(Character)
        local Valid = {}
        local ClosestDistance = Radius
        for Index = 1, #Candidates do
            local Result = EvaluateCandidate(PlayerObject, Character, Candidates[Index])
            if Result then
                Valid[#Valid + 1] = Result
                if Result.Distance < ClosestDistance then ClosestDistance = Result.Distance end
            end
        end
        if #Valid == 0 then return nil end
        local Best
        if SelectionMode == "Closest" then
            for Index = 1, #Valid do
                local Result = Valid[Index]
                if not Best or Result.Distance < Best.Distance then Best = Result end
            end
        else
            for Index = 1, #Valid do
                local Result = Valid[Index]
                if not Best or Result.Priority < Best.Priority or Result.Priority == Best.Priority and Result.Distance < Best.Distance then Best = Result end
            end
        end
        if not Best then return nil end
        return Best.Distance, Best.Character, Best.Part, Best.Position
    end
    if AtramentaConfig.Aim.SilentLockTarget == true and AtramentaConfig.Aim.SilentAimLockedTarget then
        local LockedPlayer = AtramentaConfig.Aim.SilentAimLockedTarget
        local LockedCharacter = ResolveTrackedCharacter(LockedPlayer, LockedPlayer.Character) or LockedPlayer.Character
        local LockedHumanoid = LockedCharacter and LockedCharacter:FindFirstChildOfClass("Humanoid")
        local LockedValid = LockedPlayer ~= LocalPlayer and IsCombatTargetAllowed(LockedPlayer) and LockedCharacter and LockedHumanoid
            and LockedHumanoid.Health > 0 and CombatChecks.Passes(LockedPlayer, LockedCharacter, AtramentaConfig.Aim)
        if LockedValid then
            local Distance, Character, TargetPart, AimPosition = EvaluateTarget(LockedPlayer)
            if Distance and Character and TargetPart then return LockedPlayer, Character, TargetPart, AimPosition end
            return LockedPlayer, LockedCharacter, nil, nil
        end
        ResetSilentAimTargetLock()
    end
    local ClosestPlayer
    local ClosestCharacter
    local ClosestPart
    local ClosestAimPosition
    local ClosestDistance = Radius
    for _, PlayerObject in ipairs(Players:GetPlayers()) do
        local Distance, Character, TargetPart, AimPosition = EvaluateTarget(PlayerObject)
        if Distance and Distance < ClosestDistance then
            ClosestDistance = Distance
            ClosestPlayer = PlayerObject
            ClosestCharacter = Character
            ClosestPart = TargetPart
            ClosestAimPosition = AimPosition
        end
    end
    if ClosestPlayer and AtramentaConfig.Aim.SilentLockTarget == true then AtramentaConfig.Aim.SilentAimLockedTarget = ClosestPlayer end
    return ClosestPlayer, ClosestCharacter, ClosestPart, ClosestAimPosition
end
function GetCriminologySilentAimChanceRoll(Tool, ShotCode, Salt)
    local Key = ShotCode ~= nil and tostring(ShotCode) or ""
    if Key == "" then
        SilentAim.ChanceSequence = (tonumber(SilentAim.ChanceSequence) or 0) + 1
        Key = tostring(SilentAim.ChanceSequence)
    end
    if typeof(Tool) == "Instance" then Key ..= ":" .. tostring(Tool.Name or "") end
    Key ..= ":" .. tostring(Salt or "roll")
    local Hash = 17
    for Index = 1, #Key do
        Hash = (Hash * 131 + StringByte(Key, Index)) % 1000003
    end
    return (Hash % 10000) / 100
end
function GetCriminologySilentAimShotChance(Tool, ShotCode)
    local FixedChance = Clamp(tonumber(AtramentaConfig.Aim.SilentHitChance) or 100, 0, 100)
    if AtramentaConfig.Aim.SilentRandomHitChance ~= true then
        return FixedChance
