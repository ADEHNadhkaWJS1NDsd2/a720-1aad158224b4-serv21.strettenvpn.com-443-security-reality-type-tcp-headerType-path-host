function DisconnectNearbyDoorSignals()
    for Index = 1, #NearbyDoorConnections do Shared.SafeDisconnect(NearbyDoorConnections[Index]) end
    Clear(NearbyDoorConnections)
    for Object, Connection in pairs(NearbyDoorValueConnections) do Shared.SafeDisconnect(Connection) NearbyDoorValueConnections[Object] = nil end
