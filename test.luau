function QueueNearbyDoorProcess()
    if NearbyDoorProcessQueued or not (OpenNearbyDoorsEnabled or UnlockNearbyDoorsEnabled) then return end
    NearbyDoorProcessQueued = true
    Defer(function()
        NearbyDoorProcessQueued = false
        if not (OpenNearbyDoorsEnabled or UnlockNearbyDoorsEnabled) then return end
        local CharacterModel = LocalPlayer.Character
        local RootPart = CharacterModel and CharacterModel:FindFirstChild("HumanoidRootPart")
        local HumanoidInstance = CharacterModel and CharacterModel:FindFirstChildOfClass("Humanoid")
        if not RootPart or not HumanoidInstance or HumanoidInstance.Health <= 0 then return end
        local Map = Workspace:FindFirstChild("Map")
        local DoorsFolder = Map and Map:FindFirstChild("Doors")
        if not DoorsFolder then return end
        for _, DoorInstance in ipairs(DoorsFolder:GetChildren()) do
            local DoorBase = DoorInstance:FindFirstChild("DoorBase")
            local ValuesFolder = DoorInstance:FindFirstChild("Values")
            local EventsFolder = DoorInstance:FindFirstChild("Events")
            if DoorBase and ValuesFolder and EventsFolder and (RootPart.Position - DoorBase.Position).Magnitude <= 6 then
                local ToggleEvent = EventsFolder:FindFirstChild("Toggle")
                if ToggleEvent then
                    local LockedValue = ValuesFolder:FindFirstChild("Locked")
                    local OpenValue = ValuesFolder:FindFirstChild("Open")
                    if UnlockNearbyDoorsEnabled and LockedValue and LockedValue.Value == true then
                        local LockArg = DoorInstance:FindFirstChild("Lock")
                        if LockArg then ToggleEvent:FireServer("Unlock", LockArg) end
                    end
                    if OpenNearbyDoorsEnabled and OpenValue and OpenValue.Value == false and (not LockedValue or LockedValue.Value == false) then
                        local KnobArg = DoorInstance:FindFirstChild("Knob2") or DoorInstance:FindFirstChild("Knob")
                        if KnobArg then ToggleEvent:FireServer("Open", KnobArg) end
                    end
                end
            end
        end
    end)
end
function BindNearbyDoorSignals()
    DisconnectNearbyDoorSignals()
    if not (OpenNearbyDoorsEnabled or UnlockNearbyDoorsEnabled) then return end
    local Character = LocalPlayer.Character
    if Character then
        local Root = Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if Root then NearbyDoorConnections[#NearbyDoorConnections + 1] = Root:GetPropertyChangedSignal("Position"):Connect(QueueNearbyDoorProcess) end
        if Humanoid then NearbyDoorConnections[#NearbyDoorConnections + 1] = Humanoid:GetPropertyChangedSignal("Health"):Connect(QueueNearbyDoorProcess) end
        NearbyDoorConnections[#NearbyDoorConnections + 1] = Character.ChildAdded:Connect(function(Object)
            if Object.Name == "HumanoidRootPart" or Object:IsA("Humanoid") then Defer(BindNearbyDoorSignals) end
        end)
        NearbyDoorConnections[#NearbyDoorConnections + 1] = Character.ChildRemoved:Connect(function(Object)
            if Object.Name == "HumanoidRootPart" or Object:IsA("Humanoid") then Defer(BindNearbyDoorSignals) end
        end)
    end
    NearbyDoorConnections[#NearbyDoorConnections + 1] = LocalPlayer.CharacterAdded:Connect(function() Defer(BindNearbyDoorSignals) end)
    local Map = Workspace:FindFirstChild("Map")
    local DoorsFolder = Map and Map:FindFirstChild("Doors")
    if DoorsFolder then
        NearbyDoorConnections[#NearbyDoorConnections + 1] = DoorsFolder.ChildAdded:Connect(function(Door)
            Defer(BindNearbyDoorSignals)
            Defer(QueueNearbyDoorProcess)
        end)
        NearbyDoorConnections[#NearbyDoorConnections + 1] = DoorsFolder.ChildRemoved:Connect(QueueNearbyDoorProcess)
        for _, Door in ipairs(DoorsFolder:GetChildren()) do
            local Values = Door:FindFirstChild("Values")
            if Values then
                for _, Name in ipairs({"Locked", "Open"}) do
                    local Object = Values:FindFirstChild(Name)
                    if Object and Object:IsA("ValueBase") and not NearbyDoorValueConnections[Object] then
                        NearbyDoorValueConnections[Object] = Object:GetPropertyChangedSignal("Value"):Connect(QueueNearbyDoorProcess)
                    end
                end
            end
        end
    end
    QueueNearbyDoorProcess()
end
