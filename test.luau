    end
    if GrenadeTrajectoryState.LastValid then
        GrenadeTrajectoryDraw(GrenadeTrajectoryState.Points, GrenadeTrajectoryState.BounceIndices, GrenadeTrajectoryState.LastActive)
    else
        GrenadeTrajectoryHide()
    end
end
