function NormalizeInstantEquipKey(Value)
    return Lower(tostring(Value or "")):gsub("[^%w]", "")
end
function GetInstantEquipFieldMode(Key)
    local Normalized = NormalizeInstantEquipKey(Key)
    if InstantEquipZeroKeys[Normalized] then return "zero" end
    if InstantEquipSpeedKeys[Normalized] then return "speed" end
    return nil
end
function CaptureUniversalEquipTableField(TableValue, Key, Value)
    if type(TableValue) ~= "table" then return end
    local Snapshot = GunMods.EquipConfigOriginals[TableValue]
    if type(Snapshot) ~= "table" then Snapshot = {} GunMods.EquipConfigOriginals[TableValue] = Snapshot end
    if Snapshot[Key] == nil then Snapshot[Key] = Value end
end
function ApplyUniversalEquipTable(TableValue, Depth, Seen)
    if type(TableValue) ~= "table" then return false end
    Depth = tonumber(Depth) or 0
    if Depth > 4 then return false end
    Seen = Seen or setmetatable({}, {__mode = "k"})
    if Seen[TableValue] then return false end
    Seen[TableValue] = true
    local Changed = false
    for Key, Value in pairs(TableValue) do
        if type(Value) == "number" then
            local Mode = GetInstantEquipFieldMode(Key)
            if Mode then
                CaptureUniversalEquipTableField(TableValue, Key, Value)
                local Target = Mode == "speed" and 10000 or 0
                if Value ~= Target then
                    if pcall(function() TableValue[Key] = Target end) then Changed = true end
                else
                    Changed = true
                end
            end
        elseif type(Value) == "table" and Depth < 4 then
            if ApplyUniversalEquipTable(Value, Depth + 1, Seen) then Changed = true end
        end
    end
    return Changed
end
function RestoreUniversalEquipTables()
    for TableValue, Fields in pairs(GunMods.EquipConfigOriginals) do
        if type(TableValue) == "table" and type(Fields) == "table" then
            for Key, Value in pairs(Fields) do pcall(function() TableValue[Key] = Value end) end
        end
    end
end
function CaptureUniversalEquipAttribute(Object, Key, Value)
