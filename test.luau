function Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    if not CameraObject then
        return nil
    end
    local Projection = AtramentaConfig and AtramentaConfig.Camera and AtramentaConfig.Camera.Projection
    if type(Projection) == "table" and Projection.AspectEnabled == true and typeof(Projection.AspectBaseCFrame) == "CFrame" then
        return Projection.AspectBaseCFrame
    end
    local Current = CameraObject.CFrame
    if typeof(Current) ~= "CFrame" then
        return nil
    end
    local Right = Current.RightVector
    local Up = Current.UpVector
    local Look = Current.LookVector
    if Right.Magnitude <= 0.000001 or Up.Magnitude <= 0.000001 or Look.Magnitude <= 0.000001 then
        return Current
    end
    return FromMatrix(Current.Position, Right.Unit, Up.Unit, -Look.Unit)
end

function Shared.BeginPlayerESPProjectionFrame(CameraObject)
    if not CameraObject then return nil end
    local CameraCFrame = Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    local Viewport = CameraObject.ViewportSize
    if typeof(CameraCFrame) ~= "CFrame" or typeof(Viewport) ~= "Vector2" or Viewport.X <= 1 or Viewport.Y <= 1 then return nil end
    local VerticalFOV = Rad(Clamp(tonumber(CameraObject.FieldOfView) or 70, 1, 179))
    local FocalLength = (Viewport.Y * 0.5) / Max(Tan(VerticalFOV * 0.5), 0.000001)
    local Projection = AtramentaConfig and AtramentaConfig.Camera and AtramentaConfig.Camera.Projection
    local VerticalScale = 1
    if type(Projection) == "table" and Projection.AspectEnabled == true then
        VerticalScale = Clamp(tonumber(Projection.AspectRatio) or 1, 0.50, 1.50)
    end
    local Context = Shared.PlayerESPProjectionContext
    if type(Context) ~= "table" then
        Context = {}
        Shared.PlayerESPProjectionContext = Context
    end
    Context.Camera = CameraObject
    Context.CFrame = CameraCFrame
    Context.Position = CameraCFrame.Position
    Context.Right = CameraCFrame.RightVector
    Context.Up = CameraCFrame.UpVector
    Context.Look = CameraCFrame.LookVector
    Context.Viewport = Viewport
    Context.CenterX = Viewport.X * 0.5
    Context.CenterY = Viewport.Y * 0.5
    Context.FocalLength = FocalLength
    Context.VerticalScale = VerticalScale
    Context.Frame = tonumber(Visuals.Performance.ProjectionFrame) or 0
    return Context
end

function Shared.PlayerESPWorldToViewportPoint(CameraObject, WorldPosition)
    if not CameraObject or typeof(WorldPosition) ~= "Vector3" then
        return EmptyVector3, false
    end
    local Performance = Visuals.Performance
    local Context = Shared.PlayerESPProjectionContext
    if Performance.ProjectionActive ~= true or type(Context) ~= "table" or Context.Camera ~= CameraObject
        or Context.Frame ~= (tonumber(Performance.ProjectionFrame) or 0) then
        Context = Shared.BeginPlayerESPProjectionFrame(CameraObject)
    end
    if type(Context) ~= "table" then
        return CameraObject:WorldToViewportPoint(WorldPosition)
    end
    local Delta = WorldPosition - Context.Position
    local CameraX = Delta:Dot(Context.Right)
    local CameraY = Delta:Dot(Context.Up)
    local Depth = Delta:Dot(Context.Look)
    local SafeDepth = Abs(Depth) > 0.000001 and Depth or (Depth >= 0 and 0.000001 or -0.000001)
    local ScreenX = Context.CenterX + (CameraX / SafeDepth) * Context.FocalLength
    local ScreenY = Context.CenterY - (CameraY / SafeDepth) * Context.FocalLength * Context.VerticalScale
    local Viewport = Context.Viewport
    local OnScreen = Depth > 0 and ScreenX >= 0 and ScreenX <= Viewport.X and ScreenY >= 0 and ScreenY <= Viewport.Y
    return NewVector3(ScreenX, ScreenY, Depth), OnScreen
end

function UpdateOffscreenArrow(Data, CameraObject, WorldPosition, Distance, Color)
    local Settings = Visuals.Player.Offscreen
    if not Settings.Enabled or not Data or not WorldPosition then
        HideOffscreenArrowOverlay(Data)
        return
    end
    if not EnsureOffscreenOverlay(Data) then return end
    local ScreenPosition, OnScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, WorldPosition) local Viewport = CameraObject.ViewportSize
    if OnScreen and ScreenPosition.Z > 0 and ScreenPosition.X >= 0 and ScreenPosition.X <= Viewport.X and ScreenPosition.Y >= 0 and ScreenPosition.Y <= Viewport.Y then
        HideOffscreenArrowOverlay(Data)
        return
    end
    local Center = Viewport * 0.5 local Delta = NewVector2(ScreenPosition.X - Center.X, ScreenPosition.Y - Center.Y)
    if ScreenPosition.Z <= 0 then Delta = -Delta end
    if Delta.Magnitude <= 0.001 then Delta = NewVector2(0, -1) end
    local Unit = Delta.Unit local Radius = Max(Min(Viewport.X, Viewport.Y) * Clamp(tonumber(Settings.Radius) or 0.88, 0.45, 0.94) * 0.5, 24)
    local Size = Max(tonumber(Settings.Size) or 16, 8) local Tip = Center + Unit * Radius
    local Base = Center + Unit * (Radius - Size) local Perpendicular = NewVector2(-Unit.Y, Unit.X) * (Size * 0.55)
    local Left = Base + Perpendicular local Right = Base - Perpendicular
    local Points = {{Tip, Left}, {Tip, Right}, {Left, Right}}
    Data.OffscreenOverlayHidden = false
    for Index = 1, 3 do
        local Outline = Data.OverlayPrimitives["OffscreenOutline" .. Index] local Line = Data.OverlayPrimitives["Offscreen" .. Index] local Pair = Points[Index]
        SetLine(Outline, Pair[1], Pair[2], Settings.OutlineColor, true, 3, 0.95)
        SetLine(Line, Pair[1], Pair[2], Color or Settings.Color, true, 1.5, 1)
    end
    if Data.OverlayPrimitives.OffscreenDistance then
        Data.OverlayPrimitives.OffscreenDistance.Visible = Settings.ShowDistance == true
        if Settings.ShowDistance == true then
            Data.OverlayPrimitives.OffscreenDistance.Color = Color or Settings.Color
            Data.OverlayPrimitives.OffscreenDistance.Size = Shared.GetOverlayTextSize(Visuals.Player.TextSize, true)
            Data.OverlayPrimitives.OffscreenDistance.Text = tostring(Floor((tonumber(Distance) or 0) + 0.5)) .. "m"
            Data.OverlayPrimitives.OffscreenDistance.Position = Base + Unit * (Size + 10)
        end
    end
end
function GetSkeletonConnectionCache(Data)
    if not Data or not Data.Character then return nil end
    if Data.SkeletonCacheCharacter == Data.Character and type(Data.SkeletonConnectionCache) == "table" then return Data.SkeletonConnectionCache end
    local Character = Data.Character
    local Cache = {}
    local function AddSkeletonConnection(FromPart, ToPart, FromLocalOffset, ToLocalOffset)
        if FromPart and ToPart and FromPart:IsA("BasePart") and ToPart:IsA("BasePart") then
            Cache[#Cache + 1] = {FromPart, ToPart, FromLocalOffset or EmptyVector3, ToLocalOffset or EmptyVector3}
        end
    end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local R6 = Humanoid and Humanoid.RigType == Enum.HumanoidRigType.R6 or Character:FindFirstChild("Torso") ~= nil
    if R6 then
        local Head = Character:FindFirstChild("Head")
        local Torso = Character:FindFirstChild("Torso")
        local LeftArm = Character:FindFirstChild("Left Arm")
        local RightArm = Character:FindFirstChild("Right Arm")
        local LeftLeg = Character:FindFirstChild("Left Leg")
        local RightLeg = Character:FindFirstChild("Right Leg")
        if Head and Torso then AddSkeletonConnection(Head, Torso, NewVector3(0, -Head.Size.Y * 0.45, 0), NewVector3(0, Torso.Size.Y * 0.48, 0)) end
        if Torso then AddSkeletonConnection(Torso, Torso, NewVector3(0, Torso.Size.Y * 0.46, 0), NewVector3(0, -Torso.Size.Y * 0.46, 0)) end
        if Torso and LeftArm then
            AddSkeletonConnection(Torso, LeftArm, NewVector3(-Torso.Size.X * 0.48, Torso.Size.Y * 0.27, 0), NewVector3(0, LeftArm.Size.Y * 0.42, 0))
            AddSkeletonConnection(LeftArm, LeftArm, NewVector3(0, LeftArm.Size.Y * 0.42, 0), NewVector3(0, -LeftArm.Size.Y * 0.48, 0))
        end
        if Torso and RightArm then
            AddSkeletonConnection(Torso, RightArm, NewVector3(Torso.Size.X * 0.48, Torso.Size.Y * 0.27, 0), NewVector3(0, RightArm.Size.Y * 0.42, 0))
            AddSkeletonConnection(RightArm, RightArm, NewVector3(0, RightArm.Size.Y * 0.42, 0), NewVector3(0, -RightArm.Size.Y * 0.48, 0))
        end
        if Torso and LeftLeg then
            AddSkeletonConnection(Torso, LeftLeg, NewVector3(-Torso.Size.X * 0.22, -Torso.Size.Y * 0.46, 0), NewVector3(0, LeftLeg.Size.Y * 0.45, 0))
            AddSkeletonConnection(LeftLeg, LeftLeg, NewVector3(0, LeftLeg.Size.Y * 0.45, 0), NewVector3(0, -LeftLeg.Size.Y * 0.48, 0))
        end
        if Torso and RightLeg then
            AddSkeletonConnection(Torso, RightLeg, NewVector3(Torso.Size.X * 0.22, -Torso.Size.Y * 0.46, 0), NewVector3(0, RightLeg.Size.Y * 0.45, 0))
            AddSkeletonConnection(RightLeg, RightLeg, NewVector3(0, RightLeg.Size.Y * 0.45, 0), NewVector3(0, -RightLeg.Size.Y * 0.48, 0))
        end
    else
        local function FindCharacterPart(Name) local Object = Character:FindFirstChild(Name) return Object and Object:IsA("BasePart") and Object or nil end
        AddSkeletonConnection(FindCharacterPart("Head"), FindCharacterPart("UpperTorso"))
        AddSkeletonConnection(FindCharacterPart("UpperTorso"), FindCharacterPart("LowerTorso"))
        AddSkeletonConnection(FindCharacterPart("UpperTorso"), FindCharacterPart("LeftUpperArm"))
        AddSkeletonConnection(FindCharacterPart("LeftUpperArm"), FindCharacterPart("LeftLowerArm"))
        AddSkeletonConnection(FindCharacterPart("LeftLowerArm"), FindCharacterPart("LeftHand"))
        AddSkeletonConnection(FindCharacterPart("UpperTorso"), FindCharacterPart("RightUpperArm"))
        AddSkeletonConnection(FindCharacterPart("RightUpperArm"), FindCharacterPart("RightLowerArm"))
        AddSkeletonConnection(FindCharacterPart("RightLowerArm"), FindCharacterPart("RightHand"))
        AddSkeletonConnection(FindCharacterPart("LowerTorso"), FindCharacterPart("LeftUpperLeg"))
        AddSkeletonConnection(FindCharacterPart("LeftUpperLeg"), FindCharacterPart("LeftLowerLeg"))
        AddSkeletonConnection(FindCharacterPart("LeftLowerLeg"), FindCharacterPart("LeftFoot"))
        AddSkeletonConnection(FindCharacterPart("LowerTorso"), FindCharacterPart("RightUpperLeg"))
        AddSkeletonConnection(FindCharacterPart("RightUpperLeg"), FindCharacterPart("RightLowerLeg"))
        AddSkeletonConnection(FindCharacterPart("RightLowerLeg"), FindCharacterPart("RightFoot"))
    end
    Data.SkeletonCacheCharacter = Character
    Data.SkeletonConnectionCache = Cache
    return Cache
end
function UpdateSkeletonESP(Data, CameraObject, Color)
    local Settings = Visuals.Player.Skeleton
    if not Settings.Enabled or not Data or not Data.Character then
        HideSkeletonOverlay(Data)
        return
    end
    if not EnsureSkeletonOverlay(Data) then return end
    Data.SkeletonOverlayHidden = false
    local Thickness = Max(tonumber(Settings.Thickness) or 1.5, 1)
    local Transparency = 1 - Clamp(tonumber(Settings.Transparency) or 0.05, 0, 0.95)
    local LineColor = Color or Settings.Color
    if Data.ESPCanonicalBounds == true and Data.ESPInvisibilityPose ~= true and Data.Root and Data.Root.Parent then
        local Canonical = Shared.GetPlayerESPCanonicalSkeleton(Data, Data.Root.CFrame)
        if type(Canonical) ~= "table" then
            HideSkeletonOverlay(Data)
            return
        end
        for Index = 1, #Data.SkeletonLines do
            local Line = Data.SkeletonLines[Index]
            local Pair = Canonical[Index]
            if not Line then continue end
            if not Pair then
                Line.Visible = false
                continue
            end
            local FromScreen, FromVisible = Shared.PlayerESPWorldToViewportPoint(CameraObject, Pair[1])
            local ToScreen, ToVisible = Shared.PlayerESPWorldToViewportPoint(CameraObject, Pair[2])
            local Visible = FromVisible and ToVisible and FromScreen.Z > 0 and ToScreen.Z > 0
            Line.Visible = Visible
            if Visible then
                Line.From = NewVector2(FromScreen.X, FromScreen.Y)
                Line.To = NewVector2(ToScreen.X, ToScreen.Y)
                Line.Color = LineColor
                Line.Thickness = Thickness
                Line.Transparency = Transparency
            end
        end
        return
    end
    local Connections = GetSkeletonConnectionCache(Data)
    if not Connections or #Connections == 0 then
        HideSkeletonOverlay(Data)
        return
    end
    local Pose = GetPlayerVisualRenderPose(Data, Clock())
    local Offset = Pose and Pose.Offset or EmptyVector3
    for Index = 1, #Data.SkeletonLines do
        local Line = Data.SkeletonLines[Index]
        local Pair = Connections[Index]
        if not Line then continue end
        if not Pair then
            Line.Visible = false
            continue
        end
        local From, To, FromLocalOffset, ToLocalOffset = Pair[1], Pair[2], Pair[3], Pair[4]
        if not From or not To or not From.Parent or not To.Parent then
            Line.Visible = false
            continue
        end
        local FromWorld = From.CFrame:PointToWorldSpace(FromLocalOffset) + Offset
        local ToWorld = To.CFrame:PointToWorldSpace(ToLocalOffset) + Offset
        local FromScreen, FromVisible = Shared.PlayerESPWorldToViewportPoint(CameraObject, FromWorld)
        local ToScreen, ToVisible = Shared.PlayerESPWorldToViewportPoint(CameraObject, ToWorld)
        local Visible = FromVisible and ToVisible and FromScreen.Z > 0 and ToScreen.Z > 0
        Line.Visible = Visible
        if Visible then
            Line.From = NewVector2(FromScreen.X, FromScreen.Y)
            Line.To = NewVector2(ToScreen.X, ToScreen.Y)
            Line.Color = LineColor
            Line.Thickness = Thickness
            Line.Transparency = Transparency
        end
    end
end
function UpdateLookLine(Data, CameraObject, Color)
    local Settings = Visuals.Player.Look
    local Line = Settings.Enabled and EnsureLookOverlay(Data) or Data and Data.OverlayPrimitives and Data.OverlayPrimitives.LookLine or nil
    if not Settings.Enabled or not Line or not Data then
        if Line then Line.Visible = false end
        return
    end
    local Start
    local Direction
    if Data.ESPCanonicalBounds == true and Data.ESPInvisibilityPose ~= true and Data.Root and Data.Root.Parent then
        local Anchor = Shared.GetPlayerESPProjectionCFrame(Data, Data.Root.CFrame)
        Start = Anchor:PointToWorldSpace(NewVector3(0, 1.56, 0))
        Direction = Data.ESPStableForward
    elseif Data.Head and Data.Head.Parent then
        local Pose = GetPlayerVisualRenderPose(Data, Clock())
        local Offset = Pose and Pose.Offset or EmptyVector3
        Start = Data.Head.Position + Offset
        Direction = Data.Head.CFrame.LookVector
    end
    if typeof(Start) ~= "Vector3" or typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0.001 then
        Line.Visible = false
        return
    end
    Direction = Direction.Unit
    local Finish = Start + Direction * Max(tonumber(Settings.Length) or 6, 1)
    local StartScreen, StartVisible = Shared.PlayerESPWorldToViewportPoint(CameraObject, Start)
    local EndScreen, EndVisible = Shared.PlayerESPWorldToViewportPoint(CameraObject, Finish)
    if not StartVisible or not EndVisible or StartScreen.Z <= 0 or EndScreen.Z <= 0 then
        Line.Visible = false
        return
    end
    Line.Visible = true
    Line.From = NewVector2(StartScreen.X, StartScreen.Y)
    Line.To = NewVector2(EndScreen.X, EndScreen.Y)
    Line.Color = Color or Settings.Color
    Line.Thickness = Max(tonumber(Settings.Thickness) or 1, 1)
    Line.Transparency = 1
end
function BuildPlayerFlagsText(Data, Distance, AmmoCurrent, AmmoMaximum)
    if not Visuals.Player.Flags.Enabled then return nil end
    local Entries = {}
    if Shared.IsAtramentaPlayerActuallyDowned and Shared.IsAtramentaPlayerActuallyDowned(Data.Player) then Entries[#Entries + 1] = "DOWN" end
    if Data.CachedForcefield == true then Entries[#Entries + 1] = "FF" end
    local ActiveTarget = Shared.GetActiveConfirmedCombatTarget()
    if ActiveTarget and Data.Player == ActiveTarget then Entries[#Entries + 1] = "TARGET" end
    if Visuals.Player.Flags.ShowAmmo and type(AmmoCurrent) == "number" and type(AmmoMaximum) == "number" and AmmoMaximum > 0 then
        Entries[#Entries + 1] = Format("AMMO %d/%d", Floor(AmmoCurrent + 0.5), Floor(AmmoMaximum + 0.5))
    end
    if Visuals.Player.Flags.ShowVelocity and Data.Root then Entries[#Entries + 1] = Format("SPD %.0f", Data.Root.AssemblyLinearVelocity.Magnitude) end
    if Visuals.Player.Flags.ShowDistance then Entries[#Entries + 1] = Format("%.0fm", tonumber(Distance) or 0) end
    return #Entries > 0 and Concat(Entries, "\n") or nil
end
function UpdatePredictionMarker(Data, CameraObject)
    local Settings = Visuals.Player.Prediction
    if Settings.Enabled then EnsurePredictionOverlay(Data) end
    local Marker = Data and Data.OverlayPrimitives and Data.OverlayPrimitives.PredictionMarker or nil
    local Outline = Data and Data.OverlayPrimitives and Data.OverlayPrimitives.PredictionOutline or nil
    if not Settings.Enabled or not Marker or not Outline or not Data then
        if Marker then Marker.Visible = false end
        if Outline then Outline.Visible = false end
        return
    end
    local ActiveTarget = Shared.GetActiveConfirmedCombatTarget()
    if ActiveTarget ~= Data.Player then
        Marker.Visible = false
        Outline.Visible = false
        return
    end
    local TargetPart = Data.Head or Data.Root
    if not TargetPart then
        Marker.Visible = false
        Outline.Visible = false
        return
    end
    local Pose = GetPlayerVisualRenderPose(Data, Clock())
    local Offset = Pose and Pose.Offset or EmptyVector3
    local Lead = Max(tonumber(Settings.Lead) or 0.12, 0)
    local Position = TargetPart.Position + Offset + TargetPart.AssemblyLinearVelocity * Lead
    local ScreenPosition, Visible = Shared.PlayerESPWorldToViewportPoint(CameraObject, Position)
    if not Visible or ScreenPosition.Z <= 0 then
        Marker.Visible = false
        Outline.Visible = false
        return
    end
    local Point = NewVector2(ScreenPosition.X, ScreenPosition.Y)
    local Radius = Max(tonumber(Settings.Radius) or 4, 2)
    Marker.Visible = true
    Marker.Position = Point
    Marker.Radius = Radius
    Marker.Color = Settings.Color
    Outline.Visible = true
    Outline.Position = Point
    Outline.Radius = Radius + 1
end
function UpdateBoxGlow(Data, Position, Size, Color)
    if not Data or not Data.OverlayPrimitives then return end
    local Settings = Visuals.Player.BoxGlow
    if Settings.Enabled then EnsureBoxGlowOverlay(Data) end
    local Layers = Clamp(Floor(tonumber(Settings.Layers) or 3), 1, 6)
    local Spread = Clamp(tonumber(Settings.Spread) or 2, 0.5, 8)
    local BaseTransparency = Clamp(tonumber(Settings.Transparency) or 0.78, 0, 0.98)
    local GlowColor = Settings.MatchBoxColor == true and (Color or Visuals.Player.BoxColor) or Settings.Color
    local PulseMultiplier = 1
    if Settings.Pulse == true then
        local Speed = Clamp(tonumber(Settings.PulseSpeed) or 2, 0.2, 8)
        PulseMultiplier = 0.78 + (Sin(Clock() * Speed * Pi * 2) * 0.5 + 0.5) * 0.22
    end
    for Index = 1, 6 do
        local Box = Data.OverlayPrimitives["GlowBox" .. Index]
        if Box then
            local Visible = Settings.Enabled == true and Visuals.Player.Boxes == true and Index <= Layers
            Box.Visible = Visible
            if Visible then
                local Expansion = Index * Spread
                local Fade = (Index - 1) / Max(Layers - 1, 1)
                local Transparency = Clamp(BaseTransparency + Fade * (1 - BaseTransparency) * 0.78, 0, 0.99)
                Box.Position = Position - NewVector2(Expansion, Expansion)
                Box.Size = Size + NewVector2(Expansion * 2, Expansion * 2)
                Box.Color = GlowColor
                Box.Transparency = Clamp((1 - Transparency) * PulseMultiplier, 0.02, 1)
                Box.Thickness = Clamp(tonumber(Settings.Thickness) or 1, 0.5, 4)
            end
        end
    end
end
