    if not Character then return end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Animator = Humanoid and (Humanoid:FindFirstChildOfClass("Animator") or Humanoid:FindFirstChild("Animator"))
    if Animator and Animator:IsA("Animator") then
        GunMods.EquipAnimationConnection = Animator.AnimationPlayed:Connect(function(Track)
            if AtramentaConfig.Weapon.GunMods.InstantEquip == true and IsEquipAnimationTrack(Track) then pcall(function() Track:AdjustSpeed(10000) end) end
        end)
    end
    GunMods.CharacterConnection = Character.ChildAdded:Connect(function(Tool)
        if Tool:IsA("Tool") then
            if AtramentaConfig.Weapon.GunMods.InstantEquip == true then
                RegisterUniversalInstantEquipTool(Tool)
                Defer(AccelerateEquipAnimations, Character)
            end
            Defer(HandleGun, Tool)
        end
    end)
    for _, Tool in ipairs(Character:GetChildren()) do
        if Tool:IsA("Tool") then
            if AtramentaConfig.Weapon.GunMods.InstantEquip == true then RegisterUniversalInstantEquipTool(Tool) end
            Defer(HandleGun, Tool)
        end
    end
