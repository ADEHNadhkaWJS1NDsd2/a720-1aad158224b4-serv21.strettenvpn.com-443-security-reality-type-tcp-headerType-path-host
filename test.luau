function RefreshPlayerOverlayCoreState(Data, CurrentTime)
    if not Data or not Data.ESPEligible then return end
    if not Shared.EnsurePlayerOverlayCore(Data, false) then return end
    local OverlayPrimitives = Data.OverlayPrimitives
    local Visible = Data.VisualHidden ~= true
    local TextSize = Shared.GetOverlayTextSize(Visuals.Player.TextSize, false)
    local SmallTextSize = Shared.GetOverlayTextSize(Visuals.Player.TextSize, true)
    local TextColor = Visuals.Player.TextColor
    if Data.DisplayNameText == nil then
        local PlayerObject = Data.Player
        Data.DisplayNameText = GetPlayerESPNameText(Data)
    end
    if OverlayPrimitives.Name then
        OverlayPrimitives.Name.Visible = Visible and Visuals.Player.Names
        if OverlayPrimitives.Name.Visible then
            OverlayPrimitives.Name.Text = Data.DisplayNameText
            OverlayPrimitives.Name.Size = TextSize
            OverlayPrimitives.Name.Color = TextColor
        end
    end
    if OverlayPrimitives.Distance then
        OverlayPrimitives.Distance.Visible = Visible and Visuals.Player.Distance
        if OverlayPrimitives.Distance.Visible then
            local Rounded = Floor((tonumber(Data.LastESPDistance) or 0) + 0.5)
            if Data.LastOverlayDistanceValue ~= Rounded then
                Data.LastOverlayDistanceValue = Rounded
                OverlayPrimitives.Distance.Text = tostring(Rounded) .. "m"
            end
            OverlayPrimitives.Distance.Size = SmallTextSize
            OverlayPrimitives.Distance.Color = TextColor
        end
    end
    if OverlayPrimitives.Weapon then
        local ToolName = Data.ToolName
        OverlayPrimitives.Weapon.Visible = Visible and Visuals.Player.Weapon and type(ToolName) == "string" and ToolName ~= ""
        if OverlayPrimitives.Weapon.Visible then
            OverlayPrimitives.Weapon.Text = ToolName
            OverlayPrimitives.Weapon.Size = SmallTextSize
            OverlayPrimitives.Weapon.Color = TextColor
        end
    end
    Shared.RefreshEquippedWeaponOverlayIcon(Data, Visible)
    if OverlayPrimitives.Level then
        local LevelValue = Data.LevelValue
        OverlayPrimitives.Level.Visible = Visible and Visuals.Player.Level and LevelValue ~= nil
        if OverlayPrimitives.Level.Visible then
            OverlayPrimitives.Level.Text = "Level " .. tostring(LevelValue)
            OverlayPrimitives.Level.Size = SmallTextSize
            OverlayPrimitives.Level.Color = Visuals.Player.LevelColor
        end
    end
    if OverlayPrimitives.Forcefield then
        OverlayPrimitives.Forcefield.Visible = Visible and Visuals.Player.Forcefield.Enabled and Data.CachedForcefield == true
        if OverlayPrimitives.Forcefield.Visible then
            OverlayPrimitives.Forcefield.Text = "[Forcefield]"
            OverlayPrimitives.Forcefield.Size = SmallTextSize
            OverlayPrimitives.Forcefield.Color = Visuals.Player.Forcefield.Color
        end
    end
    local Humanoid = Data.Humanoid
    local Health = Humanoid and Max(tonumber(Humanoid.Health) or 0, 0) or 0
    if OverlayPrimitives.HealthText then
        OverlayPrimitives.HealthText.Visible = Visible and Visuals.Player.HealthText
        if OverlayPrimitives.HealthText.Visible then
            local Rounded = Floor(Health + 0.5)
            if Data.LastOverlayHealthValue ~= Rounded then
                Data.LastOverlayHealthValue = Rounded
                OverlayPrimitives.HealthText.Text = tostring(Rounded)
            end
            OverlayPrimitives.HealthText.Size = TextSize
            OverlayPrimitives.HealthText.Center = false
        end
    end
    if OverlayPrimitives.Flags then
        local AmmoCurrent = tonumber(Data.CachedAmmoCurrent)
        local AmmoMaximum = tonumber(Data.CachedAmmoMaximum)
        local FlagText = Visuals.Player.Flags.Enabled and BuildPlayerFlagsText(Data, tonumber(Data.LastESPDistance) or 0, AmmoCurrent, AmmoMaximum) or nil
        OverlayPrimitives.Flags.Visible = Visible and FlagText ~= nil
        if OverlayPrimitives.Flags.Visible then
            OverlayPrimitives.Flags.Text = FlagText
            OverlayPrimitives.Flags.Color = Visuals.Player.Flags.Color
            OverlayPrimitives.Flags.Size = SmallTextSize
        end
    end
    if Visuals.Player.Ammo.Enabled and not OverlayPrimitives.AmmoBack then
        EnsureAmmoOverlay(Data)
        OverlayPrimitives = Data.OverlayPrimitives
    end
    local ShowAmmo = Visible and Visuals.Player.Ammo.Enabled and type(Data.CachedAmmoCurrent) == "number" and type(Data.CachedAmmoMaximum) == "number"
        and Data.CachedAmmoMaximum > 0
    if OverlayPrimitives.AmmoBack then OverlayPrimitives.AmmoBack.Visible = ShowAmmo end
    if OverlayPrimitives.AmmoBar then OverlayPrimitives.AmmoBar.Visible = ShowAmmo end
    if OverlayPrimitives.AmmoText then
        OverlayPrimitives.AmmoText.Visible = ShowAmmo and Visuals.Player.Ammo.Text == true
        if OverlayPrimitives.AmmoText.Visible then
            local AmmoText = Format("%d/%d", Floor(Data.CachedAmmoCurrent + 0.5), Floor(Data.CachedAmmoMaximum + 0.5))
            if Data.LastOverlayAmmoText ~= AmmoText then
                Data.LastOverlayAmmoText = AmmoText
                OverlayPrimitives.AmmoText.Text = AmmoText
            end
            OverlayPrimitives.AmmoText.Size = SmallTextSize
            OverlayPrimitives.AmmoText.Color = Visuals.Player.Ammo.Color
        end
    end
end

