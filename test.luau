function RestartUniversalEquipToolScripts(Tool)
    if not Tool or not Tool.Parent or AtramentaConfig.Weapon.GunMods.InstantEquip ~= true then return false end
    if GunMods.EquipRuntimePending[Tool] then return false end
    GunMods.EquipRuntimePending[Tool] = true
    Spawn(function()
        RegisterUniversalInstantEquipTool(Tool)
        local Scripts = {}
        for _, Object in ipairs(Tool:GetDescendants()) do
            if Object:IsA("LocalScript") and Object.Disabled ~= true then Scripts[#Scripts + 1] = Object end
        end
        if #Scripts > 0 then
            for _, ScriptObject in ipairs(Scripts) do pcall(function() ScriptObject.Disabled = true end) end
