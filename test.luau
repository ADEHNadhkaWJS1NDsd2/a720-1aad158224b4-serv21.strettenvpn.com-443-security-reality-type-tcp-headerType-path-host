function Shared.GetHitSoundPool(SoundName)
    SoundName = Shared.NormalizeHitSoundName(SoundName)
    local SoundId = HitSounds[SoundName]
    if type(SoundId) ~= "string" or SoundId == "" then return nil end
    local Pool = HitFeedbackRuntimeState.HitSoundPools[SoundId]
    if Pool then return Pool end
    Pool = {SoundId = SoundId, Voices = {}, Busy = setmetatable({}, {__mode = "k"}), Serial = setmetatable({}, {__mode = "k"}), Cursor = 0, Preloaded = false, Preloading = false}
    HitFeedbackRuntimeState.HitSoundPools[SoundId] = Pool
    for Index = 1, Max(Floor(tonumber(HitFeedbackRuntimeState.HitSoundPoolSize) or 16), 4) do
        local Voice = NewInstance("Sound")
        Voice.Name = "AtramentaHitSoundVoice"
        Voice.SoundId = SoundId
        Voice.Volume = 1
        Voice.Parent = SoundService
        Pool.Voices[Index] = Voice
        HitFeedbackRuntimeState.ActiveObjects[Voice] = true
        Voice.Ended:Connect(function() Pool.Busy[Voice] = nil end)
    end
    return Pool
end
function Shared.PreloadConfiguredHitSound(SoundName)
    local Pool = Shared.GetHitSoundPool(SoundName)
    if not Pool or Pool.Preloaded or Pool.Preloading then return Pool ~= nil end
    Pool.Preloading = true
    HitFeedbackRuntimeState.HitSoundPreloadSerial += 1
    Spawn(function()
        Shared.SafeCall(ContentProvider.PreloadAsync, ContentProvider, Pool.Voices)
        Pool.Preloaded = true
        Pool.Preloading = false
    end)
    return true
end
function Shared.AcquireHitSoundVoice(Pool)
    if not Pool then return nil, false end
    local Count = #Pool.Voices
    if Count > 0 then
        for Offset = 1, Count do
            local Index = ((Pool.Cursor + Offset - 1) % Count) + 1
            local Voice = Pool.Voices[Index]
            if Voice and Voice.Parent and not Pool.Busy[Voice] then
                Pool.Cursor = Index
                return Voice, false
            end
        end
    end
    local Voice = NewInstance("Sound")
    Voice.Name = "AtramentaHitSoundOverflow"
    Voice.SoundId = Pool.SoundId
    Voice.Parent = SoundService
    HitFeedbackRuntimeState.ActiveObjects[Voice] = true
    return Voice, true
end
function Shared.PlayConfiguredHitFeedbackSound(SoundName, Volume, PlaybackSpeed, InstanceName)
    SoundName = Shared.NormalizeHitSoundName(SoundName)
    local Pool = Shared.GetHitSoundPool(SoundName)
    if not Pool then return false end
    Shared.PreloadConfiguredHitSound(SoundName)
    local Voice, Overflow = Shared.AcquireHitSoundVoice(Pool)
    if not Voice then return false end
    Voice.Name = tostring(InstanceName or (Overflow and "AtramentaHitSoundOverflow" or "AtramentaHitSound"))
    Voice.SoundId = Pool.SoundId
    Voice.Volume = Clamp(tonumber(Volume) or 1, 0, 5)
    Voice.PlaybackSpeed = Clamp(tonumber(PlaybackSpeed) or 1, 0.5, 2)
    if not Overflow then
        local Serial = (tonumber(Pool.Serial[Voice]) or 0) + 1
        Pool.Serial[Voice] = Serial
        Pool.Busy[Voice] = true
        Shared.SafeCall(function() Voice.TimePosition = 0 end)
        Voice:Play()
        Delay(6, function()
            if Pool.Serial[Voice] == Serial then
                Pool.Busy[Voice] = nil
                if Voice.Parent and Voice.Playing then Voice:Stop() end
            end
        end)
        return true
    end
    local Finished = false local EndedConnection
    local function DestroyExcessHitmarkers()
        if Finished then return end
        Finished = true
        if EndedConnection then Shared.SafeDisconnect(EndedConnection) EndedConnection = nil end
        HitFeedbackRuntimeState.ActiveObjects[Voice] = nil
        if Voice.Parent then Voice:Destroy() end
    end
    EndedConnection = Voice.Ended:Connect(DestroyExcessHitmarkers)
    Voice:Play()
    Delay(6, DestroyExcessHitmarkers)
    return true
end
