function GrenadeTrajectoryClearActive()
    GrenadeTrajectoryState.ActiveProjectile = nil
    GrenadeTrajectoryState.ActivePart = nil
    GrenadeTrajectoryState.ActiveProfile = nil
    GrenadeTrajectoryState.ActiveStarted = 0
