end
function GetFlyInputVelocity(CameraObject, Speed, IncludeVertical)
    if not CameraObject then return EmptyVector3 end
    local CameraFrame = CameraObject.CFrame
    local Forward = CameraFrame.LookVector
    local Side = CameraFrame.RightVector
    Forward = Forward.Magnitude > 0.001 and Forward.Unit or NewVector3(0, 0, -1)
    Side = Side.Magnitude > 0.001 and Side.Unit or NewVector3(1, 0, 0)
    local Direction = EmptyVector3
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then Direction += Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then Direction -= Forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then Direction -= Side end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then Direction += Side end
    if IncludeVertical then
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then Direction += Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then Direction -= Vector3.yAxis end
    end
    if Direction.Magnitude > 0.001 then Direction = Direction.Unit end
    return Direction * Clamp(tonumber(Speed) or tonumber(FlySpeed) or 40, 5, 180)
end

