function AtramentaExtraCollectLeaderboardLevels()
    local Results = {}
    local Seen = {}
    local function Add(Object)
        if Object and (Object:IsA("IntValue") or Object:IsA("NumberValue")) and not Seen[Object] then
            Seen[Object] = true
            Results[#Results + 1] = Object
        end
    end
    local function AddFromContainer(Container)
        if not Container then
            return
        end
        Add(Container:FindFirstChild("Level") or Container:FindFirstChild("Lvl"))
    end
    AddFromContainer(LocalPlayer:FindFirstChild("leaderstats"))
    AddFromContainer(LocalPlayer:FindFirstChild("PlayerbaseData2"))
    local DataRoot = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
    local PlayerData = DataRoot and (DataRoot:FindFirstChild(LocalPlayer.Name) or DataRoot:FindFirstChild(tostring(LocalPlayer.UserId)))
    AddFromContainer(PlayerData)
    return Results
end

