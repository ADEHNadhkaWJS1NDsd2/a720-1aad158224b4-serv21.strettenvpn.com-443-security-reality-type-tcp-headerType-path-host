    local Minimum = NewVector3(Infinite, Infinite, Infinite)
    local Maximum = NewVector3(-Infinite, -Infinite, -Infinite)
    local Found = false
    local function IncludePart(Part)
        if not Part or not Part:IsA("BasePart") or Part == Root or Part.Parent ~= Character or Part:GetAttribute("AtramentaVisual") == true then return end
        local PartCFrame, PartSize = Shared.GetPlayerESPVisualPartGeometry(Part)
        if typeof(PartCFrame) ~= "CFrame" or typeof(PartSize) ~= "Vector3" then return end
        local Half = PartSize * 0.5
        local Right = PartCFrame.RightVector
        local Up = PartCFrame.UpVector
        local Look = PartCFrame.LookVector
        local Extent = NewVector3(
            Abs(Right.X) * Half.X + Abs(Up.X) * Half.Y + Abs(Look.X) * Half.Z,
            Abs(Right.Y) * Half.X + Abs(Up.Y) * Half.Y + Abs(Look.Y) * Half.Z,
            Abs(Right.Z) * Half.X + Abs(Up.Z) * Half.Y + Abs(Look.Z) * Half.Z
        )
        local Position = PartCFrame.Position
        local Low = Position - Extent
        local High = Position + Extent
        Minimum = NewVector3(Min(Minimum.X, Low.X), Min(Minimum.Y, Low.Y), Min(Minimum.Z, Low.Z))
        Maximum = NewVector3(Max(Maximum.X, High.X), Max(Maximum.Y, High.Y), Max(Maximum.Z, High.Z))
        Found = true
    end
    if IsR6 then
        for Name in pairs(ESPBoundsPartNames) do IncludePart(Character:FindFirstChild(Name)) end
    else
        for _, Part in ipairs(Character:GetChildren()) do
            if Part:IsA("BasePart") and not Part:FindFirstAncestorOfClass("Tool") and not Part:FindFirstAncestorOfClass("Accessory") then
                IncludePart(Part)
            end
        end
    end
    if not Found then return nil end
    return Minimum, Maximum
end

function Shared.ProjectPlayerESPLiveCharacterBounds(CameraObject, Data)
    local Minimum, Maximum = Shared.GetPlayerESPWorldBounds(Data)
    if typeof(Minimum) ~= "Vector3" or typeof(Maximum) ~= "Vector3" then return nil end
    local MinX, MinY = Infinite, Infinite
    local MaxX, MaxY = -Infinite, -Infinite
    local Found = false
    for XIndex = 0, 1 do
        local X = XIndex == 0 and Minimum.X or Maximum.X
        for YIndex = 0, 1 do
            local Y = YIndex == 0 and Minimum.Y or Maximum.Y
            for ZIndex = 0, 1 do
                local Z = ZIndex == 0 and Minimum.Z or Maximum.Z
                local Screen = Shared.PlayerESPWorldToViewportPoint(CameraObject, NewVector3(X, Y, Z))
                if Screen.Z > 0.05 then
                    MinX = Min(MinX, Screen.X)
                    MinY = Min(MinY, Screen.Y)
                    MaxX = Max(MaxX, Screen.X)
                    MaxY = Max(MaxY, Screen.Y)
                    Found = true
                end
            end
        end
    end
    if not Found then return nil end
    return NewVector2(MinX, MinY), NewVector2(Max(MaxX - MinX, 2), Max(MaxY - MinY, 4))
end
function Shared.ProjectStaticPlayerESPBox(CameraObject, RootPosition, AnchorPosition, AnchorSize)
    if not CameraObject or typeof(RootPosition) ~= "Vector3" then return nil end
    local Settings = Visuals.Player
    local WidthStuds = Clamp(tonumber(Settings.StaticWorldWidth) or 4.0, 2.5, 7.0)
    local HeightStuds = Clamp(tonumber(Settings.StaticWorldHeight) or 5.8, 4.0, 9.0)
    local VerticalOffset = Clamp(tonumber(Settings.StaticVerticalOffset) or -0.15, -1.5, 1.5)
    local CameraCFrame = Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    if typeof(CameraCFrame) ~= "CFrame" then return nil end
    local ToRoot = RootPosition - CameraCFrame.Position
    local RootDistance = ToRoot.Magnitude
    if RootDistance <= 0.001 or CameraCFrame.LookVector:Dot(ToRoot / RootDistance) <= 0 then return nil end
    local Center = RootPosition + CameraCFrame.UpVector * VerticalOffset
    local Right = CameraCFrame.RightVector * (WidthStuds * 0.5)
    local Up = CameraCFrame.UpVector * (HeightStuds * 0.5)
    local Points = {Center - Right + Up, Center + Right + Up, Center - Right - Up, Center + Right - Up}
    local MinX, MinY = Infinite, Infinite
    local MaxX, MaxY = -Infinite, -Infinite
    for Index = 1, 4 do
        local Screen = Shared.PlayerESPWorldToViewportPoint(CameraObject, Points[Index])
        if Screen.Z <= 0.05 then return nil end
        MinX = Min(MinX, Screen.X)
        MinY = Min(MinY, Screen.Y)
        MaxX = Max(MaxX, Screen.X)
        MaxY = Max(MaxY, Screen.Y)
    end
    local Position = NewVector2(MinX, MinY)
    local Size = NewVector2(Max(MaxX - MinX, 2), Max(MaxY - MinY, 4))
    if typeof(AnchorPosition) == "Vector2" and typeof(AnchorSize) == "Vector2" then
        local AnchorCenter = AnchorPosition + AnchorSize * 0.5
        Position = AnchorCenter - Size * 0.5
    end
    return Position, Size
end

function Shared.ProjectClassicPlayerESPBox(CameraObject, Data, RootPosition, AnchorPosition, AnchorSize)
    if not CameraObject or not Data or typeof(RootPosition) ~= "Vector3" then return nil end
    local Settings = Visuals.Player
    local Minimum, Maximum = Shared.BuildPlayerESPLocalBounds(Data)
    if typeof(Minimum) ~= "Vector3" or typeof(Maximum) ~= "Vector3" then return nil end
    local HeightStuds = Clamp(Max(Maximum.Y - Minimum.Y, 4.8), 4.0, 9.5)
    local Ratio = Clamp(tonumber(Settings.ClassicWidthRatio) or 0.50, 0.35, 0.80)
    local WidthStuds = HeightStuds * Ratio
    local CameraCFrame = Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    if typeof(CameraCFrame) ~= "CFrame" then return nil end
    local CenterOffset = ((Maximum.Y + Minimum.Y) * 0.5)
    local Center = RootPosition + CameraCFrame.UpVector * CenterOffset
    local Right = CameraCFrame.RightVector * (WidthStuds * 0.5)
    local Up = CameraCFrame.UpVector * (HeightStuds * 0.5)
    local Points = {Center - Right + Up, Center + Right + Up, Center - Right - Up, Center + Right - Up}
    local MinX, MinY = Infinite, Infinite
    local MaxX, MaxY = -Infinite, -Infinite
    for Index = 1, 4 do
        local Screen = Shared.PlayerESPWorldToViewportPoint(CameraObject, Points[Index])
        if Screen.Z <= 0.05 then return nil end
        MinX = Min(MinX, Screen.X)
        MinY = Min(MinY, Screen.Y)
        MaxX = Max(MaxX, Screen.X)
        MaxY = Max(MaxY, Screen.Y)
    end
    local Position = NewVector2(MinX, MinY)
    local Size = NewVector2(Max(MaxX - MinX, 4), Max(MaxY - MinY, 8))
    if typeof(AnchorPosition) == "Vector2" and typeof(AnchorSize) == "Vector2" then
        local AnchorCenter = AnchorPosition + AnchorSize * 0.5
        Position = AnchorCenter - Size * 0.5
    end
    return Position, Size
end

function Shared.DisconnectPlayerESPBoundsSignals(Data)
    if not Data or type(Data.ESPBoundsSignals) ~= "table" then return end
    for Key, Value in pairs(Data.ESPBoundsSignals) do
        if typeof(Value) == "RBXScriptConnection" then
            Shared.SafeDisconnect(Value)
        elseif type(Value) == "table" then
            for _, Connection in pairs(Value) do
                if typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
            end
        end
        Data.ESPBoundsSignals[Key] = nil
    end
    Data.ESPBoundsSignalCharacter = nil
end

function Shared.BindPlayerESPBoundsSignals(Data)
    local Character = Data and Data.Character
    if not Data or not Character or not Character.Parent then
        Shared.DisconnectPlayerESPBoundsSignals(Data)
        return false
    end
    if Data.ESPBoundsSignalCharacter == Character and type(Data.ESPBoundsSignals) == "table" then
        return true
    end
    Shared.DisconnectPlayerESPBoundsSignals(Data)
    Data.ESPBoundsSignalCharacter = Character
    Data.ESPBoundsSignals = {}
    local function MarkBoundsDirty(StateDirty)
        Data.ESPBoundsDirty = true
        if StateDirty == true then Data.ESPStateDirty = true end
    end
    local function DisconnectPartSignals(Part)
        local Bucket = Data.ESPBoundsSignals[Part]
        if type(Bucket) == "table" then
            for _, Connection in pairs(Bucket) do
                if typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
            end
        end
        Data.ESPBoundsSignals[Part] = nil
    end
    local function BindPartSignals(Part)
        if not Part or not Part:IsA("BasePart") or Part.Parent ~= Character then return end
        if Part.Name == "HumanoidRootPart" then return end
        if Part:FindFirstAncestorOfClass("Tool") or Part:FindFirstAncestorOfClass("Accessory") then return end
        DisconnectPartSignals(Part)
        local Bucket = {}
        Bucket.Size = Part:GetPropertyChangedSignal("Size"):Connect(function()
            MarkBoundsDirty(false)
        end)
        if ESPBoundsPartNames[Part.Name] == true then
            Bucket.Transparency = Part:GetPropertyChangedSignal("Transparency"):Connect(function()
                MarkBoundsDirty(true)
            end)
        end
        Data.ESPBoundsSignals[Part] = Bucket
    end
    for _, Object in ipairs(Character:GetChildren()) do
        BindPartSignals(Object)
    end
    Data.ESPBoundsSignals.ChildAdded = Character.ChildAdded:Connect(function(Object)
        BindPartSignals(Object)
        MarkBoundsDirty(true)
    end)
    Data.ESPBoundsSignals.ChildRemoved = Character.ChildRemoved:Connect(function(Object)
        DisconnectPartSignals(Object)
        MarkBoundsDirty(true)
    end)
    return true
end

function Shared.ResetPlayerESPBounds(Data)
    if not Data then return end
    Data.ESPBoundsCharacter = nil
    Data.ESPBoundsMinimum = nil
    Data.ESPBoundsMaximum = nil
    Data.ESPBoundsFrame = nil
    Data.ESPBoundsDirty = true
    Data.ESPStateDirty = true
    Data.ESPStateKnown = false
    Data.ESPCanonicalBounds = false
    Data.ESPInvisibilityLike = false
    Data.ESPBrokenPose = false
    Data.ESPRootTilted = false
    Data.ESPInvisibilityPose = false
end
function Shared.BuildPlayerESPLocalBounds(Data)
    local Character = Data and Data.Character
    local Root = Data and Data.Root
    if not Character or not Root or not Root.Parent then return nil end
    Shared.BindPlayerESPBoundsSignals(Data)
    if Data.ESPBoundsCharacter == Character and Data.ESPBoundsDirty ~= true and typeof(Data.ESPBoundsMinimum) == "Vector3" and typeof(Data.ESPBoundsMaximum) == "Vector3" then
        return Data.ESPBoundsMinimum, Data.ESPBoundsMaximum
    end
    local IsR6 = Shared.GetPlayerESPR6BodyState(Data)
    local Minimum
    local Maximum
    if IsR6 then
        Minimum, Maximum = Shared.GetPlayerESPCanonicalR6Bounds()
    else
        Minimum = NewVector3(Infinite, Infinite, Infinite)
        Maximum = NewVector3(-Infinite, -Infinite, -Infinite)
        local Found = false
        local RootCFrame = Root.CFrame
        for _, Part in ipairs(Character:GetChildren()) do
            local Valid = Part:IsA("BasePart") and Part ~= Root and Part.Name ~= "HumanoidRootPart" and Part:GetAttribute("AtramentaVisual") ~= true
                and not Part:FindFirstAncestorOfClass("Tool") and not Part:FindFirstAncestorOfClass("Accessory")
            if Valid and (Part.Position - Root.Position).Magnitude <= 8 then
                local VisualCFrame, VisualSize = Shared.GetPlayerESPVisualPartGeometry(Part)
                if typeof(VisualCFrame) == "CFrame" and typeof(VisualSize) == "Vector3" then
                    local Relative = RootCFrame:ToObjectSpace(VisualCFrame)
                    local Half = VisualSize * 0.5
                    for X = -1, 1, 2 do
                        for Y = -1, 1, 2 do
                            for Z = -1, 1, 2 do
                                local Point = Relative:PointToWorldSpace(NewVector3(Half.X * X, Half.Y * Y, Half.Z * Z))
                                Minimum = NewVector3(Min(Minimum.X, Point.X), Min(Minimum.Y, Point.Y), Min(Minimum.Z, Point.Z))
                                Maximum = NewVector3(Max(Maximum.X, Point.X), Max(Maximum.Y, Point.Y), Max(Maximum.Z, Point.Z))
                                Found = true
                            end
                        end
                    end
                end
            end
        end
        if not Found then
            Minimum = NewVector3(-2, -3, -1)
            Maximum = NewVector3(2, 2, 1)
        else
            Minimum -= NewVector3(0.04, 0.04, 0.03)
            Maximum += NewVector3(0.04, 0.04, 0.03)
        end
    end
    Data.ESPBoundsCharacter = Character
    Data.ESPBoundsMinimum = Minimum
    Data.ESPBoundsMaximum = Maximum
    Data.ESPBoundsDirty = false
    return Minimum, Maximum
end
function GetPlayerVisualRenderPose(Data, CurrentTime)
    if not Data then return nil end
    local Root = Data.Root
    local Head = Data.Head
    if not Root or not Root.Parent or not Root:IsA("BasePart") then
        Data.VisualRenderPose = nil
        return nil
    end
    local RootCFrame = Root.CFrame
    local RootPosition = RootCFrame.Position
    if not ResolverReadVector(RootPosition) then
        Data.VisualRenderPose = nil
        return nil
    end
    local Velocity = Root.AssemblyLinearVelocity
    if not ResolverReadVector(Velocity) then Velocity = EmptyVector3 end
    local Pose = Data.VisualRenderPose
    if type(Pose) ~= "table" then
        Pose = {}
        Data.VisualRenderPose = Pose
    end
    Pose.Character = Data.Character
    Pose.RawRootPosition = RootPosition
    Pose.RawRootCFrame = RootCFrame
    Pose.RenderRootPosition = RootPosition
    Pose.RenderRootCFrame = RootCFrame
    Pose.RawPosition = RootPosition
    Pose.HeadPosition = Head and Head.Parent and Head:IsA("BasePart") and Head.Position or nil
    Pose.Offset = EmptyVector3
    Pose.PreviousVelocity = Velocity
    Pose.Velocity = Velocity
    Pose.LastUpdate = tonumber(CurrentTime) or Clock()
    Pose.Frame = tonumber(Visuals.Performance.ProjectionFrame) or 0
    Data.VisualRenderPoseFrame = Pose.Frame
    Data.VisualRenderPoseTime = Pose.LastUpdate
    return Pose
end
function Shared.NormalizePlayerESPSizeType(Value)
    Value = tostring(Value or "Bounding")
    if Value == "Dynamic" then return "Dynamic" end
    if Value == "Static" then return "Static" end
    if Value == "Classic" then return "Classic" end
    return "Bounding"
end
function Shared.ProjectPlayerESPBodyBounds(CameraObject, Data)
    local Root = Data and Data.Root
    if not CameraObject or not Root or not Root.Parent then
        return nil
    end
    local Minimum, Maximum = Shared.BuildPlayerESPLocalBounds(Data)
    if not Minimum or not Maximum then return nil end
    local ProjectionCFrame = Shared.GetPlayerESPProjectionCFrame(Data, Root.CFrame)
    return Shared.ProjectPlayerESPLocalBounds(CameraObject, ProjectionCFrame, Minimum, Maximum)
end
function Shared.ComputePlayerESPScreenBox(CameraObject, Data, RootPosition, RootCFrame)
    if not CameraObject or not Data or typeof(RootPosition) ~= "Vector3" then return nil end
    local Root = Data.Root
    if not Root or not Root.Parent or not Root:IsA("BasePart") then return nil end
    RootCFrame = typeof(RootCFrame) == "CFrame" and RootCFrame or Root.CFrame
    local CameraCFrame = Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    if typeof(CameraCFrame) ~= "CFrame" then return nil end
    local ToRoot = RootPosition - CameraCFrame.Position
    local RootDistance = ToRoot.Magnitude
    if RootDistance <= 0.001 or CameraCFrame.LookVector:Dot(ToRoot / RootDistance) <= 0 then return nil end
    local RootScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, RootPosition)
    if RootScreen.Z <= 0.05 then return nil end
    Shared.GetPlayerESPR6BodyState(Data)
    local Settings = Visuals.Player
    local Mode = Shared.NormalizePlayerESPSizeType(Settings.BoxSizing)
    local BoxScale = Clamp(tonumber(Settings.BoxScale) or 0.96, 0.60, 1.50)
    local Padding = Clamp(tonumber(Settings.BoundingPadding) or 1.5, 0, 10)
    local Position, Size
    if Mode == "Dynamic" then
        Position, Size = Shared.ProjectPlayerESPLiveCharacterBounds(CameraObject, Data)
        if not Position or not Size then Position, Size = Shared.ProjectPlayerESPBodyBounds(CameraObject, Data) end
        if not Position or not Size then return nil end
        Position, Size = Shared.ScalePlayerESPBox(Position, Size, BoxScale, Padding)
    elseif Mode == "Bounding" then
        local NeedLiveBounds = Data.CachedDowned == true or Data.ESPInvisibilityPose == true or Data.ESPBrokenPose == true or Data.ESPRootTilted == true or Abs(RootCFrame.UpVector.Y) <= 0.72
        if NeedLiveBounds then Position, Size = Shared.ProjectPlayerESPLiveCharacterBounds(CameraObject, Data) end
        if not Position or not Size then
            local Minimum, Maximum = Shared.BuildPlayerESPLocalBounds(Data)
            if typeof(Minimum) ~= "Vector3" or typeof(Maximum) ~= "Vector3" then return nil end
            local ProjectedRoot = Shared.GetPlayerESPProjectionCFrame(Data, RootCFrame)
            if typeof(ProjectedRoot) ~= "CFrame" then ProjectedRoot = RootCFrame end
            if ProjectedRoot.Position ~= RootPosition then ProjectedRoot = ProjectedRoot - ProjectedRoot.Position + RootPosition end
            Position, Size = Shared.ProjectPlayerESPLocalBounds(CameraObject, ProjectedRoot, Minimum, Maximum)
        end
        if not Position or not Size then return nil end
        Position, Size = Shared.ScalePlayerESPBox(Position, Size, BoxScale, Padding)
    elseif Mode == "Static" then
        Position, Size = Shared.ProjectStaticPlayerESPBox(CameraObject, RootPosition)
        if not Position or not Size then return nil end
        Position, Size = Shared.ScalePlayerESPBox(Position, Size, BoxScale, 0)
    else
        Position, Size = Shared.ProjectClassicPlayerESPBox(CameraObject, Data, RootPosition)
        if not Position or not Size then return nil end
        Position, Size = Shared.ScalePlayerESPBox(Position, Size, BoxScale, 1)
    end
    if not Position or not Size then return nil end
    local Head2D
    local Head = Data.Head
    if not Head or not Head.Parent then Head = Data.Character and Data.Character:FindFirstChild("Head") end
    if Head and Head:IsA("BasePart") then
        local HeadCFrame, HeadSize = Shared.GetPlayerESPVisualPartGeometry(Head)
        if typeof(HeadCFrame) == "CFrame" then
            local HeadWorld = HeadCFrame.Position
            if typeof(HeadSize) == "Vector3" then HeadWorld += HeadCFrame.UpVector * (HeadSize.Y * 0.15) end
            local HeadScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, HeadWorld)
            if HeadScreen.Z > 0.05 then Head2D = NewVector2(HeadScreen.X, HeadScreen.Y) end
        end
    end
    Head2D = Head2D or NewVector2(Position.X + Size.X * 0.5, Position.Y + Size.Y * 0.12)
    local Feet2D = NewVector2(Position.X + Size.X * 0.5, Position.Y + Size.Y)
    return Position, Size, RootScreen, Head2D, Feet2D
end
function Shared.ProjectPlayerESPRobustBounds(CameraObject, Data)
    local Character = Data and Data.Character
    local Root = Data and Data.Root
    if not CameraObject or not Character or not Character.Parent or not Root or not Root.Parent then return nil end
    local Position, Size = Shared.ProjectPlayerESPLiveCharacterBounds(CameraObject, Data)
    if not Position or not Size then
        Position, Size = Shared.ProjectStaticPlayerESPBox(CameraObject, Root.Position)
        if not Position or not Size then return nil end
    end
    local Scale = Clamp(tonumber(Visuals.Player.BoxScale) or 0.96, 0.60, 1.50)
    local Padding = Clamp(tonumber(Visuals.Player.BoundingPadding) or 1.5, 0, 10)
    Position, Size = Shared.ScalePlayerESPBox(Position, Size, Scale, Padding)
    local RootScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, Root.Position)
    local CenterX = Position.X + Size.X * 0.5
    local Head2D
    local Head = Data.Head
    if not Head or not Head.Parent or not Head:IsA("BasePart") then
        Head = Character:FindFirstChild("Head")
        Data.Head = Head
    end
    if Head and Head:IsA("BasePart") then
        local HeadScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, Head.Position)
        if HeadScreen.Z > 0.03 then Head2D = NewVector2(HeadScreen.X, HeadScreen.Y) end
    end
    Head2D = Head2D or NewVector2(CenterX, Position.Y)
    local Feet2D = NewVector2(CenterX, Position.Y + Size.Y)
    if RootScreen.Z <= 0.03 then RootScreen = NewVector3(CenterX, Position.Y + Size.Y * 0.5, 1) end
    return Position, Size, RootScreen, Head2D, Feet2D
end

function GetPlayerFastBox(CameraObject, Data, RootPosition)
    if not CameraObject or not Data then return nil end
    local Root = Data.Root
    if not Root or not Root.Parent then return nil end
    RootPosition = typeof(RootPosition) == "Vector3" and RootPosition or Root.Position
    return Shared.ComputePlayerESPScreenBox(CameraObject, Data, RootPosition, Root.CFrame)
end

function GetPlayerBox(CameraObject, Data, Snapshot, LivePose)
    if not Data then return nil end
    if not Data.Character or not Data.Character.Parent or not Data.Root or not Data.Root.Parent then
        Shared.RefreshPlayerCharacter(Data, Data.Player and Data.Player.Character)
    end
    if not CameraObject or not Data.Character or not Data.Root or not Data.Root.Parent then return nil end
    return GetPlayerFastBox(CameraObject, Data, Data.Root.Position)
end

function SetLine(Line, From, To, Color, Visible, Thickness, Transparency)
    if not Line then return end
    Line.Visible = Visible
    if not Visible then return end
    Line.From = From
    Line.To = To
    Line.Color = Color if Thickness then Line.Thickness = Thickness end
    if Transparency then Line.Transparency = Transparency end
end
function Shared.ApplyCornerPair(Data, Index, X1, Y1, X2, Y2, Color, OutlineColor, Visible, BoxPosition, BoxSize)
    local From, To = NewVector2(X1, Y1), NewVector2(X2, Y2)
    local LineColor = Color
    if BoxGradientAffectsBox() and typeof(BoxPosition) == "Vector2" and typeof(BoxSize) == "Vector2" then
        LineColor = GetBoxGradientColor(GetBoxGradientAlpha(BoxPosition, BoxSize, (From + To) * 0.5))
    end
    local OutlineVisible = Visible and Visuals.Player.OutlineEnabled ~= false
    local OutlineOpacity = 1 - Clamp(tonumber(Visuals.Player.OutlineTransparency) or 0.05, 0, 0.95)
    local BoxOpacity = 1 - Clamp(tonumber(Visuals.Player.BoxTransparency) or 0, 0, 0.95)
    SetLine(Data.CornerOutlines[Index], From, To, OutlineColor, OutlineVisible, GetPlayerESPOutlineStrokeThickness(), OutlineOpacity)
    SetLine(Data.Corners[Index], From, To, LineColor, Visible, Max(tonumber(Visuals.Player.BoxThickness) or 1, 1), BoxOpacity)
end
function UpdateCornerBox(Data, Position, Size, Color, OutlineColor, Visible)
    if not Visible then
        if Data.CornersReady then
            for Index = 1, 8 do
                local Outline = Data.CornerOutlines[Index]
                local Corner = Data.Corners[Index]
                if Outline then Outline.Visible = false end
                if Corner then Corner.Visible = false end
            end
        end
        return
    end
    if not Shared.EnsureCornerBoxOverlay(Data) then return end
    local Width, Height = Size.X, Size.Y
    local Ratio = Clamp(tonumber(Visuals.Player.CornerLength) or 0.28, 0.10, 0.50)
    local CornerWidth = Max(Width * Ratio, 4)
    local CornerHeight = Max(Height * Ratio, 5)
    local X, Y = Position.X, Position.Y
    local Right, Bottom = X + Width, Y + Height
    Shared.ApplyCornerPair(Data, 1, X, Y, X + CornerWidth, Y, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 2, X, Y, X, Y + CornerHeight, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 3, Right, Y, Right - CornerWidth, Y, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 4, Right, Y, Right, Y + CornerHeight, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 5, X, Bottom, X + CornerWidth, Bottom, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 6, X, Bottom, X, Bottom - CornerHeight, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 7, Right, Bottom, Right - CornerWidth, Bottom, Color, OutlineColor, Visible, Position, Size)
    Shared.ApplyCornerPair(Data, 8, Right, Bottom, Right, Bottom - CornerHeight, Color, OutlineColor, Visible, Position, Size)
end
function Shared.GetTracerOrigin(ViewportSize)
    local Origin = Visuals.Player.TracerOrigin
    if Origin == "Top" then return NewVector2(ViewportSize.X * 0.5, 2) end
    if Origin == "Center" then return NewVector2(ViewportSize.X * 0.5, ViewportSize.Y * 0.5) end
    return NewVector2(ViewportSize.X * 0.5, ViewportSize.Y - 2)
end
function Shared.GetTracerEnd(Position, Size, RootScreen, HeadScreen, FeetScreen)
    local EndMode = Visuals.Player.TracerEnd
    if EndMode == "Head" then return HeadScreen end
    if EndMode == "Body" then return NewVector2(RootScreen.X, Position.Y + Size.Y * 0.52) end
    return FeetScreen
end
function Shared.QuadraticBezier(StartPoint, ControlPoint, EndPoint, Alpha)
    local Inverse = 1 - Alpha
    return StartPoint * (Inverse * Inverse) + ControlPoint * (2 * Inverse * Alpha) + EndPoint * (Alpha * Alpha)
end
function UpdateTracer(Data, ViewportSize, Position, Size, RootScreen, HeadScreen, FeetScreen, ColorOverride)
    local OverlayPrimitives = Data.OverlayPrimitives
    if not Visuals.Player.Tracers then
        Shared.HideTracerOverlay(Data)
        return
    end
    EnsureTracerOverlay(Data)
    Data.TracerOverlayHidden = false
    local From = Shared.GetTracerOrigin(ViewportSize) local To = Shared.GetTracerEnd(Position, Size, RootScreen, HeadScreen, FeetScreen)
    local Color = typeof(ColorOverride) == "Color3" and ColorOverride or Visuals.Player.TracerColor local Thickness = Visuals.Player.TracerThickness local Transparency = 1 - Visuals.Player.TracerTransparency
    if Visuals.Player.TracerStyle == "Straight" then
        SetLine(OverlayPrimitives.Tracer, From, To, Color, true, Thickness, Transparency)
        for Index = 1, 10 do
            local Segment = OverlayPrimitives["TracerCurve" .. Index]
            if Segment then Segment.Visible = false end
        end
        return
    end
    if OverlayPrimitives.Tracer then OverlayPrimitives.Tracer.Visible = false end
    Shared.EnsureCurvedTracerOverlay(Data)
    local Delta = To - From local Direction = Delta.X >= 0 and 1 or -1
    local Control = NewVector2(From.X + Delta.X * 0.46 + Direction * Min(Abs(Delta.Y) * 0.12, 90), From.Y + Delta.Y * 0.42) local Previous = From
    for Index = 1, 10 do
        local T = Index / 10 local Current = Shared.QuadraticBezier(From, Control, To, T)
        SetLine(OverlayPrimitives["TracerCurve" .. Index], Previous, Current, Color, true, Thickness, Transparency)
        Previous = Current
    end
end
function HideTargetSnapline()
    local State = Visuals.Snapline
    if State.Line then State.Line.Visible = false end
    for _, Segment in ipairs(State.Curve) do
        if Segment then Segment.Visible = false end
    end
end
function EnsureTargetSnaplineOverlay()
    local State = Visuals.Snapline
    if not State.Line then
        State.Line = Shared.CreateOverlayPrimitive("Line", {Visible = false, Thickness = State.Thickness, Transparency = 1 - State.Transparency, Color = State.Color, ZIndex = 8})
    end
    if #State.Curve == 0 then
        for Index = 1, 12 do
            State.Curve[Index] = Shared.CreateOverlayPrimitive("Line", {Visible = false, Thickness = State.Thickness, Transparency = 1 - State.Transparency,
                Color = State.Color, ZIndex = 8})
        end
    end
end
function IsTargetSnaplinePlayerValid(Player)
    if not Player or Player == LocalPlayer or not Player.Parent then return false end
    local Data = Visuals.Player.Objects[Player] local Character = Data and Data.Character or Player.Character
    local Humanoid = Data and Data.Humanoid or Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Data and Data.Root or Character and Character:FindFirstChild("HumanoidRootPart")
    if Data then
        if not Shared.IsPlayerESPRenderable(Data, Clock()) then return false end
    elseif not Character or not Humanoid or not Root or not Character.Parent or not Humanoid.Parent or not Root.Parent then
        return false
    end
    if Visuals.Player.TeamCheck and LocalPlayer.Team and Player.Team == LocalPlayer.Team then return false end
    local CameraObject = Shared.GetCamera()
    local CameraCFrame = CameraObject and Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    local ViewOrigin = typeof(CameraCFrame) == "CFrame" and CameraCFrame.Position or CameraObject and CameraObject.CFrame.Position
    if ViewOrigin and (Root.Position - ViewOrigin).Magnitude > Visuals.Player.MaxDistance then return false end
    return true
end
function GetClosestSnaplinePlayerToCursor()
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return nil end
    local MousePosition = UserInputService:GetMouseLocation() local BestPlayer = nil local BestDistance = Infinite local List = Visuals.Player.List
    for Index = 1, #List do
        local Data = List[Index] local Player = Data and Data.Player
        if Player and IsTargetSnaplinePlayerValid(Player) then
            local Character = Data.Character or Player.Character
            local Part = Data.Head or Data.Root or Character and (Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart"))
            if Part then
                local ScreenPosition, OnScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, Part.Position)
                if OnScreen and ScreenPosition.Z > 0 then
                    local Distance = (NewVector2(ScreenPosition.X, ScreenPosition.Y) - MousePosition).Magnitude
                    if Distance < BestDistance then
                        BestDistance = Distance
                        BestPlayer = Player
                    end
                end
            end
        end
    end
    return BestPlayer
end
function GetTargetSnaplinePlayer()
    local State = Visuals.Snapline
    if State.Source == "Closest to Cursor" then return GetClosestSnaplinePlayerToCursor() end
    if Ragebot.Enabled and IsTargetSnaplinePlayerValid(Ragebot.CurrentTarget) then return Ragebot.CurrentTarget end
    local AimTarget = AtramentaConfig and AtramentaConfig.Aim and (AtramentaConfig.Aim.CurrentTarget or AtramentaConfig.Aim.AimbotLockedTarget or AtramentaConfig.Aim.SilentAimLockedTarget)
    if AtramentaConfig and AtramentaConfig.Aim and AtramentaConfig.Aim.Enabled and IsTargetSnaplinePlayerValid(AimTarget) then return AimTarget end
    return nil
end
function GetTargetSnaplineWorldPosition(Character)
    if not Character then return nil end
    local TargetPart = Visuals.Snapline.TargetPart
    if TargetPart == "Head" then
        local Head = Character:FindFirstChild("Head")
        return Head and Head.Position or nil
    end
    if TargetPart == "Body" then
        local Body = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso")
        return Body and Body.Position or nil
    end
    local Root = Character:FindFirstChild("HumanoidRootPart") local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Root then return nil end
    return Root.Position - NewVector3(0, Humanoid and Humanoid.HipHeight + 1.7 or 3.2, 0)
end
function UpdateTargetSnapline()
    local State = Visuals.Snapline
    if not State.Enabled then
        HideTargetSnapline()
        return
    end
    EnsureTargetSnaplineOverlay()
    local CameraObject = Shared.GetCamera() local Target = GetTargetSnaplinePlayer()
    local Character = Target and Target.Character local WorldPosition = GetTargetSnaplineWorldPosition(Character)
    if not CameraObject or not WorldPosition then
        HideTargetSnapline()
        return
    end
    local ScreenPosition, OnScreen = Shared.PlayerESPWorldToViewportPoint(CameraObject, WorldPosition)
    if not OnScreen or ScreenPosition.Z <= 0 then
        HideTargetSnapline()
        return
    end
    local From = UserInputService:GetMouseLocation() local To = NewVector2(ScreenPosition.X, ScreenPosition.Y) local Transparency = 1 - Clamp(State.Transparency, 0, 1)
    if State.Style == "Straight" then
        SetLine(State.Line, From, To, State.Color, true, State.Thickness, Transparency)
        for _, Segment in ipairs(State.Curve) do
            if Segment then Segment.Visible = false end
        end
        return
    end
    if State.Line then State.Line.Visible = false end
    local Delta = To - From local Direction = Delta.X >= 0 and 1 or -1
    local Control = NewVector2(From.X + Delta.X * 0.5 + Direction * Min(Abs(Delta.Y) * 0.18, 80), From.Y + Delta.Y * 0.42)
    local Previous = From
    for Index = 1, 12 do
        local Current = Shared.QuadraticBezier(From, Control, To, Index / 12)
        SetLine(State.Curve[Index], Previous, Current, State.Color, true, State.Thickness, Transparency)
        Previous = Current
    end
end
function Shared.IsPlayerESPRenderable(Data, CurrentTime)
    if not Data then return false end
    local Character = Data.Character
    local Humanoid = Data.Humanoid
    local Root = Data.Root
    if not Character or not Character.Parent or not Humanoid or not Humanoid.Parent or not Root or not Root.Parent then return false end
    if Data.Player and Data.Player.Parent ~= Players then return false end
    return true
end

function Shared.ShouldRenderPlayer(Data, LocalRoot, HasEnemyTargets, Snapshot)
    if not Shared.IsPlayerESPRenderable(Data, Clock()) then return false end
    if HasEnemyTargets == true and EnemyTable[Data.Player] ~= true then return false end
    if Visuals.Player.TeamCheck and LocalPlayer.Team and Data.Player.Team == LocalPlayer.Team then return false end
    Snapshot = type(Snapshot) == "table" and Snapshot or Shared.GetPlayerVisualResolverSnapshot(Data, Clock(), Visuals.Player.UpdateInterval)
    local TargetRootPosition = Snapshot and ResolverReadVector(Snapshot.ResolvedRootPosition) and Snapshot.ResolvedRootPosition or Data.Root.Position
    local CameraObject = Shared.GetCamera()
    local CameraCFrame = CameraObject and Shared.GetStablePlayerESPCameraCFrame(CameraObject)
    local ViewOrigin = typeof(CameraCFrame) == "CFrame" and CameraCFrame.Position or CameraObject and CameraObject.CFrame.Position
    if not ViewOrigin then return false end
    local ViewDelta = TargetRootPosition - ViewOrigin
    local ViewDistanceSquared = ViewDelta:Dot(ViewDelta)
    local MaximumDistance = Max(tonumber(Visuals.Player.MaxDistance) or 1200, 1)
    if ViewDistanceSquared > MaximumDistance * MaximumDistance then return false end
    local DisplayDistance = LocalRoot and LocalRoot.Parent and (TargetRootPosition - LocalRoot.Position).Magnitude or Sqrt(ViewDistanceSquared)
    return true, DisplayDistance
end
