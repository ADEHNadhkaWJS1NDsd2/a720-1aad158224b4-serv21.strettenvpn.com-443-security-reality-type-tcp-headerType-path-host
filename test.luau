AimbotHitboxDefinitions = {{Name="Head", Parts={"Head"}}, {Name="Chest", Parts={"UpperTorso","Torso"}}, {Name="Stomach", Parts={"LowerTorso","Torso","HumanoidRootPart"}},
    {Name="Root", Parts={"HumanoidRootPart"}}, {Name="Left Arm", Parts={"LeftUpperArm","LeftLowerArm","LeftHand","Left Arm"}}, {Name="Right Arm", Parts={"RightUpperArm","RightLowerArm","RightHand","Right Arm"}},
    {Name="Left Leg", Parts={"LeftUpperLeg","LeftLowerLeg","LeftFoot","Left Leg"}}, {Name="Right Leg", Parts={"RightUpperLeg","RightLowerLeg","RightFoot","Right Leg"}}}
AimbotHitboxLookup={}
for Index=1, #AimbotHitboxDefinitions do local Definition=AimbotHitboxDefinitions[Index] AimbotHitboxLookup[Definition.Name]=Definition end
function NormalizeAimbotHitboxes(Value)
    local Output, Seen={}, {}
    local function AddHitboxName(Name) Name=tostring(Name or "") if Name~="" and AimbotHitboxLookup[Name] and not Seen[Name] then Seen[Name]=true Output[#Output+1]=Name end end
    if type(Value)=="string" then AddHitboxName(Value) elseif type(Value)=="table" then for Index=1, #Value do AddHitboxName(Value[Index]) end for Name, Enabled in pairs(Value) do if type(Name)=="string" and Enabled==true then AddHitboxName(Name) end end end
    if #Output==0 then Output[1]="Head" end return Output
end
function GetAimbotHitboxCandidates(Character)
    if not Character then return {} end
    local Selected = AtramentaConfig.Aim.AimbotHitboxes
    local NeedsNormalize = type(Selected) ~= "table" or #Selected == 0
    if not NeedsNormalize then
        for Index = 1, #Selected do
            if not AimbotHitboxLookup[tostring(Selected[Index] or "")] then NeedsNormalize = true break end
        end
    end
    if NeedsNormalize then
        Selected = NormalizeAimbotHitboxes(Selected)
        AtramentaConfig.Aim.AimbotHitboxes = Selected
    end
    local Candidates, SeenParts={}, {}
    for GroupIndex=1, #Selected do
        local Definition=AimbotHitboxLookup[Selected[GroupIndex]]
        if Definition then for PartIndex=1, #Definition.Parts do local Part=Character:FindFirstChild(Definition.Parts[PartIndex]) if Part and Part:IsA("BasePart") and not SeenParts[Part] then SeenParts[Part]=true Candidates[#Candidates+1]={Part=Part, Group=Definition.Name, Priority=GroupIndex} end end end
    end
    return Candidates
end
function GetAimTargetData(PlayerObject, TargetPartName)
    if not AtramentaConfig.Aim.Enabled or not IsCombatTargetAllowed(PlayerObject) then return nil, nil end
    local Character = ResolveTrackedCharacter(PlayerObject, PlayerObject.Character) or PlayerObject.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid") local HumanoidRootPart = ResolverGetRootPart(Character)
    if not Character or not Humanoid or not HumanoidRootPart then return nil, nil end
    if not CombatChecks.Passes(PlayerObject, Character, AtramentaConfig.Aim) then return nil, nil end
    local TargetPart
    if TargetPartName then
        TargetPartName=tostring(TargetPartName)
        if TargetPartName=="Head" and HeadHitbox.GetEnabled() then TargetPart=GetHeadHitboxPart(Character) end
        TargetPart=TargetPart or Character:FindFirstChild(TargetPartName)
    else
        local Candidates=GetAimbotHitboxCandidates(Character)
        TargetPart=Candidates[1] and Candidates[1].Part or nil
    end
    TargetPart=TargetPart or Character:FindFirstChild("Head") or HumanoidRootPart
    if not TargetPart or not TargetPart:IsA("BasePart") then return nil, nil end
    return Character, TargetPart
end
function IsAimTargetVisible(Character, TargetPosition)
    if AtramentaConfig.Aim.WallCheck ~= true then return true end
    if not Character or typeof(TargetPosition) ~= "Vector3" then return false end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return false end
    local PlayerObject = Shared.GetPlayerFromTrackedCharacter(Character)
    return CombatChecks.IsVisible(CameraObject.CFrame.Position, TargetPosition, PlayerObject, Character)
end
function IsAimbotTargetAlive(PlayerObject)
    if not AtramentaConfig.Aim.Enabled or not IsCombatTargetAllowed(PlayerObject) then return false end
    local Character = ResolveTrackedCharacter(PlayerObject, PlayerObject and PlayerObject.Character) or (PlayerObject and PlayerObject.Character)
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    return Character ~= nil and Humanoid ~= nil and Humanoid.Health > 0 and CombatChecks.Passes(PlayerObject, Character, AtramentaConfig.Aim)
end
function GetAimTargetScore(PlayerObject, PreferredPart, IgnoreFOV)
    local Character = ResolveTrackedCharacter(PlayerObject, PlayerObject and PlayerObject.Character) or (PlayerObject and PlayerObject.Character)
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if not AtramentaConfig.Aim.Enabled or not IsCombatTargetAllowed(PlayerObject) or not Character or not Humanoid or Humanoid.Health <= 0
        or not CombatChecks.Passes(PlayerObject, Character, AtramentaConfig.Aim) then
        return nil
    end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return nil end
    local Anchor, UseScreenCoordinates = GetAimFOVAnchorPosition("Aimbot")
    local Radius = Max(tonumber(AtramentaConfig.Aim.FOV) or 100, 1)
    local Candidates = GetAimbotHitboxCandidates(Character)
    local Mode = tostring(AtramentaConfig.Aim.AimbotHitboxMode or "Priority")
    if Mode ~= "Closest" then Mode = "Priority" end
    local CameraPosition = CameraObject.CFrame.Position
    local CameraLook = CameraObject.CFrame.LookVector
    local Best
    local Second
    local function Better(FirstCandidate, SecondCandidate)
        if not FirstCandidate then return false end
        if not SecondCandidate then return true end
        if Mode == "Priority" and FirstCandidate.Priority ~= SecondCandidate.Priority then
            return FirstCandidate.Priority < SecondCandidate.Priority
        end
        if Abs(FirstCandidate.Distance - SecondCandidate.Distance) > 0.5 then
            return FirstCandidate.Distance < SecondCandidate.Distance
        end
        return FirstCandidate.Dot > SecondCandidate.Dot
    end
    local function Push(Entry)
        if Better(Entry, Best) then
            Second = Best
            Best = Entry
        elseif Better(Entry, Second) then
            Second = Entry
        end
    end
    for Index = 1, #Candidates do
        local Candidate = Candidates[Index]
        local Part = Candidate.Part
        if Part and Part:IsA("BasePart") and Part:IsDescendantOf(Character) then
            local WorldPoint = Part.Position
            local Screen, OnScreen
            if UseScreenCoordinates then
                Screen, OnScreen = CameraObject:WorldToScreenPoint(WorldPoint)
            else
                Screen, OnScreen = CameraObject:WorldToViewportPoint(WorldPoint)
            end
            if OnScreen and Screen.Z > 0 then
                local DX = Anchor.X - Screen.X
                local DY = Anchor.Y - Screen.Y
                local ScreenDistance = Sqrt(DX * DX + DY * DY)
                if IgnoreFOV == true or ScreenDistance <= Radius then
                    local Delta = WorldPoint - CameraPosition
                    local Magnitude = Delta.Magnitude
                    if Magnitude > 0.001 then
                        local Dot = CameraLook:Dot(Delta / Magnitude)
                        local Sticky = PreferredPart == Part and 2.5 or 0
                        Push({Distance = Max(ScreenDistance - Sticky, 0), RawDistance = ScreenDistance, Dot = Dot, Part = Part, Priority = Candidate.Priority or Index})
                    end
                end
            end
        end
    end
    local Chosen = Best
    if AtramentaConfig.Aim.WallCheck == true and Chosen then
        if not IsAimTargetVisible(Character, Chosen.Part.Position) then
            Chosen = Second
            if Chosen and not IsAimTargetVisible(Character, Chosen.Part.Position) then Chosen = nil end
        end
    end
    return Chosen and Chosen.RawDistance or nil, Character, Chosen and Chosen.Part or nil
end
function GetClosestPlayer()
    if not AtramentaConfig.Aim.Enabled then return nil end
    local Aim = AtramentaConfig.Aim
    Aim.TargetScanFrame = (tonumber(Aim.TargetScanFrame) or 0) + 1
    local Current = Aim.CurrentTarget
    local CurrentPart = Aim.AimbotCurrentPart
    if Current and Aim.TargetScanFrame % 4 ~= 0 then
        if IsAimbotTargetAlive(Current) then
            return Current
        end
        Current = nil
        Aim.CurrentTarget = nil
    elseif not Current and Aim.TargetScanFrame % 2 ~= 0 then
        return Aim.CachedScanTarget
    end
    local CurrentDistance
    local CurrentCharacter
    local CurrentResolvedPart
    if Current then
        CurrentDistance, CurrentCharacter, CurrentResolvedPart = GetAimTargetScore(Current, CurrentPart, false)
        if CurrentDistance and CurrentResolvedPart then Aim.AimbotCurrentPart = CurrentResolvedPart end
    end
    local Best
    local BestCharacter
    local BestPart
    local BestDistance = Infinite
    local BestTier = -1
    local PlayerList = Players:GetPlayers()
    for Index = 1, #PlayerList do
        local PlayerObject = PlayerList[Index]
        if PlayerObject ~= LocalPlayer then
            local Distance
            local CandidateCharacter
            local Part
            if PlayerObject == Current then
                Distance = CurrentDistance
                CandidateCharacter = CurrentCharacter
                Part = CurrentResolvedPart
            else
                Distance, CandidateCharacter, Part = GetAimTargetScore(PlayerObject, nil, false)
            end
            if Distance then
                local Tier = GetCombatTargetPriority(PlayerObject)
                if Tier > BestTier or Tier == BestTier and Distance < BestDistance then
                    Best = PlayerObject
                    BestCharacter = CandidateCharacter
                    BestPart = Part
                    BestDistance = Distance
                    BestTier = Tier
                end
            end
        end
    end
    if CurrentDistance and Current then
        if Best and Best ~= Current then
            local SwitchDelay = Clamp(tonumber(Aim.AimbotSwitchDelay) or 0.22, 0, 1)
            local Now = Clock()
            if SwitchDelay > 0 then
                if Aim.AimbotSwitchTarget ~= Best then
                    Aim.AimbotSwitchTarget = Best
                    Aim.AimbotSwitchSince = Now
                end
                if Now - (tonumber(Aim.AimbotSwitchSince) or Now) < SwitchDelay then
                    Best = Current
                    BestCharacter = CurrentCharacter
                    BestPart = CurrentResolvedPart or CurrentPart
                    BestDistance = CurrentDistance
                else
                    Aim.AimbotSwitchTarget = nil
                    Aim.AimbotSwitchSince = 0
                end
            else
                Aim.AimbotSwitchTarget = nil
                Aim.AimbotSwitchSince = 0
            end
        else
            Aim.AimbotSwitchTarget = nil
            Aim.AimbotSwitchSince = 0
            Best = Current
            BestCharacter = CurrentCharacter
            BestPart = CurrentResolvedPart or CurrentPart
            BestDistance = CurrentDistance
        end
    else
        Aim.AimbotSwitchTarget = nil
        Aim.AimbotSwitchSince = 0
    end
    if Best ~= Aim.CurrentTarget then
        Aim.AimbotCurrentPart = BestPart
        Aim.PositionCacheCharacter = nil
        ResetAimSmooth()
    elseif BestPart then
        Aim.AimbotCurrentPart = BestPart
    end
    Aim.CachedScanTarget = Best
    Aim.CachedScanCharacter = BestCharacter
    Aim.CachedScanPart = BestPart
    Aim.CachedScanDistance = Best ~= nil and BestDistance or nil
    return Best
end
function NormalizePredictionMode(Value)
    return tostring(Value) == "Ping" and "Ping" or "Manual"
end

function NormalizePredictionSettings()
    if AtramentaConfig and AtramentaConfig.Aim then
        AtramentaConfig.Aim.AimbotPredictionMode = NormalizePredictionMode(AtramentaConfig.Aim.AimbotPredictionMode)
        AtramentaConfig.Aim.SilentPredictionMode = NormalizePredictionMode(AtramentaConfig.Aim.SilentPredictionMode)
    end
    if Ragebot and Ragebot.Settings then Ragebot.Settings.PredictionMode = NormalizePredictionMode(Ragebot.Settings.PredictionMode) end
end

function GetPredSettings(AimMode)
    local Aim = AtramentaConfig.Aim
    if AimMode == "Silent Aim" then
        return {Enabled = Aim.SilentPredictionEnabled == true, Mode = NormalizePredictionMode(Aim.SilentPredictionMode), Time = Aim.SilentPrediction, Resolver =
                Aim.SilentResolver == true}
    end
    return {Enabled = Aim.AimbotPredictionEnabled == true, Mode = NormalizePredictionMode(Aim.AimbotPredictionMode), Time = Aim.AimbotPrediction, Resolver =
            Aim.AimbotResolver == true}
end

function GetPredTime(Settings)
    if type(Settings) ~= "table" or Settings.Enabled ~= true then
        return 0
    end
    local Mode = NormalizePredictionMode(Settings.Mode)
    if Mode == "Ping" then
        return Clamp(type(ResolverGetPing) == "function" and ResolverGetPing() or 0, 0, 0.45)
    end
    return Clamp((tonumber(Settings.Time) or 0) / 1000, 0, 0.45)
end

function GetPredictedPoint(PlayerObject, CharacterObject, TargetPart, AimMode)
    if not CharacterObject or not TargetPart or not TargetPart:IsA("BasePart") then
        return nil, nil, false, 0
    end
    local Settings = GetPredSettings(AimMode)
    local BasePosition, Snapshot, PartSuspicious = ResolverGetAimPosition(PlayerObject, CharacterObject, TargetPart, Settings.Resolver)
    BasePosition = BasePosition or TargetPart.Position
    local PredictionTime = GetPredTime(Settings)
    if PredictionTime <= 0 then
        return BasePosition, BasePosition, PartSuspicious, 0, Snapshot
    end
    local PositionValue, ResolverData, _, EffectiveTime = ResolveCombatPosition(PlayerObject, CharacterObject, TargetPart, PredictionTime, AtramentaConfig.Aim, {
                ResolverEnabled = Settings.Resolver})
    EffectiveTime = tonumber(EffectiveTime) or PredictionTime
    if typeof(PositionValue) ~= "Vector3" then
        local Velocity = type(ResolverGetMovementVelocity) == "function" and select(1, ResolverGetMovementVelocity(PlayerObject, CharacterObject, AtramentaConfig.Aim)) or TargetPart.AssemblyLinearVelocity
        if typeof(Velocity) ~= "Vector3" then Velocity = EmptyVector3 end
        PositionValue = BasePosition + Velocity * PredictionTime
    end
    if AimMode == "Aimbot" and type(GetCriminologyProjectileProfile) == "function" and type(SolveCriminologyProjectileIntercept) == "function" then
        local Character = LocalPlayer.Character
        local Tool = Character and Character:FindFirstChildOfClass("Tool")
        local Profile = Tool and GetCriminologyProjectileProfile(Tool) or nil
        if type(Profile) == "table" and Profile.IsProjectile == true then
            local CameraObject = Shared.GetCamera()
            local Origin = CameraObject and CameraObject.CFrame.Position or nil
            local Velocity = type(ResolverGetMovementVelocity) == "function" and select(1, ResolverGetMovementVelocity(PlayerObject, CharacterObject, AtramentaConfig.Aim)) or TargetPart.AssemblyLinearVelocity
            if typeof(Origin) == "Vector3" and typeof(Velocity) == "Vector3" then
                local Solution = SolveCriminologyProjectileIntercept(Origin, BasePosition, Velocity, Profile.Speed, Profile.Gravity)
                if type(Solution) == "table" and typeof(Solution.AimPosition)
                        == "Vector3" then
                    PositionValue = Solution.AimPosition
                end
            end
        end
    end
    return PositionValue, BasePosition, PartSuspicious, EffectiveTime, Snapshot or ResolverData
end
function GetClosestAimPointOnPart(Part, AimMode)
    if not Part or not Part:IsA("BasePart") then return nil end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return Part.Position end
    local Anchor, UseScreenCoordinates = GetAimFOVAnchorPosition(AimMode)
    if typeof(Anchor) ~= "Vector2" then
        return Part.Position
    end
    local X = Anchor.X
    local Y = Anchor.Y
    if UseScreenCoordinates then
        local Inset = GuiService:GetGuiInset()
        X -= Inset.X
        Y -= Inset.Y
    end
    local Ray = CameraObject:ViewportPointToRay(X, Y)
    local Direction = Ray.Direction
    if Direction.Magnitude <= 0.001 then
        return Part.Position
    end
    Direction = Direction.Unit
    local Along = (Part.Position - Ray.Origin):Dot(Direction)
    local Probe = Ray.Origin + Direction * Max(Along, 0)
    local LocalPoint = Part.CFrame:PointToObjectSpace(Probe)
    local Half = Part.Size * 0.5
    local SafeInset = 0.015
    Half = NewVector3(Max(Half.X - SafeInset, 0.01), Max(Half.Y - SafeInset, 0.01), Max(Half.Z - SafeInset, 0.01))
    LocalPoint = NewVector3(Clamp(LocalPoint.X, -Half.X, Half.X), Clamp(LocalPoint.Y, -Half.Y, Half.Y), Clamp(LocalPoint.Z, -Half.Z, Half.Z))
    return Part.CFrame:PointToWorldSpace(LocalPoint)
end

function GetTargetPosition(CharacterObject, PlayerObject, AimMode, ExplicitPart)
    if not CharacterObject then return nil end
    local CurrentTime = Clock() local UseCache = true
    local UpdateInterval = Max(tonumber(AtramentaConfig.Aim.PositionUpdateInterval) or (1 / 90), 1 / 240)
    if UseCache and AtramentaConfig.Aim.PositionCacheCharacter == CharacterObject and AtramentaConfig.Aim.PositionCachePart == ExplicitPart and AtramentaConfig.Aim.PositionCacheValue and AtramentaConfig.Aim.PositionCacheMode == AimMode
        and CurrentTime - (AtramentaConfig.Aim.LastPositionUpdate or 0) < UpdateInterval then return AtramentaConfig.Aim.PositionCacheValue end
    local TargetPart = ExplicitPart
    if not TargetPart or not TargetPart:IsA("BasePart") or not TargetPart:IsDescendantOf(CharacterObject) then
        local Candidates = GetAimbotHitboxCandidates(CharacterObject)
        TargetPart = Candidates[1] and Candidates[1].Part or CharacterObject:FindFirstChild("Head") or CharacterObject:FindFirstChild("HumanoidRootPart")
    end
    if not TargetPart or not TargetPart:IsA("BasePart") then return nil end
    local PositionValue, BasePosition = GetPredictedPoint(PlayerObject, CharacterObject, TargetPart, AimMode)
    PositionValue = PositionValue or TargetPart.Position BasePosition = BasePosition or TargetPart.Position
    local PointMode = AimMode == "Silent Aim" and AtramentaConfig.Aim.SilentAimPoint or AtramentaConfig.Aim.AimbotAimPoint
    if PointMode == "Closest Point" then
        local ShotPoint
        if TargetPart.Name == "Head" and HeadHitbox.GetEnabled() then
            local CameraObject = Shared.GetCamera()
            local AnchorPosition, UseScreenCoordinates = GetAimFOVAnchorPosition(AimMode)
            ShotPoint = CameraObject and HeadHitbox.GetAimShotPoint(TargetPart, AnchorPosition, CameraObject, UseScreenCoordinates, nil, HeadHitbox.GetSizeValue())
                or TargetPart.Position
        else
            ShotPoint = GetClosestAimPointOnPart(TargetPart, AimMode) or TargetPart.Position
        end
        PositionValue = ShotPoint + (PositionValue - BasePosition)
    end
    if UseCache then
        AtramentaConfig.Aim.PositionCacheCharacter = CharacterObject AtramentaConfig.Aim.PositionCachePart = TargetPart AtramentaConfig.Aim.PositionCacheValue = PositionValue
        AtramentaConfig.Aim.PositionCacheMode = AimMode AtramentaConfig.Aim.LastPositionUpdate = CurrentTime
    end
    return PositionValue
end
AimSmoothState = AimSmoothState or {Target = nil, FilteredTarget = nil}
function ResetAimSmooth() AimSmoothState.Target = nil AimSmoothState.FilteredTarget = nil end
function ClampAimStep(Value, Maximum)
    if Maximum <= 0 then return Value end
    return Clamp(Value, -Maximum, Maximum)
end
function SmoothAim(TargetPosition, DeltaTime, TargetPlayer)
    if typeof(TargetPosition) ~= "Vector3" then return end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return end
    local Aim = AtramentaConfig.Aim
    local Dt = Clamp(tonumber(DeltaTime) or 1 / 60, 1 / 240, 1 / 20)
    if AimSmoothState.Target ~= TargetPlayer then
        ResetAimSmooth()
        AimSmoothState.Target = TargetPlayer
        AimSmoothState.FilteredTarget = TargetPosition
    end
    local CurrentCFrame = CameraObject.CFrame
    local RawDelta = TargetPosition - CurrentCFrame.Position
    if RawDelta.Magnitude <= 0.001 then return end
    local TargetDistance = RawDelta.Magnitude
    local TargetSpeed = 0
    if TargetPlayer then
        local Character = ResolveTrackedCharacter(TargetPlayer, TargetPlayer.Character) or TargetPlayer.Character
        local Root = Character and ResolverGetRootPart(Character)
        local Velocity = Root and Root.AssemblyLinearVelocity
        if typeof(Velocity) == "Vector3" then TargetSpeed = NewVector3(Velocity.X, 0, Velocity.Z).Magnitude end
    end
    local BaseFilter = Clamp(tonumber(Aim.SmoothTargetFilter) or 22, 1, 80)
    local DistanceBoost = 1 + Clamp(TargetDistance / 900, 0, 1.5) * 0.55
    local MotionBoost = 1 + Clamp(TargetSpeed / 90, 0, 1) * 0.35
    local Filter = Clamp(BaseFilter * DistanceBoost * MotionBoost, 1, 120)
    local FilterAlpha = 1 - Exp(-Filter * Dt)
    AimSmoothState.FilteredTarget = typeof(AimSmoothState.FilteredTarget) == "Vector3" and AimSmoothState.FilteredTarget:Lerp(TargetPosition, FilterAlpha) or TargetPosition
    local TargetDelta = AimSmoothState.FilteredTarget - CurrentCFrame.Position
    if TargetDelta.Magnitude <= 0.001 then return end
    local Mode = tostring(Aim.SmoothMode or "Exponential")
    local CurrentDirection = CurrentCFrame.LookVector.Unit
    local TargetDirection = TargetDelta.Unit
    if Aim.SmoothEnabled ~= true or Mode == "Instant" then
        CameraObject.CFrame = LookAt(CurrentCFrame.Position, CurrentCFrame.Position + TargetDirection)
        return
    end
    local CurrentYaw = Atan2(-CurrentDirection.X, -CurrentDirection.Z)
    local TargetYaw = Atan2(-TargetDirection.X, -TargetDirection.Z)
    local CurrentPitch = Asin(Clamp(CurrentDirection.Y, -1, 1))
    local TargetPitch = Asin(Clamp(TargetDirection.Y, -1, 1))
    local YawDelta = Atan2(Sin(TargetYaw - CurrentYaw), Cos(TargetYaw - CurrentYaw))
    local PitchDelta = TargetPitch - CurrentPitch
    local SpeedX = Clamp(tonumber(Aim.SmoothSpeedX) or 9, 0.1, 60)
    local SpeedY = Clamp(tonumber(Aim.SmoothSpeedY) or 9, 0.1, 60)
    local RangeBoost = 1 + Clamp(TargetDistance / 1400, 0, 1) * 0.28
    local MaxStep = Rad(Clamp(tonumber(Aim.SmoothMaxSpeed) or 480, 30, 2880)) * Dt * RangeBoost
    local YawStep
    local PitchStep
    if Mode == "Linear" then
        YawStep = ClampAimStep(YawDelta, MaxStep)
        PitchStep = ClampAimStep(PitchDelta, MaxStep)
    else
        local AlphaX = 1 - Exp(-SpeedX * DistanceBoost * Dt)
        local AlphaY = 1 - Exp(-SpeedY * DistanceBoost * Dt)
        YawStep = ClampAimStep(YawDelta * AlphaX, MaxStep)
        PitchStep = ClampAimStep(PitchDelta * AlphaY, MaxStep)
    end
    local NewYaw = CurrentYaw + YawStep
    local NewPitch = Clamp(CurrentPitch + PitchStep, Rad(-89.9), Rad(89.9))
    local CosPitch = Cos(NewPitch)
    local Direction = NewVector3(-Sin(NewYaw) * CosPitch, Sin(NewPitch), -Cos(NewYaw) * CosPitch)
    CameraObject.CFrame = LookAt(CurrentCFrame.Position, CurrentCFrame.Position + Direction)
end
function AimLoop(DeltaTime)
    local Aim = AtramentaConfig.Aim
    if not Aim.Enabled then return end
    Aim.EngineFrame = (tonumber(Aim.EngineFrame) or 0) + 1
    if not Aim.AimbotEnabled then
        Aim.AimActive = false
        ResetAimbotTargetLock()
        return
    end
    if not Aim.AimActive then return end
    local CurrentTarget
    local Character
    local TargetPart
    if Aim.AimbotLockTarget == true and Aim.AimbotLockedTarget then
        if IsAimbotTargetAlive(Aim.AimbotLockedTarget) then
            CurrentTarget = Aim.AimbotLockedTarget
            Character = ResolveTrackedCharacter(CurrentTarget, CurrentTarget.Character) or CurrentTarget.Character
            TargetPart = Aim.AimbotLockedPart
            local NeedValidation = not TargetPart or not TargetPart.Parent or not Character or not TargetPart:IsDescendantOf(Character) or Aim.EngineFrame % 3 == 0
            if NeedValidation then
                local _, ScoredCharacter, ScoredPart = GetAimTargetScore(CurrentTarget, TargetPart, true)
                Character = ScoredCharacter or Character
                TargetPart = ScoredPart or TargetPart
                if ScoredPart then
                    Aim.AimbotLockedPart = ScoredPart
                    Aim.AimbotCurrentPart = ScoredPart
                end
            end
        else
            ResetAimbotTargetLock()
        end
    end
    if not CurrentTarget then
        CurrentTarget = GetClosestPlayer()
        if CurrentTarget then
            if Aim.CachedScanTarget == CurrentTarget then
                Character = Aim.CachedScanCharacter
                TargetPart = Aim.CachedScanPart
            end
            if not Character or not TargetPart or not TargetPart.Parent then
                local _, ResolvedCharacter, ResolvedPart = GetAimTargetScore(CurrentTarget, Aim.AimbotCurrentPart, false)
                Character = ResolvedCharacter
                TargetPart = ResolvedPart
            end
            if TargetPart then Aim.AimbotCurrentPart = TargetPart end
            if Aim.AimbotLockTarget == true then
                Aim.AimbotLockedTarget = CurrentTarget
                Aim.AimbotLockedPart = TargetPart
            end
        end
    end
    Aim.CurrentTarget = CurrentTarget
    if not CurrentTarget then
        Aim.LastVisibilityTarget = nil
        return
    end
    Character = Character or ResolveTrackedCharacter(CurrentTarget, CurrentTarget.Character) or CurrentTarget.Character
    TargetPart = TargetPart or Aim.AimbotLockedPart or Aim.AimbotCurrentPart
    if not TargetPart or not TargetPart.Parent or not Character or not TargetPart:IsDescendantOf(Character) then
        local _, ResolvedCharacter, ResolvedPart = GetAimTargetScore(CurrentTarget, nil, Aim.AimbotLockTarget == true)
        Character = ResolvedCharacter or Character
        TargetPart = ResolvedPart
        Aim.AimbotCurrentPart = ResolvedPart
        if Aim.AimbotLockTarget == true and ResolvedPart then Aim.AimbotLockedPart = ResolvedPart end
    end
    if not Character or not TargetPart then return end
    local TargetPosition = GetTargetPosition(Character, CurrentTarget, "Aimbot", TargetPart)
    if typeof(TargetPosition) ~= "Vector3" then return end
    local Visible = true
    if Aim.WallCheck == true then
        local NeedVisibility = CurrentTarget ~= Aim.LastVisibilityTarget or TargetPart ~= Aim.LastVisibilityPart or Aim.EngineFrame % 2 == 0
        if NeedVisibility then
            Aim.LastVisibilityTarget = CurrentTarget
            Aim.LastVisibilityPart = TargetPart
            Aim.LastVisibilityResult = IsAimTargetVisible(Character, TargetPosition) == true
        end
        Visible = Aim.LastVisibilityResult == true
    end
    if Visible then SmoothAim(TargetPosition, DeltaTime, CurrentTarget) end
end

function AimEngineStep(DeltaTime)
    if AtramentaConfig.Aim.ShowFOV == true then Shared.SafeCall(UpdateFOVCircle) end
    Shared.SafeCall(AimLoop, DeltaTime)
end
function FindCriminologyProjectileNumber(Container, Wanted, Depth, Seen)
    if type(Container) ~= "table" or Depth > 3 then return nil, nil end
    Seen = Seen or {}
    if Seen[Container] then return nil, nil end
    Seen[Container] = true
    local BestValue local BestScore = -Infinite local BestName
    for Key, Value in pairs(Container) do
        local Name = Lower(tostring(Key))
        if type(Value) == "number" and Value == Value then
            local Score = -Infinite
            if Wanted == "Speed" then
                if StringFind(Name, "projectilespeed", 1, true) then
                    Score = 100
                elseif StringFind(Name, "muzzlevelocity", 1, true) then
                    Score = 96
                elseif StringFind(Name, "bulletvelocity", 1, true) then
                    Score = 94
                elseif StringFind(Name, "launchvelocity", 1, true) then
                    Score = 92
                elseif StringFind(Name, "rocketspeed", 1, true) then
                    Score = 90
                elseif StringFind(Name, "travelspeed", 1, true) then
                    Score = 88
                elseif StringFind(Name, "velocity", 1, true) then
                    Score = 72
                elseif StringFind(Name, "speed", 1, true) and not StringFind(Name, "reload", 1, true) and not StringFind(Name, "equip", 1, true)
                    and not StringFind(Name, "walk", 1, true) and not StringFind(Name, "anim", 1, true) and not StringFind(Name, "fire", 1, true) then
                    Score = 52
                end
                if Value < 8 or Value > 3000 then Score = -Infinite end
            else
                if StringFind(Name, "projectilegravity", 1, true) then
                    Score = 100
                elseif StringFind(Name, "gravity", 1, true) then
                    Score = 85
                elseif StringFind(Name, "drop", 1, true) then
                    Score = 65
                end
                if Value < 0 or Value > 1000 then Score = -Infinite end
            end
            if Score > BestScore then
                BestScore = Score
                BestValue = Value
                BestName = Name
            end
        elseif type(Value) == "table" then
            local Nested, NestedName = FindCriminologyProjectileNumber(Value, Wanted, Depth + 1, Seen)
            if Nested ~= nil then
                local NestedScore = 45
                if NestedScore > BestScore then
                    BestScore = NestedScore
                    BestValue = Nested
                    BestName = NestedName
                end
            end
        end
    end
    return BestValue, BestName
end
function GetCriminologyProjectileInstanceNumber(Tool, Wanted)
    if not Tool then return nil, nil end
    local BestValue local BestScore = -Infinite local BestName
    local function Test(Name, Value)
        Value = tonumber(Value)
        if not Value then return end
        local LowerName = Lower(tostring(Name))
        local Score = -Infinite
        if Wanted == "Speed" then
            if StringFind(LowerName, "projectilespeed", 1, true) or StringFind(LowerName, "muzzlevelocity", 1, true) or StringFind(LowerName, "bulletvelocity", 1, true) then
                Score = 100
            elseif StringFind(LowerName, "velocity", 1, true) then
                Score = 80
            elseif StringFind(LowerName, "speed", 1, true) and not StringFind(LowerName, "fire", 1, true) then
                Score = 60
            end
            if Value < 8 or Value > 3000 then Score = -Infinite end
        else
            if StringFind(LowerName, "gravity", 1, true) then
                Score = 100
            elseif StringFind(LowerName, "drop", 1, true) then
                Score = 70
            end
            if Value < 0 or Value > 1000 then Score = -Infinite end
        end
        if Score > BestScore then
            BestScore = Score
            BestValue = Value
            BestName = LowerName
        end
    end
    local Attributes = Tool:GetAttributes()
    for Name, Value in pairs(Attributes) do
        Test(Name, Value)
    end
    local Values = Tool:FindFirstChild("Values")
    if Values then
        for _, Object in ipairs(Values:GetDescendants()) do
            if Object:IsA("NumberValue") or Object:IsA("IntValue") then Test(Object.Name, Object.Value) end
        end
    end
    return BestValue, BestName
end
function GetCriminologyProjectileProfile(Tool, SpeedHint)
    if not Tool or not Tool:IsA("Tool") then return {IsProjectile = false} end
    local Config = type(Ragebot.GetWeaponConfig) == "function" and Ragebot.GetWeaponConfig(Tool) or nil
    local ConfigSpeed, ConfigSpeedName = FindCriminologyProjectileNumber(Config, "Speed", 0, {})
    local ConfigGravity, ConfigGravityName = FindCriminologyProjectileNumber(Config, "Gravity", 0, {})
    local InstanceSpeed, InstanceSpeedName = GetCriminologyProjectileInstanceNumber(Tool, "Speed")
    local InstanceGravity, InstanceGravityName = GetCriminologyProjectileInstanceNumber(Tool, "Gravity")
    local CachedSpeed = tonumber(SilentAim.ProjectileSpeedCache[tostring(Tool.Name)])
    local DirectionSpeed = tonumber(SpeedHint)
    local Speed = CachedSpeed or tonumber(ConfigSpeed) or tonumber(InstanceSpeed)
    if DirectionSpeed and DirectionSpeed >= 8 and DirectionSpeed <= 3000 then Speed = DirectionSpeed end
    local ExplicitProjectile = false
    if type(Config) == "table" then
        local Hitscan = rawget(Config, "Hitscan")
        local Projectile = rawget(Config, "Projectile")
        local ProjectileType = rawget(Config, "ProjectileType")
        local ProjectileClass = rawget(Config, "ProjectileClass")
        if Hitscan == false or Projectile == true or type(Projectile) == "table" or ProjectileType ~= nil or ProjectileClass ~= nil then
            ExplicitProjectile = true
        elseif Hitscan == true then
            return {IsProjectile = false}
        end
    end
    local ProjectileAttribute = Tool:GetAttribute("Projectile")
    local HitscanAttribute = Tool:GetAttribute("Hitscan")
    if ProjectileAttribute == true then ExplicitProjectile = true end
    if HitscanAttribute == true then return {IsProjectile = false} end
    if not ExplicitProjectile or not Speed then return {IsProjectile = false} end
    local Gravity = tonumber(ConfigGravity) or tonumber(InstanceGravity)
    if Gravity == nil then return {IsProjectile = false} end
    if Gravity > 0 and Gravity <= 5 and ConfigGravityName and StringFind(ConfigGravityName, "gravity", 1, true) then Gravity = Workspace.Gravity * Gravity end
    local SpeedSource
    if DirectionSpeed and DirectionSpeed >= 8 and DirectionSpeed <= 3000 then
        SpeedSource = "direction"
    elseif CachedSpeed then
        SpeedSource = "observed"
    elseif ConfigSpeed then
        SpeedSource = "config:" .. tostring(ConfigSpeedName)
    else
        SpeedSource = "value:" .. tostring(InstanceSpeedName)
    end
    local GravitySource = ConfigGravity and ("config:" .. tostring(ConfigGravityName)) or ("value:" .. tostring(InstanceGravityName))
    local Profile = {IsProjectile = true, Speed = Clamp(tonumber(Speed), 8, 3000), Gravity = Clamp(tonumber(Gravity), 0, 1000), SpeedSource = SpeedSource,
        GravitySource = GravitySource}
    SilentAim.LastProjectileProfile = Profile
    return Profile
end
function GetCriminologyProjectileTargetVelocity(Data)
    if type(Data) ~= "table" then return EmptyVector3 end
    local Character = Data.TargetCharacter
    local PlayerObject = Data.TargetPlayer
    local Part = Data.TargetPart
    local Velocity
    if AtramentaConfig.Aim.SilentResolver == true and type(ResolverGetMovementVelocity) == "function" and PlayerObject and Character then
        local Resolved = ResolverGetMovementVelocity(PlayerObject, Character, AtramentaConfig.Aim)
        if typeof(Resolved) == "Vector3" then Velocity = Resolved end
    end
    if typeof(Velocity) ~= "Vector3" and Part and Part:IsA("BasePart") then Velocity = Part.AssemblyLinearVelocity end
    if typeof(Velocity) ~= "Vector3" then return EmptyVector3 end
    if Velocity.Magnitude > 220 then Velocity = Velocity.Unit * 220 end
    return Velocity
end
function SolveCriminologyProjectileIntercept(Origin, TargetPosition, TargetVelocity, Speed, Gravity)
    if typeof(Origin) ~= "Vector3" or typeof(TargetPosition) ~= "Vector3" or typeof(TargetVelocity) ~= "Vector3" then return nil end
    Speed = Max(tonumber(Speed) or 0, 0.001)
    Gravity = Max(tonumber(Gravity) or 0, 0)
    local Relative = TargetPosition - Origin
    local A = TargetVelocity:Dot(TargetVelocity) - Speed * Speed
    local B = 2 * Relative:Dot(TargetVelocity)
    local C = Relative:Dot(Relative)
    local Time
    if Abs(A) <= 0.000001 then
        if Abs(B) > 0.000001 then
            local Candidate = -C / B
            if Candidate > 0 then Time = Candidate end
        end
    else
        local Discriminant = B * B - 4 * A * C
        if Discriminant >= 0 then
            local Root = Sqrt(Discriminant)
            local First = (-B - Root) / (2 * A)
            local Second = (-B + Root) / (2 * A)
            if First > 0 and Second > 0 then
                Time = Min(First, Second)
            elseif First > 0 then
                Time = First
            elseif Second > 0 then
                Time = Second
            end
        end
    end
    if not Time then Time = Relative.Magnitude / Speed end
    Time = Clamp(Time, 0, 4)
    local AimPosition
    for _ = 1, 3 do
        AimPosition = TargetPosition + TargetVelocity * Time + NewVector3(0, Gravity * 0.5 * Time * Time, 0)
        local Delta = AimPosition - Origin
        if Delta.Magnitude <= 0.001 then return nil end
        Time = Clamp(Delta.Magnitude / Speed, 0, 4)
    end
    local Direction = AimPosition - Origin
    if Direction.Magnitude <= 0.001 then return nil end
    return {Direction = Direction.Unit, AimPosition = AimPosition, TravelTime = Time}
end
function InstallCriminologyProjectileObserver()
    local Existing = SilentAim.ProjectileConnection
    if typeof(Existing) == "RBXScriptConnection" and Existing.Connected then return end
    SilentAim.ProjectileConnection = nil
    SilentAim.ProjectileConnection = Workspace.DescendantAdded:Connect(function(Object)
                local Probe = SilentAim.LastProjectileProbe
                if type(Probe) ~= "table" or Clock() - (tonumber(Probe.Time) or 0) > 0.35 or typeof(Probe.Origin) ~= "Vector3" then
                    return
                end
                Defer(function()
                        if not Object or not Object.Parent then return end
                        local Part
                        if Object:IsA("BasePart") then
                            Part = Object
                        elseif Object:IsA("Model") then
                            Part = Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true)
                        end
                        if not Part or not Part:IsA("BasePart") then return end
                        local ObjectName = Lower(tostring(Object.Name) .. " " .. tostring(Object.Parent and Object.Parent.Name or ""))
                        local LooksProjectile = StringFind(ObjectName, "projectile", 1, true) or StringFind(ObjectName, "rocket", 1, true)
                            or StringFind(ObjectName, "missile", 1, true) or StringFind(ObjectName, "snow", 1, true) or StringFind(ObjectName, "grenade", 1, true)
                            or StringFind(ObjectName, "bullet", 1, true)
                        if not LooksProjectile then return end
                        local Distance = (Part.Position - Probe.Origin).Magnitude
                        if Distance > 28 then return end
                        local Velocity = Part.AssemblyLinearVelocity
                        local Speed = Velocity.Magnitude
                        if Speed < 8 or Speed > 3000 then return end
                        if typeof(Probe.Direction) == "Vector3" and Velocity.Magnitude > 0.001 and Velocity.Unit:Dot(Probe.Direction) < 0.25 then return end
                        local Key = tostring(Probe.ToolName or "")
