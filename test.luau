    local Minimum = Clamp(tonumber(AtramentaConfig.Aim.SilentRandomHitChanceMin) or 70, 0, 100)
    local Maximum = Clamp(tonumber(AtramentaConfig.Aim.SilentRandomHitChanceMax) or 100, 0, 100)
    if Minimum > Maximum then Minimum, Maximum = Maximum, Minimum end
    if Maximum <= Minimum then
        return Minimum
    end
