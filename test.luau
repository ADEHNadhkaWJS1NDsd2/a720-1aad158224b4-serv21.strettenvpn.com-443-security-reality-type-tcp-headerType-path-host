        local Registration = PartSuspicious and TargetPosition or GetCriminologySilentAimRayPartContact(Origin, Direction, Part) or GetCriminologySilentAimStablePoint(Part, TargetPosition) or TargetPosition
        return {Origin = Origin, Direction = Direction, TargetPosition = TargetPosition, RegistrationPosition = Registration, Route = nil, Wallbang = false, Projectile = false, ResolverSnapshot = Snapshot}
    end
    local Center = PartSuspicious and BasePosition or GetCriminologySilentAimStablePoint(Part, Part.Position) or Part.Position
    local CenterDelta = Center - Origin
    if CenterDelta.Magnitude > 0.001 and IsCriminologySilentAimDirectPathClear(Origin, Center) then
        local Direction = CenterDelta.Unit local Registration = PartSuspicious and Center or GetCriminologySilentAimRayPartContact(Origin, Direction, Part) or Center
        return {Origin = Origin, Direction = Direction, TargetPosition = Center, RegistrationPosition = Registration, Route = nil, Wallbang = false, Projectile = false, ResolverSnapshot = Snapshot}
