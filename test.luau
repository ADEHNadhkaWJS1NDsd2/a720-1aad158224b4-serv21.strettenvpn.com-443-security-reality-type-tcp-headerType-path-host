function ApplyBodyHideVisualToReplica(Snapshot)
    if type(Snapshot) ~= "table" or typeof(Snapshot.RootCFrame) ~= "CFrame" or not HideRunning() then return Snapshot end
    local Visual = BodyHide.VisualSnapshot
    if type(Visual) ~= "table" or Visual.Character ~= Snapshot.Character or typeof(Visual.RootCFrame) ~= "CFrame"
        or type(Visual.Parts) ~= "table" or Clock() - (tonumber(Visual.Time) or 0) > 0.20 then return Snapshot end
    Snapshot.Parts = type(Snapshot.Parts) == "table" and Snapshot.Parts or {}
    for Name, PartCFrame in pairs(Visual.Parts) do
        if typeof(PartCFrame) == "CFrame" then Snapshot.Parts[Name] = Snapshot.RootCFrame * Visual.RootCFrame:ToObjectSpace(PartCFrame) end
    end
