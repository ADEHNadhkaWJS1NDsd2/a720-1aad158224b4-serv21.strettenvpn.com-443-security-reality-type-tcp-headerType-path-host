end
function ExtendedVisuals:IsGeneratedLocalVisual(Object)
    local Current = Object
    while Current and Current ~= LocalPlayer.Character do
        if Sub(tostring(Current.Name or ""), 1, 10) == "Atramenta" or Current:GetAttribute("AtramentaVisualLayer") == true then return true end
        Current = Current.Parent
    end
