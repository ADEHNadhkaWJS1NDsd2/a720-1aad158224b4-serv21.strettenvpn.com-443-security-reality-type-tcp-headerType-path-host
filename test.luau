function BuildChinaHatRainbowPalette()
    local Palette = AtramentaConfig.Visual.ChinaHat.RainbowPalette local Count = Max(Floor(tonumber(AtramentaConfig.Visual.ChinaHat.RainbowPaletteSize) or 96), 24)
    if #Palette == Count then return Palette end
