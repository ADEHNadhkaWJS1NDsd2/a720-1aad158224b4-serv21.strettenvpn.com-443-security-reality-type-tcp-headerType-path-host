function IsPlayerVisualCacheNeeded()
    return Visuals.Player.Enabled == true or Visuals.Player.Chams.Enabled == true or Visuals.Player.Material.Enabled == true
end
function ShutdownPlayerVisualCache()
    if Visuals.Player.UiProjectionBound == true then
        Visuals.Player.UiProjectionBound = false
        RunService:UnbindFromRenderStep("AtramentaPlayerUiProjection")
    end
    if Visuals.PlayerAddedConnection then Shared.SafeDisconnect(Visuals.PlayerAddedConnection); Visuals.PlayerAddedConnection = nil end
    if Visuals.PlayerRemovingConnection then Shared.SafeDisconnect(Visuals.PlayerRemovingConnection); Visuals.PlayerRemovingConnection = nil end
    if Visuals.WorldCharactersConnection then Shared.SafeDisconnect(Visuals.WorldCharactersConnection); Visuals.WorldCharactersConnection = nil end
    if Visuals.WorldContainerConnection then Shared.SafeDisconnect(Visuals.WorldContainerConnection); Visuals.WorldContainerConnection = nil end
    if Visuals.WorldRootConnection then Shared.SafeDisconnect(Visuals.WorldRootConnection); Visuals.WorldRootConnection = nil end
    Visuals.BoundWorldCharacters = nil
    Visuals.BoundWorldContainer = nil
    for Index = #Visuals.Player.List, 1, -1 do
        local Data = Visuals.Player.List[Index]
        if Data and Data.Player then Shared.DestroyPlayerVisual(Data.Player) end
    end
    Clear(Visuals.Player.List)
    Clear(Visuals.Player.Objects)
    Clear(Visuals.Player.ProfilePictureCache)
    if Visuals.Player.UiRoot and Visuals.Player.UiRoot.Parent then Visuals.Player.UiRoot:Destroy() end
    Visuals.Player.UiRoot = nil
    Visuals.Initialized = false
end
function IsVisualEngineNeeded()
    return Visuals.Player.Enabled == true or Visuals.Player.Chams.Enabled == true or Visuals.Player.Material.Enabled == true or Visuals.Snapline.Enabled == true
end
function EnsureVisualEngine()
    RefreshPlayerUIProjection()
    local PlayerCacheNeeded = IsPlayerVisualCacheNeeded()
    if PlayerCacheNeeded then
        Shared.EnsurePlayerCache()
    elseif Visuals.Initialized then
        ShutdownPlayerVisualCache()
    end
    if not IsVisualEngineNeeded() then
        if Visuals.Connection then
            Shared.SafeDisconnect(Visuals.Connection)
            Visuals.Connection = nil
        end
        Visuals.ChamVisibilityCursor = 1
        Visuals.Performance.EspCursor = 1
        Visuals.Performance.LastESPCameraCFrame = nil
        Visuals.Performance.ProjectionFrame = 0
        return
    end
    if Visuals.ChamsRenderConnection then
        Shared.SafeDisconnect(Visuals.ChamsRenderConnection)
        Visuals.ChamsRenderConnection = nil
    end
    local NeedAuxiliaryRenderLoop = Visuals.Snapline.Enabled == true or Visuals.Player.Chams.Enabled == true
    if not NeedAuxiliaryRenderLoop then
        if Visuals.Connection then
            Shared.SafeDisconnect(Visuals.Connection)
            Visuals.Connection = nil
        end
        return
    end
    if Visuals.Connection then return end
    Visuals.Connection = RunService.RenderStepped:Connect(function(DeltaTime)
        local Performance = Visuals.Performance
        DeltaTime = Clamp(tonumber(DeltaTime) or 0, 0, 0.05)
        Performance.SmoothedDelta += (DeltaTime - Performance.SmoothedDelta) * Clamp(DeltaTime * 4, 0, 1)
        Performance.EstimatedFps = 1 / Max(Performance.SmoothedDelta, 1 / 240)
        Performance.PlayerCount = #Visuals.Player.List
        if not IsVisualEngineNeeded() then
            local Connection = Visuals.Connection
            Visuals.Connection = nil
            if Connection then Shared.SafeDisconnect(Connection) end
            return
        end
        Performance.VisualFrame = (tonumber(Performance.VisualFrame) or 0) + 1


        if Visuals.Snapline.Enabled then Shared.SafeCall(UpdateTargetSnapline) end
        if Visuals.Player.Chams.Enabled then Shared.SafeCall(RefreshAllPlayerChamVisibilityFast, false) end
    end)
end
AutoPickupCashController = {Runtime = {Enabled = false, Generation = 0, Character = nil, Humanoid = nil, Root = nil, Filter = nil, Folder = nil, Remote = nil, InFlight = nil,
        LastFolderScan = 0, Items = setmetatable({}, {__mode = "k"}), Connections = {}, WorkerRunning = false, WakeRequested = false}, MaximumDistance = 22, RetryDelay = 0.12, SuccessDelay = 0.04, IdleDelay = 0.03,
    RescanDelay = 0.12}
function AutoPickupCashController.Disconnect(Name)
    local Runtime = AutoPickupCashController.Runtime
