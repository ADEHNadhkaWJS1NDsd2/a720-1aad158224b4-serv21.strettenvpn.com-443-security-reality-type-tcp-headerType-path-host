function BindAutoRespawnCharacter(Character)
    ClearAutoRespawnCharacterConnections()
    if not AutoRespawnEnabled or not Character then return end
    local function BindHumanoid(Humanoid)
        if not Humanoid or not Humanoid:IsA("Humanoid") then return end
        AutoRespawnCharacterConnections[#AutoRespawnCharacterConnections + 1] = Humanoid:GetPropertyChangedSignal("Health"):Connect(function()
            if AutoRespawnEnabled and Character == LocalPlayer.Character and Humanoid.Parent and Humanoid.Health <= 0 then RequestCharacterRespawn() end
        end)
        if Humanoid.Health <= 0 then Defer(RequestCharacterRespawn) end
    end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid then BindHumanoid(Humanoid) end
    AutoRespawnCharacterConnections[#AutoRespawnCharacterConnections + 1] = Character.ChildAdded:Connect(function(Object)
        if Object:IsA("Humanoid") then BindHumanoid(Object) end
    end)
    AutoRespawnCharacterConnections[#AutoRespawnCharacterConnections + 1] = Character.AncestryChanged:Connect(function()
        if Character ~= LocalPlayer.Character or not Character.Parent then RespawnSafetyState.RespawnRequestedFor = nil end
    end)
end
