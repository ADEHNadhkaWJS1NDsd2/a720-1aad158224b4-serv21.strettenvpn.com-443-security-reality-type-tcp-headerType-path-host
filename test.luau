function Shared.FindPlayerLevelSource(Data)
    local Player = Data and Data.Player
    if not Player then return nil end
    local Names = {"Level", "LEVEL", "Lvl", "LVL", "level"}
    local function InspectLevelContainer(Container)
        if not Container then return nil end
        for Index = 1, #Names do
            local Object = Container:FindFirstChild(Names[Index])
            if Object and Object:IsA("ValueBase") then
                local Value = tonumber(Object.Value)
                if Value and Value >= 0 then return Floor(Value + 0.5), Object, nil, nil end
            end
        end
        for Index = 1, #Names do
            local Value = tonumber(Container:GetAttribute(Names[Index]))
            if Value and Value >= 0 then return Floor(Value + 0.5), nil, Container, Names[Index] end
        end
        return nil
    end
    local Containers = {Player:FindFirstChild("leaderstats"), Player:FindFirstChild("PlayerbaseData2"), Player:FindFirstChild("Data"), Player:FindFirstChild("Values"), Player}
    for Index = 1, #Containers do
        local Value, Object, AttributeContainer, AttributeName = InspectLevelContainer(Containers[Index])
        if Value ~= nil then return Value, Object, AttributeContainer, AttributeName end
    end
    local Id = tostring(Player.UserId)
    local ReplicatedData = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
    local Entry = ReplicatedData and (ReplicatedData:FindFirstChild(Player.Name) or ReplicatedData:FindFirstChild(Id))
    local Value, Object, AttributeContainer, AttributeName = InspectLevelContainer(Entry)
    if Value ~= nil then return Value, Object, AttributeContainer, AttributeName end
    local CharStats = ReplicatedStorage:FindFirstChild("CharStats")
    Entry = CharStats and (CharStats:FindFirstChild(Player.Name) or CharStats:FindFirstChild(Id))
    return InspectLevelContainer(Entry)
end
function Shared.RefreshPlayerLevelSource(Data)
