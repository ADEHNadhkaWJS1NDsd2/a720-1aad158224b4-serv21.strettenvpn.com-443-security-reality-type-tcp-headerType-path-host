end
function UpdatePlayerUIProjection()
    if Visuals.Player.Enabled ~= true then return end
    local CameraObject = Shared.GetCamera()
    local LocalCharacter = LocalPlayer.Character
    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    local List = Visuals.Player.List
    if not CameraObject then
        for _, Data in ipairs(List) do
            Shared.HidePlayerVisual(Data)
        end
        Visuals.Performance.ProjectionActive = false
        return
    end
    local CurrentTime = Clock()
    local MaximumDistance = Max(tonumber(Visuals.Player.MaxDistance) or 1200, 1)
    local MaximumDistanceSquared = MaximumDistance * MaximumDistance
    local HasEnemyTargets = AtramentaHasEnemyTargets()
    local Performance = Visuals.Performance
    Performance.ProjectionFrame += 1
    Performance.PlayerCount = #List
    Performance.ESPRenderer = "Roblox UI"
    Performance.ProjectionActive = true
    Shared.BeginPlayerESPProjectionFrame(CameraObject)
    local ProjectionContext = Shared.PlayerESPProjectionContext
    local ViewOrigin = type(ProjectionContext) == "table" and ProjectionContext.Position or CameraObject.CFrame.Position
    local StateInterval = Clamp(tonumber(Performance.UIStateInterval) or 0.10, 1 / 30, 0.25)
    local DynamicInterval = Clamp(tonumber(Performance.UIDynamicInterval) or 1 / 30, 1 / 60, 0.10)
    for Index = 1, #List do
        local Data = List[Index]
        if not Data then
            continue
        end
        local Character = Data.Character
        local Humanoid = Data.Humanoid
        local TargetRoot = Data.Root
        if not Character or not Character.Parent or not Humanoid or not Humanoid.Parent or not TargetRoot or not TargetRoot.Parent then
            local Resolved = Data.Player and ResolveTrackedCharacter(Data.Player, Data.Player.Character) or nil
            if Resolved then
                Shared.RefreshPlayerCharacter(Data, Resolved)
                Character = Data.Character
                Humanoid = Data.Humanoid
                TargetRoot = Data.Root
            end
        end
        local Blocked = not Character or not Humanoid or not TargetRoot or not Shared.IsPlayerESPRenderable(Data, CurrentTime)
            or (HasEnemyTargets and EnemyTable[Data.Player] ~= true)
            or (Visuals.Player.TeamCheck and LocalPlayer.Team and Data.Player.Team == LocalPlayer.Team)
        if Blocked then
            Data.ESPEligible = false
            if Data.VisualHidden ~= true then Shared.HidePlayerVisual(Data) end
            continue
        end
        local RootPosition = TargetRoot.Position
        local ViewDelta = RootPosition - ViewOrigin
        local ViewDistanceSquared = ViewDelta:Dot(ViewDelta)
        if ViewDistanceSquared > MaximumDistanceSquared then
            Data.ESPEligible = false
            if Data.VisualHidden ~= true then Shared.HidePlayerVisual(Data) end
            continue
        end
        Data.ESPEligible = true
        if Data.PlayerESPSignalsBound ~= true then Shared.BindPlayerESPStateSignals(Data) end
        Data.LastESPViewDistance = Sqrt(ViewDistanceSquared)
        local EspColor, EspOutline = GetPlayerESPColors(Data, LocalRoot, CurrentTime)
        Data.LastESPColor = EspColor
        Data.LastESPOutline = EspOutline
        local WasHidden = Data.VisualHidden == true
        local Position, Size, RootScreen, HeadScreen, FeetScreen = GetPlayerFastBox(CameraObject, Data, RootPosition)
        if not Position or not Size then
            ResetPlayerESPProjectionCache(Data)
            if Data.VisualHidden ~= true then Shared.HidePlayerVisual(Data) end
            if Visuals.Player.Offscreen.Enabled then
                UpdateOffscreenArrow(Data, CameraObject, RootPosition, Data.LastESPDistance, Data.LastESPColor or Visuals.Player.Offscreen.Color)
            else
                HideOffscreenArrowOverlay(Data)
            end
            continue
        end
        HideOffscreenArrowOverlay(Data)
        Data.VisualHidden = false
        if not Shared.EnsurePlayerESPUI(Data) then
            Shared.HidePlayerVisual(Data)
            continue
        end
        if LocalRoot and LocalRoot.Parent then
            Data.LastESPDistance = (RootPosition - LocalRoot.Position).Magnitude
        else
            Data.LastESPDistance = Data.LastESPViewDistance
        end
        local NextStateRefresh = tonumber(Data.NextESPStateRefresh) or 0
        local NeedStateRefresh = WasHidden or Data.ESPStateDirty == true or CurrentTime >= NextStateRefresh
        if NeedStateRefresh then
            Data.ESPStateDirty = false
            Data.NextESPStateRefresh = CurrentTime + StateInterval
        end
        local AnimationActive = IsPlayerESPAnimationActive(Data)
        local NextDynamicRefresh = tonumber(Data.NextESPDynamicRefresh) or 0
        local NeedDynamicRefresh = (WasHidden or Data.ESPDynamicDirty == true or AnimationActive) and CurrentTime >= NextDynamicRefresh
        if NeedDynamicRefresh then
            Data.ESPDynamicDirty = false
            Data.NextESPDynamicRefresh = CurrentTime + DynamicInterval
        end
        local Ui = Data.UiEsp or EnsurePlayerUIESP(Data)
        local Root = Ui and Ui.Root
        if not Root or not Root.Parent then
            Shared.HidePlayerVisual(Data)
            continue
        end
        local Width = Max(Size.X, 1)
        local Height = Max(Size.Y, 1)
        local X = Position.X
        local Y = Position.Y
        if Data.UIProjectionX ~= X or Data.UIProjectionY ~= Y then
            Root.Position = FromOffset(X, Y)
            Data.UIProjectionX = X
            Data.UIProjectionY = Y
        end
        if Data.UIProjectionWidth ~= Width or Data.UIProjectionHeight ~= Height then
            Root.Size = FromOffset(Width, Height)
            Data.UIProjectionWidth = Width
            Data.UIProjectionHeight = Height
        end
        Data.UiProjectedWidth = Width
        Data.UiProjectedHeight = Height
        if Root.Visible ~= true then Root.Visible = true end
        if NeedStateRefresh then
            if Visuals.Player.Ammo.Enabled or (Visuals.Player.Flags.Enabled and Visuals.Player.Flags.ShowAmmo) then
                GetEquippedToolAndAmmo(Data, CurrentTime)
            end
            if Visuals.Player.Weapon or Visuals.Player.WeaponIcon then
                Shared.GetCachedToolName(Data, CurrentTime)
            end
            local StateOk = pcall(RefreshPlayerRobloxUIState, Data, Ui, Position, Size, CurrentTime)
            if not StateOk then Shared.MarkPlayerESPStateDirty(Data, true) end
        end
        if NeedDynamicRefresh then
            UpdatePlayerUIDynamicProjection(Data, Ui, CurrentTime)
            if Visuals.Player.BoxGradient.Enabled == true and Visuals.Player.BoxGradient.Animated == true then
                local Rotation = GetBoxGradientRotation()
                if Ui.BoxStrokeGradient and Ui.BoxStrokeGradient.Enabled then Ui.BoxStrokeGradient.Rotation = Rotation end
                if Ui.FillGradient and Ui.FillGradient.Enabled then Ui.FillGradient.Rotation = Rotation end
            end
            if Visuals.Player.Prediction.Enabled then UpdatePredictionMarker(Data, CameraObject) end
        end
        local OverlayColor = Data.LastESPColor or Visuals.Player.BoxColor
        if Visuals.Player.Skeleton.Enabled then
            UpdateSkeletonESP(Data, CameraObject, OverlayColor)
        elseif NeedStateRefresh then
            HideSkeletonOverlay(Data)
        end
        if NeedStateRefresh then
            if not Visuals.Player.Look.Enabled and Data.OverlayPrimitives and Data.OverlayPrimitives.LookLine then
                Data.OverlayPrimitives.LookLine.Visible = false
            end
            if not Visuals.Player.Tracers then Shared.HideTracerOverlay(Data) end
            if not Visuals.Player.Prediction.Enabled and Data.OverlayPrimitives then
                if Data.OverlayPrimitives.PredictionMarker then Data.OverlayPrimitives.PredictionMarker.Visible = false end
                if Data.OverlayPrimitives.PredictionOutline then Data.OverlayPrimitives.PredictionOutline.Visible = false end
            end
        end
        if Visuals.Player.Look.Enabled then UpdateLookLine(Data, CameraObject, OverlayColor) end
        if Visuals.Player.Tracers then
            UpdateTracer(Data, CameraObject.ViewportSize, Position, Size, RootScreen, HeadScreen, FeetScreen, nil)
        end
    end
    Performance.ProjectionActive = false
end
function RefreshPlayerUIProjection()
    local Needed = Visuals.Player.Enabled == true
    if Needed then
        if Visuals.Player.UiProjectionBound == true then return end
        RunService:UnbindFromRenderStep("AtramentaPlayerUiProjection")
        Visuals.Player.UiProjectionBound = true
        RunService:BindToRenderStep("AtramentaPlayerUiProjection", Enum.RenderPriority.Last.Value + 25,
            function()
            local Success = Shared.SafeCall(UpdatePlayerUIProjection)
            if not Success then
                Visuals.Performance.ProjectionActive = false
                for _, Data in ipairs(Visuals.Player.List) do
                    Shared.HidePlayerVisual(Data)
                end
            end
            end)
        return
    end
    RunService:UnbindFromRenderStep("AtramentaPlayerUiProjection")
    Visuals.Performance.ProjectionActive = false
    Visuals.Player.UiProjectionBound = false
    for _, Data in ipairs(Visuals.Player.List) do
        HidePlayerUIESP(Data)
    end
end
function Shared.DestroyPlayerVisual(Player)
    local Data = Visuals.Player.Objects[Player] if not Data then return end
    local UserId = Player and tonumber(Player.UserId) or nil
    if UserId then Visuals.Player.ProfilePictureCache[UserId] = nil end
    Data.ProfilePictureData = nil
    Data.ProfilePictureApplied = false
    Shared.DisconnectVisualConnection(Data.CharacterAddedConnection)
    Shared.DisconnectVisualConnection(Data.CharacterRemovingConnection)
    if type(Shared.DisconnectPlayerESPStateSignals) == "function" then Shared.DisconnectPlayerESPStateSignals(Data) end
    for Unused, Object in pairs(Data.OverlayPrimitives) do Shared.RemoveOverlayPrimitive(Object) end
    DestroyPlayerUIESP(Data)
    if type(RestorePlayerESPMaterial) == "function" then RestorePlayerESPMaterial(Data) end
    DestroyChams(Data)
    local List = Visuals.Player.List
    local Index = Floor(tonumber(Data.ListIndex) or 0)
    if Index < 1 or List[Index] ~= Data then
        Index = 0
        for SearchIndex = 1, #List do
            if List[SearchIndex] == Data then Index = SearchIndex break end
        end
    end
    if Index > 0 then
        local LastIndex = #List
        local Last = List[LastIndex]
        if Index ~= LastIndex then
            List[Index] = Last
            if Last then Last.ListIndex = Index end
        end
        List[LastIndex] = nil
    end
    Data.ListIndex = 0
    Visuals.Player.Objects[Player] = nil
end
function Shared.ReconcilePlayerVisualCache()
    local ActivePlayers, StalePlayers = Visuals.ReconcileActive, Visuals.ReconcileStale
    Clear(ActivePlayers)
    Clear(StalePlayers)
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            ActivePlayers[Player] = true
            local Data = Visuals.Player.Objects[Player]
            if not Data then Data = Shared.CreatePlayerVisual(Player) end
            local Resolved = ResolveTrackedCharacter(Player, Player.Character)
            if Data then
                local NeedsRefresh = Resolved and Data.Character ~= Resolved
                if not NeedsRefresh and Resolved and (not Data.Root or not Data.Root.Parent or not Data.Humanoid or not Data.Humanoid.Parent) then NeedsRefresh = true end
                if NeedsRefresh then Shared.RefreshPlayerCharacter(Data, Resolved) end
            end
        end
    end
    for Player in pairs(Visuals.Player.Objects) do
        if not ActivePlayers[Player] or Player.Parent ~= Players then StalePlayers[#StalePlayers + 1] = Player end
    end
    for Index = 1, #StalePlayers do Shared.DestroyPlayerVisual(StalePlayers[Index]) end
end
function Shared.EnsurePlayerCache()
    Visuals.Initialized = true
    Shared.ReconcilePlayerVisualCache()
    if not Visuals.PlayerAddedConnection then
        Visuals.PlayerAddedConnection = Players.PlayerAdded:Connect(function(Player)
            if Player == LocalPlayer then return end
            Shared.CreatePlayerVisual(Player)
        end)
    end
    if not Visuals.PlayerRemovingConnection then Visuals.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(Player) Shared.DestroyPlayerVisual(Player) end) end
    if not Visuals.WorldRootConnection then
        local function BindWorldCharactersFolder(Folder)
            if Folder == Visuals.BoundWorldCharacters then return end
            if Visuals.WorldCharactersConnection then Shared.SafeDisconnect(Visuals.WorldCharactersConnection); Visuals.WorldCharactersConnection = nil end
            Visuals.BoundWorldCharacters = Folder
            if not Folder then return end
            for _, Character in ipairs(Folder:GetChildren()) do
                local Player = Players:FindFirstChild(Character.Name)
                if Player and Player:IsA("Player") and Player ~= LocalPlayer then
                    local Data = Visuals.Player.Objects[Player] or Shared.CreatePlayerVisual(Player)
                    if Data then
                        Shared.RefreshPlayerCharacter(Data, Character)
                            end
                end
            end
            Visuals.WorldCharactersConnection = Folder.ChildAdded:Connect(function(Character)
                local Player = Players:FindFirstChild(Character.Name)
                if Player and Player:IsA("Player") and Player ~= LocalPlayer then
                    Defer(function()
                        local Data = Visuals.Player.Objects[Player] or Shared.CreatePlayerVisual(Player)
                        if Data then
                            Shared.RefreshPlayerCharacter(Data, Character)
                                    end
                    end)
                end
            end)
        end
        local function BindWorldContainer(Container)
            if Container == Visuals.BoundWorldContainer then return end
            if Visuals.WorldContainerConnection then Shared.SafeDisconnect(Visuals.WorldContainerConnection); Visuals.WorldContainerConnection = nil end
            Visuals.BoundWorldContainer = Container
            if not Container then BindWorldCharactersFolder(nil); return end
            BindWorldCharactersFolder(Container:FindFirstChild("Characters"))
            Visuals.WorldContainerConnection = Container.ChildAdded:Connect(function(Child) if Child.Name == "Characters" then BindWorldCharactersFolder(Child) end end)
        end
        BindWorldContainer(Workspace:FindFirstChild("©"))
        Visuals.WorldRootConnection = Workspace.ChildAdded:Connect(function(Child) if Child.Name == "©" then BindWorldContainer(Child) end end)
    end
end
