function Ragebot.ClampWallbangPacketEndpoint(Part, WorldPosition)
    if not Part or not Part:IsA("BasePart") or typeof(WorldPosition) ~= "Vector3" then
        return nil
    end
    local RadiusMap = {Head = 1.5, Torso = 3, UpperTorso = 3, LowerTorso = 3, ["Left Arm"] = 2.5, ["Right Arm"] = 2.5, ["Left Leg"] = 2.5, ["Right Leg"] = 2.5,
        LeftUpperArm = 2.5, RightUpperArm = 2.5, LeftLowerArm = 2.5, RightLowerArm = 2.5, LeftUpperLeg = 2.5, RightUpperLeg = 2.5, LeftLowerLeg = 2.5, RightLowerLeg = 2.5,
        HumanoidRootPart = 10}
    local Radius = tonumber(RadiusMap[Part.Name]) or 3
    local Margin = Part.Name == "Head" and 0.06 or 0.08
    local SafeRadius = Max(Radius - Margin, 0.05)
    local Delta = WorldPosition - Part.Position
    local Distance = Delta.Magnitude
    if Distance <= SafeRadius then
        return WorldPosition
    end
    if Distance <= 0.000001 then
        return Part.Position
    end
    return Part.Position + Delta.Unit * SafeRadius
end

function HeadHitbox.ClampToRealHead(Head, DesiredPosition)
    if not Head or not Head:IsA("BasePart") then
        return nil
    end
    return Ragebot.ClampWallbangPacketEndpoint(Head, typeof(DesiredPosition) == "Vector3" and DesiredPosition or Head.Position) or Head.Position
end

function HeadHitbox.GetScreenSelection(Head, CursorPosition, CameraObject, UseScreenCoordinates, TopLeftInset, Scale)
    if not Head or not Head:IsA("BasePart") or typeof(CursorPosition) ~= "Vector2" or not CameraObject then
        return nil, false, nil, nil
    end
    local WorldPoint = Head.Position
    local Projected, Visible
    if UseScreenCoordinates == true then
        Projected, Visible = CameraObject:WorldToScreenPoint(WorldPoint)
    else
        Projected, Visible = CameraObject:WorldToViewportPoint(WorldPoint)
    end
    if not Projected or Projected.Z <= 0 then
        return nil, false, WorldPoint, Head.Position
    end
    local ScreenPoint = NewVector2(Projected.X, Projected.Y)
    if UseScreenCoordinates ~= true and typeof(TopLeftInset) == "Vector2" then ScreenPoint += TopLeftInset end
    local Distance = (CursorPosition - ScreenPoint).Magnitude
    local ShotPoint = HeadHitbox.ClampToRealHead(Head, WorldPoint) or Head.Position
    return Distance, Visible == true, WorldPoint, ShotPoint
end

function HeadHitbox.GetAimShotPoint(Head, DesiredPosition, CameraObject, UseScreenCoordinates, TopLeftInset, Scale)
    if not Head or not Head:IsA("BasePart") then
        return nil
    end
    if typeof(DesiredPosition) == "Vector3" then
        return HeadHitbox.ClampToRealHead(Head, DesiredPosition) or Head.Position
    end
    if typeof(DesiredPosition) == "Vector2" and CameraObject then
        local _, _, _, ShotPoint = HeadHitbox.GetScreenSelection(Head, DesiredPosition, CameraObject, UseScreenCoordinates, TopLeftInset, Scale)
        if typeof(ShotPoint) == "Vector3" then
            return ShotPoint
        end
    end
    return Head.Position
end

