function GrenadeTrajectoryTryTrackProjectile(Object)
    if not GrenadeTrajectoryState.Enabled or GrenadeTrajectoryState.ShowLive ~= true or not Object or not Object.Parent then return false end
    local CurrentTime = Clock()
    if CurrentTime - (tonumber(GrenadeTrajectoryState.LastHeldAt) or 0) > 1.15 then return false end
    local Part = GrenadeTrajectoryGetProjectilePart(Object)
    if not Part or not Part.Parent then return false end
    local Character = LocalPlayer.Character
    if Character and Object:IsDescendantOf(Character) then return false end
    for _, Name in next, {"Creator", "Owner", "Player"} do
        local Owner = Object:FindFirstChild(Name, true)
        if Owner and Owner:IsA("ObjectValue") and Owner.Value and Owner.Value ~= LocalPlayer then return false end
    end
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Reference = GrenadeTrajectoryState.LastHeldHandlePosition or Root and Root.Position
    if typeof(Reference) ~= "Vector3" or (Part.Position - Reference).Magnitude > 55 then return false end
    local LaunchVelocity = Part.AssemblyLinearVelocity
    local Speed = LaunchVelocity.Magnitude
    if Speed < 4 then return false end
    local AimDirection = GrenadeTrajectoryState.LastHeldAimDirection
    local RootVelocity = GrenadeTrajectoryState.LastHeldRootVelocity
    local LearnedSpeed
    if typeof(AimDirection) == "Vector3" and AimDirection.Magnitude > 0.001 and typeof(RootVelocity) == "Vector3" then
        local Relative = LaunchVelocity - RootVelocity
        local Along = Relative:Dot(AimDirection.Unit)
        if Along > 20 and Along <= 450 and Relative.Magnitude > 0.001 and Relative.Unit:Dot(AimDirection.Unit) >= 0.55 then LearnedSpeed = Along end
    end
    LearnedSpeed = LearnedSpeed or Clamp(Speed, 20, 450)
    local Key = Lower(tostring(GrenadeTrajectoryState.LastHeldToolName or Object.Name))
    local Previous = GrenadeTrajectoryState.ObservedProfiles[Key]
    local PreviousSpeed = type(Previous) == "table" and tonumber(Previous.Speed) or nil
    GrenadeTrajectoryState.ObservedProfiles[Key] = {Speed = PreviousSpeed and PreviousSpeed + (LearnedSpeed - PreviousSpeed) * 0.35 or LearnedSpeed, Time = CurrentTime}
    local Profile = GrenadeTrajectoryState.LastHeldProfile
    GrenadeTrajectoryState.ActiveProjectile = Object
    GrenadeTrajectoryState.ActivePart = Part
    GrenadeTrajectoryState.ActiveProfile = type(Profile) == "table" and {ThrowSpeed = tonumber(Profile.ThrowSpeed) or GrenadeTrajectoryState.ThrowSpeed,
        PredictionTime = tonumber(Profile.PredictionTime) or GrenadeTrajectoryState.PredictionTime,
        GravityScale = tonumber(Profile.GravityScale) or GrenadeTrajectoryState.GravityScale, Friction = Profile.Friction,
        FrictionWeight = Profile.FrictionWeight, Elasticity = Profile.Elasticity, ElasticityWeight = Profile.ElasticityWeight} or {
        ThrowSpeed = GrenadeTrajectoryState.ThrowSpeed, PredictionTime = GrenadeTrajectoryState.PredictionTime, GravityScale = GrenadeTrajectoryState.GravityScale}
    GrenadeTrajectoryState.ActiveStarted = CurrentTime
    return true
end
function GrenadeTrajectoryGetContainers()
    local Result = {}
    local Seen = setmetatable({}, {__mode = "k"})
    local function Add(Object)
        if not Object or Seen[Object] then return end
        Seen[Object] = true
        Result[#Result + 1] = Object
    end
    local Debris = Workspace:FindFirstChild("Debbris") or Workspace:FindFirstChild("Debris")
    Add(Debris)
    if Debris then
        Add(Debris:FindFirstChild("VParts"))
        Add(Debris:FindFirstChild("Projectiles"))
        Add(Debris:FindFirstChild("Effects"))
    end
    Add(Workspace:FindFirstChild("VParts"))
    Add(Workspace:FindFirstChild("Projectiles"))
    return Result
end
function GrenadeTrajectoryBindDebrisFolder()
    local Containers = GrenadeTrajectoryGetContainers()
    local ActiveSet = setmetatable({}, {__mode = "k"})
    GrenadeTrajectoryState.Containers = Containers
    GrenadeTrajectoryState.DebrisFolder = Containers[1]
    for Index = 1, #Containers do
        local Container = Containers[Index]
        ActiveSet[Container] = true
        if not GrenadeTrajectoryState.ContainerConnections[Container] then
            GrenadeTrajectoryState.ContainerConnections[Container] = Container.ChildAdded:Connect(function(Object)
                if GrenadeTrajectoryState.Enabled ~= true or GrenadeTrajectoryState.ShowLive ~= true then return end
                Defer(function()
                    if GrenadeTrajectoryTryTrackProjectile(Object) then return end
                    Wait(0.025)
                    if GrenadeTrajectoryTryTrackProjectile(Object) then return end
                    Wait(0.05)
                    GrenadeTrajectoryTryTrackProjectile(Object)
                end)
            end)
        end
    end
    for Container, Connection in pairs(GrenadeTrajectoryState.ContainerConnections) do
        if not ActiveSet[Container] or not Container.Parent then
            if Connection and typeof(Connection) == "RBXScriptConnection" then Connection:Disconnect() end
            GrenadeTrajectoryState.ContainerConnections[Container] = nil
        end
    end
end
function GrenadeTrajectoryGetActiveProjectile()
    local Object = GrenadeTrajectoryState.ActiveProjectile local Part = GrenadeTrajectoryState.ActivePart
    if GrenadeTrajectoryState.ShowLive ~= true or not Object or not Object.Parent or not Part or not Part.Parent then
        GrenadeTrajectoryClearActive()
        return nil, nil, nil
    end
    local Age = Clock() - (tonumber(GrenadeTrajectoryState.ActiveStarted) or 0)
    if Age > 9 then
        GrenadeTrajectoryClearActive()
        return nil, nil, nil
    end
    local Stored = GrenadeTrajectoryState.ActiveProfile local Profile
    if type(Stored) == "table" then
        Profile = {ThrowSpeed = Stored.ThrowSpeed, GravityScale = Stored.GravityScale,
            PredictionTime = Max((tonumber(Stored.PredictionTime) or GrenadeTrajectoryState.PredictionTime) - Age, 0.08)}
    end
    return Object, Part, Profile
end
function GrenadeTrajectoryBuildCastParams(Ignore)
    local Parameters = NewRaycastParams()
    Parameters.FilterType = Enum.RaycastFilterType.Exclude
    Parameters.IgnoreWater = false
    Parameters.RespectCanCollide = true
    local Filter = {}
    if type(Ignore) == "table" then
        for Index = 1, #Ignore do
            local Object = Ignore[Index]
            if Object then Filter[#Filter + 1] = Object end
        end
    end
    local Characters = Workspace:FindFirstChild("Characters")
    if Characters then Filter[#Filter + 1] = Characters end
    Parameters.FilterDescendantsInstances = Filter
    local CollisionGroup = rawget(_G, "CG_NCC")
    if type(CollisionGroup) == "string" and CollisionGroup ~= "" then Shared.SafeCall(function() Parameters.CollisionGroup = CollisionGroup end) end
    return Parameters
end
function GrenadeTrajectoryCast(Position, Radius, Travel, Parameters)
    if typeof(Position) ~= "Vector3" or typeof(Travel) ~= "Vector3" or Travel.Magnitude <= 0.0001 then return nil end
    if type(Workspace.Spherecast) == "function" then
        return Workspace:Spherecast(Position, Radius, Travel, Parameters)
    end
    return Workspace:Raycast(Position, Travel, Parameters)
end
function GrenadeTrajectoryPushPoint(Points, Position, Force)
    if typeof(Position) ~= "Vector3" then return #Points end
    local Last = Points[#Points]
    if not Last then
        Points[1] = Position
        return 1
    end
