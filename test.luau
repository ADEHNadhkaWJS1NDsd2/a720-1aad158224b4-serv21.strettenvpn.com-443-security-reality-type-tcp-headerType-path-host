function BacktrackVisuals:NormalizeScope(Value)
    Value = tostring(Value or "All")
    if Value == "Players" or Value == "Local Player" or Value == "All" then return Value end
    return "All"
end
function BacktrackVisuals:ShouldTrack(Player)
    if not Player then return false end
    local Scope = self:NormalizeScope(self.Scope)
    if Scope == "Local Player" then return Player == LocalPlayer end
    if Scope == "Players" then return Player ~= LocalPlayer end
    return true
end
function BacktrackVisuals:SetScope(Value)
    self.Scope = self:NormalizeScope(Value)
    for Player in pairs(self.Objects) do
        if not self:ShouldTrack(Player) then self:DestroyObject(Player) end
    end
    for Player in pairs(self.Records) do
        if not self:ShouldTrack(Player) then self.Records[Player] = nil end
    end
end
function BacktrackVisuals:AddPlayer(Player)
    if not Player or self.PlayerSet[Player] then return end
    self.PlayerSet[Player] = true
    self.Players[#self.Players + 1] = Player
end
function BacktrackVisuals:RemovePlayer(Player)
    if not Player or not self.PlayerSet[Player] then return end
    self.PlayerSet[Player] = nil
    self:DestroyObject(Player)
    self.Records[Player] = nil
    for Index = #self.Players, 1, -1 do
        if self.Players[Index] == Player then
            local LastIndex = #self.Players
            self.Players[Index] = self.Players[LastIndex]
            self.Players[LastIndex] = nil
            break
        end
    end
end
function BacktrackVisuals:RebuildPlayerCache()
    Clear(self.Players)
    self.PlayerSet = setmetatable({}, {__mode = "k"})
    for _, Player in ipairs(Players:GetPlayers()) do
        self:AddPlayer(Player)
    end
end
function BacktrackVisuals:GetServerTickRate()
    local TickRate = 60
    if type(Ragebot) == "table" and type(Ragebot.Runtime) == "table" and type(Ragebot.Runtime.SimulationSettings) == "table" then
        TickRate = tonumber(Ragebot.Runtime.SimulationSettings.ServerTickRate) or TickRate
    end
    return Clamp(TickRate, 20, 128)
end
function BacktrackVisuals:UpdateTiming(DeltaTime, CurrentTime)
    local FrameSample = Clamp(tonumber(DeltaTime) or 1 / 60, 1 / 360, 1 / 15)
    self.FrameTime += (FrameSample - self.FrameTime) * 0.10
    self.RecordInterval = Clamp(self.FrameTime, 1 / 60, 1 / 20)
    if CurrentTime < (tonumber(self.NextTimingUpdate) or 0) then return end
    self.NextTimingUpdate = CurrentTime + 0.25
    local Ping = 0
    if type(ResolverGetPing) == "function" then
        Ping = ResolverGetPing()
    else
        Shared.SafeCall(function()
            Ping = tonumber(LocalPlayer:GetNetworkPing()) or 0
        end)
    end
    self.PingSeconds = Clamp(tonumber(Ping) or 0, 0, 1.5)
    self.ServerTickRate = self:GetServerTickRate()
end
function BacktrackVisuals:GetDelay(Player)
    local TickLength = 1 / Clamp(tonumber(self.ServerTickRate) or 60, 20, 128) local OneWayLatency = Clamp(tonumber(self.PingSeconds) or 0, 0, 1.5) * 0.5
    local FrameLead = Clamp(tonumber(self.FrameTime) or 1 / 60, 1 / 360, 1 / 15)
    local AdaptiveDelay
    if Player == LocalPlayer then
        AdaptiveDelay = TickLength * 1.15 + OneWayLatency * 0.35 + FrameLead * 0.35
    else
        AdaptiveDelay = TickLength * 1.50 + OneWayLatency * 0.75 + FrameLead * 0.50
    end
    AdaptiveDelay = Clamp(AdaptiveDelay, TickLength, 0.24)
    self.AdaptiveDelay = AdaptiveDelay
    return AdaptiveDelay
end
function BacktrackVisuals:GetPartReferences(Character, State)
    if not Character then return nil end
    State = type(State) == "table" and State or {}
    local References = State.PartReferences
    if type(References) == "table" and State.PartReferenceCharacter == Character then
        local Valid = true
        for _, Part in pairs(References) do
            if not Part or Part.Parent ~= Character then Valid = false break end
        end
        if Valid then return References end
    end
    References = {}
    for Name in pairs(self.BodyParts) do
        local Part = Character:FindFirstChild(Name)
        if Part and Part:IsA("BasePart") and Part.Parent == Character then
            local VisualSize = Shared.GetPhysicalHbeVisualSize(Part)
            if typeof(VisualSize) ~= "Vector3" or VisualSize.Magnitude <= 12 then References[Name] = Part end
        end
    end
    State.PartReferences = References
    State.PartReferenceCharacter = Character
    return References
end
function BacktrackVisuals:CaptureParts(Character, State)
    local References = self:GetPartReferences(Character, State)
    if type(References) ~= "table" then return nil end
    local Parts = {}
    for Name, Part in pairs(References) do
        if Part and Part.Parent == Character then Parts[Name] = Part.CFrame end
    end
    return next(Parts) and Parts or nil
end
function BacktrackVisuals:SetLocalStableSnapshot(Character, Root, CurrentTime)
    if not self.Enabled or not self:ShouldTrack(LocalPlayer) or not Character or not Root or not Root.Parent then return end
    self.LocalReferenceState = type(self.LocalReferenceState) == "table" and self.LocalReferenceState or {}
    local Parts = self:CaptureParts(Character, self.LocalReferenceState) if not Parts then return end
    self.LocalStableSnapshot = {Time = tonumber(CurrentTime) or Clock(), Character = Character, RootCFrame = Root.CFrame, Parts = Parts, Source = "Invisibility"}
end
function BacktrackVisuals:RebaseParts(Parts, FromRoot, ToRoot)
    if type(Parts) ~= "table" or typeof(FromRoot) ~= "CFrame" or typeof(ToRoot) ~= "CFrame" then return nil end
    local Result = {}
    for Name, PartCFrame in pairs(Parts) do
        if typeof(PartCFrame) == "CFrame" then Result[Name] = ToRoot * FromRoot:ToObjectSpace(PartCFrame) end
    end
    return next(Result) and Result or nil
end
function BacktrackVisuals:ApplyAntiAimToSource(Source, Character, CurrentTime)
    if type(Source) ~= "table" or typeof(Source.RootCFrame) ~= "CFrame" then return Source end
    local AntiAimActive = BodyHide and (BodyHide.Head == true or BodyHide.Hands == true)
    if not AntiAimActive then return Source end
    local Visual = BodyHide and BodyHide.VisualSnapshot
    if type(Visual) == "table" and Visual.Character == Character and typeof(Visual.RootCFrame) == "CFrame"
        and type(Visual.Parts) == "table" and CurrentTime - (tonumber(Visual.Time) or 0) <= 0.25 then
        local Rebased = self:RebaseParts(Visual.Parts, Visual.RootCFrame, Source.RootCFrame)
        if type(Rebased) == "table" then
            Source.Parts = type(Source.Parts) == "table" and Source.Parts or {}
            for Name, PartCFrame in pairs(Rebased) do
                if typeof(PartCFrame) == "CFrame" then Source.Parts[Name] = PartCFrame end
            end
        end
    end
    Source.AntiAim = true
    Source.AntiAimMode = "Static"
    local Name = tostring(Source.Source or "Character")
    if not StringFind(Name, "AntiAim", 1, true) then Source.Source = Name == "Character" and "AntiAim" or (Name .. "+AntiAim") end
    return Source
end
function BacktrackVisuals:GetLocalSource(Character, Root, CurrentTime)
    self.LocalReferenceState = type(self.LocalReferenceState) == "table" and self.LocalReferenceState or {}
    local FakePositionActive = DesyncSettings and DesyncSettings.FakePositionEnabled == true
    local VelocityActive = type(VelocityDesync) == "table" and VelocityDesync.Enabled == true
    local AntiAimActive = BodyHide and (BodyHide.Head == true or BodyHide.Hands == true)
    local Source
    if FakePositionActive and type(GetAtramentaFakePositionVisualSnapshot) == "function" then
        local Replica = GetAtramentaFakePositionVisualSnapshot(CurrentTime)
        if Replica and typeof(Replica.RootCFrame) == "CFrame" then
            Source = {RootCFrame = Replica.RootCFrame, Parts = type(Replica.Parts) == "table" and Replica.Parts or nil, Source = "FakePosition",
                Sequence = Replica.Sequence, FakeLag = false, FakePosition = true, FakePositionMode = "NetworkOwnedPhysicsPulse", VelocityDesync = false, AntiAim = false}
        end
    end
    if not Source and VelocityActive and type(GetVelocityDesyncVisualSnapshot) == "function" then
        local Snapshot = GetVelocityDesyncVisualSnapshot(CurrentTime)
        if Snapshot and typeof(Snapshot.RootCFrame) == "CFrame" and (tonumber(Snapshot.Age) or Infinite) <= 0.20 then
            Source = {RootCFrame = Snapshot.RootCFrame, Parts = type(Snapshot.Parts) == "table" and Snapshot.Parts or nil,
                Source = "VelocityDesync", VelocityDesync = true, VelocityDesyncMethod = Snapshot.Method,
                VelocityDesyncMode = Snapshot.Mode, VelocityDesyncOffset = Snapshot.Offset, VelocityDesyncFakeVelocity = Snapshot.FakeVelocity}
        end
    end
    if not Source and InvisibilityEnabled == true then
        local Stable = self.LocalStableSnapshot
        if type(Stable) == "table" and Stable.Character == Character and typeof(Stable.RootCFrame) == "CFrame" and CurrentTime - (tonumber(Stable.Time) or 0) <= 0.20 then
            Source = {RootCFrame = Stable.RootCFrame, Parts = Stable.Parts, Source = "Invisibility"}
        end
    end
    if not Source and type(GetAtramentaLocalServerReplicaSnapshot) == "function" then
        local Replica = GetAtramentaLocalServerReplicaSnapshot(CurrentTime)
        if Replica and typeof(Replica.RootCFrame) == "CFrame" and (tonumber(Replica.Age) or Infinite) <= 0.18 then
            Source = {RootCFrame = Replica.RootCFrame, Parts = type(Replica.Parts) == "table" and Replica.Parts or nil, Source = "ServerReplica",
                Sequence = Replica.Sequence, VelocityDesync = Replica.VelocityDesync == true,
                VelocityDesyncMethod = Replica.VelocityDesyncMethod, VelocityDesyncMode = Replica.VelocityDesyncMode,
                VelocityDesyncOffset = Replica.VelocityDesyncOffset, VelocityDesyncFakeVelocity = Replica.VelocityDesyncFakeVelocity}
        end
    end
    if not Source then Source = {RootCFrame = Root.CFrame, Parts = self:CaptureParts(Character, self.LocalReferenceState), Source = "Character"} end
    if AntiAimActive then Source = self:ApplyAntiAimToSource(Source, Character, CurrentTime) end
    return Source
end
function BacktrackVisuals:Capture(Player, Character, Root, CurrentTime)
    if not Player or not Character or not Root or not Root.Parent or not self:ShouldTrack(Player) then return end
    local State = self.Records[Player]
    if type(State) ~= "table" or State.Character ~= Character then
        State = {Character = Character, LastSample = 0, Samples = {}, StartIndex = 1, PartReferences = nil, PartReferenceCharacter = nil}
        self.Records[Player] = State
    end
    if CurrentTime - (tonumber(State.LastSample) or 0) < self.RecordInterval then return end
    State.LastSample = CurrentTime
    local RootCFrame local Parts local Source = "Character" local Sequence
    local FakeLag = false local FakePosition = false local FakePositionMode local VelocityDesyncActive = false local VelocityDesyncMethod local VelocityDesyncMode local VelocityDesyncOffset local VelocityDesyncFakeVelocity
    local AntiAim = false local AntiAimMode
    if Player == LocalPlayer then
        local Snapshot = self:GetLocalSource(Character, Root, CurrentTime)
        if not Snapshot or typeof(Snapshot.RootCFrame) ~= "CFrame" then return end
        RootCFrame = Snapshot.RootCFrame
        Parts = type(Snapshot.Parts) == "table" and Snapshot.Parts or nil
        Source = tostring(Snapshot.Source or "Character")
        Sequence = Snapshot.Sequence
        FakeLag = Snapshot.FakeLag == true
        FakePosition = Snapshot.FakePosition == true
        FakePositionMode = Snapshot.FakePositionMode
        VelocityDesyncActive = Snapshot.VelocityDesync == true
        VelocityDesyncMethod = Snapshot.VelocityDesyncMethod
        VelocityDesyncMode = Snapshot.VelocityDesyncMode
        VelocityDesyncOffset = Snapshot.VelocityDesyncOffset
        VelocityDesyncFakeVelocity = Snapshot.VelocityDesyncFakeVelocity
        AntiAim = Snapshot.AntiAim == true
        AntiAimMode = Snapshot.AntiAimMode
    else
        RootCFrame = Root.CFrame
        Parts = self:CaptureParts(Character, State)
    end
    if type(Parts) ~= "table" or next(Parts) == nil then
        Parts = {}
        local CurrentRoot = Root.CFrame
        local References = self:GetPartReferences(Character, State) or {}
        for Name, Part in pairs(References) do
            if Part and Part.Parent == Character then Parts[Name] = RootCFrame * CurrentRoot:ToObjectSpace(Part.CFrame) end
        end
    end
    if next(Parts) == nil then return end
    local Samples = State.Samples
    Samples[#Samples + 1] = {Time = CurrentTime, RootCFrame = RootCFrame, Parts = Parts, Source = Source, Sequence = Sequence,
        FakeLag = FakeLag, FakePosition = FakePosition, FakePositionMode = FakePositionMode, VelocityDesync = VelocityDesyncActive,
        VelocityDesyncMethod = VelocityDesyncMethod, VelocityDesyncMode = VelocityDesyncMode, VelocityDesyncOffset = VelocityDesyncOffset,
        VelocityDesyncFakeVelocity = VelocityDesyncFakeVelocity, AntiAim = AntiAim, AntiAimMode = AntiAimMode}
    if #Samples > self.MaxRecords then Remove(Samples, 1) end
end
function BacktrackVisuals:GetRecord(Player, CurrentTime)
    local State = self.Records[Player]
    if type(State) ~= "table" or type(State.Samples) ~= "table" or #State.Samples == 0 then return nil end
    local Samples = State.Samples
    if Player == LocalPlayer then
        local Latest = Samples[#Samples]
        if Latest and (Latest.FakeLag or Latest.FakePosition or Latest.VelocityDesync or Latest.AntiAim) then
            return CurrentTime - (tonumber(Latest.Time) or 0) <= 1.60 and Latest or nil
        end
    end
    local TargetTime = CurrentTime - self:GetDelay(Player) local Selected = Samples[1]
    for Index = #Samples, 1, -1 do
        local Sample = Samples[Index]
        if Sample.Time <= TargetTime then
            Selected = Sample
            break
        end
    end
    if not Selected or CurrentTime - (tonumber(Selected.Time) or 0) > 0.75 then return nil end
    return Selected
end
function BacktrackVisuals:DestroyObject(Player)
    local Object = self.Objects[Player] if not Object then return end
    if Object.Model then Object.Model:Destroy() end
    self.Objects[Player] = nil
end
function BacktrackVisuals:StripClone(Clone)
    for _, Descendant in ipairs(Clone:GetDescendants()) do
        if Descendant:IsA("JointInstance") or Descendant:IsA("Constraint") or Descendant:IsA("Attachment")
            or Descendant:IsA("Script") or Descendant:IsA("LocalScript") or Descendant:IsA("ParticleEmitter")
            or Descendant:IsA("Trail") or Descendant:IsA("Beam") or Descendant:IsA("BillboardGui")
            or Descendant:IsA("SurfaceGui") or Descendant:IsA("Decal") or Descendant:IsA("Texture") or Descendant:IsA("SurfaceAppearance") then
            Descendant:Destroy()
        elseif Descendant:IsA("SpecialMesh") then
            Descendant.TextureId = ""
        end
    end
end
function BacktrackVisuals:ApplyPartAppearance(Part)
    if not Part or not Part:IsA("BasePart") then return end
    Part.Anchored = true
    Part.CanCollide = false
    Part.CanTouch = false
    Part.CanQuery = false
    Part.CastShadow = false
    Part.Massless = true
    Part.Material = Enum.Material.Neon
    Part.Color = self.Color
    Part.Transparency = Clamp(tonumber(self.Transparency) or 0.68, 0.05, 0.95)
    if Part:IsA("MeshPart") then Part.TextureID = "" end
end
function BacktrackVisuals:CreateXRayAdornment(Part, Parent)
    if not Part or not Part:IsA("BasePart") then return nil end
    local Adornment = NewInstance("BoxHandleAdornment")
    Adornment.Name = "BacktrackXRay"
    Adornment.Adornee = Part
    Adornment.Size = Part.Size + NewVector3(0.035, 0.035, 0.035)
    Adornment.AlwaysOnTop = true
    Adornment.ZIndex = 10
    Adornment.Color3 = self.Color
    Adornment.Transparency = Clamp((tonumber(self.Transparency) or 0.68) * 0.68, 0.10, 0.82)
    Adornment.Visible = self.ThroughWalls == true
    Adornment.Parent = Parent
    return Adornment
end
function BacktrackVisuals:ApplyObjectAppearance(Object)
    if not Object or type(Object.Parts) ~= "table" then return end
    if Object.LastColor == self.Color and Object.LastTransparency == self.Transparency and Object.LastThroughWalls == self.ThroughWalls then
        return
    end
    Object.LastColor = self.Color
    Object.LastTransparency = self.Transparency
    Object.LastThroughWalls = self.ThroughWalls
    for Name, Part in pairs(Object.Parts) do
        self:ApplyPartAppearance(Part)
        local Adornment = Object.XRayParts and Object.XRayParts[Name]
        if Adornment and Adornment.Parent then
            Adornment.Size = Part.Size + NewVector3(0.035, 0.035, 0.035)
            Adornment.Color3 = self.Color
            Adornment.Transparency = Clamp((tonumber(self.Transparency) or 0.68) * 0.68, 0.10, 0.82)
            Adornment.Visible = self.ThroughWalls == true
        end
    end
end
function BacktrackVisuals:BuildObject(Player, Character)
    self:DestroyObject(Player)
    if not Player or not Character then return nil end
    local Root = ResolverGetRootPart(Character)
    if not Root then return nil end
    local Model = NewInstance("Model")
    Model.Name = "Backtrack_" .. tostring(Player.Name)
    local Parts = {}
    local XRayParts = {}
    for Name in pairs(self.BodyParts) do
        local Original = Character:FindFirstChild(Name)
        if Original and Original:IsA("BasePart") and Original.Parent == Character and Original ~= Root and Original.Archivable then
            local VisualSize = Shared.GetPhysicalHbeVisualSize(Original)
            if typeof(VisualSize) == "Vector3" and VisualSize.Magnitude > 12 then continue end
            local ClonePart = Original:Clone()
            if typeof(VisualSize) == "Vector3" then ClonePart.Size = VisualSize end
            self:StripClone(ClonePart)
            self:ApplyPartAppearance(ClonePart)
            ClonePart.Name = Name
            ClonePart.Parent = Model
            Parts[Name] = ClonePart
            XRayParts[Name] = self:CreateXRayAdornment(ClonePart, Model)
        end
    end
    if next(Parts) == nil then
        Model:Destroy()
        return nil
    end
    Model.Parent = self:GetFolder()
    local Object = {Character = Character, Root = Root, Model = Model, Parts = Parts, XRayParts = XRayParts, Visible = true, Source = "Character"}
    self.Objects[Player] = Object
    self:ApplyObjectAppearance(Object)
    return Object
end
function BacktrackVisuals:SetObjectVisible(Object, Visible)
    if not Object or not Object.Model then return end
    if Visible then
        if Object.Model.Parent ~= self:GetFolder() then Object.Model.Parent = self:GetFolder() end
    elseif Object.Model.Parent then
        Object.Model.Parent = nil
    end
    Object.Visible = Visible == true
end
function BacktrackVisuals:RefreshAppearance()
    for _, Object in pairs(self.Objects) do
        if Object then
            Object.LastColor = nil
            Object.LastTransparency = nil
            Object.LastThroughWalls = nil
            self:ApplyObjectAppearance(Object)
        end
    end
end
function BacktrackVisuals:UpdatePlayer(Player, CurrentTime, LocalRoot)
    if not Player or Player.Parent ~= Players or not self:ShouldTrack(Player) then
        if Player then
            self:DestroyObject(Player)
            self.Records[Player] = nil
        end
        return
    end
    local Character = Player == LocalPlayer and LocalPlayer.Character or ResolveTrackedCharacter(Player, Player.Character) or Player.Character
    local Root = Character and ResolverGetRootPart(Character)
    if not Character or not Root or not Root.Parent then
        self:DestroyObject(Player)
        self.Records[Player] = nil
        return
    end
    self:Capture(Player, Character, Root, CurrentTime)
    if Player ~= LocalPlayer and LocalRoot and (Root.Position - LocalRoot.Position).Magnitude > Max(tonumber(self.MaxDistance) or 1800, 100) then
        local Object = self.Objects[Player]
        if Object then self:SetObjectVisible(Object, false) end
        return
    end
    local Record = self:GetRecord(Player, CurrentTime) local Object = self.Objects[Player]
    if not Record or type(Record.Parts) ~= "table" then
        if Object then self:SetObjectVisible(Object, false) end
        return
    end
    if not Object or Object.Character ~= Character or Object.Root ~= Root or not Object.Model then Object = self:BuildObject(Player, Character) end
    if not Object then return end
    self:SetObjectVisible(Object, true)
    Object.Source = tostring(Record.Source or "Character")
    Object.Sequence = Record.Sequence
    Object.FakeLag = Record.FakeLag == true
    Object.FakePosition = Record.FakePosition == true
    Object.FakePositionMode = Record.FakePositionMode
    Object.VelocityDesync = Record.VelocityDesync == true
    Object.VelocityDesyncMethod = Record.VelocityDesyncMethod
    Object.VelocityDesyncMode = Record.VelocityDesyncMode
    Object.VelocityDesyncOffset = Record.VelocityDesyncOffset
    Object.VelocityDesyncFakeVelocity = Record.VelocityDesyncFakeVelocity
    Object.AntiAim = Record.AntiAim == true
    Object.AntiAimMode = Record.AntiAimMode
    self:ApplyObjectAppearance(Object)
    local CurrentRootCFrame = Root.CFrame
    for Name, Clone in pairs(Object.Parts) do
        local Historical = Record.Parts[Name]
        if typeof(Historical) == "CFrame" then
            Clone.CFrame = Historical
        else
            local CurrentPart = Character:FindFirstChild(Name)
            if CurrentPart and CurrentPart:IsA("BasePart") and typeof(Record.RootCFrame) == "CFrame" then
                Clone.CFrame = Record.RootCFrame * CurrentRootCFrame:ToObjectSpace(CurrentPart.CFrame)
            end
        end
    end
end
function BacktrackVisuals:Step(DeltaTime)
    if not self.Enabled then return end
    local CurrentTime = Clock()
    self:UpdateTiming(DeltaTime, CurrentTime)
    self.Clock += Clamp(tonumber(DeltaTime) or 0, 0, 0.10)
    if self.Clock < self.RecordInterval then return end
    self.Clock = self.Clock % self.RecordInterval
    local Character = LocalPlayer.Character local LocalRoot = Character and ResolverGetRootPart(Character) local CachedPlayers = self.Players local Count = #CachedPlayers
    if Count == 0 then
        self.Cursor = 1
        return
    end
    local Divisor = Count >= 24 and 3 or Count >= 12 and 2 or 1 local BatchSize = Max(1, Ceil(Count / Divisor))
    local Cursor = Clamp(Floor(tonumber(self.Cursor) or 1), 1, Count)
    for Offset = 0, BatchSize - 1 do
        local Index = ((Cursor + Offset - 1) % Count) + 1 local Player = CachedPlayers[Index]
        if Player and Player.Parent == Players and self:ShouldTrack(Player) then self:UpdatePlayer(Player, CurrentTime, LocalRoot) end
    end
    self.Cursor = ((Cursor + BatchSize - 1) % Count) + 1
end
function BacktrackVisuals:DisconnectRuntime()
    if self.Connection then
        Shared.SafeDisconnect(self.Connection)
        self.Connection = nil
    end
    if self.PlayerAddedConnection then
        Shared.SafeDisconnect(self.PlayerAddedConnection)
        self.PlayerAddedConnection = nil
    end
    if self.PlayerRemovingConnection then
        Shared.SafeDisconnect(self.PlayerRemovingConnection)
        self.PlayerRemovingConnection = nil
    end
end
function BacktrackVisuals:SetEnabled(Value)
    Value = Value == true
    if self.Enabled == Value then return end
    self.Enabled = Value
    if self.Enabled then
        self:GetFolder()
        self:RebuildPlayerCache()
        InstallDesyncNetworkHook()
        self.PlayerAddedConnection = Players.PlayerAdded:Connect(function(Player)
            BacktrackVisuals:AddPlayer(Player)
        end)
        self.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(Player)
            BacktrackVisuals:RemovePlayer(Player)
        end)
        self.Connection = RunService.RenderStepped:Connect(function(DeltaTime)
            Shared.SafeCall(BacktrackVisuals.Step, BacktrackVisuals, DeltaTime)
        end)
    else
        self:DisconnectRuntime()
        for Player in pairs(self.Objects) do
            self:DestroyObject(Player)
        end
        Clear(self.Records)
        Clear(self.Players)
        self.PlayerSet = setmetatable({}, {__mode = "k"})
        self.LocalStableSnapshot = nil
        self.LocalReferenceState = nil
        self.Clock = 0
    end
end
function BacktrackVisuals:Destroy()
    self.Enabled = false
    self:DisconnectRuntime()
    for Player in pairs(self.Objects) do
        self:DestroyObject(Player)
    end
    Clear(self.Records)
    Clear(self.Players)
    self.PlayerSet = setmetatable({}, {__mode = "k"})
    self.LocalStableSnapshot = nil
    self.LocalReferenceState = nil
    if self.Folder then
        self.Folder:Destroy()
        self.Folder = nil
    end
end
