function AvatarChangerCacheExactAccessories(UserId, SourceModel)
    UserId = tonumber(UserId)
    if not UserId or UserId < 1 or not SourceModel then
        return 0
    end
    local Previous = AvatarChangerState.AccessoryCache[UserId]
    if type(Previous) == "table" then
        for Index = 1, #Previous do
            local Object = Previous[Index]
            if typeof(Object) == "Instance" then Shared.SafeCall(Object.Destroy, Object) end
        end
    end
    local Cache = {}
    local Keys = {}
    for _, Object
        in ipairs(SourceModel:GetDescendants()) do
        if Object:IsA("Accessory") and not Object:FindFirstAncestorOfClass("Accessory") then
            local Key = AvatarChangerObjectKey(Object)
            if not Key or Keys[Key] ~= true then
                if Key then Keys[Key] = true end
                local Success, Clone = Shared.SafeCall(Object.Clone, Object)
                if Success and typeof(Clone) == "Instance" and Clone:IsA("Accessory") then Cache[#Cache + 1] = Clone end
            end
        end
    end
    AvatarChangerState.AccessoryCache[UserId] = Cache
    AvatarChangerState.AccessoryKeys[UserId] = Keys
    return #Cache
end

function AvatarChangerGetCurrentAccessoryMap(Character)
    local Map = {}
    if not Character then
        return Map
    end
    for _, Object
        in ipairs(Character:GetChildren()) do
        if Object:IsA("Accessory") then
            local Key = AvatarChangerObjectKey(Object)
            if Key then Map[Key] = Object end
        end
    end
    return Map
end

function AvatarChangerApplyCachedAccessories(Character, Humanoid, UserId, ExactSet)
    UserId = tonumber(UserId)
    if not Character or not Character.Parent or not Humanoid or not Humanoid.Parent or not UserId then
        return false, 0
    end
    local Cache = AvatarChangerState.AccessoryCache[UserId]
    if type(Cache) ~= "table" then
        return false, 0
    end
    local DesiredKeys = AvatarChangerState.AccessoryKeys[UserId]
    DesiredKeys = type(DesiredKeys) == "table" and DesiredKeys or {}
    if ExactSet == true then
        for _, Current
            in ipairs(Character:GetChildren()) do
            if Current:IsA("Accessory") then
                local Key = AvatarChangerObjectKey(Current)
                if not Key or DesiredKeys[Key] ~= true then Shared.SafeCall(Current.Destroy, Current) end
            end
        end
    end
    local CurrentMap = AvatarChangerGetCurrentAccessoryMap(Character)
    local Added = 0
    for Index = 1, #Cache do
        local Source = Cache[Index]
        if Source and Source:IsA("Accessory") then
            local Key = AvatarChangerObjectKey(Source)
            local Existing = Key and CurrentMap[Key] or nil
            if Existing and Existing.Parent == Character then
                AvatarChangerEnsureAccessoryWeld(Character, Existing)
            else
                if AvatarChangerCloneIntoCharacter(Character, Humanoid, Source) then Added += 1 end
            end
        end
    end
    AvatarChangerRepairAccessories(Character, Humanoid)
    return true, Added
end

function AvatarChangerObjectKey(Object)
    if not Object then return nil end
    if Object:IsA("Accessory") then
        local Handle = Object:FindFirstChild("Handle")
        local MeshId = Handle and Handle:IsA("MeshPart") and tostring(Handle.MeshId or "") or ""
        local TextureId = Handle and Handle:IsA("MeshPart") and tostring(Handle.TextureID or "") or ""
        local SpecialMesh = Handle and Handle:FindFirstChildOfClass("SpecialMesh")
        if SpecialMesh then
            MeshId = tostring(SpecialMesh.MeshId or MeshId)
            TextureId = tostring(SpecialMesh.TextureId or TextureId)
        end
        return "Accessory|" .. tostring(Object.Name) .. "|" .. MeshId .. "|" .. TextureId
    end
    if Object:IsA("CharacterMesh") then
        return "CharacterMesh|" .. tostring(Object.BodyPart) .. "|" .. tostring(Object.MeshId)
    end
    return Object.ClassName
end

function AvatarChangerApplySourceObjects(Character, Humanoid, SourceModel, Seen)
    if not SourceModel then return end
    Seen = type(Seen) == "table" and Seen or {}
    for _, Object in ipairs(SourceModel:GetDescendants()) do
        if AvatarChangerIsManagedObject(Object) and not Object:IsA("Accessory") then
            local ParentAccessory = Object:FindFirstAncestorOfClass("Accessory")
            if not ParentAccessory then
                local Key = AvatarChangerObjectKey(Object)
                if not Key or Seen[Key] ~= true then
                    if Key then Seen[Key] = true end
                    AvatarChangerCloneIntoCharacter(Character, Humanoid, Object)
                end
            end
        end
    end
    for _, Object in ipairs(SourceModel:GetDescendants()) do
        if Object:IsA("Accessory") and not Object:FindFirstAncestorOfClass("Accessory") then
            local Key = AvatarChangerObjectKey(Object)
            if not Key or Seen[Key] ~= true then
                if Key then Seen[Key] = true end
                AvatarChangerCloneIntoCharacter(Character, Humanoid, Object)
            end
        end
    end
end

function AvatarChangerApplyHeadVisuals(Character, SourceModel, Seen)
    if not Character or not SourceModel then return end
    Seen = type(Seen) == "table" and Seen or {}
    local RealHead = Character:FindFirstChild("Head")
    local SourceHead = SourceModel:FindFirstChild("Head", true)
    if not RealHead or not RealHead:IsA("BasePart") or not SourceHead or not SourceHead:IsA("BasePart") then return end
    for _, Object in ipairs(SourceHead:GetChildren()) do
        local LowerName = Lower(tostring(Object.Name or ""))
        if Object:IsA("Decal") or Object:IsA("Texture") or Object:IsA("SpecialMesh") or Object:IsA("SurfaceAppearance") then
            local Key
            if Object:IsA("Decal") or Object:IsA("Texture") then
                Key = "HeadTexture|" .. tostring(Object.Texture)
            elseif Object:IsA("SpecialMesh") then
                Key = "HeadMesh|" .. tostring(Object.MeshId) .. "|" .. tostring(Object.TextureId)
            else
                Key = "HeadSurface|" .. tostring(Object.ColorMap or "") .. "|" .. tostring(Object.NormalMap or "")
            end
            if Seen[Key] ~= true then
                Seen[Key] = true
                local Success, Clone = Shared.SafeCall(Object.Clone, Object)
                if Success and typeof(Clone) == "Instance" then
                    Shared.SafeCall(function() Clone:SetAttribute("AtramentaAvatarChanger", true) end)
                    Clone.Parent = RealHead
                end
            end
        end
    end
end

function AvatarChangerApplyHumanoidDescription(Humanoid, Description)
    if not Humanoid or not Humanoid.Parent or typeof(Description) ~= "Instance" or not Description:IsA("HumanoidDescription") then
        return false
    end
    local Success
    if type(Humanoid.ApplyDescriptionResetAsync) == "function" then
        Success = select(1, Shared.SafeCall(function()
                    Humanoid:ApplyDescriptionResetAsync(Description)
                end))
    end
    if Success then
        return true
    end
    Success = select(1, Shared.SafeCall(function()
                Humanoid:ApplyDescriptionReset(Description)
            end))
    if Success then
        return true
    end
    if type(Humanoid.ApplyDescriptionAsync) == "function" then
        Success = select(1, Shared.SafeCall(function()
                    Humanoid:ApplyDescriptionAsync(Description)
                end))
    end
    if Success then
        return true
    end
    Success = select(1, Shared.SafeCall(function()
                Humanoid:ApplyDescription(Description)
            end))
    return Success == true
end

function AvatarChangerRepairAccessories(Character, Humanoid)
    if not Character or not Character.Parent or not Humanoid or not Humanoid.Parent then
        return
    end
    for _, Accessory
        in ipairs(Character:GetChildren()) do
        if Accessory:IsA("Accessory") then
            local Handle = Accessory:FindFirstChild("Handle")
            if Handle and Handle:IsA("BasePart") then
                Handle.CanCollide = false
                Handle.Massless = true
                AvatarChangerEnsureAccessoryWeld(Character, Accessory)
            end
        end
    end
end

function AvatarChangerApplyTemplate(Character, Humanoid, Template, AppearanceModel)
    if not Character or not Character.Parent or not Humanoid or not Humanoid.Parent then return false end
    if not Template and not AppearanceModel then return false end
    AvatarChangerClearAppearance(Character)
    if AppearanceModel then AvatarChangerCopyRigAttachments(Character, AppearanceModel) end
    if Template then AvatarChangerCopyRigAttachments(Character, Template) end
    local Seen = {}
    if AppearanceModel then AvatarChangerApplySourceObjects(Character, Humanoid, AppearanceModel, Seen) end
    if Template then AvatarChangerApplySourceObjects(Character, Humanoid, Template, Seen) end
    local HeadSeen = {}
    if AppearanceModel then AvatarChangerApplyHeadVisuals(Character, AppearanceModel, HeadSeen) end
    if Template then AvatarChangerApplyHeadVisuals(Character, Template, HeadSeen) end
    return true
end

function AvatarChangerRefreshCharacterVisuals()
    Defer(function()
        if type(HeadHitbox) == "table" then
            if type(HeadHitbox.Refresh) == "function" then Shared.SafeCall(HeadHitbox.Refresh) end
            if type(HeadHitbox.UpdatePhysicalSize) == "function" then Shared.SafeCall(HeadHitbox.UpdatePhysicalSize) end
        end
        if ExtendedVisuals and type(ExtendedVisuals.RefreshCharacterMaterialRender) == "function" then
            Shared.SafeCall(function() ExtendedVisuals:RefreshCharacterMaterialRender() end)
        end
    end)
end

function AvatarChangerApplyDescriptionToHumanoid(Humanoid, Description, UserId)
    local Character = Humanoid and Humanoid.Parent
    UserId = tonumber(UserId)
    if not Character or not Character:IsA("Model") or not UserId or UserId < 1 or typeof(Description) ~= "Instance" or not Description:IsA("HumanoidDescription") then
        return false
    end
    AvatarChangerCaptureOriginal(Character, Humanoid)
    local AppearanceModel = AvatarChangerBuildAppearanceModel(UserId)
    local Template = AvatarChangerBuildTemplate(Description, Humanoid.RigType)
    if AppearanceModel then
        AvatarChangerCacheExactAccessories(UserId, AppearanceModel)
        AvatarChangerCopyRigAttachments(Character, AppearanceModel)
    elseif Template then
        AvatarChangerCacheExactAccessories(UserId, Template)
    end
    if Template then AvatarChangerCopyRigAttachments(Character, Template) end
    local DirectApplied = AvatarChangerApplyHumanoidDescription(Humanoid, Description)
    if DirectApplied ~= true then
        if not Template and not AppearanceModel then
            return false
        end
        DirectApplied = AvatarChangerApplyTemplate(Character, Humanoid, Template, AppearanceModel) == true
    else
        local Seen = {}
        for _, Object
            in ipairs(Character:GetDescendants()) do
            if AvatarChangerIsManagedObject(Object) then
                local ParentAccessory = Object:FindFirstAncestorOfClass("Accessory")
                if Object:IsA("Accessory") or not ParentAccessory then
                    local Key = AvatarChangerObjectKey(Object)
                    if Key then Seen[Key] = true end
                end
            end
        end
        if AppearanceModel then AvatarChangerApplySourceObjects(Character, Humanoid, AppearanceModel, Seen) end
        if Template then AvatarChangerApplySourceObjects(Character, Humanoid, Template, Seen) end
        local HeadSeen = {}
        local RealHead = Character:FindFirstChild("Head")
        if RealHead then
            for _, Object
                in ipairs(RealHead:GetChildren()) do
                if Object:IsA("Decal") or Object:IsA("Texture") then
                    HeadSeen["HeadTexture|" .. tostring(Object.Texture)] = true
                elseif Object:IsA("SpecialMesh") then
                    HeadSeen["HeadMesh|" .. tostring(Object.MeshId) .. "|" .. tostring(Object.TextureId)] = true
                elseif Object:IsA("SurfaceAppearance") then
                    HeadSeen["HeadSurface|" .. tostring(Object.ColorMap or "") .. "|" .. tostring(Object.NormalMap or "")] = true
                end
            end
        end
        if AppearanceModel then AvatarChangerApplyHeadVisuals(Character, AppearanceModel, HeadSeen) end
        if Template then AvatarChangerApplyHeadVisuals(Character, Template, HeadSeen) end
    end
    AvatarChangerApplyCachedAccessories(Character, Humanoid, UserId, true)
    if Template then Shared.SafeCall(Template.Destroy, Template) end
    if AppearanceModel then Shared.SafeCall(AppearanceModel.Destroy, AppearanceModel) end
    AvatarChangerRepairAccessories(Character, Humanoid)
    Defer(function()
        if Character and Character.Parent and Humanoid and Humanoid.Parent then AvatarChangerApplyCachedAccessories(Character, Humanoid, UserId, true) end
    end)
    Delay(0.20, function()
        if AvatarChangerState.Enabled == true and AvatarChangerState.TargetUserId == UserId and Character and Character.Parent and Humanoid and Humanoid.Parent then
            AvatarChangerApplyCachedAccessories(Character, Humanoid, UserId, true)
        end
    end)
    return DirectApplied == true
end

function AvatarChangerWaitForCharacterReady(Character, Timeout)
    if not Character or not Character.Parent then return nil end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or not Humanoid.Parent then
        Shared.WaitForConditionSignal(function()
            Humanoid = Character:FindFirstChildOfClass("Humanoid")
            return Humanoid ~= nil and Humanoid.Parent ~= nil
        end, Max(tonumber(Timeout) or 4, 0.25), {Character.ChildAdded, Character.AncestryChanged})
    end
    if not Humanoid or not Humanoid.Parent or Humanoid.Health <= 0 then return nil end
    return Humanoid
end

function AvatarChangerApplyDescription(UserId, Name, DisplayName, Generation, NotifySuccess)
    if AvatarChangerState.Enabled ~= true or Generation ~= AvatarChangerState.Generation then return false end
    local Description = GetAvatarDescription(UserId)
    if not Description then
        if NotifySuccess then NotifyAvatarChanger("avatar changer", "failed to load avatar") end
        return false
    end
    if AvatarChangerState.Enabled ~= true or Generation ~= AvatarChangerState.Generation then return false end
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if not Character or not Character.Parent or not Humanoid or Humanoid.Health <= 0 then return false end
    AvatarChangerCaptureOriginal(Character, Humanoid)
    AvatarChangerState.TargetUserId = UserId
    AvatarChangerState.TargetName = tostring(Name or "")
    AvatarChangerState.TargetDisplayName = tostring(DisplayName or "")
    local ApplySuccess = AvatarChangerApplyDescriptionToHumanoid(Humanoid, Description, UserId)
    if ApplySuccess ~= true then
        if NotifySuccess then NotifyAvatarChanger("avatar changer", "failed to build/apply avatar") end
        return false
    end
    AvatarChangerState.LastAppliedCharacter = Character
    AvatarChangerState.LastAppliedAt = Clock()
    AvatarChangerRefreshCharacterVisuals()
    for _, RetryDelay in ipairs({0.25, 0.75, 1.50}) do
        Delay(RetryDelay, function()
            if AvatarChangerState.Enabled ~= true or Generation ~= AvatarChangerState.Generation or LocalPlayer.Character ~= Character then return end
            local LiveHumanoid = Character:FindFirstChildOfClass("Humanoid")
            if not LiveHumanoid or LiveHumanoid.Health <= 0 then return end
            local RetryDescription = GetAvatarDescription(UserId)
            if RetryDescription then
                AvatarChangerApplyDescriptionToHumanoid(LiveHumanoid, RetryDescription, UserId)
                AvatarChangerRefreshCharacterVisuals()
            end
        end)
    end
    if NotifySuccess then
        local Label = AvatarChangerState.TargetName ~= "" and ("@" .. AvatarChangerState.TargetName) or tostring(UserId)
        NotifyAvatarChanger("avatar changer", Label .. " [" .. tostring(UserId) .. "]")
    end
    return true
end

function AvatarChangerApplyQuery(NotifyErrors)
    AvatarChangerState.Generation += 1
    local Generation = AvatarChangerState.Generation
    local Query = AvatarChangerState.Query
    Spawn(function()
        local UserId, Name, DisplayName, Error = ResolveAvatarChangerUserID(Query)
        if AvatarChangerState.Enabled ~= true or Generation ~= AvatarChangerState.Generation then return end
        if not UserId then
            if NotifyErrors then NotifyAvatarChanger("avatar changer", Error == "empty" and "enter username, user id or display name" or "user not found") end
            return
        end
        AvatarChangerApplyDescription(UserId, Name, DisplayName, Generation, NotifyErrors == true)
    end)
end

function AvatarChangerRestore()
    AvatarChangerState.Generation += 1
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if not Character or not Humanoid then
        AvatarChangerState.TargetUserId = nil
        return
    end
    local Snapshot = AvatarChangerState.OriginalDescriptions[Character]
    if type(Snapshot) == "table" and Snapshot.Captured == true then
        local RestoredDescription = Snapshot.Description and AvatarChangerApplyHumanoidDescription(Humanoid, Snapshot.Description) == true
        if not RestoredDescription then AvatarChangerClearAppearance(Character) end
        for _, Object in ipairs(Snapshot.Objects or {}) do
            local Key = AvatarChangerObjectKey(Object)
            local Exists = false
            if Key then
                for _, Current in ipairs(Character:GetDescendants()) do
                    if AvatarChangerIsManagedObject(Current) and AvatarChangerObjectKey(Current) == Key then Exists = true break end
                end
            end
            if not Exists then AvatarChangerCloneIntoCharacter(Character, Humanoid, Object) end
        end
        local Head = Character:FindFirstChild("Head")
        if Head and Head:IsA("BasePart") then
            for _, Object in ipairs(Snapshot.FaceObjects or {}) do
                local Success, Clone = Shared.SafeCall(Object.Clone, Object)
                if Success and typeof(Clone) == "Instance" and not Head:FindFirstChild(Clone.Name) then Clone.Parent = Head end
            end
            for _, Object in ipairs(Snapshot.HeadMeshes or {}) do
                local Success, Clone = Shared.SafeCall(Object.Clone, Object)
                if Success and typeof(Clone) == "Instance" and not Head:FindFirstChildOfClass(Clone.ClassName) then Clone.Parent = Head end
            end
        end
        AvatarChangerRepairAccessories(Character, Humanoid)
    else
        local Description = GetAvatarDescription(LocalPlayer.UserId)
        if Description then AvatarChangerApplyDescriptionToHumanoid(Humanoid, Description, LocalPlayer.UserId) end
    end
    AvatarChangerRefreshCharacterVisuals()
    local PreviousTarget = tonumber(AvatarChangerState.TargetUserId)
    AvatarChangerState.TargetUserId = nil
    AvatarChangerState.TargetName = ""
    AvatarChangerState.TargetDisplayName = ""
    if PreviousTarget then
        local Cached = AvatarChangerState.AccessoryCache[PreviousTarget]
        if type(Cached) == "table" then
            for Index = 1, #Cached do
                local Object = Cached[Index]
                if typeof(Object) == "Instance" then Shared.SafeCall(Object.Destroy, Object) end
            end
        end
        AvatarChangerState.AccessoryCache[PreviousTarget] = nil
        AvatarChangerState.AccessoryKeys[PreviousTarget] = nil
    end
end

function AvatarChangerSetEnabled(Value)
    Value = Value == true
    if AvatarChangerState.Enabled == Value then
        if Value then AvatarChangerApplyQuery(true) end
        return
    end
    AvatarChangerState.Enabled = Value
    if Value then AvatarChangerApplyQuery(true) else AvatarChangerRestore() end
end

function AvatarChangerSetQuery(Value)
    AvatarChangerState.Query = tostring(Value or "")
    AvatarChangerState.InputRevision += 1
    if AvatarChangerState.Enabled ~= true then return end
    local Revision = AvatarChangerState.InputRevision
    Delay(0.50, function()
        if AvatarChangerState.Enabled == true and Revision == AvatarChangerState.InputRevision then AvatarChangerApplyQuery(false) end
    end)
end

if AvatarChangerState.CharacterAddedConnection and typeof(AvatarChangerState.CharacterAddedConnection) == "RBXScriptConnection" then
    Shared.SafeDisconnect(AvatarChangerState.CharacterAddedConnection)
end

AvatarChangerState.CharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(Character)
    if AvatarChangerState.Enabled ~= true then return end
    local Revision = AvatarChangerState.Generation
    Spawn(function()
        local Humanoid = AvatarChangerWaitForCharacterReady(Character, 8)
        if not Humanoid or AvatarChangerState.Enabled ~= true or LocalPlayer.Character ~= Character then return end
        local AppearanceSignal = LocalPlayer.CharacterAppearanceLoaded
        Shared.WaitForConditionSignal(function()
            if AvatarChangerState.Enabled ~= true or LocalPlayer.Character ~= Character then return true end
            local Ready = false
            Shared.SafeCall(function() Ready = LocalPlayer:HasAppearanceLoaded() end)
            return Ready == true
        end, 2.0, {AppearanceSignal, Shared.GetPropertyChangedSignalSafe(LocalPlayer, "Character"), Character.AncestryChanged})
        if AvatarChangerState.Enabled ~= true or LocalPlayer.Character ~= Character then return end
        if Revision <= AvatarChangerState.Generation then AvatarChangerApplyQuery(false) end
    end)
end)

