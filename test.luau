function BindWorldSafeState(Data)
    if type(Data) ~= "table" or Data.Kind ~= "SAFE" then return end
    local Object = Data.Object
    if not Object or Visuals.WorldESP.Objects[Object] ~= Data then return end
    Data.Connections = type(Data.Connections) == "table" and Data.Connections or {}
    for _, Name in ipairs({"BrokenValue", "SafeDescendantAdded", "SafeDescendantRemoving"}) do
        local Connection = Data.Connections[Name]
        if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
        Data.Connections[Name] = nil
    end
    local function QueueStateRefresh(Rebind)
        if Data.RefreshQueued then
            if Rebind then Data.RebindQueued = true end
            return
        end
        Data.RefreshQueued = true
        Data.RebindQueued = Rebind == true
        Defer(function()
            if Visuals.WorldESP.Objects[Object] ~= Data then return end
            local ShouldRebind = Data.RebindQueued == true
            Data.RefreshQueued = false
            Data.RebindQueued = false
            if ShouldRebind then BindWorldSafeState(Data) end
            RefreshWorldESPEntry(Object, true)
        end)
    end
    local Broken = GetWorldObjectBrokenValue(Object)
    Data.BrokenValue = Broken
    if Broken then
        Data.Connections.BrokenValue = Broken:GetPropertyChangedSignal("Value"):Connect(function()
            QueueStateRefresh(false)
        end)
    end
    Data.Connections.SafeDescendantAdded = Object.DescendantAdded:Connect(function(Descendant)
        local Name = Descendant.Name
        if Name == "Values" or Name == "Broken" or Descendant:IsA("BasePart") then QueueStateRefresh(Name == "Values" or Name == "Broken") end
    end)
    Data.Connections.SafeDescendantRemoving = Object.DescendantRemoving:Connect(function(Descendant)
        local Name = Descendant.Name
        if Descendant == Data.BrokenValue or Name == "Values" or Name == "Broken" or Descendant == Data.Adornee then QueueStateRefresh(true) end
    end)
end
