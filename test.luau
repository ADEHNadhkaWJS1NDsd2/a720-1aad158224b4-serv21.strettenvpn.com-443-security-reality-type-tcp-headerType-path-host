function CombatLogRuntime.CleanWeaponName(Name)
    Name=tostring(Name or "unknown")
    Name=Name:gsub("^%["," "):gsub("%]$",""):gsub("^%s+",""):gsub("%s+$","")
    return Name~="" and Name or "unknown"
