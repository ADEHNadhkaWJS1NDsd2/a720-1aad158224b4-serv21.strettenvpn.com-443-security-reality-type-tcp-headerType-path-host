        Ui.AmmoBack.Size = NewUDim2(1, 0, 0, 3)
        Ui.AmmoBack.BackgroundColor3 = Visuals.Player.Ammo.BackColor
        Ui.Ammo.Position = NewUDim2(0, AmmoOffset.X, 1, BottomOffset + 2 + AmmoOffset.Y)
        Ui.Ammo.Size = NewUDim2(Ratio, 0, 0, 3)
        Ui.Ammo.BackgroundColor3 = Visuals.Player.Ammo.Color
        if Ui.AmmoText.Visible then
            Ui.AmmoText.Text = Format("%d/%d", Floor(AmmoCurrent + 0.5), Floor(AmmoMaximum + 0.5))
            Ui.AmmoText.TextSize = TextSize
            Ui.AmmoText.TextColor3 = Visuals.Player.Ammo.Color
            Ui.AmmoText.AnchorPoint = NewVector2(0.5, 0)
            Ui.AmmoText.Position = NewUDim2(0.5, AmmoOffset.X, 1, BottomOffset + 7 + AmmoOffset.Y)
            Ui.AmmoText.Size = FromOffset(80, 14)
        end
    end
    Ui.AvatarBack.Visible = Visuals.Player.ProfilePicture == true
    Ui.AvatarBack.Position = NewUDim2(1, 5 + AvatarOffset.X, 0, AvatarOffset.Y)
    Ui.AvatarBack.Size = FromOffset(PictureSize + 2, PictureSize + 2)
    Ui.Avatar.Position = FromOffset(1, 1)
    Ui.Avatar.Size = FromOffset(PictureSize, PictureSize)
    if Ui.AvatarBack.Visible then UpdatePlayerUIThumbnail(Data, Ui) end
end
function UpdateCornerProjectionOnly(Data, Position, Size)
    if not Data or Data.CornersReady ~= true then return end
    local Width, Height = Size.X, Size.Y
    local Ratio = Clamp(tonumber(Visuals.Player.CornerLength) or 0.28, 0.10, 0.50)
    local CornerWidth = Max(Width * Ratio, 4)
    local CornerHeight = Max(Height * Ratio, 5)
    local X, Y = Position.X, Position.Y
    local Right, Bottom = X + Width, Y + Height
    local Points = {{X, Y, X + CornerWidth, Y}, {X, Y, X, Y + CornerHeight}, {Right, Y, Right - CornerWidth, Y}, {Right, Y, Right, Y + CornerHeight},
        {X, Bottom, X + CornerWidth, Bottom}, {X, Bottom, X, Bottom - CornerHeight}, {Right, Bottom, Right - CornerWidth, Bottom}, {Right, Bottom, Right, Bottom - CornerHeight}
    }
    for Index = 1, 8 do
        local Point = Points[Index]
        local From = NewVector2(Point[1], Point[2])
        local To = NewVector2(Point[3], Point[4])
        local Outline = Data.CornerOutlines[Index]
        local Corner = Data.Corners[Index]
        if Outline and Outline.Visible then
            Outline.From = From
            Outline.To = To
        end
        if Corner and Corner.Visible then
            Corner.From = From
            Corner.To = To
            if BoxGradientAffectsBox() then Corner.Color = GetBoxGradientColor(GetBoxGradientAlpha(Position, Size, (From + To) * 0.5)) end
        end
    end
end
function UpdateGlowProjectionOnly(Data, Position, Size)
    if not Data or not Data.OverlayPrimitives then return end
    local Settings = Visuals.Player.BoxGlow
    local Spread = Clamp(tonumber(Settings.Spread) or 2, 0.5, 8)
    for Index = 1, 6 do
        local Box = Data.OverlayPrimitives["GlowBox" .. Index]
        if Box and Box.Visible then
            local Expansion = Index * Spread
            Box.Position = Position - NewVector2(Expansion, Expansion)
            Box.Size = Size + NewVector2(Expansion * 2, Expansion * 2)
        end
    end
end
function ApplyPlayerOverlayBoxState(Data, Position, Size)
    if not Data or not Data.OverlayReady or typeof(Position) ~= "Vector2" or typeof(Size) ~= "Vector2" then return false end
    local OverlayPrimitives = Data.OverlayPrimitives
    local Visible = Data.VisualHidden ~= true and Data.ESPEligible == true
    local BoxesEnabled = Visible and Visuals.Player.Boxes == true
    local FullBox = BoxesEnabled and Visuals.Player.BoxStyle == "Full"
    local CornerBox = BoxesEnabled and Visuals.Player.BoxStyle == "Corners"
    local OutlineEnabled = Visuals.Player.OutlineEnabled ~= false
    local Color = Data.LastESPColor or Visuals.Player.BoxColor
    local OutlineColor = Data.LastESPOutline or Visuals.Player.OutlineColor
    local GradientBox = FullBox and BoxGradientAffectsBox()
    local GradientFill = Visible and Visuals.Player.Fill == true and BoxGradientAffectsFill()
    if OverlayPrimitives.BoxOutline then
        OverlayPrimitives.BoxOutline.Visible = FullBox and OutlineEnabled
        OverlayPrimitives.BoxOutline.Position = Position
        OverlayPrimitives.BoxOutline.Size = Size
        OverlayPrimitives.BoxOutline.Color = OutlineColor
        OverlayPrimitives.BoxOutline.Thickness = GetPlayerESPOutlineStrokeThickness()
        OverlayPrimitives.BoxOutline.Transparency = 1 - Clamp(tonumber(Visuals.Player.OutlineTransparency) or 0.05, 0, 0.95)
    end
    if OverlayPrimitives.Box then
        OverlayPrimitives.Box.Visible = FullBox and not GradientBox
        OverlayPrimitives.Box.Position = Position
        OverlayPrimitives.Box.Size = Size
        OverlayPrimitives.Box.Color = Color
        OverlayPrimitives.Box.Thickness = Max(tonumber(Visuals.Player.BoxThickness) or 1, 1)
        OverlayPrimitives.Box.Transparency = 1 - Clamp(tonumber(Visuals.Player.BoxTransparency) or 0, 0, 0.95)
    end
    if CornerBox then UpdateCornerBox(Data, Position, Size, Color, OutlineColor, true) else HideCornerBox(Data) end
    if GradientBox then UpdateFullBoxGradient(Data, Position, Size, true) else HideFullBoxGradient(Data) end
    if OverlayPrimitives.Fill then
        OverlayPrimitives.Fill.Visible = Visible and Visuals.Player.Fill == true and not GradientFill
        OverlayPrimitives.Fill.Position = Position
        OverlayPrimitives.Fill.Size = Size
        OverlayPrimitives.Fill.Color = Visuals.Player.FillColor
        OverlayPrimitives.Fill.Transparency = 1 - Clamp(tonumber(Visuals.Player.FillTransparency) or 0.82, 0, 1)
    end
    if GradientFill then UpdateOverlayFillGradient(Data, Position, Size) else HideOverlayFillGradient(Data) end
    if Visible and Visuals.Player.BoxGlow.Enabled and Visuals.Player.Boxes == true then UpdateBoxGlow(Data, Position, Size, Color) else HideBoxGlow(Data) end
    return Visible
end

function UpdatePlayerOverlayProjection(Data, CameraObject, Position, Size, RootScreen, HeadScreen, FeetScreen, CurrentTime)
    if not Data then return end
    local OverlayPrimitives = Data.OverlayPrimitives
    local Color = Data.LastESPColor or Visuals.Player.BoxColor
    local TextSize = Shared.GetESPTextSize()
    local LineHeight = TextSize + 3
    local CenterX = Position.X + Size.X * 0.5
    local Visible = ApplyPlayerOverlayBoxState(Data, Position, Size)
    if OverlayPrimitives.Name then
        OverlayPrimitives.Name.Visible = Visible and Visuals.Player.Names
        OverlayPrimitives.Name.Position = ApplyPlayerESPPreviewOffset(NewVector2(CenterX, Position.Y - LineHeight), "Name")
    end
    local PictureSize = Clamp(tonumber(Visuals.Player.ProfilePictureSize) or 28, 16, 48)
    local AvatarOffset = GetPlayerESPPreviewOffset("Avatar")
    if OverlayPrimitives.ProfilePicture and OverlayPrimitives.ProfilePicture.Visible then
        local PicturePosition = NewVector2(Position.X + Size.X + 5, Position.Y) + AvatarOffset
        OverlayPrimitives.ProfilePicture.Position = PicturePosition
        OverlayPrimitives.ProfilePicture.Size = NewVector2(PictureSize, PictureSize)
        if OverlayPrimitives.ProfilePictureBack and OverlayPrimitives.ProfilePictureBack.Visible then
            OverlayPrimitives.ProfilePictureBack.Position = PicturePosition - NewVector2(1, 1)
            OverlayPrimitives.ProfilePictureBack.Size = NewVector2(PictureSize + 2, PictureSize + 2)
        end
    end
    if OverlayPrimitives.Forcefield and OverlayPrimitives.Forcefield.Visible then
        local Up = Visuals.Player.Names and LineHeight or 0
        OverlayPrimitives.Forcefield.Position = ApplyPlayerESPPreviewOffset(NewVector2(CenterX, Position.Y - LineHeight - Up), "Forcefield")
    end
    local BottomY = Position.Y + Size.Y + 3 local BottomIndex = 0
    local function PlaceBottomOverlay(Object, OffsetName)
        if not Object or not Object.Visible then return end
        Object.Position = ApplyPlayerESPPreviewOffset(NewVector2(CenterX, BottomY + BottomIndex * LineHeight), OffsetName)
        BottomIndex += 1
    end
    PlaceBottomOverlay(OverlayPrimitives.Weapon, "Weapon")
    Shared.PositionEquippedWeaponOverlayIcon(Data)
    PlaceBottomOverlay(OverlayPrimitives.Distance, "Distance")
    PlaceBottomOverlay(OverlayPrimitives.Level, "Level")
    local NeedHealth = Visuals.Player.HealthBar or Visuals.Player.HealthText
    if NeedHealth then
        local Humanoid = Data.Humanoid
        local TargetHealthPercent = Humanoid and Clamp(Humanoid.Health / Max(Humanoid.MaxHealth, 1), 0, 1) or 0
        local HealthPercent, DelayedHealthPercent = UpdatePlayerHealthAnimation(Data, TargetHealthPercent, CurrentTime)
        local HealthOffset = GetPlayerESPPreviewOffset("Health Bar")
        local HealthBackX = Position.X - 5 + HealthOffset.X
        local HealthTopY = Position.Y
        if OverlayPrimitives.HealthBack then
            OverlayPrimitives.HealthBack.Visible = Visible and Visuals.Player.HealthBar
            OverlayPrimitives.HealthBack.Position = NewVector2(HealthBackX, HealthTopY)
            OverlayPrimitives.HealthBack.Size = NewVector2(4, Size.Y)
        end
        if OverlayPrimitives.HealthDelayed then
            local Percent = Clamp(DelayedHealthPercent or HealthPercent, 0, 1)
            local Height = Size.Y * Percent
            OverlayPrimitives.HealthDelayed.Visible = Visible and Visuals.Player.HealthBar and Visuals.Player.Health.Delayed
            if OverlayPrimitives.HealthDelayed.Visible then
                OverlayPrimitives.HealthDelayed.Position = NewVector2(HealthBackX + 1, HealthTopY + Size.Y - Height)
                OverlayPrimitives.HealthDelayed.Size = NewVector2(2, Height)
            end
        end
        if OverlayPrimitives.Health then
            local Height = Size.Y * HealthPercent
            OverlayPrimitives.Health.Visible = Visible and Visuals.Player.HealthBar
            if OverlayPrimitives.Health.Visible then
                OverlayPrimitives.Health.Position = NewVector2(HealthBackX + 1, HealthTopY + Size.Y - Height)
                OverlayPrimitives.Health.Size = NewVector2(2, Height)
                OverlayPrimitives.Health.Color = GetPlayerESPHealthColor(HealthPercent)
            end
        end
        if OverlayPrimitives.HealthText and OverlayPrimitives.HealthText.Visible then
            local HealthValueOffset = GetPlayerESPPreviewOffset("Health Value")
            OverlayPrimitives.HealthText.Center = false
            OverlayPrimitives.HealthText.Size = TextSize
            local Bounds = OverlayPrimitives.HealthText.TextBounds or NewVector2(18, TextSize)
            local TextWidth = Clamp(Bounds.X, 8, 40)
            OverlayPrimitives.HealthText.Position = NewVector2(HealthBackX - TextWidth - 1, HealthTopY) + HealthValueOffset
        end
    else
        if OverlayPrimitives.HealthBack then OverlayPrimitives.HealthBack.Visible = false end
        if OverlayPrimitives.HealthDelayed then OverlayPrimitives.HealthDelayed.Visible = false end
        if OverlayPrimitives.Health then OverlayPrimitives.Health.Visible = false end
        if OverlayPrimitives.HealthText then OverlayPrimitives.HealthText.Visible = false end
    end
    if OverlayPrimitives.Flags and OverlayPrimitives.Flags.Visible then
        local AvatarStackY = Visuals.Player.ProfilePicture and (PictureSize + 6) or 0
        OverlayPrimitives.Flags.Position = ApplyPlayerESPPreviewOffset(NewVector2(Position.X + Size.X + 5, Position.Y + AvatarStackY), "Flags")
    end
    if OverlayPrimitives.AmmoBack and OverlayPrimitives.AmmoBar and OverlayPrimitives.AmmoBack.Visible then
        local CurrentObject = Data.CachedAmmoCurrentObject
        if CurrentObject and CurrentObject.Parent then
            local LiveCurrent = tonumber(CurrentObject.Value)
            if LiveCurrent ~= nil then Data.CachedAmmoCurrent = LiveCurrent end
        end
        local Current = tonumber(Data.CachedAmmoCurrent) local Maximum = tonumber(Data.CachedAmmoMaximum)
        local Ratio = Current and Maximum and Maximum > 0 and Clamp(Current / Maximum, 0, 1) or 0 local AmmoOffset = GetPlayerESPPreviewOffset("Ammo")
        local BarY = BottomY + BottomIndex * LineHeight + 2 local BarPosition = NewVector2(Position.X, BarY) + AmmoOffset local BarWidth = Max(Size.X, 2)
        OverlayPrimitives.AmmoBack.Position = BarPosition
        OverlayPrimitives.AmmoBack.Size = NewVector2(BarWidth, 3)
        OverlayPrimitives.AmmoBar.Position = BarPosition
        OverlayPrimitives.AmmoBar.Size = NewVector2(Max(BarWidth * Ratio, 1), 3)
        if OverlayPrimitives.AmmoText and OverlayPrimitives.AmmoText.Visible then OverlayPrimitives.AmmoText.Position = NewVector2(CenterX, BarY + 6) + AmmoOffset end
    end
    if Visuals.Player.Skeleton.Enabled then
        UpdateSkeletonESP(Data, CameraObject, Color)
    else
        HideSkeletonOverlay(Data)
    end
    if Visuals.Player.Look.Enabled then
        UpdateLookLine(Data, CameraObject, Color)
    elseif OverlayPrimitives.LookLine then
        OverlayPrimitives.LookLine.Visible = false
    end
    if Visuals.Player.Tracers then
        UpdateTracer(Data, CameraObject.ViewportSize, Position, Size, RootScreen, HeadScreen, FeetScreen, nil)
    else
        Shared.HideTracerOverlay(Data)
    end
    if Visuals.Player.Prediction.Enabled then
        UpdatePredictionMarker(Data, CameraObject)
    else
        if OverlayPrimitives.PredictionMarker then OverlayPrimitives.PredictionMarker.Visible = false end
        if OverlayPrimitives.PredictionOutline then OverlayPrimitives.PredictionOutline.Visible = false end
    end
end

function UpdatePlayerOverlayProjectionFast(Data, CameraObject, Position, Size, RootScreen, HeadScreen, FeetScreen, CurrentTime, DynamicRefresh)
    if not Data then return end
    if Data.PlayerESPSignalsBound ~= true then Shared.BindPlayerESPStateSignals(Data) end
    if Visuals.Player.Ammo.Enabled or (Visuals.Player.Flags.Enabled and Visuals.Player.Flags.ShowAmmo) then GetEquippedToolAndAmmo(Data, CurrentTime) end
    if Visuals.Player.Weapon or Visuals.Player.WeaponIcon then Shared.GetCachedToolName(Data, CurrentTime) end
    RefreshPlayerOverlayCoreState(Data, CurrentTime)
    ApplyPlayerOverlayBoxState(Data, Position, Size)
    local OverlayPrimitives = Data.OverlayPrimitives
    local TextSize = Shared.GetESPTextSize()
    local LineHeight = TextSize + 3
    local CenterX = Position.X + Size.X * 0.5

    do
        if OverlayPrimitives.Name and OverlayPrimitives.Name.Visible then
            OverlayPrimitives.Name.Position = ApplyPlayerESPPreviewOffset(NewVector2(CenterX, Position.Y - LineHeight), "Name")
        end

        local PictureSize = Clamp(tonumber(Visuals.Player.ProfilePictureSize) or 28, 16, 48)
        local AvatarOffset = GetPlayerESPPreviewOffset("Avatar")
        if OverlayPrimitives.ProfilePicture and OverlayPrimitives.ProfilePicture.Visible then
            local PicturePosition = NewVector2(Position.X + Size.X + 5, Position.Y) + AvatarOffset
            OverlayPrimitives.ProfilePicture.Position = PicturePosition
            OverlayPrimitives.ProfilePicture.Size = NewVector2(PictureSize, PictureSize)
            if OverlayPrimitives.ProfilePictureBack and OverlayPrimitives.ProfilePictureBack.Visible then
                OverlayPrimitives.ProfilePictureBack.Position = PicturePosition - NewVector2(1, 1)
                OverlayPrimitives.ProfilePictureBack.Size = NewVector2(PictureSize + 2, PictureSize + 2)
            end
        end

        if OverlayPrimitives.Forcefield and OverlayPrimitives.Forcefield.Visible then
            local Up = Visuals.Player.Names and LineHeight or 0
            OverlayPrimitives.Forcefield.Position = ApplyPlayerESPPreviewOffset(NewVector2(CenterX, Position.Y - LineHeight - Up), "Forcefield")
        end

        local BottomY = Position.Y + Size.Y + 3
        local BottomIndex = 0
        local function PlaceBottomOverlay(Object, OffsetName)
            if not Object or not Object.Visible then return end
            Object.Position = ApplyPlayerESPPreviewOffset(NewVector2(CenterX, BottomY + BottomIndex * LineHeight), OffsetName)
            BottomIndex += 1
        end
        PlaceBottomOverlay(OverlayPrimitives.Weapon, "Weapon")
        if OverlayPrimitives.WeaponIcon and OverlayPrimitives.WeaponIcon.Visible then Shared.PositionEquippedWeaponOverlayIcon(Data) end
        PlaceBottomOverlay(OverlayPrimitives.Distance, "Distance")
        PlaceBottomOverlay(OverlayPrimitives.Level, "Level")

        local HealthOffset = GetPlayerESPPreviewOffset("Health Bar")
        local HealthBackX = Position.X - 5 + HealthOffset.X
        if OverlayPrimitives.HealthBack and OverlayPrimitives.HealthBack.Visible then
            OverlayPrimitives.HealthBack.Position = NewVector2(HealthBackX, Position.Y)
            OverlayPrimitives.HealthBack.Size = NewVector2(4, Size.Y)
        end
        if OverlayPrimitives.HealthText and OverlayPrimitives.HealthText.Visible then
            local HealthValueOffset = GetPlayerESPPreviewOffset("Health Value")
            local Bounds = OverlayPrimitives.HealthText.TextBounds or NewVector2(18, TextSize)
            local TextWidth = Clamp(Bounds.X, 8, 40)
            OverlayPrimitives.HealthText.Position = NewVector2(HealthBackX - TextWidth - 1, Position.Y) + HealthValueOffset
        end

        if OverlayPrimitives.Flags and OverlayPrimitives.Flags.Visible then
            local AvatarStackY = Visuals.Player.ProfilePicture and (PictureSize + 6) or 0
            OverlayPrimitives.Flags.Position = ApplyPlayerESPPreviewOffset(NewVector2(Position.X + Size.X + 5, Position.Y + AvatarStackY), "Flags")
        end

        if OverlayPrimitives.AmmoBack and OverlayPrimitives.AmmoBar and OverlayPrimitives.AmmoBack.Visible then
            local AmmoOffset = GetPlayerESPPreviewOffset("Ammo")
            local BarY = BottomY + BottomIndex * LineHeight + 2
            local BarPosition = NewVector2(Position.X, BarY) + AmmoOffset
            local BarWidth = Max(Size.X, 2)
            OverlayPrimitives.AmmoBack.Position = BarPosition
            OverlayPrimitives.AmmoBack.Size = NewVector2(BarWidth, 3)
            OverlayPrimitives.AmmoBar.Position = BarPosition
            local Current = tonumber(Data.CachedAmmoCurrent)
            local Maximum = tonumber(Data.CachedAmmoMaximum)
            local Ratio = Current and Maximum and Maximum > 0 and Clamp(Current / Maximum, 0, 1) or 0
            OverlayPrimitives.AmmoBar.Size = NewVector2(Max(BarWidth * Ratio, 1), 3)
            if OverlayPrimitives.AmmoText and OverlayPrimitives.AmmoText.Visible then
                OverlayPrimitives.AmmoText.Position = NewVector2(CenterX, BarY + 6) + AmmoOffset
                if Current and Maximum and Maximum > 0 then OverlayPrimitives.AmmoText.Text = Format("%d/%d", Floor(Current + 0.5), Floor(Maximum + 0.5)) end
            end
        end
    end

    if DynamicRefresh then
        local NeedHealth = Visuals.Player.HealthBar or Visuals.Player.HealthText
        if NeedHealth then
            local Humanoid = Data.Humanoid
            local TargetHealthPercent = Humanoid and Clamp(Humanoid.Health / Max(Humanoid.MaxHealth, 1), 0, 1) or 0
            local HealthPercent, DelayedHealthPercent = UpdatePlayerHealthAnimation(Data, TargetHealthPercent, CurrentTime)
            local HealthOffset = GetPlayerESPPreviewOffset("Health Bar")
            local HealthBackX = Position.X - 5 + HealthOffset.X
            if OverlayPrimitives.HealthDelayed and OverlayPrimitives.HealthDelayed.Visible then
                local Percent = Clamp(DelayedHealthPercent or HealthPercent, 0, 1)
                local Height = Size.Y * Percent
                OverlayPrimitives.HealthDelayed.Position = NewVector2(HealthBackX + 1, Position.Y + Size.Y - Height)
                OverlayPrimitives.HealthDelayed.Size = NewVector2(2, Height)
            end
            if OverlayPrimitives.Health and OverlayPrimitives.Health.Visible then
                local Height = Size.Y * HealthPercent
                OverlayPrimitives.Health.Position = NewVector2(HealthBackX + 1, Position.Y + Size.Y - Height)
                OverlayPrimitives.Health.Size = NewVector2(2, Height)
                OverlayPrimitives.Health.Color = GetPlayerESPHealthColor(HealthPercent)
            end
        end

        if Visuals.Player.Prediction.Enabled then UpdatePredictionMarker(Data, CameraObject) end
    end

    local Color = Data.LastESPColor or Visuals.Player.BoxColor
    if Visuals.Player.Skeleton.Enabled then UpdateSkeletonESP(Data, CameraObject, Color) else HideSkeletonOverlay(Data) end
    if Visuals.Player.Look.Enabled then UpdateLookLine(Data, CameraObject, Color) elseif OverlayPrimitives.LookLine then OverlayPrimitives.LookLine.Visible = false end
    if Visuals.Player.Tracers then UpdateTracer(Data, CameraObject.ViewportSize, Position, Size, RootScreen, HeadScreen, FeetScreen, nil) else Shared.HideTracerOverlay(Data) end
    if not Visuals.Player.Prediction.Enabled then
        if OverlayPrimitives.PredictionMarker then OverlayPrimitives.PredictionMarker.Visible = false end
        if OverlayPrimitives.PredictionOutline then OverlayPrimitives.PredictionOutline.Visible = false end
    end
end

function RefreshPlayerOverlayVisualStateFast(Data, CameraObject, Position, Size, RootScreen, HeadScreen, FeetScreen, CurrentTime)
    if not Data or Data.ESPEligible ~= true then return false end
    if not Shared.EnsurePlayerOverlayCore(Data, true) then return false end
    local OverlayPrimitives = Data.OverlayPrimitives
    local Visible = Data.VisualHidden ~= true

    if Visuals.Player.Weapon or Visuals.Player.WeaponIcon then Shared.GetCachedToolName(Data, CurrentTime) end
    if Visuals.Player.Level and type(GetCachedPlayerLevel) == "function" then GetCachedPlayerLevel(Data, CurrentTime) end
    if Data.PlayerESPSignalsBound ~= true then Shared.BindPlayerESPStateSignals(Data) end
    if Visuals.Player.Ammo.Enabled or (Visuals.Player.Flags.Enabled and Visuals.Player.Flags.ShowAmmo) then
        GetEquippedToolAndAmmo(Data, CurrentTime)
    end


    ApplyPlayerOverlayBoxState(Data, Position, Size)


    RefreshPlayerOverlayCoreState(Data, CurrentTime)
    if OverlayPrimitives.HealthBack then OverlayPrimitives.HealthBack.Visible = Visible and Visuals.Player.HealthBar == true end
    if OverlayPrimitives.HealthDelayed then OverlayPrimitives.HealthDelayed.Visible = Visible and Visuals.Player.HealthBar == true and Visuals.Player.Health.Delayed == true end
    if OverlayPrimitives.Health then OverlayPrimitives.Health.Visible = Visible and Visuals.Player.HealthBar == true end


    UpdatePlayerOverlayProjectionFast(Data, CameraObject, Position, Size, RootScreen, HeadScreen, FeetScreen, CurrentTime, true)
    return true
end

function UpdatePlayerUIDynamicProjection(Data, Ui, CurrentTime)
    if not Data or not Ui then return end
    local Humanoid = Data.Humanoid if not Humanoid then return end
    local TargetHealthPercent = Clamp(Humanoid.Health / Max(Humanoid.MaxHealth, 1), 0, 1)
    local HealthPercent, DelayedHealthPercent = UpdatePlayerHealthAnimation(Data, TargetHealthPercent, CurrentTime)
    local HealthOffset = GetPlayerESPPreviewOffset("Health Bar") local HealthBackX = -5 + HealthOffset.X
    if Ui.HealthBack and Ui.HealthBack.Visible then
        Ui.HealthBack.Position = FromOffset(HealthBackX, 0)
        Ui.HealthBack.Size = NewUDim2(0, 4, 1, 0)
    end
    if Ui.Health and Ui.Health.Visible then
        Ui.Health.Position = NewUDim2(0, HealthBackX + 1, 1 - HealthPercent, 0)
        Ui.Health.Size = NewUDim2(0, 2, HealthPercent, 0)
        Ui.Health.BackgroundColor3 = GetPlayerESPHealthColor(HealthPercent)
    end
    if Ui.HealthDelayed and Ui.HealthDelayed.Visible then
        local DelayedPercent = Clamp(DelayedHealthPercent or HealthPercent, 0, 1)
        Ui.HealthDelayed.Position = NewUDim2(0, HealthBackX + 1, 1 - DelayedPercent, 0)
        Ui.HealthDelayed.Size = NewUDim2(0, 2, DelayedPercent, 0)
    end
    if Ui.HealthText and Ui.HealthText.Visible then
        local Offset = GetPlayerESPPreviewOffset("Health Value")
        Ui.HealthText.TextSize = Shared.GetESPTextSize()
        Ui.HealthText.TextScaled = false
        Ui.HealthText.TextWrapped = false
        Ui.HealthText.TextXAlignment = Enum.TextXAlignment.Right
        Ui.HealthText.TextYAlignment = Enum.TextYAlignment.Top
