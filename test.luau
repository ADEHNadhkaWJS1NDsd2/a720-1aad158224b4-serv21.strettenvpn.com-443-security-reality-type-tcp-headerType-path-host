    local Filter = {}
    if LocalPlayer.Character then Filter[#Filter + 1] = LocalPlayer.Character end
    if Workspace.CurrentCamera then Filter[#Filter + 1] = Workspace.CurrentCamera end
    Ragebot.RayParams.FilterType = Enum.RaycastFilterType.Exclude
    Ragebot.RayParams.FilterDescendantsInstances = Filter
    Ragebot.RayParams.IgnoreWater = true
    return Ragebot.RayParams
end
function Ragebot.GetPosition()
    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    return Root and Root.Position or EmptyVector3
end
function Ragebot.GetPredictionTime()
    if Ragebot.Settings.Simulation ~= true then
        return 0
    end
    local Mode = NormalizePredictionMode(Ragebot.Settings.PredictionMode)
    if Mode == "Ping" then
        return Clamp(type(ResolverGetPing) == "function" and ResolverGetPing() or 0, 0, 0.45)
    end
    return Clamp((tonumber(Ragebot.Settings.Prediction) or 0) / 1000, 0, 0.45)
end

function Ragebot.ApplyPrediction(BasePosition, PredictedPosition)
    if typeof(PredictedPosition) == "Vector3" then
        return PredictedPosition
    end
    return BasePosition
end

function Ragebot.PredictPosition(Player, TargetPart)
    if not Player or not TargetPart or not TargetPart:IsA("BasePart") then
        return nil
    end
    local Character = ResolveTrackedCharacter(Player, Player.Character) or Player.Character
    local BasePosition = select(1, ResolverGetAimPosition(Player, Character, TargetPart, Ragebot.Settings.Resolver == true)) or TargetPart.Position
    local PredictionTime = Ragebot.GetPredictionTime()
    if PredictionTime <= 0 then
        return BasePosition
    end
    Ragebot.Runtime.SimulationSettings.Resolver = Ragebot.Settings.Resolver == true
    local PredictedPosition = ResolveCombatPosition(Player, Character, TargetPart, PredictionTime, Ragebot.Runtime.SimulationSettings, {ResolverEnabled =
                    Ragebot.Settings.Resolver == true})
    if typeof(PredictedPosition) ~= "Vector3" then PredictedPosition = BasePosition end
    return PredictedPosition
end

function Ragebot.GetRouteTargetPosition(Player, TargetRoot)
    if not Player or not TargetRoot or not TargetRoot:IsA("BasePart") then
        return nil
    end
    return Ragebot.PredictPosition(Player, TargetRoot)
end

function Ragebot.GetReloadRemote()
    local Cached = Ragebot.Runtime.ReloadRemote
    if Cached and Cached.Parent and Cached:IsA("RemoteEvent") then return Cached end
    local Events = ReplicatedStorage:FindFirstChild("Events")
    local Remote = Events and Events:FindFirstChild("GNX_R")
    if not Remote then Remote = ReplicatedStorage:FindFirstChild("GNX_R", true) end
    if Remote and Remote:IsA("RemoteEvent") then
        Ragebot.Runtime.ReloadRemote = Remote
        return Remote
    end
    return nil
end

function Ragebot.TryAutoReloadAfterShot(Tool)
    if Ragebot.Settings.AutoReload ~= true then return false end
    if not Tool or not Tool:IsA("Tool") or Tool.Parent ~= LocalPlayer.Character then return false end
    local Remote = Ragebot.GetReloadRemote()
    if not Remote or not Remote.Parent then return false end
    local SentAt = Clock()
    local Success = Shared.SafeCall(function()
        Remote:FireServer(tick(), "KLWE89U0", Tool)
    end)
    if Success == true then
        Ragebot.Runtime.AutoReloadLastShotAt = SentAt
        Ragebot.Runtime.AutoReloadLastShotTool = Tool
    end
    return Success == true
end
function Ragebot.GetReloadValues(Tool)
    if not Tool or not Tool:IsA("Tool") then return nil end
    local Values = Tool:FindFirstChild("Values") or Tool:FindFirstChild("Values", true)
    if not Values then return nil end
    local ServerAmmo = Values:FindFirstChild("SERVER_Ammo")
    local ServerStored = Values:FindFirstChild("SERVER_StoredAmmo")
    local LocalAmmo = Values:FindFirstChild("Ammo")
    local LocalStored = Values:FindFirstChild("StoredAmmo")
    local ServerAmmoValue = ServerAmmo and tonumber(ServerAmmo.Value) or nil
    local ServerStoredValue = ServerStored and tonumber(ServerStored.Value) or nil
    local LocalAmmoValue = LocalAmmo and tonumber(LocalAmmo.Value) or nil
    local LocalStoredValue = LocalStored and tonumber(LocalStored.Value) or nil
    if ServerAmmoValue == nil and LocalAmmoValue == nil then return nil end
    if ServerStoredValue == nil and LocalStoredValue == nil then return nil end
    return {Values = Values, ServerAmmo = ServerAmmo, ServerStored = ServerStored, LocalAmmo = LocalAmmo, LocalStored = LocalStored,
        Ammo = ServerAmmoValue ~= nil and ServerAmmoValue or LocalAmmoValue, Stored = ServerStoredValue ~= nil and ServerStoredValue or LocalStoredValue,
        ServerAmmoValue = ServerAmmoValue, ServerStoredValue = ServerStoredValue, LocalAmmoValue = LocalAmmoValue, LocalStoredValue = LocalStoredValue}
end
function Ragebot.SyncReloadFromServer(Tool)
    local State = Ragebot.GetReloadValues(Tool)
    if not State then return false end
    if State.ServerAmmoValue ~= nil and State.LocalAmmo and State.LocalAmmo.Parent and State.LocalAmmoValue ~= State.ServerAmmoValue then
        Shared.SafeCall(function() State.LocalAmmo.Value = State.ServerAmmoValue end)
    end
    if State.ServerStoredValue ~= nil and State.LocalStored and State.LocalStored.Parent and State.LocalStoredValue ~= State.ServerStoredValue then
        Shared.SafeCall(function() State.LocalStored.Value = State.ServerStoredValue end)
    end
    local Synced = Ragebot.GetReloadValues(Tool) or State
    Ragebot.Runtime.ReloadLastServerAmmo = Synced.ServerAmmoValue
    Ragebot.Runtime.ReloadLastServerStored = Synced.ServerStoredValue
    Ragebot.Runtime.ReloadLastLocalAmmo = Synced.LocalAmmoValue
    Ragebot.Runtime.ReloadLastLocalStored = Synced.LocalStoredValue
    Ragebot.Runtime.ReloadLastServerSync = Clock()
    return Synced.ServerAmmoValue ~= nil or Synced.LocalAmmoValue ~= nil
end
function Ragebot.GetNativeGunController(Tool)
    if not Tool or not Tool:IsA("Tool") then return nil end
    Ragebot.Runtime.NativeGunControllers = type(Ragebot.Runtime.NativeGunControllers) == "table" and Ragebot.Runtime.NativeGunControllers or setmetatable({}, {__mode = "k"})
    local Cached = Ragebot.Runtime.NativeGunControllers[Tool]
    if Cached ~= nil then
        local Success, Reload = Shared.SafeCall(function() return Cached.Reload end)
        if Success and type(Reload) == "function" then return Cached end
        Ragebot.Runtime.NativeGunControllers[Tool] = nil
    end
    local Module = Tool:FindFirstChild("Gun") or Tool:FindFirstChild("Gun", true)
    if not Module or not Module:IsA("ModuleScript") then return nil end
    local Success, Controller = Shared.SafeCall(require, Module)
    if not Success or Controller == nil then return nil end
    local ReadSuccess, Reload = Shared.SafeCall(function() return Controller.Reload end)
    if not ReadSuccess or type(Reload) ~= "function" then return nil end
    Ragebot.Runtime.NativeGunControllers[Tool] = Controller
    return Controller
end

function Ragebot.CreateReloadSessionID()
    return Math.random()
end

function Ragebot.PrimeLocalAmmoForReload(Tool, PreShotAmmo)
    if not Tool or not Tool:IsA("Tool") then return false end
    local Values = Tool:FindFirstChild("Values")
    if not Values then return false end
    local LocalAmmo = Values:FindFirstChild("Ammo")
    local LocalStored = Values:FindFirstChild("StoredAmmo")
    local ServerAmmo = Values:FindFirstChild("SERVER_Ammo")
    local ServerStored = Values:FindFirstChild("SERVER_StoredAmmo")
    local MagSize = Ragebot.GetReloadMagSize(Tool)
    local LocalAmmoValue = LocalAmmo and tonumber(LocalAmmo.Value) or nil
    local ServerAmmoValue = ServerAmmo and tonumber(ServerAmmo.Value) or nil
    local TargetAmmo = LocalAmmoValue
    if type(TargetAmmo) == "number" then
        if type(ServerAmmoValue) == "number" and ServerAmmoValue < TargetAmmo then
            TargetAmmo = ServerAmmoValue
        elseif type(PreShotAmmo) == "number" then
            TargetAmmo = Min(TargetAmmo, Max(Floor(PreShotAmmo) - 1, 0))
        else
            TargetAmmo = Max(TargetAmmo - 1, 0)
        end
        if type(MagSize) == "number" and MagSize > 0 then TargetAmmo = Min(TargetAmmo, MagSize - 1) end
        if LocalAmmo and LocalAmmo.Parent and tonumber(LocalAmmo.Value) ~= TargetAmmo then Shared.SafeCall(function() LocalAmmo.Value = TargetAmmo end) end
    end
    local ServerStoredValue = ServerStored and tonumber(ServerStored.Value) or nil
    if LocalStored and LocalStored.Parent and type(ServerStoredValue) == "number" and tonumber(LocalStored.Value) ~= ServerStoredValue then
        Shared.SafeCall(function() LocalStored.Value = ServerStoredValue end)
    end
    return true
end

function Ragebot.GetReloadDuration(Tool, ShotgunStep)
    local Config = Ragebot.GetWeaponConfig(Tool)
    local function ReadNumber(Object, Key)
        if type(Object) ~= "table" and typeof(Object) ~= "userdata" then return nil end
        local Value
        if type(Object) == "table" then Value = rawget(Object, Key) end
        if Value == nil then
            local Success, Result = Shared.SafeCall(function() return Object[Key] end)
            if Success then Value = Result end
        end
        return tonumber(Value)
    end
    if ShotgunStep == true then
        local Shotgun
        if type(Config) == "table" then Shotgun = rawget(Config, "ShotgunSettings") end
        if Shotgun == nil and Config ~= nil then
            local Success, Result = Shared.SafeCall(function() return Config.ShotgunSettings end)
            if Success then Shotgun = Result end
        end
        local StartTime = ReadNumber(Shotgun, "ReloadStartTime")
        local ShellTime = ReadNumber(Shotgun, "ShellInTime")
        return Clamp(StartTime or ShellTime or 0.65, 0.12, 4)
    end
    local ReloadTime = ReadNumber(Config, "ReloadTime") or 2.0
    return Clamp(ReloadTime, 0.20, 8)
end

function Ragebot.GetReloadTimestamp()
    return Workspace:GetServerTimeNow()
end

function Ragebot.WaitServerTimeDelta(Seconds, Tool)
    local Start = Workspace:GetServerTimeNow()
    local Duration = Max(tonumber(Seconds) or 0, 0)
    if Duration <= 0 then Duration = 1 / 60 end
    local Deadline = Start + Duration
    while Workspace:GetServerTimeNow() < Deadline do
        if Tool and Tool.Parent ~= LocalPlayer.Character then return false end
        RunService.Heartbeat:Wait()
    end
    return Tool == nil or Tool.Parent == LocalPlayer.Character
end

function Ragebot.GetReloadSyncEvent(Tool)
    if not Tool or not Tool:IsA("Tool") then return nil end
    local Values = Tool:FindFirstChild("Values") or Tool:FindFirstChild("Values", true)
    local Event = Values and Values:FindFirstChild("ComEvent")
    return Event and Event:IsA("RemoteEvent") and Event or nil
end

function Ragebot.WaitForReloadServerSync(Tool, BeforeAmmo, BeforeStored, Timeout)
    local SyncEvent = Ragebot.GetReloadSyncEvent(Tool)
    local State = Ragebot.GetReloadValues(Tool)
    if not State then return false end
    local function HasReloadSynced()
        if not Tool or Tool.Parent ~= LocalPlayer.Character then return true end
        local Current = Ragebot.GetReloadValues(Tool)
        if not Current then return true end
        local Ammo = Current.ServerAmmoValue ~= nil and Current.ServerAmmoValue or Current.Ammo
        local Stored = Current.ServerStoredValue ~= nil and Current.ServerStoredValue or Current.Stored
        return Ammo ~= nil and Stored ~= nil and (Ammo > BeforeAmmo or Stored < BeforeStored)
    end
    local Signals = {SyncEvent and SyncEvent.OnClientEvent or nil, Tool.AncestryChanged, Shared.GetPropertyChangedSignalSafe(LocalPlayer, "Character")}
    for _, Object in ipairs({State.ServerAmmo, State.ServerStored, State.LocalAmmo, State.LocalStored}) do
        if Object then Signals[#Signals + 1] = Object:GetPropertyChangedSignal("Value") end
    end
    Shared.WaitForConditionSignal(HasReloadSynced, Max(tonumber(Timeout) or 0.65, 0.08), Signals)
    if not Tool or Tool.Parent ~= LocalPlayer.Character then return false end
    local Current = Ragebot.GetReloadValues(Tool)
    if not Current then return false end
    local Ammo = Current.ServerAmmoValue ~= nil and Current.ServerAmmoValue or Current.Ammo
    local Stored = Current.ServerStoredValue ~= nil and Current.ServerStoredValue or Current.Stored
    return Ammo ~= nil and Stored ~= nil and (Ammo > BeforeAmmo or Stored < BeforeStored)
end

function Ragebot.WithInternalReloadSend(Function)
    Ragebot.Runtime.InternalReloadSendDepth = (tonumber(Ragebot.Runtime.InternalReloadSendDepth) or 0) + 1
    local Results = Pack(Shared.SafeCall(Function))
    Ragebot.Runtime.InternalReloadSendDepth = Max((tonumber(Ragebot.Runtime.InternalReloadSendDepth) or 1) - 1, 0)
    return Unpack(Results, 1, Results.n)
end

function Ragebot.SendReloadStart(Remote, Tool, ReloadSessionId, ExtraData)
    if not Remote or not Remote.Parent or not Tool or Tool.Parent ~= LocalPlayer.Character then return false end
    local Timestamp = Ragebot.GetReloadTimestamp()
    if type(Timestamp) ~= "number" then return false end
    local Success = Ragebot.WithInternalReloadSend(function()
        Remote:FireServer(Timestamp, "STZNRD", Tool, ReloadSessionId, ExtraData)
    end)
    return Success == true
end

function Ragebot.SendReloadComplete(Remote, Tool, ExtraData)
    if not Remote or not Remote.Parent or not Tool or Tool.Parent ~= LocalPlayer.Character then return false end
    local Timestamp = Ragebot.GetReloadTimestamp()
    if type(Timestamp) ~= "number" then return false end
    local Success = Ragebot.WithInternalReloadSend(function()
        Remote:FireServer(Timestamp, "KLWE89U0", Tool, nil, ExtraData)
    end)
    return Success == true
end

function Ragebot.IsShotgunReload(Tool)
    local Config = Ragebot.GetWeaponConfig(Tool)
    if Config == nil then return false end
    local Settings
    if type(Config) == "table" then Settings = rawget(Config, "ShotgunSettings") end
    if Settings == nil then
        local Success, Value = Shared.SafeCall(function() return Config.ShotgunSettings end)
        if Success then Settings = Value end
    end
    if Settings == nil then return false end
    local Enabled
    if type(Settings) == "table" then Enabled = rawget(Settings, "ShotgunReload") end
    if Enabled == nil then
        local Success, Value = Shared.SafeCall(function() return Settings.ShotgunReload end)
        if Success then Enabled = Value end
    end
    return Enabled == true
end

function Ragebot.CompleteReloadSession(Remote, Tool, ExtraData, FillAll)
    if not Remote or not Tool or Tool.Parent ~= LocalPlayer.Character then return false end
    local MagSize = Ragebot.GetReloadMagSize(Tool)
    local Shotgun = Ragebot.IsShotgunReload(Tool)
    local MaximumSteps = Shotgun and Clamp(MagSize or 16, 1, 64) or 1
    if FillAll == false then MaximumSteps = 1 end
    local AnySync = false
    for _ = 1, MaximumSteps do
        local Before = Ragebot.GetReloadValues(Tool)
        if not Before then break end
        local BeforeAmmo = Before.ServerAmmoValue ~= nil and Before.ServerAmmoValue or Before.Ammo
        local BeforeStored = Before.ServerStoredValue ~= nil and Before.ServerStoredValue or Before.Stored
        if BeforeStored == nil or BeforeStored <= 0 then break end
        if MagSize and BeforeAmmo and BeforeAmmo >= MagSize then break end
        local Synced = false
        for Attempt = 1, 2 do
            if not Ragebot.SendReloadComplete(Remote, Tool, ExtraData) then break end
            if Ragebot.WaitForReloadServerSync(Tool, BeforeAmmo or 0, BeforeStored, 0.42) then
                Synced = true
                AnySync = true
                Ragebot.SyncReloadFromServer(Tool)
                break
            end
            if Attempt == 1 then RunService.Heartbeat:Wait() end
        end
        if not Synced then break end
        if not Shotgun then break end
    end
    return AnySync
end

function Ragebot.RunReloadSequence(Tool, ExtraData, Force)

    if not Tool or not Tool:IsA("Tool") or Tool.Parent ~= LocalPlayer.Character then return false end
    local State = Ragebot.GetReloadValues(Tool)
    if not State or type(State.Stored) ~= "number" or State.Stored <= 0 then return false end
    local MagSize = Ragebot.GetReloadMagSize(Tool)
    if Force ~= true and type(MagSize) == "number" and type(State.Ammo) == "number" and State.Ammo >= MagSize then return true end
    local Remote = Ragebot.GetReloadRemote()
    if not Remote then return false end
    local ReloadSessionId = Ragebot.CreateReloadSessionID()
    Ragebot.Runtime.ReloadSessionId = ReloadSessionId
    local Started = false
    for Attempt = 1, 3 do
        if Ragebot.SendReloadStart(Remote, Tool, ReloadSessionId, ExtraData) then
            if Ragebot.WaitServerTimeDelta(1 / 60, Tool) then
                Started = true
                break
            end
        end
        if Attempt < 3 and not Ragebot.WaitServerTimeDelta(1 / 60, Tool) then break end
    end
    if not Started or Tool.Parent ~= LocalPlayer.Character then return false end
    local Shotgun = Ragebot.IsShotgunReload(Tool)
    local Initial = Ragebot.GetReloadValues(Tool)
    if not Initial then return false end
    local InitialAmmo = Initial.ServerAmmoValue ~= nil and Initial.ServerAmmoValue or Initial.LocalAmmoValue or Initial.Ammo or 0
    local InitialStored = Initial.ServerStoredValue ~= nil and Initial.ServerStoredValue or Initial.LocalStoredValue or Initial.Stored or 0
    local Missing = 1
    if type(MagSize) == "number" then Missing = Max(MagSize - InitialAmmo, 1) end
    Missing = Min(Missing, Max(Floor(InitialStored), 1))
    local Steps = Shotgun and Clamp(Missing, 1, 64) or 1
    local AnySync = false
    for Step = 1, Steps do
        if Tool.Parent ~= LocalPlayer.Character then break end
        local ReloadDelay = Ragebot.GetReloadDuration(Tool, Shotgun)
        if ReloadDelay > 0 and not Ragebot.WaitServerTimeDelta(ReloadDelay, Tool) then break end
        local Before = Ragebot.GetReloadValues(Tool)
        if not Before then break end
        local BeforeAmmo = Before.ServerAmmoValue ~= nil and Before.ServerAmmoValue or Before.LocalAmmoValue or Before.Ammo or 0
        local BeforeStored = Before.ServerStoredValue ~= nil and Before.ServerStoredValue or Before.LocalStoredValue or Before.Stored or 0
        if type(MagSize) == "number" and BeforeAmmo >= MagSize then AnySync = true break end
        if BeforeStored <= 0 then break end
        local Completed = false
        for Attempt = 1, 3 do
            if Ragebot.SendReloadComplete(Remote, Tool, ExtraData) then
                if Ragebot.WaitForReloadServerSync(Tool, BeforeAmmo, BeforeStored, 1.25) then
                    Completed = true
                    AnySync = true
                    Ragebot.SyncReloadFromServer(Tool)
                    break
                end
            end
            if Attempt < 3 and not Ragebot.WaitServerTimeDelta(1 / 60, Tool) then break end
        end
        if not Completed then break end
        if not Shotgun then break end
    end
    return AnySync
end

function Ragebot.TriggerNativeReload(Tool, PreShotAmmo)
    if not Tool or Tool.Parent ~= LocalPlayer.Character then return false end
    local State = Ragebot.GetReloadValues(Tool)
    if not State or type(State.Stored) ~= "number" or State.Stored <= 0 then return false end
    local MagSize = Ragebot.GetReloadMagSize(Tool)
    if type(MagSize) == "number" and type(State.Ammo) == "number" and State.Ammo >= MagSize then return true end
    if type(PreShotAmmo) == "number" then Ragebot.PrimeLocalAmmoForReload(Tool, PreShotAmmo) end
    local Controller = Ragebot.GetNativeGunController(Tool)
    if not Controller then
        return Ragebot.RunReloadSequence(Tool, nil, PreShotAmmo ~= nil)
    end
    local Success, Reload = Shared.SafeCall(function() return Controller.Reload end)
    if not Success or type(Reload) ~= "function" then return false end
    Ragebot.Runtime.ReloadNativeStartedAt = Clock()
    Ragebot.Runtime.ReloadNativeTool = Tool
    local Fired = Shared.SafeCall(Reload)
    return Fired == true
end
function Ragebot.GetReloadMagSize(Tool)
    local Config = Ragebot.GetWeaponConfig(Tool)
    if Config == nil then return nil end
    local MagSize
    if type(Config) == "table" then MagSize = rawget(Config, "MagSize") end
    if MagSize == nil then
        local Success, Value = Shared.SafeCall(function() return Config.MagSize end)
        if Success then MagSize = Value end
    end
    MagSize = tonumber(MagSize)
    return MagSize and Max(Floor(MagSize), 1) or nil
end
function Ragebot.GetAutoReloadState(Tool)
    if not Tool then return nil end
    local States = Ragebot.Runtime.AutoReloadStates
    if type(States) ~= "table" then
        States = setmetatable({}, {__mode = "k"})
        Ragebot.Runtime.AutoReloadStates = States
    end
    local State = States[Tool]
    if type(State) ~= "table" then
        State = {Armed = true, Fired = false, ManualActive = false, ManualUntil = 0, LastAmmo = nil, LastStored = nil, LastTriggerAt = 0, LastStartAt = 0, LastCompleteAt = 0}
        States[Tool] = State
    end
    return State
end
function Ragebot.GetAutoReloadObservedValues(Tool)
    local Values = Ragebot.GetReloadValues(Tool)
    if not Values then return nil, nil, nil end
    local Ammo = Values.LocalAmmoValue
    local Stored = Values.LocalStoredValue
    if Ammo == nil then Ammo = Values.ServerAmmoValue end
    if Stored == nil then Stored = Values.ServerStoredValue end
    return Ammo, Stored, Values
end
function Ragebot.ObserveReloadAction(Arguments)
    if type(Arguments) ~= "table" then return false end
    local ReloadAction = Arguments[2]
    local Tool = Arguments[3]
    if typeof(Tool) ~= "Instance" or not Tool:IsA("Tool") then return false end
    local State = Ragebot.GetAutoReloadState(Tool)
    if not State then return false end
    local Now = Clock()
    if ReloadAction == "STZNRD" then
        State.ManualActive = true
        State.ManualUntil = Now + 8
        State.LastStartAt = Now
        State.Fired = true
        State.Armed = false
        Ragebot.StopAutoReloadWorker(Tool)
        return true
    end
    if ReloadAction == "KLWE89U0" then
        State.ManualActive = true
        State.ManualUntil = Now + 1.5
        State.LastCompleteAt = Now
        local Token = {}
        State.CompleteToken = Token
        Spawn(function()
            local ReloadValues = Ragebot.GetReloadValues(Tool)
            local Signals = {Tool.AncestryChanged}
            if ReloadValues then
                for _, Object in ipairs({ReloadValues.ServerAmmo, ReloadValues.LocalAmmo}) do
                    if Object then Signals[#Signals + 1] = Object:GetPropertyChangedSignal("Value") end
                end
            end
            Shared.WaitForConditionSignal(function()
                if State.CompleteToken ~= Token or not Tool.Parent then return true end
                local Ammo = select(1, Ragebot.GetAutoReloadObservedValues(Tool))
                return type(Ammo) == "number" and Ammo > 0
            end, 1.5, Signals)
            if State.CompleteToken ~= Token or not Tool.Parent then return end
            local Ammo = select(1, Ragebot.GetAutoReloadObservedValues(Tool))
            if type(Ammo) == "number" and Ammo > 0 then
                State.ManualActive = false
                State.ManualUntil = 0
                State.Fired = false
                State.Armed = true
                State.LastAmmo = Ammo
            else
                State.ManualActive = false
                State.ManualUntil = 0
            end
        end)
        return true
    end
    return false
end
function Ragebot.IsManualReloadActive(Tool)
    local State = Ragebot.GetAutoReloadState(Tool)
    if not State then return false end
    if State.ManualActive ~= true then return false end
    if Clock() <= (tonumber(State.ManualUntil) or 0) then return true end
    State.ManualActive = false
    State.ManualUntil = 0
    return false
end
function Ragebot.StopAutoReloadWorker(Tool)
    local Workers = Ragebot.Runtime.ReloadWorkers
    if type(Workers) == "table" and Tool then Workers[Tool] = nil end
end
function Ragebot.StartAutoReloadWorker(Tool)
    if Ragebot.Settings.AutoReload ~= true or not Tool or not Tool:IsA("Tool") or Tool.Parent ~= LocalPlayer.Character then return false end
    local Ammo, Stored = Ragebot.GetAutoReloadObservedValues(Tool)
    if type(Ammo) ~= "number" or type(Stored) ~= "number" or Stored <= 0 then return false end
    local State = Ragebot.GetAutoReloadState(Tool)
    if not State then return false end
    State.LastAmmo = Ammo
    State.LastStored = Stored
    if Ammo > 0 then
        State.Armed = true
        State.Fired = false
        return false
    end
    if Ragebot.IsManualReloadActive(Tool) then return false end
    if State.Armed ~= true or State.Fired == true then return false end
    State.Armed = false
    State.Fired = true
    State.LastTriggerAt = Clock()
    Ragebot.Runtime.ReloadPendingTool = Tool
    Ragebot.Runtime.ReloadPendingUntil = State.LastTriggerAt + 0.25
    local Started = Ragebot.TriggerNativeReload(Tool)
    Ragebot.Runtime.ReloadPendingTool = nil
    Ragebot.Runtime.ReloadPendingUntil = 0
    return Started == true
end
function Ragebot.HandleCriminologyManualReload(Remote, Arguments)
    return false
end
function Ragebot.RequestReload(Tool)
    if Ragebot.Settings.AutoReload ~= true or not Tool or Tool.Parent ~= LocalPlayer.Character then return false end
    local Ammo, Stored = Ragebot.GetAutoReloadObservedValues(Tool)
    if type(Ammo) ~= "number" or type(Stored) ~= "number" then return false end
    local State = Ragebot.GetAutoReloadState(Tool)
    if not State then return false end
    State.LastStored = Stored
    if Ammo > 0 then
        State.LastAmmo = Ammo
        State.Armed = true
        State.Fired = false
        return false
    end
    State.LastAmmo = Ammo
    if Stored <= 0 or Ragebot.IsManualReloadActive(Tool) then return false end
    return Ragebot.StartAutoReloadWorker(Tool)
end
function Ragebot.DisconnectReload()
    local Connections = Ragebot.Runtime.ReloadConnections
    if type(Connections) ~= "table" then
        Connections = {}
        Ragebot.Runtime.ReloadConnections = Connections
    end
    for Index = #Connections, 1, -1 do
        local Connection = Connections[Index]
        if Connection then
            if typeof(Connection) == "RBXScriptConnection" then
                Connection:Disconnect()
            elseif type(Connection) == "table" and type(Connection.Disconnect) == "function" then
                Shared.SafeCall(Connection.Disconnect, Connection)
            end
        end
        Connections[Index] = nil
    end
    local Tool = Ragebot.Runtime.ReloadTool
    if Tool then Ragebot.StopAutoReloadWorker(Tool) end
    Ragebot.Runtime.ReloadTool = nil
    Ragebot.Runtime.ReloadAmmoObject = nil
    Ragebot.Runtime.ReloadStoredObject = nil
    Ragebot.Runtime.ReloadLocalAmmoObject = nil
    Ragebot.Runtime.ReloadPendingTool = nil
    Ragebot.Runtime.ReloadPendingUntil = 0
end
function Ragebot.StopReloadMonitor()
    for _, Field in ipairs({"ReloadCharacterAddedConnection", "ReloadCharacterRemovingConnection", "ReloadCharacterChildAddedConnection", "ReloadCharacterChildRemovedConnection", "ReloadMonitorConnection"}) do
        local Connection = Ragebot.Runtime[Field]
        if Connection and typeof(Connection) == "RBXScriptConnection" then Connection:Disconnect() end
        Ragebot.Runtime[Field] = nil
    end
    Ragebot.Runtime.ReloadMonitorAccumulator = 0
end
function Ragebot.BindReloadCharacter(Character)
    local Added = Ragebot.Runtime.ReloadCharacterChildAddedConnection
    if Added and typeof(Added) == "RBXScriptConnection" then Added:Disconnect() end
    local Removed = Ragebot.Runtime.ReloadCharacterChildRemovedConnection
    if Removed and typeof(Removed) == "RBXScriptConnection" then Removed:Disconnect() end
    Ragebot.Runtime.ReloadCharacterChildAddedConnection = nil
    Ragebot.Runtime.ReloadCharacterChildRemovedConnection = nil
    if not Character then return end
    Ragebot.Runtime.ReloadCharacterChildAddedConnection = Character.ChildAdded:Connect(function(Object)
        if Object:IsA("Tool") and type(Ragebot.RefreshReload) == "function" then Defer(Ragebot.RefreshReload) end
    end)
    Ragebot.Runtime.ReloadCharacterChildRemovedConnection = Character.ChildRemoved:Connect(function(Object)
        if Object:IsA("Tool") and type(Ragebot.RefreshReload) == "function" then Defer(Ragebot.RefreshReload) end
    end)
end
function Ragebot.EnsureReloadMonitor()
    if Ragebot.Settings.AutoReload ~= true then return false end
    if not Ragebot.Runtime.ReloadCharacterAddedConnection then
        Ragebot.Runtime.ReloadCharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(Character)
            Ragebot.BindReloadCharacter(Character)
            Defer(Ragebot.RefreshReload)
        end)
    end
    if not Ragebot.Runtime.ReloadCharacterRemovingConnection then
        Ragebot.Runtime.ReloadCharacterRemovingConnection = LocalPlayer.CharacterRemoving:Connect(function()
            Ragebot.DisconnectReload()
            Ragebot.BindReloadCharacter(nil)
        end)
    end
    Ragebot.BindReloadCharacter(LocalPlayer.Character)
    if not Ragebot.Runtime.ReloadMonitorConnection then
        Ragebot.Runtime.ReloadMonitorAccumulator = 0
        Ragebot.Runtime.ReloadMonitorConnection = RunService.Heartbeat:Connect(function(DeltaTime)
            if Ragebot.Settings.AutoReload ~= true then return end
            Ragebot.Runtime.ReloadMonitorAccumulator = (tonumber(Ragebot.Runtime.ReloadMonitorAccumulator) or 0) + Max(tonumber(DeltaTime) or 0, 0)
            if Ragebot.Runtime.ReloadMonitorAccumulator < 0.05 then return end
            Ragebot.Runtime.ReloadMonitorAccumulator = 0
            local Character = LocalPlayer.Character
            local Tool = Character and Character:FindFirstChildOfClass("Tool")
            if Tool ~= Ragebot.Runtime.ReloadTool then
                Ragebot.BindReload(Tool)
            elseif Tool then
                Ragebot.RequestReload(Tool)
            end
        end)
    end
    return true
end
function Ragebot.BindReload(Tool)
    if type(Ragebot.Runtime.ReloadConnections) ~= "table" then Ragebot.Runtime.ReloadConnections = {} end
    if Ragebot.Settings.AutoReload ~= true then
        Ragebot.DisconnectReload()
        return
    end
    if not Tool or not Tool.Parent or not Ragebot.IsGun(Tool) then
        Ragebot.DisconnectReload()
        return
    end
    local State = Ragebot.GetReloadValues(Tool)
    local ServerAmmo = State and State.ServerAmmo or nil
    local ServerStored = State and State.ServerStored or nil
    local LocalAmmo = State and State.LocalAmmo or nil
    if Ragebot.Runtime.ReloadTool == Tool and Ragebot.Runtime.ReloadAmmoObject == ServerAmmo and Ragebot.Runtime.ReloadStoredObject == ServerStored
        and Ragebot.Runtime.ReloadLocalAmmoObject == LocalAmmo then
        Ragebot.RequestReload(Tool)
        return
    end
    Ragebot.DisconnectReload()
    local Connections = Ragebot.Runtime.ReloadConnections
    Ragebot.Runtime.ReloadTool = Tool
    Ragebot.Runtime.ReloadAmmoObject = ServerAmmo
    Ragebot.Runtime.ReloadStoredObject = ServerStored
    Ragebot.Runtime.ReloadLocalAmmoObject = LocalAmmo
    local function Request()
        if type(Ragebot.RequestReload) ~= "function" then
            return
        end
        Defer(Ragebot.RequestReload, Tool)
    end
    for _, Object in ipairs({ServerAmmo, ServerStored, LocalAmmo}) do
        if Object then Connections[#Connections + 1] = Object:GetPropertyChangedSignal("Value"):Connect(Request) end
    end
    Connections[#Connections + 1] = Tool.DescendantAdded:Connect(function(Object)
        if Object.Name == "SERVER_Ammo" or Object.Name == "SERVER_StoredAmmo" or Object.Name == "Ammo" or Object.Name == "StoredAmmo" then Defer(Ragebot.RefreshReload) end
    end)
    Connections[#Connections + 1] = Tool.AncestryChanged:Connect(function()
        if Tool.Parent ~= LocalPlayer.Character then Defer(Ragebot.RefreshReload) end
    end)
    Ragebot.RequestReload(Tool)
end
function Ragebot.RefreshReload()
    if type(Ragebot.Runtime.ReloadConnections) ~= "table" then Ragebot.Runtime.ReloadConnections = {} end
    if type(Ragebot.Runtime.ReloadWorkers) ~= "table" then Ragebot.Runtime.ReloadWorkers = setmetatable({}, {__mode = "k"}) end
    if type(Ragebot.Runtime.AutoReloadStates) ~= "table" then Ragebot.Runtime.AutoReloadStates = setmetatable({}, {__mode = "k"}) end
    if Ragebot.Settings.AutoReload ~= true then
        Ragebot.DisconnectReload()
        Ragebot.StopReloadMonitor()
        return
    end
    Ragebot.EnsureReloadMonitor()
    local Character = LocalPlayer.Character
    local Tool = Character and Character:FindFirstChildOfClass("Tool")
    Ragebot.BindReload(Tool)
end

function Ragebot.IsInvisibilityLikeCharacter(Character)
    if not Character or not Character.Parent then
        return false
    end
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root or not Root:IsA("BasePart") then
        return false
    end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local IsR6 = Character:FindFirstChild("Torso") ~= nil or (Humanoid and Humanoid.RigType == Enum.HumanoidRigType.R6)
    if not IsR6 then
        return false
    end
    local RootUpY = Abs(Root.CFrame.UpVector.Y)
    local RootTilted = RootUpY <= 0.45
    local HalfTransparent = 0
    local BodyCount = 0
    local CoreNames = {"Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
    for Index = 1, #CoreNames do
        local Part = Character:FindFirstChild(CoreNames[Index])
        if Part and Part:IsA("BasePart") then
            BodyCount += 1
            local Transparency = tonumber(Part.Transparency) or 0
            if Transparency >= 0.40 and Transparency <= 0.60 then HalfTransparent += 1 end
        end
    end
    local TransparencyMatch = BodyCount >= 4 and HalfTransparent >= 3
    return RootTilted or TransparencyMatch
end

function Ragebot.GetInvisibilityStablePart(Character)
    if not Character then return nil end
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if Root and Root:IsA("BasePart") then
        return Root
    end
    local Torso = Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("LowerTorso")
    if Torso and Torso:IsA("BasePart") then
        return Torso
    end
    local Head = Character:FindFirstChild("Head")
    return Head and Head:IsA("BasePart") and Head or nil
end

function Ragebot.IsTargetDowned(Target, Character)
    if not Target then return false end
    Character = Character or ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    return CombatChecks.IsDowned(Target, Character) == true
end

function Ragebot.GetDirectTargetParts(Character, Target)
    if not Character then return {} end
    if Ragebot.IsTargetDowned(Target, Character) then
        local Head = Character:FindFirstChild("Head")
        return Head and Head:IsA("BasePart") and {Head} or {}
    end
    local Preferred = tostring(Ragebot.Settings.TargetPart or "Head")
    local InvisibilityLike = Ragebot.IsInvisibilityLikeCharacter(Character)
    local Order
    if InvisibilityLike then
        Order = {"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso", "Head", Preferred, "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm", "RightUpperArm",
            "LeftUpperLeg", "RightUpperLeg"}
    else
        Order = {Preferred, "Head", "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm", "RightUpperArm",
            "LeftUpperLeg", "RightUpperLeg"}
    end
    local Output = {}
    local Seen = {}
    for Index = 1, #Order do
        local Name = Order[Index]
        if not Seen[Name] then
            Seen[Name] = true
            local Part = Character:FindFirstChild(Name)
            if Part and Part:IsA("BasePart") then Output[#Output + 1] = Part end
        end
    end
    return Output
end

function Ragebot.IsDirectShotClear(Origin, HitPosition, TargetCharacter)
    if typeof(Origin) ~= "Vector3" or typeof(HitPosition) ~= "Vector3" then
        return false
    end
    local Direction = HitPosition - Origin
    if Direction.Magnitude <= 0.000001 then return false end
    local Parameters = NewRaycastParams()
    Parameters.FilterType = Enum.RaycastFilterType.Exclude
    Parameters.FilterDescendantsInstances = {Workspace.CurrentCamera, LocalPlayer.Character}
    Parameters.IgnoreWater = true
    local Result = Workspace:Raycast(Origin, Direction, Parameters)
    if not Result then return true end
    return TargetCharacter ~= nil and Result.Instance ~= nil and Result.Instance:IsDescendantOf(TargetCharacter)
end

function Ragebot.FindDirectShot(BaseOrigin, Target, TargetPosition)
    if typeof(BaseOrigin) ~= "Vector3" or not Target or not Target.Character then
        return nil
    end
    local Character = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    if not Character then return nil end
    local Parts = Ragebot.GetDirectTargetParts(Character, Target)
    for Index = 1, #Parts do
        local Part = Parts[Index]
        local HitPosition = Part.Position
        if Ragebot.IsDirectShotClear(BaseOrigin, HitPosition, Character) then
            local Direction = HitPosition - BaseOrigin
            if Direction.Magnitude > 0.000001 then
                return {Origin = BaseOrigin, Hit = HitPosition, CandidateHit = HitPosition, Part = Part, HitPartName = Part.Name, Target = Target, Direct = true,
                    Wallbang = false, Stage = "Direct"}
            end
        end
    end
    return nil
end

function Ragebot.ResetWallbangState(Target)
    local Wallbang = Ragebot.Runtime and Ragebot.Runtime.Wallbang
    if type(Wallbang) ~= "table" then return end
    local FibonacciState = Wallbang.FibonacciState
    if Target == nil or (type(FibonacciState) == "table" and FibonacciState.Target == Target) then Wallbang.FibonacciState = nil end
    local WeightedState = Wallbang.MatrixState
    if Target == nil or (type(WeightedState) == "table" and WeightedState.Target == Target) then Wallbang.MatrixState = nil end
    local AngleState = Wallbang.SourceAngleState
    if Target == nil or (type(AngleState) == "table" and AngleState.Target == Target) then Wallbang.SourceAngleState = nil end
    Wallbang.LastScan = 0
    Wallbang.ScanStartedAt = nil
    Wallbang.ScanDeadline = nil
    Wallbang.ScanTimedOut = false
end

local function ClampWallbangMatrixOffset(Offset, Radius)
    if typeof(Offset) ~= "Vector3" then
        return EmptyVector3
    end
    Radius = Max(tonumber(Radius) or 0, 0)
    local Magnitude = Offset.Magnitude
    if Radius > 0 and Magnitude > Radius then
        return Offset.Unit * Radius
    end
    return Offset
end

function Ragebot.GetWallbangWorldIgnoreList(LocalCharacter, TargetCharacter)
    return {Workspace.CurrentCamera, LocalCharacter, TargetCharacter}
end

function Ragebot.TraceWallbangWorldRoute(FromPosition, ToPosition, IgnoreList)
    if typeof(FromPosition) ~= "Vector3" or typeof(ToPosition) ~= "Vector3" then
        return false, nil, 0
    end
    local Direction = ToPosition - FromPosition
    local Distance = Direction.Magnitude
    if Distance <= 0.000001 then
        return true, nil, 1
    end
    local Parameters = NewRaycastParams()
    Parameters.FilterType = Enum.RaycastFilterType.Exclude
    Parameters.FilterDescendantsInstances = type(IgnoreList) == "table" and IgnoreList or {}
    Parameters.IgnoreWater = true
    local Result = Workspace:Raycast(FromPosition, Direction, Parameters)
    if not Result then
        return true, nil, 1
    end
    local Progress = Clamp((Result.Position - FromPosition).Magnitude / Distance, 0, 1)
    return false, Result, Progress
end

function Ragebot.IsWallbangWorldClear(FromPosition, ToPosition, IgnoreList)
    local IsClear = Ragebot.TraceWallbangWorldRoute(FromPosition, ToPosition, IgnoreList)
    return IsClear == true
end

function Ragebot.ValidateWallbangCandidate(FromPosition, ToPosition, IgnoreList)
    if typeof(FromPosition) ~= "Vector3" or typeof(ToPosition) ~= "Vector3" then
        return false, nil, 0
    end
    local Delta = ToPosition - FromPosition
    if Delta.Magnitude <= 0.000001 then
        return false, nil, 0
    end
    local IsClear, Result, Progress = Ragebot.TraceWallbangWorldRoute(FromPosition, ToPosition, IgnoreList)
    return IsClear == true, Result, Progress
end

function Ragebot.GetWallbangOriginHardLimit()
    return Clamp(tonumber(Ragebot.Runtime.Wallbang and Ragebot.Runtime.Wallbang.OriginHardLimit) or 19.001, 1, 19.001)
end

function Ragebot.ClampWallbangOriginOffset(Offset)
    if typeof(Offset) ~= "Vector3" then
        return EmptyVector3
    end
    local Limit = Ragebot.GetWallbangOriginHardLimit()
    local Magnitude = Offset.Magnitude
    if Magnitude > Limit and Magnitude > 0.000001 then
        return Offset.Unit * Limit
    end
    return Offset
end

function Ragebot.GetLiveWallbangOrigin(BaseOrigin, CandidateOrigin)
    if typeof(BaseOrigin) ~= "Vector3" or typeof(CandidateOrigin) ~= "Vector3" then
        return CandidateOrigin
    end
    return BaseOrigin + Ragebot.ClampWallbangOriginOffset(CandidateOrigin - BaseOrigin)
end

local function FindFirstWallbangPart(Character, Names)
    if not Character or type(Names) ~= "table" then
        return nil
    end
    for Index = 1, #Names do
        local Part = Character:FindFirstChild(Names[Index])
        if Part and Part:IsA("BasePart") then
            return Part
        end
    end
    return nil
end

local function MakeWallbangAnchor(Name, Part, LocalOffset)
    if not Part or not Part:IsA("BasePart") then
        return nil
    end
    LocalOffset = typeof(LocalOffset) == "Vector3" and LocalOffset or EmptyVector3
    return {Name = Name, Part = Part, PartName = Part.Name, LocalOffset = LocalOffset}
end

function Ragebot.GetWallbangPriorityAnchors(Character, Target)
    local Anchors = {}
    if not Character then return Anchors end
    local Head = FindFirstWallbangPart(Character, {"Head"})
    if Ragebot.IsTargetDowned(Target, Character) then
        if Head then
            Anchors[1] = MakeWallbangAnchor("HeadCenter", Head, EmptyVector3)
            Anchors[2] = MakeWallbangAnchor("HeadUpper", Head, NewVector3(0, Head.Size.Y * 0.25, 0))
            Anchors[3] = MakeWallbangAnchor("HeadLower", Head, NewVector3(0, -Head.Size.Y * 0.25, 0))
            Anchors[4] = MakeWallbangAnchor("HeadLeft", Head, NewVector3(-Head.Size.X * 0.25, 0, 0))
            Anchors[5] = MakeWallbangAnchor("HeadRight", Head, NewVector3(Head.Size.X * 0.25, 0, 0))
        end
        return Anchors
    end
    local Torso = FindFirstWallbangPart(Character, {"Torso", "UpperTorso", "LowerTorso"})
    local Root = FindFirstWallbangPart(Character, {"HumanoidRootPart"})
    local LeftArm = FindFirstWallbangPart(Character, {"Left Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand"})
    local RightArm = FindFirstWallbangPart(Character, {"Right Arm", "RightUpperArm", "RightLowerArm", "RightHand"})
    local LeftLeg = FindFirstWallbangPart(Character, {"Left Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot"})
    local RightLeg = FindFirstWallbangPart(Character, {"Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot"})
    local function Add(Name, Part, LocalOffset)
        local Anchor = MakeWallbangAnchor(Name, Part, LocalOffset)
        if Anchor then Anchors[#Anchors + 1] = Anchor end
    end
    if Ragebot.IsInvisibilityLikeCharacter(Character) then
        Add("InvisRootStable", Root or Torso, EmptyVector3)
        Add("InvisTorsoStable", Torso or Root, EmptyVector3)
    end
    if Head then
        Add("HeadCenter", Head, EmptyVector3)
        Add("HeadUpper", Head, NewVector3(0, Head.Size.Y * 0.30, 0))
    end
    if Torso then
        Add("TorsoCenter", Torso, EmptyVector3)
        Add("TorsoUpper", Torso, NewVector3(0, Torso.Size.Y * 0.28, 0))
        Add("TorsoLower", Torso, NewVector3(0, -Torso.Size.Y * 0.28, 0))
        Add("TorsoLeft", Torso, NewVector3(-Torso.Size.X * 0.28, 0, 0))
        Add("TorsoRight", Torso, NewVector3(Torso.Size.X * 0.28, 0, 0))
    end
    Add("RootCenter", Root or Torso, EmptyVector3)
    Add("LeftArmCenter", LeftArm or Torso, EmptyVector3)
    Add("RightArmCenter", RightArm or Torso, EmptyVector3)
    Add("LeftLegCenter", LeftLeg or Torso, EmptyVector3)
    Add("RightLegCenter", RightLeg or Torso, EmptyVector3)
    while #Anchors > 12 do
        Anchors[#Anchors] = nil
    end
    return Anchors
end

function Ragebot.GetWallbangAnchorWorldPosition(Anchor)
    if type(Anchor) ~= "table" or not Anchor.Part or not Anchor.Part:IsA("BasePart") then
        return nil
    end
    local LocalOffset = typeof(Anchor.LocalOffset) == "Vector3" and Anchor.LocalOffset or EmptyVector3
    return Anchor.Part.CFrame:PointToWorldSpace(LocalOffset)
end

function Ragebot.FindWallbangAnchorByRoute(Anchors, Route)
    if type(Anchors) ~= "table" or type(Route) ~= "table" then
        return nil
    end
    local RouteName = tostring(Route.AnchorName or "")
    local RoutePartName = tostring(Route.AnchorPartName or "")
    for Index = 1, #Anchors do
        local Anchor = Anchors[Index]
        if Anchor and (tostring(Anchor.Name) == RouteName or (RouteName == "" and Anchor.Part and Anchor.Part.Name == RoutePartName)) then
            return Anchor
        end
    end
    return nil
end

Ragebot.FibonacciConfig = {Revision = 3, PointCount = 40, PhaseCycle = 47, OffsetCache = {}, RadialScales = {1.00, 0.82, 0.64, 0.46}}

local function WallbangGreatestCommonDivisor(FirstValue, SecondValue)
    FirstValue = Abs(Floor(tonumber(FirstValue) or 0))
    SecondValue = Abs(Floor(tonumber(SecondValue) or 0))
    while SecondValue ~= 0 do
        FirstValue, SecondValue = SecondValue, FirstValue % SecondValue
    end
    return FirstValue
end

local function WallbangChooseCoprimeStride(Total, Seed)
    Total = Max(Floor(tonumber(Total) or 1), 1)
    Seed = Max(Floor(tonumber(Seed) or 1), 1)
    local Candidate = Max(3, (Seed % Max(Total - 1, 1)) + 1)
    if Candidate % 2 == 0 then Candidate += 1 end
    for _ = 1, 64 do
        if Candidate < Total and WallbangGreatestCommonDivisor(Candidate, Total) == 1 then
            return Candidate
        end
        Candidate += 2
        if Candidate >= Total then Candidate = 3 end
    end
    return 1
end

local function WallbangFract(Value)
    Value = tonumber(Value) or 0
    return Value - Floor(Value)
end

function Ragebot.GetSourceFibonacciOffsets(Radius, Phase)
    Radius = Clamp(tonumber(Radius) or 19, 1, Ragebot.GetWallbangOriginHardLimit())
    local PointCount = Ragebot.FibonacciConfig.PointCount
    Phase = Max(Floor(tonumber(Phase) or 0), 0) % Ragebot.FibonacciConfig.PhaseCycle
    local Cache = Ragebot.FibonacciConfig.OffsetCache
    local Key = Format("r%d:%.4f:%d:%d", Ragebot.FibonacciConfig.Revision, Radius, PointCount, Phase)
    local Cached = Cache[Key]
    if type(Cached) == "table" and #Cached == PointCount + 1 then
        return Cached
    end
    local Offsets = Table.create(PointCount + 1)
    Offsets[1] = EmptyVector3
    local GoldenAngle = Pi * (3 - Sqrt(5))
    local GoldenConjugate = (Sqrt(5) - 1) * 0.5
    local PhaseRotation = Phase * GoldenAngle * GoldenConjugate
    local Scales = Ragebot.FibonacciConfig.RadialScales
    local ScaleCount = #Scales
    for Index = 0, PointCount - 1 do
        local T = (Index + 0.5) / PointCount
        local Y = 1 - 2 * T
        local Ring = Sqrt(Max(1 - Y * Y, 0))
        local Theta = Index * GoldenAngle + PhaseRotation
        local Direction = NewVector3(Cos(Theta) * Ring, Y, Sin(Theta) * Ring)
        local Lane = ((Index + Phase * 3) % ScaleCount) + 1
        local RadialScale = Scales[Lane]
        if (Index + Phase) % 5 == 0 then RadialScale = 1 end
        Offsets[#Offsets + 1] = Direction * Radius * RadialScale
    end
    Cache[Key] = Offsets
    return Offsets
end

function Ragebot.GetSourcePriorityParts(Character, Target)
    local Output = {}
    if not Character then return Output end
    if Ragebot.IsTargetDowned(Target, Character) then
        local Head = Character:FindFirstChild("Head")
        if Head and Head:IsA("BasePart") then Output[1] = Head end
        return Output
    end
    local Preferred = tostring(Ragebot.Settings.TargetPart or "Head")
    local InvisibilityLike = Ragebot.IsInvisibilityLikeCharacter(Character)
    local Names
    if InvisibilityLike then
        Names = {"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso", "Head", Preferred, "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
    else
        Names = {Preferred, "Head", "Torso", "UpperTorso", "HumanoidRootPart", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"}
    end
    local Seen = {}
    for Index = 1, #Names do
        local Name = Names[Index]
        if not Seen[Name] then
            Seen[Name] = true
            local Part = Character:FindFirstChild(Name)
            if Part and Part:IsA("BasePart") then Output[#Output + 1] = Part end
        end
    end
    return Output
end

function Ragebot.GetSourceState(Target, Character, Radius)
    local Wallbang = Ragebot.Runtime.Wallbang
    local State = Wallbang.FibonacciState
    local NeedsReset = type(State) ~= "table" or State.Fibonacci ~= true or State.Target ~= Target or State.Character ~= Character or Abs((tonumber(State.Radius) or -1)
            - Radius) > 0.0001
    if NeedsReset then
        State = {Fibonacci = true, Target = Target, Character = Character, Radius = Radius, Cursor = 0, Pass = 0, TotalChecks = 0, LastLocalPosition = nil,
            LastTargetPosition = nil}
        Wallbang.FibonacciState = State
    end
    return State
end

function Ragebot.RefreshSourceMotion(State, LocalRoot, TargetRoot)
    if type(State) ~= "table" or not LocalRoot or not TargetRoot then
        return
    end
    local LocalPosition = LocalRoot.Position
    local TargetPosition = TargetRoot.Position
    local ResetDistance = 9
    local Stale = typeof(State.LastLocalPosition) == "Vector3" and (LocalPosition - State.LastLocalPosition).Magnitude > ResetDistance
    Stale = Stale or (typeof(State.LastTargetPosition) == "Vector3" and (TargetPosition - State.LastTargetPosition).Magnitude > ResetDistance)
    if Stale then State.Cursor = 0 end
    State.LastLocalPosition = LocalPosition
    State.LastTargetPosition = TargetPosition
end

function Ragebot.GetSourceCandidateIndices(State, OffsetCount, PartCount)
    OffsetCount = Max(Floor(tonumber(OffsetCount) or 1), 1)
    PartCount = Max(Floor(tonumber(PartCount) or 1), 1)
    local Total = OffsetCount * PartCount * OffsetCount
    local Cursor = Clamp(Floor(tonumber(State.Cursor) or 0), 0, Max(Total - 1, 0))
    local Pass = Max(Floor(tonumber(State.Pass) or 0), 0)
    local Stride = WallbangChooseCoprimeStride(Total, 997 + Pass * 38)
    local Mixed = (Cursor * Stride + Pass * 131) % Total
    local HitIndex = (Mixed % OffsetCount) + 1
    local PartIndex = (Floor(Mixed / OffsetCount) % PartCount) + 1
    local ShootIndex = (Floor(Mixed / (OffsetCount * PartCount)) % OffsetCount) + 1
    return ShootIndex, PartIndex, HitIndex, Total
end

function Ragebot.AdvanceSourceState(State, Total)
    Total = Max(Floor(tonumber(Total) or 1), 1)
    State.Cursor = (tonumber(State.Cursor) or 0) + 1
    if State.Cursor < Total then
        return false
    end
    State.Cursor = 0
    State.Pass = ((tonumber(State.Pass) or 0) + 1) % Ragebot.FibonacciConfig.PhaseCycle
    return true
end

function Ragebot.ScanSourceFibonacciWallbang(BaseOrigin, Target, TargetPosition)
    if typeof(BaseOrigin) ~= "Vector3" or not Target or not Target.Character then
        return nil, 0, "FibonacciBlocked"
    end
    local LocalCharacter = LocalPlayer.Character
    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    if not LocalRoot or not LocalRoot:IsA("BasePart") then
        return nil, 0, "FibonacciBlocked"
    end
    local Character = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    if not Character or not Character.Parent then
        return nil, 0, "FibonacciBlocked"
    end
    local TargetRoot = Character:FindFirstChild("HumanoidRootPart")
    if not TargetRoot or not TargetRoot:IsA("BasePart") then
        return nil, 0, "FibonacciBlocked"
    end
    local Parts = Ragebot.GetSourcePriorityParts(Character, Target)
    if #Parts <= 0 then
        return nil, 0, "FibonacciNoParts"
    end
    local Radius = Clamp(tonumber(Ragebot.Runtime.Wallbang.OriginRadius) or 19, 1, 19.001)
    local State = Ragebot.GetSourceState(Target, Character, Radius)
    Ragebot.RefreshSourceMotion(State, LocalRoot, TargetRoot)
    local Pass = Max(Floor(tonumber(State.Pass) or 0), 0)
    local Offsets = Ragebot.GetSourceFibonacciOffsets(Radius, Pass)
    local OffsetCount = #Offsets
    local IgnoreList = Ragebot.GetWallbangWorldIgnoreList(LocalCharacter, Character)
    local TargetShift = EmptyVector3
    if typeof(TargetPosition) == "Vector3" then TargetShift = TargetPosition - TargetRoot.Position end
    local Checks = 0
    while true do
        if Checks > 0 and Ragebot.IsWallbangTimeSliceExpired(Checks) then
            break
        end
        local ShootIndex, PartIndex, HitIndex, Total = Ragebot.GetSourceCandidateIndices(State, OffsetCount, #Parts)
        local ShootOffset = Offsets[ShootIndex]
        local Part = Parts[PartIndex]
        local HitOffset = Offsets[HitIndex]
        if not Part or not Part.Parent then
            Ragebot.Runtime.Wallbang.FibonacciState = nil
            return nil, Checks, "FibonacciRefresh"
        end
        local PredictedPartPosition = Ragebot.PredictPosition(Target, Part)
        if typeof(PredictedPartPosition) ~= "Vector3" then PredictedPartPosition = Part.Position + TargetShift end
        ShootOffset = Ragebot.ClampWallbangOriginOffset(ShootOffset)
        local ShootPosition = BaseOrigin + ShootOffset
        local HitPosition = PredictedPartPosition + HitOffset
        Checks += 1
        State.TotalChecks = (tonumber(State.TotalChecks) or 0) + 1
        local IsClear = Ragebot.ValidateWallbangCandidate(ShootPosition, HitPosition, IgnoreList)
        local Wrapped = Ragebot.AdvanceSourceState(State, Total)
        if IsClear then
            local Delta = HitPosition - ShootPosition
            return {Origin = ShootPosition, Hit = HitPosition, CandidateHit = HitPosition, Part = Part, DamagePart = Character:FindFirstChild("Head") or Part,
                HitPartName = Part.Name, Target = Target, Direct = false, Wallbang = true, Fibonacci = true, FibonacciWallbang = true, MatrixWallbang = false,
                FibonacciPass = Pass, FibonacciShootOffset = ShootOffset, FibonacciHitOffset = HitOffset, ShootOffset = ShootOffset, PacketDirection =
                    Delta.Magnitude > 0.000001 and Delta.Unit * 1000 or nil, WorldRouteValidated = true, Stage = "Fibonacci"}, Checks, "Fibonacci"
        end
        if Wrapped then
            break
        end
    end
    return nil, Checks, "FibonacciScan"
end

Ragebot.MatrixConfig = {Revision = 7, DirectionCache = {}, PhaseCycle = 127, RefinementSamples = 0, RefinementScale = 0, NearRouteProgress = 1, NearRouteLifetime = 0,
    SuccessRouteLifetime = 0, MotionResetDistance = 12, RadialScales = {1.00, 0.94, 0.88, 0.81, 0.73, 0.65, 0.57, 0.49, 0.41, 0.33}, SearchCycleMultiplier = 6}

local function MatrixFract(Value)
    return WallbangFract(Value)
end

local function BuildMatrixBasis(Axis)
    if typeof(Axis) ~= "Vector3" or Axis.Magnitude <= 0.000001 then Axis = NewVector3(0, 0, -1) end
    local Forward = Axis.Unit
    local Reference = Abs(Forward.Y) > 0.92 and NewVector3(1, 0, 0) or NewVector3(0, 1, 0)
    local Right = Forward:Cross(Reference)
    if Right.Magnitude <= 0.000001 then
        Right = NewVector3(1, 0, 0)
    else
        Right = Right.Unit
    end
    local Up = Right:Cross(Forward)
    if Up.Magnitude <= 0.000001 then
        Up = NewVector3(0, 1, 0)
    else
        Up = Up.Unit
    end
    return Forward, Right, Up
end

function Ragebot.GenerateMatrixDirections(PointCount, Phase, Bias)
    PointCount = Clamp(Floor(tonumber(PointCount) or 96), 1, 192)
    Phase = Max(Floor(tonumber(Phase) or 0), 0) % Ragebot.MatrixConfig.PhaseCycle
    Bias = Clamp(tonumber(Bias) or 1.25, 1.00, 4.00)
    local Directions = Table.create(PointCount)
    Directions[1] = EmptyVector3
    if PointCount == 1 then
        return Directions
    end
    local SampleCount = PointCount - 1
    local PairCount = Max(Ceil(SampleCount / 2), 1)
    local GoldenAngle = Pi * (3 - Sqrt(5))
    local GoldenConjugate = (Sqrt(5) - 1) * 0.5
    local PhaseRotation = Phase * GoldenAngle * GoldenConjugate
    local PhaseShift = MatrixFract(Phase * 0.6180339887498949)
    local Scales = Ragebot.MatrixConfig.RadialScales
    local ScaleCount = #Scales
    for Index = 0, SampleCount - 1 do
        local PairIndex = Floor(Index / 2)
        local U = MatrixFract((PairIndex + 0.5) / PairCount + PhaseShift)
        local VerticalMagnitude = Clamp(U ^ (1 / Bias), 0, 1)
        local HemisphereSign = Index % 2 == 0 and -1 or 1
        local Y = VerticalMagnitude * HemisphereSign
        local Ring = Sqrt(Max(1 - Y * Y, 0))
        local Theta = PairIndex * GoldenAngle + PhaseRotation
        local UnitDirection = NewVector3(Cos(Theta) * Ring, Y, Sin(Theta) * Ring)
        local RadialScale
        if (PairIndex + Phase) % 3 ~= 2 then
            RadialScale = 1.00
        else
            local ScaleIndex = (PairIndex * 7 + Phase * 11) % ScaleCount + 1
            RadialScale = tonumber(Scales[ScaleIndex]) or 1.00
        end
        Directions[Index + 2] = UnitDirection * RadialScale
    end
    return Directions
end

function Ragebot.GetMatrixDirections(PointCount, Phase, Bias)
    PointCount = Clamp(Floor(tonumber(PointCount) or 96), 1, 192)
    Phase = Max(Floor(tonumber(Phase) or 0), 0) % Ragebot.MatrixConfig.PhaseCycle
    Bias = Clamp(tonumber(Bias) or 1.85, 1.05, 4)
    local CacheKey = Format("r%d:%d:%d:%.3f", Ragebot.MatrixConfig.Revision, PointCount, Phase, Bias)
    local Cache = Ragebot.MatrixConfig.DirectionCache
    local Cached = Cache[CacheKey]
    if type(Cached) == "table" and #Cached == PointCount then
        return Cached
    end
    local Directions = Ragebot.GenerateMatrixDirections(PointCount, Phase, Bias)
    Cache[CacheKey] = Directions
    return Directions
end

function Ragebot.TransformMatrixOffset(Direction, Axis, Radius)
    if typeof(Direction) ~= "Vector3" then
        return nil
    end
    Radius = Clamp(tonumber(Radius) or 19.001, 1, 25)
    local Magnitude = Direction.Magnitude
    if Magnitude <= 0.000001 then
        return EmptyVector3
    end
    local RadialScale = Clamp(Magnitude, 0, 1)
    local LocalDirection = Direction.Unit
    local Forward, Right, Up = BuildMatrixBasis(Axis)
    local WorldDirection = Right * LocalDirection.X + Up * LocalDirection.Y + Forward * LocalDirection.Z
    if WorldDirection.Magnitude <= 0.000001 then
        return EmptyVector3
    end
    return WorldDirection.Unit * Radius * RadialScale
end

function Ragebot.GetMatrixState(Target, Character, Radius, OriginPointCount, EndpointPointCount, Bias)
    local Wallbang = Ragebot.Runtime.Wallbang
    local State = Wallbang.MatrixState
    local NeedsReset = type(State) ~= "table" or State.Target ~= Target or State.Character ~= Character or State.Radius ~= Radius or State.OriginPointCount ~= OriginPointCount
        or State.EndpointPointCount ~= EndpointPointCount or Abs((tonumber(State.Bias) or 0) - Bias) > 0.0001
    if NeedsReset then
        State = {Target = Target, Character = Character, Radius = Radius, OriginPointCount = OriginPointCount, EndpointPointCount = EndpointPointCount, Bias = Bias, Cursor = 0,
            Pass = 0, TotalChecks = 0, LastSuccessRoute = nil, NearRoute = nil, RefinementIndex = 1, LastLocalPosition = nil, LastTargetPosition = nil}
        Wallbang.MatrixState = State
    end
    return State
end

function Ragebot.GetMatrixIndices(State, OriginCount, AnchorCount, EndpointCount)
    OriginCount = Max(Floor(tonumber(OriginCount) or 1), 1)
    AnchorCount = Max(Floor(tonumber(AnchorCount) or 1), 1)
    EndpointCount = Max(Floor(tonumber(EndpointCount) or 1), 1)
    local Cursor = Max(Floor(tonumber(State.Cursor) or 0), 0)
    local Pass = Max(Floor(tonumber(State.Pass) or 0), 0)
    local OriginStride = WallbangChooseCoprimeStride(OriginCount, 17 + Pass * 6)
    local AnchorStride = WallbangChooseCoprimeStride(AnchorCount, 5 + Pass * 4)
    local EndpointStride = WallbangChooseCoprimeStride(EndpointCount, 23 + Pass * 10)
    local ShootIndex = (Cursor * OriginStride + Pass * 11) % OriginCount + 1
    local AnchorIndex = (Cursor * AnchorStride + Pass * 7) % AnchorCount + 1
    local EndpointIndex = (Cursor * EndpointStride + Pass * 13) % EndpointCount + 1
    local LargestDimension = Max(OriginCount, AnchorCount, EndpointCount)
    local SearchCycle = Max(LargestDimension * (tonumber(Ragebot.MatrixConfig.SearchCycleMultiplier) or 8), LargestDimension)
    return ShootIndex, AnchorIndex, EndpointIndex, SearchCycle
end

function Ragebot.AdvanceMatrixState(State, OriginCount, AnchorCount, EndpointCount)
    local LargestDimension = Max(Max(Floor(tonumber(OriginCount) or 1), 1), Max(Floor(tonumber(AnchorCount) or 1), 1), Max(Floor(tonumber(EndpointCount) or 1), 1))
    local SearchCycle = Max(Floor(LargestDimension * (tonumber(Ragebot.MatrixConfig.SearchCycleMultiplier) or 8)), LargestDimension)
    State.Cursor = (tonumber(State.Cursor) or 0) + 1
    if State.Cursor < SearchCycle then
        return false
    end
    State.Cursor = 0
    State.Pass = ((tonumber(State.Pass) or 0) + 1) % Ragebot.MatrixConfig.PhaseCycle
    State.RefinementIndex = 1
    return true
end

function Ragebot.ResetMatrixCursor(State)
    if type(State) ~= "table" then
        return
    end
    State.Cursor = 0
    State.RefinementIndex = 1
end

function Ragebot.RefreshMatrixMotion(State, LocalRoot, TargetRoot)
    if type(State) ~= "table" or not LocalRoot or not TargetRoot then
        return
    end
    local ResetDistance = tonumber(Ragebot.MatrixConfig.MotionResetDistance) or 12
    local LocalPosition = LocalRoot.Position
    local TargetPosition = TargetRoot.Position
    local Stale = typeof(State.LastLocalPosition) == "Vector3" and (LocalPosition - State.LastLocalPosition).Magnitude > ResetDistance
    Stale = Stale or (typeof(State.LastTargetPosition) == "Vector3" and (TargetPosition - State.LastTargetPosition).Magnitude > ResetDistance)
    if Stale then
        Ragebot.ResetMatrixCursor(State)
        State.NearRoute = nil
        State.LastSuccessRoute = nil
    end
    State.LastLocalPosition = LocalPosition
    State.LastTargetPosition = TargetPosition
end

function Ragebot.RememberMatrixNearRoute(State, ShootOffset, EndpointOffset, Anchor, Progress)
    if type(State) ~= "table" or typeof(ShootOffset) ~= "Vector3" or typeof(EndpointOffset) ~= "Vector3" or type(Anchor) ~= "table" then
        return
    end
    Progress = Clamp(tonumber(Progress) or 0, 0, 1)
    if Progress
        < Ragebot.MatrixConfig.NearRouteProgress then
        return
    end
    local Current = State.NearRoute
    local Now = Clock()
    if type(Current) == "table" and Now - (tonumber(Current.Time) or 0)
            <= Ragebot.MatrixConfig.NearRouteLifetime and (tonumber(Current.Progress) or 0) > Progress then
        return
    end
    State.NearRoute = {ShootOffset = ShootOffset, EndpointOffset = EndpointOffset, AnchorName = Anchor.Name, AnchorPartName = Anchor.PartName,
        AnchorLocalOffset = Anchor.LocalOffset, Progress = Progress, Time = Now}
    State.RefinementIndex = 1
end

function Ragebot.RememberMatrixRoute(State, ShootOffset, EndpointOffset, Anchor)
    if type(State) ~= "table" or typeof(ShootOffset) ~= "Vector3" or typeof(EndpointOffset) ~= "Vector3" or type(Anchor) ~= "table" then
        return
    end
    State.LastSuccessRoute = {ShootOffset = ShootOffset, EndpointOffset = EndpointOffset, AnchorName = Anchor.Name, AnchorPartName = Anchor.PartName,
        AnchorLocalOffset = Anchor.LocalOffset, Time = Clock()}
    State.NearRoute = nil
    State.RefinementIndex = 1
end

function Ragebot.GetMatrixRefineBase(State)
    if type(State) ~= "table" then
        return nil
    end
    local Now = Clock()
    local Success = State.LastSuccessRoute
    if type(Success) == "table" and Now - (tonumber(Success.Time) or 0)
            <= Ragebot.MatrixConfig.SuccessRouteLifetime then
        return Success, "Success"
    end
    local Near = State.NearRoute
    if type(Near) == "table" and Now - (tonumber(Near.Time) or 0)
            <= Ragebot.MatrixConfig.NearRouteLifetime then
        return Near, "Near"
    end
    return nil
end

function Ragebot.MakeMatrixShot(Target, Character, ShootPosition, HitPosition, Anchor, ShootOffset, EndpointOffset)
    if not Target or not Character or typeof(ShootPosition) ~= "Vector3" or typeof(HitPosition) ~= "Vector3" or type(Anchor) ~= "table" or not Anchor.Part
        or not Anchor.Part:IsA("BasePart") then
        return nil
    end
    local TargetHead = Character:FindFirstChild("Head")
    if not TargetHead or not TargetHead:IsA("BasePart") then
        return nil
    end
    local Delta = HitPosition - ShootPosition
    if Delta.Magnitude <= 0.000001 then
        return nil
    end
    return {Origin = ShootPosition, Hit = HitPosition, CandidateHit = HitPosition, PacketDirection = Delta.Unit * 1000, PacketUnitDirection = Delta.Unit, Target = Target,
        Part = TargetHead, DamagePart = TargetHead, SearchPart = Anchor.Part, ValidatedPart = Anchor.Part, HitPartName = Anchor.PartName, AnchorName = Anchor.Name,
        AnchorPartName = Anchor.PartName, AnchorLocalOffset = Anchor.LocalOffset, ShootOffset = typeof(ShootOffset) == "Vector3" and ShootOffset or EmptyVector3,
        EndpointOffset = typeof(EndpointOffset) == "Vector3" and EndpointOffset or EmptyVector3, Direct = false, Wallbang = true, MatrixWallbang = true, MatrixRoute = true,
        MatrixFibonacci = true, MatrixDual = true, WorldRouteValidated = true, Stage = "Matrix"}
end

function Ragebot.TryMatrixRefine(Target, Character, LocalRoot, TargetRoot, Anchors, State, Radius, Bias, IgnoreList)
    local BaseRoute, Source = Ragebot.GetMatrixRefineBase(State)
    if not BaseRoute then
        return nil, 0
    end
    local Anchor = Ragebot.FindWallbangAnchorByRoute(Anchors, BaseRoute)
    if not Anchor then
        if Source == "Success" then
            State.LastSuccessRoute = nil
        else
            State.NearRoute = nil
        end
        return nil, 0
    end
    local AnchorPosition = Ragebot.GetWallbangAnchorWorldPosition(Anchor)
    if typeof(AnchorPosition) ~= "Vector3" then
        return nil, 0
    end
    local Axis = TargetRoot.Position - LocalRoot.Position
    local SampleCount = Ragebot.MatrixConfig.RefinementSamples
    local RefinementRadius = Max(Radius * Ragebot.MatrixConfig.RefinementScale, 0.25)
    local Pass = Max(Floor(tonumber(State.Pass) or 0), 0)
    local OriginDirections = Ragebot.GetMatrixDirections(SampleCount, Pass * 7 + 13, Bias)
    local EndpointDirections = Ragebot.GetMatrixDirections(SampleCount, Pass * 7 + 29, Bias)
    local Checks = 0
    local StartIndex = Clamp(Floor(tonumber(State.RefinementIndex) or 1), 1, SampleCount)
    for Step = 0, SampleCount - 1 do
        if Checks > 0 and Ragebot.IsWallbangTimeSliceExpired(Checks) then
            break
        end
        local Index = ((StartIndex + Step - 1) % SampleCount) + 1
        local EndpointIndex = (Index * 11 + Pass * 5 - 1) % SampleCount + 1
        local OriginJitter = Ragebot.TransformMatrixOffset(OriginDirections[Index], Axis, RefinementRadius)
        local EndpointJitter = Ragebot.TransformMatrixOffset(EndpointDirections[EndpointIndex], -Axis, RefinementRadius)
        if typeof(OriginJitter) ~= "Vector3" or typeof(EndpointJitter) ~= "Vector3" then
            continue
        end
        local ShootOffset = ClampWallbangMatrixOffset(BaseRoute.ShootOffset + OriginJitter, Radius)
        local EndpointOffset = ClampWallbangMatrixOffset(BaseRoute.EndpointOffset + EndpointJitter, Radius)
        local ShootPosition = LocalRoot.Position + ShootOffset
        local HitPosition = AnchorPosition + EndpointOffset
        Checks += 1
        State.RefinementIndex = (Index % SampleCount) + 1
        local IsClear, _, Progress = Ragebot.ValidateWallbangCandidate(ShootPosition, HitPosition, IgnoreList)
        if IsClear then
            local Shot = Ragebot.MakeMatrixShot(Target, Character, ShootPosition, HitPosition, Anchor, ShootOffset, EndpointOffset)
            if Shot then
                Shot.RefinedRoute = true
                Shot.RefinementSource = Source
                Ragebot.RememberMatrixRoute(State, ShootOffset, EndpointOffset, Anchor)
                return Shot, Checks
            end
        else
            Ragebot.RememberMatrixNearRoute(State, ShootOffset, EndpointOffset, Anchor, Progress)
        end
    end
    return nil, Checks
end

function Ragebot.ScanMatrixWallbang(BaseOrigin, Target, TargetPosition)
    if typeof(BaseOrigin) ~= "Vector3" or not Target or not Target.Character then
        return nil, 0, "MatrixBlocked"
    end
    local LocalCharacter = LocalPlayer.Character
    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    if not LocalRoot or not LocalRoot:IsA("BasePart") then
        return nil, 0, "MatrixBlocked"
    end
    local Character = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    if not Character or not Character.Parent then
        return nil, 0, "MatrixBlocked"
    end
    local TargetHead = Character:FindFirstChild("Head")
    local TargetRoot = Character:FindFirstChild("HumanoidRootPart")
    if not TargetHead or not TargetHead:IsA("BasePart") or not TargetRoot or not TargetRoot:IsA("BasePart") then
        return nil, 0, "MatrixBlocked"
    end
    local Anchors = Ragebot.GetWallbangPriorityAnchors(Character, Target)
    local AnchorCount = #Anchors
    if AnchorCount <= 0 then
        return nil, 0, "MatrixNoAnchors"
    end
    local Wallbang = Ragebot.Runtime.Wallbang
    local OriginRadius = Clamp(tonumber(Wallbang.OriginRadius) or 19.001, 1, Ragebot.GetWallbangOriginHardLimit())
    local HitRadius = Clamp(tonumber(Wallbang.HitRadius) or 25, 1, 25)
    local OriginPointCount = Clamp(Floor(tonumber(Wallbang.OriginPointCount) or 96), 16, 192)
    local EndpointPointCount = Clamp(Floor(tonumber(Wallbang.EndpointPointCount) or 96), 16, 192)
    local Bias = Clamp(tonumber(Wallbang.MatrixBias) or 1.25, 1.00, 2.50)
    local State = Ragebot.GetMatrixState(Target, Character, OriginRadius, OriginPointCount, EndpointPointCount, Bias)
    Ragebot.RefreshMatrixMotion(State, LocalRoot, TargetRoot)
    State.NearRoute = nil
    State.LastSuccessRoute = nil
    local Pass = Max(Floor(tonumber(State.Pass) or 0), 0)
    local PredictedRootPosition = typeof(TargetPosition) == "Vector3" and TargetPosition or Ragebot.GetRouteTargetPosition(Target, TargetRoot)
    if typeof(PredictedRootPosition) ~= "Vector3" then PredictedRootPosition = TargetRoot.Position end
    local PredictionShift = PredictedRootPosition - TargetRoot.Position
    local Axis = PredictedRootPosition - BaseOrigin
    if Axis.Magnitude <= 0.000001 then Axis = TargetRoot.Position - BaseOrigin end
    local ShootDirections = Ragebot.GetMatrixDirections(OriginPointCount, Pass * 11 + 1, Bias)
    local EndpointDirections = Ragebot.GetMatrixDirections(EndpointPointCount, Pass * 13 + 5, Bias)
    local OriginCount = #ShootDirections
    local EndpointCount = #EndpointDirections
    if OriginCount <= 0 or EndpointCount <= 0 then
        return nil, 0, "MatrixNoOffsets"
    end
    local IgnoreList = Ragebot.GetWallbangWorldIgnoreList(LocalCharacter, Character)
    local Checks = 0
    while true do
        if Checks > 0 and Ragebot.IsWallbangTimeSliceExpired(Checks) then
            break
        end
        local ShootIndex, AnchorIndex, EndpointIndex = Ragebot.GetMatrixIndices(State, OriginCount, AnchorCount, EndpointCount)
        local ShootDirection = ShootDirections[ShootIndex]
        local EndpointDirection = EndpointDirections[EndpointIndex]
        local ShootOffset = Ragebot.ClampWallbangOriginOffset(Ragebot.TransformMatrixOffset(ShootDirection, Axis, OriginRadius))
        local RawEndpointOffset = Ragebot.TransformMatrixOffset(EndpointDirection, -Axis, HitRadius)
        local Anchor = Anchors[AnchorIndex]
        local AnchorPosition = Ragebot.GetWallbangAnchorWorldPosition(Anchor)
        local Wrapped = Ragebot.AdvanceMatrixState(State, OriginCount, AnchorCount, EndpointCount)
        if typeof(ShootOffset) ~= "Vector3" or typeof(RawEndpointOffset) ~= "Vector3" or typeof(AnchorPosition) ~= "Vector3" then
            if Wrapped then
                break
            end
            continue
        end
        local EndpointOffset
        if (State.TotalChecks + Checks + Pass) % 4 == 0 then
            EndpointOffset = ClampWallbangMatrixOffset(PredictionShift, HitRadius)
        else
            EndpointOffset = ClampWallbangMatrixOffset(PredictionShift + RawEndpointOffset, HitRadius)
        end
        local ShootPosition = BaseOrigin + ShootOffset
        local HitPosition = AnchorPosition + EndpointOffset
        Checks += 1
        State.TotalChecks = (tonumber(State.TotalChecks) or 0) + 1
        local RouteClear = Ragebot.ValidateWallbangCandidate(ShootPosition, HitPosition, IgnoreList)
        if RouteClear == true then
            local Shot = Ragebot.MakeMatrixShot(Target, Character, ShootPosition, HitPosition, Anchor, ShootOffset, EndpointOffset)
            if Shot then
                State.LastFoundPass = Pass
                State.LastFoundShootOffset = ShootOffset
                State.LastFoundEndpointOffset = EndpointOffset
                State.LastFoundAnchor = Anchor.Name
                return Shot, Checks, "Matrix"
            end
        end
        if Wrapped then
            break
        end
    end
    return nil, Checks, "MatrixScan"
end

Ragebot.AngleOffsetSearch = {Revision = 3, SampleCount = 120, PhaseCycle = 61, MaxOriginRadius = 19.001, MaxEndpointRadius = 7.5}

function Ragebot.GetAngleOffsetState(Target, Character)
    local Wallbang = Ragebot.Runtime.Wallbang
    local State = Wallbang.SourceAngleState
    if type(State) ~= "table" or State.Target ~= Target or State.Character ~= Character or State.AngleRevision ~= Ragebot.AngleOffsetSearch.Revision then
        State = {Target = Target, Character = Character, AngleRevision = Ragebot.AngleOffsetSearch.Revision, Cursor = 0, Pass = 0, TotalChecks = 0, LastLocalPosition = nil,
            LastTargetPosition = nil}
        Wallbang.SourceAngleState = State
    end
    return State
end

function Ragebot.RefreshAngleOffsetMotionState(State, LocalRoot, TargetRoot)
    if type(State) ~= "table" or not LocalRoot or not TargetRoot then
        return
    end
    local LocalPosition = LocalRoot.Position
    local TargetPosition = TargetRoot.Position
    local Stale = typeof(State.LastLocalPosition) == "Vector3" and (LocalPosition - State.LastLocalPosition).Magnitude > 8
    Stale = Stale or (typeof(State.LastTargetPosition) == "Vector3" and (TargetPosition - State.LastTargetPosition).Magnitude > 8)
    if Stale then State.Cursor = 0 end
    State.LastLocalPosition = LocalPosition
    State.LastTargetPosition = TargetPosition
end

function Ragebot.AdvanceAngleOffsetState(State)
    local SampleCount = Ragebot.AngleOffsetSearch.SampleCount
    State.Cursor = (tonumber(State.Cursor) or 0) + 1
    if State.Cursor < SampleCount then
        return false
    end
    State.Cursor = 0
    State.Pass = ((tonumber(State.Pass) or 0) + 1) % Ragebot.AngleOffsetSearch.PhaseCycle
    return true
end

function Ragebot.BuildAngleOffsetCandidate(BaseOrigin, PredictedPartPosition, Axis, SampleIndex, Pass, OriginRadiusLimit, EndpointRadiusLimit)
    local Forward, Right, Up = BuildMatrixBasis(Axis)
    local Golden = 0.6180339887498949
    local R2A = 0.7548776662466927
    local R2B = 0.5698402909980532
    local OriginTurn = WallbangFract((SampleIndex + 0.5) * Golden + Pass * R2A)
    local OriginRadialT = WallbangFract((SampleIndex + 0.5) * R2A + Pass * R2B)
    local OriginDepthT = WallbangFract((SampleIndex + 0.5) * R2B + Pass * Golden)
    local OriginRadius = OriginRadiusLimit * (0.22 + 0.78 * Sqrt(OriginRadialT))
    if (SampleIndex + Pass) % 6 == 0 then OriginRadius = OriginRadiusLimit end
    local OriginTheta = OriginTurn * Pi * 2
    local OriginDepth = (OriginDepthT * 2 - 1) * OriginRadiusLimit * 0.34
    local OriginOffset = Right * Cos(OriginTheta) * OriginRadius + Up * Sin(OriginTheta) * OriginRadius + Forward * OriginDepth
    OriginOffset = Ragebot.ClampWallbangOriginOffset(OriginOffset)
    local EndpointTurn = WallbangFract((SampleIndex + 0.5) * R2B + Pass * 0.4142135623730950 + 0.5)
    local EndpointRadialT = WallbangFract((SampleIndex + 0.5) * 0.4142135623730950 + Pass * Golden)
    local EndpointDepthT = WallbangFract((SampleIndex + 0.5) * R2A + Pass * 0.7320508075688772)
    local EndpointRadius = EndpointRadiusLimit * (0.16 + 0.84 * Sqrt(EndpointRadialT))
    local EndpointTheta = EndpointTurn * Pi * 2
    local EndpointDepth = (EndpointDepthT * 2 - 1) * EndpointRadiusLimit * 0.42
    local EndpointOffset = Right * Cos(EndpointTheta) * EndpointRadius + Up * Sin(EndpointTheta) * EndpointRadius - Forward * EndpointDepth
    local ShootPosition = BaseOrigin + OriginOffset
    local HitPosition = PredictedPartPosition + EndpointOffset
    return ShootPosition, HitPosition, OriginOffset, EndpointOffset
end

function Ragebot.ScanSourceAngleOffsetWallbang(BaseOrigin, Target, TargetPosition)
    if typeof(BaseOrigin) ~= "Vector3" or not Target or not Target.Character then
        return nil, 0, "AngleOffsetBlocked"
    end
    local LocalCharacter = LocalPlayer.Character
    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    local TargetCharacter = ResolveTrackedCharacter(Target, Target.Character) or Target.Character
    local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild("HumanoidRootPart")
    if not LocalCharacter or not LocalRoot or not TargetCharacter or not TargetRoot or not TargetRoot:IsA("BasePart") then
        return nil, 0, "AngleOffsetBlocked"
    end
    local Parts = Ragebot.GetDirectTargetParts(TargetCharacter, Target)
    if #Parts <= 0 then
        return nil, 0, "AngleOffsetNoPart"
    end
    local State = Ragebot.GetAngleOffsetState(Target, TargetCharacter)
    Ragebot.RefreshAngleOffsetMotionState(State, LocalRoot, TargetRoot)
    local Pass = Max(Floor(tonumber(State.Pass) or 0), 0)
    local SampleCount = Ragebot.AngleOffsetSearch.SampleCount
    local OriginRadiusLimit = Min(Clamp(tonumber(Ragebot.Runtime.Wallbang.OriginRadius) or 19, 1, 19.001), Ragebot.AngleOffsetSearch.MaxOriginRadius)
    local EndpointRadiusLimit = Min(OriginRadiusLimit * 0.55, Ragebot.AngleOffsetSearch.MaxEndpointRadius)
    local PredictedRootPosition = typeof(TargetPosition) == "Vector3" and TargetPosition or Ragebot.GetRouteTargetPosition(Target, TargetRoot)
    if typeof(PredictedRootPosition) ~= "Vector3" then PredictedRootPosition = TargetRoot.Position end
    local TargetShift = PredictedRootPosition - TargetRoot.Position
    local IgnoreList = Ragebot.GetWallbangWorldIgnoreList(LocalCharacter, TargetCharacter)
    local Checks = 0
    while true do
        if Checks > 0 and Ragebot.IsWallbangTimeSliceExpired(Checks) then
            break
        end
        local Cursor = Clamp(Floor(tonumber(State.Cursor) or 0), 0, SampleCount - 1)
        local PartStride = WallbangChooseCoprimeStride(#Parts, 5 + Pass * 2)
        local PartIndex = (Cursor * PartStride + Pass) % #Parts + 1
        local Part = Parts[PartIndex]
        if not Part or not Part.Parent then
            Ragebot.Runtime.Wallbang.SourceAngleState = nil
            return nil, Checks, "AngleOffsetRefresh"
        end
        local PredictedPartPosition = Ragebot.PredictPosition(Target, Part)
        if typeof(PredictedPartPosition) ~= "Vector3" then PredictedPartPosition = Part.Position + TargetShift end
        local Axis = PredictedPartPosition - BaseOrigin
        if Axis.Magnitude <= 0.000001 then Axis = PredictedRootPosition - BaseOrigin end
        local ShootPosition, HitPosition, OriginOffset, EndpointOffset = Ragebot.BuildAngleOffsetCandidate(BaseOrigin, PredictedPartPosition, Axis, Cursor, Pass,
                OriginRadiusLimit, EndpointRadiusLimit)
        Checks += 1
        State.TotalChecks = (tonumber(State.TotalChecks) or 0) + 1
        local IsClear = Ragebot.ValidateWallbangCandidate(ShootPosition, HitPosition, IgnoreList)
        local Wrapped = Ragebot.AdvanceAngleOffsetState(State)
        if IsClear then
            local Delta = HitPosition - ShootPosition
            return {Origin = ShootPosition, Hit = HitPosition, CandidateHit = HitPosition, Part = Part, HitPartName = Part.Name, Target = Target, Direct = false,
                Wallbang = true, SourceAngleOffset = true, AdaptiveAngleOffset = true, AnglePass = Pass, AngleSample = Cursor, AngleOriginOffset = OriginOffset,
                AngleEndpointOffset = EndpointOffset, ShootOffset = OriginOffset, PacketDirection = Delta.Magnitude > 0.000001 and Delta.Unit * 1000 or nil,
                WorldRouteValidated = true, Stage = "AngleOffset"}, Checks, "AngleOffset"
        end
        if Wrapped then
            break
        end
    end
    return nil, Checks, "AngleOffsetScan"
end

function Ragebot.FindWallbangShot(BaseOrigin, Target, TargetPosition)
    if typeof(BaseOrigin) ~= "Vector3" or not Target or not Target.Character then
        return nil, 0, "WallbangBlocked"
    end
    local Wallbang = Ragebot.Runtime.Wallbang
    local TotalChecks = 0
    local function TryMatrix()
        Ragebot.BeginWallbangTimeSlice(14, 48, 1.55)
        local Shot, Checks, Stage = Ragebot.ScanMatrixWallbang(BaseOrigin, Target, TargetPosition)
        TotalChecks += tonumber(Checks) or 0
        if Shot then
            Wallbang.LastSuccessfulMethod = "Matrix"
            return Shot, Stage or "Matrix"
        end
        return nil, Stage
    end
    local function TryFibonacci()
        Ragebot.BeginWallbangTimeSlice(6, 22, 1.00)
        local Shot, Checks, Stage = Ragebot.ScanSourceFibonacciWallbang(BaseOrigin, Target, TargetPosition)
        TotalChecks += tonumber(Checks) or 0
        if Shot then
            Wallbang.LastSuccessfulMethod = "Fibonacci"
            return Shot, Stage or "Fibonacci"
        end
        return nil, Stage
    end
    local function TryAngle()
        Ragebot.BeginWallbangTimeSlice(4, 16, 0.78)
        local Shot, Checks, Stage = Ragebot.ScanSourceAngleOffsetWallbang(BaseOrigin, Target, TargetPosition)
        TotalChecks += tonumber(Checks) or 0
        if Shot then
            Wallbang.LastSuccessfulMethod = "Angle"
            return Shot, Stage or "AngleOffset"
        end
        return nil, Stage
    end
    local Preferred = tostring(Wallbang.LastSuccessfulMethod or "Matrix")
    local Order
    if Preferred == "Fibonacci" then
        Order = {TryFibonacci, TryMatrix, TryAngle}
    elseif Preferred == "Angle" then
        Order = {TryAngle, TryMatrix, TryFibonacci}
    else
        Order = {TryMatrix, TryFibonacci, TryAngle}
    end
    local LastStage = "WallbangScan"
    for Index = 1, #Order do
        local Shot, Stage = Order[Index]()
        LastStage = Stage or LastStage
        if Shot then
            return Shot, TotalChecks, Stage
        end
    end
    return nil, TotalChecks, LastStage
end

function Ragebot.GetTarget()
    local Character = LocalPlayer.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Root then return nil end
    local Tool = Character:FindFirstChildOfClass("Tool")
    if not Ragebot.IsFirearm(Tool) then
        Ragebot.CurrentTarget = nil
        return nil
    end
    local CameraObject = Workspace.CurrentCamera
    if not CameraObject then return nil end
    local Mode = tostring(Ragebot.Settings.TargetSelection or "Distance")
    if Mode ~= "Distance" and Mode ~= "Mouse" and Mode ~= "FOV" then
        Mode = "Distance"
        Ragebot.Settings.TargetSelection = Mode
    end
    local MyPosition = Ragebot.GetPosition()
    local MousePosition = Ragebot.GetFieldOfViewPosition()
    local FOVRadius = Clamp(tonumber(Ragebot.Settings.FOV) or 320, 10, 700)
    local ScreenLimited = Mode == "Mouse" or Mode == "FOV"
    local function IsValid(Player)
        if not Player or Player == LocalPlayer or Player.Parent ~= Players or not Player.Character then
            return false
        end
        if not IsCombatTargetAllowed(Player) then return false end
        if not CombatChecks.Passes(Player, Player.Character, Ragebot.Settings) then
            return false
        end
        return Player.Character:FindFirstChild("HumanoidRootPart") ~= nil
    end
    local function GetMetric(Player)
        if not IsValid(Player) then return nil end
        local TargetRoot = Player.Character:FindFirstChild("HumanoidRootPart")
        if not TargetRoot then return nil end
        if Mode == "Distance" then
            return (TargetRoot.Position - MyPosition).Magnitude
        end
        local Metric = Ragebot.GetTargetScreenMetric(Player.Character, MousePosition, CameraObject)
        if not Metric then return nil end
        if ScreenLimited and Metric > FOVRadius then
            return nil
        end
        return Metric
    end
    if Ragebot.Settings.LockTarget == true and Ragebot.CurrentTarget then
        local LockedMetric = GetMetric(Ragebot.CurrentTarget)
        if LockedMetric then
            return Ragebot.CurrentTarget
        end
    end
    local Best
    local BestMetric = Infinite
    local CurrentMetric = GetMetric(Ragebot.CurrentTarget)
    for _, Player in ipairs(Players:GetPlayers()) do
        local Metric = GetMetric(Player)
        if Metric and Metric < BestMetric then
            BestMetric = Metric
            Best = Player
        end
    end
    if Ragebot.CurrentTarget and CurrentMetric and Best and Ragebot.CurrentTarget ~= Best then
        local HoldMargin = Mode == "Distance" and 3 or 10
        if CurrentMetric <= BestMetric + HoldMargin then
            Best = Ragebot.CurrentTarget
            BestMetric = CurrentMetric
        end
    end
    Ragebot.CurrentTarget = Best
    return Best
end
