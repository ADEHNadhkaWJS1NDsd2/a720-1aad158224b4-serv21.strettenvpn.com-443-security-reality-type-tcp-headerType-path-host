function Shared.NormalizeLocalAttackSource(Source)
    Source = tostring(Source or "")
    if Source == "RageBot" or Source == "Ragebot" then return "RageBot" end
    if Source == "SilentAim" or Source == "Silent Aim" then return "SilentAim" end
    if Source == "Aimbot" then return "Aimbot" end
    if Source == "HBE" or Source == "Hitbox" then return "HBE" end
    if Source == "Remote" or Source == "Local" or Source == "Manual" or Source == "" then return "Manual" end
    return Source
end
function Shared.GetLocalAttackSourcePriority(Source)
    Source = Shared.NormalizeLocalAttackSource(Source)
    if Source == "RageBot" then return 100 end
    if Source == "SilentAim" then return 90 end
    if Source == "HBE" then return 85 end
    if Source == "Aimbot" then return 80 end
    if Source == "Manual" then return 60 end
    return 20
end
function Shared.MergeLocalAttackSource(CurrentSource, IncomingSource)
    if IncomingSource == nil then return Shared.NormalizeLocalAttackSource(CurrentSource) end
    if CurrentSource == nil then return Shared.NormalizeLocalAttackSource(IncomingSource) end
    local Current = Shared.NormalizeLocalAttackSource(CurrentSource)
    local Incoming = Shared.NormalizeLocalAttackSource(IncomingSource)
    if Shared.GetLocalAttackSourcePriority(Incoming) >= Shared.GetLocalAttackSourcePriority(Current) then return Incoming end
    return Current
end
function Shared.GetLocalShotTokenKey(Tool, Token)
