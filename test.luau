function HidePlayerOverlayCore(Data)
    if not Data or type(Data.OverlayPrimitives) ~= "table" then return end
    local Names = {"Fill", "BoxOutline", "Box", "Name", "Forcefield", "Weapon", "Distance", "Level", "HealthBack", "HealthDelayed", "Health", "HealthText", "Flags", "AmmoBack", "AmmoBar", "AmmoText", "ProfilePicture", "ProfilePictureBack"}
    for Index = 1, #Names do
        local Object = Data.OverlayPrimitives[Names[Index]]
        if Object then Shared.SafeCall(function() Object.Visible = false end) end
    end
    if type(Data.CornerOutlines) == "table" then
        for Index = 1, #Data.CornerOutlines do
            local Object = Data.CornerOutlines[Index]
            if Object then Shared.SafeCall(function() Object.Visible = false end) end
        end
    end
    if type(Data.Corners) == "table" then
        for Index = 1, #Data.Corners do
            local Object = Data.Corners[Index]
            if Object then Shared.SafeCall(function() Object.Visible = false end) end
        end
    end
end
function UpdatePlayerUICorners(Ui, Width, Height, Color, OutlineColor, Visible)
    if not Ui or type(Ui.Corners) ~= "table" then return end
    local Ratio = Clamp(tonumber(Visuals.Player.CornerLength) or 0.28, 0.10, 0.50)
    local CornerWidth = Max(Width * Ratio, 4)
    local CornerHeight = Max(Height * Ratio, 5)
    local Thickness = Max(tonumber(Visuals.Player.BoxThickness) or 1, 1)
    local BoxTransparency = Clamp(tonumber(Visuals.Player.BoxTransparency) or 0, 0, 0.95)
    local OutlineEnabled = Visuals.Player.OutlineEnabled ~= false
    local OutlineTransparency = Clamp(tonumber(Visuals.Player.OutlineTransparency) or 0.05, 0, 0.95)
    local OutlineThickness = GetPlayerESPOutlineStrokeThickness()
    local Segments = {{0, 0, CornerWidth, Thickness}, {0, 0, Thickness, CornerHeight}, {Width - CornerWidth, 0, CornerWidth, Thickness},
        {Width - Thickness, 0, Thickness, CornerHeight}, {0, Height - Thickness, CornerWidth, Thickness}, {0, Height - CornerHeight, Thickness, CornerHeight},
        {Width - CornerWidth, Height - Thickness, CornerWidth, Thickness}, {Width - Thickness, Height - CornerHeight, Thickness, CornerHeight}}
    for Index = 1, 8 do
        local Line = Ui.Corners[Index]
        local Segment = Segments[Index]
        Line.Visible = Visible
        if Visible then
            Line.Position = FromOffset(Segment[1], Segment[2])
            Line.Size = FromOffset(Segment[3], Segment[4])
            local Mid = NewVector2(Segment[1] + Segment[3] * 0.5, Segment[2] + Segment[4] * 0.5)
            local LineColor = Color
            if BoxGradientAffectsBox() then LineColor = GetBoxGradientColor(GetBoxGradientAlpha(EmptyVector2, NewVector2(Width, Height), Mid)) end
            Line.BackgroundColor3 = LineColor
            Line.BackgroundTransparency = BoxTransparency
            local Stroke = Line:FindFirstChild("Outline")
            if Stroke then
                Stroke.Enabled = OutlineEnabled
                Stroke.Color = OutlineColor
                Stroke.Thickness = Max(OutlineThickness - 0.75, 1)
                Stroke.Transparency = OutlineTransparency
            end
        end
    end
end
function UpdatePlayerUIThumbnail(Data, Ui)
    if not Visuals.Player.ProfilePicture or not Ui or not Ui.Avatar then return end
    if Ui.Avatar.Image ~= "" or Data.UiThumbnailRequested then return end
    Data.UiThumbnailRequested = true
    Spawn(function()
        local Success, Image = Shared.SafeCall(function()
            return Players:GetUserThumbnailAsync(Data.Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)
        Data.UiThumbnailRequested = false
        if Success and type(Image) == "string" and Data.UiEsp == Ui and Ui.Avatar and Ui.Avatar.Parent then Ui.Avatar.Image = Image end
    end)
end
function ApplyPlayerUIBoxState(Ui, Size, EspColor, EspOutline)
    if not Ui or typeof(Size) ~= "Vector2" then return end
    local BoxesEnabled = Visuals.Player.Boxes == true
    local FullBox = BoxesEnabled and Visuals.Player.BoxStyle == "Full"
    local CornerBox = BoxesEnabled and Visuals.Player.BoxStyle == "Corners"
    local OutlineEnabled = Visuals.Player.OutlineEnabled ~= false
    local GradientBox = FullBox and BoxGradientAffectsBox()
    local GradientFill = Visuals.Player.Fill == true and BoxGradientAffectsFill()
    local BoxStrokeObject = Ui.Box and Ui.Box:FindFirstChild("Stroke")
    local OutlineStrokeObject = Ui.BoxOutline and Ui.BoxOutline:FindFirstChild("Stroke")
    if BoxStrokeObject then
        BoxStrokeObject.Thickness = Max(tonumber(Visuals.Player.BoxThickness) or 1, 1)
        BoxStrokeObject.Transparency = Clamp(tonumber(Visuals.Player.BoxTransparency) or 0, 0, 0.95)
        BoxStrokeObject.Color = EspColor
    end
    if OutlineStrokeObject then
        OutlineStrokeObject.Thickness = GetPlayerESPOutlineStrokeThickness()
        OutlineStrokeObject.Transparency = Clamp(tonumber(Visuals.Player.OutlineTransparency) or 0.05, 0, 0.95)
        OutlineStrokeObject.Color = EspOutline
    end
    Ui.BoxOutline.Visible = FullBox and OutlineEnabled
    Ui.Box.Visible = FullBox
    local GradientSequence
    if GradientBox or GradientFill then
        local Settings = Visuals.Player.BoxGradient
        GradientSequence = ColorSequence.new({ColorSequenceKeypoint.new(0, Settings.Color1), ColorSequenceKeypoint.new(0.5, Settings.Color2), ColorSequenceKeypoint.new(1, Settings.Color3)})
    end
    if Ui.BoxStrokeGradient then
        Ui.BoxStrokeGradient.Enabled = GradientBox
        if GradientBox then
            Ui.BoxStrokeGradient.Color = GradientSequence
            Ui.BoxStrokeGradient.Rotation = GetBoxGradientRotation()
        end
    end
    UpdatePlayerUICorners(Ui, Size.X, Size.Y, EspColor, EspOutline, CornerBox)
    Ui.Fill.Visible = Visuals.Player.Fill == true
    Ui.Fill.BackgroundColor3 = Visuals.Player.FillColor
    Ui.Fill.BackgroundTransparency = Clamp(tonumber(Visuals.Player.FillTransparency) or 0.82, 0, 1)
    if Ui.FillGradient then
        Ui.FillGradient.Enabled = GradientFill
        if GradientFill then
            Ui.Fill.BackgroundColor3 = NewColor3(1, 1, 1)
            Ui.FillGradient.Color = GradientSequence
            Ui.FillGradient.Rotation = GetBoxGradientRotation()
        end
    end
    local GlowSettings = Visuals.Player.BoxGlow
    if GlowSettings.Enabled == true and BoxesEnabled then EnsurePlayerUIGlowFrames(Ui) end
    if type(Ui.BoxGlowFrames) == "table" then
        local Layers = Clamp(Floor(tonumber(GlowSettings.Layers) or 3), 1, 6)
        local Spread = Clamp(tonumber(GlowSettings.Spread) or 2, 0.5, 8)
        local GlowColor = GlowSettings.MatchBoxColor == true and EspColor or GlowSettings.Color
        local Pulse = 1
        if GlowSettings.Pulse == true then
            local Speed = Clamp(tonumber(GlowSettings.PulseSpeed) or 2, 0.2, 8)
            Pulse = 0.78 + (Sin(Clock() * Speed * Pi * 2) * 0.5 + 0.5) * 0.22
        end
        for Index = 1, 6 do
            local GlowFrame = Ui.BoxGlowFrames[Index]
            if GlowFrame then
                local Active = GlowSettings.Enabled == true and BoxesEnabled and Index <= Layers
                GlowFrame.Visible = Active
                if Active then
                    local Expansion = Index * Spread
                    GlowFrame.Position = FromOffset(-Expansion, -Expansion)
                    GlowFrame.Size = NewUDim2(1, Expansion * 2, 1, Expansion * 2)
                    local Stroke = GlowFrame:FindFirstChild("Stroke")
                    if Stroke then
                        local Fade = (Index - 1) / Max(Layers - 1, 1)
                        local Transparency = Clamp((tonumber(GlowSettings.Transparency) or 0.78) + Fade * 0.18, 0, 0.98)
                        Stroke.Color = GlowColor
                        Stroke.Thickness = Clamp(tonumber(GlowSettings.Thickness) or 1, 0.5, 4)
                        Stroke.Transparency = Clamp(1 - (1 - Transparency) * Pulse, 0, 0.99)
                    end
                end
            end
        end
    end
end

function UpdatePlayerUIESP(Data, Position, Size, DistanceValue, ToolName, HealthPercent, HealthColor, AmmoCurrent, AmmoMaximum, CurrentTime, EspColor, EspOutline)
    local Ui = EnsurePlayerUIESP(Data) if not Ui then return end
    Ui.Root.Visible = true
    local TextSize = Shared.GetESPTextSize() local LineHeight = TextSize + 3
    ApplyPlayerUIBoxState(Ui, Size, EspColor, EspOutline)
    local VisibilityTextColor = Visuals.Player.TextColor
    local NameOffset = GetPlayerESPPreviewOffset("Name")
    Ui.Name.Visible = Visuals.Player.Names
    Ui.Name.Text = Data.DisplayNameText or Data.Player.Name
    Ui.Name.TextSize = TextSize
    Ui.Name.TextColor3 = VisibilityTextColor
    Ui.Name.AnchorPoint = NewVector2(0.5, 1)
    Ui.Name.Position = NewUDim2(0.5, NameOffset.X, 0, -2 + NameOffset.Y)
    Ui.Name.Size = FromOffset(Max(Size.X + 100, 120), LineHeight)
    local ForcefieldOffset = GetPlayerESPPreviewOffset("Forcefield")
    Ui.Forcefield.Visible = Visuals.Player.Forcefield.Enabled and Data.CachedForcefield == true
    Ui.Forcefield.Text = "[Forcefield]"
    Ui.Forcefield.TextSize = TextSize
    Ui.Forcefield.TextColor3 = Visuals.Player.Forcefield.Color
    Ui.Forcefield.AnchorPoint = NewVector2(0.5, 1)
    Ui.Forcefield.Position = NewUDim2(0.5, ForcefieldOffset.X, 0, -(Visuals.Player.Names and LineHeight + 3 or 2) + ForcefieldOffset.Y)
    Ui.Forcefield.Size = FromOffset(Max(Size.X + 100, 120), LineHeight)
    local BottomOffset = 3
    local function PlaceBottomLabel(Label, Enabled, Text, Color, OffsetName, FontSize)
        Label.Visible = Enabled
        if not Enabled then return end
        local Offset = GetPlayerESPPreviewOffset(OffsetName)
        Label.Text = Text
        Label.TextColor3 = Color
        Label.TextSize = FontSize
        Label.AnchorPoint = NewVector2(0.5, 0)
        Label.Position = NewUDim2(0.5, Offset.X, 1, BottomOffset + Offset.Y)
        Label.Size = FromOffset(Max(Size.X + 120, 140), LineHeight)
        BottomOffset += LineHeight
    end
    local WeaponBottomOffset = BottomOffset
    PlaceBottomLabel(Ui.Weapon, Visuals.Player.Weapon and ToolName ~= nil, ToolName or "", VisibilityTextColor, "Weapon", TextSize)
    if Ui.WeaponIcon then
        local IconAsset = Data.ToolIconAsset
        local ShowIcon = Visuals.Player.Weapon == true and Visuals.Player.WeaponIcon == true and ToolName ~= nil and type(IconAsset) == "string" and IconAsset ~= ""
        Ui.WeaponIcon.Visible = ShowIcon
        if ShowIcon then
            local WeaponOffset = GetPlayerESPPreviewOffset("Weapon")
            local IconSize = Clamp(Visuals.Player.WeaponIconSize, 10, 40)
            local TextWidth = tonumber(Ui.Weapon.TextBounds.X) or 0
            Ui.WeaponIcon.Image = IconAsset
            Ui.WeaponIcon.ImageColor3 = Visuals.Player.WeaponIconColor
            Ui.WeaponIcon.ImageTransparency = 0
            Ui.WeaponIcon.AnchorPoint = NewVector2(0, 0)
            Ui.WeaponIcon.Position = NewUDim2(0.5, -TextWidth * 0.5 - IconSize - 4 + WeaponOffset.X, 1, WeaponBottomOffset - 1 + WeaponOffset.Y)
            Ui.WeaponIcon.Size = FromOffset(IconSize, IconSize)
        end
    end
    PlaceBottomLabel(Ui.Distance, Visuals.Player.Distance, tostring(Floor(DistanceValue + 0.5)) .. "m", VisibilityTextColor, "Distance", TextSize)
    local LevelValue = Visuals.Player.Level and type(GetCachedPlayerLevel) == "function" and GetCachedPlayerLevel(Data, CurrentTime) or nil
    PlaceBottomLabel(Ui.Level, LevelValue ~= nil, LevelValue and ("Level " .. tostring(LevelValue)) or "", Visuals.Player.LevelColor, "Level", TextSize)
    local HealthOffset = GetPlayerESPPreviewOffset("Health Bar") local HealthBackX = -5 + HealthOffset.X
    Ui.HealthBack.Visible = Visuals.Player.HealthBar
    Ui.HealthBack.Position = FromOffset(HealthBackX, HealthOffset.Y)
    Ui.HealthBack.Size = NewUDim2(0, 4, 1, 0)
    local DelayedPercent = Clamp(Data.DelayedHealthPercent or HealthPercent, 0, 1)
    Ui.HealthDelayed.Visible = Visuals.Player.HealthBar and Visuals.Player.Health.Delayed
    Ui.HealthDelayed.BackgroundColor3 = Visuals.Player.Health.DelayedColor
