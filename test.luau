RespawnSafetyState.RemovingConnection = LocalPlayer.CharacterRemoving:Connect(function(Character)
    Shared.ClearRespawnTransientState(Character)
end)
AtramentaConfig.Runtime.CharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(Character)
    RespawnSafetyState.Generation += 1
    local Generation = RespawnSafetyState.Generation
    local Preserved = RespawnSafetyState.Preserved or {}
    RespawnSafetyState.Suspended = true
    RespawnSafetyState.CurrentCharacter = Character
    RespawnSafetyState.RespawnRequestedFor = nil
    Shared.BindRespawnSafety(Character)
    Shared.SafeCall(function()
        local GunSettings = AtramentaConfig.Weapon and AtramentaConfig.Weapon.GunMods
        local NeedWeaponRuntime = AtramentaConfig.Weapon and AtramentaConfig.Weapon.Enabled == true or GunSettings and GunSettings.InstantEquip == true
        if NeedWeaponRuntime and type(BindGunCharacter) == "function" then BindGunCharacter(Character) end
        if GunSettings and GunSettings.InstantEquip == true and type(RefreshUniversalInstantEquip) == "function" then RefreshUniversalInstantEquip(false) end
    end)
    Spawn(function()
        if not Character or not Character.Parent then return end
        local Humanoid = Character:FindFirstChildOfClass("Humanoid") or Character:WaitForChild("Humanoid", 8)
        local RootPart = Character:FindFirstChild("HumanoidRootPart") or Character:WaitForChild("HumanoidRootPart", 8)
        if not Humanoid or not RootPart or not Humanoid.Parent or not RootPart.Parent then return end
        Shared.WaitForConditionSignal(function()
            return Generation ~= RespawnSafetyState.Generation or Character ~= LocalPlayer.Character or not Character.Parent
                or Character:IsDescendantOf(workspace) and Humanoid.Parent and Humanoid.Health > 0
        end, 8, {Character.AncestryChanged, Humanoid:GetPropertyChangedSignal("Health"), Shared.GetPropertyChangedSignalSafe(LocalPlayer, "Character")})
        Wait(0.8)
        if not (Generation == RespawnSafetyState.Generation and Character == LocalPlayer.Character and Character.Parent and Humanoid.Parent
            and RootPart.Parent and Humanoid.Health > 0) then
            return
        end
        RespawnSafetyState.Suspended = false
        RespawnSafetyState.Preserved = nil
        if AtramentaConfig.Visual.ChinaHat.Enabled then
            Shared.SafeCall(function()
                CreateChinaHat(Character)
            end)
        end
        if AtramentaConfig.Visual.Demon.Enabled then
            Shared.SafeCall(function()
                CreateDemonCosmetics(Character)
            end)
        end
        if Preserved.World and WorldEffectsState.Enabled then Shared.SafeCall(StartWorldEffects) end
        if Preserved.WeaponShader and WeaponShaderSettings.Enabled then
            Shared.SafeCall(function()
                BindWeaponShaderLifecycle()
                EnsureWeaponShaderRender()
                RebindWeaponShadersAfterRespawn(Character)
            end)
        end
        Wait(0.15)
        if not (Generation == RespawnSafetyState.Generation) then return end
        if Preserved.Arms then Shared.SafeCall(ArmsChamsEnable) end
        if Preserved.Weapon then Shared.SafeCall(WeaponChamsEnable) end
        if Preserved.Bunny or Preserved.Strafe or Preserved.Air then
            BunnyHopEnabled = Preserved.Bunny == true
            AutoStrafeEnabled = Preserved.Strafe == true
            AirControlEnabled = Preserved.Air == true
            Shared.SafeCall(UpdateMovementAssistConnection)
        end
        Wait(0.35)
        if not (Generation == RespawnSafetyState.Generation) then return end
        if Preserved.Noclip then Shared.SafeCall(NoclipEnable) end
        if Preserved.Fly then Shared.SafeCall(FlyEnable) end
        if Preserved.Invis then Shared.SafeCall(InvisibilityEnable) end
        Wait(0.35)
        if Generation == RespawnSafetyState.Generation then
            if Preserved.Stamina then Shared.SafeCall(EnableInfiniteStamina) end
            if Preserved.NoFall then Shared.SafeCall(EnableNoFallDamage) end
            if Preserved.Rage then
                Shared.SafeCall(function()
                    Ragebot.Enable()
                end)
            end
        end
    end)
end)
if LocalPlayer.Character then
    RespawnSafetyState.Suspended = false
    Shared.BindRespawnSafety(LocalPlayer.Character)
end
