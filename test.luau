    local State = AtramentaFakePositionPhysicsState
    local Root = State.SavedRoot
    local SavedCFrame = State.SavedCFrame
    local SavedVelocity = State.SavedVelocity
    local SavedAngularVelocity = State.SavedAngularVelocity
    State.SavedRoot = nil
    State.SavedCFrame = nil
    State.SavedVelocity = nil
    State.SavedAngularVelocity = nil
    State.SpoofApplied = false
    if not Root or not Root.Parent then return false end
    if typeof(SavedCFrame) == "CFrame" then Shared.SafeCall(function() Root.CFrame = SavedCFrame end) end
    if typeof(SavedVelocity) == "Vector3" then Shared.SafeCall(function() Root.AssemblyLinearVelocity = SavedVelocity end) end
    if typeof(SavedAngularVelocity) == "Vector3" then Shared.SafeCall(function() Root.AssemblyAngularVelocity = SavedAngularVelocity end) end
    return true
end

