end

function PlayerVisuals.Material.IsBodyVisualObject(Data, Object)
    local Character = Data and Data.Character
    if not Character or not Object or not Object:IsDescendantOf(Character) then return false end
    if Object:GetAttribute("AtramentaVisual") == true then return false end
    if Object:FindFirstAncestorOfClass("Tool") then return false end
    return PlayerVisuals.Material.GetAccessory(Object) == nil
end

function PlayerVisuals.Material.Rescan(Data)
    local Character = Data and Data.Character
    if not Character or not Character.Parent then return false end
    Data.PlayerMaterialObjects = type(Data.PlayerMaterialObjects) == "table" and Data.PlayerMaterialObjects or setmetatable({}, {__mode = "k"})
    for _, Object in ipairs(Character:GetDescendants()) do
        PlayerVisuals.Material.Track(Data, Object)
    end
    return true
end
function PlayerVisuals.Material.IsAllowed(Data, Object)
    local Character = Data and Data.Character
    if not Character or not Object or not Object:IsDescendantOf(Character) then return false end
    if Object:GetAttribute("AtramentaVisual") == true then return false end
    if Object:FindFirstAncestorOfClass("Tool") then return false end
    local Accessory = PlayerVisuals.Material.GetAccessory(Object)
    if Accessory and Visuals.Player.Material.Scope ~= "Body + Accessories" then
        return false
    end
    return true
end
function PlayerVisuals.Material.DisconnectObjectSignal(Data, Object)
    local Signals = Data and Data.PlayerMaterialObjectSignals
    local Connection = type(Signals) == "table" and Signals[Object] or nil
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    if type(Signals) == "table" then Signals[Object] = nil end
end

function PlayerVisuals.Material.SyncSnapshotProperty(Data, Object, Kind, Property)
    local Snapshots = Data and Data.PlayerMaterialSnapshots
    local Snapshot = type(Snapshots) == "table" and Snapshots[Object] or nil
    if type(Snapshot) ~= "table" or not Object or not Object.Parent then
        return
    end
    if Kind == "Part" then
        if Property == "Color" then Snapshot.Color = Object.Color
        elseif Property == "Material" then Snapshot.Material = Object.Material
        elseif Property == "MaterialVariant" then Snapshot.MaterialVariant = Object.MaterialVariant
        elseif Property == "Reflectance" then Snapshot.Reflectance = Object.Reflectance
        elseif Property == "Transparency" then Snapshot.Transparency = Object.Transparency
        elseif Property == "LocalTransparencyModifier" then Snapshot.LocalTransparencyModifier = Object.LocalTransparencyModifier
        elseif Property == "TextureID" and Object:IsA("MeshPart") then Snapshot.TextureID = Object.TextureID
        elseif Property == "UsePartColor" and Object:IsA("UnionOperation") then Snapshot.UsePartColor = Object.UsePartColor end
    elseif Kind == "Mesh" then
        if Property == "TextureId" then Snapshot.TextureId = Object.TextureId
        elseif Property == "VertexColor" and Object:IsA("SpecialMesh") then Snapshot.VertexColor = Object.VertexColor end
    elseif Kind == "Texture" then
        if Property == "Texture" then Snapshot.Texture = Object.Texture
        elseif Property == "Transparency" then Snapshot.Transparency = Object.Transparency end
    elseif Kind == "Surface" then
        if Property == "ColorMap" then Snapshot.ColorMap = Object.ColorMap
        elseif Property == "MetalnessMap" then Snapshot.MetalnessMap = Object.MetalnessMap
        elseif Property == "NormalMap" then Snapshot.NormalMap = Object.NormalMap
        elseif Property == "RoughnessMap" then Snapshot.RoughnessMap = Object.RoughnessMap end
    elseif Kind == "Clothing" and Snapshot.Property == Property then
        Snapshot.Value = Object[Property]
    end
end

function PlayerVisuals.Material.BindObjectSignal(Data, Object, Kind)
    if not Data or not Object or not Object:IsA("BasePart") then
        return
    end
    Data.PlayerMaterialObjectSignals = type(Data.PlayerMaterialObjectSignals) == "table" and Data.PlayerMaterialObjectSignals or setmetatable({}, {__mode = "k"})
    if Data.PlayerMaterialObjectSignals[Object] then
        return
    end
    local Watched = {Color = true, Material = true, MaterialVariant = true, Reflectance = true, Transparency = true, LocalTransparencyModifier = true, UsePartColor = true}
    Data.PlayerMaterialObjectSignals[Object] = Object.Changed:Connect(function(Property)
            if Data.PlayerMaterialApplying == true or Visuals.Player.Material.Enabled ~= true or Watched[Property] ~= true then
                return
            end
            local Snapshot = Data.PlayerMaterialSnapshots and Data.PlayerMaterialSnapshots[Object]
            if type(Snapshot) == "table" then
                if Property == "Color" then
                    Snapshot.Color = Object.Color
                elseif Property == "Material" then
                    Snapshot.Material = Object.Material
                elseif Property == "MaterialVariant" then
                    Snapshot.MaterialVariant = Object.MaterialVariant
                elseif Property == "Reflectance" then
                    Snapshot.Reflectance = Object.Reflectance
                elseif Property == "Transparency" then
                    Snapshot.Transparency = Object.Transparency
                elseif Property == "LocalTransparencyModifier" then
                    Snapshot.LocalTransparencyModifier = Object.LocalTransparencyModifier
                elseif Property == "UsePartColor" and Object:IsA("UnionOperation") then
                    Snapshot.UsePartColor = Object.UsePartColor
                end
            end
            Data.PlayerMaterialDirty = true
            PlayerVisuals.QueueUpdate(Data, false)
        end)
end
function PlayerVisuals.Material.Track(Data, Object)
    if not Data or not Object or not Object:IsA("BasePart") or Object.Name == "HumanoidRootPart" or not PlayerVisuals.Material.IsAllowed(Data, Object) then
        return
    end
    Data.PlayerMaterialObjects = type(Data.PlayerMaterialObjects) == "table" and Data.PlayerMaterialObjects or setmetatable({}, {__mode = "k"})
    local WasTracked = Data.PlayerMaterialObjects[Object] ~= nil
    Data.PlayerMaterialObjects[Object] = "Part"
    PlayerVisuals.Material.BindObjectSignal(Data, Object, "Part")
    if not WasTracked and Visuals.Player.Material.Enabled == true then Data.PlayerMaterialDirty = true end
end
function PlayerVisuals.Material.Snapshot(Data, Object, Kind)
    if not Object or not Object:IsA("BasePart") then
        return nil
    end
    Data.PlayerMaterialSnapshots = type(Data.PlayerMaterialSnapshots) == "table" and Data.PlayerMaterialSnapshots or setmetatable({}, {__mode = "k"})
    local Snapshot = Data.PlayerMaterialSnapshots[Object]
    if Snapshot then
        return Snapshot
    end
    Snapshot = {Color = Object.Color, Material = Object.Material, MaterialVariant = Object.MaterialVariant, Reflectance = Object.Reflectance,
        Transparency = Object.Transparency, LocalTransparencyModifier = Object.LocalTransparencyModifier, UsePartColor = Object:IsA("UnionOperation") and Object.UsePartColor
            or nil}
    Data.PlayerMaterialSnapshots[Object] = Snapshot
    return Snapshot
end
function PlayerVisuals.Material.RestoreObject(Object, Kind, Snapshot)
    if not Object or not Object.Parent or not Object:IsA("BasePart") or type(Snapshot) ~= "table" then
        return
    end
    Object.Color = Snapshot.Color
    Object.Material = Snapshot.Material
    Object.MaterialVariant = Snapshot.MaterialVariant or ""
    Object.Reflectance = Snapshot.Reflectance
    Object.Transparency = Snapshot.Transparency
    Object.LocalTransparencyModifier = tonumber(Snapshot.LocalTransparencyModifier) or 0
    if Object:IsA("UnionOperation") and Snapshot.UsePartColor ~= nil then Object.UsePartColor = Snapshot.UsePartColor end
end
function PlayerVisuals.Material.Restore(Data)
    if not Data then return end
    PlayerVisuals.Material.Disconnect(Data)
    PlayerVisuals.Material.DestroyProxyModel(Data)
    if type(Data.PlayerMaterialObjectSignals) == "table" then
        for Object, Connection in pairs(Data.PlayerMaterialObjectSignals) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
            Data.PlayerMaterialObjectSignals[Object] = nil
        end
    end
    Data.PlayerMaterialCharacter = nil
    Data.PlayerMaterialScope = nil
    Data.PlayerMaterialObjects = setmetatable({}, {__mode = "k"})
    Data.PlayerMaterialSnapshots = setmetatable({}, {__mode = "k"})
    Data.PlayerMaterialDirty = true
    Data.PlayerMaterialApplied = nil
    Data.PlayerMaterialObjectSignals = setmetatable({}, {__mode = "k"})
    Data.MaterialCharacter = nil
    Data.PlayerMaterialApplying = false
    if type(Shared.ResetPlayerESPBounds) == "function" then Shared.ResetPlayerESPBounds(Data) end
end
function PlayerVisuals.Material.Bind(Data)

    local Character = Data and Data.Character
    return Data ~= nil and Character ~= nil and Character.Parent ~= nil
