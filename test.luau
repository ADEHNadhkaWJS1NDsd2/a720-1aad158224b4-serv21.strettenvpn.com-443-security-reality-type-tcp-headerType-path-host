    local Raw = Root.AssemblyLinearVelocity or Root.Velocity or EmptyVector3
    if not Player then return ResolverClampVector(Raw, 240), nil end
    local Data = ResolverSampleMotion(Player, Character, Settings)
    return Data and (Data.Velocity or Data.ResolvedVelocity) or ResolverClampVector(Raw, 240), Data
end
function ResolverGetLeadVelocity(Data, Settings)
    Settings = Settings or {}
    local TickRate = Clamp(tonumber(Settings.ServerTickRate) or 60, Res.PredictionTickRateMinimum, Res.PredictionTickRateMaximum)
    local TickLength = 1 / TickRate
    local MaxTicks = Clamp(Floor(tonumber(Settings.MaxExtrapolationTicks) or Res.MaximumExtrapolationTicks), 1, 8)
    local Ping = ResolverGetPing()
    local Age = Data and Clamp(Clock() - (tonumber(Data.LastTime) or Clock()), 0, 0.10) or 0
    local Ticks = Clamp(Ceil((Ping * 0.5 + Age * 0.35 + TickLength) / TickLength), Res.MinimumExtrapolationTicks, MaxTicks)
