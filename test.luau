do
    local LegacyRestorePlayerMaterial = PlayerVisuals.Material.Restore
    PlayerVisuals.Material.Enums = {Neon = Enum.Material.Neon, ForceField = Enum.Material.ForceField}
    local SourceBodyNames = {Head = true, Torso = true, UpperTorso = true, LowerTorso = true,
        ["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true, LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
        RightUpperArm = true, RightLowerArm = true, RightHand = true, LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
        RightUpperLeg = true, RightLowerLeg = true, RightFoot = true}
    local function DestroyOldMaterialGlow(Parent)
        if not Parent then return end
        for _, Object in ipairs(Parent:GetDescendants()) do
            if Object.Name == "AtramentaMaterialGlow" or Object.Name == "MaterialGlowInner" or Object.Name == "MaterialGlowOuter" then Shared.SafeCall(Object.Destroy, Object) end
        end
    end
    DestroyOldMaterialGlow(Workspace.CurrentCamera)
    DestroyOldMaterialGlow(workspace)
    local function DisconnectBucket(Bucket)
        if type(Bucket) ~= "table" then return end
        for Key, Connection in pairs(Bucket) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
            Bucket[Key] = nil
        end
    end
    local function SourceMaterialDisconnect(Data)
        if not Data then return end
        DisconnectBucket(Data.SourceMaterialConnections)
        Data.SourceMaterialConnections = nil
        if type(Data.SourceMaterialObjectConnections) == "table" then
            for Object, Bucket in pairs(Data.SourceMaterialObjectConnections) do
                DisconnectBucket(Bucket)
                Data.SourceMaterialObjectConnections[Object] = nil
            end
        end
        Data.SourceMaterialObjectConnections = setmetatable({}, {__mode = "k"})
    end
    local function SourceMaterialIsAccessoryPart(Object)
        return Object and Object:IsA("BasePart") and Object:FindFirstAncestorOfClass("Accessory") ~= nil
    end
    local function SourceMaterialIsVisualPart(Character, Object)
        if not Character or not Object or not Object:IsA("BasePart") or not Object:IsDescendantOf(Character) then return false end
        if Object:FindFirstAncestorOfClass("Tool") then return false end
        if Object:GetAttribute("AtramentaVisual") == true or Object:GetAttribute("AtramentaHeadHitboxVisual") == true then return false end
        if Object.Name == "HumanoidRootPart" then return false end
        if SourceBodyNames[Object.Name] or SourceMaterialIsAccessoryPart(Object) then return true end
        return Object.Parent == Character and Object.Transparency < 0.995
    end
    local function GetSettings()
        local Settings = Visuals.Player.Material
        local TypeName = tostring(Settings.Type or "Neon")
        local MaterialEnum = PlayerVisuals.Material.Enums[TypeName] or Enum.Material.Neon
        if not PlayerVisuals.Material.Enums[TypeName] then Settings.Type = "Neon" end
        local Color = typeof(Settings.Color) == "Color3" and Settings.Color or NewRGB(249, 217, 255)
        local Transparency = Clamp(tonumber(Settings.Transparency) or 0.2, 0, 0.999999)
        return Settings, MaterialEnum, Color, Transparency
    end
    local function SavePart(Data, Object)
        Data.SourceMaterialParts = type(Data.SourceMaterialParts) == "table" and Data.SourceMaterialParts or setmetatable({}, {__mode = "k"})
        local Saved = Data.SourceMaterialParts[Object]
        if Saved then return Saved end
        local HbeOriginal = Shared.GetPhysicalHbeOriginal(Object)
        Saved = {Color = Object.Color, Material = Object.Material, MaterialVariant = Object.MaterialVariant, Reflectance = Object.Reflectance,
            Transparency = HbeOriginal and HbeOriginal.Transparency or Object.Transparency,
            LocalTransparencyModifier = HbeOriginal and HbeOriginal.LocalTransparencyModifier or Object.LocalTransparencyModifier,
            TextureID = Object:IsA("MeshPart") and Object.TextureID or nil, UsePartColor = Object:IsA("UnionOperation") and Object.UsePartColor or nil}
        Data.SourceMaterialParts[Object] = Saved
        return Saved
    end
    local function SaveProperty(Data, Object, Property)
        Data.SourceMaterialProperties = type(Data.SourceMaterialProperties) == "table" and Data.SourceMaterialProperties or setmetatable({}, {__mode = "k"})
        local Properties = Data.SourceMaterialProperties[Object]
        if type(Properties) ~= "table" then
            Properties = {}
            Data.SourceMaterialProperties[Object] = Properties
        end
        if Properties[Property] == nil then
            local Success, Value = Shared.SafeCall(function() return Object[Property] end)
            if Success then Properties[Property] = {Value = Value} end
        end
        return Properties[Property]
    end
    local function RefreshSavedProperty(Data, Object, Property)
        local Saved = SaveProperty(Data, Object, Property)
        if type(Saved) ~= "table" then return end
        local Success, Value = Shared.SafeCall(function() return Object[Property] end)
        if Success then Saved.Value = Value end
    end
    local function SaveClothing(Data, Object, Property)
        Data.SourceMaterialClothing = type(Data.SourceMaterialClothing) == "table" and Data.SourceMaterialClothing or setmetatable({}, {__mode = "k"})
        local Saved = Data.SourceMaterialClothing[Object]
        if Saved == nil then
            Saved = {Property = Property, Value = Object[Property]}
            Data.SourceMaterialClothing[Object] = Saved
        end
        return Saved
    end
    local function SetApplying(Data, Callback)
        if not Data or type(Callback) ~= "function" then return end
        local Previous = Data.PlayerMaterialApplying == true
        Data.PlayerMaterialApplying = true
        local Results = Pack(Shared.SafeCall(Callback))
        Data.PlayerMaterialApplying = Previous
        return Unpack(Results, 1, Results.n)
    end
    local function ApplyPart(Data, Character, Object)
        if not SourceMaterialIsVisualPart(Character, Object) then return false end
        local Settings, MaterialEnum, Color, Transparency = GetSettings()
        if Settings.Enabled ~= true then return false end
        local Saved = SavePart(Data, Object)
        SetApplying(Data, function()
            Shared.ApplyAtramentaCharacterMaterialPart(Object, Settings.Type, Color, Transparency, Saved)
        end)
        return true
    end
    local function ApplySurface(Data, Object, Kind)
        local Settings = Visuals.Player.Material
        if Settings.Enabled ~= true or not Object or not Object.Parent then return false end
        SetApplying(Data, function()
            if Kind == "SpecialMesh" then
                SaveProperty(Data, Object, "TextureId")
                if Object.TextureId ~= "" then Object.TextureId = "" end
            elseif Kind == "Decal" or Kind == "Texture" then
                SaveProperty(Data, Object, "Transparency")
                if Object.Transparency ~= 1 then Object.Transparency = 1 end
            elseif Kind == "SurfaceAppearance" then
                for _, Property in ipairs({"ColorMap", "MetalnessMap", "NormalMap", "RoughnessMap"}) do
                    SaveProperty(Data, Object, Property)
                    local Success, Current = Shared.SafeCall(function() return Object[Property] end)
                    if Success and Current ~= "" then Shared.SafeCall(function() Object[Property] = "" end) end
                end
            end
        end)
        return true
    end
    local function ApplyClothing(Data, Object, Property)
        local Settings = Visuals.Player.Material
        if Settings.Enabled ~= true or not Object or not Object.Parent then return false end
        SaveClothing(Data, Object, Property)
        SetApplying(Data, function()
            if Object[Property] ~= "" then Object[Property] = "" end
        end)
        return true
    end
    local function EnsureObjectBucket(Data, Object)
        Data.SourceMaterialObjectConnections = type(Data.SourceMaterialObjectConnections) == "table"
            and Data.SourceMaterialObjectConnections or setmetatable({}, {__mode = "k"})
        local Bucket = Data.SourceMaterialObjectConnections[Object]
        if type(Bucket) ~= "table" then
            Bucket = {}
            Data.SourceMaterialObjectConnections[Object] = Bucket
        end
        return Bucket
    end
    local function BindProperty(Data, Object, Property, Callback)
        if not Data or not Object or not Object.Parent then return end
        local Bucket = EnsureObjectBucket(Data, Object)
        if Bucket[Property] then return end
        local Success, Signal = Shared.SafeCall(function() return Object:GetPropertyChangedSignal(Property) end)
        if not Success or typeof(Signal) ~= "RBXScriptSignal" then return end
        Bucket[Property] = Signal:Connect(function()
            if Data.PlayerMaterialApplying == true or Visuals.Player.Material.Enabled ~= true or Data.SourceMaterialBoundCharacter ~= Data.Character then
                return
            end
            Shared.SafeCall(Callback)
        end)
    end
    local function BindPart(Data, Character, Object)
        if not SourceMaterialIsVisualPart(Character, Object) then return false end
        Data.SourceMaterialTrackedParts = type(Data.SourceMaterialTrackedParts) == "table" and Data.SourceMaterialTrackedParts or setmetatable({}, {__mode = "k"})
        if Data.SourceMaterialTrackedParts[Object] then return true end
        Data.SourceMaterialTrackedParts[Object] = true
        SavePart(Data, Object)
        local function Repair(Property)
            local Saved = Data.SourceMaterialParts and Data.SourceMaterialParts[Object]
            if type(Saved) ~= "table" then Saved = SavePart(Data, Object) end
            if Property == "Color" then Saved.Color = Object.Color
            elseif Property == "Material" then Saved.Material = Object.Material
            elseif Property == "MaterialVariant" then Saved.MaterialVariant = Object.MaterialVariant
            elseif Property == "Reflectance" then Saved.Reflectance = Object.Reflectance
            elseif Property == "Transparency" then Saved.Transparency = Object.Transparency
            elseif Property == "LocalTransparencyModifier" then Saved.LocalTransparencyModifier = Object.LocalTransparencyModifier
            elseif Property == "TextureID" and Object:IsA("MeshPart") then Saved.TextureID = Object.TextureID
            elseif Property == "UsePartColor" and Object:IsA("UnionOperation") then Saved.UsePartColor = Object.UsePartColor end
            ApplyPart(Data, Character, Object)
        end
        for _, Property in ipairs({"Material", "MaterialVariant", "Color", "Reflectance", "Transparency"}) do
            local WatchedProperty = Property
            BindProperty(Data, Object, WatchedProperty, function() Repair(WatchedProperty) end)
        end
        if Object:IsA("MeshPart") then
            BindProperty(Data, Object, "TextureID", function() Repair("TextureID") end)
        elseif Object:IsA("UnionOperation") then
            BindProperty(Data, Object, "UsePartColor", function() Repair("UsePartColor") end)
        end
        return true
    end
    local function BindSurface(Data, Character, Object, Kind)
        if not Object or not Object.Parent then return false end
        local Owner = Object:FindFirstAncestorWhichIsA("BasePart")
        if not Owner or not SourceMaterialIsVisualPart(Character, Owner) then return false end
        Data.SourceMaterialTrackedSurfaces = type(Data.SourceMaterialTrackedSurfaces) == "table" and Data.SourceMaterialTrackedSurfaces or setmetatable({}, {__mode = "k"})
        if Data.SourceMaterialTrackedSurfaces[Object] then return true end
        Data.SourceMaterialTrackedSurfaces[Object] = Kind
        if Kind == "SpecialMesh" then
            SaveProperty(Data, Object, "TextureId")
            BindProperty(Data, Object, "TextureId", function()
                RefreshSavedProperty(Data, Object, "TextureId")
                ApplySurface(Data, Object, Kind)
            end)
        elseif Kind == "Decal" or Kind == "Texture" then
            SaveProperty(Data, Object, "Transparency")
            BindProperty(Data, Object, "Transparency", function()
                RefreshSavedProperty(Data, Object, "Transparency")
                ApplySurface(Data, Object, Kind)
            end)
        elseif Kind == "SurfaceAppearance" then
            for _, Property in ipairs({"ColorMap", "MetalnessMap", "NormalMap", "RoughnessMap"}) do
                local WatchedProperty = Property
                SaveProperty(Data, Object, WatchedProperty)
                BindProperty(Data, Object, WatchedProperty, function()
                    RefreshSavedProperty(Data, Object, WatchedProperty)
                    ApplySurface(Data, Object, Kind)
                end)
            end
        end
        return true
    end
    local function BindClothing(Data, Object, Property)
        if not Object or not Object.Parent then return false end
        Data.SourceMaterialTrackedClothing = type(Data.SourceMaterialTrackedClothing) == "table" and Data.SourceMaterialTrackedClothing or setmetatable({}, {__mode = "k"})
        if Data.SourceMaterialTrackedClothing[Object] then return true end
        Data.SourceMaterialTrackedClothing[Object] = Property
        SaveClothing(Data, Object, Property)
        BindProperty(Data, Object, Property, function()
            local Saved = Data.SourceMaterialClothing and Data.SourceMaterialClothing[Object]
            if type(Saved) == "table" then Saved.Value = Object[Property] end
            ApplyClothing(Data, Object, Property)
        end)
        return true
    end
    local function TrackObject(Data, Character, Object, ApplyNow)
        if not Data or not Character or not Object then return false end
        local Tracked = false
        if Object:IsA("BasePart") then
            Tracked = BindPart(Data, Character, Object)
            if Tracked and ApplyNow ~= false then ApplyPart(Data, Character, Object) end
        elseif Object:IsA("Shirt") then
            Tracked = BindClothing(Data, Object, "ShirtTemplate")
            if Tracked and ApplyNow ~= false then ApplyClothing(Data, Object, "ShirtTemplate") end
        elseif Object:IsA("Pants") then
            Tracked = BindClothing(Data, Object, "PantsTemplate")
            if Tracked and ApplyNow ~= false then ApplyClothing(Data, Object, "PantsTemplate") end
        elseif Object:IsA("ShirtGraphic") then
            Tracked = BindClothing(Data, Object, "Graphic")
            if Tracked and ApplyNow ~= false then ApplyClothing(Data, Object, "Graphic") end
        end
        return Tracked
    end
    local function RestoreTrackedObject(Data, Object)
        if not Data or not Object then return end
        local SavedPart = type(Data.SourceMaterialParts) == "table" and Data.SourceMaterialParts[Object] or nil
        if Object:IsA("BasePart") and type(SavedPart) == "table" and Object.Parent then
            SetApplying(Data, function()
                Object.Color = SavedPart.Color
                Object.Material = SavedPart.Material or Enum.Material.Plastic
                Object.MaterialVariant = SavedPart.MaterialVariant or ""
                Object.Reflectance = tonumber(SavedPart.Reflectance) or 0
                Object.Transparency = tonumber(SavedPart.Transparency) or 0
                Object.LocalTransparencyModifier = tonumber(SavedPart.LocalTransparencyModifier) or 0
                if Object:IsA("MeshPart") and SavedPart.TextureID ~= nil then Object.TextureID = SavedPart.TextureID end
                if Object:IsA("UnionOperation") and SavedPart.UsePartColor ~= nil then Object.UsePartColor = SavedPart.UsePartColor end
            end)
        end
        local Properties = type(Data.SourceMaterialProperties) == "table" and Data.SourceMaterialProperties[Object] or nil
        if type(Properties) == "table" and Object.Parent then
            SetApplying(Data, function()
                for Property, Saved in pairs(Properties) do
                    if type(Saved) == "table" then Shared.SafeCall(function() Object[Property] = Saved.Value end) end
                end
            end)
        end
        local Clothing = type(Data.SourceMaterialClothing) == "table" and Data.SourceMaterialClothing[Object] or nil
        if type(Clothing) == "table" and Clothing.Property and Object.Parent then
            SetApplying(Data, function() Shared.SafeCall(function() Object[Clothing.Property] = Clothing.Value or "" end) end)
        end
    end
    local function UntrackObject(Data, Object, Restore)
        if not Data or not Object then return end
        if Restore == true then RestoreTrackedObject(Data, Object) end
        local Bucket = type(Data.SourceMaterialObjectConnections) == "table" and Data.SourceMaterialObjectConnections[Object] or nil
        DisconnectBucket(Bucket)
        if type(Data.SourceMaterialObjectConnections) == "table" then Data.SourceMaterialObjectConnections[Object] = nil end
        if type(Data.SourceMaterialTrackedParts) == "table" then Data.SourceMaterialTrackedParts[Object] = nil end
        if type(Data.SourceMaterialTrackedSurfaces) == "table" then Data.SourceMaterialTrackedSurfaces[Object] = nil end
        if type(Data.SourceMaterialTrackedClothing) == "table" then Data.SourceMaterialTrackedClothing[Object] = nil end
    end
    local function BuildIndex(Data, Character)
        if not Data or not Character or not Character.Parent then return false end
        if type(Data.SourceMaterialObjectConnections) == "table" then
            for Object, Bucket in pairs(Data.SourceMaterialObjectConnections) do
                DisconnectBucket(Bucket)
                Data.SourceMaterialObjectConnections[Object] = nil
            end
        end
        Data.SourceMaterialTrackedParts = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialTrackedSurfaces = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialTrackedClothing = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialObjectConnections = setmetatable({}, {__mode = "k"})
        for _, Object in ipairs(Character:GetDescendants()) do
            TrackObject(Data, Character, Object, false)
        end
        Data.SourceMaterialIndexCharacter = Character
        Data.SourceMaterialIndexDirty = false
        return true
    end
    local function Enforce(Data, Character)
        if not Data or not Character or not Character.Parent then return false end
        local Settings, MaterialEnum, Color, Transparency = GetSettings()
        if Settings.Enabled ~= true then return false end
        if Data.SourceMaterialIndexCharacter ~= Character or type(Data.SourceMaterialTrackedParts) ~= "table" then BuildIndex(Data, Character) end
        for Object in pairs(Data.SourceMaterialTrackedParts or {}) do
            if Object and Object.Parent and Object:IsDescendantOf(Character) then
                ApplyPart(Data, Character, Object)
            else
                UntrackObject(Data, Object, false)
            end
        end
        for Object, Kind in pairs(Data.SourceMaterialTrackedSurfaces or {}) do
            RestoreTrackedObject(Data, Object)
            UntrackObject(Data, Object, false)
        end
        for Object, Property in pairs(Data.SourceMaterialTrackedClothing or {}) do
            if Object and Object.Parent and Object:IsDescendantOf(Character) then
                ApplyClothing(Data, Object, Property)
            else
                UntrackObject(Data, Object, false)
            end
        end
        Data.PlayerMaterialApplied = {Material = MaterialEnum, Color = Color, Transparency = Transparency, Scope = "Full Body + All Accessories"}
        Data.PlayerMaterialDirty = false
        return true
    end
    local function RestoreSaved(Data)
        if not Data then return end
        for Object in pairs(type(Data.SourceMaterialTrackedParts) == "table" and Data.SourceMaterialTrackedParts or {}) do
            RestoreTrackedObject(Data, Object)
        end
        for Object in pairs(type(Data.SourceMaterialTrackedSurfaces) == "table" and Data.SourceMaterialTrackedSurfaces or {}) do
            RestoreTrackedObject(Data, Object)
        end
        for Object in pairs(type(Data.SourceMaterialTrackedClothing) == "table" and Data.SourceMaterialTrackedClothing or {}) do
            RestoreTrackedObject(Data, Object)
        end
        for Object, Saved in pairs(type(Data.SourceMaterialParts) == "table" and Data.SourceMaterialParts or {}) do
            if Object and Object.Parent and Object:IsA("BasePart") and type(Saved) == "table" then
                SetApplying(Data, function()
                    Object.Color = Saved.Color
                    Object.Material = Saved.Material or Enum.Material.Plastic
                    Object.MaterialVariant = Saved.MaterialVariant or ""
                    Object.Reflectance = tonumber(Saved.Reflectance) or 0
                    Object.Transparency = tonumber(Saved.Transparency) or 0
                    Object.LocalTransparencyModifier = tonumber(Saved.LocalTransparencyModifier) or 0
                    if Object:IsA("MeshPart") and Saved.TextureID ~= nil then Object.TextureID = Saved.TextureID end
                    if Object:IsA("UnionOperation") and Saved.UsePartColor ~= nil then Object.UsePartColor = Saved.UsePartColor end
                end)
            end
        end
        for Object, Properties in pairs(type(Data.SourceMaterialProperties) == "table" and Data.SourceMaterialProperties or {}) do
            if Object and Object.Parent and type(Properties) == "table" then
                SetApplying(Data, function()
                    for Property, Saved in pairs(Properties) do
                        if type(Saved) == "table" then Shared.SafeCall(function() Object[Property] = Saved.Value end) end
                    end
                end)
            end
        end
        for Object, Saved in pairs(type(Data.SourceMaterialClothing) == "table" and Data.SourceMaterialClothing or {}) do
            if Object and Object.Parent and type(Saved) == "table" and Saved.Property then
                SetApplying(Data, function() Shared.SafeCall(function() Object[Saved.Property] = Saved.Value or "" end) end)
            end
        end
        Data.SourceMaterialParts = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialProperties = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialClothing = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialTrackedParts = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialTrackedSurfaces = setmetatable({}, {__mode = "k"})
        Data.SourceMaterialTrackedClothing = setmetatable({}, {__mode = "k"})
    end
    function PlayerVisuals.Material.Restore(Data)
        if not Data then return end
        SourceMaterialDisconnect(Data)
        if type(PlayerVisuals.Material.Disconnect) == "function" then Shared.SafeCall(PlayerVisuals.Material.Disconnect, Data) end
        if type(Data.PlayerMaterialObjectSignals) == "table" then
            for Object, Connection in pairs(Data.PlayerMaterialObjectSignals) do
                if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
                Data.PlayerMaterialObjectSignals[Object] = nil
            end
        end
        Data.PlayerMaterialObjects = setmetatable({}, {__mode = "k"})
        if Data.PlayerMaterialModel or Data.PlayerMaterialProxies or Data.PlayerMaterialSourceTransparency then Shared.SafeCall(LegacyRestorePlayerMaterial, Data) end
        Data.PlayerMaterialApplying = true
        RestoreSaved(Data)
        Data.PlayerMaterialApplying = false
        Data.PlayerMaterialCharacter = nil
        Data.MaterialCharacter = nil
        Data.SourceMaterialBoundCharacter = nil
        Data.SourceMaterialIndexCharacter = nil
        Data.PlayerMaterialApplied = nil
        Data.PlayerMaterialDirty = true
        if type(Shared.ResetPlayerESPBounds) == "function" then Shared.ResetPlayerESPBounds(Data) end
    end
    function PlayerVisuals.Material.Bind(Data)
        local Character = Data and Data.Character
        if not Data or not Character or not Character.Parent then return false end
        if Data.SourceMaterialBoundCharacter == Character and type(Data.SourceMaterialConnections) == "table" then return true end
        if Data.SourceMaterialBoundCharacter and Data.SourceMaterialBoundCharacter ~= Character then PlayerVisuals.Material.Restore(Data) end
        SourceMaterialDisconnect(Data)
        if type(PlayerVisuals.Material.Disconnect) == "function" then Shared.SafeCall(PlayerVisuals.Material.Disconnect, Data) end
        if type(Data.PlayerMaterialObjectSignals) == "table" then
            for Object, Connection in pairs(Data.PlayerMaterialObjectSignals) do
                if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
                Data.PlayerMaterialObjectSignals[Object] = nil
            end
        end
        Data.PlayerMaterialObjects = setmetatable({}, {__mode = "k"})
        Data.PlayerMaterialCharacter = Character
        Data.MaterialCharacter = Character
        Data.SourceMaterialBoundCharacter = Character
        Data.SourceMaterialParts = type(Data.SourceMaterialParts) == "table" and Data.SourceMaterialParts or setmetatable({}, {__mode = "k"})
        Data.SourceMaterialProperties = type(Data.SourceMaterialProperties) == "table" and Data.SourceMaterialProperties or setmetatable({}, {__mode = "k"})
        Data.SourceMaterialClothing = type(Data.SourceMaterialClothing) == "table" and Data.SourceMaterialClothing or setmetatable({}, {__mode = "k"})
        Data.SourceMaterialConnections = {}
        BuildIndex(Data, Character)
        Data.SourceMaterialConnections.DescendantAdded = Character.DescendantAdded:Connect(function(Object)
            if Data.SourceMaterialBoundCharacter ~= Character or Visuals.Player.Material.Enabled ~= true then return end
            TrackObject(Data, Character, Object, true)
            if not Object:IsA("BasePart") and (Object:IsA("Accessory") or Object:IsA("Model") or Object:IsA("Folder")) then
                for _, Descendant in ipairs(Object:GetDescendants()) do
                    TrackObject(Data, Character, Descendant, true)
                end
            end
        end)
        Data.SourceMaterialConnections.DescendantRemoving = Character.DescendantRemoving:Connect(function(Object)
            if Data.SourceMaterialBoundCharacter ~= Character then return end
            if Object:IsA("Accessory") or Object:IsA("Model") or Object:IsA("Folder") then
                for _, Descendant in ipairs(Object:GetDescendants()) do
                    UntrackObject(Data, Descendant, true)
                end
            end
            UntrackObject(Data, Object, true)
        end)
        Data.SourceMaterialConnections.Ancestry = Character.AncestryChanged:Connect(function()
            if not Character.Parent and Data.SourceMaterialBoundCharacter == Character then PlayerVisuals.Material.Restore(Data) end
        end)
        return true
    end
    function PlayerVisuals.Material.ApplyInfiniteStaminaState(Data, Visible)
        local Settings = Visuals.Player.Material
        local Character = Data and Data.Character
        if Settings.Enabled ~= true or not Character or not Character.Parent then
            if Data and Data.SourceMaterialBoundCharacter then PlayerVisuals.Material.Restore(Data) end
            return
        end
        if not PlayerVisuals.Material.Bind(Data) then return end
        Enforce(Data, Character)
    end
    function PlayerVisuals.Material.MarkDirty(Rebuild)
        for _, Data in ipairs(Visuals.Player.List) do
            if Rebuild == true then
                PlayerVisuals.Material.Restore(Data)
            else
                Data.PlayerMaterialDirty = true
            end
            if Visuals.Player.Material.Enabled == true then Shared.SafeCall(PlayerVisuals.Material.ApplyInfiniteStaminaState, Data, true) end
        end
    end
end

function SetPlayerChamChamsVisible(Data, Visible, Tier)
    if Visible == true then
        local StyleVisible = Visuals.Player.Chams.VisibilityCheck == true and PlayerVisuals.GetVisibility(Data, false) or true
        PlayerVisuals.Chams.ApplyInfiniteStaminaState(Data, true, Tier, StyleVisible)
    else
        PlayerVisuals.Chams.SetVisible(Data, false)
    end
end

function ApplyPlayerChamVisibilityState(Data, Visible, Force)
    if not Data then return end
    local Tier = tonumber(Data.ChamTier) or 1
    if Visible ~= true then
        PlayerVisuals.Chams.SetVisible(Data, false)
        return
    end
    local StyleVisible = Visuals.Player.Chams.VisibilityCheck == true and PlayerVisuals.GetVisibility(Data, false) or true
    PlayerVisuals.Chams.ApplyInfiniteStaminaState(Data, true, Tier, StyleVisible)
end

function RefreshPlayerChamVisibilityFast(Data)
    if not Data then return end
    local Character = Data.Character
    local Humanoid = Data.Humanoid
    local PlayerObject = Data.Player
    local TeamBlocked = Visuals.Player.TeamCheck and PlayerObject and PlayerObject.Team ~= nil and PlayerObject.Team == LocalPlayer.Team
    local EnemyBlocked = AtramentaHasEnemyTargets() and EnemyTable[PlayerObject] ~= true
    local Eligible = Shared.IsPlayerESPRenderable(Data, Clock()) and not TeamBlocked and not EnemyBlocked
    if not Eligible then
        if Data.PlayerChamFolder then PlayerVisuals.Chams.SetVisible(Data, false) end
        return
    end
    local Tier, Distance = PlayerVisuals.Chams.GetTier(Data)
    local PreviousTier = tonumber(Data.ChamTier) or 0
    local StyleVisible = Visuals.Player.Chams.VisibilityCheck == true and PlayerVisuals.GetVisibility(Data, false) or true
    local VisibilityChanged = Data.ChamStyleVisible ~= StyleVisible
    Data.ChamTier = Tier
    Data.LastChamDistance = Distance
    local Head = Character:FindFirstChild("Head")
    local HeadEntry = Head and Data.PlayerChamLayers and Data.PlayerChamLayers[Head] or nil
    local NeedsRepair = not Data.PlayerChamFolder or not Data.PlayerChamFolder.Parent
        or (Head and (type(HeadEntry) ~= "table" or not HeadEntry.Core or not HeadEntry.Core.Parent))
    if PreviousTier ~= Tier or VisibilityChanged or Data.PlayerChamApplied == nil or NeedsRepair then
        PlayerVisuals.Chams.ApplyInfiniteStaminaState(Data, true, Tier, StyleVisible)
    elseif Tier <= 0 and Data.ChamsRenderActive == true then
        PlayerVisuals.Chams.SetVisible(Data, false)
    elseif Tier > 0 and Data.ChamsRenderActive ~= true then
        PlayerVisuals.Chams.ApplyInfiniteStaminaState(Data, true, Tier, StyleVisible)
    end
end
function RefreshAllPlayerChamVisibilityFast(ForceAll)
    if Visuals.Player.Chams.Enabled ~= true then return end
    local List = Visuals.Player.List
    for Index = 1, #List do
        local Data = List[Index]
        if Data then Shared.SafeCall(RefreshPlayerChamVisibilityFast, Data) end
    end
    Visuals.ChamVisibilityCursor = 1
end
function ApplyPlayerChamData(Data, SkipBloom)
    if not Data then return end
    local Character = Data.Character
    local Humanoid = Data.Humanoid
    local PlayerObject = Data.Player
    PlayerVisuals.BindStateSignals(Data)
    local TeamBlocked = Visuals.Player.TeamCheck and PlayerObject and PlayerObject.Team ~= nil and PlayerObject.Team == LocalPlayer.Team
    local EnemyBlocked = AtramentaHasEnemyTargets() and EnemyTable[PlayerObject] ~= true
    local Eligible = Shared.IsPlayerESPRenderable(Data, Clock()) and not TeamBlocked and not EnemyBlocked
    if not Eligible then
        if Data.PlayerMaterialCharacter then PlayerVisuals.Material.Restore(Data) end
        if Data.PlayerChamFolder then PlayerVisuals.Chams.SetVisible(Data, false) end
        return
    end
    if Visuals.Player.Material.Enabled == true then
        if Data.PlayerMaterialDirty == true or Data.SourceMaterialBoundCharacter ~= Character or Data.PlayerMaterialApplied == nil then
            PlayerVisuals.Material.ApplyInfiniteStaminaState(Data, true)
        end
    elseif Data.PlayerMaterialCharacter then
        PlayerVisuals.Material.Restore(Data)
    end
    if Visuals.Player.Chams.Enabled ~= true then
        if Data.PlayerChamFolder then PlayerVisuals.Chams.Destroy(Data) end
        if not SkipBloom then PlayerVisuals.UpdateBloom() end
        return
    end
    local Tier, Distance = PlayerVisuals.Chams.GetTier(Data)
    Data.ChamTier = Tier
    Data.LastChamDistance = Distance
    if Tier <= 0 then
        PlayerVisuals.Chams.SetVisible(Data, false)
    else
        PlayerVisuals.Chams.ApplyInfiniteStaminaState(Data, true, Tier)
    end
    if not SkipBloom then PlayerVisuals.UpdateBloom() end
end
function UpdatePlayerChams(ForceAll)
    local List = Visuals.Player.List
    for Index = 1, #List do
        local Data = List[Index]
        if Data then Shared.SafeCall(ApplyPlayerChamData, Data, true) end
    end
    if ForceAll ~= false then UpdateChamsBloom() end
end
function Shared.IsWorldPostEffect(Object)
    return Object and (Object:IsA("ColorCorrectionEffect") or Object:IsA("BloomEffect") or Object:IsA("SunRaysEffect")
        or Object:IsA("DepthOfFieldEffect") or Object:IsA("BlurEffect"))
end
function Shared.IsAtramentaWorldEffect(Object)
    return Object == Visuals.World.ColorCorrection or Object == Visuals.World.BloomEffect or Object == Visuals.World.SunRaysEffect
        or Object == Visuals.World.DepthOfFieldEffect or Object == Visuals.World.BlurEffect
        or Object and (Object.Name == "AtramentaWorldColor" or Object.Name == "AtramentaWorldBloom" or Object.Name == "AtramentaWorldSunRays"
            or Object.Name == "AtramentaWorldDepthOfField" or Object.Name == "AtramentaWorldBlur")
end
function Shared.GetLightingTechnology()
    local Success, Value = Shared.SafeCall(function()
        return Lighting.Technology
    end)
    if Success and typeof(Value) == "EnumItem" then
        return Value
    end
    if type(gethiddenproperty) == "function" then
        local HiddenSuccess, HiddenValue = Shared.SafeCall(gethiddenproperty, Lighting, "Technology")
        if HiddenSuccess and typeof(HiddenValue) == "EnumItem" then
            return HiddenValue
        end
    end
    return nil
end

function Shared.SetLightingTechnology(Value)
    if typeof(Value) ~= "EnumItem" then return false end
    local Success = Shared.SafeCall(function()
        Lighting.Technology = Value
    end)
    if Success then return true end
    if type(sethiddenproperty) == "function" then
        local HiddenSuccess = Shared.SafeCall(sethiddenproperty, Lighting, "Technology", Value)
        return HiddenSuccess == true
    end
    return false
end

function Shared.GetLightingTechnologyName()
    local Value = Shared.GetLightingTechnology()
    return typeof(Value) == "EnumItem" and Value.Name or "Future"
end

function Shared.SaveWorldOriginal()
    if Visuals.World.Original then return end
    local Atmospheres = {}
    local PostEffects = setmetatable({}, {__mode = "k"})
    for _, Object in ipairs(Lighting:GetChildren()) do
        if Object:IsA("Atmosphere") and Object ~= Visuals.World.Atmosphere then
            Atmospheres[#Atmospheres + 1] = {Object = Object, Density = Object.Density, Offset = Object.Offset, Color = Object.Color, Decay = Object.Decay,
                Glare = Object.Glare, Haze = Object.Haze}
        elseif Shared.IsWorldPostEffect(Object) and not Shared.IsAtramentaWorldEffect(Object) then
            PostEffects[Object] = {Enabled = Object.Enabled}
        end
    end
    Visuals.World.Original = {Technology = Shared.GetLightingTechnology(), Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, ColorShiftTop = Lighting.ColorShift_Top,
        ColorShiftBottom = Lighting.ColorShift_Bottom, Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
        ExposureCompensation = Lighting.ExposureCompensation, GlobalShadows = Lighting.GlobalShadows,
        ShadowSoftness = Lighting.ShadowSoftness, EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale, EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        FogColor = Lighting.FogColor, FogStart = Lighting.FogStart, FogEnd = Lighting.FogEnd, Atmospheres = Atmospheres, PostEffects = PostEffects}
end
function Shared.SetWorldProperty(Object, Property, Value)
    if Object and Object[Property] ~= Value then Object[Property] = Value end
end
function SaveWorldAtmosphere(Object)
    if not Object or not Object:IsA("Atmosphere") or Object == Visuals.World.Atmosphere then return end
    Shared.SaveWorldOriginal()
    local Original = Visuals.World.Original
    Original.Atmospheres = type(Original.Atmospheres) == "table" and Original.Atmospheres or {}
    for _, Entry in ipairs(Original.Atmospheres) do
        if Entry.Object == Object then return end
    end
    Original.Atmospheres[#Original.Atmospheres + 1] = {Object = Object, Density = Object.Density, Offset = Object.Offset, Color = Object.Color,
        Decay = Object.Decay, Glare = Object.Glare, Haze = Object.Haze}
end
function SuppressWorldAtmospheres()
    Shared.SaveWorldOriginal()
    for _, Object in ipairs(Lighting:GetChildren()) do
        if Object:IsA("Atmosphere") and Object ~= Visuals.World.Atmosphere then
            SaveWorldAtmosphere(Object)
            Shared.SetWorldProperty(Object, "Density", 0)
            Shared.SetWorldProperty(Object, "Haze", 0)
            Shared.SetWorldProperty(Object, "Glare", 0)
        end
    end
    Visuals.World.AtmospheresSuppressed = true
end
function RestoreAtramentaAtmospheres()
    local Atmosphere = Visuals.World.Atmosphere
    if Atmosphere then Atmosphere:Destroy() end
    Visuals.World.Atmosphere = nil
    Visuals.World.AtmospheresSuppressed = false
    local Original = Visuals.World.Original local Entries = Original and Original.Atmospheres
    if type(Entries) ~= "table" then return end
    for _, Entry in ipairs(Entries) do
        local Object = Entry.Object
        if Object and Object.Parent then
            Shared.SafeCall(function()
                Object.Density = Entry.Density
                Object.Offset = Entry.Offset
                Object.Color = Entry.Color Object.Decay = Entry.Decay
                Object.Glare = Entry.Glare
                Object.Haze = Entry.Haze
            end)
        end
    end
end
function SaveWorldPostEffect(Object)
    if not Shared.IsWorldPostEffect(Object) or Shared.IsAtramentaWorldEffect(Object) then return end
    Shared.SaveWorldOriginal()
    local Original = Visuals.World.Original
    Original.PostEffects = type(Original.PostEffects) == "table" and Original.PostEffects or setmetatable({}, {__mode = "k"})
    if Original.PostEffects[Object] == nil then Original.PostEffects[Object] = {Enabled = Object.Enabled} end
end
function SuppressWorldPostEffects()
    for _, Object in ipairs(Lighting:GetChildren()) do
        if Shared.IsWorldPostEffect(Object) and not Shared.IsAtramentaWorldEffect(Object) then
            SaveWorldPostEffect(Object)
            Shared.SetWorldProperty(Object, "Enabled", false)
        end
    end
end
function RestoreWorldPostEffects()
    local Original = Visuals.World.Original local Entries = Original and Original.PostEffects
    if type(Entries) ~= "table" then return end
    for Object, Entry in pairs(Entries) do
        if Object and Object.Parent and type(Entry) == "table" then Shared.SafeCall(function() Object.Enabled = Entry.Enabled == true end) end
    end
end
function EnsureAtramentaAtmosphere()
    if not Visuals.World.FogEnabled then
        RestoreAtramentaAtmospheres()
        return
    end
    SuppressWorldAtmospheres()
    local Atmosphere = Visuals.World.Atmosphere
    if not Atmosphere or not Atmosphere.Parent then
        Atmosphere = NewInstance("Atmosphere")
        Atmosphere.Name = "AtramentaFogAtmosphere"
