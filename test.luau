function GetBoxGradientRotation()
    local Settings = Visuals.Player.BoxGradient
    local Rotation = tonumber(Settings.Rotation) or 90
    if Settings.Animated == true then
        local Direction = Settings.Direction == "Left" and -1 or 1
        Rotation += Clock() * (tonumber(Settings.Speed) or 45) * Direction
    end
    return Rotation % 360
end

function GetBoxGradientColor(Alpha)
    local Settings = Visuals.Player.BoxGradient
    Alpha = Clamp(tonumber(Alpha) or 0, 0, 1)
    local A = Settings.Color1
    local B = Settings.Color2
    local C = Settings.Color3
    if Alpha <= 0.5 then
        return A:Lerp(B, Alpha * 2)
    end
    return B:Lerp(C, (Alpha - 0.5) * 2)
end

function GetBoxGradientAlpha(Position, Size, Point)
    if typeof(Position) ~= "Vector2" or typeof(Size) ~= "Vector2" or typeof(Point) ~= "Vector2" then return 0.5 end
    local Width = Max(Size.X, 1)
    local Height = Max(Size.Y, 1)
    local NX = Clamp((Point.X - Position.X) / Width, 0, 1) - 0.5
    local NY = Clamp((Point.Y - Position.Y) / Height, 0, 1) - 0.5
    local Angle = Rad(GetBoxGradientRotation())
    local AxisX = Cos(Angle)
    local AxisY = Sin(Angle)
    local Projection = NX * AxisX + NY * AxisY
    local Radius = Max(Abs(AxisX) * 0.5 + Abs(AxisY) * 0.5, 0.001)
    return Clamp(0.5 + Projection / (Radius * 2), 0, 1)
end

function BoxGradientAffectsBox()
    local Settings = Visuals.Player.BoxGradient
    return Settings.Enabled == true and (Settings.Mode == "Box" or Settings.Mode == "Box + Fill")
end

function BoxGradientAffectsFill()
    local Settings = Visuals.Player.BoxGradient
    return Settings.Enabled == true and (Settings.Mode == "Fill" or Settings.Mode == "Box + Fill")
end

function EnsureBoxGradientOverlay(Data)
    if not Data then return false end
    for Index = 1, 4 do
