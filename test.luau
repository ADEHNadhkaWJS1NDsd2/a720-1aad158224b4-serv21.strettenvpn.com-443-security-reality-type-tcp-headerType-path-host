function Shared.ReadWeaponMetadataKey(Object)
    if not Object then return nil end
    local DirectKey = Shared.GetKnownWeaponKey(Object.Name)
    if DirectKey then return DirectKey end
    local ConfigKey = Shared.ReadWeaponConfigKey(Object)
    if ConfigKey then return ConfigKey end
    for Index = 1, #Shared.WeaponIdentityFields do
        local Field = Shared.WeaponIdentityFields[Index]
        local AttributeKey = Shared.GetKnownWeaponKey(Object:GetAttribute(Field))
        if AttributeKey then return AttributeKey end
    end
    local Tool = Object:IsA("Tool") and Object or Object:FindFirstChildOfClass("Tool")
    if Tool then
        local ToolConfigKey = Shared.ReadWeaponConfigKey(Tool)
        if ToolConfigKey then return ToolConfigKey end
        local ToolNameKey = Shared.GetKnownWeaponKey(Tool.Name)
        if ToolNameKey then return ToolNameKey end
    end
    for _, Descendant in ipairs(Object:GetDescendants()) do
        if Descendant:IsA("ModuleScript") and Descendant.Name == "Config" then
            local DescendantConfigKey = Shared.ReadWeaponConfigKey(Descendant.Parent)
            if DescendantConfigKey then return DescendantConfigKey end
        elseif Descendant:IsA("StringValue") then
            for Index = 1, #Shared.WeaponIdentityFields do
                if Descendant.Name == Shared.WeaponIdentityFields[Index] then
                    local ValueKey = Shared.GetKnownWeaponKey(Descendant.Value)
                    if ValueKey then return ValueKey end
                    break
                end
            end
        end
        for Index = 1, #Shared.WeaponIdentityFields do
            local Field = Shared.WeaponIdentityFields[Index]
            local AttributeKey = Shared.GetKnownWeaponKey(Descendant:GetAttribute(Field))
            if AttributeKey then return AttributeKey end
        end
    end
    return nil
end
function Shared.GetAssetToken(Value)
