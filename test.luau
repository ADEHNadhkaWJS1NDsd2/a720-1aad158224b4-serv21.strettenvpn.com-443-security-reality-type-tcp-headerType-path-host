function UpdateChinaHatAppearance(UseBatch)
    local Transparency = CosmeticClamp(AtramentaConfig.Visual.ChinaHat.Transparency, 0, 0.94) local SurfaceBeams = AtramentaConfig.Visual.ChinaHat.SurfaceBeams
    local OutlineBeams = AtramentaConfig.Visual.ChinaHat.OutlineBeams local SurfaceCount = #SurfaceBeams
