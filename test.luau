function AtramentaAuraTransparencySequence(Sequence, Transparency)
    Transparency = Clamp(tonumber(Transparency) or 0, 0, 1)
    if typeof(Sequence) ~= "NumberSequence" then return NumberSequence.new(Transparency) end
    local Keypoints = {}
    for Index, Keypoint in ipairs(Sequence.Keypoints) do
        local Value = Transparency + (1 - Transparency) * Keypoint.Value
        local Envelope = Keypoint.Envelope * (1 - Transparency)
        Keypoints[Index] = NumberSequenceKeypoint.new(Keypoint.Time, Clamp(Value, 0, 1), Max(Envelope, 0))
    end
    return NumberSequence.new(Keypoints)
end
function ExtendedVisuals:RememberAuraAppearance(Object)
    if not Object then return end
    local ClassName = Object.ClassName
    if ClassName == "ParticleEmitter" or ClassName == "Beam" or ClassName == "Trail" then
        if self.Aura.OriginalTransparency[Object] == nil then self.Aura.OriginalTransparency[Object] = Object.Transparency end
    elseif ClassName == "PointLight" then
        if self.Aura.OriginalBrightness[Object] == nil then self.Aura.OriginalBrightness[Object] = Object.Brightness end
    end
    for _, Descendant in ipairs(Object:GetDescendants()) do
        local DescendantClass = Descendant.ClassName
        if DescendantClass == "ParticleEmitter" or DescendantClass == "Beam" or DescendantClass == "Trail" then
            if self.Aura.OriginalTransparency[Descendant] == nil then self.Aura.OriginalTransparency[Descendant] = Descendant.Transparency end
        elseif DescendantClass == "PointLight" then
            if self.Aura.OriginalBrightness[Descendant] == nil then self.Aura.OriginalBrightness[Descendant] = Descendant.Brightness end
        end
    end
end
function ExtendedVisuals:ApplyAuraAppearance()
    local Color = typeof(self.Aura.Color) == "Color3" and self.Aura.Color or NewRGB(255, 120, 205)
    local ColorSequenceValue = ColorSequence.new(Color)
    local Transparency = Clamp(tonumber(self.Aura.Transparency) or 0.20, 0, 1)
    local function ApplyAuraToObject(Object)
        if not Object or not Object.Parent then return end
        local ClassName = Object.ClassName
        if ClassName == "PointLight" then
            Object.Color = Color
            local Original = self.Aura.OriginalBrightness[Object]
            if Original ~= nil then Object.Brightness = Max(0, Original * (1 - Transparency)) end
        elseif ClassName == "ParticleEmitter" or ClassName == "Beam" or ClassName == "Trail" then
            Object.Color = ColorSequenceValue
            local Original = self.Aura.OriginalTransparency[Object]
            if Original then Object.Transparency = AtramentaAuraTransparencySequence(Original, Transparency) end
        end
    end
    for _, Object in ipairs(self.Aura.Objects) do
        ApplyAuraToObject(Object)
        if Object and Object.Parent then for _, Descendant in ipairs(Object:GetDescendants()) do ApplyAuraToObject(Descendant) end end
    end
end
function ExtendedVisuals:GetAuraTemplate(Preset)
    Preset = tostring(Preset or self.Aura.Preset or "Angel")
    local Cached = self.Aura.Templates[Preset]
    if typeof(Cached) == "Instance" then return Cached end
    local Source = self.AuraSources[Preset] or self.AuraSources.Angel
    if not Source then return nil end
    local Object
    if Source.Asset then
        local Success, Result = Shared.SafeCall(function() return Game:GetObjects(Source.Asset)[1] end)
        if Success and typeof(Result) == "Instance" then Object = Result end
    elseif Source.File then
        local AssetsFolder = type(Library) == "table" and type(Library.Folders) == "table" and Library.Folders.Assets or "Atramenta.rip/Assets"
        local Path = AssetsFolder .. "/" .. Source.File
        local LegacyPath = "juju recode/custom/" .. Source.File
        local HasFile = type(isfile) == "function" and isfile(Path)
        if not HasFile and type(isfile) == "function" and isfile(LegacyPath) then Path = LegacyPath HasFile = true end
        if not HasFile and type(writefile) == "function" and type(isfile) == "function" and Source.Url then
            local Downloaded, Body = Shared.SafeCall(function() return Game:HttpGet(Source.Url) end)
            if Downloaded and type(Body) == "string" and #Body > 32 then
                Shared.SafeCall(writefile, Path, Body)
                HasFile = isfile(Path)
            end
        end
        local AssetFunction = type(getcustomasset) == "function" and getcustomasset or type(getsynasset) == "function" and getsynasset or nil
        if HasFile and AssetFunction then
            local Loaded, Asset = Shared.SafeCall(AssetFunction, Path)
            if Loaded and type(Asset) == "string" and Asset ~= "" then
                local Created, Result = Shared.SafeCall(function() return Game:GetObjects(Asset)[1] end)
                if Created and typeof(Result) == "Instance" then Object = Result end
            end
        end
    end
    if Object then self.Aura.Templates[Preset] = Object end
    return Object
end
function ExtendedVisuals:GetAuraBodyPart(Character, Name)
    if not Character then return nil end
    local Direct = Character:FindFirstChild(Name)
    if Direct and Direct:IsA("BasePart") then return Direct end
    if Name == "Torso" then return Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("LowerTorso")
    elseif Name == "UpperTorso" or Name == "LowerTorso" then return Character:FindFirstChild("Torso")
    elseif Name == "HumanoidRootPart" then return Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") end
    return nil
end
function ExtendedVisuals:DestroyAura()
    for Index = #self.Aura.Objects, 1, -1 do
        local Object = self.Aura.Objects[Index]
        if Object and Object.Parent then Object:Destroy() end
        self.Aura.Objects[Index] = nil
    end
    self.Aura.Character = nil
    self.Aura.OriginalTransparency = setmetatable({}, {__mode = "k"})
    self.Aura.OriginalBrightness = setmetatable({}, {__mode = "k"})
    local Character = LocalPlayer.Character
    if Character then for _, Object in ipairs(Character:GetDescendants()) do if Object.Name == "AtramentaParticleAura" then Object:Destroy() end end end
end
function ExtendedVisuals:CreateAura()
    if not self.Aura.Enabled then self:DestroyAura() return end
    local Character = LocalPlayer.Character
    if not Character then return end
    if self.Aura.Character == Character and #self.Aura.Objects > 0 then self:ApplyAuraAppearance() return end
    self:DestroyAura()
    local Template = self:GetAuraTemplate(self.Aura.Preset)
    if not Template then return end
    local Success, Cloned = Shared.SafeCall(function() return Template:Clone() end)
    if not Success or typeof(Cloned) ~= "Instance" then return end
    for _, SourcePart in ipairs(Cloned:GetChildren()) do
        if SourcePart:IsA("BasePart") then
            local TargetPart = self:GetAuraBodyPart(Character, SourcePart.Name)
            if TargetPart then
                for _, Child in ipairs(SourcePart:GetChildren()) do
                    Child.Name = "AtramentaParticleAura"
                    Child.Parent = TargetPart
                    self.Aura.Objects[#self.Aura.Objects + 1] = Child
                    self:RememberAuraAppearance(Child)
                end
            end
        end
    end
    Cloned:Destroy()
    self.Aura.Character = Character
    self:ApplyAuraAppearance()
end
