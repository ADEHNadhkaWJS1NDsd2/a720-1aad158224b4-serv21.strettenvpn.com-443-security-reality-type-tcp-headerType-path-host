function DestroyFlyLinearVelocity()
    local LinearVelocityObject = FlyState.LinearVelocity
    local AttachmentObject = FlyState.LinearAttachment
    FlyState.LinearVelocity = nil
    FlyState.LinearAttachment = nil
    FlyState.LinearRoot = nil
    if LinearVelocityObject then
        Shared.SafeCall(function()
            LinearVelocityObject.Enabled = false
            LinearVelocityObject:Destroy()
        end)
    end
    if AttachmentObject then
        Shared.SafeCall(function()
            AttachmentObject:Destroy()
        end)
    end
end

function EnsureFlyLinearVelocity(RootPart)
    if not RootPart or not RootPart.Parent then return nil end
    local ExistingVelocity = FlyState.LinearVelocity
    local ExistingAttachment = FlyState.LinearAttachment
    if FlyState.LinearRoot == RootPart and ExistingVelocity and ExistingVelocity.Parent == RootPart and ExistingAttachment and ExistingAttachment.Parent == RootPart then
        return ExistingVelocity
    end
    DestroyFlyLinearVelocity()
    local AttachmentObject = NewInstance("Attachment")
    AttachmentObject.Name = "AtramentaFlyAttachment"
    AttachmentObject.Parent = RootPart
    local LinearVelocityObject = NewInstance("LinearVelocity")
    LinearVelocityObject.Name = "AtramentaFlyLinearVelocity"
    LinearVelocityObject.Attachment0 = AttachmentObject
    LinearVelocityObject.RelativeTo = Enum.ActuatorRelativeTo.World
    LinearVelocityObject.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    LinearVelocityObject.VectorVelocity = EmptyVector3
    LinearVelocityObject.MaxForce = 1000000000
    LinearVelocityObject.Enabled = true
    LinearVelocityObject.Parent = RootPart
    FlyState.LinearRoot = RootPart
    FlyState.LinearAttachment = AttachmentObject
    FlyState.LinearVelocity = LinearVelocityObject
    return LinearVelocityObject
end

function ApplyFlyLinearVelocity(RootPart, Velocity)
    if not RootPart or not RootPart.Parent or typeof(Velocity) ~= "Vector3" then return false end
    local LinearVelocityObject = EnsureFlyLinearVelocity(RootPart)
    if not LinearVelocityObject then return false end
    LinearVelocityObject.VectorVelocity = Velocity
    if LinearVelocityObject.Enabled ~= true then LinearVelocityObject.Enabled = true end
    return true
end

function StopRagdollFlyPreSimulationRemote()
    local Connection = FlyState.RagdollPreSimulationConnection
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    FlyState.RagdollPreSimulationConnection = nil
end

function StartRagdollFlyPreSimulationRemote()
    StopRagdollFlyPreSimulationRemote()
    FlyState.RagdollLastRemote = 0
    FlyState.RagdollPreSimulationConnection = RunService.PreSimulation:Connect(function()
        if FlyEnabled ~= true or FlyMethod ~= "Ragdoll" then return end
        local Now = tick()
        local LastRemote = tonumber(FlyState.RagdollLastRemote) or 0
        if Now - LastRemote < 0.1 then return end
        local Character = LocalPlayer.Character
        local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart or not RootPart.Parent then return end
        local Events = ReplicatedStorage:FindFirstChild("Events")
        local RagdollRemote = Events and Events:FindFirstChild("__RZDONL")
        if not RagdollRemote or not RagdollRemote:IsA("RemoteEvent") then return end
        FlyState.RagdollLastRemote = Now
        RagdollRemote:FireServer("__---r", EmptyVector3, RootPart.CFrame, true)
    end)
end

function FlyEnable()
    if FlyEnabled then return end
    FlyEnabled = true
    FlyState.RagdollLastRemote = 0
    if FlyConnection then
        Shared.SafeDisconnect(FlyConnection)
        FlyConnection = nil
    end
    StopRagdollFlyPreSimulationRemote()
    DestroyFlyLinearVelocity()
    local Character = LocalPlayer.Character
    local RootPart = BindFlyCharacter(Character)
    if RootPart then EnsureFlyLinearVelocity(RootPart) end
    if FlyMethod == "Ragdoll" then
        BindRagdollFlyParts(Character)
        StartRagdollFlyPreSimulationRemote()
    end
    FlyConnection = RunService.PreSimulation:Connect(function()
        if not FlyEnabled then return end
        local CurrentCharacter = LocalPlayer.Character
        if not CurrentCharacter then return end
        local RootPart = CurrentCharacter:FindFirstChild("HumanoidRootPart")
        local Humanoid = CurrentCharacter:FindFirstChildOfClass("Humanoid")
        local CameraObject = Shared.GetCamera()
        if not RootPart or not RootPart.Parent or not CameraObject then return end
        if FlyState.Root ~= RootPart or FlyState.Humanoid ~= Humanoid then
            RootPart, Humanoid = BindFlyCharacter(CurrentCharacter)
            if not RootPart then return end
            if FlyMethod == "Ragdoll" then BindRagdollFlyParts(CurrentCharacter) end
        end
        local Speed = Clamp(tonumber(FlySpeed) or 40, 5, 180)
        local DesiredVelocity = GetFlyInputVelocity(CameraObject, Speed, true)
        local IsRagdoll = FlyMethod == "Ragdoll"
        ApplyFlyLinearVelocity(RootPart, DesiredVelocity)
        DesyncNetworkState.FlyAppliedVelocity = DesiredVelocity
        DesyncNetworkState.FlyLastVector = DesiredVelocity
        DesyncNetworkState.FlyLastLocalStep = Clock()
        DesyncNetworkState.FlyStatus = (IsRagdoll and "RAG-LV:" or "LV:") .. tostring(Floor(DesiredVelocity.Magnitude + 0.5))
    end)
end

function FlyDisable()
    if not FlyEnabled then return end
    FlyEnabled = false
    if FlyConnection then
        Shared.SafeDisconnect(FlyConnection)
        FlyConnection = nil
    end
    StopRagdollFlyPreSimulationRemote()
    DestroyFlyLinearVelocity()
    if FlyMethod == "Ragdoll" then RestoreRagdollFlyParts() end
    FlyState.Root = nil
    FlyState.Humanoid = nil
    FlyState.Position = nil
    FlyState.Rotation = nil
    FlyState.AutoRotate = nil
    FlyState.RagdollLastRemote = 0
    DesyncNetworkState.FlyAppliedVelocity = EmptyVector3
    DesyncNetworkState.FlyLastVector = EmptyVector3
    DesyncNetworkState.FlyPreviousPosition = nil
    DesyncNetworkState.FlyPreviousTime = 0
    DesyncNetworkState.FlyLastLocalStep = 0
    DesyncNetworkState.FlyStatus = "OFF"
end

function WalkSpeed.BackingFrom(Value)
    local Success, Default, Run, Crouch = Shared.SafeCall(function()
        return Value.DefaultWalkSpeed, Value.RunWalkSpeed, Value.CrouchWalkSpeed
    end)
    if not Success or type(Default) ~= "number" or type(Run) ~= "number" or type(Crouch) ~= "number" or type(getrawmetatable) ~= "function" then
        return nil
    end
    local MetaSuccess, Meta = Shared.SafeCall(getrawmetatable, Value)
    if not MetaSuccess or type(Meta) ~= "table" then return nil end
    local Backing = rawget(Meta, "__index")
    if type(Backing) ~= "table" or type(rawget(Backing, "DefaultWalkSpeed")) ~= "number"
        or type(rawget(Backing, "RunWalkSpeed")) ~= "number" or type(rawget(Backing, "CrouchWalkSpeed")) ~= "number" then
        return nil
    end
    return Backing
end
function WalkSpeed.Inspect(Function)
    local Values = Shared.GetFunctionUpvalues(Function)
    if not Values then return nil, nil end
    for _, Value in next, Values do
        local Backing = WalkSpeed.BackingFrom(Value)
        if Backing then return Value, Backing end
    end
end
function WalkSpeed.FromHeartbeat()
    if type(getconnections) ~= "function" then return nil, nil end
    local Success, Connections = Shared.SafeCall(getconnections, RunService.Heartbeat)
    if not Success or type(Connections) ~= "table" then return nil, nil end
    for _, Connection in next, Connections do
        local Proxy, Backing = WalkSpeed.Inspect(Shared.GetConnectionCallback(Connection))
        if Proxy and Backing then return Proxy, Backing end
    end
end
function WalkSpeed.FromGC()
    if type(getgc) ~= "function" then return nil, nil end
    local Success, Objects = Shared.SafeCall(getgc, true)
    if not Success or type(Objects) ~= "table" then return nil, nil end
    for _, Object in next, Objects do
        if type(Object) == "function" then
            local Proxy, Backing = WalkSpeed.Inspect(Object)
            if Proxy and Backing then return Proxy, Backing end
        end
    end
end
function WalkSpeed.Resolve(AllowGC)
    if WalkSpeed.Backing then return true end
    WalkSpeed.Proxy, WalkSpeed.Backing = WalkSpeed.FromHeartbeat()
    if not WalkSpeed.Backing and AllowGC then WalkSpeed.Proxy, WalkSpeed.Backing = WalkSpeed.FromGC() end
    if WalkSpeed.Backing and not WalkSpeed.Original then
        WalkSpeed.Original = {Default = rawget(WalkSpeed.Backing, "DefaultWalkSpeed"),
            Run = rawget(WalkSpeed.Backing, "RunWalkSpeed"), Crouch = rawget(WalkSpeed.Backing, "CrouchWalkSpeed")}
    end
    return WalkSpeed.Backing ~= nil
end
function WalkSpeed.ApplyInfiniteStaminaState()
    if not WalkSpeed.Alive or not WalkSpeed.Enabled then return false end
    if not WalkSpeed.Backing and not WalkSpeed.Resolve(WalkSpeed.Attempts == 0) then return false end
    rawset(WalkSpeed.Backing, "DefaultWalkSpeed", WalkSpeed.Speed)
    rawset(WalkSpeed.Backing, "RunWalkSpeed", WalkSpeed.Speed)
    rawset(WalkSpeed.Backing, "CrouchWalkSpeed", WalkSpeed.Speed)
    return true
end
function WalkSpeed.Restore()
    if not WalkSpeed.Backing or not WalkSpeed.Original then return end
    rawset(WalkSpeed.Backing, "DefaultWalkSpeed", WalkSpeed.Original.Default)
    rawset(WalkSpeed.Backing, "RunWalkSpeed", WalkSpeed.Original.Run)
    rawset(WalkSpeed.Backing, "CrouchWalkSpeed", WalkSpeed.Original.Crouch)
end
function WalkSpeed.StartResolve()
    if WalkSpeed.Thread then return end
    local Token = {}
    WalkSpeed.Thread = Token
    local function Attempt()
        if WalkSpeed.Thread ~= Token or not WalkSpeed.Alive or not WalkSpeed.Enabled or WalkSpeed.Backing or WalkSpeed.Attempts >= 10 then
            if WalkSpeed.Thread == Token then WalkSpeed.Thread = nil end
            return
        end
        WalkSpeed.Attempts += 1
        if WalkSpeed.ApplyInfiniteStaminaState() then
            if WalkSpeed.Thread == Token then WalkSpeed.Thread = nil end
            return
        end
        Delay(1.5, Attempt)
    end
    Defer(Attempt)
end
function WalkSpeed.SetSpeed(Value)
    WalkSpeed.Speed = Clamp(Floor((tonumber(Value) or WalkSpeed.Speed) + 0.5), 24, 32)
    rawset(Environment, "CriminalityWalkSpeedValue", WalkSpeed.Speed)
    WalkSpeed.ApplyInfiniteStaminaState()
    return WalkSpeed.Speed
end
function WalkSpeed.SetEnabled(Value)
    local Enabled = Value == true
    if WalkSpeed.Enabled == Enabled then return Enabled end
    WalkSpeed.Enabled = Enabled
    if Enabled then
        if not WalkSpeed.Resolve(true) then WalkSpeed.StartResolve() end
        WalkSpeed.ApplyInfiniteStaminaState()
    else
        WalkSpeed.Thread = nil
        WalkSpeed.Restore()
    end
    return Enabled
end
function WalkSpeed.Rescan()
    WalkSpeed.Restore()
    WalkSpeed.Proxy = nil
    WalkSpeed.Backing = nil
    WalkSpeed.Original = nil
    WalkSpeed.Attempts = 0
    local Resolved = WalkSpeed.Resolve(true)
    WalkSpeed.ApplyInfiniteStaminaState()
    return Resolved
end
function WalkSpeed.GetState()
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    return {Enabled = WalkSpeed.Enabled, Speed = WalkSpeed.Speed, Actual = Humanoid and Humanoid.WalkSpeed or nil,
        Resolved = WalkSpeed.Backing ~= nil, CrouchPatched = WalkSpeed.Backing ~= nil, Method = "XIIX Default/Run/Crouch config"}
end
function WalkSpeed.Shutdown()
    if not WalkSpeed.Alive then return end
    WalkSpeed.SetEnabled(false)
    WalkSpeed.Alive = false
    if WalkSpeed.Thread then
        Shared.SafeCall(Cancel, WalkSpeed.Thread)
        WalkSpeed.Thread = nil
    end
end
