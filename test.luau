        Shared.SaveWorldOriginal()
        ApplyWorldLightingCore()
        EnsureWorldEffects()
        Visuals.World.Dirty = false
    end)
    Visuals.World.Applying = false
    return Success
end
WorldVisualApplyGeneration = 0
function StopStandaloneWorldEffects()
    local Connection = Visuals.World.StandaloneEffectConnection
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    Visuals.World.StandaloneEffectConnection = nil
    if type(Visuals.World.StandaloneEffectConnections) == "table" then
        for Key, Signal in pairs(Visuals.World.StandaloneEffectConnections) do
            if Signal and typeof(Signal) == "RBXScriptConnection" then Shared.SafeDisconnect(Signal) end
            Visuals.World.StandaloneEffectConnections[Key] = nil
        end
    end
    Visuals.World.StandaloneEffectConnections = {}
end
function RefreshStandaloneWorldEffects()
    StopStandaloneWorldEffects()
    if Visuals.World.Enabled or not WorldPostOverrideActive() then return end
    Visuals.World.StandaloneEffectConnections = {}
    local Connections = Visuals.World.StandaloneEffectConnections
    local function ApplyInfiniteStaminaState()
        if Visuals.World.Enabled or not WorldPostOverrideActive() or Visuals.World.Applying then return end
        Visuals.World.Applying = true
        Shared.SafeCall(EnsureWorldEffects)
        Visuals.World.Applying = false
    end
    local function BindEffect(Object)
        if not Shared.IsWorldPostEffect(Object) or Shared.IsAtramentaWorldEffect(Object) then return end
        if Connections[Object] then return end
        Connections[Object] = Object:GetPropertyChangedSignal("Enabled"):Connect(function()
            if Visuals.World.Applying then return end
            Defer(ApplyInfiniteStaminaState)
        end)
    end
    for _, Object in ipairs(Lighting:GetChildren()) do BindEffect(Object) end
    Connections.ChildAdded = Lighting.ChildAdded:Connect(function(Object)
        BindEffect(Object)
        Defer(ApplyInfiniteStaminaState)
    end)
    Connections.ChildRemoved = Lighting.ChildRemoved:Connect(function(Object)
        local Signal = Connections[Object]
        if Signal and typeof(Signal) == "RBXScriptConnection" then Shared.SafeDisconnect(Signal) end
        Connections[Object] = nil
        Defer(ApplyInfiniteStaminaState)
    end)
    ApplyInfiniteStaminaState()
end
function QueueWorldPostApply()
    if Visuals.World.Enabled then
        Visuals.World.Dirty = true
        ApplyWorldVisuals()
        return
    end
    Shared.SaveWorldOriginal()
    if Visuals.World.Applying then return end
    Visuals.World.Applying = true
    Shared.SafeCall(EnsureWorldEffects)
    Visuals.World.Applying = false
    RefreshStandaloneWorldEffects()
end
function QueueWorldVisualApply()
    if not Visuals.World.Enabled then return end
    Visuals.World.Dirty = true
    ApplyWorldVisuals()
end
function DisconnectWorldAtmosphereSignals(Object)
    local Connections = Visuals.World.AtmosphereConnections and Visuals.World.AtmosphereConnections[Object]
    if type(Connections) == "table" then
        for Index = 1, #Connections do
            local Connection = Connections[Index]
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
        end
    end
    if Visuals.World.AtmosphereConnections then Visuals.World.AtmosphereConnections[Object] = nil end
end
function DisconnectWorldPostEffectSignal(Object)
    local Connection = Visuals.World.PostEffectConnections and Visuals.World.PostEffectConnections[Object]
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    if Visuals.World.PostEffectConnections then Visuals.World.PostEffectConnections[Object] = nil end
end
function DisconnectWorldOverrideSignals()
    if type(Visuals.World.PropertyConnections) == "table" then
        for _, Connection in ipairs(Visuals.World.PropertyConnections) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
        end
    end
    Clear(Visuals.World.PropertyConnections)
    if type(Visuals.World.ChildConnections) == "table" then
        for _, Connection in ipairs(Visuals.World.ChildConnections) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
        end
    end
    Clear(Visuals.World.ChildConnections)
    if type(Visuals.World.AtmosphereConnections) == "table" then
        for _, Connections in pairs(Visuals.World.AtmosphereConnections) do
            if type(Connections) == "table" then
                for Index = 1, #Connections do
                    local Connection = Connections[Index]
                    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
                end
            end
        end
    end
    Visuals.World.AtmosphereConnections = setmetatable({}, {__mode = "k"})
    if type(Visuals.World.PostEffectConnections) == "table" then
        for _, Connection in pairs(Visuals.World.PostEffectConnections) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
        end
    end
    Visuals.World.PostEffectConnections = setmetatable({}, {__mode = "k"})
end
function QueueWorldOverrideCorrection()
    if not Visuals.World.Enabled or Visuals.World.Applying or Visuals.World.CorrectionQueued then return end
    Visuals.World.CorrectionQueued = true
    Defer(function()
        Visuals.World.CorrectionQueued = false
        if not Visuals.World.Enabled or Visuals.World.Applying then return end
        Visuals.World.Applying = true
        Shared.SafeCall(function()
            ApplyWorldLightingCore()
            if Visuals.World.Dirty then EnsureWorldEffects(); Visuals.World.Dirty = false end
        end)
        Visuals.World.Applying = false
    end)
end
function BindWorldAtmosphereSignals(Object)
    if not Object or not Object:IsA("Atmosphere") or Object == Visuals.World.Atmosphere then return end
    DisconnectWorldAtmosphereSignals(Object)
    local Connections = {}
    Visuals.World.AtmosphereConnections[Object] = Connections
    local Properties = {"Density", "Offset", "Color", "Decay", "Glare", "Haze"}
    for Index = 1, #Properties do
        Connections[Index] = Object:GetPropertyChangedSignal(Properties[Index]):Connect(function()
            if Visuals.World.Enabled and not Visuals.World.Applying then
                Visuals.World.Dirty = true
                QueueWorldOverrideCorrection()
            end
        end)
    end
end
function BindWorldPostEffectSignal(Object)
    if not Shared.IsWorldPostEffect(Object) or Shared.IsAtramentaWorldEffect(Object) then return end
    DisconnectWorldPostEffectSignal(Object)
    SaveWorldPostEffect(Object)
    Visuals.World.PostEffectConnections[Object] = Object:GetPropertyChangedSignal("Enabled"):Connect(function()
        if not Visuals.World.Enabled or Visuals.World.Applying or Shared.IsAtramentaWorldEffect(Object) or not WorldPostOverrideActive() then return end
        Visuals.World.Applying = true
        Shared.SetWorldProperty(Object, "Enabled", false)
        Visuals.World.Applying = false
    end)
end
function BindWorldOverrideSignals()
    DisconnectWorldOverrideSignals()
    local Properties = {"Ambient", "OutdoorAmbient", "ColorShift_Top", "ColorShift_Bottom", "Brightness", "ExposureCompensation", "GlobalShadows", "ShadowSoftness", "EnvironmentDiffuseScale", "EnvironmentSpecularScale", "FogColor", "FogStart", "FogEnd"}
    for Index = 1, #Properties do
        Visuals.World.PropertyConnections[Index] = Lighting:GetPropertyChangedSignal(Properties[Index]):Connect(function()
            QueueWorldOverrideCorrection()
        end)
    end
    for _, Object in ipairs(Lighting:GetChildren()) do
        if Object:IsA("Atmosphere") and Object ~= Visuals.World.Atmosphere then BindWorldAtmosphereSignals(Object) end
        if Shared.IsWorldPostEffect(Object) and not Shared.IsAtramentaWorldEffect(Object) then BindWorldPostEffectSignal(Object) end
    end
    Visuals.World.ChildConnections[1] = Lighting.ChildAdded:Connect(function(Object)
        if not Visuals.World.Enabled or Visuals.World.Applying then return end
        if Object:IsA("Atmosphere") and Object ~= Visuals.World.Atmosphere then
            SaveWorldAtmosphere(Object)
            BindWorldAtmosphereSignals(Object)
            Visuals.World.Dirty = true
            QueueWorldOverrideCorrection()
            return
        end
        if Shared.IsWorldPostEffect(Object) and not Shared.IsAtramentaWorldEffect(Object) then
            SaveWorldPostEffect(Object)
            BindWorldPostEffectSignal(Object)
            if WorldPostOverrideActive() then
                Visuals.World.Applying = true
                Shared.SetWorldProperty(Object, "Enabled", false)
                Visuals.World.Applying = false
            end
        end
    end)
    Visuals.World.ChildConnections[2] = Lighting.ChildRemoved:Connect(function(Object)
        if Object:IsA("Atmosphere") then DisconnectWorldAtmosphereSignals(Object) end
        if Shared.IsWorldPostEffect(Object) then DisconnectWorldPostEffectSignal(Object) end
        if not Visuals.World.Enabled or Visuals.World.Applying then return end
        if Object == Visuals.World.Atmosphere then Visuals.World.Atmosphere = nil end
        if Object == Visuals.World.ColorCorrection then Visuals.World.ColorCorrection = nil end
        if Object == Visuals.World.BloomEffect then Visuals.World.BloomEffect = nil end
        if Object == Visuals.World.SunRaysEffect then Visuals.World.SunRaysEffect = nil end
        if Object == Visuals.World.DepthOfFieldEffect then Visuals.World.DepthOfFieldEffect = nil end
        if Object == Visuals.World.BlurEffect then Visuals.World.BlurEffect = nil end
        if Object:IsA("Atmosphere") or Shared.IsWorldPostEffect(Object) then
            Visuals.World.Dirty = true
            QueueWorldOverrideCorrection()
        end
    end)
end
function StartWorldOverride()
    Shared.SaveWorldOriginal()
    StopStandaloneWorldEffects()
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep(Visuals.World.RenderStepName)
    end)
    if Visuals.World.Connection then
        Shared.SafeCall(function() Shared.SafeDisconnect(Visuals.World.Connection) end)
        Visuals.World.Connection = nil
    end
    DisconnectWorldOverrideSignals()
    Visuals.World.CorrectionQueued = false
    Visuals.World.Bound = true
    Visuals.World.Dirty = true
    ApplyWorldVisuals()
    BindWorldOverrideSignals()
end
function RestoreWorldVisuals(Full)
    Shared.SafeCall(function() RunService:UnbindFromRenderStep(Visuals.World.RenderStepName) end)
    DisconnectWorldOverrideSignals()
    if Visuals.World.Connection then
        Shared.SafeCall(function() Shared.SafeDisconnect(Visuals.World.Connection) end)
        Visuals.World.Connection = nil
    end
    Visuals.World.Accumulator = 0
    Visuals.World.EffectAccumulator = 0
    Visuals.World.CorrectionQueued = false
    Visuals.World.Bound = false
    local Original = Visuals.World.Original
    if Original then
        if typeof(Original.Technology) == "EnumItem" then Shared.SetLightingTechnology(Original.Technology) end
        Shared.SafeCall(function()
            Lighting.Ambient = Original.Ambient
            Lighting.OutdoorAmbient = Original.OutdoorAmbient
            Lighting.ColorShift_Top = Original.ColorShiftTop
            Lighting.ColorShift_Bottom = Original.ColorShiftBottom
            Lighting.Brightness = Original.Brightness
            Lighting.ClockTime = Original.ClockTime
            Lighting.ExposureCompensation = Original.ExposureCompensation
            Lighting.GlobalShadows = Original.GlobalShadows
            Lighting.ShadowSoftness = Original.ShadowSoftness
            Lighting.EnvironmentDiffuseScale = Original.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = Original.EnvironmentSpecularScale
            Lighting.FogColor = Original.FogColor Lighting.FogStart = Original.FogStart
            Lighting.FogEnd = Original.FogEnd
        end)
    end
    RestoreAtramentaAtmospheres()
    if Visuals.World.ColorCorrection then
        Visuals.World.ColorCorrection:Destroy()
        Visuals.World.ColorCorrection = nil
    end
    if Visuals.World.BloomEffect then
        Visuals.World.BloomEffect:Destroy()
        Visuals.World.BloomEffect = nil
    end
    if Visuals.World.SunRaysEffect then
        Visuals.World.SunRaysEffect:Destroy()
        Visuals.World.SunRaysEffect = nil
    end
    if Visuals.World.DepthOfFieldEffect then
        Visuals.World.DepthOfFieldEffect:Destroy()
        Visuals.World.DepthOfFieldEffect = nil
    end
    if Visuals.World.BlurEffect then
        Visuals.World.BlurEffect:Destroy()
        Visuals.World.BlurEffect = nil
    end
    RestoreWorldPostEffects()
    StopStandaloneWorldEffects()
    Visuals.World.Original = nil
    Visuals.World.Applying = false
    Visuals.World.Dirty = false
    if Full ~= true and WorldPostOverrideActive() then QueueWorldPostApply() end
end
function Visuals.World.StopTimeLock()
    local Connection = Visuals.World.TimeLockConnection
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    Visuals.World.TimeLockConnection = nil
    Visuals.World.TimeLockApplying = false
end
function Visuals.World.ApplyLockedTime()
    if Visuals.World.Enabled ~= true or Visuals.World.TimeLock ~= true or Visuals.World.TimeLockApplying then return end
    local DesiredTime = Clamp(tonumber(Visuals.World.ClockTime) or Lighting.ClockTime, 0, 24)
    if Abs(Lighting.ClockTime - DesiredTime) <= 0.001 then return end
    Visuals.World.TimeLockApplying = true
    Lighting.ClockTime = DesiredTime
    Visuals.World.TimeLockApplying = false
end
function Visuals.World.RefreshTimeLock()
    Visuals.World.StopTimeLock()
    if Visuals.World.Enabled ~= true or Visuals.World.TimeLock ~= true then return end
    Visuals.World.ClockTime = Clamp(tonumber(Visuals.World.ClockTime) or Lighting.ClockTime, 0, 24)
    Visuals.World.ApplyLockedTime()
    Visuals.World.TimeLockConnection = Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
        if Visuals.World.Enabled ~= true or Visuals.World.TimeLock ~= true or Visuals.World.TimeLockApplying then return end
        Visuals.World.ApplyLockedTime()
    end)
end
Visuals.World.StopTimeLock()
function GetWorldAdornee(Object)
    if not Object or not Object.Parent then return nil end
    if Object:IsA("BasePart") then return Object end
    if Object:IsA("Model") then return Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true) end
    return Object:FindFirstChildWhichIsA("BasePart", true)
end
function IsWorldSafeObject(Object)
    if not Object then return false end
    local Name = Lower(tostring(Object.Name or ""))
    return StringFind(Name, "safe", 1, true) ~= nil or StringFind(Name, "register", 1, true) ~= nil
end
function GetWorldObjectBrokenValue(Object)
    if not Object then return nil end
    local Values = Object:FindFirstChild("Values")
    local Broken = Values and Values:FindFirstChild("Broken")
    if Broken and Broken:IsA("ValueBase") then return Broken end
    Broken = Object:FindFirstChild("Broken", true)
    if Broken and Broken:IsA("ValueBase") then return Broken end
    return nil
end
function GetWorldObjectBrokenState(Object)
    local Broken = GetWorldObjectBrokenValue(Object)
    if not Broken then return false, false end
    local Value = Broken.Value
    if type(Value) == "boolean" then return Value, true end
    if type(Value) == "number" then return Value ~= 0, true end
    return tostring(Value):lower() == "true", true
end
function GetWorldObjectColor(Object, Kind)
    if Kind == "SAFE" then
        local IsBroken = GetWorldObjectBrokenState(Object)
        return IsBroken and Visuals.WorldESP.BrokenColor or Visuals.WorldESP.SafeColor
    end
    if Kind == "DROPPED" then return Visuals.WorldESP.DroppedColor end
    return Visuals.WorldESP.CashColor
end
function GetWorldObjectMaxDistance(Kind)
    if Kind == "DROPPED" then return Max(tonumber(Visuals.WorldESP.DroppedMaxDistance) or 1500, 0) end
    return Max(tonumber(Visuals.WorldESP.MaxDistance) or 1500, 0)
end
function Shared.GetSafeDisplayName(Object)
    local Name = Lower(Object.Name)
    if StringFind(Name, "register", 1, true) then return "Register" end
    if StringFind(Name, "small", 1, true) then return "Small Safe" end
    if StringFind(Name, "medium", 1, true) then return "Medium Safe" end
    if StringFind(Name, "large", 1, true) then return "Large Safe" end
    return "Safe"
end
function GetWorldObjectText(Object, Kind)
    if Kind == "SAFE" then return Shared.GetSafeDisplayName(Object) end
    if Kind == "DROPPED" then return Shared.GetDroppedItemDisplayName(Object) end
    return "Cash"
end
function DisconnectWorldESPObjectConnections(Data)
    if type(Data) ~= "table" then return end
    if type(Data.Connections) == "table" then
        for Name, Connection in pairs(Data.Connections) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
            Data.Connections[Name] = nil
        end
    end
    Data.Connections = {}
end
function RemoveWorldESPObject(Object)
    local Data = Object and Visuals.WorldESP.Objects[Object]
