    local Existing = ShotToken ~= nil and Shared.FindLocalShotByToken(Tool, ShotToken) or nil
    if not Existing then
        for Index = #AttackConfirmationState.Shots, 1, -1 do
            local Candidate = AttackConfirmationState.Shots[Index]
            if Candidate and Candidate.Tool == Tool and Candidate.DamageConfirmed ~= true and Candidate.Discarded ~= true then
                local Age = CurrentTime - (tonumber(Candidate.Time) or CurrentTime)
                local TargetCompatible = not TargetPlayer or not Candidate.Player or Candidate.Player == TargetPlayer
                local DirectionCompatible = true
                if typeof(Direction) == "Vector3" and Direction.Magnitude > 0.001 and typeof(Candidate.Direction) == "Vector3" and Candidate.Direction.Magnitude > 0.001 then
                    DirectionCompatible = Direction.Unit:Dot(Candidate.Direction.Unit) >= 0.955
                end
                local IntentMerge = CanonicalSource ~= "RageBot" and Age >= -0.005 and Age <= 0.010 and TargetCompatible and DirectionCompatible
                    and Candidate.IntentOnly == true and Candidate.VerifiedFire ~= true and Candidate.RemoteConfirmed ~= true and Candidate.AmmoConfirmed ~= true
                    and ShotToken == nil
                if IntentMerge then Existing = Candidate break end
            end
        end
    end
    if Existing then
        Existing.LastSeenAt = CurrentTime
        Existing.Token = ShotToken or Existing.Token
        Existing.Source = Shared.MergeLocalAttackSource(Existing.Source, CanonicalSource)
        Existing.Origin = typeof(OriginPosition) == "Vector3" and OriginPosition or Existing.Origin
        Existing.Direction = typeof(Direction) == "Vector3" and Direction or Existing.Direction
        if TargetPlayer and ResolvedCharacter then
            Existing.Player = TargetPlayer Existing.Character = ResolvedCharacter Existing.TargetPart = ResolvedPart or Existing.TargetPart
            Existing.TargetPositionAtFire = ResolvedPart and ResolvedPart.Position or Existing.TargetPositionAtFire
            Existing.TargetVelocityAtFire = ResolvedPart and ResolvedPart.AssemblyLinearVelocity or Existing.TargetVelocityAtFire
            if ResolvedPart and PartName then Existing.PartName = PartName end
            if Shared.IsAtramentaPlayerActuallyDowned(TargetPlayer) then Existing.TargetWasDowned = true end
        end
        Shared.IndexLocalShot(Existing)
        if type(Shared.TryConfirmBufferedDamage) == "function" then Shared.TryConfirmBufferedDamage(Existing) end
        return Existing
    end
    AttackConfirmationState.Serial += 1
    local ExplicitAssist = CanonicalSource == "RageBot" or CanonicalSource == "SilentAim" or CanonicalSource == "Aimbot" or CanonicalSource == "HBE"
    local Shot = {Id = AttackConfirmationState.Serial, Time = CurrentTime, CreatedAt = CurrentTime, LastSeenAt = CurrentTime,
        Player = TargetPlayer, Character = ResolvedCharacter, TargetPart = ResolvedPart, PartName = PartName,
        TargetPositionAtFire = ResolvedPart and ResolvedPart.Position or nil, TargetVelocityAtFire = ResolvedPart and ResolvedPart.AssemblyLinearVelocity or nil,
        Token = ShotToken, Tool = Tool, Source = CanonicalSource, Origin = typeof(OriginPosition) == "Vector3" and OriginPosition or nil,
        Direction = typeof(Direction) == "Vector3" and Direction or nil, AmmoAtFire = ServerAmmo and tonumber(ServerAmmo.Value) or nil,
        LocalIntent = true, IntentOnly = true, VerifiedFire = false, OwnershipState = "Intent", ExplicitAssist = ExplicitAssist,
        TargetWasDowned = TargetPlayer and Shared.IsAtramentaPlayerActuallyDowned(TargetPlayer) or false, FinishSoundPlayed = false,
        ConfirmedAt = nil, SignalConfirmed = false, AmmoConfirmed = false, RemoteConfirmed = false, DamageConfirmed = false, TracerSpawned = false}
    AttackConfirmationState.Shots[#AttackConfirmationState.Shots + 1] = Shot
    Shared.IndexLocalShot(Shot)
    CombatLogRuntime.ScheduleMiss(Shot)
    return Shot
end
