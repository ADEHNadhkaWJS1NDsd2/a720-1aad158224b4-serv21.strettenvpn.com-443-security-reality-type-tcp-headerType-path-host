function UpdateAtramentaFakePositionGuard()
    if DesyncSettings.FakePositionEnabled ~= true then
        RestoreAtramentaFakePositionPhysics()
        return
    end
    local Character = LocalPlayer.Character
    local Root = Character and ResolverGetRootPart(Character)
    if not Character or not Root or not Root.Parent or Root.Anchored then
        RestoreAtramentaFakePositionPhysics()
        return
    end
    local State = AtramentaFakePositionPhysicsState
    if State.Character ~= Character or State.Root ~= Root or typeof(State.AnchorCFrame) ~= "CFrame" then
        if not CaptureAtramentaFakePositionAnchor(Character) then return end
    end
    if not AtramentaFakePositionOwnsAssembly(Root) then
        RestoreAtramentaFakePositionPhysics()
        return
    end
    if Ragebot and Ragebot.Runtime and Ragebot.Runtime.TPHitBusy == true then
        RestoreAtramentaFakePositionPhysics()
        return
    end
    if State.SpoofApplied == true then RestoreAtramentaFakePositionPhysics() end
    local RealCFrame = Root.CFrame
    local RealVelocity = Root.AssemblyLinearVelocity
    local RealAngularVelocity = Root.AssemblyAngularVelocity
    State.SavedRoot = Root
    State.SavedCFrame = RealCFrame
    State.SavedVelocity = RealVelocity
    State.SavedAngularVelocity = RealAngularVelocity
    State.SpoofApplied = true
    State.LastPulse = Clock()
    DesyncNetworkState.FakePositionPreviousPosition = RealCFrame.Position
    DesyncNetworkState.FakePositionPreviousVelocity = RealVelocity
    DesyncNetworkState.FakePositionPreviousTime = State.LastPulse
    Root.CFrame = State.AnchorCFrame
    Root.AssemblyLinearVelocity = State.AnchorVelocity
    Root.AssemblyAngularVelocity = State.AnchorAngularVelocity
    DesyncNetworkState.FakePositionPatchedPackets = (tonumber(DesyncNetworkState.FakePositionPatchedPackets) or 0) + 1
end

function AtramentaFakePositionShouldBlock(CurrentTime, Protected)
    return false
