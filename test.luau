    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Character or not Humanoid or not Root or not Root.Parent or Humanoid.Health <= 0 or Root.Anchored then
        return nil
    end
    local State = Humanoid:GetState()
    if State == Enum.HumanoidStateType.Dead or State == Enum.HumanoidStateType.Seated then
        return nil
    end
    return Character, Humanoid, Root
end

local function VelocityDesyncRageOwnsRoot()
    if not Ragebot or not Ragebot.Runtime then
        return false
    end
    if Ragebot.Runtime.TPHitBusy == true then
        return true
    end
    local ActiveShot = Ragebot.Runtime.ActiveShot
    return type(ActiveShot) == "table" and ActiveShot.TPHit == true
end

local function VelocityDesyncMakeRaycastParams(Character)
    local Parameters = NewRaycastParams()
    Parameters.FilterType = Enum.RaycastFilterType.Exclude
    Parameters.FilterDescendantsInstances = {Character, Workspace.CurrentCamera}
    Parameters.IgnoreWater = true
    return Parameters
end

function BuildVelocityDesyncOffset(Root, Character, CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Rng = VelocityDesync.Random
    if typeof(Rng) ~= "Random" then
        Rng = Random.new((Floor(CurrentTime * 1000000) + Abs(LocalPlayer.UserId or 0) * 977) % 2147483646 + 1)
        VelocityDesync.Random = Rng
    end
    if (tonumber(VelocityDesync.LissajousStartTime) or 0) <= 0 then
        VelocityDesync.LissajousStartTime = CurrentTime
        VelocityDesync.LissajousLastTime = CurrentTime
        VelocityDesync.LissajousAmplitude = NewVector3(22, 22, 22)
        VelocityDesync.LissajousFrequency = NewVector3(Rng:NextNumber(62.0, 84.0), Rng:NextNumber(78.0, 108.0), Rng:NextNumber(54.0, 76.0))
        VelocityDesync.LissajousPhase = NewVector3(Rng:NextNumber(0, Pi * 2), Rng:NextNumber(0, Pi * 2), Rng:NextNumber(0, Pi * 2))
        VelocityDesync.LissajousPhaseJitter = EmptyVector3
        VelocityDesync.LissajousPhaseJitterTarget = EmptyVector3
        VelocityDesync.LissajousNextJitterAt = CurrentTime + Rng:NextNumber(0.018, 0.045)
    end
    local LastTime = tonumber(VelocityDesync.LissajousLastTime) or CurrentTime
    local DeltaTime = Clamp(CurrentTime - LastTime, 0, 0.10)
    VelocityDesync.LissajousLastTime = CurrentTime
    if CurrentTime >= (tonumber(VelocityDesync.LissajousNextJitterAt) or 0) then
        VelocityDesync.LissajousPhaseJitterTarget = NewVector3(Rng:NextNumber(-1.20, 1.20), Rng:NextNumber(-1.00, 1.00), Rng:NextNumber(-1.20, 1.20))
        VelocityDesync.LissajousNextJitterAt = CurrentTime + Rng:NextNumber(0.022, 0.060)
    end
    local CurrentJitter = VelocityDesync.LissajousPhaseJitter
    local TargetJitter = VelocityDesync.LissajousPhaseJitterTarget
    if typeof(CurrentJitter) ~= "Vector3" then CurrentJitter = EmptyVector3 end
    if typeof(TargetJitter) ~= "Vector3" then TargetJitter = EmptyVector3 end
    local JitterAlpha = 1 - Exp(-DeltaTime * 72.0)
    CurrentJitter = CurrentJitter:Lerp(TargetJitter, JitterAlpha)
    VelocityDesync.LissajousPhaseJitter = CurrentJitter
    local Elapsed = Max(0, CurrentTime - (tonumber(VelocityDesync.LissajousStartTime) or CurrentTime))
    local Amplitude = VelocityDesync.LissajousAmplitude
    local Frequency = VelocityDesync.LissajousFrequency
    local Phase = VelocityDesync.LissajousPhase
    if typeof(Amplitude) ~= "Vector3" then Amplitude = NewVector3(22, 22, 22) end
    if typeof(Frequency) ~= "Vector3" then Frequency = NewVector3(72.0, 91.0, 63.0) end
    if typeof(Phase) ~= "Vector3" then Phase = NewVector3(0, 2.0943951024, 4.1887902048) end
    local Minimum = tonumber(VelocityDesync.LissajousMinOffset) or -22
    local Maximum = tonumber(VelocityDesync.LissajousMaxOffset) or 22
    if Minimum > Maximum then Minimum, Maximum = Maximum, Minimum end
    local Center = (Minimum + Maximum) * 0.5
    local Radius = (Maximum - Minimum) * 0.5
    local XPhase = Elapsed * Frequency.X + Phase.X + CurrentJitter.X
    local YPhase = Elapsed * Frequency.Y + Phase.Y + CurrentJitter.Y
    local ZPhase = Elapsed * Frequency.Z + Phase.Z + CurrentJitter.Z
    local Candidate = NewVector3(Center + (Sin(XPhase) * 0.68 + Sin(XPhase * 2.73 + YPhase * 0.17) * 0.32) * Radius,
        Center + (Sin(YPhase) * 0.66 + Sin(YPhase * 2.41 + ZPhase * 0.19) * 0.34) * Radius, Center + (Sin(ZPhase) * 0.70 + Sin(ZPhase * 2.89 + XPhase * 0.13) * 0.30) * Radius)
    Candidate = NewVector3(Clamp(Candidate.X, Minimum, Maximum), Clamp(Candidate.Y, Minimum, Maximum), Clamp(Candidate.Z, Minimum, Maximum))
    VelocityDesync.LastOffsetChange = CurrentTime
    VelocityDesync.NextOffsetChange = CurrentTime
    VelocityDesync.Sequence = (tonumber(VelocityDesync.Sequence) or 0) + 1
    VelocityDesync.CurrentOffset = Candidate
    return Candidate
end

function CaptureVelocityDesyncVisualSnapshot(Character, Root, RealCFrame, FakeCFrame, RealVelocity, FakeVelocity, CurrentTime)
    if not Character or not Root or not Root.Parent or typeof(RealCFrame) ~= "CFrame" or typeof(FakeCFrame) ~= "CFrame" then
        return
    end
    local Parts
    if type(BacktrackVisuals) == "table" and type(BacktrackVisuals.CaptureParts) == "function" then
        VelocityDesync.VisualReferenceState = type(VelocityDesync.VisualReferenceState) == "table" and VelocityDesync.VisualReferenceState or {}
        local CurrentParts = BacktrackVisuals:CaptureParts(Character, VelocityDesync.VisualReferenceState)
        if type(CurrentParts) == "table" then
            Parts = {}
            local CurrentRoot = Root.CFrame
            for Name, PartCFrame in pairs(CurrentParts) do
                if typeof(PartCFrame) == "CFrame" then Parts[Name] = FakeCFrame * CurrentRoot:ToObjectSpace(PartCFrame) end
            end
        end
    end
    VelocityDesync.VisualSnapshot = {Time = tonumber(CurrentTime) or Clock(), Character = Character, RootCFrame = FakeCFrame, Parts = Parts, Method = "FastFlag+VelocitySpoof",
        Mode = NormalizeVelocityDesyncMode(VelocityDesync.Mode), Offset = FakeCFrame.Position - RealCFrame.Position, FakeVelocity = FakeVelocity, RealVelocity = RealVelocity}
end

function GetVelocityDesyncVisualSnapshot(CurrentTime)
    local Snapshot = type(VelocityDesync) == "table" and VelocityDesync.VisualSnapshot or nil
    if type(Snapshot) ~= "table" or typeof(Snapshot.RootCFrame) ~= "CFrame" then
        return nil
    end
    local Age = Max(0, (tonumber(CurrentTime) or Clock()) - (tonumber(Snapshot.Time) or 0))
    if Age > 0.25 then
        return nil
    end
    local Parts = {}
    if type(Snapshot.Parts) == "table" then
        for Name, PartCFrame in pairs(Snapshot.Parts) do
            if typeof(PartCFrame) == "CFrame" then Parts[Name] = PartCFrame end
        end
    end
    return {Time = Snapshot.Time, Age = Age, RootCFrame = Snapshot.RootCFrame, Parts = Parts, Method = Snapshot.Method, Mode = Snapshot.Mode, Offset = Snapshot.Offset,
        FakeVelocity = Snapshot.FakeVelocity, RealVelocity = Snapshot.RealVelocity}
end

function RestoreVelocityDesyncSpoof()
    local Root = VelocityDesync.SavedRoot
    local SavedVelocity = VelocityDesync.SavedVelocity
    local SavedAngularVelocity = VelocityDesync.SavedAngularVelocity
    VelocityDesync.SavedRoot = nil
    VelocityDesync.SavedCFrame = nil
    VelocityDesync.SavedVelocity = nil
    VelocityDesync.SavedAngularVelocity = nil
    VelocityDesync.FakeCFrame = nil
    VelocityDesync.PostSimulationCFrame = nil
    VelocityDesync.RestoreCFrame = nil
    VelocityDesync.SpoofApplied = false
    VelocityDesync.AppliedMethod = nil
    VelocityDesync.Phase = "Idle"
    VelocityDesync.AppliedOffset = EmptyVector3
    if not Root or not Root.Parent then
        return
    end
    if typeof(SavedVelocity) == "Vector3" then
        Shared.SafeCall(function()
            Root.AssemblyLinearVelocity = SavedVelocity
        end)
    end
    if typeof(SavedAngularVelocity) == "Vector3" then
        Shared.SafeCall(function()
            Root.AssemblyAngularVelocity = SavedAngularVelocity
        end)
    end
end

function ApplyVelocityDesyncSpoof(DeltaTime)
    if DesyncSettings and DesyncSettings.FakePositionEnabled == true then
        if VelocityDesync.SpoofApplied or VelocityDesync.SavedRoot then RestoreVelocityDesyncSpoof() end
        return
    end
    if VelocityDesync.Enabled ~= true then
        if VelocityDesync.SpoofApplied or VelocityDesync.SavedRoot then RestoreVelocityDesyncSpoof() end
        return
    end
    if VelocityDesyncRageOwnsRoot() then
        if VelocityDesync.SpoofApplied or VelocityDesync.SavedRoot then RestoreVelocityDesyncSpoof() end
        return
    end
    if VelocityDesync.SpoofApplied or VelocityDesync.SavedRoot then RestoreVelocityDesyncSpoof() end
    local Character, Humanoid, Root = GetVelocityDesyncCharacter()
    if not Root then return end
    local RealCFrame = Root.CFrame
    local RealVelocity = Root.AssemblyLinearVelocity
    local RealAngularVelocity = Root.AssemblyAngularVelocity
    local CurrentTime = Clock()
    local Wave = BuildVelocityDesyncOffset(Root, Character, CurrentTime)
    if typeof(Wave) ~= "Vector3" then return end
    local VelocityScale = Max(tonumber(VelocityDesync.VelocityScale) or 30.0, 0)
    local AngularScale = Max(tonumber(VelocityDesync.AngularScale) or 18.0, 0)
    local VelocityDelta = Wave * VelocityScale
    local FakeVelocity = RealVelocity + VelocityDelta
    local FakeAngularVelocity = NewVector3(Wave.Z * AngularScale, Wave.X * AngularScale, Wave.Y * AngularScale)
    VelocityDesync.Method = "FastFlag+VelocitySpoof"
    VelocityDesync.Mode = NormalizeVelocityDesyncMode(VelocityDesync.Mode)
    VelocityDesync.RealVelocity = RealVelocity
    VelocityDesync.RealAngularVelocity = RealAngularVelocity
    VelocityDesync.FakeVelocity = FakeVelocity
    VelocityDesync.FakeAngularVelocity = FakeAngularVelocity
    VelocityDesync.VelocityDelta = VelocityDelta
    VelocityDesync.Offset = Wave
    VelocityDesync.CurrentOffset = Wave
    VelocityDesync.AppliedOffset = Wave
    VelocityDesync.SavedRoot = Root
    VelocityDesync.SavedCFrame = nil
    VelocityDesync.SavedVelocity = RealVelocity
    VelocityDesync.SavedAngularVelocity = RealAngularVelocity
    VelocityDesync.FakeCFrame = nil
    VelocityDesync.PostSimulationCFrame = nil
    VelocityDesync.RestoreCFrame = nil
    VelocityDesync.SpoofApplied = true
    VelocityDesync.AppliedMethod = "FastFlag+VelocitySpoof"
    VelocityDesync.Phase = "Lissajous3DVelocity"
    VelocityDesync.LastPhysicsDelta = Clamp(tonumber(DeltaTime) or (1 / 60), 1 / 240, 1 / 20)
    Root.AssemblyLinearVelocity = FakeVelocity
    Root.AssemblyAngularVelocity = FakeAngularVelocity
    local PreviewCFrame = RealCFrame + VelocityDelta * Min(VelocityDesync.LastPhysicsDelta * 2, 0.08)
    CaptureVelocityDesyncVisualSnapshot(Character, Root, RealCFrame, PreviewCFrame, RealVelocity, FakeVelocity, CurrentTime)
    VelocityDesync.RuntimePatched = (tonumber(VelocityDesync.RuntimePatched) or 0) + 1
    VelocityDesync.Patched = VelocityDesync.RuntimePatched
    VelocityDesync.LastRuntimePatch = CurrentTime
end

function CaptureVelocityDesyncAfterSimulation()
    if VelocityDesync.Enabled == true and VelocityDesync.SpoofApplied == true then VelocityDesync.Phase = "AwaitingRenderVelocityRestore" end
end

function StopVelocityDesyncRuntime()
    if VelocityDesync.HeartbeatConnection then
        Shared.SafeDisconnect(VelocityDesync.HeartbeatConnection)
        VelocityDesync.HeartbeatConnection = nil
    end
    if VelocityDesync.PreSimulationConnection then
        Shared.SafeDisconnect(VelocityDesync.PreSimulationConnection)
        VelocityDesync.PreSimulationConnection = nil
    end
    if VelocityDesync.PostSimulationConnection then
        Shared.SafeDisconnect(VelocityDesync.PostSimulationConnection)
        VelocityDesync.PostSimulationConnection = nil
    end
    if VelocityDesync.RenderConnection then
        Shared.SafeDisconnect(VelocityDesync.RenderConnection)
        VelocityDesync.RenderConnection = nil
    end
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep("AtramentaVelocityDesyncRestore")
    end)
    RestoreVelocityDesyncSpoof()
    VelocityDesync.CurrentOffset = EmptyVector3
    VelocityDesync.AppliedOffset = EmptyVector3
    VelocityDesync.Offset = EmptyVector3
    VelocityDesync.VisualSnapshot = nil
    VelocityDesync.NextOffsetChange = 0
    VelocityDesync.Phase = "Idle"
    VelocityDesync.AppliedMethod = nil
    ApplyVelocityDesyncSenderRate(false)
end

function StartVelocityDesyncRuntime()
    StopVelocityDesyncRuntime()
    if VelocityDesync.Enabled ~= true then
        return false
    end
    VelocityDesync.Method = "FastFlag+VelocitySpoof"
    VelocityDesync.Mode = "Lissajous3D"
    VelocityDesync.AppliedMethod = "FastFlag+VelocitySpoof"
    VelocityDesync.Phase = "Lissajous3DVelocity"
    local FastFlagApplied = ApplyVelocityDesyncSenderRate(true)
    VelocityDesync.HeartbeatConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        ApplyVelocityDesyncSpoof(DeltaTime)
    end)
    Shared.SafeCall(function()
        RunService:BindToRenderStep("AtramentaVelocityDesyncRestore", Enum.RenderPriority.Camera.Value - 1,
            function()
                if VelocityDesync.SpoofApplied or VelocityDesync.SavedRoot then RestoreVelocityDesyncSpoof() end
            end)
    end)
    if not FastFlagApplied then VelocityDesync.Phase = "VelocitySpoofOnly" end
    return true
end

function RewriteVelocityDesyncPacket(Packet, Data, BaseSnapshot)
    return false, BaseSnapshot
end

function SetVelocityDesyncEnabled(Value)
    local Enabled = Value == true
    VelocityDesync.Enabled = false
    StopVelocityDesyncRuntime()
    VelocityDesync.Enabled = Enabled
    if Enabled then StartVelocityDesyncRuntime() end
    return VelocityDesync.Enabled
end

function CleanupAtramentaDesyncRuntime()
    if type(SetFakePositionEnabled) == "function" then
        Shared.SafeCall(SetFakePositionEnabled, false)
    elseif type(DesyncSettings) == "table" then
        DesyncSettings.FakePositionEnabled = false
    end
    if type(VelocityDesync) == "table" then
        VelocityDesync.Enabled = false
        Shared.SafeCall(StopVelocityDesyncRuntime)
        Shared.SafeCall(ApplyVelocityDesyncSenderRate, false)
    end
    SetAtramentaPhysicsSenderRateOwner("FakePosition", false)
    SetAtramentaPhysicsSenderRateOwner("VelocityDesync", false)
    local RakNetState = rawget(Environment, "AtramentaDesyncRakNet")
    if type(RakNetState) == "table" and RakNetState.Controller == DesyncNetworkState then RakNetState.Controller = nil end
    local LegacyRakNetState = rawget(Environment, "AtramentaAntiAimRakNet")
    if type(LegacyRakNetState) == "table" and LegacyRakNetState.Controller == DesyncNetworkState then LegacyRakNetState.Controller = nil end
    Shared.SafeCall(function() RunService:UnbindFromRenderStep("AtramentaVelocityDesyncRestore") end)
end
AtramentaRuntimeControl:AddCleanup(function()
    if type(Ragebot) == "table" then
        if type(Ragebot.DisconnectReload) == "function" then Shared.SafeCall(Ragebot.DisconnectReload) end
        if type(Ragebot.StopReloadMonitor) == "function" then Shared.SafeCall(Ragebot.StopReloadMonitor) end
