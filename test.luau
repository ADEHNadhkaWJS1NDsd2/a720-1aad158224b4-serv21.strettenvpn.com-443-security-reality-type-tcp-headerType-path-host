    end
    Delay(self.Hit.OverlayDuration + 0.05, function() if Gui.Parent then Gui:Destroy() end end)
end
function ExtendedVisuals:OnHit(TargetPart, Character, IsHeadshot)
    self:EmitSkeleton(Character)
