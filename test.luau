function Ragebot.GetTargetScreenMetric(Character, MousePosition, CameraObject)
    if not Character or typeof(MousePosition) ~= "Vector2" or not CameraObject then
        return nil
    end
    local Best = Infinite
    local Found = false
    local Parts = Ragebot.GetTargetScreenParts(Character)
    local Player = Shared.GetPlayerFromTrackedCharacter(Character) or Players:GetPlayerFromCharacter(Character)
    for Index = 1, #Parts do
        local Part = Parts[Index]
        if Part and Part:IsA("BasePart") then
            local Position = Part.Position
            if Ragebot.Settings.Resolver == true and Player then Position = select(1, ResolverGetAimPosition(Player, Character, Part, true)) or Position end
            local Screen = Ragebot.GetTargetScreenPosition(Position, CameraObject)
            if Screen then
                local Distance = (Screen - MousePosition).Magnitude
                if Distance < Best then
                    Best = Distance
                    Found = true
                end
            end
        end
    end
    return Found and Best or nil
