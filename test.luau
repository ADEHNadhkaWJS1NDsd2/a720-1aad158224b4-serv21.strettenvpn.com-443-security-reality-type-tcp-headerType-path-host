            if UpdateTransparency then
                Beam.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, CosmeticClamp(Transparency + 0.26, 0, 0.97)),
                    NumberSequenceKeypoint.new(0.72, CosmeticClamp(Transparency + 0.20, 0, 0.96)), NumberSequenceKeypoint.new(1, CosmeticClamp(Transparency + 0.12, 0, 0.95))})
            end
        end
    end
    local OutlineStart = Max(StartIndex, SurfaceCount + 1)
    for GlobalIndex = OutlineStart, EndIndex do
        local Index = GlobalIndex - SurfaceCount local Data = OutlineBeams[Index]
        if not Data then break end
        local Beam = Data.Beam
        if Beam and Beam.Parent then
            Beam.Color = ColorSequence.new(GetChinaHatColor(Data.ColorIndex or Index, Data.HueOffset or 0),
                GetChinaHatColor((Data.ColorIndex or Index) + 1, Data.HueOffset or 0))
            if UpdateTransparency then Beam.Transparency = NumberSequence.new(CosmeticClamp(Transparency + (Data.Faint and 0.22 or 0), 0, 0.96)) end
        end
    end
    if UseBatch and TotalCount > 0 then
        AtramentaConfig.Visual.ChinaHat.AppearanceBatchIndex = EndIndex >= TotalCount and 1 or EndIndex + 1
    else
        AtramentaConfig.Visual.ChinaHat.AppearanceBatchIndex = 1
    end
end
function CreateChinaHat(Character)
    Character = Character or LocalPlayer.Character
    local CurrentTime = Clock()
    if CurrentTime < (tonumber(AtramentaConfig.Visual.ChinaHat.NextBuildAt) or 0) then return false end
    AtramentaConfig.Visual.ChinaHat.NextBuildAt = CurrentTime + 0.20
    if not Character then return false end
    local Head = Character:FindFirstChild("Head") local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Head or not Humanoid or Humanoid.RigType ~= Enum.HumanoidRigType.R6 then return false end
    DestroyChinaHat()
    local Model = NewInstance("Model")
    Model.Name = "MinecraftChinaHat"
    Model.Parent = Character
    local Pivot = NewInstance("Part")
    Pivot.Name = "ChinaHatPivot"
    Pivot.Size = NewVector3(0.1, 0.1, 0.1)
    Pivot.Transparency = 1
    Pivot.Anchored = false
    Pivot.CanCollide = false
    Pivot.CanTouch = false
    Pivot.CanQuery = false
    Pivot.Massless = true
    Pivot.CastShadow = false
    Pivot.CFrame = Head.CFrame * NewCFrame(0, AtramentaConfig.Visual.ChinaHat.Height, 0)
    Pivot.Parent = Model
    local Motor = NewInstance("Motor6D")
    Motor.Name = "ChinaHatMotor"
    Motor.Part0 = Head
    Motor.Part1 = Pivot
    Motor.C0 = NewCFrame(0, AtramentaConfig.Visual.ChinaHat.Height, 0)
    Motor.C1 = NewCFrame()
    Motor.Parent = Head
    local Segments = AtramentaConfig.Visual.ChinaHat.Segments local Scale = AtramentaConfig.Visual.ChinaHat.Scale local Radius = 1.18 * Scale local RimHeight = -0.28 * Scale
    local ApexHeight = 0.48 * Scale local InnerRadius = Radius * 0.54
    local InnerHeight = RimHeight + (ApexHeight - RimHeight) * 0.46 local ArcWidth = (Radius * Pi * 2) / Segments
    local Apex = CreateChinaHatAttachment(Pivot, "HatApex", NewVector3(0, ApexHeight, 0))
    local Rim = {}
    local Inner = {}
    for Index = 1, Segments do
        local Angle = (Index - 1) / Segments * Pi * 2 local X = Cos(Angle) local Z = Sin(Angle)
        Rim[Index] = CreateChinaHatAttachment(Pivot, "HatRim_" .. Index, NewVector3(X * Radius, RimHeight, Z * Radius))
        Inner[Index] = CreateChinaHatAttachment(Pivot, "HatInner_" .. Index, NewVector3(X * InnerRadius, InnerHeight, Z * InnerRadius))
    end
    for Index = 1, Segments do
        local NextIndex = Index % Segments + 1
        local Surface = CreateChinaHatBeam(Pivot, "HatSurface_" .. Index, Apex, Rim[Index], 0.018 * Scale, ArcWidth * 1.08, NumberSequence.new(0.42), -0.02)
        AtramentaConfig.Visual.ChinaHat.SurfaceBeams[#AtramentaConfig.Visual.ChinaHat.SurfaceBeams + 1] = {Beam = Surface}
        local RimBeam = CreateChinaHatBeam(Pivot, "HatRimLine_" .. Index, Rim[Index], Rim[NextIndex], 0.038 * Scale, 0.038 * Scale, NumberSequence.new(0.10), 0.03)
        AtramentaConfig.Visual.ChinaHat.OutlineBeams[#AtramentaConfig.Visual.ChinaHat.OutlineBeams + 1] = {Beam = RimBeam, ColorIndex = Index, HueOffset = 0, Faint = false}
        local InnerBeam = CreateChinaHatBeam(Pivot, "HatInnerLine_" .. Index, Inner[Index], Inner[NextIndex], 0.024 * Scale, 0.024 * Scale, NumberSequence.new(0.32), 0.02)
        AtramentaConfig.Visual.ChinaHat.OutlineBeams[#AtramentaConfig.Visual.ChinaHat.OutlineBeams + 1] = {Beam = InnerBeam, ColorIndex = Index, HueOffset = 0.04, Faint = true}
        if Index % 4 == 1 then
            local Spoke = CreateChinaHatBeam(Pivot, "HatSpoke_" .. Index, Apex, Rim[Index], 0.018 * Scale, 0.018 * Scale, NumberSequence.new(0.38), 0.04)
            AtramentaConfig.Visual.ChinaHat.OutlineBeams[#AtramentaConfig.Visual.ChinaHat.OutlineBeams + 1] = {Beam = Spoke, ColorIndex = Index, HueOffset = 0.02, Faint = true}
        end
    end
    AtramentaConfig.Visual.ChinaHat.Model = Model
    AtramentaConfig.Visual.ChinaHat.Motor = Motor AtramentaConfig.Visual.ChinaHat.Time = 0
    AtramentaConfig.Visual.ChinaHat.AppearanceAccumulator = 0
    UpdateChinaHatAppearance()
    AtramentaConfig.Visual.ChinaHat.RuntimeAccumulator = 0
    AtramentaConfig.Visual.ChinaHat.NextBuildAt = 0
    return true
end
function UpdateChinaHat(DeltaTime)
    if not AtramentaConfig.Visual.ChinaHat.Enabled then return end
    DeltaTime = CosmeticClamp(tonumber(DeltaTime) or 0.016, 0.001, 0.05)
    AtramentaConfig.Visual.ChinaHat.RuntimeAccumulator = (tonumber(AtramentaConfig.Visual.ChinaHat.RuntimeAccumulator) or 0) + DeltaTime
    local RuntimeInterval = tonumber(AtramentaConfig.Visual.ChinaHat.RuntimeInterval) or 1 / 30
    if AtramentaConfig.Visual.ChinaHat.RuntimeAccumulator < RuntimeInterval then return end
    DeltaTime = AtramentaConfig.Visual.ChinaHat.RuntimeAccumulator AtramentaConfig.Visual.ChinaHat.RuntimeAccumulator = 0
    local Character = LocalPlayer.Character
    if not Character then DestroyChinaHat(); return end
    if not AtramentaConfig.Visual.ChinaHat.Model or AtramentaConfig.Visual.ChinaHat.Model.Parent ~= Character then CreateChinaHat(Character); return end
    local Motor = AtramentaConfig.Visual.ChinaHat.Motor if not Motor or not Motor.Parent then CreateChinaHat(Character); return end
    AtramentaConfig.Visual.ChinaHat.Time += DeltaTime
    local Rotation = Rad(AtramentaConfig.Visual.ChinaHat.Time * AtramentaConfig.Visual.ChinaHat.SpinSpeed) local Bob = Sin(AtramentaConfig.Visual.ChinaHat.Time * 2) * 0.012
    local Target = NewCFrame(0, Bob, 0) * Angles(0, Rotation, 0)
    Motor.Transform = Motor.Transform:Lerp(Target, CosmeticExpAlpha(10, DeltaTime))
    if AtramentaConfig.Visual.ChinaHat.Rainbow then
        AtramentaConfig.Visual.ChinaHat.AppearanceAccumulator += DeltaTime
        if AtramentaConfig.Visual.ChinaHat.AppearanceAccumulator >= AtramentaConfig.Visual.ChinaHat.AppearanceInterval then
            AtramentaConfig.Visual.ChinaHat.AppearanceAccumulator %= AtramentaConfig.Visual.ChinaHat.AppearanceInterval
            UpdateChinaHatAppearance(true)
        end
    else
        AtramentaConfig.Visual.ChinaHat.AppearanceAccumulator = 0
    end
end
function SetupChinaHat()
    if AtramentaConfig.Visual.ChinaHat.Connection then Shared.SafeDisconnect(AtramentaConfig.Visual.ChinaHat.Connection) end
    AtramentaConfig.Visual.ChinaHat.Connection = RunService.Heartbeat:Connect(function(DeltaTime)
        Shared.SafeCall(UpdateChinaHat, DeltaTime)
    end)
    if AtramentaConfig.Visual.ChinaHat.CharacterConnection then Shared.SafeDisconnect(AtramentaConfig.Visual.ChinaHat.CharacterConnection) end
    AtramentaConfig.Visual.ChinaHat.CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(Character)
        AtramentaConfig.Visual.ChinaHat.BuildGeneration = (tonumber(AtramentaConfig.Visual.ChinaHat.BuildGeneration) or 0) + 1
        local Generation = AtramentaConfig.Visual.ChinaHat.BuildGeneration
        Spawn(function()
            Wait(0.55)
            if AtramentaConfig.Visual.ChinaHat.Enabled and Generation == AtramentaConfig.Visual.ChinaHat.BuildGeneration and Character == LocalPlayer.Character then
                AtramentaConfig.Visual.ChinaHat.NextBuildAt = 0
                CreateChinaHat(Character)
            end
        end)
    end)
    AtramentaConfig.Visual.ChinaHat.NextBuildAt = 0
    CreateChinaHat(LocalPlayer.Character)
end
function RebuildChinaHat()
    if not AtramentaConfig.Visual.ChinaHat.Enabled then return end
    AtramentaConfig.Visual.ChinaHat.NextBuildAt = 0
    CreateChinaHat(LocalPlayer.Character)
end
function ToggleChinaHat(State)
    AtramentaConfig.Visual.ChinaHat.Enabled = State == true
    AtramentaConfig.Visual.ChinaHat.BuildGeneration = (tonumber(AtramentaConfig.Visual.ChinaHat.BuildGeneration) or 0) + 1
    if AtramentaConfig.Visual.ChinaHat.Enabled then
        SetupChinaHat()
    else
        if AtramentaConfig.Visual.ChinaHat.Connection then Shared.SafeDisconnect(AtramentaConfig.Visual.ChinaHat.Connection); AtramentaConfig.Visual.ChinaHat.Connection = nil end
        if AtramentaConfig.Visual.ChinaHat.CharacterConnection then Shared.SafeDisconnect(AtramentaConfig.Visual.ChinaHat.CharacterConnection); AtramentaConfig.Visual.ChinaHat.CharacterConnection = nil end
        DestroyChinaHat()
    end
end
function CosmeticClamp(Value, Minimum, Maximum) return Max(Minimum, Min(Maximum, Value)) end
function CosmeticExpAlpha(Speed, DeltaTime) return 1 - Exp(-Speed * DeltaTime) end
function DestroyDemonCosmetics()
    local Demon = AtramentaConfig.Visual.Demon
    if Demon.Folder and Demon.Folder.Parent then Demon.Folder:Destroy() end
    for Index = #Demon.Attachments, 1, -1 do
        local Attachment = Demon.Attachments[Index]
        if Attachment and Attachment.Parent then Attachment:Destroy() end
        Demon.Attachments[Index] = nil
    end
    Clear(Demon.CoreBeams)
    Clear(Demon.GlowBeams)
    Clear(Demon.HornAttachments)
    Clear(Demon.TailAttachments)
    Clear(Demon.SpikeAttachments)
    Clear(Demon.SpadeAttachments)
    Clear(Demon.TailBeams)
    Clear(Demon.SpikeBeams)
    Clear(Demon.SpadeBeams)
    Demon.Folder = nil
    Demon.Character = nil
    Demon.Head = nil
    Demon.RootPart = nil
end
function CreateDemonAttachment(Parent, Name, Position)
    local Attachment = NewInstance("Attachment")
    Attachment.Name = Name
    Attachment.Position = Position or EmptyVector3
    Attachment.Parent = Parent
    AtramentaConfig.Visual.Demon.Attachments[#AtramentaConfig.Visual.Demon.Attachments + 1] = Attachment
    return Attachment
end
function IsDemonBeamRoleEnabled(Role)
    local Demon = AtramentaConfig.Visual.Demon
    if Role == "Horn" then return Demon.Horns == true end
    if Role == "Tail" or Role == "Spade" then return Demon.Tail == true end
    if Role == "Spike" then return Demon.Tail == true and Demon.Spikes == true end
    return false
end
function GetDemonRoleStyle(Role)
    local Demon = AtramentaConfig.Visual.Demon
    if Role == "Horn" then
        return Demon.HornColor, Demon.HornGlowColor, Demon.HornTransparency, Demon.HornGlow == true
    end
    return Demon.TailColor, Demon.TailGlowColor, Demon.TailTransparency, Demon.TailGlow == true
end
function CreateDemonBeam(Parent, Attachment0, Attachment1, Width0, Width1, Role)
    local Demon = AtramentaConfig.Visual.Demon
    local Color, GlowColor, Transparency, GlowEnabled = GetDemonRoleStyle(Role)
    local Beam = NewInstance("Beam")
    Beam.Name = "AtramentaDemon" .. tostring(Role or "Core")
    Beam.Attachment0 = Attachment0
    Beam.Attachment1 = Attachment1
    Beam.FaceCamera = true
    Beam.Segments = 1
    Beam.Width0 = Width0
    Beam.Width1 = Width1
    Beam.LightEmission = 0.72
    Beam.LightInfluence = 0
    Beam.Color = ColorSequence.new(Color)
    Beam.Transparency = NumberSequence.new(Clamp(tonumber(Transparency) or 0.08, 0, 0.92))
    Beam.ZOffset = 0.02
    Beam.Enabled = IsDemonBeamRoleEnabled(Role)
    Beam:SetAttribute("AtramentaDemonRole", tostring(Role or "Core"))
    Beam.Parent = Parent
    Demon.CoreBeams[#Demon.CoreBeams + 1] = Beam
    local GlowBeam = NewInstance("Beam")
    GlowBeam.Name = "AtramentaDemonGlow"
    GlowBeam.Attachment0 = Attachment0
    GlowBeam.Attachment1 = Attachment1
    GlowBeam.FaceCamera = true
    GlowBeam.Segments = 1
    GlowBeam.Width0 = Width0 * 2.15
    GlowBeam.Width1 = Width1 * 2.15
    GlowBeam.LightEmission = 1
    GlowBeam.LightInfluence = 0
    GlowBeam.Color = ColorSequence.new(GlowColor)
    GlowBeam.Transparency = NumberSequence.new(Clamp(0.68 + (tonumber(Transparency) or 0.08) * 0.22, 0, 0.96))
    GlowBeam.ZOffset = -0.02
    GlowBeam.Enabled = GlowEnabled and IsDemonBeamRoleEnabled(Role)
    GlowBeam:SetAttribute("AtramentaDemonRole", tostring(Role or "Core"))
    GlowBeam.Parent = Parent
    Demon.GlowBeams[#Demon.GlowBeams + 1] = GlowBeam
    return Beam, GlowBeam
end
function UpdateDemonAppearance()
    local Demon = AtramentaConfig.Visual.Demon
    for _, Beam in ipairs(Demon.CoreBeams) do
        if Beam and Beam.Parent then
            local Role = Beam:GetAttribute("AtramentaDemonRole")
            local Color, _, Transparency = GetDemonRoleStyle(Role)
            Beam.Color = ColorSequence.new(Color)
            Beam.Transparency = NumberSequence.new(Clamp(tonumber(Transparency) or 0.08, 0, 0.92))
            Beam.Enabled = IsDemonBeamRoleEnabled(Role)
        end
    end
    for _, Beam in ipairs(Demon.GlowBeams) do
        if Beam and Beam.Parent then
            local Role = Beam:GetAttribute("AtramentaDemonRole")
            local _, GlowColor, Transparency, GlowEnabled = GetDemonRoleStyle(Role)
            Beam.Color = ColorSequence.new(GlowColor)
            Beam.Transparency = NumberSequence.new(Clamp(0.68 + (tonumber(Transparency) or 0.08) * 0.22, 0, 0.96))
            Beam.Enabled = GlowEnabled and IsDemonBeamRoleEnabled(Role)
        end
    end
end
function BuildDemonHorns(Head, Folder)
    local Demon = AtramentaConfig.Visual.Demon
    local SegmentCount = 8
    local Scale = Demon.HornScale
    for SideIndex, Side in ipairs({-1, 1}) do
        local Horn = {}
        for Segment = 0, SegmentCount do
            local Alpha = Segment / SegmentCount
            local SideDistance = (0.36 + Sin(Alpha * 1.8) * 1.02) * Side * Scale
            local Height = (0.46 + Alpha * 1.62 - Alpha ^ 2.2 * 0.42) * Scale
            local Back = (-0.08 + Alpha ^ 1.8 * 1.06) * Scale
            Horn[Segment + 1] = CreateDemonAttachment(Head, "AtramentaDemonHorn" .. tostring(SideIndex) .. "_" .. tostring(Segment), NewVector3(SideDistance, Height, Back))
        end
        Demon.HornAttachments[SideIndex] = Horn
        for Segment = 1, SegmentCount do
            local Alpha0 = (Segment - 1) / SegmentCount
            local Alpha1 = Segment / SegmentCount
            local Width0 = Max(0.035, (0.22 * (1 - Alpha0 * 0.84)) * Scale * Demon.HornThickness)
            local Width1 = Max(0.025, (0.22 * (1 - Alpha1 * 0.84)) * Scale * Demon.HornThickness)
            local Beam, GlowBeam = CreateDemonBeam(Folder, Horn[Segment], Horn[Segment + 1], Width0, Width1, "Horn")
            Beam.Enabled = Demon.Horns == true
            GlowBeam.Enabled = Demon.Horns == true and Demon.HornGlow == true
        end
    end
end
function BuildDemonTail(RootPart, Folder)
    local Demon = AtramentaConfig.Visual.Demon
    local SegmentCount = Clamp(Floor(tonumber(Demon.TailSegments) or 18), 10, 28)
    for Segment = 0, SegmentCount do
        Demon.TailAttachments[Segment + 1] = CreateDemonAttachment(RootPart, "AtramentaDemonTail" .. tostring(Segment), EmptyVector3)
    end
    for Segment = 1, SegmentCount do
        local Alpha0 = (Segment - 1) / SegmentCount
        local Alpha1 = Segment / SegmentCount
        local Width0 = Max(0.035, (0.29 * (1 - Alpha0 * 0.88)) * Demon.TailScale * Demon.TailThickness)
        local Width1 = Max(0.025, (0.29 * (1 - Alpha1 * 0.88)) * Demon.TailScale * Demon.TailThickness)
        local Beam, GlowBeam = CreateDemonBeam(Folder, Demon.TailAttachments[Segment], Demon.TailAttachments[Segment + 1], Width0, Width1, "Tail")
        Beam.Enabled = Demon.Tail == true
        GlowBeam.Enabled = Demon.Tail == true and Demon.TailGlow == true
        Demon.TailBeams[#Demon.TailBeams + 1] = Beam
    end
    local SpikeCount = 8
    for Index = 1, SpikeCount do
        local TailIndex = Clamp(Floor(2 + (Index / (SpikeCount + 1)) * (SegmentCount - 3)), 2, SegmentCount)
        local SpikeAttachment = CreateDemonAttachment(RootPart, "AtramentaDemonSpike" .. tostring(Index), EmptyVector3)
        Demon.SpikeAttachments[Index] = {Attachment = SpikeAttachment, TailIndex = TailIndex}
        local Beam, GlowBeam = CreateDemonBeam(Folder, Demon.TailAttachments[TailIndex], SpikeAttachment, 0.075 * Demon.TailScale * Demon.TailThickness, 0.018, "Spike")
        Beam.Enabled = Demon.Tail == true and Demon.Spikes == true
        GlowBeam.Enabled = Demon.Tail == true and Demon.Spikes == true and Demon.TailGlow == true
        Demon.SpikeBeams[#Demon.SpikeBeams + 1] = Beam
    end
    local SpadeNames = {"Base", "Left", "Right", "Top", "Bottom", "Apex"}
    for Index, Name in ipairs(SpadeNames) do
        Demon.SpadeAttachments[Index] = CreateDemonAttachment(RootPart, "AtramentaDemonSpade" .. Name, EmptyVector3)
    end
    local SpadePairs = {{1, 2}, {2, 6}, {6, 3}, {3, 1}, {4, 6}, {5, 6}}
    for _, Pair in ipairs(SpadePairs) do
        local Beam, GlowBeam = CreateDemonBeam(Folder, Demon.SpadeAttachments[Pair[1]], Demon.SpadeAttachments[Pair[2]],
            0.055 * Demon.TailScale * Demon.TailThickness, 0.032 * Demon.TailScale * Demon.TailThickness, "Spade")
        Beam.Enabled = Demon.Tail == true
        GlowBeam.Enabled = Demon.Tail == true and Demon.TailGlow == true
        Demon.SpadeBeams[#Demon.SpadeBeams + 1] = Beam
    end
end
function UpdateDemonTail(Time)
    local Demon = AtramentaConfig.Visual.Demon
    local Attachments = Demon.TailAttachments
    local SegmentCount = #Attachments - 1
    if SegmentCount < 2 then return end
    local Scale = Demon.TailScale
    local SegmentLength = (Demon.TailLength * Scale) / SegmentCount
    local Speed = Time * Demon.SwaySpeed
    local Sway = Demon.SwayStrength * Scale
    local Position = NewVector3(0, -0.48 * Scale, 0.58 * Scale)
    local Direction = NewVector3(0, -0.34, 0.94).Unit
    local Positions = Table.create(SegmentCount + 1)
    Positions[1] = Position
    Attachments[1].Position = Position
    for Segment = 1, SegmentCount do
        local Alpha = Segment / SegmentCount
        local Side = Sin(Speed - Alpha * 3.45) * (0.14 + Alpha * 0.54) * Sway
        local Vertical = Cos(Speed * 0.82 - Alpha * 2.65) * (0.07 + Alpha * 0.22) * Sway
        local Arch = Sin(Alpha * Pi) * 0.30 * Scale
        local SegmentDirection = (Direction + NewVector3(Side, Vertical + Arch * 0.16, 0)).Unit
        Position += SegmentDirection * SegmentLength
        Positions[Segment + 1] = Position
        Attachments[Segment + 1].Position = Position
    end
    for Index, SpikeData in ipairs(Demon.SpikeAttachments) do
        local TailIndex = Clamp(SpikeData.TailIndex, 2, SegmentCount)
        local PositionIndex = Clamp(TailIndex, 1, #Positions)
        local BasePosition = Positions[PositionIndex]
        local Alpha = PositionIndex / #Positions
        local SideWave = Sin(Speed - Alpha * 3.45)
        local SpikeHeight = Demon.SpikeHeight * Scale * (1 - Alpha * 0.52)
        SpikeData.Attachment.Position = BasePosition + NewVector3(SideWave * 0.05 * Scale, SpikeHeight, -0.03 * Scale)
    end
    local PreviousPosition = Positions[SegmentCount]
    local TipPosition = Positions[SegmentCount + 1]
    local Tangent = TipPosition - PreviousPosition
    if Tangent.Magnitude < 0.001 then
        Tangent = NewVector3(0, 0, 1)
    else
        Tangent = Tangent.Unit
    end
    local Right = NewVector3(1, 0, 0)
    local Up = NewVector3(0, 1, 0)
    local Width = 0.34 * Scale
    local Height = 0.30 * Scale
    local Length = 0.58 * Scale
    local Base = TipPosition - Tangent * 0.05 * Scale
    local Apex = TipPosition + Tangent * Length
    Demon.SpadeAttachments[1].Position = Base
    Demon.SpadeAttachments[2].Position = TipPosition - Right * Width + Up * 0.06 * Scale
    Demon.SpadeAttachments[3].Position = TipPosition + Right * Width + Up * 0.06 * Scale
    Demon.SpadeAttachments[4].Position = TipPosition + Up * Height
    Demon.SpadeAttachments[5].Position = TipPosition - Up * Height * 0.78
    Demon.SpadeAttachments[6].Position = Apex
end
function UpdateDemonCosmetics(DeltaTime)
    local Demon = AtramentaConfig.Visual.Demon
    if not Demon.Enabled then return end
    Demon.RuntimeAccumulator += Clamp(DeltaTime, 0, 0.05)
    if Demon.RuntimeAccumulator < Demon.RuntimeInterval then
        return
    end
    Demon.RuntimeAccumulator = 0
    local Character = LocalPlayer.Character
    if not Character then
        DestroyDemonCosmetics()
        return
    end
    if Demon.Character ~= Character or not Demon.Folder or not Demon.Folder.Parent or not Demon.Head
        or not Demon.Head.Parent or not Demon.RootPart or not Demon.RootPart.Parent then
        CreateDemonCosmetics(Character)
        return
    end
    if Demon.Tail then UpdateDemonTail(Clock()) end
end
function CreateDemonCosmetics(Character)
    local Demon = AtramentaConfig.Visual.Demon
    if not Demon.Enabled or not Character then
        DestroyDemonCosmetics()
        return
    end
    local Head = Character:FindFirstChild("Head")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not Head or not RootPart then
        return
    end
    DestroyDemonCosmetics()
    local Folder = NewInstance("Folder")
    Folder.Name = "AtramentaDemonCosmetics"
    Folder.Parent = Character
    Demon.Folder = Folder
    Demon.Character = Character
    Demon.Head = Head
    Demon.RootPart = RootPart
    if Demon.Horns then BuildDemonHorns(Head, Folder) end
    if Demon.Tail then
        BuildDemonTail(RootPart, Folder)
        UpdateDemonTail(Clock())
    end
    UpdateDemonAppearance()
end
function RebuildDemonCosmetics()
    local Demon = AtramentaConfig.Visual.Demon
    Demon.Enabled = Demon.Horns == true or Demon.Tail == true
    if not Demon.Enabled then DestroyDemonCosmetics() return end
    CreateDemonCosmetics(LocalPlayer.Character)
end
function RefreshDemonRuntime()
    local Demon = AtramentaConfig.Visual.Demon
    Demon.Enabled = Demon.Horns == true or Demon.Tail == true
    if Demon.Enabled then
        if not Demon.Connection then
            Demon.Connection = RunService.Heartbeat:Connect(function(DeltaTime)
                Shared.SafeCall(UpdateDemonCosmetics, DeltaTime)
            end)
        end
        CreateDemonCosmetics(LocalPlayer.Character)
    else
        if Demon.Connection then Shared.SafeDisconnect(Demon.Connection) Demon.Connection = nil end
        DestroyDemonCosmetics()
    end
end
function SetDemonPartEnabled(Part, Value)
    local Demon = AtramentaConfig.Visual.Demon
    if Part == "Horns" then Demon.Horns = Value == true elseif Part == "Tail" then Demon.Tail = Value == true end
    RefreshDemonRuntime()
end
function ToggleDemonCosmetics(Enabled)
    local Value = Enabled == true
    AtramentaConfig.Visual.Demon.Horns = Value
    AtramentaConfig.Visual.Demon.Tail = Value
    RefreshDemonRuntime()
end
function GetAimFOVAnchorPosition(AimMode)
    local CameraObject = Shared.GetCamera()
    local UseMouse = AimMode == "Silent Aim" or AimMode == nil and AtramentaConfig.Aim.SilentEnabled == true and AtramentaConfig.Aim.AimbotEnabled ~= true
    if UseMouse then
        local MousePosition = UserInputService:GetMouseLocation()
        AtramentaConfig.Aim.FOVPosition = MousePosition
        return MousePosition, true
    end
    if CameraObject then
        local CenterPosition = CameraObject.ViewportSize * 0.5
        AtramentaConfig.Aim.FOVPosition = CenterPosition
        return CenterPosition, false
    end
    return AtramentaConfig.Aim.FOVPosition, false
end
function RemoveAimFOVCircle()
    local Objects = {AtramentaConfig.Aim.FOVCircle, AtramentaConfig.Aim.FOVFillCircle}
    for _, Object in ipairs(Objects) do
        if Object then Shared.SafeCall(function() Object.Visible = false Object:Remove() end) end
    end
    for _, GlowCircle in ipairs(AtramentaConfig.Aim.FOVGlowCircles or {}) do
        if GlowCircle then Shared.SafeCall(function() GlowCircle.Visible = false GlowCircle:Remove() end) end
    end
    for _, Line in ipairs(AtramentaConfig.Aim.FOVGradientLines or {}) do
        if Line then Shared.SafeCall(function() Line.Visible = false Line:Remove() end) end
    end
    AtramentaConfig.Aim.FOVCircle = nil
    AtramentaConfig.Aim.FOVFillCircle = nil
    AtramentaConfig.Aim.FOVGlowCircle = nil
    AtramentaConfig.Aim.FOVGlowCircles = {}
    AtramentaConfig.Aim.FOVGradientLines = {}
end
function CreateAimFOVCircle(Color, Thickness, Transparency, Filled)
    return Shared.CreateOverlayPrimitive("Circle", {Visible = false, Color = Color, Filled = Filled == true, Thickness = Max(tonumber(Thickness) or 1, 1),
        Transparency = Clamp(tonumber(Transparency) or 0.72, 0, 1), Radius = AtramentaConfig.Aim.FOV, NumSides = 96})
end
function CreateAimFOVGlow(Position, Visible)
    AtramentaConfig.Aim.FOVGlowCircles = {}
    if not AtramentaConfig.Aim.FOVGlow then return end
    local BaseThickness = Clamp(tonumber(AtramentaConfig.Aim.FOVGlowThickness) or 8, 2, 32)
    local BaseTransparency = Clamp(tonumber(AtramentaConfig.Aim.FOVGlowTransparency) or 0.20, 0, 1)
    local Layers = {{2.15, 0.28}, {1.55, 0.52}, {1.05, 0.82}}
    for Index, Layer in ipairs(Layers) do
        local GlowCircle = CreateAimFOVCircle(AtramentaConfig.Aim.FOVGlowColor, Max(BaseThickness * Layer[1], 1), Clamp(BaseTransparency * Layer[2], 0.01, 1), false)
        if GlowCircle then
            GlowCircle.Position = Position
            GlowCircle.Visible = Visible
            AtramentaConfig.Aim.FOVGlowCircles[Index] = GlowCircle
        end
    end
    AtramentaConfig.Aim.FOVGlowCircle = AtramentaConfig.Aim.FOVGlowCircles[3]
end
function CreateAimFOVGradient()
    AtramentaConfig.Aim.FOVGradientLines = {}
    if AtramentaConfig.Aim.FOVGradient ~= true then return end
    for Index = 1, 72 do
        local Line = Shared.CreateOverlayPrimitive("Line", {Visible = false, Thickness = Clamp(tonumber(AtramentaConfig.Aim.FOVThickness) or 2, 1, 8),
            Transparency = Clamp(tonumber(AtramentaConfig.Aim.FOVGradientTransparency) or 0.72, 0, 1)})
        if Line then AtramentaConfig.Aim.FOVGradientLines[#AtramentaConfig.Aim.FOVGradientLines + 1] = Line end
    end
end
function CreateFOVCircle()
    RemoveAimFOVCircle()
    if not AtramentaConfig.Aim.ShowFOV or not Shared.CheckOverlayCompatibility() then return end
    local Position = GetAimFOVAnchorPosition()
    local Visible = AtramentaConfig.Aim.Enabled and AtramentaConfig.Aim.ShowFOV
    CreateAimFOVGlow(Position, Visible)
    CreateAimFOVGradient()
    local Fill = CreateAimFOVCircle(AtramentaConfig.Aim.FOVFillColor, 1, AtramentaConfig.Aim.FOVFillTransparency, true)
    if Fill then
        Fill.Position = Position
        Fill.Visible = Visible and AtramentaConfig.Aim.FOVFilled == true
        AtramentaConfig.Aim.FOVFillCircle = Fill
    end
    local Circle = CreateAimFOVCircle(AtramentaConfig.Aim.FOVColor, AtramentaConfig.Aim.FOVThickness, AtramentaConfig.Aim.FOVTransparency, false)
    if not Circle then RemoveAimFOVCircle() return end
    Circle.Position = Position
    Circle.Visible = Visible and AtramentaConfig.Aim.FOVGradient ~= true
    AtramentaConfig.Aim.FOVCircle = Circle
end
function UpdateFOVCircle()
    local Circle = AtramentaConfig.Aim.FOVCircle
    if not Circle then return end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then
        Circle.Visible = false
        if AtramentaConfig.Aim.FOVFillCircle then AtramentaConfig.Aim.FOVFillCircle.Visible = false end
        for _, GlowCircle in ipairs(AtramentaConfig.Aim.FOVGlowCircles or {}) do GlowCircle.Visible = false end
        for _, Line in ipairs(AtramentaConfig.Aim.FOVGradientLines or {}) do Line.Visible = false end
        return
    end
    local Position = GetAimFOVAnchorPosition()
    local Visible = AtramentaConfig.Aim.Enabled and AtramentaConfig.Aim.ShowFOV
    local Radius = Clamp(tonumber(AtramentaConfig.Aim.FOV) or 100, 10, 700)
    local Primary = AtramentaConfig.Aim.FOVColor or NewRGB(255, 255, 255)
    local Secondary = AtramentaConfig.Aim.FOVGradientColor or NewRGB(54, 218, 145)
    local Thickness = Clamp(tonumber(AtramentaConfig.Aim.FOVThickness) or 2, 1, 8)
    local Transparency = Clamp(tonumber(AtramentaConfig.Aim.FOVTransparency) or 0.72, 0, 1)
    Circle.Position = Position
    Circle.Radius = Radius
    Circle.Color = Primary
    Circle.Thickness = Thickness
    Circle.Transparency = Transparency
    Circle.Visible = Visible and AtramentaConfig.Aim.FOVGradient ~= true
    local Fill = AtramentaConfig.Aim.FOVFillCircle
    if Fill then
        Fill.Position = Position
        Fill.Radius = Radius
        Fill.Color = AtramentaConfig.Aim.FOVFillColor or Primary
        Fill.Transparency = Clamp(tonumber(AtramentaConfig.Aim.FOVFillTransparency) or 0.10, 0, 1)
        Fill.Visible = Visible and AtramentaConfig.Aim.FOVFilled == true
    end
    if AtramentaConfig.Aim.FOVGlow and #(AtramentaConfig.Aim.FOVGlowCircles or {}) == 0 then CreateFOVCircle() return end
    if AtramentaConfig.Aim.FOVGradient and #(AtramentaConfig.Aim.FOVGradientLines or {}) == 0 then CreateFOVCircle() return end
    local BaseThickness = Clamp(tonumber(AtramentaConfig.Aim.FOVGlowThickness) or 8, 2, 32)
    local BaseTransparency = Clamp(tonumber(AtramentaConfig.Aim.FOVGlowTransparency) or 0.20, 0, 1)
    local Layers = {{2.15, 0.28}, {1.55, 0.52}, {1.05, 0.82}}
    for Index, GlowCircle in ipairs(AtramentaConfig.Aim.FOVGlowCircles or {}) do
        local Layer = Layers[Index] or Layers[#Layers]
        GlowCircle.Position = Position
        GlowCircle.Radius = Radius
        GlowCircle.Color = AtramentaConfig.Aim.FOVGlowColor
        GlowCircle.Thickness = Max(BaseThickness * Layer[1], 1)
        GlowCircle.Transparency = Clamp(BaseTransparency * Layer[2], 0.01, 1)
        GlowCircle.Visible = Visible and AtramentaConfig.Aim.FOVGlow
    end
    local SegmentCount = #(AtramentaConfig.Aim.FOVGradientLines or {})
    if AtramentaConfig.Aim.FOVGradient == true and SegmentCount > 0 then
        local Rotation = tonumber(AtramentaConfig.Aim.FOVGradientRotation) or 0
        if AtramentaConfig.Aim.FOVGradientAnimated == true then Rotation += Clock() * (tonumber(AtramentaConfig.Aim.FOVGradientSpeed) or 45) end
        local RotationRadians = Rad(Rotation % 360)
        local GradientTransparency = Clamp(tonumber(AtramentaConfig.Aim.FOVGradientTransparency) or Transparency, 0, 1)
        for Index = 1, SegmentCount do
            local Line = AtramentaConfig.Aim.FOVGradientLines[Index]
            local T0 = (Index - 1) / SegmentCount
            local T1 = Index / SegmentCount
            local Angle0 = T0 * Pi * 2 + RotationRadians
            local Angle1 = T1 * Pi * 2 + RotationRadians
            Line.From = Position + NewVector2(Cos(Angle0) * Radius, Sin(Angle0) * Radius)
            Line.To = Position + NewVector2(Cos(Angle1) * Radius, Sin(Angle1) * Radius)
            local Wave = 0.5 - 0.5 * Cos(T0 * Pi * 2)
            Line.Color = Primary:Lerp(Secondary, Wave)
            Line.Thickness = Thickness
            Line.Transparency = GradientTransparency
            Line.Visible = Visible
        end
    else
        for _, Line in ipairs(AtramentaConfig.Aim.FOVGradientLines or {}) do Line.Visible = false end
    end
end
