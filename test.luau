        for _, Object in ipairs(CurrentPlayerGui:GetDescendants()) do
            if Object:IsA("BillboardGui") and (Object.Name == "AtramentaWorldSAFE" or Object.Name == "AtramentaWorldCASH" or Object:GetAttribute("AtramentaWorldESP") == true
            ) then
                Shared.SafeCall(function() Object:Destroy() end)
            end
        end
    end
    Visuals.WorldESP.Objects = {}
end
function BindWorldESPEvents()
    DisconnectWorldESPEvents()
    local Connections = Visuals.WorldESP.Connections
    local Map = Workspace:FindFirstChild("Map")
    local Filter = Workspace:FindFirstChild("Filter")
    local SafeFolder = Map and Map:FindFirstChild("BredMakurz")
    local CashFolder = Filter and Filter:FindFirstChild("SpawnedBread")
    local DroppedFolder = Filter and Filter:FindFirstChild("SpawnedTools")
    Visuals.WorldESP.BoundMap = Map
    Visuals.WorldESP.BoundFilter = Filter
    Visuals.WorldESP.BoundSafeFolder = SafeFolder
    Visuals.WorldESP.BoundCashFolder = CashFolder
    Visuals.WorldESP.BoundDroppedFolder = DroppedFolder
    if Visuals.WorldESP.Safes == true and SafeFolder then
        for _, Object in ipairs(SafeFolder:GetChildren()) do TrackWorldESPObject(Object, "SAFE") end
        Connections.SafeAdded = SafeFolder.ChildAdded:Connect(function(Object)
            Defer(TrackWorldESPObject, Object, "SAFE")
        end)
        Connections.SafeRemoved = SafeFolder.ChildRemoved:Connect(RemoveWorldESPObject)
    end
    if Visuals.WorldESP.Cash == true and CashFolder then
        for _, Object in ipairs(CashFolder:GetChildren()) do TrackWorldESPObject(Object, "CASH") end
        Connections.CashAdded = CashFolder.ChildAdded:Connect(function(Object)
            Defer(TrackWorldESPObject, Object, "CASH")
        end)
        Connections.CashRemoved = CashFolder.ChildRemoved:Connect(RemoveWorldESPObject)
    end
    if Visuals.WorldESP.Dropped == true and DroppedFolder then
        for _, Object in ipairs(DroppedFolder:GetChildren()) do TrackWorldESPObject(Object, "DROPPED") end
        Connections.DroppedAdded = DroppedFolder.ChildAdded:Connect(function(Object)
            Defer(TrackWorldESPObject, Object, "DROPPED")
        end)
        Connections.DroppedRemoved = DroppedFolder.ChildRemoved:Connect(RemoveWorldESPObject)
    end
    if Map then
        Connections.MapChildAdded = Map.ChildAdded:Connect(function(Object)
            if Object.Name == "BredMakurz" and Visuals.WorldESP.Safes == true then Defer(BindWorldESPEvents) end
        end)
        Connections.MapChildRemoved = Map.ChildRemoved:Connect(function(Object)
            if Object == Visuals.WorldESP.BoundSafeFolder or Object.Name == "BredMakurz" then Defer(BindWorldESPEvents) end
        end)
    end
    if Filter then
        Connections.FilterChildAdded = Filter.ChildAdded:Connect(function(Object)
            if Object.Name == "SpawnedBread" and Visuals.WorldESP.Cash == true then Defer(BindWorldESPEvents) end
            if Object.Name == "SpawnedTools" and Visuals.WorldESP.Dropped == true then Defer(BindWorldESPEvents) end
        end)
        Connections.FilterChildRemoved = Filter.ChildRemoved:Connect(function(Object)
            if Object == Visuals.WorldESP.BoundCashFolder or Object.Name == "SpawnedBread" then Defer(BindWorldESPEvents) end
            if Object == Visuals.WorldESP.BoundDroppedFolder or Object.Name == "SpawnedTools" then Defer(BindWorldESPEvents) end
        end)
    end
    Connections.WorkspaceAdded = Workspace.ChildAdded:Connect(function(Object)
        if Object.Name == "Map" or Object.Name == "Filter" then Defer(BindWorldESPEvents) end
    end)
    Connections.WorkspaceRemoved = Workspace.ChildRemoved:Connect(function(Object)
        if Object == Visuals.WorldESP.BoundMap or Object == Visuals.WorldESP.BoundFilter or Object.Name == "Map" or Object.Name == "Filter" then Defer(BindWorldESPEvents) end
    end)
end
function RefreshWorldESPStyles(Kind)
    local Objects = {}
    for Object, Data in pairs(Visuals.WorldESP.Objects) do
        if not Kind or (Data and Data.Kind == Kind) then Objects[#Objects + 1] = Object end
    end
    for Index = 1, #Objects do RefreshWorldESPEntry(Objects[Index], true) end
end
function RefreshWorldESP(Force)
    if Visuals.WorldESP.Safes ~= true then ClearWorldESPKind("SAFE") end
    if Visuals.WorldESP.Cash ~= true then ClearWorldESPKind("CASH") end
    if Visuals.WorldESP.Dropped ~= true then ClearWorldESPKind("DROPPED") end
    if Visuals.WorldESP.Safes == true or Visuals.WorldESP.Cash == true or Visuals.WorldESP.Dropped == true then
        BindWorldESPEvents()
        StartWorldESPRepair()
        UpdateWorldESP(Force == true)
    else
        StopWorldESPRepair()
        DisconnectWorldESPEvents()
        if next(Visuals.WorldESP.Objects) then ClearWorldESPKind(nil) end
    end
end
function UpdateWorldESP(Force)
    if Visuals.WorldESP.Safes ~= true and Visuals.WorldESP.Cash ~= true and Visuals.WorldESP.Dropped ~= true then return end
    local Map = Workspace:FindFirstChild("Map")
    local Filter = Workspace:FindFirstChild("Filter")
    local SafeFolder = Map and Map:FindFirstChild("BredMakurz")
    local CashFolder = Filter and Filter:FindFirstChild("SpawnedBread")
    local DroppedFolder = Filter and Filter:FindFirstChild("SpawnedTools")
    if Map ~= Visuals.WorldESP.BoundMap or Filter ~= Visuals.WorldESP.BoundFilter
        or SafeFolder ~= Visuals.WorldESP.BoundSafeFolder or CashFolder ~= Visuals.WorldESP.BoundCashFolder or DroppedFolder ~= Visuals.WorldESP.BoundDroppedFolder then
        BindWorldESPEvents()
        return
    end
    if Visuals.WorldESP.Safes == true and SafeFolder then
        for _, Object in ipairs(SafeFolder:GetChildren()) do TrackWorldESPObject(Object, "SAFE") end
    end
    if Visuals.WorldESP.Cash == true and CashFolder then
        for _, Object in ipairs(CashFolder:GetChildren()) do TrackWorldESPObject(Object, "CASH") end
    end
    if Visuals.WorldESP.Dropped == true and DroppedFolder then
        for _, Object in ipairs(DroppedFolder:GetChildren()) do TrackWorldESPObject(Object, "DROPPED") end
    end
    local RemoveList = {}
    local RefreshList = {}
    for Object, Data in pairs(Visuals.WorldESP.Objects) do
        local Kind = Data and Data.Kind
        local Valid = Object and Object.Parent and Data and Data.Billboard and Data.Billboard.Parent and Data.Label and Data.Label.Parent
        if Valid and Kind == "SAFE" then
            Valid = Visuals.WorldESP.Safes == true and SafeFolder ~= nil and Object.Parent == SafeFolder and IsWorldSafeObject(Object)
        elseif Valid and Kind == "CASH" then
            Valid = Visuals.WorldESP.Cash == true and CashFolder ~= nil and Object.Parent == CashFolder
        elseif Valid and Kind == "DROPPED" then
            Valid = Visuals.WorldESP.Dropped == true and DroppedFolder ~= nil and Object.Parent == DroppedFolder
        else
            Valid = false
        end
        if Valid then
            RefreshList[#RefreshList + 1] = Object
        else
            RemoveList[#RemoveList + 1] = Object
        end
    end
    for Index = 1, #RemoveList do RemoveWorldESPObject(RemoveList[Index]) end
    for Index = 1, #RefreshList do RefreshWorldESPEntry(RefreshList[Index], Force == true) end
end
