function EncodeAvatarChangerURL(Value)
    return tostring(Value or ""):gsub("\n", "\r\n"):gsub("([^%w%-_%.~])",
        function(Character)
            return Format("%%%02X", StringByte(Character))
        end)
end

function ResolveAvatarChangerUserID(Query)
    Query = tostring(Query or "") :gsub("^%s+", "") :gsub("%s+$", "") :gsub("^@", "")
    if Query == "" then
        return nil, nil, nil, "empty"
    end
    local NumericId = tonumber(Query)
    if NumericId and NumericId >= 1 and NumericId == Floor(NumericId) then
        local Name
        local Success, Result = Shared.SafeCall(Players.GetNameFromUserIdAsync, Players, NumericId)
        if Success and type(Result) == "string" then Name = Result end
        return NumericId, Name, nil, nil
    end
    local QueryLower = Lower(Query)
    for _, PlayerObject in ipairs(Players:GetPlayers()) do
        if Lower(PlayerObject.Name) == QueryLower or Lower(PlayerObject.DisplayName) == QueryLower then
            return PlayerObject.UserId, PlayerObject.Name, PlayerObject.DisplayName, nil
        end
    end
    local UsernameSuccess, UsernameId = Shared.SafeCall(Players.GetUserIdFromNameAsync, Players, Query)
    if UsernameSuccess and type(UsernameId) == "number" and UsernameId >= 1 then
        return UsernameId, Query, nil, nil
    end
    local Url = "https://users.roblox.com/v1/users/search?keyword=" .. EncodeAvatarChangerURL(Query) .. "&limit=10"
    local HttpSuccess, Body = Shared.SafeCall(function()
            return Game:HttpGet(Url)
        end)
    if not HttpSuccess or type(Body) ~= "string" or Body == "" then
        return nil, nil, nil, "lookup failed"
    end
    local DecodeSuccess, Decoded = Shared.SafeCall(function()
            return GetService(Game, "HttpService"):JSONDecode(Body)
        end)
    if not DecodeSuccess or type(Decoded) ~= "table" or type(Decoded.data) ~= "table" or #Decoded.data <= 0 then
        return nil, nil, nil, "not found"
    end
    local Best
    local BestScore = -1
    for Index, Entry in ipairs(Decoded.data) do
        if type(Entry) == "table" and tonumber(Entry.id) and tonumber(Entry.id) >= 1 then
            local Name = tostring(Entry.name or "")
            local DisplayName = tostring(Entry.displayName or "")
            local Score = 0
            if QueryLower(Name) == QueryLower then
                Score = 400
            elseif QueryLower(DisplayName) == QueryLower then
                Score = 300
            elseif StringFind(QueryLower(Name), QueryLower, 1, true) == 1 then
                Score = 200
            elseif StringFind(QueryLower(DisplayName), QueryLower, 1, true) == 1 then
                Score = 150
            else
                Score = Max(100 - Index, 1)
            end
            if Score > BestScore then
                BestScore = Score
                Best = Entry
            end
        end
    end
    if not Best then
        return nil, nil, nil, "not found"
    end
    return tonumber(Best.id), tostring(Best.name or ""), tostring(Best.displayName or ""), nil
end

function GetAvatarDescription(UserId)
    UserId = tonumber(UserId)
    if not UserId or UserId < 1 then
        return nil
    end
    local Cached = AvatarChangerState.DescriptionCache[UserId]
    if typeof(Cached) == "Instance" and Cached:IsA("HumanoidDescription") then
        return Cached:Clone()
    end
    local Success, Description
    if type(Players.GetHumanoidDescriptionFromUserIdAsync) == "function" then
        Success, Description = Shared.SafeCall(Players.GetHumanoidDescriptionFromUserIdAsync, Players, UserId)
    end
    if not Success or typeof(Description) ~= "Instance" or not Description:IsA("HumanoidDescription") then
        Success, Description = Shared.SafeCall(Players.GetHumanoidDescriptionFromUserId, Players, UserId)
    end
    if not Success or typeof(Description) ~= "Instance" or not Description:IsA("HumanoidDescription") then
        return nil
    end
    AvatarChangerState.DescriptionCache[UserId] = Description
    return Description:Clone()
end

function AvatarChangerIsManagedObject(Object)
    if not Object then return false end
    return Object:IsA("Accessory") or Object:IsA("Shirt") or Object:IsA("Pants") or Object:IsA("ShirtGraphic") or Object:IsA("BodyColors") or Object:IsA("CharacterMesh")
end

function AvatarChangerCaptureOriginal(Character, Humanoid)
    if not Character or not Character.Parent then return nil end
    local Existing = AvatarChangerState.OriginalDescriptions[Character]
    if type(Existing) == "table" and Existing.Captured == true then return Existing end
    local Snapshot = {Captured = true, Objects = {}, FaceObjects = {}, HeadMeshes = {}}
    for _, Object in ipairs(Character:GetChildren()) do
        if AvatarChangerIsManagedObject(Object) then
            local Success, Clone = Shared.SafeCall(Object.Clone, Object)
            if Success and typeof(Clone) == "Instance" then Snapshot.Objects[#Snapshot.Objects + 1] = Clone end
        end
    end
    local Head = Character:FindFirstChild("Head")
    if Head and Head:IsA("BasePart") then
        for _, Object in ipairs(Head:GetChildren()) do
            local LowerName = Lower(tostring(Object.Name or ""))
            if Object:IsA("Decal") or Object:IsA("Texture") or Object:IsA("SpecialMesh") or Object:IsA("SurfaceAppearance") then
                local Success, Clone = Shared.SafeCall(Object.Clone, Object)
                if Success and typeof(Clone) == "Instance" then
                    if Object:IsA("Decal") then
                        Snapshot.FaceObjects[#Snapshot.FaceObjects + 1] = Clone
                    else
                        Snapshot.HeadMeshes[#Snapshot.HeadMeshes + 1] = Clone
                    end
                end
            end
        end
    end
    local Success, Description = Shared.SafeCall(Humanoid.GetAppliedDescription, Humanoid)
    if Success and typeof(Description) == "Instance" and Description:IsA("HumanoidDescription") then Snapshot.Description = Description:Clone() end
    AvatarChangerState.OriginalDescriptions[Character] = Snapshot
    return Snapshot
end

function AvatarChangerClearAppearance(Character)
    if not Character then return end
    for _, Object in ipairs(Character:GetChildren()) do
        if AvatarChangerIsManagedObject(Object) then Shared.SafeCall(Object.Destroy, Object) end
    end
    local Head = Character:FindFirstChild("Head")
    if Head and Head:IsA("BasePart") then
        for _, Object in ipairs(Head:GetChildren()) do
            local LowerName = Lower(tostring(Object.Name or ""))
            if Object:IsA("Decal") or Object:IsA("Texture") or Object:IsA("SpecialMesh") or Object:IsA("SurfaceAppearance") then Shared.SafeCall(Object.Destroy, Object) end
        end
    end
end

function AvatarChangerCopyRigAttachments(Character, SourceModel)
    if not Character or not SourceModel then return end
    for _, SourcePart in ipairs(SourceModel:GetDescendants()) do
        if SourcePart:IsA("BasePart") then
            local RealPart = Character:FindFirstChild(SourcePart.Name)
            if RealPart and RealPart:IsA("BasePart") and RealPart.Parent == Character then
                for _, Child in ipairs(SourcePart:GetChildren()) do
                    if Child:IsA("Attachment") then
                        local Existing = RealPart:FindFirstChild(Child.Name)
                        if not Existing or not Existing:IsA("Attachment") then
                            local Success, Clone = Shared.SafeCall(Child.Clone, Child)
                            if Success and typeof(Clone) == "Instance" then
                                Shared.SafeCall(function() Clone:SetAttribute("AtramentaAvatarAttachment", true) end)
                                Clone.Parent = RealPart
                            end
                        end
                    end
                end
            end
        end
    end
end

function AvatarChangerFindBodyAttachment(Character, Accessory, HandleAttachment)
    if not Character then
        return nil
    end
    local AttachmentName = HandleAttachment and HandleAttachment.Name or ""
    if AttachmentName ~= "" then
        for _, Candidate
            in ipairs(Character:GetDescendants()) do
            if Candidate:IsA("Attachment") and Candidate.Name == AttachmentName and not Candidate:IsDescendantOf(Accessory) then
                local Parent = Candidate.Parent
                if Parent and Parent:IsA("BasePart") then
                    return Candidate
                end
            end
        end
    end
    local AttachmentNameLower = Lower(AttachmentName)
    local PreferredPart
    if StringFind(AttachmentNameLower, "hair", 1, true) or StringFind(AttachmentNameLower, "hat", 1, true) or StringFind(AttachmentNameLower, "face", 1, true) then
        PreferredPart = "Head"
    elseif StringFind(AttachmentNameLower, "leftshoulder", 1, true) or StringFind(AttachmentNameLower, "leftcollar", 1, true) then
        PreferredPart = Character:FindFirstChild("Left Arm") and "Left Arm" or "LeftUpperArm"
    elseif StringFind(AttachmentNameLower, "rightshoulder", 1, true) or StringFind(AttachmentNameLower, "rightcollar", 1, true) then
        PreferredPart = Character:FindFirstChild("Right Arm") and "Right Arm" or "RightUpperArm"
    elseif StringFind(AttachmentNameLower, "waist", 1, true) or StringFind(AttachmentNameLower, "body", 1, true) or StringFind(AttachmentNameLower, "back", 1, true)
        or StringFind(AttachmentNameLower, "front", 1, true) or StringFind(AttachmentNameLower, "neck", 1, true) then
        PreferredPart = Character:FindFirstChild("Torso") and "Torso" or "UpperTorso"
    end
    if not PreferredPart and Accessory then
        local AccessoryType = Accessory.AccessoryType
        if AccessoryType == Enum.AccessoryType.Hair or AccessoryType == Enum.AccessoryType.Hat or AccessoryType == Enum.AccessoryType.Face
            or AccessoryType == Enum.AccessoryType.Eyebrow or AccessoryType == Enum.AccessoryType.Eyelash then
            PreferredPart = "Head"
        elseif AccessoryType == Enum.AccessoryType.Shoulder then
            PreferredPart = Character:FindFirstChild("Torso") and "Torso" or "UpperTorso"
        elseif AccessoryType == Enum.AccessoryType.Neck or AccessoryType == Enum.AccessoryType.Front or AccessoryType == Enum.AccessoryType.Back
            or AccessoryType == Enum.AccessoryType.Waist then
            PreferredPart = Character:FindFirstChild("Torso") and "Torso" or "UpperTorso"
        end
    end
    local Part = PreferredPart and Character:FindFirstChild(PreferredPart)
    if not Part or not Part:IsA("BasePart") then
        Part = Character:FindFirstChild("Head") or Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("HumanoidRootPart")
    end
    if not Part or not Part:IsA("BasePart") then
        return nil
    end
    return Part
end

function AvatarChangerEnsureAccessoryWeld(Character, Accessory)
    if not Character or not Accessory or not Accessory:IsA("Accessory") then
        return false
    end
    local Handle = Accessory:FindFirstChild("Handle")
    if not Handle or not Handle:IsA("BasePart") then
        return false
    end
    Handle.CanCollide = false
    Handle.Massless = true
    if Handle:FindFirstChildOfClass("WrapLayer") then
        return true
    end
    local ExistingWeld = Handle:FindFirstChild("AccessoryWeld")
    if ExistingWeld and (ExistingWeld:IsA("Weld") or ExistingWeld:IsA("WeldConstraint")) then
        local Part1 = ExistingWeld:IsA("Weld") and ExistingWeld.Part1 or ExistingWeld.Part1
        if Part1 and Part1:IsDescendantOf(Character) then
            return true
        end
        Shared.SafeCall(ExistingWeld.Destroy, ExistingWeld)
    end
    local FirstHandleAttachment
    for _, HandleAttachment
        in ipairs(Handle:GetChildren()) do
        if HandleAttachment:IsA("Attachment") then
            FirstHandleAttachment = FirstHandleAttachment or HandleAttachment
            local BodyAttachment = AvatarChangerFindBodyAttachment(Character, Accessory, HandleAttachment)
            if BodyAttachment and BodyAttachment:IsA("Attachment") then
                local BodyPart = BodyAttachment.Parent
                if BodyPart and BodyPart:IsA("BasePart") then
                    local Weld = NewInstance("Weld")
                    Weld.Name = "AccessoryWeld"
                    Weld.Part0 = Handle
                    Weld.Part1 = BodyPart
                    Weld.C0 = HandleAttachment.CFrame
                    Weld.C1 = BodyAttachment.CFrame
                    Weld.Parent = Handle
                    return true
                end
            end
        end
    end
    return false
end

function AvatarChangerCloneIntoCharacter(Character, Humanoid, Object)
    if not Character or not Humanoid or not Object then return false end
    local Success, Clone = Shared.SafeCall(Object.Clone, Object)
    if not Success or typeof(Clone) ~= "Instance" then return false end
    Shared.SafeCall(function() Clone:SetAttribute("AtramentaAvatarChanger", true) end)
    if Clone:IsA("Accessory") then
        local Added = Shared.SafeCall(function() Humanoid:AddAccessory(Clone) end)
        if not Clone.Parent then Clone.Parent = Character end
        AvatarChangerEnsureAccessoryWeld(Character, Clone)
        Defer(function()
            if Clone and Clone.Parent == Character then AvatarChangerEnsureAccessoryWeld(Character, Clone) end
        end)
    else
        Clone.Parent = Character
    end
    return true
end

function AvatarChangerBuildTemplate(Description, RigType)
    if typeof(Description) ~= "Instance" or not Description:IsA("HumanoidDescription") then
        return nil
    end
    RigType = RigType == Enum.HumanoidRigType.R15 and Enum.HumanoidRigType.R15 or Enum.HumanoidRigType.R6
    local Success, Model
    if type(Players.CreateHumanoidModelFromDescriptionAsync) == "function" then
        Success, Model = Shared.SafeCall(function()
                return Players:CreateHumanoidModelFromDescriptionAsync(Description, RigType)
            end)
    end
    if not Success or typeof(Model) ~= "Instance" or not Model:IsA("Model") then
        Success, Model = Shared.SafeCall(function()
                return Players:CreateHumanoidModelFromDescription(Description, RigType)
            end)
    end
    if Success and typeof(Model) == "Instance" and Model:IsA("Model") then
        return Model
    end
    return nil
end

