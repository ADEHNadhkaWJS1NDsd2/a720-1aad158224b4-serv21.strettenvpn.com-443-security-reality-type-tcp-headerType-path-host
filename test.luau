function CombatLogRuntime.BindLibraryNotice(Notice)
    if typeof(Notice) == "Instance" then
        Notice:SetAttribute("AtramentaCombatLog", true)
        CombatLogRuntime.LibraryNotices[Notice] = true
    end
    CombatLogRuntime.ApplyLogLayout()
    return Notice
end
function CombatLogRuntime.ClearVisualLogs()
    for Notice in pairs(CombatLogRuntime.LibraryNotices) do
        CombatLogRuntime.LibraryNotices[Notice] = nil
        if Notice and Notice.Parent and Notice:GetAttribute("AtramentaCombatLog") == true then Notice:Destroy() end
    end
end
function CombatLogRuntime.MaintainRuntime(CurrentTime, Force)
    CurrentTime = tonumber(CurrentTime) or Clock()
    if Force ~= true and CurrentTime < (tonumber(CombatLogRuntime.NextMaintenance) or 0) then return end
    CombatLogRuntime.NextMaintenance = CurrentTime + (tonumber(CombatLogRuntime.MaintenanceInterval) or 1.25)
    for Index = #CombatLogRuntime.RecentEnemyShots, 1, -1 do
        local Entry = CombatLogRuntime.RecentEnemyShots[Index]
        local ReferenceTime = Entry and Max(tonumber(Entry.Time) or 0, tonumber(Entry.ExpectedAt) or 0) or 0
        if not Entry or CurrentTime - ReferenceTime > 1.50 then Remove(CombatLogRuntime.RecentEnemyShots, Index) end
    end
    while #CombatLogRuntime.RecentEnemyShots > 48 do Remove(CombatLogRuntime.RecentEnemyShots, 1) end
    for Key, LoggedAt in pairs(CombatLogRuntime.IncomingRecentShots) do
        if CurrentTime - (tonumber(LoggedAt) or 0) > 2 then CombatLogRuntime.IncomingRecentShots[Key] = nil end
    end
    for Player, Buffered in pairs(AttackConfirmationState.BufferedDamage) do
        if not Buffered or CurrentTime >= (tonumber(Buffered.ExpiresAt) or ((tonumber(Buffered.Time) or 0) + AttackConfirmationState.SignalWindow)) then
            AttackConfirmationState.BufferedDamage[Player] = nil
        end
    end
    for Notice in pairs(CombatLogRuntime.LibraryNotices) do
        if not Notice or not Notice.Parent then CombatLogRuntime.LibraryNotices[Notice] = nil end
    end
end
function CombatLogRuntime.ProcessEnemyShotQueue(CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Queue = CombatLogRuntime.EnemyShotQueue
    if CombatLogState.Enabled ~= true or CombatLogState.Incoming ~= true then
        if #Queue > 0 then Clear(Queue) end
        return
    end
    local Processed = 0
    for Index = #Queue, 1, -1 do
        if Processed >= 12 then break end
        local Entry = Queue[Index]
        if not Entry or CurrentTime >= (tonumber(Entry.Due) or 0) then
            Remove(Queue, Index)
            Processed += 1
            local Object = Entry and Entry.Object
            if Object and Object.Parent then
                if Entry.IsBeam then
                    local Attachment0, Attachment1 = Object.Attachment0, Object.Attachment1
                    if Attachment0 and Attachment1 then
                        local Origin, EndPosition = Attachment0.WorldPosition, Attachment1.WorldPosition
                        if (EndPosition - Origin).Magnitude >= 2 then
                            local Player = CombatLogRuntime.ResolveEnemyShotSource(Origin, Object)
                            if Player then CombatLogRuntime.RecordEnemyShot(Player, Origin, EndPosition, Object) end
                        end
                    end
                elseif Object:IsA("BasePart") and typeof(Entry.StartPosition) == "Vector3" then
                    local EndPosition = Object.Position
                    if (EndPosition - Entry.StartPosition).Magnitude >= 1 then
                        local Player = CombatLogRuntime.ResolveEnemyShotSource(Entry.StartPosition, Object)
                        if Player then CombatLogRuntime.RecordEnemyShot(Player, Entry.StartPosition, EndPosition, Object) end
                    end
                end
            end
        end
    end
end
function CombatLogRuntime.FlushLogQueue()
    if CombatLogRuntime.LogWorkerRunning == true then return end
    CombatLogRuntime.LogWorkerRunning = true
    Spawn(function()
        local Processed = 0
        while CombatLogRuntime.LogQueueHead <= CombatLogRuntime.LogQueueTail do
            local Head = CombatLogRuntime.LogQueueHead
            local Entry = CombatLogRuntime.LogQueue[Head]
            CombatLogRuntime.LogQueue[Head] = nil
            CombatLogRuntime.LogQueueHead = Head + 1
            if Entry and Library then
                local SetIdentity = type(setthreadidentity) == "function" and setthreadidentity or type(setidentity) == "function" and setidentity or nil
                if SetIdentity then Shared.SafeCall(SetIdentity, 8) end
                local Success, Notice = Shared.SafeCall(function()
                    if type(Library.CombatLogNotification) == "function" then
                        return Library:CombatLogNotification({Title = Entry.Title, Description = Entry.Description, Duration = CombatLogState.Duration, Position = CombatLogState.Position, Scale = CombatLogState.Scale, MaximumVisible = CombatLogState.MaximumVisible})
                    elseif type(Library.Notification) == "function" then
                        return Library:Notification({Title = Entry.Title, Description = Entry.Description, Duration = CombatLogState.Duration, MaximumVisible = CombatLogState.MaximumVisible})
                    end
                end)
                if Success then CombatLogRuntime.BindLibraryNotice(Notice) end
            end
            Processed += 1
            if Processed >= 8 then
                Processed = 0
                Wait()
            end
        end
        Clear(CombatLogRuntime.LogQueue)
        CombatLogRuntime.LogQueueHead = 1
        CombatLogRuntime.LogQueueTail = 0
        CombatLogRuntime.LogWorkerRunning = false
    end)
end
function CombatLogRuntime.Emit(Kind, Message, Detail)
    if CombatLogState.Enabled ~= true then return end
    Kind = tostring(Kind or "log")
    if (Kind == "Hit" or Kind == "Kill") and CombatLogState.Hits ~= true then return end
    if Kind == "Miss" and CombatLogState.Misses ~= true then return end
    if Kind == "Damage" and CombatLogState.Incoming ~= true then return end
    if not Library or type(Library.CombatLogNotification) ~= "function" and type(Library.Notification) ~= "function" then return end
    local Description = tostring(Message or "")
    if tostring(Detail or "") ~= "" then Description = Description .. "  ·  " .. tostring(Detail) end
    local Tail = (tonumber(CombatLogRuntime.LogQueueTail) or 0) + 1
    CombatLogRuntime.LogQueueTail = Tail
    CombatLogRuntime.LogQueue[Tail] = {Title = Lower(Kind), Description = Description}
    local Head = tonumber(CombatLogRuntime.LogQueueHead) or 1
    while Tail - Head + 1 > 128 do
        CombatLogRuntime.LogQueue[Head] = nil
        Head += 1
    end
    CombatLogRuntime.LogQueueHead = Head
    CombatLogRuntime.FlushLogQueue()
end
function CombatLogRuntime.GetShotTargetPart(Shot)
    if type(Shot) ~= "table" or not Shot.Player then return nil, nil end
    local Character = ResolveTrackedCharacter(Shot.Player, Shot.Character)
    if not Character then return nil, nil end
    local Part = Shot.PartName and Character:FindFirstChild(Shot.PartName, true) or nil
    if not Part or not Part:IsA("BasePart") then
        Part = Character:FindFirstChild("HumanoidRootPart", true) or Character:FindFirstChild("Head", true) or Character.PrimaryPart
    end
    return Character, Part
end
function CombatLogRuntime.GetWeaponRange(Tool)
    if not Tool then return nil end
    if type(GetBulletTracerWeaponInfo) == "function" then
        local Data = GetBulletTracerWeaponInfo(Tool)
        if type(Data) == "table" then
            local Range = tonumber(Data.Range)
            if Range and Range > 0 then return Range end
        end
    end
    return nil
end
function CombatLogRuntime.GetPointSegmentDistance(Point, StartPosition, EndPosition)
    if typeof(Point) ~= "Vector3" or typeof(StartPosition) ~= "Vector3" or typeof(EndPosition) ~= "Vector3" then return Infinite, StartPosition, 0 end
    local Segment = EndPosition - StartPosition local LengthSquared = Segment:Dot(Segment)
    if LengthSquared <= 0.0001 then return (Point - StartPosition).Magnitude, StartPosition, 0 end
    local Alpha = Clamp((Point - StartPosition):Dot(Segment) / LengthSquared, 0, 1) local Closest = StartPosition + Segment * Alpha
    return (Point - Closest).Magnitude, Closest, Alpha
end
function CombatLogRuntime.GetPreferredBodyParts(Character)
    if not Character then return {} end
    local CurrentTime = Clock()
    local Cached = CombatLogRuntime.BodyPartCache[Character]
    if type(Cached) == "table" and CurrentTime
            < (tonumber(Cached.RefreshAt) or 0) and type(Cached.Parts) == "table" then
        return Cached.Parts
    end
    local PreferredNames = {Head = true, HumanoidRootPart = true, UpperTorso = true, LowerTorso = true, Torso = true, ["Left Arm"] = true,
        ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true, LeftUpperArm = true, RightUpperArm = true, LeftLowerArm = true,
        RightLowerArm = true, LeftUpperLeg = true, RightUpperLeg = true, LeftLowerLeg = true, RightLowerLeg = true}
    local Parts = {}
    for _, Part in ipairs(Character:GetDescendants()) do
        if Part:IsA("BasePart") and PreferredNames[Part.Name] then Parts[#Parts + 1] = Part end
    end
    CombatLogRuntime.BodyPartCache[Character] = {Parts = Parts, RefreshAt = CurrentTime + 1}
    return Parts
end
function CombatLogRuntime.GetClosestBodyPartToSegment(Character, StartPosition, EndPosition)
    if not Character then return nil, Infinite, 0 end
    local BestPart, BestDistance, BestProjection = nil, Infinite, 0
    for _, Part in ipairs(CombatLogRuntime.GetPreferredBodyParts(Character)) do
        if Part and Part.Parent then
            local CenterDistance, _, Projection = CombatLogRuntime.GetPointSegmentDistance(Part.Position, StartPosition, EndPosition)
            local Radius = Max(Min(Part.Size.X, Part.Size.Y, Part.Size.Z) * 0.42, 0.22) local SurfaceDistance = Max(CenterDistance - Radius, 0)
            if SurfaceDistance < BestDistance then
                BestPart = Part
                BestDistance = SurfaceDistance
                BestProjection = Projection
            end
        end
    end
    return BestPart, BestDistance, BestProjection
end
function CombatLogRuntime.BindEnemyWeaponTracking(Player, Character)
    if CombatLogState.Enabled ~= true or CombatLogState.Incoming ~= true then return end
    if not Player or Player == LocalPlayer then return end
    Character = ResolveTrackedCharacter(Player, Character or Player.Character)
    if not Character then return end
    local Existing = CombatLogRuntime.EnemyWeaponConnections[Player]
    if type(Existing) == "table" and Existing.Character == Character then return end
    if type(Existing) == "table" then
        if Existing.Added then Shared.SafeDisconnect(Existing.Added) end
        if Existing.Removed then Shared.SafeDisconnect(Existing.Removed) end
    end
    for _, Child in ipairs(Character:GetChildren()) do
        if Child:IsA("Tool") then CombatLogRuntime.RememberEnemyWeapon(Player, Child, nil, "Equipped") end
    end
    local Bucket = {Character = Character}
    Bucket.Added = Character.ChildAdded:Connect(function(Child)
        if Child:IsA("Tool") then CombatLogRuntime.RememberEnemyWeapon(Player, Child, nil, "Equipped") end
    end)
    Bucket.Removed = Character.ChildRemoved:Connect(function(Child)
        if Child:IsA("Tool") then CombatLogRuntime.RememberEnemyWeapon(Player, Child, nil, "Unequipped") end
    end)
    CombatLogRuntime.EnemyWeaponConnections[Player] = Bucket
end
function CombatLogRuntime.ClearEnemyWeaponTracking()
    for Player, Bucket in pairs(CombatLogRuntime.EnemyWeaponConnections) do
        if type(Bucket) == "table" then
            if Bucket.Added then Shared.SafeDisconnect(Bucket.Added) end
            if Bucket.Removed then Shared.SafeDisconnect(Bucket.Removed) end
        end
        CombatLogRuntime.EnemyWeaponConnections[Player] = nil
    end
end
function CombatLogRuntime.RecordEnemyVisualizeShot(Shooter, ShotId, WeaponConfig, Weapon, VisibilityOverride, Origin, Directions, ExtraData)
    if CombatLogState.Enabled ~= true or CombatLogState.Incoming ~= true then return end
    if typeof(Shooter) ~= "Instance" or not Shooter:IsA("Player") or Shooter == LocalPlayer then return end
    if typeof(Origin) ~= "Vector3" or type(Directions) ~= "table" then return end
    local Character = LocalPlayer.Character
    if not Character then return end
    local Range = type(WeaponConfig) == "table" and tonumber(rawget(WeaponConfig, "Range")) or nil
    Range = Clamp(Range or 1200, 25, 20000)
    local BulletSettings = type(WeaponConfig) == "table" and rawget(WeaponConfig, "BulletSettings") or nil
    local Speed = type(BulletSettings) == "table" and tonumber(rawget(BulletSettings, "Velocity")) or nil
    if Speed and Speed > 0 then Speed *= 1.5 end
    local WeaponName = CombatLogRuntime.RememberEnemyWeapon(Shooter, Weapon, WeaponConfig, "Bullet") or CombatLogRuntime.GetWeaponName(Weapon, Shooter, "Bullet")
    local CurrentTime = Clock()
    CombatLogRuntime.BindEnemyWeaponTracking(Shooter, Shooter.Character)
    for Index, Direction in pairs(Directions) do
        if typeof(Direction) == "Vector3" and Direction.Magnitude > 0.001 then
            local Unit = Direction.Unit
            local EndPosition = Origin + Unit * Range
            local Part, MissDistance, Projection = CombatLogRuntime.GetClosestBodyPartToSegment(Character, Origin, EndPosition)
            if Part and Projection >= 0 and Projection <= 1 and MissDistance <= Max(CombatLogRuntime.IncomingShotRadius * 1.75, 6) then
                local TravelDistance = Range * Projection
                local ExpectedAt = CurrentTime
                if Speed and Speed > 1 then ExpectedAt = CurrentTime + TravelDistance / Speed end
                local ShotEntry = {Time = CurrentTime, ExpectedAt = ExpectedAt, Player = Shooter, Tool = Weapon, WeaponName = WeaponName, WeaponConfig = WeaponConfig,
                    ShotId = ShotId, BulletIndex = Index, Origin = Origin, EndPosition = EndPosition, Part = Part, MissDistance = MissDistance, Projection = Projection,
                    SourceObject = Weapon, SourceType = "Bullet", DirectVisualize = true, DamageConfirmed = false, Consumed = false}
                CombatLogRuntime.RecentEnemyShots[#CombatLogRuntime.RecentEnemyShots + 1] = ShotEntry
            end
        end
    end
    while #CombatLogRuntime.RecentEnemyShots > 64 do Remove(CombatLogRuntime.RecentEnemyShots, 1) end
end

function CombatLogRuntime.ResolvePlayerFromObject(Object)
    local Current = Object
    while Current and Current ~= workspace do
        if Current:IsA("Model") then
            local Player = Players:GetPlayerFromCharacter(Current)
            if Player then return Player end
            local Named = Players:FindFirstChild(Current.Name)
            if Named and Named:IsA("Player") then return Named end
        end
        Current = Current.Parent
    end
    return nil
end
function CombatLogRuntime.FindNearestEnemyToPosition(Position, MaximumDistance)
    if typeof(Position) ~= "Vector3" then return nil end
    MaximumDistance = tonumber(MaximumDistance) or 18
    local BestPlayer = nil local BestDistance = MaximumDistance
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local Character = ResolveTrackedCharacter(Player, Player.Character)
            local Root = Character and Character:FindFirstChild("HumanoidRootPart")
            if Root then
                local Distance = (Root.Position - Position).Magnitude
                if Distance
                    < BestDistance then
                    BestDistance = Distance
                    BestPlayer = Player
                end
            end
        end
    end
    return BestPlayer
end
function CombatLogRuntime.ResolveEnemyShotSource(Origin, Object)
    local Player = CombatLogRuntime.ResolvePlayerFromObject(Object)
    if not Player and Object and Object.Parent then Player = CombatLogRuntime.ResolvePlayerFromObject(Object.Parent) end
    if not Player then Player = CombatLogRuntime.FindNearestEnemyToPosition(Origin, CombatLogRuntime.EnemyShotSourceRadius or 10) end
    if Player == LocalPlayer then return nil end
    return Player
end
function CombatLogRuntime.IsOwnVisual(Object)
    local Current = Object
    for _ = 1, 5 do
        if not Current then break end
        if StringFind(Lower(Current.Name), "atramenta", 1, true) then return true end
        Current = Current.Parent
    end
    return false
end
function CombatLogRuntime.IsEnemyShotTrajectoryValid(Player, Origin, EndPosition, Character)
    if not Player or Player == LocalPlayer or typeof(Origin) ~= "Vector3" or typeof(EndPosition) ~= "Vector3" then return false end
    local Segment = EndPosition - Origin
    if Segment.Magnitude < 4 then return false end
    local ShooterCharacter = ResolveTrackedCharacter(Player, Player.Character) local ShooterRoot = ShooterCharacter and ShooterCharacter:FindFirstChild("HumanoidRootPart")
    local LocalRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    if not ShooterRoot or not LocalRoot then return false end
    local OriginTolerance = Max(tonumber(CombatLogRuntime.EnemyShotOriginTolerance) or 14, 4)
    if (Origin - ShooterRoot.Position).Magnitude > OriginTolerance then return false end
    local ToLocal = LocalRoot.Position - Origin
    if ToLocal.Magnitude <= 0.001 then return false end
    local Direction = Segment.Unit local Alignment = Direction:Dot(ToLocal.Unit)
    if Alignment < 0.72 then return false end
    local _, _, Projection = CombatLogRuntime.GetPointSegmentDistance(LocalRoot.Position, Origin, EndPosition)
    return Projection >= 0.035 and Projection <= 0.985
end
function CombatLogRuntime.RecordEnemyShot(Player, Origin, EndPosition, SourceObject)
    if CombatLogState.Enabled ~= true or not Player or Player == LocalPlayer or typeof(Origin) ~= "Vector3" or typeof(EndPosition) ~= "Vector3" then return end
    local Character = LocalPlayer.Character local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Root or not CombatLogRuntime.IsEnemyShotTrajectoryValid(Player, Origin, EndPosition, Character) then return end
    local Part, MissDistance, Projection = CombatLogRuntime.GetClosestBodyPartToSegment(Character, Origin, EndPosition)
    if not Part or MissDistance == Infinite or Projection < 0.035 or Projection > 0.985 then return end
    local CurrentTime = Clock()
    CombatLogRuntime.MaintainRuntime(CurrentTime, false)
    local ShotEntry = {Time = CurrentTime, Player = Player, Origin = Origin, EndPosition = EndPosition, Part = Part,
        MissDistance = MissDistance, Projection = Projection, SourceObject = SourceObject, DamageConfirmed = false}
    CombatLogRuntime.RecentEnemyShots[#CombatLogRuntime.RecentEnemyShots + 1] = ShotEntry
    while #CombatLogRuntime.RecentEnemyShots > 48 do Remove(CombatLogRuntime.RecentEnemyShots, 1) end

end
function CombatLogRuntime.IsEnemyShotVisualCandidate(Object)
    if not Object then return false end
    local Current = Object
    for _ = 1, 6 do
        if not Current or Current == workspace then break end
        local Name = Lower(Current.Name)
        if StringFind(Name, "bullet", 1, true) or StringFind(Name, "tracer", 1, true)
            or StringFind(Name, "projectile", 1, true) or StringFind(Name, "gunshot", 1, true) or StringFind(Name, "laser", 1, true) then
            return true
        end
        Current = Current.Parent
    end
    if Object:IsA("Beam") then
        local Attachment0, Attachment1 = Object.Attachment0, Object.Attachment1
        if not Attachment0 or not Attachment1 then return false end
        local Width = Max(tonumber(Object.Width0) or 0, tonumber(Object.Width1) or 0) local SegmentLength = (Attachment1.WorldPosition - Attachment0.WorldPosition).Magnitude
        return Width <= 0.16 and SegmentLength >= 5
    end
    return false
end
function CombatLogRuntime.TrackEnemyShotObject(Object)
    if not Object or CombatLogRuntime.SeenEnemyShotObjects[Object] or CombatLogRuntime.IsOwnVisual(Object) or not CombatLogRuntime.IsEnemyShotVisualCandidate(Object) then
        return
    end
    local Entry
    if Object:IsA("Beam") then
        CombatLogRuntime.SeenEnemyShotObjects[Object] = true
        Entry = {Object = Object, IsBeam = true, Due = Clock() + 0.035}
    elseif Object:IsA("BasePart") then
        CombatLogRuntime.SeenEnemyShotObjects[Object] = true
        Entry = {Object = Object, IsBeam = false, StartPosition = Object.Position, Due = Clock() + 0.045}
    else
        return
    end
    local Queue = CombatLogRuntime.EnemyShotQueue
    if #Queue >= (tonumber(CombatLogRuntime.EnemyShotQueueLimit) or 96) then Remove(Queue, 1) end
    Queue[#Queue + 1] = Entry
end
CombatLogRuntime.EnemyShotRoots = CombatLogRuntime.EnemyShotRoots or setmetatable({}, {__mode = "k"})
CombatLogRuntime.EnemyShotRootNames = CombatLogRuntime.EnemyShotRootNames or {Debris = true, Effects = true, Projectiles = true, Bullets = true, Tracers = true}
function CombatLogRuntime.BindEnemyShotRoot(Root)
    if not Root or CombatLogRuntime.EnemyShotRoots[Root] then return end
    local Connection = Root.DescendantAdded:Connect(function(Object)
        if Object:IsA("Beam") or Object:IsA("BasePart") then CombatLogRuntime.TrackEnemyShotObject(Object) end
    end)
    CombatLogRuntime.EnemyShotRoots[Root] = Connection
end
function CombatLogRuntime.RefreshEnemyShotTracking()
    local ShouldTrack = CombatLogState.Enabled == true and CombatLogState.Incoming == true
    if CombatLogRuntime.EnemyVisualizeConnection then
        Shared.SafeDisconnect(CombatLogRuntime.EnemyVisualizeConnection)
        CombatLogRuntime.EnemyVisualizeConnection = nil
    end
    for Root, Connection in pairs(CombatLogRuntime.EnemyShotRoots or {}) do
        if Connection then Shared.SafeDisconnect(Connection) end
        CombatLogRuntime.EnemyShotRoots[Root] = nil
    end
    if CombatLogRuntime.EnemyShotConnection then Shared.SafeDisconnect(CombatLogRuntime.EnemyShotConnection) end
    CombatLogRuntime.EnemyShotConnection = nil
    Clear(CombatLogRuntime.EnemyShotConnections)
    Clear(CombatLogRuntime.EnemyShotQueue)
    CombatLogRuntime.ClearEnemyWeaponTracking()
    if not ShouldTrack then
        Clear(CombatLogRuntime.RecentEnemyShots)
        return
    end
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then CombatLogRuntime.BindEnemyWeaponTracking(Player, Player.Character) end
    end
    local EventsFolder = ReplicatedStorage:FindFirstChild("Events")
    local Visualize = EventsFolder and EventsFolder:FindFirstChild("Visualize")
    if Visualize and Visualize:IsA("RemoteEvent") then
        CombatLogRuntime.EnemyVisualizeConnection = Visualize.OnClientEvent:Connect(function(...)
            CombatLogRuntime.RecordEnemyVisualizeShot(...)
        end)
    end
end
function CombatLogRuntime.FindTaggedAttacker(Character, Humanoid)
    local Containers = {Character, Humanoid}
    local CharStats = ReplicatedStorage:FindFirstChild("CharStats")
    if CharStats and LocalPlayer then Containers[#Containers + 1] = CharStats:FindFirstChild(LocalPlayer.Name) end
    local Keywords = {"creator", "attacker", "damager", "damagefrom", "lastdamager", "lastattacker", "killer", "shooter", "source"}
    for _, Container in ipairs(Containers) do
        if Container then
            for _, Object in ipairs(Container:GetDescendants()) do
                if Object:IsA("ObjectValue") and Object.Value then
                    local LowerName = Lower(Object.Name)
                    local Matched = false
                    for _, Keyword in ipairs(Keywords) do
                        if StringFind(LowerName, Keyword, 1, true) then Matched = true break end
                    end
                    if Matched then
                        if Object.Value:IsA("Player") then
                            if Object.Value ~= LocalPlayer then return Object.Value end
                        else
                            local Player = CombatLogRuntime.ResolvePlayerFromObject(Object.Value)
                            if Player and Player ~= LocalPlayer then return Player end
                        end
                    end
                end
            end
        end
    end
    return nil
end
function CombatLogRuntime.GetRecentEnemyShot(MaximumAge, MaximumMissDistance, TaggedAttacker)
    local CurrentTime = Clock()
    local AgeLimit = Clamp(tonumber(MaximumAge) or CombatLogRuntime.IncomingShotWindow or 0.70, 0.10, 1.50)
    local MissLimit = Clamp(tonumber(MaximumMissDistance) or CombatLogRuntime.IncomingShotRadius or 4.00, 0.25, 10)
    local Best, BestScore
    for Index = #CombatLogRuntime.RecentEnemyShots, 1, -1 do
        local Shot = CombatLogRuntime.RecentEnemyShots[Index]
        local ExpectedAt = Shot and tonumber(Shot.ExpectedAt) or nil
        local FiredAt = Shot and tonumber(Shot.Time) or nil
        local ReferenceTime = ExpectedAt or FiredAt or 0
        local Expired = not Shot or CurrentTime - Max(FiredAt or 0, ExpectedAt or 0) > 1.50
        if Expired then
            Remove(CombatLogRuntime.RecentEnemyShots, Index)
        elseif Shot.Consumed ~= true and Shot.Player and Shot.Player ~= LocalPlayer and (not TaggedAttacker or Shot.Player == TaggedAttacker)
            and typeof(Shot.Origin) == "Vector3" and typeof(Shot.EndPosition) == "Vector3" and (tonumber(Shot.MissDistance) or Infinite) <= MissLimit then
            local TimeError = Abs(CurrentTime - ReferenceTime)
            if FiredAt then TimeError = Min(TimeError, Abs(CurrentTime - FiredAt)) end
            if ExpectedAt then TimeError = Min(TimeError, Abs(CurrentTime - ExpectedAt)) end
            if TimeError <= AgeLimit then
                local Score = TimeError + (tonumber(Shot.MissDistance) or 0) * 0.025
                if Shot.DirectVisualize == true then Score -= 0.04 end
                if BestScore == nil or Score < BestScore then
                    Best = Shot
                    BestScore = Score
                end
            end
        end
    end
    return Best
end
function CombatLogRuntime.RoundIncomingDamage(Damage)
    Damage = tonumber(Damage) or 0
    if Abs(Damage - Floor(Damage + 0.5)) <= 0.05 then
        return Max(Floor(Damage + 0.5), 1)
    end
    return Max(Floor(Damage * 10 + 0.5) / 10, 0.1)
end

function CombatLogRuntime.MarkEnemyShotConsumed(Shot)
    if type(Shot) ~= "table" then return end
    Shot.DamageConfirmed = true
    Shot.DamageConfirmedAt = Clock()
    Shot.Consumed = true
    local ShotId = Shot.ShotId
    if ShotId == nil then return end
    for Index = #CombatLogRuntime.RecentEnemyShots, 1, -1 do
        local Entry = CombatLogRuntime.RecentEnemyShots[Index]
        if Entry and Entry.Player == Shot.Player and Entry.ShotId == ShotId then
            Entry.DamageConfirmed = true
            Entry.DamageConfirmedAt = Shot.DamageConfirmedAt
            Entry.Consumed = true
        end
    end
end

function CombatLogRuntime.EmitIncomingDamageEntry(Entry)
    if type(Entry) ~= "table" or not Entry.Attacker or (tonumber(Entry.Damage) or 0) <= 0 then return end
    local Parts = {CombatLogRuntime.GetDisplayName(Entry.Attacker), tostring(Entry.WeaponName or Entry.SourceType or "damage"),
        "hit you for " .. tostring(CombatLogRuntime.RoundIncomingDamage(Entry.Damage))}
    if Entry.PartName then Parts[#Parts + 1] = Entry.PartName end
    local DistanceText = CombatLogRuntime.FormatDistance(Entry.Distance)
    if DistanceText then Parts[#Parts + 1] = DistanceText .. " st" end
    CombatLogRuntime.Emit("Damage", Concat(Parts, "  ·  "), nil)
end

function CombatLogRuntime.QueueMergedIncomingDamage(Entry)
    local Attacker = Entry and Entry.Attacker
    if not Attacker then return end
    local Buckets = CombatLogRuntime.IncomingPending[Attacker]
    if type(Buckets) ~= "table" then
        Buckets = {}
        CombatLogRuntime.IncomingPending[Attacker] = Buckets
    end
    local Key = tostring(Entry.SourceType or "Damage") .. "\0" .. tostring(Entry.WeaponName or "")
    local Bucket = Buckets[Key]
    if Bucket then
        Bucket.Damage = (tonumber(Bucket.Damage) or 0) + (tonumber(Entry.Damage) or 0)
        Bucket.Distance = Entry.Distance or Bucket.Distance
        Bucket.PartName = Entry.PartName or Bucket.PartName
        return
    end
    Bucket = {Attacker = Attacker, WeaponName = Entry.WeaponName, SourceType = Entry.SourceType, Damage = tonumber(Entry.Damage) or 0, Distance = Entry.Distance,
        PartName = Entry.PartName}
    Buckets[Key] = Bucket
    Delay(CombatLogRuntime.IncomingMergeWindow, function()
        local CurrentBuckets = CombatLogRuntime.IncomingPending[Attacker]
        if type(CurrentBuckets) ~= "table" or CurrentBuckets[Key] ~= Bucket then return end
        CurrentBuckets[Key] = nil
        if next(CurrentBuckets) == nil then CombatLogRuntime.IncomingPending[Attacker] = nil end
        CombatLogRuntime.EmitIncomingDamageEntry(Bucket)
    end)
end

function CombatLogRuntime.LogIncomingDamage(Character, Humanoid, Damage)
    if CombatLogState.Enabled ~= true or CombatLogState.Incoming ~= true or not Damage or Damage <= 0 then return end
    local CurrentTime = Clock()
    local TaggedAttacker = CombatLogRuntime.FindTaggedAttacker(Character, Humanoid)
    local RecentShot = CombatLogRuntime.GetRecentEnemyShot(CombatLogRuntime.IncomingShotWindow, CombatLogRuntime.IncomingShotRadius, TaggedAttacker)
    local LocalRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    local Attacker = RecentShot and RecentShot.Player or TaggedAttacker
    if not Attacker or Attacker == LocalPlayer then return end
    CombatLogRuntime.RecentDamageAt = CurrentTime
    local AttackerCharacter = ResolveTrackedCharacter(Attacker, Attacker.Character)
    local AttackerRoot = AttackerCharacter and AttackerCharacter:FindFirstChild("HumanoidRootPart")
    local Distance = LocalRoot and AttackerRoot and (LocalRoot.Position - AttackerRoot.Position).Magnitude
        or LocalRoot and RecentShot and (LocalRoot.Position - RecentShot.Origin).Magnitude or nil
    local SourceType
    if RecentShot then
        SourceType = "Bullet"
    else
        local TaggedDistance = LocalRoot and AttackerRoot and (LocalRoot.Position - AttackerRoot.Position).Magnitude or nil
        SourceType = TaggedDistance and TaggedDistance <= Max(tonumber(CombatLogRuntime.IncomingMeleeDistance) or 22, 1) and "Melee" or "Explosive"
    end
    local WeaponName = RecentShot and RecentShot.WeaponName or CombatLogRuntime.GetWeaponName(RecentShot and (RecentShot.Tool or RecentShot.SourceObject), Attacker, SourceType)
    local Entry = {Attacker = Attacker, WeaponName = WeaponName, SourceType = SourceType, Damage = Damage, Distance = Distance,
        PartName = RecentShot and RecentShot.Part and RecentShot.Part.Name or nil}
    if RecentShot then
        local ShotId = RecentShot.ShotId
        if ShotId ~= nil then
            local ShotKey = tostring(Attacker.UserId or Attacker.Name) .. ":" .. tostring(ShotId)
            local LastAt = tonumber(CombatLogRuntime.IncomingRecentShots[ShotKey])
            if LastAt and CurrentTime - LastAt <= CombatLogRuntime.IncomingDuplicateWindow then
                CombatLogRuntime.MarkEnemyShotConsumed(RecentShot)
                return
            end
            CombatLogRuntime.IncomingRecentShots[ShotKey] = CurrentTime
        end
        CombatLogRuntime.MarkEnemyShotConsumed(RecentShot)
        CombatLogRuntime.EmitIncomingDamageEntry(Entry)
        return
    end
    CombatLogRuntime.QueueMergedIncomingDamage(Entry)
end

function CombatLogRuntime.BindLocalDamage(Character)
    if CombatLogRuntime.LocalDamageConnection then
        Shared.SafeDisconnect(CombatLogRuntime.LocalDamageConnection)
        CombatLogRuntime.LocalDamageConnection = nil
    end
    CombatLogRuntime.LocalCharacter = Character
    local Humanoid = Character and (Character:FindFirstChildOfClass("Humanoid") or Character:WaitForChild("Humanoid", 5))
    CombatLogRuntime.LocalHumanoid = Humanoid
    if not Humanoid then return end
    CombatLogRuntime.PreviousLocalHealth = Humanoid.Health
    CombatLogRuntime.DamageAccumulator = 0
    CombatLogRuntime.DamageAccumulatorVersion += 1
    CombatLogRuntime.DamageAccumulatorCharacter = Character
    CombatLogRuntime.DamageAccumulatorHumanoid = Humanoid
    CombatLogRuntime.LocalDamageConnection = Humanoid.HealthChanged:Connect(function(NewHealth)
        if CombatLogRuntime.LocalCharacter ~= Character then return end
        local PreviousHealth = CombatLogRuntime.PreviousLocalHealth
        CombatLogRuntime.PreviousLocalHealth = NewHealth
        if type(PreviousHealth) ~= "number" or type(NewHealth) ~= "number" then return end
        local Damage = PreviousHealth - NewHealth
        if Damage <= 0 then return end
        CombatLogRuntime.DamageAccumulator += Damage
        CombatLogRuntime.DamageAccumulatorCharacter = Character
        CombatLogRuntime.DamageAccumulatorHumanoid = Humanoid
        CombatLogRuntime.DamageAccumulatorVersion += 1
        local Version = CombatLogRuntime.DamageAccumulatorVersion
        Delay(CombatLogRuntime.DamageAccumulatorWindow, function()
            if CombatLogRuntime.LocalCharacter ~= Character or CombatLogRuntime.DamageAccumulatorVersion ~= Version then return end
            local TotalDamage = CombatLogRuntime.DamageAccumulator CombatLogRuntime.DamageAccumulator = 0
            if TotalDamage > 0 then CombatLogRuntime.LogIncomingDamage(Character, Humanoid, TotalDamage) end
        end)
    end)
end
function CombatLogRuntime.ClassifyMiss(Shot)
    if type(Shot) ~= "table" then return "unconfirmed shot", nil end
    if not Shot.Player then return "no target", nil end
    local Character, TargetPart = CombatLogRuntime.GetShotTargetPart(Shot)
    if not Character or not TargetPart then return "target lost", nil end
    local Origin = Shot.Origin
    local IntendedPosition = typeof(Shot.HitPosition) == "Vector3" and Shot.HitPosition or typeof(Shot.TargetPositionAtFire) == "Vector3"
            and Shot.TargetPositionAtFire or TargetPart.Position
    local Distance = typeof(Origin) == "Vector3" and (IntendedPosition - Origin).Magnitude or nil
    local Range = CombatLogRuntime.GetWeaponRange(Shot.Tool)
    if Range and Distance and Distance > Range * 1.02 then return "distance", Distance end
    local Source = type(Shared.NormalizeLocalAttackSource) == "function" and Shared.NormalizeLocalAttackSource(Shot.Source) or tostring(Shot.Source or "")
    local SilentShot = Source == "SilentAim" or Shot.SpreadBypassed == true
    local PredictedCenter = typeof(Shot.PredictedCenter) == "Vector3" and Shot.PredictedCenter or nil
    if Source == "RageBot" and PredictedCenter and typeof(Shot.DamageHitPosition) == "Vector3" and Shot.RouteOutsideHitbox ~= true then
        local PredictionError = (Shot.DamageHitPosition - PredictedCenter).Magnitude
        if PredictionError > Max(TargetPart.Size.Magnitude * 0.72, 1.35) then return "prediction error", Distance end
    end
    if Source == "RageBot" and Shot.RouteValidAtFire == false then
        return "route invalid at fire", Distance
    end
    if Source ~= "RageBot" and not SilentShot and typeof(Origin) == "Vector3" and typeof(Shot.Direction) == "Vector3" then
        local IntendedDelta = IntendedPosition - Origin
        if IntendedDelta.Magnitude > 0.001 and Shot.Direction.Magnitude > 0.001 then
            local Dot = Clamp(IntendedDelta.Unit:Dot(Shot.Direction.Unit), -1, 1)
            local Angle = Deg(Acos(Dot))
            local WeaponData = type(GetBulletTracerWeaponInfo) == "function" and GetBulletTracerWeaponInfo(Shot.Tool) or nil
            local Spread = WeaponData and tonumber(WeaponData.Spread) or 0
            local SpreadThreshold = Max(Spread * 0.35, 0.55)
            if Angle > SpreadThreshold then return "spread", Distance end
        end
    end
    if typeof(Origin) == "Vector3" and typeof(IntendedPosition) == "Vector3" and Source ~= "RageBot" and not (SilentShot and Shot.Wallbang == true) then
        Ragebot.RefreshRaycastParameters(LocalPlayer)
        local Result = Workspace:Raycast(Origin, IntendedPosition - Origin, Ragebot.RayParams)
        if Result and not Result.Instance:IsDescendantOf(Character) then return "obstruction", Distance end
    end
    if Source == "RageBot" and Shot.PenetrationValidatedAtFire == true then
        local Safety = tonumber(Shot.WallbangSafety) or 0
        local Risk = tonumber(Shot.PenetrationRisk) or 0
        if Safety < 0.16 or Risk > 1.12 then return "penetration rejected", Distance end
    end
    if Source == "RageBot" and Shot.AmmoConfirmed == true and Shot.SignalConfirmed == true then
        return "damage not confirmed", Distance
    end
    if Source == "RageBot" and Shot.AmmoConfirmed == true and Shot.RageRemoteSent == true then
        return "server hit not confirmed", Distance
    end
    if Shot.AmmoConfirmed == true and Shot.SignalConfirmed == true then
        return "damage not confirmed", Distance
    end
    if Source == "RageBot" and Shot.RageRemoteSent == true then
        return "server shot not confirmed", Distance
    end
    return "unconfirmed shot", Distance
end
function Shared.IsConfirmedLocalFire(Shot)
    if type(Shot) ~= "table" or Shot.Discarded == true then return false end
    if Shot.RemoteConfirmed == true or Shot.AmmoConfirmed == true or Shot.RageRemoteSent == true or Shot.DamagePacketSent == true then return true end
    return Shot.VerifiedFire == true and Shot.SignalConfirmed ~= true
end
function CombatLogRuntime.ResolveScheduledMiss(Shot)
    if type(Shot) ~= "table" or Shot.DamageConfirmed == true or Shot.MissLogged == true or Shot.Discarded == true then return end
    if not Shared.IsConfirmedLocalFire(Shot) then
        Shot.Resolution = "FireNotConfirmed"
        Shot.ResolvedAt = Clock()
        return
    end
    local Reason, ShotDistance = CombatLogRuntime.ClassifyMiss(Shot)
    Shot.Resolution = "Miss"
    Shot.ResolvedAt = Clock()
    Shot.MissLogged = true
    if Ragebot and type(Ragebot.FinalizeValidationShot) == "function" then Ragebot.FinalizeValidationShot(Shot, false, nil, Reason) end
    if CombatLogState.Enabled ~= true or CombatLogState.Misses ~= true then return end
    local DetailParts = {CombatLogRuntime.GetWeaponName(Shot.Tool, LocalPlayer), tostring(Reason)}
    local DistanceText = CombatLogRuntime.FormatDistance(ShotDistance)
    if DistanceText then DetailParts[#DetailParts + 1] = DistanceText .. " st" end
    if Ragebot and type(Ragebot.GetValidationLogDetail) == "function" then
        local ValidationDetail = Ragebot.GetValidationLogDetail(Shot)
        if ValidationDetail then DetailParts[#DetailParts + 1] = ValidationDetail end
    end
    CombatLogRuntime.Emit("Miss", Concat(DetailParts, "  ·  "), nil)
end
function CombatLogRuntime.ScheduleMiss(Shot)
    if type(Shot) ~= "table" or Shot.MissScheduled then return end
    Shot.MissScheduled = true
    Shot.MissDue = Clock() + Clamp(tonumber(CombatLogState.ResolveDelay) or 1.55, 0.20, 2.50)
    local Queue = CombatLogRuntime.PendingMisses
    Queue[#Queue + 1] = Shot
    while #Queue > 512 do Remove(Queue, 1) end
end
function CombatLogRuntime.ProcessPendingMisses(CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Queue = CombatLogRuntime.PendingMisses
    local Processed = 0
    for Index = #Queue, 1, -1 do
        if Processed >= 64 then break end
        local Shot = Queue[Index]
        if not Shot or Shot.DamageConfirmed == true or Shot.MissLogged == true or Shot.Discarded == true then
            Remove(Queue, Index)
        elseif CurrentTime >= (tonumber(Shot.MissDue) or CurrentTime) then
            Remove(Queue, Index)
            CombatLogRuntime.ResolveScheduledMiss(Shot)
            Processed += 1
        end
    end
end
function Shared.ResolveLocalAttackTarget(TargetCharacter, TargetPart)
    TargetCharacter = TargetCharacter or Shared.GetHumanoidCharacterFromPart(TargetPart)
    local TargetPlayer = Shared.GetPlayerFromTrackedCharacter(TargetCharacter)
    if not TargetPlayer or TargetPlayer == LocalPlayer or not TargetCharacter then return nil, nil, nil, nil end
    local ResolvedCharacter = ResolveTrackedCharacter(TargetPlayer, TargetCharacter)
    if ResolvedCharacter then TargetCharacter = ResolvedCharacter end
    local PartName = TargetPart and TargetPart.Name or nil
    if TargetPart and not TargetPart:IsDescendantOf(TargetCharacter) then TargetPart = PartName and TargetCharacter:FindFirstChild(PartName, true) or nil end
    if not TargetPart then TargetPart = TargetCharacter:FindFirstChild("HumanoidRootPart") or TargetCharacter:FindFirstChild("Head") or TargetCharacter.PrimaryPart end
    if not TargetPart or not TargetPart:IsA("BasePart") then return TargetPlayer, TargetCharacter, nil, PartName end
    return TargetPlayer, TargetCharacter, TargetPart, TargetPart.Name
end
