function Ragebot.EnsureFieldOfView()
    if not Ragebot.FOVCircle then
        Ragebot.FOVCircle = Ragebot.CreateFieldOfViewCircle(Ragebot.Settings.FOVColor or NewRGB(255, 255, 255),
            Ragebot.Settings.FOVThickness, Ragebot.Settings.FOVTransparency, false)
    end
    if not Ragebot.FOVFillCircle then
        Ragebot.FOVFillCircle = Ragebot.CreateFieldOfViewCircle(Ragebot.Settings.FOVFillColor or Ragebot.Settings.FOVColor, 1, Ragebot.Settings.FOVFillTransparency, true)
    end
    if Ragebot.Settings.FOVGlow == true then
        if #Ragebot.FOVGlowCircles == 0 then Ragebot.CreateFieldOfViewGlow() end
    elseif #Ragebot.FOVGlowCircles > 0 then
        for Index = 1, #Ragebot.FOVGlowCircles do Ragebot.RemoveOverlay(Ragebot.FOVGlowCircles[Index]) end
        Ragebot.FOVGlowCircles = {}
    end
    if Ragebot.Settings.FOVGradient == true then
        if #Ragebot.FOVGradientLines == 0 then Ragebot.CreateFieldOfViewGradient() end
    elseif #Ragebot.FOVGradientLines > 0 then
        for Index = 1, #Ragebot.FOVGradientLines do Ragebot.RemoveOverlay(Ragebot.FOVGradientLines[Index]) end
        Ragebot.FOVGradientLines = {}
    end
end
function Ragebot.UpdateFieldOfView()
    local Visible = Ragebot.Enabled and Ragebot.Settings.TargetSelection == "FOV" and Ragebot.Settings.ShowFOV == true
    if not Visible then
        if Ragebot.FOVCircle then Ragebot.FOVCircle.Visible = false end
        if Ragebot.FOVFillCircle then Ragebot.FOVFillCircle.Visible = false end
        for Index = 1, #Ragebot.FOVGlowCircles do Ragebot.FOVGlowCircles[Index].Visible = false end
        for Index = 1, #Ragebot.FOVGradientLines do Ragebot.FOVGradientLines[Index].Visible = false end
        return
    end
    Ragebot.EnsureFieldOfView()
    local Position = Ragebot.GetFieldOfViewPosition()
    local Radius = Clamp(tonumber(Ragebot.Settings.FOV) or 320, 10, 700)
    local Primary = Ragebot.Settings.FOVColor or NewRGB(255, 255, 255)
    local Secondary = Ragebot.Settings.FOVGradientColor or NewRGB(54, 218, 145)
    local Thickness = Clamp(tonumber(Ragebot.Settings.FOVThickness) or 2, 1, 8)
    local Transparency = Clamp(tonumber(Ragebot.Settings.FOVTransparency) or 0.72, 0, 1)
    if Ragebot.FOVFillCircle then
        Ragebot.FOVFillCircle.Position = Position
        Ragebot.FOVFillCircle.Radius = Radius
        Ragebot.FOVFillCircle.Color = Ragebot.Settings.FOVFillColor or Primary
        Ragebot.FOVFillCircle.Transparency = Clamp(tonumber(Ragebot.Settings.FOVFillTransparency) or 0.10, 0, 1)
        Ragebot.FOVFillCircle.Visible = Ragebot.Settings.FOVFilled == true
    end
    if Ragebot.FOVCircle then
        Ragebot.FOVCircle.Position = Position
        Ragebot.FOVCircle.Radius = Radius
        Ragebot.FOVCircle.Color = Primary
        Ragebot.FOVCircle.Thickness = Thickness
        Ragebot.FOVCircle.Transparency = Transparency
        Ragebot.FOVCircle.Visible = Ragebot.Settings.FOVGradient ~= true
    end
    local GlowThickness = Clamp(tonumber(Ragebot.Settings.FOVGlowThickness) or 8, 2, 32)
    local GlowTransparency = Clamp(tonumber(Ragebot.Settings.FOVGlowTransparency) or 0.20, 0, 1)
    for Index = 1, #Ragebot.FOVGlowCircles do
        local Circle = Ragebot.FOVGlowCircles[Index]
        local Layer = Ragebot.FOVGlowLayers[Index] or Ragebot.FOVGlowLayers[#Ragebot.FOVGlowLayers]
        Circle.Position = Position
        Circle.Radius = Radius
        Circle.Color = Ragebot.Settings.FOVGlowColor or Secondary
        Circle.Thickness = Max(GlowThickness * Layer[1], 1)
        Circle.Transparency = Clamp(GlowTransparency * Layer[2], 0.01, 1)
        Circle.Visible = Ragebot.Settings.FOVGlow == true
    end
    local SegmentCount = #Ragebot.FOVGradientLines
    if Ragebot.Settings.FOVGradient == true and SegmentCount > 0 then
        local Rotation = tonumber(Ragebot.Settings.FOVGradientRotation) or 0
        if Ragebot.Settings.FOVGradientAnimated == true then Rotation += Clock() * (tonumber(Ragebot.Settings.FOVGradientSpeed) or 45) end
        local RotationRadians = Rad(Rotation % 360)
        local GradientTransparency = Clamp(tonumber(Ragebot.Settings.FOVGradientTransparency) or Transparency, 0, 1)
        for Index = 1, SegmentCount do
            local Line = Ragebot.FOVGradientLines[Index]
            local T0 = (Index - 1) / SegmentCount
            local T1 = Index / SegmentCount
            local Angle0 = T0 * Pi * 2 + RotationRadians
            local Angle1 = T1 * Pi * 2 + RotationRadians
            Line.From = Position + NewVector2(Cos(Angle0) * Radius, Sin(Angle0) * Radius)
            Line.To = Position + NewVector2(Cos(Angle1) * Radius, Sin(Angle1) * Radius)
            local Wave = 0.5 - 0.5 * Cos(T0 * Pi * 2)
            Line.Color = Primary:Lerp(Secondary, Wave)
            Line.Thickness = Thickness
            Line.Transparency = GradientTransparency
            Line.Visible = true
        end
    end
end
