function Shared.GetDroppedItemKey(Object)
    if not Object then return nil end
    local Cached = Shared.DroppedWeaponIdentityCache[Object]
    if type(Cached) == "string" then return Cached end
    local Key = Shared.ReadWeaponMetadataKey(Object)
    if not Key then Key = Shared.ResolveWeaponSignatureKey(Object) end
    if Key then Shared.DroppedWeaponIdentityCache[Object] = Key end
    return Key
end
