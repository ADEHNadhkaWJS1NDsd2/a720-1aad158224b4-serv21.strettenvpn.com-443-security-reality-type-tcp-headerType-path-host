function UpdateAtramentaFakeLagTelemetry(Action, Protected, Slot, CurrentTime)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Start = tonumber(DesyncNetworkState.FakeLagWindowStart) or 0
    if Start <= 0 then
        Start = CurrentTime
        DesyncNetworkState.FakeLagWindowStart = Start
    end
    DesyncNetworkState.FakeLagWindowSeen = (tonumber(DesyncNetworkState.FakeLagWindowSeen) or 0) + 1
    if Action == "HOLD" then
        DesyncNetworkState.FakeLagWindowBlocked = (tonumber(DesyncNetworkState.FakeLagWindowBlocked) or 0) + 1
    else
        DesyncNetworkState.FakeLagWindowSent = (tonumber(DesyncNetworkState.FakeLagWindowSent) or 0) + 1
    end
    if Protected == true then DesyncNetworkState.FakeLagWindowProtected = (tonumber(DesyncNetworkState.FakeLagWindowProtected) or 0) + 1 end
    DesyncNetworkState.FakeLagLastAction = tostring(Action or "WAIT")
    DesyncNetworkState.FakeLagLastActionTime = CurrentTime
    DesyncNetworkState.FakeLagLastSlot = Max(Floor(tonumber(Slot) or 0), 0)
    local Elapsed = CurrentTime - Start
    if Elapsed >= 0.50 then
        DesyncNetworkState.FakeLagSeenRate = (tonumber(DesyncNetworkState.FakeLagWindowSeen) or 0) / Elapsed
        DesyncNetworkState.FakeLagBlockedRate = (tonumber(DesyncNetworkState.FakeLagWindowBlocked) or 0) / Elapsed
        DesyncNetworkState.FakeLagSentRate = (tonumber(DesyncNetworkState.FakeLagWindowSent) or 0) / Elapsed
        DesyncNetworkState.FakeLagProtectedRate = (tonumber(DesyncNetworkState.FakeLagWindowProtected) or 0) / Elapsed
        DesyncNetworkState.FakeLagWindowStart = CurrentTime
        DesyncNetworkState.FakeLagWindowSeen = 0
        DesyncNetworkState.FakeLagWindowBlocked = 0
        DesyncNetworkState.FakeLagWindowSent = 0
        DesyncNetworkState.FakeLagWindowProtected = 0
    end
end
