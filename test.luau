function ResolverGetCharacterFolders(CurrentTime)
    local State = Res.WorldCharacterCache
    CurrentTime = tonumber(CurrentTime) or Clock()
    if CurrentTime >= (tonumber(State.NextRefresh) or 0) or State.WorldCharacters and not State.WorldCharacters.Parent
        or State.NormalCharacters and not State.NormalCharacters.Parent then
        local WorldContainer = Workspace:FindFirstChild("©")
        State.WorldCharacters = WorldContainer and WorldContainer:FindFirstChild("Characters") or nil
        State.NormalCharacters = Workspace:FindFirstChild("Characters")
        State.NextRefresh = CurrentTime + 0.40
    end
    return State.WorldCharacters, State.NormalCharacters
