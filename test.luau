        end)
    elseif AttributeContainer and type(AttributeName) == "string" then
        Data.PlayerLevelSourceSignals.Attribute = AttributeContainer:GetAttributeChangedSignal(AttributeName):Connect(function()
            local NewValue = tonumber(AttributeContainer:GetAttribute(AttributeName))
            NewValue = NewValue and NewValue >= 0 and Floor(NewValue + 0.5) or nil
            if Data.LevelValue ~= NewValue then
                Data.LevelValue = NewValue
                Shared.MarkPlayerESPStateDirty(Data, false)
