function PatchBodyPose(Packet)
    if type(Packet) ~= "table" or not HideRunning() then
        return nil, false
    end
    local Pose = Packet[1]
    if type(Pose) ~= "table" then
        return nil, false
    end
    local NewPacket = Table.clone(Packet)
    local NewPose = Table.clone(Pose)
    local Changed = false
    if BodyHide.Hands then
        if typeof(NewPose[1]) == "Vector3" then
            NewPose[1] = HandPacketPos(HideBase.LeftHand)
            Changed = true
        end
        if typeof(NewPose[2]) == "Vector3" then
            NewPose[2] = HandPacketPos(HideBase.RightHand)
            Changed = true
        end
    end
    if BodyHide.Head and typeof(NewPose[3]) == "Vector3" then
        NewPose[3] = HeadPacketPos()
        Changed = true
    end
    if not Changed then
        return nil, false
    end
    BodyHide.PatchedPackets = (tonumber(BodyHide.PatchedPackets) or 0) + 1
    NewPacket[1] = NewPose
    return NewPacket, true
end

