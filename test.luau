function PlayerVisuals.GetBrightnessColor(Color, Brightness)
    if typeof(Color) ~= "Color3" then return NewColor3(1, 1, 1) end
    Brightness = Clamp(tonumber(Brightness) or 1, 0.1, 2)
    if Brightness <= 1 then
        return NewColor3(Color.R * Brightness, Color.G * Brightness, Color.B * Brightness)
    end
    return Color:Lerp(NewColor3(1, 1, 1), Brightness - 1)
end

function PlayerVisuals.GetVisibility(Data, Force)
    local Character = Data and Data.Character
    local CameraObject = Shared.GetCamera()
    if not Data or not Character or not Character.Parent or not CameraObject then return true end
    local CurrentTime = Clock()
    if Force ~= true and type(Data.PlayerVisualVisibilityAt) == "number" and CurrentTime - Data.PlayerVisualVisibilityAt <= 1 / 180
        and type(Data.PlayerVisualVisible) == "boolean" then
        return Data.PlayerVisualVisible
    end
    local Params = Data.PlayerVisualRayParams
    if typeof(Params) ~= "RaycastParams" then
        Params = NewRaycastParams()
        Params.FilterType = Enum.RaycastFilterType.Exclude
        Params.IgnoreWater = true
        Params.RespectCanCollide = false
        Data.PlayerVisualRayParams = Params
    end
    local Ignore = Data.PlayerVisualRayIgnore
    if type(Ignore) ~= "table" then
        Ignore = {}
        Data.PlayerVisualRayIgnore = Ignore
    else
        Clear(Ignore)
    end
    local LocalCharacter = LocalPlayer.Character
    if LocalCharacter then Ignore[#Ignore + 1] = LocalCharacter end
    Ignore[#Ignore + 1] = Character
    Ignore[#Ignore + 1] = CameraObject
    Params.FilterDescendantsInstances = Ignore
    local Origin = CameraObject.CFrame.Position
    local Head = Data.Head or Character:FindFirstChild("Head")
    local Torso = Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso") or Character:FindFirstChild("LowerTorso")
    local Root = Data.Root or Character:FindFirstChild("HumanoidRootPart")
    local Samples = {Head, Torso, Root}
    local Visible = false
    for Index = 1, #Samples do
        local Part = Samples[Index]
        if Part and Part:IsA("BasePart") and Part:IsDescendantOf(Character) then
            local Direction = Part.Position - Origin
            if Direction:Dot(Direction) <= 0.0001 or Workspace:Raycast(Origin, Direction, Params) == nil then
                Visible = true
                break
            end
        end
    end
    Data.PlayerVisualVisible = Visible
    Data.PlayerVisualVisibilityAt = CurrentTime
    Data.PlayerVisualPendingVisibility = nil
    Data.PlayerVisualPendingSamples = 0
    Data.ChamVisible = Visible
    return Visible
end
function PlayerVisuals.GetChamStyle(Visible)
    local Settings = Visuals.Player.Chams
    local Color = Settings.Color
    if Settings.VisibilityCheck == true and Visible == false and typeof(Settings.HiddenColor) == "Color3" then Color = Settings.HiddenColor end
    return Color, Clamp(tonumber(Settings.Transparency) or 0.28, 0, 0.95)
end
function PlayerVisuals.GetMaterialColor(Visible)
    local Settings = Visuals.Player.Material
    return PlayerVisuals.GetBrightnessColor(Settings.Color, Settings.Brightness)
end
function PlayerVisuals.UpdateBloom()
    local CameraObject = Shared.GetCamera()
    local ArmsGlow = ArmsChamsEnabled == true and type(ArmsChamsSettings) == "table" and ArmsChamsSettings.GlowEnabled == true
    local WeaponGlow = WeaponChamsEnabled == true and type(WeaponChamsSettings) == "table" and WeaponChamsSettings.GlowEnabled == true
    local PlayerGlow = Visuals.Player.Chams.Enabled == true and Visuals.Player.Chams.Glow == true
    local PlayerMaterialGlow = Visuals.Player.Material.Enabled == true and tostring(Visuals.Player.Material.Type or "Neon") == "Neon"
    local Enabled = ArmsGlow or WeaponGlow or PlayerGlow or PlayerMaterialGlow
    if not Enabled or not CameraObject then
        if PlayerVisuals.Bloom.Object and PlayerVisuals.Bloom.Object.Parent then PlayerVisuals.Bloom.Object:Destroy() end
        PlayerVisuals.Bloom.Object = nil
        return
    end
    local Bloom = PlayerVisuals.Bloom.Object
    if not Bloom or not Bloom.Parent or Bloom.Parent ~= CameraObject then
        if Bloom and Bloom.Parent then Bloom:Destroy() end
        Bloom = NewInstance("BloomEffect")
        Bloom.Name = "AtramentaBloom"
        Bloom.Parent = CameraObject
        PlayerVisuals.Bloom.Object = Bloom
    end
    local Intensity = 0.72
    local Size = 18
    local Threshold = 0.86
    if ArmsGlow then
        local Strength = Clamp(tonumber(ArmsChamsSettings.GlowStrength) or 1.0, 0.2, 2.5)
        Intensity = Max(Intensity, 0.58 + Strength * 0.48)
        Size = Max(Size, 18 + Strength * 4)
        Threshold = Min(Threshold, 0.74)
    end
    if WeaponGlow then
        local Strength = Clamp(tonumber(WeaponChamsSettings.GlowStrength) or 1.2, 0.2, 2.5)
        Intensity = Max(Intensity, 0.62 + Strength * 0.50)
        Size = Max(Size, 19 + Strength * 4.5)
        Threshold = Min(Threshold, 0.72)
    end
    if PlayerMaterialGlow then
        Intensity = Max(Intensity, 1.08)
        Size = Max(Size, 24)
        Threshold = Min(Threshold, 0.68)
    end
    if PlayerGlow then
        local PlayerIntensity = Clamp(tonumber(Visuals.Player.Chams.GlowStrength) or 1.45, 0.2, 2.5)
        local PlayerSize = Clamp(tonumber(Visuals.Player.Chams.GlowSize) or 30, 8, 48)
        Intensity = Max(Intensity, PlayerIntensity)
        Size = Max(Size, PlayerSize)
        Threshold = Min(Threshold, Clamp(0.78 - (PlayerIntensity - 1) * 0.07, 0.62, 0.82))
    end
    Bloom.Enabled = true
    Bloom.Intensity = Intensity
    Bloom.Size = Size
    Bloom.Threshold = Threshold
end
function PlayerVisuals.Chams.Destroy(Data)
    if not Data then return end
    if type(Data.PlayerChamConnections) == "table" then
        for _, Connection in pairs(Data.PlayerChamConnections) do
