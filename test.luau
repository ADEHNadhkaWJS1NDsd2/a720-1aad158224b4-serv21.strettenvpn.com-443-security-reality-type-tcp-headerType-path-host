            if Ballistic then return {Origin = Origin, Direction = Ballistic.Direction.Unit, TargetPosition = Ballistic.AimPosition, ImpactTargetPosition = Base + Velocity * Ballistic.TravelTime,
                RegistrationPosition = PartSuspicious and (Base + Velocity * Ballistic.TravelTime) or nil, Route = nil, Wallbang = false, Projectile = true,
                ProjectileSpeed = Profile.Speed, ProjectileGravity = Profile.Gravity, ProjectileTravelTime = Ballistic.TravelTime, ProjectileProfile = Profile, ResolverSnapshot = Snapshot} end
