                        end
                    end
                end
            end
        elseif Name == "Distance" then
            Visuals.Player.Distance = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Distance then Data.OverlayPrimitives.Distance.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Distance then Data.UiEsp.Distance.Visible = false end
                end
            end
        elseif Name == "Level" then
            Visuals.Player.Level = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Level then Data.OverlayPrimitives.Level.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Level then Data.UiEsp.Level.Visible = false end
                end
            end
        elseif Name == "Forcefield" then
            Visuals.Player.Forcefield.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Forcefield then Data.OverlayPrimitives.Forcefield.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Forcefield then Data.UiEsp.Forcefield.Visible = false end
                end
            end
        elseif Name == "Flags" then
            Visuals.Player.Flags.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.Flags then Data.OverlayPrimitives.Flags.Visible = false end
                    if Data.UiEsp and Data.UiEsp.Flags then Data.UiEsp.Flags.Visible = false end
                end
            end
        elseif Name == "Skeleton" then
            Visuals.Player.Skeleton.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do HideSkeletonOverlay(Data) end
            end
        elseif Name == "View Direction" then
            Visuals.Player.Look.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.LookLine then Data.OverlayPrimitives.LookLine.Visible = false end
                end
            end
        elseif Name == "Tracer" then
            Visuals.Player.Tracers = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do Shared.HideTracerOverlay(Data) end
            end
        elseif Name == "Offscreen" then
            Visuals.Player.Offscreen.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do HideOffscreenArrowOverlay(Data) end
            end
        elseif Name == "Prediction" then
            Visuals.Player.Prediction.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    if Data.OverlayPrimitives.PredictionMarker then Data.OverlayPrimitives.PredictionMarker.Visible = false end
                    if Data.OverlayPrimitives.PredictionOutline then Data.OverlayPrimitives.PredictionOutline.Visible = false end
                end
            end
        elseif Name == "Box Glow" then
            Visuals.Player.BoxGlow.Enabled = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    for Index = 1, 3 do
                        local Glow = Data.OverlayPrimitives["GlowBox" .. Index]
                        if Glow then Glow.Visible = false end
                    end
                end
            end
        elseif Name == "Health Trail" then
            Visuals.Player.Health.Delayed = Value
            if not Value then
                for _, Data in ipairs(Visuals.Player.List) do
                    Data.DelayedHealthPercent = Data.DisplayedHealthPercent
                    Data.HealthDamageHoldUntil = 0
                    if Data.OverlayPrimitives.HealthDelayed then Data.OverlayPrimitives.HealthDelayed.Visible = false end
                    if Data.UiEsp and Data.UiEsp.HealthDelayed then Data.UiEsp.HealthDelayed.Visible = false end
                end
            end
        end
        local Flag = PlayerESPElementFlags[Name]
        if Flag and type(Library) == "table" and type(Library.Flags) == "table" then Library.Flags[Flag] = Value end
        for _, Data in ipairs(Visuals.Player.List) do
            Data.NextESPStateRefresh = 0
        end
        SyncAtramentaESPPreview()
        EnsureVisualEngine()
    end
    function GetPlayerESPElementSelection()
        local Result = {}
        for _, Name in ipairs(PlayerESPElementNames) do
            local Flag = PlayerESPElementFlags[Name]
            if Flag and type(Library) == "table" and type(Library.Flags) == "table" then
                local State
                if Name == "Box" then State = Visuals.Player.Boxes
                elseif Name == "Fill" then State = Visuals.Player.Fill
                elseif Name == "Name" then State = Visuals.Player.Names
                elseif Name == "Avatar" then State = Visuals.Player.ProfilePicture
                elseif Name == "Health Bar" then State = Visuals.Player.HealthBar
                elseif Name == "Health Text" then State = Visuals.Player.HealthText
                elseif Name == "Weapon" then State = Visuals.Player.Weapon
                elseif Name == "Ammo" then State = Visuals.Player.Ammo.Enabled
                elseif Name == "Distance" then State = Visuals.Player.Distance
                elseif Name == "Level" then State = Visuals.Player.Level
                elseif Name == "Forcefield" then State = Visuals.Player.Forcefield.Enabled
                elseif Name == "Flags" then State = Visuals.Player.Flags.Enabled
                elseif Name == "Skeleton" then State = Visuals.Player.Skeleton.Enabled
                elseif Name == "View Direction" then State = Visuals.Player.Look.Enabled
                elseif Name == "Tracer" then State = Visuals.Player.Tracers
                elseif Name == "Offscreen" then State = Visuals.Player.Offscreen.Enabled
                elseif Name == "Prediction" then State = Visuals.Player.Prediction.Enabled
                elseif Name == "Box Glow" then State = Visuals.Player.BoxGlow.Enabled
                elseif Name == "Health Trail" then State = Visuals.Player.Health.Delayed end
                if State == true then Result[#Result + 1] = Name end
            end
        end
        return Result
    end
    function ApplyPlayerESPElementSelection(Selection)
        local Selected = {}
        if type(Selection) == "table" then
            for _, Name in ipairs(Selection) do Selected[tostring(Name)] = true end
        end
        for _, Name in ipairs(PlayerESPElementNames) do
            ApplyPlayerESPElement(Name, Selected[Name] == true)
        end
    end
    function CreatePlayerESPElementSetter(ElementName, FlagName)
        return function(Value)
            Value = Value == true
            if type(Library) == "table" and type(Library.Flags) == "table" and type(FlagName) == "string" then Library.Flags[FlagName] = Value end
            ApplyPlayerESPElement(ElementName, Value)
        end
    end
    if type(Library.Setters) == "table" then
        for ElementName, FlagName in pairs(PlayerESPElementFlags) do
            Library.Setters[FlagName] = CreatePlayerESPElementSetter(ElementName, FlagName)
        end
    end
