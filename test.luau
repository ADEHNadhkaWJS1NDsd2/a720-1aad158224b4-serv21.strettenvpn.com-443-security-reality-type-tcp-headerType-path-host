function SetupBlur()
    if not AtramentaConfig.Camera.MotionBlur.BlurEffect or not AtramentaConfig.Camera.MotionBlur.BlurEffect.Parent then
        local BlurEffect = NewInstance("BlurEffect")
        BlurEffect.Name = "AtramentaMotionBlur"
        BlurEffect:SetAttribute("AtramentaMotionBlur", true)
        BlurEffect.Size = 0
        BlurEffect.Parent = Lighting
        AtramentaConfig.Camera.MotionBlur.BlurEffect = BlurEffect
    end
    if AtramentaConfig.Camera.MotionBlur.Connection then
        Shared.SafeDisconnect(AtramentaConfig.Camera.MotionBlur.Connection)
        AtramentaConfig.Camera.MotionBlur.Connection = nil
    end
    local State = AtramentaConfig.Camera.MotionBlur
    State.LastLookVector = nil
    State.CurrentLookVector = nil
    State.LastCameraCFrame = nil
    State.RotationSpeed = 0
    State.SmoothedSize = 0
    State.Connection = RunService.RenderStepped:Connect(function(DeltaTime)
        local BlurEffect = State.BlurEffect
        if not State.Enabled or not BlurEffect or not BlurEffect.Parent then return end
        local CameraObject = Shared.GetCamera()
        if not CameraObject then
            State.LastCameraCFrame = nil
            State.RotationSpeed = 0
            State.SmoothedSize = 0
            BlurEffect.Size = 0
            return
        end
        local Delta = Clamp(tonumber(DeltaTime) or 1 / 60, 1 / 240, 1 / 20)
        local CurrentFrame = CameraObject.CFrame
        local LastFrame = State.LastCameraCFrame
        local AngularSpeed = 0
        if typeof(LastFrame) == "CFrame" then
            local Relative = LastFrame:ToObjectSpace(CurrentFrame)
            local X, Y, Z = Relative:ToOrientation()
            local AngularDelta = Sqrt(X * X + Y * Y + Z * Z)
            AngularSpeed = AngularDelta / Delta
        end
        State.LastCameraCFrame = CurrentFrame
        State.CurrentLookVector = CurrentFrame.LookVector
        State.LastLookVector = State.CurrentLookVector
        State.RotationSpeed = AngularSpeed
        local Strength = Clamp(tonumber(State.MotionStrength) or 100, 0, 200) / 100
        local Deadzone = 0.035
        local RawSize = 0
        if AngularSpeed > Deadzone and Strength > 0 then RawSize = Clamp((AngularSpeed - Deadzone) * 3.35 * Strength, 0, 56) end
        local Smooth = Clamp(tonumber(State.MotionSmooth) or 65, 0, 100) / 100
        local CurrentSize = tonumber(State.SmoothedSize) or 0
        local AttackHz = 48 - Smooth * 30
        local ReleaseHz = 22 - Smooth * 18
        local ResponseHz = RawSize > CurrentSize and AttackHz or ReleaseHz
        local Alpha = Smooth <= 0 and 1 or Clamp(1 - Exp(-ResponseHz * Delta), 0, 1)
        State.SmoothedSize = CurrentSize + (RawSize - CurrentSize) * Alpha
        if State.SmoothedSize < 0.015 and RawSize <= 0 then State.SmoothedSize = 0 end
        BlurEffect.Size = Clamp(State.SmoothedSize, 0, 56)
    end)
end
function DisableBlur()
    AtramentaConfig.Camera.MotionBlur.Enabled = false
    if AtramentaConfig.Camera.MotionBlur.Connection then
        Shared.SafeDisconnect(AtramentaConfig.Camera.MotionBlur.Connection)
        AtramentaConfig.Camera.MotionBlur.Connection = nil
    end
    local BlurEffect = AtramentaConfig.Camera.MotionBlur.BlurEffect
    AtramentaConfig.Camera.MotionBlur.BlurEffect = nil
    AtramentaConfig.Camera.MotionBlur.LastLookVector = nil
    AtramentaConfig.Camera.MotionBlur.CurrentLookVector = nil
    AtramentaConfig.Camera.MotionBlur.LastCameraCFrame = nil
    AtramentaConfig.Camera.MotionBlur.RotationSpeed = 0
    AtramentaConfig.Camera.MotionBlur.SmoothedSize = 0
    if BlurEffect then
        Shared.SafeCall(function()
            if BlurEffect:IsA("BlurEffect") then BlurEffect.Size = 0 end
            BlurEffect:Destroy()
        end)
    end
    for _, Object in ipairs(Lighting:GetDescendants()) do
        if Object:IsA("BlurEffect") and (Object.Name == "AtramentaMotionBlur" or Object:GetAttribute("AtramentaMotionBlur") == true) then
            Shared.SafeCall(function() Object:Destroy() end)
        end
    end
end
function ToggleBlur(StateValue)
    AtramentaConfig.Camera.MotionBlur.Enabled = StateValue
    if StateValue then SetupBlur() else DisableBlur() end
end
Camera = {}

function Camera.IsActive()
    local State = AtramentaConfig.Camera.Projection
    return State.FOVEnabled == true or State.ZoomEnabled == true or State.AspectEnabled == true
end

function Camera.GetBaseFOV(CameraObject)
    local State = AtramentaConfig.Camera.Projection
    if State.FOVEnabled == true then
        return Clamp(tonumber(State.FOV) or 90, 40, 120)
    end
    if CameraObject then
        local Saved = State.SavedValues[CameraObject]
        if type(Saved) == "number" then
            return Clamp(Saved, 5, 120)
        end
    end
    return Clamp(tonumber(State.SavedValue) or 70, 5, 120)
end

function Camera.GetAspectOverlay()

    local State = AtramentaConfig.Camera.Projection
    if State.AspectGui and State.AspectGui.Parent then Shared.SafeCall(State.AspectGui.Destroy, State.AspectGui) end
    State.AspectGui = nil
    State.AspectFrames = nil
    return nil, nil
end

function Camera.RestoreAspectCFrame(CameraObject)
    local State = AtramentaConfig.Camera.Projection
    CameraObject = CameraObject or Shared.GetCamera()
    if not CameraObject then
        State.AspectBaseCFrame = nil
        State.AspectAppliedCFrame = nil
        return
    end
    local Applied = State.AspectAppliedCFrame
    local Base = State.AspectBaseCFrame
    if typeof(Applied) == "CFrame" and typeof(Base) == "CFrame" and CameraObject.CFrame == Applied then CameraObject.CFrame = Base end
    State.AspectBaseCFrame = nil
    State.AspectAppliedCFrame = nil
end

function Camera.UpdateAspectOverlay(CameraObject)
    local State = AtramentaConfig.Camera.Projection
    if State.AspectGui and State.AspectGui.Parent then Shared.SafeCall(State.AspectGui.Destroy, State.AspectGui) end
    State.AspectGui = nil
    State.AspectFrames = nil
    CameraObject = CameraObject or Shared.GetCamera()
    if not CameraObject then
        State.AspectBaseCFrame = nil
        State.AspectAppliedCFrame = nil
        return
    end
    if State.AspectEnabled ~= true then
        Camera.RestoreAspectCFrame(CameraObject)
        return
    end
    local Resolution = Clamp(tonumber(State.AspectRatio) or 1, 0.50, 1.50)
    local Current = CameraObject.CFrame
    local PreviousApplied = State.AspectAppliedCFrame
    local PreviousBase = State.AspectBaseCFrame
    local BaseCFrame
    if typeof(PreviousApplied) == "CFrame" and typeof(PreviousBase) == "CFrame" and Current == PreviousApplied then
        BaseCFrame = PreviousBase
    else
        BaseCFrame = Current
    end
    State.AspectBaseCFrame = BaseCFrame
    if Abs(Resolution - 1) <= 0.0001 then
        CameraObject.CFrame = BaseCFrame
        State.AspectAppliedCFrame = BaseCFrame
        return
    end
    local AppliedCFrame = BaseCFrame * NewCFrame(0, 0, 0, 1, 0, 0, 0, Resolution, 0, 0, 0, 1)
    CameraObject.CFrame = AppliedCFrame
    State.AspectAppliedCFrame = AppliedCFrame
end

function Camera.DestroyAspectOverlay()
    local State = AtramentaConfig.Camera.Projection
    Camera.RestoreAspectCFrame(Shared.GetCamera())
    if State.AspectGui and State.AspectGui.Parent then Shared.SafeCall(State.AspectGui.Destroy, State.AspectGui) end
    State.AspectGui = nil
    State.AspectFrames = nil
end

function Camera.GetDesiredFOV(CameraObject)
    local State = AtramentaConfig.Camera.Projection
    local FOV = Camera.GetBaseFOV(CameraObject)
    if State.ZoomEnabled == true then
        local Zoom = Clamp(tonumber(State.Zoom) or 2, 1, 8)
        local HalfFOV = Rad(FOV) * 0.5
        FOV = Deg(2 * Atan(Tan(HalfFOV) / Zoom))
    end
    return Clamp(FOV, 5, 120)
end

function Camera.DisconnectWatcher()
    local State = AtramentaConfig.Camera.Projection
    if State.ChangeConnection then
        Shared.SafeDisconnect(State.ChangeConnection)
        State.ChangeConnection = nil
    end
    State.Camera = nil
end

function Camera.BindWatcher(CameraObject)
    if not CameraObject then return end
    local State = AtramentaConfig.Camera.Projection
    if State.Camera == CameraObject and State.ChangeConnection then return end
    Camera.DisconnectWatcher()
    State.Camera = CameraObject
    if State.SavedValues[CameraObject] == nil then State.SavedValues[CameraObject] = CameraObject.FieldOfView end
    State.ChangeConnection = CameraObject:GetPropertyChangedSignal("FieldOfView"):Connect(function()
        if not Camera.IsActive() or State.Applying then return end
        if State.FOVEnabled ~= true then
            local Desired = Camera.GetDesiredFOV(CameraObject)
            if Abs(CameraObject.FieldOfView - Desired) > 0.01 then
                State.SavedValues[CameraObject] = CameraObject.FieldOfView
                State.SavedValue = CameraObject.FieldOfView
            end
        end
        Camera.Update()
    end)
end

function Camera.Update()
    if not Camera.IsActive() then return end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return end
    local State = AtramentaConfig.Camera.Projection
    if State.SavedValues[CameraObject] == nil then
        State.SavedValues[CameraObject] = CameraObject.FieldOfView
        State.SavedValue = CameraObject.FieldOfView
    end
    Camera.BindWatcher(CameraObject)
    local Desired = Camera.GetDesiredFOV(CameraObject)
    if Abs(CameraObject.FieldOfView - Desired) > 0.001 then
        State.Applying = true
        CameraObject.FieldOfView = Desired
        State.Applying = false
    end
    Camera.UpdateAspectOverlay(CameraObject)
end

function Camera.Refresh()
    local State = AtramentaConfig.Camera.Projection
    local CameraObject = Shared.GetCamera()
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep(State.BindName)
    end)
    Camera.GetAspectOverlay()
    if Camera.IsActive() then
        if CameraObject then
            if State.SavedValues[CameraObject] == nil then State.SavedValues[CameraObject] = CameraObject.FieldOfView end
            State.SavedValue = State.SavedValues[CameraObject]
            Camera.BindWatcher(CameraObject)
        end
        RunService:BindToRenderStep(State.BindName, Enum.RenderPriority.Last.Value, Camera.Update)
        Camera.Update()
        return
    end
    Camera.DisconnectWatcher()
    if CameraObject then
        local Saved = State.SavedValues[CameraObject]
        if Saved == nil then Saved = State.SavedValue end
        if type(Saved) == "number" then
            State.Applying = true
            Shared.SafeCall(function()
                CameraObject.FieldOfView = Saved
            end)
            State.Applying = false
        end
    end
    State.SavedValue = nil
    State.Applying = false
end

function Camera.SetFOVEnabled(Enabled)
    AtramentaConfig.Camera.Projection.FOVEnabled = Enabled == true
    Camera.Refresh()
end

function Camera.SetZoomEnabled(Enabled)
    AtramentaConfig.Camera.Projection.ZoomEnabled = Enabled == true
    Camera.Refresh()
end

function Camera.SetAspectEnabled(Enabled)
    local State = AtramentaConfig.Camera.Projection
    local NewValue = Enabled == true
    if NewValue ~= true then Camera.RestoreAspectCFrame(Shared.GetCamera()) end
    State.AspectEnabled = NewValue
    Camera.Refresh()
end

MainEnvironment.Camera = Camera

function DisconnectFreecamInputs()
    for _, Connection in ipairs(AtramentaConfig.Camera.Freecam.InputConnections) do
        Shared.SafeCall(function()
            Shared.SafeDisconnect(Connection)
        end)
    end
    AtramentaConfig.Camera.Freecam.InputConnections = {}
end
function AddFreecamInputConnection(Connection)
    AtramentaConfig.Camera.Freecam.InputConnections[#AtramentaConfig.Camera.Freecam.InputConnections + 1] = Connection
    return Connection
end
function ApplyFreecamMouseState()
    if AtramentaConfig.Camera.Freecam.OnMobile then return end
    if not AtramentaConfig.Camera.Freecam.Enabled then return end
    if AtramentaConfig.Camera.Freecam.Rotating then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled = false
    else
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end
end
function ResolveFreecamMouseRestore(SavedCameraMode)
    if SavedCameraMode == Enum.CameraMode.LockFirstPerson then return Enum.MouseBehavior.LockCenter, false end
    return Enum.MouseBehavior.Default, true
end
function ReleaseFreecamCharacter(Saved)
    local Character = LocalPlayer.Character
    local CurrentRoot = Character and (Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso"))
    if Saved and Saved.RootPart and Saved.RootPart.Parent then
        Saved.RootPart.Anchored = false
        Saved.RootPart.AssemblyLinearVelocity = EmptyVector3
        Saved.RootPart.AssemblyAngularVelocity = EmptyVector3
    end
    if CurrentRoot and CurrentRoot.Parent then
        CurrentRoot.Anchored = false
        CurrentRoot.AssemblyLinearVelocity = EmptyVector3
        CurrentRoot.AssemblyAngularVelocity = EmptyVector3
    end
end
function ForceRestorePlayerCamera(Saved, RestoreTransform)
    local CameraObject = Shared.GetCamera() local Character = LocalPlayer.Character local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    ReleaseFreecamCharacter(Saved)
    if Saved.MinZoom ~= nil then LocalPlayer.CameraMinZoomDistance = Saved.MinZoom end
    if Saved.MaxZoom ~= nil then LocalPlayer.CameraMaxZoomDistance = Saved.MaxZoom end
    local Mode = Saved.CameraMode or Enum.CameraMode.Classic
    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    if CameraObject then
        local Subject = Saved.Subject
        if not Subject or not Subject.Parent then Subject = Humanoid end
        CameraObject.CameraType = Enum.CameraType.Custom
        if Subject then CameraObject.CameraSubject = Subject end
        if Saved.FOV then CameraObject.FieldOfView = Saved.FOV end
        if RestoreTransform ~= false then
            if typeof(Saved.CameraCFrame) == "CFrame" then CameraObject.CFrame = Saved.CameraCFrame end
            if typeof(Saved.CameraFocus) == "CFrame" then CameraObject.Focus = Saved.CameraFocus end
        end
    end
    LocalPlayer.CameraMode = Mode
    local Behavior, Icon = ResolveFreecamMouseRestore(Mode)
    UserInputService.MouseBehavior = Behavior UserInputService.MouseIconEnabled = Icon
    return Mode
end
function RestoreFreecamCameraState(Saved, Token)
    if AtramentaConfig.Camera.Freecam.Enabled or AtramentaConfig.Camera.Freecam.MouseRestoreToken ~= Token then return end
    local Mode = ForceRestorePlayerCamera(Saved, true)
    Spawn(function()
        RunService.RenderStepped:Wait()
        if AtramentaConfig.Camera.Freecam.Enabled or AtramentaConfig.Camera.Freecam.MouseRestoreToken ~= Token then return end
        local CameraObject = Shared.GetCamera() local Character = LocalPlayer.Character local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        ReleaseFreecamCharacter(Saved)
        if CameraObject then
            local Subject = Saved.Subject
            if not Subject or not Subject.Parent then Subject = Humanoid end
            CameraObject.CameraType = Enum.CameraType.Custom
            if Subject then CameraObject.CameraSubject = Subject end
            if Saved.FOV then CameraObject.FieldOfView = Saved.FOV end
        end
        LocalPlayer.CameraMode = Mode
        if Mode == Enum.CameraMode.LockFirstPerson then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
        end
        RunService.RenderStepped:Wait()
        if AtramentaConfig.Camera.Freecam.Enabled or AtramentaConfig.Camera.Freecam.MouseRestoreToken ~= Token then return end
        ReleaseFreecamCharacter(Saved)
        if Mode ~= Enum.CameraMode.LockFirstPerson then
            local CurrentCamera = Shared.GetCamera() local Distance = CurrentCamera and (CurrentCamera.CFrame.Position - CurrentCamera.Focus.Position).Magnitude or Infinite
            if Distance > 1.05 then
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                UserInputService.MouseIconEnabled = true
            end
        end
        AtramentaConfig.Camera.Freecam.StartedFirstPerson = false
        AtramentaConfig.Camera.Freecam.SavedCameraMode = nil
        AtramentaConfig.Camera.Freecam.SavedMinZoom = nil
        AtramentaConfig.Camera.Freecam.SavedMaxZoom = nil
        AtramentaConfig.Camera.Freecam.SavedMouseBehavior = nil
        AtramentaConfig.Camera.Freecam.SavedMouseIconEnabled = nil
        AtramentaConfig.Camera.Freecam.SavedCameraType = nil
        AtramentaConfig.Camera.Freecam.SavedCameraSubject = nil
        AtramentaConfig.Camera.Freecam.SavedCameraCFrame = nil
        AtramentaConfig.Camera.Freecam.SavedCameraFocus = nil
        AtramentaConfig.Camera.Freecam.SavedFieldOfView = nil
        AtramentaConfig.Camera.Freecam.SavedRootAnchored = nil
        AtramentaConfig.Camera.Freecam.SavedRootPart = nil
    end)
end
function SetFreecamRotationState(State)
    AtramentaConfig.Camera.Freecam.Rotating = State == true
    AtramentaConfig.Camera.Freecam.MouseDelta = EmptyVector2
    ApplyFreecamMouseState()
end
function GetFreecamMovementVector(CameraFrame)
    local Move = EmptyVector3 local Keys = AtramentaConfig.Camera.Freecam.KeysDown
    if UserInputService:IsKeyDown(Enum.KeyCode.W) or Keys[Enum.KeyCode.W] then
        Move += CameraFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) or Keys[Enum.KeyCode.S] then
        Move -= CameraFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) or Keys[Enum.KeyCode.A] then
        Move -= CameraFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) or Keys[Enum.KeyCode.D] then
        Move += CameraFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) or Keys[Enum.KeyCode.E] or Keys[Enum.KeyCode.Space] then
        Move += Vector3.yAxis
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or Keys[Enum.KeyCode.Q] or Keys[Enum.KeyCode.LeftControl] then
        Move -= Vector3.yAxis
    end
    if Move.Magnitude > 0 then return Move.Unit end
    return EmptyVector3
end
function UpdateFreecam(DeltaTime)
    if not AtramentaConfig.Camera.Freecam.Enabled then return end
    local CameraObject = Shared.GetCamera()
    if not CameraObject then
        ToggleFreecam(false)
        return
    end
    DeltaTime = Clamp(tonumber(DeltaTime) or 0, 0, 1 / 30)
    if LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson then LocalPlayer.CameraMode = Enum.CameraMode.Classic end
    CameraObject.CameraType = Enum.CameraType.Scriptable
    if AtramentaConfig.Camera.Freecam.Rotating ~= AtramentaConfig.Camera.Freecam.RightMouseDown then SetFreecamRotationState(AtramentaConfig.Camera.Freecam.RightMouseDown) end
    if AtramentaConfig.Camera.Freecam.Rotating then
        local Delta = UserInputService:GetMouseDelta()
        if AtramentaConfig.Camera.Freecam.MouseDelta.Magnitude > Delta.Magnitude then Delta = AtramentaConfig.Camera.Freecam.MouseDelta end
        AtramentaConfig.Camera.Freecam.MouseDelta = EmptyVector2
        local Sensitivity = Clamp(tonumber(AtramentaConfig.Camera.Freecam.Sensitivity) or 0.18, 0.10, 0.50) local RotationScale = Rad(Sensitivity)
        AtramentaConfig.Camera.Freecam.Yaw -= Delta.X * RotationScale
        AtramentaConfig.Camera.Freecam.Pitch = Clamp(AtramentaConfig.Camera.Freecam.Pitch - Delta.Y * RotationScale, Rad(-89), Rad(89))
    else
        AtramentaConfig.Camera.Freecam.MouseDelta = EmptyVector2
    end
    local RotationFrame = Angles(0, AtramentaConfig.Camera.Freecam.Yaw, 0) * Angles(AtramentaConfig.Camera.Freecam.Pitch, 0, 0)
    local MovementVector = GetFreecamMovementVector(RotationFrame) local Speed = Clamp(tonumber(AtramentaConfig.Camera.Freecam.Speed) or 100, 100, 500)
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then Speed *= Clamp(tonumber(AtramentaConfig.Camera.Freecam.BoostMultiplier) or 2, 1, 3) end
    local TargetVelocity = MovementVector * Speed local Acceleration = Clamp(tonumber(AtramentaConfig.Camera.Freecam.Acceleration) or 14, 1, 30)
    local Alpha = 1 - Exp(-Acceleration * DeltaTime)
    if MovementVector.Magnitude > 0 then
        AtramentaConfig.Camera.Freecam.Velocity = AtramentaConfig.Camera.Freecam.Velocity:Lerp(TargetVelocity, Alpha)
        if AtramentaConfig.Camera.Freecam.Velocity.Magnitude > Speed and AtramentaConfig.Camera.Freecam.Velocity.Magnitude > 0 then
            AtramentaConfig.Camera.Freecam.Velocity = AtramentaConfig.Camera.Freecam.Velocity.Unit * Speed
        end
    else
        AtramentaConfig.Camera.Freecam.Velocity = AtramentaConfig.Camera.Freecam.Velocity:Lerp(EmptyVector3, Clamp(Alpha * 1.35, 0, 1))
    end
    AtramentaConfig.Camera.Freecam.Position += AtramentaConfig.Camera.Freecam.Velocity * DeltaTime
    local CameraFrame = NewCFrame(AtramentaConfig.Camera.Freecam.Position) * RotationFrame
    CameraObject.CFrame = CameraFrame
    CameraObject.Focus = NewCFrame(AtramentaConfig.Camera.Freecam.Position + CameraFrame.LookVector * 512)
    ApplyFreecamMouseState()
end
function SetupFreecam()
    local CameraObject = Shared.GetCamera()
    if not CameraObject then
        AtramentaConfig.Camera.Freecam.Enabled = false
        return
    end
    DisconnectFreecamInputs()
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep("AtramentaFreecam")
    end)
    AtramentaConfig.Camera.Freecam.SavedCameraType = CameraObject.CameraType
    AtramentaConfig.Camera.Freecam.SavedCameraSubject = CameraObject.CameraSubject
    AtramentaConfig.Camera.Freecam.SavedCameraCFrame = CameraObject.CFrame
    AtramentaConfig.Camera.Freecam.SavedCameraFocus = CameraObject.Focus
    AtramentaConfig.Camera.Freecam.SavedFieldOfView = CameraObject.FieldOfView
    AtramentaConfig.Camera.Freecam.SavedMouseBehavior = UserInputService.MouseBehavior
    AtramentaConfig.Camera.Freecam.SavedMouseIconEnabled = UserInputService.MouseIconEnabled
    AtramentaConfig.Camera.Freecam.SavedCameraMode = LocalPlayer.CameraMode
    AtramentaConfig.Camera.Freecam.SavedMinZoom = LocalPlayer.CameraMinZoomDistance
    AtramentaConfig.Camera.Freecam.SavedMaxZoom = LocalPlayer.CameraMaxZoomDistance
    local CameraDistance = (CameraObject.CFrame.Position - CameraObject.Focus.Position).Magnitude
    AtramentaConfig.Camera.Freecam.StartedFirstPerson = LocalPlayer.CameraMode
            == Enum.CameraMode.LockFirstPerson or CameraDistance <= 1.05 or (tonumber(AtramentaConfig.Camera.Freecam.SavedMinZoom) ~= nil
            and tonumber(AtramentaConfig.Camera.Freecam.SavedMaxZoom) ~= nil and AtramentaConfig.Camera.Freecam.SavedMinZoom <= 0.6 and AtramentaConfig.Camera.Freecam.SavedMaxZoom <= 0.6)
    AtramentaConfig.Camera.Freecam.MouseRestoreToken += 1
    AtramentaConfig.Camera.Freecam.Position = CameraObject.CFrame.Position
    local Pitch, Yaw = CameraObject.CFrame:ToOrientation()
    AtramentaConfig.Camera.Freecam.Pitch = Clamp(Pitch, Rad(-89), Rad(89))
    AtramentaConfig.Camera.Freecam.Yaw = Yaw
    AtramentaConfig.Camera.Freecam.Velocity = EmptyVector3
    AtramentaConfig.Camera.Freecam.MouseDelta = EmptyVector2
    AtramentaConfig.Camera.Freecam.KeysDown = {}
    AtramentaConfig.Camera.Freecam.Rotating = false
    AtramentaConfig.Camera.Freecam.RightMouseDown = false
    local Character = LocalPlayer.Character local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    AtramentaConfig.Camera.Freecam.SavedRootPart = RootPart
    if RootPart then
        AtramentaConfig.Camera.Freecam.SavedRootAnchored = RootPart.Anchored
        RootPart.Anchored = true
    else
        AtramentaConfig.Camera.Freecam.SavedRootAnchored = nil
    end
    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    CameraObject.CameraType = Enum.CameraType.Scriptable
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    AddFreecamInputConnection(UserInputService.InputBegan:Connect(function(Input)
            if not AtramentaConfig.Camera.Freecam.Enabled then return end
            if Input.UserInputType == Enum.UserInputType.MouseButton2 then
                AtramentaConfig.Camera.Freecam.RightMouseDown = true
                SetFreecamRotationState(true)
            elseif Input.KeyCode == Enum.KeyCode.W or Input.KeyCode == Enum.KeyCode.A or Input.KeyCode == Enum.KeyCode.S or Input.KeyCode == Enum.KeyCode.D
                or Input.KeyCode == Enum.KeyCode.Q or Input.KeyCode == Enum.KeyCode.E or Input.KeyCode == Enum.KeyCode.Space or Input.KeyCode == Enum.KeyCode.LeftControl then
                AtramentaConfig.Camera.Freecam.KeysDown[Input.KeyCode] = true
            end
        end))
    AddFreecamInputConnection(UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton2 then
                AtramentaConfig.Camera.Freecam.RightMouseDown = false
                SetFreecamRotationState(false)
            elseif Input.KeyCode ~= Enum.KeyCode.Unknown then
                AtramentaConfig.Camera.Freecam.KeysDown[Input.KeyCode] = nil
            end
        end))
    AddFreecamInputConnection(UserInputService.InputChanged:Connect(function(Input)
            if not AtramentaConfig.Camera.Freecam.Enabled then return end
            if Input.UserInputType == Enum.UserInputType.MouseMovement and AtramentaConfig.Camera.Freecam.Rotating then
                AtramentaConfig.Camera.Freecam.MouseDelta += NewVector2(Input.Delta.X, Input.Delta.Y)
            end
        end))
    Shared.SafeCall(function()
        AddFreecamInputConnection(UserInputService.WindowFocusReleased:Connect(function()
                AtramentaConfig.Camera.Freecam.RightMouseDown = false
                SetFreecamRotationState(false)
            end))
    end)
    RunService:BindToRenderStep("AtramentaFreecam", Enum.RenderPriority.Camera.Value + 100, UpdateFreecam)
    ApplyFreecamMouseState()
end
function DisableFreecam()
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep("AtramentaFreecam")
    end)
    DisconnectFreecamInputs()
    AtramentaConfig.Camera.Freecam.RightMouseDown = false
    AtramentaConfig.Camera.Freecam.Rotating = false
    AtramentaConfig.Camera.Freecam.MouseDelta = EmptyVector2
    AtramentaConfig.Camera.Freecam.KeysDown = {}
    AtramentaConfig.Camera.Freecam.Velocity = EmptyVector3
    AtramentaConfig.Camera.Freecam.MouseRestoreToken += 1
    local Token = AtramentaConfig.Camera.Freecam.MouseRestoreToken
    local Saved = {CameraType = AtramentaConfig.Camera.Freecam.SavedCameraType, Subject = AtramentaConfig.Camera.Freecam.SavedCameraSubject, FOV = AtramentaConfig.Camera.Freecam.SavedFieldOfView,
        CameraCFrame = AtramentaConfig.Camera.Freecam.SavedCameraCFrame, CameraFocus = AtramentaConfig.Camera.Freecam.SavedCameraFocus, CameraMode = AtramentaConfig.Camera.Freecam.SavedCameraMode,
        MinZoom = AtramentaConfig.Camera.Freecam.SavedMinZoom, MaxZoom = AtramentaConfig.Camera.Freecam.SavedMaxZoom, RootAnchored = AtramentaConfig.Camera.Freecam.SavedRootAnchored, RootPart = AtramentaConfig.Camera.Freecam.SavedRootPart,
        WasFirstPerson = AtramentaConfig.Camera.Freecam.StartedFirstPerson == true}
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    ReleaseFreecamCharacter(Saved)
    ForceRestorePlayerCamera(Saved, true)
    RestoreFreecamCameraState(Saved, Token)
    AtramentaConfig.Camera.Freecam.Position = nil
    if AtramentaConfig.Camera.Projection and AtramentaConfig.Camera.Projection.FOVEnabled then Camera.Update() end
end
function ToggleFreecam(State)
    State = State == true
    if State == AtramentaConfig.Camera.Freecam.Enabled then return end
    if State and ProjectileController and ProjectileController.CurrentObject then ProjectileController:Release() end
    if State then
        AtramentaConfig.Camera.Freecam.Enabled = true
        SetupFreecam()
    else
        AtramentaConfig.Camera.Freecam.Enabled = false
        DisableFreecam()
    end
end
Shared.SafeCall(function()
    RunService:UnbindFromRenderStep("AtramentaFreecam")
    if AtramentaConfig.Camera.Freecam.Enabled then return end
    local Character = LocalPlayer.Character local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    if RootPart and RootPart.Anchored then RootPart.Anchored = false end
end)
PreviousGunMods = rawget(Environment, "GunMods")
if type(PreviousGunMods) == "table" then
    if type(PreviousGunMods.ConfigOriginals) == "table" then
        for Config, Snapshot in pairs(PreviousGunMods.ConfigOriginals) do
            if type(Config) == "table" and type(Snapshot) == "table" and type(Snapshot.Entries) == "table" then
                for Index = 1, #Snapshot.Entries do
