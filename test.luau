SharedAuraTick = 0

MeleeAuraRuntime = type(MeleeAuraRuntime) == "table" and MeleeAuraRuntime or {}

MeleeAuraRuntime.Revision = 4
MeleeAuraRuntime.Busy = false
MeleeAuraRuntime.ConfigResolver = nil
MeleeAuraRuntime.ConfigModule = nil

MeleeAuraRuntime.ConfigCache = type(MeleeAuraRuntime.ConfigCache) == "table" and MeleeAuraRuntime.ConfigCache or setmetatable({}, {__mode = "k"})

MeleeAuraRuntime.ConfigRetryAt = type(MeleeAuraRuntime.ConfigRetryAt) == "table" and MeleeAuraRuntime.ConfigRetryAt or setmetatable({}, {__mode = "k"})

MeleeAuraRuntime.ToolStates = type(MeleeAuraRuntime.ToolStates) == "table" and MeleeAuraRuntime.ToolStates or setmetatable({}, {__mode = "k"})

function GetMeleeAuraConfigResolver()
    local Runtime = MeleeAuraRuntime
    local NewModules = ReplicatedStorage:FindFirstChild("NewModules")
    local SharedModules = NewModules and NewModules:FindFirstChild("Shared")
    local Extensions = SharedModules and SharedModules:FindFirstChild("Extensions")
    local Module = Extensions and Extensions:FindFirstChild("GetConfig")
    if not Module then
        Runtime.ConfigResolver = nil
        Runtime.ConfigModule = nil
        return nil
    end
    if Runtime.ConfigModule == Module and type(Runtime.ConfigResolver) == "function" then
        return Runtime.ConfigResolver
    end
    local Success, Resolver = Shared.SafeCall(require, Module)
    if not Success or type(Resolver) ~= "function" then
        Runtime.ConfigResolver = nil
        Runtime.ConfigModule = Module
        return nil
    end
    Runtime.ConfigResolver = Resolver
    Runtime.ConfigModule = Module
    return Resolver
end

function IsMeleeAuraConfig(Config)
    if type(Config) ~= "table" or type(Config.Mains) ~= "table" then
        return false
    end
    local SlashStages = Clamp(Floor(tonumber(Config.SlashStages) or 16), 1, 32)
    for Index = 1, SlashStages do
        if type(Config.Mains["S" .. tostring(Index)]) == "table" then
            return true
        end
    end
    for Key, Value in pairs(Config.Mains) do
        if type(Key) == "string" and Key:match("^S%d+$") and type(Value) == "table" then
            return true
        end
    end
    return false
end

function GetMeleeAuraDirectConfigModule(Tool)
    if not Tool or not Tool:IsA("Tool") then
        return nil
    end
    local Direct = Tool:FindFirstChild("Config")
    if Direct and Direct:IsA("ModuleScript") then
        return Direct
    end
    local Nested = Tool:FindFirstChild("Config", true)
    if Nested and Nested:IsA("ModuleScript") then
        return Nested
    end
    return nil
end

function GetMeleeAuraConfig(Tool)
    if not Tool or not Tool:IsA("Tool") or not Tool.Parent then
        return nil
    end
    local Runtime = MeleeAuraRuntime
    local Cached = Runtime.ConfigCache[Tool]
    if IsMeleeAuraConfig(Cached) then
        return Cached
    end
    local CurrentTime = Clock()
    local RetryAt = tonumber(Runtime.ConfigRetryAt[Tool]) or 0
    if CurrentTime < RetryAt then
        return nil
    end
    local ConfigModule = GetMeleeAuraDirectConfigModule(Tool)
    if ConfigModule then
        local Success, Config = Shared.SafeCall(require, ConfigModule)
        if Success and IsMeleeAuraConfig(Config) then
            Runtime.ConfigCache[Tool] = Config
            Runtime.ConfigRetryAt[Tool] = nil
            return Config
        end
    end
    local Resolver = GetMeleeAuraConfigResolver()
    if type(Resolver) == "function" then
        local Success, Config = Shared.SafeCall(Resolver, Tool)
        if Success and IsMeleeAuraConfig(Config) then
            Runtime.ConfigCache[Tool] = Config
            Runtime.ConfigRetryAt[Tool] = nil
            return Config
        end
    end
    Runtime.ConfigRetryAt[Tool] = CurrentTime + 1.25
    return nil
end

function GetMeleeAuraProtocolKey()
    return tick()
end

function GetMeleeAuraToolState(Tool)
    local States = MeleeAuraRuntime.ToolStates
    local State = States[Tool]
    if type(State) ~= "table" then
        State = {LastAttackAt = 0, NextAttackAt = 0, LastToken = nil, LastStage = 0, HitTokens = {}}
        States[Tool] = State
    end
    if type(State.HitTokens)
        ~= "table" then
        State.HitTokens = {}
    end
    return State
end

function ResolveMeleeAuraPartObject(Object)
    if not Object then
        return nil
    end
    if Object:IsA("BasePart") then
        return Object
    end
    if Object:IsA("Model") then
        local Primary = Object.PrimaryPart
        if Primary and Primary:IsA("BasePart") then
            return Primary
        end
        return Object:FindFirstChildWhichIsA("BasePart", true)
    end
    if Object:IsA("Accessory") or Object:IsA("Tool") then
        local Handle = Object:FindFirstChild("Handle", true)
        if Handle and Handle:IsA("BasePart") then
            return Handle
        end
        return Object:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

function ResolveMeleeAuraReference(Reference, Tool, Character)
    if typeof(Reference) == "Instance" then
        return ResolveMeleeAuraPartObject(Reference)
    end
    if type(Reference) == "string" then
        local Object = Tool and Tool:FindFirstChild(Reference, true)
        local Part = ResolveMeleeAuraPartObject(Object)
        if Part then
            return Part
        end
        Object = Character and Character:FindFirstChild(Reference, true)
        return ResolveMeleeAuraPartObject(Object)
    end
    if type(Reference) ~= "table" then
        return nil
    end
    local Scope = tostring(Reference[1] or Reference.Scope or "")
    local Name = Reference[2] or Reference.Name
    if type(Name) ~= "string" or Name == "" then
        return nil
    end
    local Container
    if Scope == "Tool" then
        Container = Tool
    elseif Scope == "Char" or Scope == "Character" then
        Container = Character
    end
    if not Container then
        return nil
    end
    local Object = Container:FindFirstChild(Name) or Container:FindFirstChild(Name, true)
    return ResolveMeleeAuraPartObject(Object)
end

function GetMeleeAuraStageConfig(Config, ServerStage, ToolState)
    if type(Config) ~= "table" or type(Config.Mains) ~= "table" then
        return nil, nil
    end
    local Stage = tonumber(ServerStage)
    if Stage then
        Stage = Floor(Stage)
        local Exact = Config.Mains["S" .. tostring(Stage)]
        if type(Exact) == "table" then
            ToolState.LastStage = Stage
            return Exact, Stage
        end
    end
    local SlashStages = Clamp(Floor(tonumber(Config.SlashStages) or 8), 1, 16)
    local Previous = Max(Floor(tonumber(ToolState.LastStage) or 0), 0)
    for Offset = 1, SlashStages do
        local CandidateIndex = (Previous + Offset - 1) % SlashStages + 1
        local Candidate = Config.Mains["S" .. tostring(CandidateIndex)]
        if type(Candidate) == "table" then
            ToolState.LastStage = CandidateIndex
            return Candidate, CandidateIndex
        end
    end
    local Keys = {}
    for Key, Value in pairs(Config.Mains) do
        if type(Key) == "string" and Key:match("^S%d+$") and type(Value) == "table" then Keys[#Keys + 1] = Key end
    end
    Sort(Keys,
        function(A, B)
            return (tonumber(A:match("%d+")) or 0)
                < (tonumber(B:match("%d+")) or 0)
        end)
    local Key = Keys[1]
    if not Key then
        return nil, nil
    end
    local Index = tonumber(Key:match("%d+")) or 1
    ToolState.LastStage = Index
    return Config.Mains[Key], Index
end

function ResolveMeleeAuraHitter(Config, StageConfig, Tool, Character)
    local Hitter = StageConfig and ResolveMeleeAuraReference(StageConfig.Hitter, Tool, Character)
    if Hitter then
        return Hitter
    end
    Hitter = Config and ResolveMeleeAuraReference(Config.Handle, Tool, Character)
    if Hitter then
        return Hitter
    end
    local ToolNames = {"WeaponHandle", "Handle", "HHandle", "Hitbox", "Blade"}
    for Index = 1, #ToolNames do
        local Part = Tool:FindFirstChild(ToolNames[Index], true)
        if Part and Part:IsA("BasePart") then
            return Part
        end
    end
    local CharacterNames = {"Right Arm", "Left Arm", "RightHand", "LeftHand", "UpperTorso", "Torso", "HumanoidRootPart"}
    for Index = 1, #CharacterNames do
        local Part = Character:FindFirstChild(CharacterNames[Index])
        if Part and Part:IsA("BasePart") then
            return Part
        end
    end
    return nil
end

function GetMeleeAuraTargetPart(Character, Hitter)
    if not Character then
        return nil
    end
    local Names = {"Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm",
        "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
    local Best
    local BestDistance = Infinite
    local HitterPosition = Hitter and Hitter:IsA("BasePart") and Hitter.Position or nil
    for Index = 1, #Names do
        local Part = Character:FindFirstChild(Names[Index])
        if Part and Part:IsA("BasePart") and Part.Transparency < 1 then
            if not HitterPosition then
                return Part
            end
            local Distance = (HitterPosition - Part.Position).Magnitude
            if Distance < BestDistance then
                BestDistance = Distance
                Best = Part
            end
        end
    end
    return Best or Character:FindFirstChild("Torso") or Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Head") or Character:FindFirstChild(
            "HumanoidRootPart")
end

function GetMeleeAuraTarget(RootPart)
    if not RootPart then
        return nil
    end
    local BestPlayer
    local BestCharacter
    local BestRoot
    local BestDistance = Infinite
    local BestTier = -1
    local MaximumDistance = Clamp(tonumber(MeleeAuraDistance) or 15, 1, 15)
    for _, PlayerObject in ipairs(Players:GetPlayers()) do
        if not IsCombatTargetAllowed(PlayerObject) then
            continue
        end
        local TargetCharacter = PlayerObject.Character
        local TargetRoot = TargetCharacter and TargetCharacter:FindFirstChild("HumanoidRootPart")
        local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass("Humanoid")
        if not TargetRoot or not TargetRoot:IsA("BasePart") or not TargetHumanoid or TargetHumanoid.Health <= 0 or TargetCharacter:FindFirstChildOfClass("ForceField") then
            continue
        end
        local Distance = (RootPart.Position - TargetRoot.Position).Magnitude
        if Distance > MaximumDistance then
            continue
        end
        local Tier = GetCombatTargetPriority(PlayerObject)
        if Tier > BestTier or (Tier == BestTier and Distance < BestDistance) then
            BestTier = Tier
            BestDistance = Distance
            BestPlayer = PlayerObject
            BestCharacter = TargetCharacter
            BestRoot = TargetRoot
        end
    end
    if not BestPlayer then
        return nil
    end
    return {Player = BestPlayer, Character = BestCharacter, Root = BestRoot, Distance = BestDistance, MaximumDistance = MaximumDistance}
end

function IsMeleeAuraTargetStillValid(TargetData, RootPart, Hitter)
    if type(TargetData) ~= "table" or not RootPart or not RootPart.Parent then
        return false
    end
    local PlayerObject = TargetData.Player
    local Character = TargetData.Character
    if not PlayerObject or PlayerObject.Parent ~= Players or not Character or not Character.Parent or PlayerObject.Character ~= Character or not IsCombatTargetAllowed(
            PlayerObject) then
        return false
    end
    local TargetRoot = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not TargetRoot or not TargetRoot:IsA("BasePart") or not Humanoid or Humanoid.Health <= 0 or Character:FindFirstChildOfClass("ForceField") then
        return false
    end
    local MaximumDistance = Clamp(tonumber(MeleeAuraDistance) or 15, 1, 15)
    if (RootPart.Position - TargetRoot.Position).Magnitude > MaximumDistance then
        return false
    end
    if Hitter and (not Hitter.Parent or not Hitter:IsA("BasePart")) then
        return false
    end
    return true
end

function RunMeleeAuraAttack(Character, RootPart, Tool, Config, TargetData, PrimaryRemote, SecondaryRemote)
    local Runtime = MeleeAuraRuntime
    if Runtime.Busy == true then
        return false
    end
    local ToolState = GetMeleeAuraToolState(Tool)
    local CurrentClock = tick()
    if CurrentClock
        < (tonumber(ToolState.NextAttackAt) or 0) then
        return false
    end
    Runtime.Busy = true
    local AttackStarted = tick()
    local LastAttackAt = tonumber(ToolState.LastAttackAt) or 0
    local Elapsed = Max(AttackStarted - LastAttackAt, 0)
    local ProtocolKey = tick()
    local PreviousHit
    local PreviousToken = ToolState.LastToken
    if PreviousToken ~= nil then PreviousHit = ToolState.HitTokens[PreviousToken] == true end
    local PingSync
    if type(_G) == "table" and type(_G.GSettings) == "table" then PingSync = _G.GSettings.PingSync end
    local Success, AttackToken, ServerStage = Shared.SafeCall(
            function()
                return PrimaryRemote:InvokeServer("🍞", ProtocolKey, Tool, "43TRFWX", "Normal", Elapsed, PingSync, PreviousHit)
            end)
    if not Success or not AttackToken then
        ToolState.NextAttackAt = tick() + 0.08
        Runtime.Busy = false
        return false
    end
    ToolState.LastAttackAt = AttackStarted
    if PreviousToken ~= nil and PreviousToken
            ~= AttackToken then
        ToolState.HitTokens[PreviousToken] = nil
    end
    ToolState.LastToken = AttackToken
    local StageConfig, StageNumber = GetMeleeAuraStageConfig(Config, ServerStage, ToolState)
    if type(StageConfig) ~= "table" then
        ToolState.NextAttackAt = tick() + 0.12
        Runtime.Busy = false
        return false
    end
    local Hitter = ResolveMeleeAuraHitter(Config, StageConfig, Tool, Character)
    if not Hitter then
        ToolState.NextAttackAt = tick() + 0.12
        Runtime.Busy = false
        return false
    end
    local SwingWait = Clamp(tonumber(StageConfig.SwingWait) or 0, 0, 2)
    local SwingTime = Clamp(tonumber(StageConfig.SwingTime) or 0.12, 0, 2)
    local DebounceTime = Clamp(tonumber(StageConfig.DebounceTime) or (SwingWait + SwingTime), 0.05, 3)
    ToolState.NextAttackAt = AttackStarted + DebounceTime
    if SwingWait > 0 then Wait(SwingWait) end
    if not MeleeAuraEnabled or LocalPlayer.Character
            ~= Character or Tool.Parent
            ~= Character or not IsMeleeAuraTargetStillValid(TargetData, RootPart, Hitter) then
        Runtime.Busy = false
        return false
    end
    local TargetCharacter = TargetData.Character
    local TargetPart = GetMeleeAuraTargetPart(TargetCharacter, Hitter)
    if not TargetPart or not TargetPart:IsA("BasePart") then
        Runtime.Busy = false
        return false
    end
    local HitPosition = TargetPart.Position
    local FireSuccess = Shared.SafeCall(
            function()
                SecondaryRemote:FireServer("🍞", ProtocolKey, Tool, "2389ZFX34", AttackToken, true, Hitter, TargetPart, TargetCharacter, RootPart.Position, HitPosition)
            end)
    if FireSuccess then
        ToolState.HitTokens[AttackToken] = true
        SharedAuraTick = tick()
        ToolState.LastStage = tonumber(StageNumber) or ToolState.LastStage
    end
    Runtime.Busy = false
    return FireSuccess == true
end

function MeleeAuraEnable()
    if MeleeAuraEnabled then
        return
    end
    MeleeAuraEnabled = true
    MeleeAuraRuntime.Busy = false
    MeleeAuraCoroutine = Spawn(
            function()
                while MeleeAuraEnabled do
                    local Character = LocalPlayer.Character
                    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
                    local Tool = Character and Character:FindFirstChildOfClass("Tool")
                    if not Character or not RootPart or not RootPart:IsA("BasePart") or not Tool then
                        Wait(0.05)
                        continue
                    end
                    local Config = GetMeleeAuraConfig(Tool)
                    if not Config then
                        Wait(0.08)
                        continue
                    end
                    local Events = ReplicatedStorage:FindFirstChild("Events")
                    local PrimaryRemote = Events and Events:FindFirstChild("XMHH.2")
                    local SecondaryRemote = Events and Events:FindFirstChild("XMHH2.2")
                    if not PrimaryRemote or not SecondaryRemote then
                        Wait(0.08)
                        continue
                    end
                    local Target = GetMeleeAuraTarget(RootPart)
                    if Target then RunMeleeAuraAttack(Character, RootPart, Tool, Config, Target, PrimaryRemote, SecondaryRemote) end
                    Wait(0.025)
                end
                MeleeAuraRuntime.Busy = false
            end)
end

function MeleeAuraDisable()
    MeleeAuraEnabled = false
    MeleeAuraRuntime.Busy = false
    if MeleeAuraCoroutine then
        Cancel(MeleeAuraCoroutine)
        MeleeAuraCoroutine = nil
    end
end

function WeaponPerspectiveVisualsActive()
    return WeaponShaderSettings.Enabled == true or WeaponChamsEnabled == true or ArmsChamsEnabled == true or type(GunMaterialChamsState) == "table"
            and GunMaterialChamsState.Enabled == true
end
function WeaponPerspectiveRefreshParts(Tool, Force)
    local State = WeaponPerspectiveState
    local CurrentTime = Clock()
    if not Tool or not Tool.Parent then
        State.Parts = {}
        State.PartsTool = nil
        State.NextPartsRefresh = 0
        return State.Parts
    end
    if not Force and State.PartsTool == Tool and CurrentTime < (tonumber(State.NextPartsRefresh) or 0) then
        return State.Parts
    end
    local Parts = {}
    for _, Object in ipairs(Tool:GetDescendants()) do
        if Object:IsA("BasePart") then Parts[#Parts + 1] = Object end
    end
    State.Parts = Parts
    State.PartsTool = Tool
    State.NextPartsRefresh = CurrentTime + 0.18
    return Parts
end
function WeaponPerspectiveRepairThirdPerson(Tool)
    if InvisibilityEnabled == true or not Tool or not Tool.Parent then return end
    local Parts = WeaponPerspectiveRefreshParts(Tool, false)
    for Index = 1, #Parts do
        local Part = Parts[Index]
        if Part and Part.Parent and Part:IsDescendantOf(Tool) and Part.LocalTransparencyModifier ~= 0 then Part.LocalTransparencyModifier = 0 end
    end
end
function WeaponPerspectiveStep()
    if not WeaponPerspectiveVisualsActive() then return end
    local State = WeaponPerspectiveState
    local CurrentTime = Clock()
    if CurrentTime - (tonumber(State.LastStep) or 0) < 0.035 then return end
    State.LastStep = CurrentTime
    local FirstPerson = IsViewModelFirstPerson()
    local Tool = GetWeaponShaderTarget()
    local PerspectiveChanged = State.LastFirstPerson ~= nil and State.LastFirstPerson ~= FirstPerson
    if PerspectiveChanged and FirstPerson == false then
        State.RepairUntil = CurrentTime + 0.72
        WeaponPerspectiveRefreshParts(Tool, true)
        WeaponShaderSettings.Dirty = true
        WeaponShaderSettings.NextRootCheck = 0
        Defer(function()
            if WeaponShaderSettings.Enabled then RefreshWeaponShaders(true) end
            if type(GunMaterialChamsState) == "table" and GunMaterialChamsState.Enabled and type(GunMaterialChamsRefreshRoots) == "function" then
                GunMaterialChamsRefreshRoots()
            end
        end)
    elseif not FirstPerson and Tool ~= State.LastTool then
        State.RepairUntil = CurrentTime + 0.45
        WeaponPerspectiveRefreshParts(Tool, true)
    end
    State.LastFirstPerson = FirstPerson
    State.LastTool = Tool
    if not FirstPerson and CurrentTime <= (tonumber(State.RepairUntil) or 0) then WeaponPerspectiveRepairThirdPerson(Tool) end
end
function EnsureWeaponPerspectiveFix()
    local State = WeaponPerspectiveState
    if not WeaponPerspectiveVisualsActive() then
        if State.Connection then
            Shared.SafeDisconnect(State.Connection)
            State.Connection = nil
        end
        State.LastFirstPerson = nil
        State.LastTool = nil
        State.RepairUntil = 0
        State.Parts = {}
        State.PartsTool = nil
        return
    end
    if State.Connection then return end
    State.LastFirstPerson = IsViewModelFirstPerson()
    State.LastTool = nil
    State.LastStep = 0
    State.Connection = RunService.Heartbeat:Connect(function()
        Shared.SafeCall(WeaponPerspectiveStep)
    end)
end
function GetWeaponShaderTarget()
    local Character = LocalPlayer.Character
    if not Character then return nil end
    local Equipped = nil
    for _, Object in ipairs(Character:GetChildren()) do
        if Object:IsA("Tool") then
            Equipped = Object
