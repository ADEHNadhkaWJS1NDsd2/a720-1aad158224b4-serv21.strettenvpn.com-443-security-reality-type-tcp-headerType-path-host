                Resolved = ResolveTrackedCharacter(Player, Player.Character)
                return Resolved ~= nil and Resolved:FindFirstChildOfClass("Humanoid") ~= nil
            end, 6, {Player.CharacterAdded, Shared.GetPropertyChangedSignalSafe(Player, "Character"), InitialCharacter and InitialCharacter.ChildAdded or nil,
                HitVisualWorldCharacters and HitVisualWorldCharacters.ChildAdded or nil})
