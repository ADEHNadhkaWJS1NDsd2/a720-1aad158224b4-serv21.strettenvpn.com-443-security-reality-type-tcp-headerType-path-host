        if not Data.OverlayPrimitives[Name] then Data.OverlayPrimitives[Name] = Shared.CreateOverlayPrimitive("Line", {Visible = false, Thickness = 1, Transparency = 1, ZIndex = 4}) end
    end
    for Index = 1, 16 do
        local Name = "GradientFill" .. Index
        if not Data.OverlayPrimitives[Name] then Data.OverlayPrimitives[Name] = Shared.CreateOverlayPrimitive("Square", {Visible = false, Filled = true, Transparency = 0.2, ZIndex = 1}) end
    end
    return true
end
function HideBoxGradientOverlay(Data)
    if not Data or not Data.OverlayPrimitives then return end
    for Index = 1, 4 do
        local Object = Data.OverlayPrimitives["GradientBoxSide" .. Index]
        if Object then Object.Visible = false end
    end
    for Index = 1, 16 do
        local Object = Data.OverlayPrimitives["GradientFill" .. Index]
        if Object then Object.Visible = false end
    end
