function Shared.RefreshPlayerESPOffsetCache(Force)
    local PlayerState = Visuals.Player
    local Cache = PlayerState.OffsetCache
    if type(Cache) ~= "table" then Cache = {}; PlayerState.OffsetCache = Cache end
    local Now = Clock()
    if Force ~= true and Now < (tonumber(PlayerState.OffsetCacheNextUpdate) or 0) then return Cache end
    local Flags = type(Library) == "table" and type(Library.Flags) == "table" and Library.Flags or nil
    for Index = 1, #PlayerESPOffsetNames do
        local Name = PlayerESPOffsetNames[Index]
        local Value = Flags and Flags["Player ESP " .. Name .. " Offset"] or nil
        if typeof(Value) ~= "Vector2" then Value = EmptyVector2 end
        if Name == "Health Bar" or Name == "Health Value" then Value = EmptyVector2 end
        Cache[Name] = Value
    end
    PlayerState.OffsetCacheNextUpdate = Now + 0.20
    return Cache
end
function GetPlayerESPPreviewOffset(Name)
    if type(Name) ~= "string" then return EmptyVector2 end
    local Cache = Shared.RefreshPlayerESPOffsetCache()
    local Value = Cache and Cache[Name]
    return typeof(Value) == "Vector2" and Value or EmptyVector2
end
function ApplyPlayerESPPreviewOffset(BasePosition, Name)
    if typeof(BasePosition) ~= "Vector2" then return BasePosition end
    return BasePosition + GetPlayerESPPreviewOffset(Name)
end
function NormalizePlayerESPNameParts(Value)
    local Output, Seen = {}, {}
    local function AddNamePart(Name)
        Name = tostring(Name or "")
        if (Name == "Display Name" or Name == "Username") and not Seen[Name] then
            Seen[Name] = true
            Output[#Output + 1] = Name
        end
    end
    if type(Value) == "string" then
        AddNamePart(Value)
    elseif type(Value) == "table" then
        for Index = 1, #Value do AddNamePart(Value[Index]) end
        for Name, Enabled in pairs(Value) do
            if type(Name) == "string" and Enabled == true then AddNamePart(Name) end
        end
    end
    if #Output == 0 then Output[1] = "Display Name" end
    return Output
end
function GetPlayerESPNameText(Data)
    local PlayerObject = Data and Data.Player
    if not PlayerObject then return "" end
    local Parts = NormalizePlayerESPNameParts(Visuals.Player.NameParts)
    local ShowDisplay, ShowUser = false, false
    for Index = 1, #Parts do
        if Parts[Index] == "Display Name" then ShowDisplay = true elseif Parts[Index] == "Username" then ShowUser = true end
    end
    local DisplayName = tostring(PlayerObject.DisplayName or PlayerObject.Name or "")
    local Username = tostring(PlayerObject.Name or "")
    if ShowDisplay and ShowUser and DisplayName ~= Username then return DisplayName .. " [" .. Username .. "]" end
    if ShowUser then return Username end
    return DisplayName ~= "" and DisplayName or Username
end
function GetPlayerESPOutlineStrokeThickness()
    local BoxThickness = Max(tonumber(Visuals.Player.BoxThickness) or 1, 0.5)
    local BorderThickness = Max(tonumber(Visuals.Player.OutlineThickness) or 1, 0.5)
    return BoxThickness + BorderThickness * 2
end
function GetPlayerESPHealthColor(HealthPercent)
    local Alpha = Clamp(tonumber(HealthPercent) or 0, 0, 1)
    local Low = Visuals.Player.HealthLowColor
    local Mid = Visuals.Player.HealthMidColor
    local High = Visuals.Player.HealthHighColor
    if Alpha <= 0.5 then return Low:Lerp(Mid, Alpha * 2) end
    return Mid:Lerp(High, (Alpha - 0.5) * 2)
end
function UpdatePlayerHealthAnimation(Data, TargetPercent, CurrentTime)
    if not Data then return Clamp(tonumber(TargetPercent) or 0, 0, 1), Clamp(tonumber(TargetPercent) or 0, 0, 1) end
    TargetPercent = Clamp(tonumber(TargetPercent) or 0, 0, 1)
    CurrentTime = tonumber(CurrentTime) or Clock()
    local Health = Visuals.Player.Health
    local LastTime = tonumber(Data.LastHealthVisualAt) or CurrentTime
    local DeltaTime = Clamp(CurrentTime - LastTime, 0, 0.10)
    Data.LastHealthVisualAt = CurrentTime
    local Displayed = tonumber(Data.DisplayedHealthPercent)
    local Delayed = tonumber(Data.DelayedHealthPercent)
    local PreviousTarget = tonumber(Data.LastHealthTargetPercent)
    if Displayed == nil then Displayed = TargetPercent end
    if Delayed == nil then Delayed = TargetPercent end
    if PreviousTarget == nil then PreviousTarget = TargetPercent end
    if DeltaTime > 0 then
        local SmoothSpeed = Max(tonumber(Health.SmoothSpeed) or 12, 0.1)
        local Alpha = 1 - Exp(-SmoothSpeed * DeltaTime)
        Displayed += (TargetPercent - Displayed) * Alpha
        if Abs(TargetPercent - Displayed) <= 0.001 then Displayed = TargetPercent end
    end
    if TargetPercent > PreviousTarget + 0.001 then
        Delayed = Max(Delayed, Displayed, TargetPercent)
        Data.HealthDamageHoldUntil = CurrentTime
    elseif TargetPercent < PreviousTarget - 0.001 then
        Data.HealthDamageHoldUntil = CurrentTime + Max(tonumber(Health.DelayHold) or 0.12, 0)
    end
    Delayed = Max(Delayed, Displayed)
    if Health.Delayed ~= true then
        Delayed = Displayed
    elseif CurrentTime >= (tonumber(Data.HealthDamageHoldUntil) or 0) and Delayed > Displayed and DeltaTime > 0 then
        local DelaySpeed = Max(tonumber(Health.DelaySpeed) or 7.5, 0.1)
        local Alpha = 1 - Exp(-DelaySpeed * DeltaTime)
        Delayed += (Displayed - Delayed) * Alpha
        if Delayed - Displayed <= 0.001 then Delayed = Displayed end
    end
    Displayed = Clamp(Displayed, 0, 1)
    Delayed = Clamp(Max(Delayed, Displayed), 0, 1)
    Data.DisplayedHealthPercent = Displayed
    Data.DelayedHealthPercent = Delayed
    Data.LastHealthTargetPercent = TargetPercent
    return Displayed, Delayed
end
function RequestProfileData(Url)
    if type(Url) ~= "string" or Url == "" then return nil end
    local RequestFunctions = {Environment and Environment.request, Environment and Environment.http_request, type(syn) == "table" and syn.request or nil,
        type(http) == "table" and http.request or nil, type(fluxus) == "table" and fluxus.request or nil}
    for Index = 1, #RequestFunctions do
        local RequestFunction = RequestFunctions[Index]
        if type(RequestFunction) == "function" then
            local Success, Response = Shared.SafeCall(RequestFunction, {Url = Url, Method = "GET", Headers = {["Accept"] = "*/*", ["User-Agent"] = "Atramenta.rip"}})
            local Body = Success and Shared.ExtractHTTPBody(Response) or nil
            if type(Body) == "string" and #Body > 24 then return Body end
        end
    end
    local Success, Body = Shared.SafeCall(function()
        return Game:HttpGet(Url, true)
    end)
    if Success and type(Body) == "string" and #Body > 24 then return Body end
    return nil
end
function FetchProfilePicture(UserId)
    UserId = tonumber(UserId)
    if not UserId or UserId <= 0 then return nil end
    local ApiUrl = "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=" .. tostring(Floor(UserId)) .. "&size=180x180&format=Png&isCircular=false"
    local Json = RequestProfileData(ApiUrl)
    if type(Json) ~= "string" then return nil end
    local DecodeSuccess, Decoded = Shared.SafeCall(function()
        return GetService(Game, "HttpService"):JSONDecode(Json)
    end)
    if not DecodeSuccess or type(Decoded) ~= "table" or type(Decoded.data) ~= "table" or type(Decoded.data[1]) ~= "table" then return nil end
    local ImageUrl = Decoded.data[1].imageUrl
    if type(ImageUrl) ~= "string" or ImageUrl == "" then return nil end
    local Data = RequestProfileData(ImageUrl)
    if type(Data) ~= "string" or #Data <= 64 then return nil end
    return Data
end
function QueueProfilePicture(Data)
    if type(Data) ~= "table" or not Data.Player then return end
    local UserId = tonumber(Data.Player.UserId)
    if not UserId or UserId <= 0 then return end
    local Cache = Visuals.Player.ProfilePictureCache local Entry = Cache[UserId] local CurrentTime = Clock()
    if type(Entry) == "table" then
        if type(Entry.Data) == "string" and #Entry.Data > 64 then
            Data.ProfilePictureData = Entry.Data
            return
        end
        if Entry.Loading == true then return end
        if CurrentTime < (tonumber(Entry.RetryAt) or 0) then return end
    else
        Entry = {}
        Cache[UserId] = Entry
    end
    Entry.Loading = true
    Spawn(function()
        local PictureData = FetchProfilePicture(UserId)
        Entry.Loading = false
        Entry.Time = Clock()
        if type(PictureData) == "string" and #PictureData > 64 then
            Entry.Data = PictureData
            Entry.RetryAt = 0
            if Data.Player and Data.Player.Parent then
                Data.ProfilePictureData = PictureData
                Data.ProfilePictureApplied = false
            end
        else
            Entry.RetryAt = Clock() + 30
        end
    end)
end

