function AtramentaExtraGetSpoofText(Text)
    local State = AtramentaExtraState.NameSpoof
    Text = tostring(Text or "")
    if Text == "" then
        return Text
    end
    local RealDisplay = tostring(LocalPlayer.DisplayName or "")
    local RealName = tostring(LocalPlayer.Name or "")
    if RealDisplay ~= "" and StringFind(Text, RealDisplay, 1, true) then Text = GSub(Text, RealDisplay, tostring(State.FakeDisplay or RealDisplay)) end
    if RealName ~= "" and StringFind(Text, RealName, 1, true) then Text = GSub(Text, RealName, tostring(State.FakeName or RealName)) end
    return Text
end

function AtramentaExtraIsTextObject(Object)
    return Object and (Object:IsA("TextLabel") or Object:IsA("TextButton") or Object:IsA("TextBox"))
end

function AtramentaExtraApplySpoofTextObject(Object, CaptureReal)
    local State = AtramentaExtraState.NameSpoof
    if State.Enabled ~= true or State.Applying == true or not AtramentaExtraIsTextObject(Object) then
        return
    end
    if CaptureReal == true or State.Texts[Object] == nil then State.Texts[Object] = tostring(Object.Text or "") end
    local RealText = tostring(State.Texts[Object] or "")
    local Spoofed = AtramentaExtraGetSpoofText(RealText)
    if Object.Text ~= Spoofed then
        State.Applying = true
        Object.Text = Spoofed
        State.Applying = false
    end
end

function AtramentaExtraBindSpoofTextObject(Object)
    local State = AtramentaExtraState.NameSpoof
    if not AtramentaExtraIsTextObject(Object) then
        return
    end
    if State.TextConnections[Object] then
        AtramentaExtraApplySpoofTextObject(Object, false)
        return
    end
    State.Texts[Object] = tostring(Object.Text or "")
    State.TextConnections[Object] = Object:GetPropertyChangedSignal("Text"):Connect(
            function()
                if State.Enabled ~= true or State.Applying == true or not Object.Parent then
                    return
                end
                State.Texts[Object] = tostring(Object.Text or "")
                AtramentaExtraApplySpoofTextObject(Object, false)
            end)
    AtramentaExtraApplySpoofTextObject(Object, false)
end

function AtramentaExtraBindNameSpoofHumanoid(Humanoid)
    local State = AtramentaExtraState.NameSpoof
    if State.HumanoidConnection then
        Shared.SafeDisconnect(State.HumanoidConnection)
        State.HumanoidConnection = nil
    end
    State.BoundHumanoid = nil
    State.OriginalHumanoidDisplay = nil
    if not Humanoid or not Humanoid:IsA("Humanoid") then
        return
    end
    State.BoundHumanoid = Humanoid
    State.OriginalHumanoidDisplay = Humanoid.DisplayName
    State.HumanoidConnection = Humanoid:GetPropertyChangedSignal("DisplayName"):Connect(
            function()
                if State.Enabled ~= true or State.Applying == true or not Humanoid.Parent then
                    return
                end
                State.OriginalHumanoidDisplay = Humanoid.DisplayName
                State.Applying = true
                Humanoid.DisplayName = tostring(State.FakeDisplay or LocalPlayer.DisplayName)
                State.Applying = false
            end)
    if State.Enabled then
        State.Applying = true
        Humanoid.DisplayName = tostring(State.FakeDisplay or LocalPlayer.DisplayName)
        State.Applying = false
    end
end

function AtramentaExtraProcessSpoofText(Object) AtramentaExtraBindSpoofTextObject(Object) end

function AtramentaExtraApplyNameSpoof()
    local State = AtramentaExtraState.NameSpoof
    if State.Enabled ~= true then
        return
    end
    local PlayerGuiObject = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if PlayerGuiObject then
        for _, Object in ipairs(PlayerGuiObject:GetDescendants()) do
            AtramentaExtraBindSpoofTextObject(Object)
        end
    end
    for Object in pairs(State.Texts) do
        if Object and Object.Parent then AtramentaExtraApplySpoofTextObject(Object, false) end
    end
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if Humanoid and State.BoundHumanoid
            ~= Humanoid then
        AtramentaExtraBindNameSpoofHumanoid(Humanoid)
    elseif Humanoid then
        State.Applying = true
        Humanoid.DisplayName = tostring(State.FakeDisplay or LocalPlayer.DisplayName)
        State.Applying = false
    end
end

function AtramentaExtraDisconnectNameSpoof()
    local State = AtramentaExtraState.NameSpoof
    for Object, Connection in pairs(State.TextConnections) do
        if Connection then Shared.SafeDisconnect(Connection) end
        State.TextConnections[Object] = nil
    end
    for Index = 1, #State.Connections do
        local Connection = State.Connections[Index]
        if Connection then Shared.SafeDisconnect(Connection) end
    end
    State.Connections = {}
    if State.CharacterConnection then
        Shared.SafeDisconnect(State.CharacterConnection)
        State.CharacterConnection = nil
    end
    if State.HumanoidConnection then
        Shared.SafeDisconnect(State.HumanoidConnection)
        State.HumanoidConnection = nil
    end
end

function AtramentaExtraSetNameSpoof(Value)
    local State = AtramentaExtraState.NameSpoof
    local Enabled = Value == true
    AtramentaExtraDisconnectNameSpoof()
    State.Enabled = Enabled
    if Enabled then
        local PlayerGuiObject = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if PlayerGuiObject then
            State.Connections[#State.Connections + 1] = PlayerGuiObject.DescendantAdded:Connect(
                    function(Object)
                        if State.Enabled ~= true then
                            return
                        end
                        Defer(AtramentaExtraBindSpoofTextObject, Object)
                    end)
        end
        State.Connections[#State.Connections + 1] = LocalPlayer.ChildAdded:Connect(
                function(Object)
                    if State.Enabled ~= true or not Object:IsA("PlayerGui") then
                        return
                    end
                    Defer(AtramentaExtraApplyNameSpoof)
                end)
        State.CharacterConnection = LocalPlayer.CharacterAdded:Connect(
                function(Character)
                    if State.Enabled ~= true then
                        return
                    end
                    Defer(
                        function()
                            if State.Enabled ~= true or LocalPlayer.Character
                                    ~= Character then
                                return
                            end
                            local Humanoid = Character:FindFirstChildOfClass("Humanoid") or Character:WaitForChild("Humanoid", 3)
                            AtramentaExtraBindNameSpoofHumanoid(Humanoid)
                            AtramentaExtraApplyNameSpoof()
                        end)
                end)
        AtramentaExtraApplyNameSpoof()
        return
    end
    State.Applying = true
    for Object, Original in pairs(State.Texts) do
        if Object and Object.Parent and AtramentaExtraIsTextObject(Object) then Object.Text = tostring(Original or "") end
    end
    local Humanoid = State.BoundHumanoid
    if Humanoid and Humanoid.Parent and State.OriginalHumanoidDisplay
            ~= nil then
        Humanoid.DisplayName = State.OriginalHumanoidDisplay
    end
    State.Applying = false
    State.Texts = setmetatable({}, {__mode = "k"})
    State.TextConnections = setmetatable({}, {__mode = "k"})
    State.OriginalHumanoidDisplay = nil
    State.BoundHumanoid = nil
end

