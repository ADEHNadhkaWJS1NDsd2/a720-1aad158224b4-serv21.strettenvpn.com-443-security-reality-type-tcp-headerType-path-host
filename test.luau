function UpdateFullBoxGradient(Data, Position, Size, Visible)
    if not Data or not Data.OverlayPrimitives then return false end
    local Enabled = Visible == true and BoxGradientAffectsBox()
    if not Enabled then
        for Index = 1, 4 do
            local Object = Data.OverlayPrimitives["GradientBoxSide" .. Index]
            if Object then Object.Visible = false end
        end
        return false
    end
    if not EnsureBoxGradientOverlay(Data) then return false end
    local X, Y = Position.X, Position.Y
    local R, B = X + Size.X, Y + Size.Y
    local Lines = {{NewVector2(X, Y), NewVector2(R, Y), 0.125}, {NewVector2(R, Y), NewVector2(R, B), 0.375}, {NewVector2(R, B), NewVector2(X, B), 0.625},
        {NewVector2(X, B), NewVector2(X, Y), 0.875}}
    local Thickness = Max(tonumber(Visuals.Player.BoxThickness) or 1, 0.5)
    local Opacity = 1 - Clamp(tonumber(Visuals.Player.BoxTransparency) or 0, 0, 0.95)
    for Index = 1, 4 do
        local Object = Data.OverlayPrimitives["GradientBoxSide" .. Index]
        local Pair = Lines[Index]
        Object.Visible = true
        Object.From = Pair[1]
        Object.To = Pair[2]
        Object.Color = GetOverlayGradientSample(Pair[3])
        Object.Thickness = Thickness
        Object.Transparency = Opacity
    end
    return true
end
function GetOverlayGradientSample(Alpha)
    local Settings = Visuals.Player.BoxGradient
    Alpha = Clamp(tonumber(Alpha) or 0, 0, 1)
    if Settings.Animated == true then
        local Direction = Settings.Direction == "Left" and -1 or 1
        local Speed = Clamp(tonumber(Settings.Speed) or 45, 5, 180)
        local Phase = (Clock() * Speed / 180) * Direction
        Alpha = (Alpha + Phase) % 2
        if Alpha > 1 then Alpha = 2 - Alpha end
    end
    return GetBoxGradientColor(Alpha)
end

function UpdateOverlayFillGradient(Data, Position, Size)
    if not Data or not Data.OverlayPrimitives then return false end
    local Enabled = Visuals.Player.Fill == true and BoxGradientAffectsFill()
    if not Enabled then
        for Index = 1, 16 do
            local Object = Data.OverlayPrimitives["GradientFill" .. Index]
            if Object then Object.Visible = false end
        end
        return false
    end
    if not EnsureBoxGradientOverlay(Data) then return false end
    local Settings = Visuals.Player.BoxGradient
    local Steps = Clamp(Floor(tonumber(Settings.Steps) or 12), 6, 16)
    local PlayerCount = #Visuals.Player.List
    local Distance = tonumber(Data.LastESPViewDistance) or 0
    if PlayerCount >= 24 then
        Steps = Min(Steps, 8)
    elseif PlayerCount >= 16 then
        Steps = Min(Steps, 10)
    elseif Distance >= 700 then
        Steps = Min(Steps, 8)
    elseif Distance >= 400 then
        Steps = Min(Steps, 10)
    end
    local BaseRotation = Rad((tonumber(Settings.Rotation) or 90) % 180)
    local VerticalBands = Abs(Cos(BaseRotation)) >= Abs(Sin(BaseRotation))
    local Opacity = 1 - Clamp(tonumber(Visuals.Player.FillTransparency) or 0.82, 0, 1)
    for Index = 1, 16 do
        local Object = Data.OverlayPrimitives["GradientFill" .. Index]
        local Active = Index <= Steps
        Object.Visible = Active
        if Active then
            local T0 = (Index - 1) / Steps
            local T1 = Index / Steps
            local CenterT = (T0 + T1) * 0.5
            local Color = GetOverlayGradientSample(CenterT)
            if VerticalBands then
                local StartX = Position.X + Size.X * T0
                local EndX = Position.X + Size.X * T1
                local Width = Max(EndX - StartX + 1.25, 1)
                Object.Position = NewVector2(StartX - 0.35, Position.Y)
                Object.Size = NewVector2(Width, Size.Y)
            else
                local StartY = Position.Y + Size.Y * T0
                local EndY = Position.Y + Size.Y * T1
                local Height = Max(EndY - StartY + 1.25, 1)
                Object.Position = NewVector2(Position.X, StartY - 0.35)
                Object.Size = NewVector2(Size.X, Height)
            end
            Object.Color = Color
            Object.Transparency = Opacity
        end
    end
    return true
end
