function SetFakePositionEnabled(Value)
    local Enabled = Value == true
    local State = AtramentaFakePositionPhysicsState
    local Connection = DesyncNetworkState.FakePositionGuardConnection
    if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
    DesyncNetworkState.FakePositionGuardConnection = nil
    if State.HeartbeatConnection and typeof(State.HeartbeatConnection) == "RBXScriptConnection" then Shared.SafeDisconnect(State.HeartbeatConnection) end
    State.HeartbeatConnection = nil
    if State.CharacterConnection and typeof(State.CharacterConnection) == "RBXScriptConnection" then Shared.SafeDisconnect(State.CharacterConnection) end
    State.CharacterConnection = nil
    Shared.SafeCall(function()
        RunService:UnbindFromRenderStep("AtramentaFakePositionRestore")
    end)
    State.RenderBound = false
    SetAtramentaPhysicsSenderRateOwner("FakePosition", false)
    DesyncSettings.FakePositionEnabled = false
    RestoreAtramentaFakePositionPhysics()
    ResetAtramentaFakePositionState()
    ResetAtramentaFakeLagTelemetry()
    State.Character = nil
    State.Root = nil
    State.AnchorCFrame = nil
    if not Enabled then return false end
    local Character = LocalPlayer.Character
    local Root = Character and ResolverGetRootPart(Character)
    if not Character or not Root or not Root.Parent then return false end
    if not AtramentaFakePositionOwnsAssembly(Root) then return false end
    if not CaptureAtramentaFakePositionAnchor(Character) then
        return false
    end
    DesyncSettings.FakePositionEnabled = true
    DesyncSettings.FakePositionMode = "NetworkOwnedPhysicsPulse"
    State.HeartbeatConnection = RunService.Heartbeat:Connect(function()
        if DesyncSettings.FakePositionEnabled == true then
            UpdateAtramentaFakePositionGuard()
        else
            RestoreAtramentaFakePositionPhysics()
        end
    end)
    DesyncNetworkState.FakePositionGuardConnection = State.HeartbeatConnection
    Shared.SafeCall(function()
        RunService:BindToRenderStep("AtramentaFakePositionRestore", Enum.RenderPriority.Camera.Value - 2,
            function()
                if State.SpoofApplied == true or State.SavedRoot ~= nil then RestoreAtramentaFakePositionPhysics() end
            end)
        State.RenderBound = true
    end)
    State.CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(NewCharacter)
        if DesyncSettings.FakePositionEnabled ~= true then return end
        Spawn(function()
            local NewRoot = ResolverGetRootPart(NewCharacter)
            if not NewRoot or not NewRoot.Parent then
                Shared.WaitForConditionSignal(function()
                    NewRoot = ResolverGetRootPart(NewCharacter)
                    return DesyncSettings.FakePositionEnabled ~= true or NewRoot ~= nil and NewRoot.Parent ~= nil
                end, 5, {NewCharacter.ChildAdded, NewCharacter.AncestryChanged})
            end
            if DesyncSettings.FakePositionEnabled == true and NewRoot and NewRoot.Parent then
                RestoreAtramentaFakePositionPhysics()
                CaptureAtramentaFakePositionAnchor(NewCharacter)
            end
        end)
    end)
    Defer(function()
        if DesyncSettings.FakePositionEnabled == true then UpdateAtramentaFakePositionGuard() end
    end)
    return true
end

function UnpackAtramentaRawVector3(Payload)
    if type(Payload) ~= "string" or #Payload < 12 then return nil end
    if type(buffer) == "table" and type(buffer.fromstring) == "function" and type(buffer.readf32) == "function" then
        local DataBuffer = buffer.fromstring(Sub(Payload, 1, 12))
        local X = buffer.readf32(DataBuffer, 0)
        local Y = buffer.readf32(DataBuffer, 4)
        local Z = buffer.readf32(DataBuffer, 8)
        if X == X and Y == Y and Z == Z and Abs(X) < 1000000 and Abs(Y) < 1000000 and Abs(Z) < 1000000 then return NewVector3(X, Y, Z) end
        return nil
    end
    if type(StringUnpack) == "function" then
        local X, Y, Z = StringUnpack("<fff", Payload)
        if X == X and Y == Y and Z == Z and Abs(X) < 1000000 and Abs(Y) < 1000000 and Abs(Z) < 1000000 then return NewVector3(X, Y, Z) end
    end
    return nil
end
function GetAtramentaReplicaVerification(Sequence, CurrentTime)
    local Verification = DesyncNetworkState.ReplicaVerification
    if type(Verification) ~= "table" then return "Outbound", "send", 0, nil end
    local Entry = Verification[tonumber(Sequence) or -1]
    if type(Entry) ~= "table" then return "Outbound", "send", 0, nil end
    local Now = tonumber(CurrentTime) or Clock()
    local Age = Max(0, Now - (tonumber(Entry.Time) or 0))
    local Status = tostring(Entry.Status or "Outbound")
    local Source = Entry.Source
    if Status == "Outbound" and Age >= 0.30 then
        Status = "Sent"
        Source = "send-no-ack"
    end
    if (Status == "Outbound" or Status == "Sent" or Status == "PatchedSent" or Status == "ReplaySent") and Age >= 0.85 and (
            tonumber(DesyncNetworkState.ReceiveSeen) or 0) > 0 and (tonumber(DesyncNetworkState.ReceivePayloadMatches) or 0) <= 0 then
        Status = "NoEcho"
        Source = "receive-no-self-echo"
    end
    return Status, Source, Age, Entry.ReceivePosition
end
function RegisterAtramentaPendingReplica(Sequence, Payload, Position, CurrentTime, Status)
    if type(Payload) ~= "string" or #Payload ~= 12 or typeof(Position) ~= "Vector3" then return end
    local Pending = DesyncNetworkState.ReplicaPending
    if type(Pending) ~= "table" then
        Pending = {}
        DesyncNetworkState.ReplicaPending = Pending
    end
    Pending[#Pending + 1] = {Sequence = Sequence, Payload = Payload, Position = Position, Time = CurrentTime}
    while #Pending > 28 do
        Remove(Pending, 1)
    end
    local Verification = DesyncNetworkState.ReplicaVerification
    if type(Verification) ~= "table" then
        Verification = {}
        DesyncNetworkState.ReplicaVerification = Verification
    end
    Verification[Sequence] = {Status = tostring(Status or "Outbound"), Source = Status == "PatchedSent" and "setdata-send" or "send", Time = CurrentTime, ReceivePosition = nil}
    local MinimumSequence = Max(0, Sequence - 48)
    for StoredSequence in pairs(Verification) do
        if type(StoredSequence) == "number" and StoredSequence < MinimumSequence then Verification[StoredSequence] = nil end
    end
end
function MarkAtramentaReplicaVerification(Sequence, Status, Source, ReceivePosition, CurrentTime)
    Sequence = tonumber(Sequence)
    if not Sequence then return end
    local Verification = DesyncNetworkState.ReplicaVerification
    if type(Verification) ~= "table" then
        Verification = {}
        DesyncNetworkState.ReplicaVerification = Verification
    end
    Verification[Sequence] = {Status = tostring(Status or "Outbound"), Source = Source, Time = tonumber(CurrentTime) or Clock(), ReceivePosition = ReceivePosition}
    if Status == "Confirmed" then
        DesyncNetworkState.LastVerifiedSequence = Max(tonumber(DesyncNetworkState.LastVerifiedSequence) or 0, Sequence)
    elseif Status == "Correction" or Status == "Mismatch" then
        DesyncNetworkState.LastCorrectionSequence = Max(tonumber(DesyncNetworkState.LastCorrectionSequence) or 0, Sequence)
        DesyncNetworkState.ReceiveCorrections = (tonumber(DesyncNetworkState.ReceiveCorrections) or 0) + 1
    end
end
function FindAtramentaPendingReplicaByPosition(Position, CurrentTime)
    if typeof(Position) ~= "Vector3" then return nil, Infinite end
    local Pending = DesyncNetworkState.ReplicaPending
    if type(Pending) ~= "table" then return nil, Infinite end
    local Best local BestDistance = Infinite
    for Index = #Pending, 1, -1 do
        local Entry = Pending[Index]
        if type(Entry) == "table" then
            local Age = CurrentTime - (tonumber(Entry.Time) or 0)
            if Age > 1.50 then break end
            if typeof(Entry.Position) == "Vector3" then
                local Distance = (Entry.Position - Position).Magnitude
                if Distance < BestDistance then
                    BestDistance = Distance
                    Best = Entry
                end
            end
        end
    end
    return Best, BestDistance
end
function ProcessAtramentaReceiveVerification(Packet)
    local Controller = DesyncNetworkState
    local Data = Packet and Packet.AsString
    if type(Data) ~= "string" then return end
    Controller.ReceiveSeen = (tonumber(Controller.ReceiveSeen) or 0) + 1
    local CurrentTime = Clock()
    Controller.LastReceiveTime = CurrentTime
    local Pending = Controller.ReplicaPending
    if type(Pending) == "table" then
        for Index = #Pending, 1, -1 do
            local Entry = Pending[Index]
            if type(Entry) == "table" then
                local Age = CurrentTime - (tonumber(Entry.Time) or 0)
                if Age > 1.50 then break end
                if type(Entry.Payload) == "string" and #Entry.Payload == 12 and StringFind(Data, Entry.Payload, 1, true) then
                    Controller.ReceivePayloadMatches = (tonumber(Controller.ReceivePayloadMatches) or 0) + 1
                    MarkAtramentaReplicaVerification(Entry.Sequence, "Confirmed", "receive-exact-anywhere", Entry.Position, CurrentTime)
                    break
                end
            end
        end
    end
    if StringByte(Data, 1) == 0xA1 then return end
    local EntityKey = Controller.PhysicsEntityKey
    if type(EntityKey) ~= "string" or #EntityKey ~= 4 then return end
    local KeyPosition = StringFind(Data, EntityKey, 1, true)
    if not KeyPosition then return end
    Controller.ReceiveEntityHits = (tonumber(Controller.ReceiveEntityHits) or 0) + 1
    local Header = StringChar(0x83, 0x05, 0x06) .. EntityKey
    local SearchFrom = 1
    while true do
        local RecordStart = StringFind(Data, Header, SearchFrom, true)
        if not RecordStart then break end
        Controller.ReceivePhysicsHits = (tonumber(Controller.ReceivePhysicsHits) or 0) + 1
        local PayloadStart = RecordStart + 15
        local PayloadEnd = PayloadStart + 11
        if PayloadEnd <= #Data then
            local ReceivePayload = Sub(Data, PayloadStart, PayloadEnd)
            local ReceivePosition = UnpackAtramentaRawVector3(ReceivePayload)
            if ReceivePosition then
                local Pending, Distance = FindAtramentaPendingReplicaByPosition(ReceivePosition, CurrentTime)
                if Pending and Distance <= 0.85 then
                    Controller.ReceivePayloadMatches = (tonumber(Controller.ReceivePayloadMatches) or 0) + 1
                    local ExactPayload = type(Pending.Payload) == "string" and ReceivePayload == Pending.Payload
                    MarkAtramentaReplicaVerification(Pending.Sequence, "Confirmed", ExactPayload and "receive-exact" or "receive-position", ReceivePosition, CurrentTime)
                else
                    local Latest = Controller.LocalServerReplica
                    local LatestPosition = Latest and typeof(Latest.RawPosition) == "Vector3" and Latest.RawPosition or Latest and typeof(
                                Latest.RootCFrame) == "CFrame" and Latest.RootCFrame.Position or nil
                    local Character = LocalPlayer.Character
                    local Root = Character and ResolverGetRootPart(Character)
                    local LivePosition = Root and Root.Position or nil
                    if Latest and Latest.Sequence and typeof(LatestPosition) == "Vector3" and (ReceivePosition - LatestPosition).Magnitude > 1.50 then
                        local ReceiveNearLive = typeof(LivePosition) == "Vector3" and (ReceivePosition - LivePosition).Magnitude <= 1.25
                        local FakeSeparated = typeof(LivePosition) == "Vector3" and (LatestPosition - LivePosition).Magnitude >= 1.25
                        if ReceiveNearLive and FakeSeparated then MarkAtramentaReplicaVerification(Latest.Sequence, "Correction", "receive", ReceivePosition, CurrentTime) end
                    end
                end
            end
        end
        SearchFrom = RecordStart + 1
    end
end
function UpdateAtramentaLocalCorrectionVerification()
    if not BacktrackVisuals or BacktrackVisuals.ReplicationVerification ~= true then
        return
    end
    local Character = LocalPlayer.Character
    local Root = Character and ResolverGetRootPart(Character)
    if not Root or not Root.Parent then
        DesyncNetworkState.PreviousLocalPosition = nil
        DesyncNetworkState.PreviousLocalVelocity = nil
        return
    end
    local CurrentTime = Clock()
    local CurrentPosition = Root.Position
    local CurrentVelocity = Root.AssemblyLinearVelocity
    local PreviousPosition = DesyncNetworkState.PreviousLocalPosition
    local PreviousVelocity = DesyncNetworkState.PreviousLocalVelocity
    local PreviousTime = tonumber(DesyncNetworkState.PreviousLocalCorrectionTime) or 0
    DesyncNetworkState.PreviousLocalPosition = CurrentPosition
    DesyncNetworkState.PreviousLocalVelocity = CurrentVelocity
    DesyncNetworkState.PreviousLocalCorrectionTime = CurrentTime
    if typeof(PreviousPosition) ~= "Vector3" or typeof(PreviousVelocity) ~= "Vector3" or PreviousTime <= 0 then return end
    local DeltaTime = Clamp(CurrentTime - PreviousTime, 0, 0.10)
    if DeltaTime <= 0 then return end
    local Expected = PreviousPosition + PreviousVelocity * DeltaTime
    local CorrectionDistance = (CurrentPosition - Expected).Magnitude
    if CorrectionDistance < 2.25 then return end
    local Replica = DesyncNetworkState.LocalServerReplica
    if type(Replica) ~= "table" or not Replica.Sequence or CurrentTime - (tonumber(DesyncNetworkState.LocalServerReplicaLastSend) or 0) > 0.45 then
        return
    end
    local ReplicaPosition = typeof(Replica.RawPosition) == "Vector3" and Replica.RawPosition or typeof(Replica.RootCFrame)
            == "CFrame" and Replica.RootCFrame.Position or nil
    if typeof(ReplicaPosition) ~= "Vector3" then return end
    local BeforeDistance = (PreviousPosition - ReplicaPosition).Magnitude
    local AfterDistance = (CurrentPosition - ReplicaPosition).Magnitude
    if AfterDistance + 0.75
        < BeforeDistance then
        MarkAtramentaReplicaVerification(Replica.Sequence, "Confirmed", "local-correction", CurrentPosition, CurrentTime)
    end
end
function FindAtramentaPhysicsPositionField(Data, RootPosition)
    if type(Data) ~= "string" or #Data < 12 or typeof(RootPosition) ~= "Vector3" then return nil, nil end
    local Controller = DesyncNetworkState
    Controller.PhysicsPositionSamples = (tonumber(Controller.PhysicsPositionSamples) or 0) + 1
    local Root = LocalPlayer.Character and ResolverGetRootPart(LocalPlayer.Character)
    local Velocity = Root and Root.AssemblyLinearVelocity or EmptyVector3
    local Speed = typeof(Velocity) == "Vector3" and Velocity.Magnitude or 0
    local SearchTolerance = Clamp(1.35 + Speed * 0.085, 1.35, 7.5)
    local CachedTolerance = Clamp(SearchTolerance * 1.65, 2.25, 10)
    local CachedOffset = Floor(tonumber(Controller.PhysicsPositionOffset) or 0)
    local function ReadAt(Offset)
        if Offset < 1 or Offset + 11 > #Data then return nil end
        local Value = UnpackAtramentaRawVector3(Sub(Data, Offset, Offset + 11))
        if typeof(Value) ~= "Vector3" then return nil end
        if Value.X ~= Value.X or Value.Y ~= Value.Y or Value.Z ~= Value.Z then return nil end
        if Abs(Value.X) > 1000000 or Abs(Value.Y) > 1000000 or Abs(Value.Z) > 1000000 then return nil end
        return Value
    end
    if CachedOffset > 0 then
        local CachedPosition = ReadAt(CachedOffset)
        if typeof(CachedPosition) == "Vector3" then
            local Error = (CachedPosition - RootPosition).Magnitude
            if Error <= CachedTolerance then
                Controller.PhysicsPositionConfidence = Min((tonumber(Controller.PhysicsPositionConfidence) or 0) + 1, 240)
                Controller.PhysicsPositionValidated = Controller.PhysicsPositionConfidence >= 2
                Controller.PhysicsPositionLastError = Error
                return CachedOffset, CachedPosition
            end
        end
    end
    local BestOffset
    local BestPosition
    local BestError = Infinite
    local SecondOffset
    local SecondPosition
    local SecondError = Infinite
    local MaximumOffset = Min(#Data - 11, 384)
    for Offset = 1, MaximumOffset do
        local Position = ReadAt(Offset)
        if typeof(Position) == "Vector3" then
            local Error = (Position - RootPosition).Magnitude
            if Error < BestError then
                SecondOffset, SecondPosition, SecondError = BestOffset, BestPosition, BestError
                BestOffset, BestPosition, BestError = Offset, Position, Error
            elseif Error < SecondError then
                SecondOffset, SecondPosition, SecondError = Offset, Position, Error
            end
        end
    end
    if BestOffset and BestError <= SearchTolerance then
        if BestOffset == CachedOffset then
            Controller.PhysicsPositionConfidence = Min((tonumber(Controller.PhysicsPositionConfidence) or 0) + 2, 240)
        else
            Controller.PhysicsPositionOffset = BestOffset
            Controller.PhysicsPositionConfidence = Max(tonumber(Controller.PhysicsPositionConfidence) or 0, 0) + 1
        end
        Controller.PhysicsPositionValidated = Controller.PhysicsPositionConfidence >= 2
        Controller.PhysicsPositionLastError = BestError
        Controller.PhysicsPositionSecondOffset = SecondError <= SearchTolerance * 1.15 and SecondOffset or nil
        Controller.PhysicsPositionSecondError = SecondError
        return BestOffset, BestPosition
    end
    Controller.PhysicsPositionMisses = (tonumber(Controller.PhysicsPositionMisses) or 0) + 1
    Controller.PhysicsPositionConfidence = Max((tonumber(Controller.PhysicsPositionConfidence) or 0) - 1, 0)
    Controller.PhysicsPositionLastError = BestError
    if Controller.PhysicsPositionConfidence <= 0 then
        Controller.PhysicsPositionOffset = 0
        Controller.PhysicsPositionValidated = false
    end
    return nil, nil
end
function CaptureAtramentaLocalReplicaSnapshot(CurrentTime)
    local Character = LocalPlayer.Character
    local Root = Character and ResolverGetRootPart(Character)
    if not Character or not Root or not Root.Parent then return nil end
    local RootCFrame = Root.CFrame
    local Spoofed = false
    local RealRootCFrame = RootCFrame
    local Parts = {}
    if BacktrackVisuals and type(BacktrackVisuals.BodyParts) == "table" then
        local Correction = Spoofed and RealRootCFrame * RootCFrame:Inverse() or nil
        for Name in pairs(BacktrackVisuals.BodyParts) do
            local Part = Character:FindFirstChild(Name)
            if Part and Part:IsA("BasePart") and Part.Parent == Character and Part.Size.Magnitude <= 12 then
                Parts[Name] = Correction and Correction * Part.CFrame or Part.CFrame
            end
        end
    end
    return {Time = CurrentTime, Character = Character, RootCFrame = RealRootCFrame, Parts = Parts}
end
function CloneAtramentaReplicaSnapshot(Snapshot, CurrentTime)
