function AtramentaExtraGetHudTextSpec(Kind)
    local State = AtramentaExtraState.HudSpoof
    if Kind == "XP" then
        return State.XPEnabled == true, tostring(State.XPText or ""), State.XPOriginals
    end
    return State.LevelEnabled == true, tostring(State.LevelText or ""), State.LevelOriginals
end

function AtramentaExtraApplyHudText(Object, Kind, CaptureReal)
    local State = AtramentaExtraState.HudSpoof
    if State.Applying == true or not AtramentaExtraIsTextObject(Object) then
        return
    end
    local Enabled, SpoofText, Originals = AtramentaExtraGetHudTextSpec(Kind)
    if not Enabled then
        return
    end
    if CaptureReal == true or Originals[Object] == nil then Originals[Object] = tostring(Object.Text or "") end
    if Object.Text ~= SpoofText then
        State.Applying = true
        Object.Text = SpoofText
        State.Applying = false
    end
end

function AtramentaExtraBindHudText(Object, Kind)
    local State = AtramentaExtraState.HudSpoof
    if not AtramentaExtraIsTextObject(Object) then
        return
    end
    local Entry = State.TextConnections[Object]
    if type(Entry) == "table" and Entry.Kind == Kind and Entry.Connection then
        AtramentaExtraApplyHudText(Object, Kind, false)
        return
    end
    if type(Entry) == "table" and Entry.Connection then Shared.SafeDisconnect(Entry.Connection) end
    local _, _, Originals = AtramentaExtraGetHudTextSpec(Kind)
    if Originals[Object] == nil then Originals[Object] = tostring(Object.Text or "") end
    local Connection = Object:GetPropertyChangedSignal("Text"):Connect(
            function()
                if State.Applying == true or not Object.Parent then
                    return
                end
                local Enabled = Kind == "XP" and State.XPEnabled == true or Kind == "Level" and State.LevelEnabled == true
                if not Enabled then
                    return
                end
                local Map = Kind == "XP" and State.XPOriginals or State.LevelOriginals
                Map[Object] = tostring(Object.Text or "")
                AtramentaExtraApplyHudText(Object, Kind, false)
            end)
    State.TextConnections[Object] = {Kind = Kind, Connection = Connection}
    AtramentaExtraApplyHudText(Object, Kind, false)
end

function AtramentaExtraApplyLeaderboardValue(Object, CaptureReal)
    local State = AtramentaExtraState.HudSpoof
    if State.Applying == true or State.LeaderboardEnabled
            ~= true or not Object or not (Object:IsA("IntValue") or Object:IsA("NumberValue")) then
        return
    end
    if CaptureReal == true or State.LeaderboardOriginals[Object] == nil then State.LeaderboardOriginals[Object] = Object.Value end
    local SpoofValue = Floor(tonumber(State.LeaderboardValue) or 999)
    if Object.Value ~= SpoofValue then
        State.Applying = true
        Object.Value = SpoofValue
        State.Applying = false
    end
end

function AtramentaExtraBindLeaderboardValue(Object)
    local State = AtramentaExtraState.HudSpoof
    if not Object or not (Object:IsA("IntValue") or Object:IsA("NumberValue")) then
        return
    end
    if State.ValueConnections[Object] then
        AtramentaExtraApplyLeaderboardValue(Object, false)
        return
    end
    if State.LeaderboardOriginals[Object] == nil then State.LeaderboardOriginals[Object] = Object.Value end
    State.ValueConnections[Object] = Object:GetPropertyChangedSignal("Value"):Connect(
            function()
                if State.Applying == true or State.LeaderboardEnabled
                        ~= true or not Object.Parent then
                    return
                end
                State.LeaderboardOriginals[Object] = Object.Value
                AtramentaExtraApplyLeaderboardValue(Object, false)
            end)
    AtramentaExtraApplyLeaderboardValue(Object, false)
end

function AtramentaExtraUpdateHudSpoof()
    local State = AtramentaExtraState.HudSpoof
    if State.XPEnabled then
        for _, Label in ipairs(AtramentaExtraCollectXPLabels()) do
            AtramentaExtraBindHudText(Label, "XP")
        end
    end
    if State.LevelEnabled then
        for _, Label in ipairs(AtramentaExtraCollectLevelLabels()) do
            AtramentaExtraBindHudText(Label, "Level")
        end
    end
    if State.LeaderboardEnabled then
        for _, Level in ipairs(AtramentaExtraCollectLeaderboardLevels()) do
            AtramentaExtraBindLeaderboardValue(Level)
        end
    end
end

function AtramentaExtraDisconnectHudDiscovery()
    local State = AtramentaExtraState.HudSpoof
    for Index = 1, #State.Connections do
        local Connection = State.Connections[Index]
        if Connection then Shared.SafeDisconnect(Connection) end
    end
    State.Connections = {}
end

function AtramentaExtraBindHudDiscovery()
    local State = AtramentaExtraState.HudSpoof
    AtramentaExtraDisconnectHudDiscovery()
    local PlayerGuiObject = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if PlayerGuiObject then
        State.Connections[#State.Connections + 1] = PlayerGuiObject.DescendantAdded:Connect(
                function()
                    if State.XPEnabled or State.LevelEnabled then Defer(AtramentaExtraUpdateHudSpoof) end
                end)
    end
    State.Connections[#State.Connections + 1] = LocalPlayer.ChildAdded:Connect(
            function(Object)
                if Object.Name == "leaderstats" or Object.Name == "PlayerbaseData2" or Object:IsA("PlayerGui") then Defer(AtramentaExtraUpdateHudSpoof) end
            end)
    local DataRoot = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
    if DataRoot then
        State.Connections[#State.Connections + 1] = DataRoot.DescendantAdded:Connect(
                function()
                    if State.LeaderboardEnabled then Defer(AtramentaExtraUpdateHudSpoof) end
                end)
    end
end

function AtramentaExtraRefreshHudSpoof()
    local State = AtramentaExtraState.HudSpoof
    local Enabled = State.XPEnabled or State.LevelEnabled or State.LeaderboardEnabled
    if Enabled then
        AtramentaExtraUpdateHudSpoof()
        AtramentaExtraBindHudDiscovery()
        if not State.Connection then
            State.Connection = RunService.Heartbeat:Connect(
                    function(DeltaTime)
                        State.Accumulator += Min(tonumber(DeltaTime) or 0.016, 0.05)
                        if State.Accumulator
                            < 0.65 then
                            return
                        end
                        State.Accumulator = 0
                        AtramentaExtraUpdateHudSpoof()
                    end)
        end
        return
    end
    if State.Connection then
        Shared.SafeDisconnect(State.Connection)
        State.Connection = nil
    end
    State.Accumulator = 0
    AtramentaExtraDisconnectHudDiscovery()
end

function AtramentaExtraRestoreHudCategory(Kind)
    local State = AtramentaExtraState.HudSpoof
    State.Applying = true
    if Kind == "XP" or Kind == "Level" then
        local Originals = Kind == "XP" and State.XPOriginals or State.LevelOriginals
        for Object, Original in pairs(Originals) do
            if Object and Object.Parent and AtramentaExtraIsTextObject(Object) then Object.Text = tostring(Original or "") end
        end
        for Object, Entry in pairs(State.TextConnections) do
            if type(Entry) == "table" and Entry.Kind == Kind then
                if Entry.Connection then Shared.SafeDisconnect(Entry.Connection) end
                State.TextConnections[Object] = nil
            end
        end
        if Kind == "XP" then
            State.XPOriginals = setmetatable({}, {__mode = "k"})
        else
            State.LevelOriginals = setmetatable({}, {__mode = "k"})
        end
    elseif Kind == "Leaderboard" then
        for Object, Original in pairs(State.LeaderboardOriginals) do
            if Object and Object.Parent and (Object:IsA("IntValue") or Object:IsA("NumberValue")) then Object.Value = Original end
        end
        for Object, Connection in pairs(State.ValueConnections) do
            if Connection then Shared.SafeDisconnect(Connection) end
            State.ValueConnections[Object] = nil
        end
        State.LeaderboardOriginals = setmetatable({}, {__mode = "k"})
    end
    State.Applying = false
end

function AtramentaExtraRestoreHudSpoof()
    AtramentaExtraRestoreHudCategory("XP")
    AtramentaExtraRestoreHudCategory("Level")
    AtramentaExtraRestoreHudCategory("Leaderboard")
end

function AtramentaExtraDestroy()
    AtramentaExtraSetCameraBobbing(false)
    AtramentaExtraSetMaxZoom(false)
    AtramentaExtraSetScopeGlint(false)
    AtramentaExtraSetAutoRefill(false)
    AtramentaExtraSetAutoBuy(false)
    AtramentaExtraSetNameSpoof(false)
    local Hud = AtramentaExtraState.HudSpoof
    Hud.XPEnabled = false
    Hud.LevelEnabled = false
    Hud.LeaderboardEnabled = false
    AtramentaExtraRefreshHudSpoof()
    AtramentaExtraRestoreHudSpoof()
end
