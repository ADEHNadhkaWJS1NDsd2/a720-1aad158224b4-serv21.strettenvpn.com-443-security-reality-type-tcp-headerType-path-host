        Transparency = Clamp(tonumber(Transparency) or 0.72, 0, 1), Radius = Clamp(tonumber(Ragebot.Settings.FOV) or 320, 10, 700)})
end
function Ragebot.CreateFieldOfViewGlow()
    Ragebot.FOVGlowCircles = {}
    if Ragebot.Settings.FOVGlow ~= true then return end
    local Thickness = Clamp(tonumber(Ragebot.Settings.FOVGlowThickness) or 8, 2, 32)
    local Transparency = Clamp(tonumber(Ragebot.Settings.FOVGlowTransparency) or 0.20, 0, 1)
    for Index = 1, #Ragebot.FOVGlowLayers do
        local Layer = Ragebot.FOVGlowLayers[Index]
        local Circle = Ragebot.CreateFieldOfViewCircle(Ragebot.Settings.FOVGlowColor or Ragebot.Settings.FOVGradientColor,
            Max(Thickness * Layer[1], 1), Clamp(Transparency * Layer[2], 0.01, 1), false)
        if Circle then Ragebot.FOVGlowCircles[#Ragebot.FOVGlowCircles + 1] = Circle end
