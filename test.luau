    AutoRespawnCharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(Character)
        RespawnSafetyState.RespawnRequestedFor = nil
        Defer(BindAutoRespawnCharacter, Character)
    end)
    BindAutoRespawnCharacter(LocalPlayer.Character)
end
function AutoRespawnDisable()
