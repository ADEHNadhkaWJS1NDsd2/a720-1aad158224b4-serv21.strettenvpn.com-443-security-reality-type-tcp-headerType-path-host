Ragebot.AutoDelayProfileKeys = {beretta = "Beretta", tec9 = "TEC-9", glock17 = "Glock 17", g17 = "Glock 17", glock18 = "Glock 18", g18 = "Glock 18", uzi = "Uzi", m1911 = "M1911", deagle = "Deagle", magnum = "Magnum", sks = "SKS", aks74u = "AKS-74U", fnp45 = "FNP-45", mare = "Mare", mac10 = "MAC-10", scarh = "SCAR-H", tommy = "Tommy",
    tommygun = "Tommy", thompson = "Tommy"}
