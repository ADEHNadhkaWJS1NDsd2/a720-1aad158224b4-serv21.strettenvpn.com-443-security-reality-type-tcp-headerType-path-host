    Shot.LastSeenAt = Shot.RemoteConfirmedAt Shot.OwnershipState = "Owned" Shot.FireConfirmedAt = Shot.FireConfirmedAt or Shot.RemoteConfirmedAt
    Shared.IndexLocalShot(Shot)
