ESPBoundsPartNames = {Head = true, Torso = true, ["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true}
EspR6CanonicalPartSizes = {Head = NewVector3(2, 1, 1), Torso = NewVector3(2, 2, 1), ["Left Arm"] = NewVector3(1, 2, 1),
    ["Right Arm"] = NewVector3(1, 2, 1), ["Left Leg"] = NewVector3(1, 2, 1), ["Right Leg"] = NewVector3(1, 2, 1)}
function GetESPR6CanonicalPartSize(Part)
    if not Part or not Part:IsA("BasePart") then return nil end
    return EspR6CanonicalPartSizes[Part.Name]
end
function Shared.GetPlayerESPR6BodyState(Data)
    local Character = Data and Data.Character
    local Root = Data and Data.Root
    local Humanoid = Data and Data.Humanoid
    if not Character or not Root or not Root.Parent then
        return false, false, false
    end
    local IsR6 = (Humanoid and Humanoid.RigType == Enum.HumanoidRigType.R6) or Character:FindFirstChild("Torso") ~= nil
    if not IsR6 then
        Data.ESPCanonicalBounds = false
        Data.ESPInvisibilityLike = false
        Data.ESPBrokenPose = false
        Data.ESPRootTilted = false
        Data.ESPInvisibilityPose = false
        Data.ESPStateKnown = true
        Data.ESPStateDirty = false
        return false, false, false
    end
    local RootTilted = Abs(Root.CFrame.UpVector.Y) <= 0.55
    if Data.ESPStateKnown == true and Data.ESPStateDirty ~= true and Data.ESPRootTilted == RootTilted then
        return true, Data.ESPCanonicalBounds == true, Data.ESPInvisibilityLike == true
    end
    local BodyCount = 0
    local HalfTransparent = 0
    local FullyTransparent = 0
    local Displaced = 0
    for Name in pairs(ESPBoundsPartNames) do
        local Part = Character:FindFirstChild(Name)
        if Part and Part:IsA("BasePart") and Part.Parent == Character then
            BodyCount += 1
            local Transparency = tonumber(Part.Transparency) or 0
            if Transparency >= 0.42 and Transparency <= 0.58 then
                HalfTransparent += 1
            elseif Transparency >= 0.97 then
                FullyTransparent += 1
            end
            if (Part.Position - Root.Position).Magnitude > 6.75 then Displaced += 1 end
        end
    end
    local InvisibilityLike = BodyCount >= 4 and HalfTransparent >= Max(3, Ceil(BodyCount * 0.60))
    local BrokenPose = Displaced >= 2
    local InvisibilityPose = RootTilted or InvisibilityLike
    local UseCanonical = InvisibilityLike or BrokenPose or FullyTransparent >= 3
    local Horizontal = NewVector3(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
    if not UseCanonical and Horizontal.Magnitude > 0.15 then
        Data.ESPStableForward = Horizontal.Unit
    elseif typeof(Data.ESPStableForward) ~= "Vector3" or Data.ESPStableForward.Magnitude <= 0.15 then
        Data.ESPStableForward = Horizontal.Magnitude > 0.15 and Horizontal.Unit or NewVector3(0, 0, -1)
    end
    Data.ESPCanonicalBounds = UseCanonical
    Data.ESPInvisibilityLike = InvisibilityLike
    Data.ESPBrokenPose = BrokenPose
    Data.ESPRootTilted = RootTilted
    Data.ESPInvisibilityPose = InvisibilityPose
    Data.ESPStateKnown = true
    Data.ESPStateDirty = false
    return true, UseCanonical, InvisibilityLike
end
function Shared.GetPlayerESPProjectionCFrame(Data, RootCFrame)
    if typeof(RootCFrame) ~= "CFrame" then return RootCFrame end
    if not Data or Data.ESPCanonicalBounds ~= true then return RootCFrame end
    local Forward = Data.ESPStableForward
    if typeof(Forward) ~= "Vector3" then Forward = NewVector3(0, 0, -1) end
    Forward = NewVector3(Forward.X, 0, Forward.Z)
    if Forward.Magnitude <= 0.15 then
        Forward = NewVector3(0, 0, -1)
    else
        Forward = Forward.Unit
    end
    local Position = RootCFrame.Position
    return LookAt(Position, Position + Forward, Vector3.yAxis)
end

function Shared.GetPlayerESPCanonicalR6Bounds()
    return NewVector3(-1.58, -3.05, -0.68), NewVector3(1.58, 2.08, 0.68)
end

