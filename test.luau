    local History = DesyncNetworkState.PhysicsPacketHistory
    if type(History) ~= "table" or #History < 2 then return nil end
    local WantedTime = CurrentTime - Clamp(tonumber(Delay) or 0.22, 0.03, 0.80)
    local Signature = CurrentEntry.Signature
    local ExactSize
    local SignatureMatch
    for Index = #History - 1, 1, -1 do
        local Entry = History[Index]
        if type(Entry) == "table" and (tonumber(Entry.Time) or Infinite) <= WantedTime then
            if Entry.Signature == Signature then
                if Entry.Size == CurrentEntry.Size then
                    ExactSize = Entry
                    break
                end
                SignatureMatch = SignatureMatch or Entry
            end
        end
    end
