function Shared.CleanupAttackConfirmations()
    local CurrentTime = Clock()
    for Index = #AttackConfirmationState.Shots, 1, -1 do
        local Shot = AttackConfirmationState.Shots[Index]
        local Expired = not Shot or CurrentTime - (tonumber(Shot.Time) or CurrentTime) > AttackConfirmationState.Window
        local Completed = Shot and (Shot.DamageConfirmed == true or Shot.MissLogged == true or Shot.Discarded == true)
            and CurrentTime - (tonumber(Shot.ConfirmedAt) or tonumber(Shot.ResolvedAt) or tonumber(Shot.Time) or CurrentTime) > AttackConfirmationState.MergeWindow
        if Expired or Completed then
            if Shot then Shared.UnindexLocalShot(Shot) end
            Remove(AttackConfirmationState.Shots, Index)
        end
    end
    while #AttackConfirmationState.Shots > AttackConfirmationState.MaximumShots do
        local Shot = Remove(AttackConfirmationState.Shots, 1)
        if Shot then Shared.UnindexLocalShot(Shot) end
    end
end
