function GameVisuals:GetThrowableDefinition(Object)
    if not Object then return nil end
    local Search = Lower(Object.Name)
    for _, Descendant in ipairs(Object:GetDescendants()) do
        Search = Search .. " " .. Lower(Descendant.Name)
    end
    for _, Definition in ipairs(self.ThrowableDefinitions) do
        if StringFind(Search, Definition.Key, 1, true) then return Definition end
    end
    return nil
end
function GameVisuals:IsExcludedDebris(Object)
    local Name = Lower(Object.Name)
    return StringFind(Name, "bullethole", 1, true) ~= nil or StringFind(Name, "magpart", 1, true) ~= nil or Name == "nparts" or Name == "vparts"
        or Name == "toclear" or Name == "bloodinstances"
end
function GameVisuals:RemoveObject(Object)
