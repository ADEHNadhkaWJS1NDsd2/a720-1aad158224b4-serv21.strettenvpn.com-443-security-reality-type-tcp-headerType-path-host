function Ragebot.Fire(Options)
    if Ragebot.Enabled ~= true then
        return false
    end
    Options = type(Options) == "table" and Options or {}
    local Shot = type(Options.Shot) == "table" and Options.Shot or Ragebot.Runtime.ActiveShot
    if not Shot or not Shot.Target or not Shot.Target.Character then
        return false
    end
    if not IsCombatTargetAllowed(Shot.Target) then
        Ragebot.Runtime.ActiveShot = nil
        return false
    end
    local Character = LocalPlayer.Character
    local LocalHead = Character and Character:FindFirstChild("Head")
    local LocalRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    if not LocalHead or not LocalRoot then
        return false
    end
    local TargetCharacter = ResolveTrackedCharacter(Shot.Target, Shot.Target.Character) or Shot.Target.Character
    local TargetDowned = TargetCharacter and Ragebot.IsTargetDowned(Shot.Target, TargetCharacter) or false
    local InvisibilityLikeTarget = TargetCharacter and Ragebot.IsInvisibilityLikeCharacter(TargetCharacter) or false
    local TargetHead = TargetCharacter and TargetCharacter:FindFirstChild("Head")
    if not TargetHead or not TargetHead:IsA("BasePart") then
        Ragebot.Runtime.ActiveShot = nil
        return false
    end
    local Tool = Character and Character:FindFirstChildOfClass("Tool")
    if not Tool then
        return false
    end
    local Values = Tool:FindFirstChild("Values")
    local HitMarker = Tool:FindFirstChild("Hitmarker")
    if not Values or not HitMarker then
        return false
    end
    local Ammo = Values:FindFirstChild("SERVER_Ammo")
    local StoredAmmo = Values:FindFirstChild("SERVER_StoredAmmo")
    if not Ammo or not StoredAmmo then
        return false
    end
    if typeof(Ammo.Value) == "number" and Ammo.Value <= 0 then
        if Ragebot.Settings.AutoReload == true then Ragebot.RequestReload(Tool, true) end
        return false
    end
    if Shot.MatrixWallbang == true or Shot.MatrixRoute == true then
        if TargetDowned and tostring(Shot.AnchorPartName or Shot.HitPartName or "") ~= "Head" then
            Ragebot.Runtime.ActiveShot = nil
            return false
        end
        local AnchorPart = TargetDowned and TargetHead or TargetCharacter:FindFirstChild(tostring(Shot.AnchorPartName or Shot.HitPartName or "Head"))
        if not AnchorPart or not AnchorPart:IsA("BasePart") then
            Ragebot.Runtime.ActiveShot = nil
            return false
        end
        local ShootOffset = Ragebot.ClampWallbangOriginOffset(typeof(Shot.ShootOffset) == "Vector3" and Shot.ShootOffset or EmptyVector3)
        local HitOffset = typeof(Shot.EndpointOffset) == "Vector3" and Shot.EndpointOffset or EmptyVector3
        local AnchorLocalOffset = typeof(Shot.AnchorLocalOffset) == "Vector3" and Shot.AnchorLocalOffset or EmptyVector3
        local AnchorPosition = AnchorPart.CFrame:PointToWorldSpace(AnchorLocalOffset)
        local MatrixDamagePart = TargetHead
        if InvisibilityLikeTarget and not TargetDowned then MatrixDamagePart = AnchorPart end
        local ShootPosition = LocalRoot.Position + ShootOffset
        local HitPosition = AnchorPosition + HitOffset
        local RouteValid = Ragebot.ValidateShotRoute(Shot, ShootPosition, HitPosition, Character, TargetCharacter)
        if RouteValid ~= true then
            local MatrixState = Ragebot.Runtime.Wallbang.MatrixState
            if type(MatrixState) == "table" and MatrixState.Target == Shot.Target then MatrixState.LastSuccessRoute = nil end
            Ragebot.Runtime.ActiveShot = nil
            return false
        end
        local Delta = HitPosition - ShootPosition
        if Delta.Magnitude <= 0.000001 then
            Ragebot.Runtime.ActiveShot = nil
            return false
        end
        local PacketDirection = Delta.Unit * 1000
        local ShotId = Ragebot.GenerateShotKey(30) .. "0"
        local Events = ReplicatedStorage:FindFirstChild("Events")
        local StartShootEvent = Events and Events:FindFirstChild("GNX_S")
        local FinishShootEvent = Events and Events:FindFirstChild("ZFKLF__H")
        if not StartShootEvent or not FinishShootEvent then
            return false
        end
        local FeedbackAttack = Ragebot.RegisterRageFeedbackShot(TargetCharacter, MatrixDamagePart, ShotId, Tool, ShootPosition, PacketDirection, HitPosition, {Wallbang = true,
                MatrixWallbang = true, MatrixRoute = Shot.MatrixRoute == true, AnchorName = Shot.AnchorName, AnchorPartName = Shot.AnchorPartName, Stage = Shot.Stage})
        if type(FeedbackAttack) == "table" then Shot.FeedbackAttack = FeedbackAttack end
        StartShootEvent:FireServer(tick(), ShotId, Tool, "FDS9I83", ShootPosition, {PacketDirection}, false)
        Ragebot.MarkRageFeedbackRemote(FeedbackAttack, ShotId, ShootPosition, PacketDirection)
        if HitFeedbackState.BulletTracerEnabled == true then
            Shared.SpawnDirectionalBulletTracer(ShootPosition, HitPosition, Tool, true, false)
            if type(FeedbackAttack) == "table" then FeedbackAttack.TracerSpawned = true end
        end
        FinishShootEvent:FireServer("🧈", Tool, ShotId, 1, MatrixDamagePart, HitPosition, PacketDirection)
        Ragebot.MarkRageFeedbackDamagePacket(FeedbackAttack, HitPosition)
        if HitMarker and HitMarker:IsA("BindableEvent") then HitMarker:Fire(MatrixDamagePart) end
        local SentAt = Clock()
        Ragebot.Runtime.LastShot = SentAt
        Ragebot.Runtime.LastShotAt = SentAt
        Ragebot.LastTarget = Shot.Target
        Ragebot.LastStage = tostring(Shot.Stage or "MatrixWallbang")
        Ragebot.TryAutoReloadAfterShot(Tool)
        if Ragebot.Runtime.ActiveShot
            == Shot then
            Ragebot.Runtime.ActiveShot = nil
        end
        return true
    end
    if TargetDowned and Shot.Part and Shot.Part ~= TargetHead then
        Ragebot.Runtime.ActiveShot = nil
        return false
    end
    local HitPart = TargetDowned and TargetHead or Shot.Part
    if InvisibilityLikeTarget and not TargetDowned and (Shot.Direct == true or Shot.TPHit == true) then HitPart = Ragebot.GetInvisibilityStablePart(TargetCharacter) or HitPart or TargetHead end
    if not HitPart or not HitPart:IsA("BasePart") or not HitPart:IsDescendantOf(TargetCharacter) then HitPart = TargetHead end
    local ShootPosition = typeof(Shot.Origin) == "Vector3" and Shot.Origin or LocalHead.Position
    if Shot.Wallbang == true and Shot.MatrixWallbang ~= true and typeof(Shot.ShootOffset) == "Vector3" then
        ShootPosition = LocalRoot.Position + Ragebot.ClampWallbangOriginOffset(Shot.ShootOffset)
    elseif Shot.Wallbang == true then
        ShootPosition = Ragebot.GetLiveWallbangOrigin(LocalRoot.Position, ShootPosition)
    end
    local HitPosition = typeof(Shot.Hit) == "Vector3" and Shot.Hit or HitPart.Position
    if Shot.Direct == true or Shot.TPHit == true then HitPosition = HitPart.Position end
    if Shot.Wallbang == true and Shot.MatrixWallbang ~= true then
        local LivePartPosition = Ragebot.PredictPosition(Shot.Target, HitPart)
        if typeof(LivePartPosition)
            ~= "Vector3" then
            LivePartPosition = HitPart.Position
        end
        if Shot.FibonacciWallbang == true and typeof(Shot.FibonacciHitOffset)
                == "Vector3" then
            HitPosition = LivePartPosition + Shot.FibonacciHitOffset
        elseif Shot.SourceAngleOffset == true and typeof(Shot.AngleEndpointOffset)
                == "Vector3" then
            HitPosition = LivePartPosition + Shot.AngleEndpointOffset
        end
    end
    if Shot.Direct == true or Shot.TPHit == true or Shot.Wallbang == true then
        local RouteValid = Ragebot.ValidateShotRoute(Shot, ShootPosition, HitPosition, Character, TargetCharacter)
        if RouteValid ~= true then
            Ragebot.Runtime.ActiveShot = nil
            return false
        end
    end
    if Shot.Wallbang ~= true and InvisibilityLikeTarget then HitPosition = HitPart.Position end
    local Delta = HitPosition - ShootPosition
    if Delta.Magnitude <= 0.001 then
        Ragebot.Runtime.ActiveShot = nil
        return false
    end
    local HitDirection = Delta.Unit
    local RandomKey = Ragebot.GenerateShotKey(30) .. "0"
    local Events = ReplicatedStorage:FindFirstChild("Events")
    local GNX_S = Events and Events:FindFirstChild("GNX_S")
    local ZFKLF__H = Events and Events:FindFirstChild("ZFKLF__H")
    if not GNX_S or not ZFKLF__H then
        return false
    end
    if TargetDowned then
        HitPart = TargetHead
        Shot.Part = TargetHead
        Shot.HitPartName = "Head"
    end
    local FeedbackAttack = Ragebot.RegisterRageFeedbackShot(TargetCharacter, HitPart, RandomKey, Tool, ShootPosition, HitDirection, HitPosition, {
            Wallbang = Shot.Wallbang == true, MatrixWallbang = false, SourceAngleOffset = Shot.SourceAngleOffset == true,
            Stage = Shot.Stage or (Shot.TPHit == true and "TPHit" or "Direct")})
    if type(FeedbackAttack) == "table" then Shot.FeedbackAttack = FeedbackAttack end
    GNX_S:FireServer(tick(), RandomKey, Tool, "FDS9I83", ShootPosition, {HitDirection}, false)
    Ragebot.MarkRageFeedbackRemote(FeedbackAttack, RandomKey, ShootPosition, HitDirection)
    ZFKLF__H:FireServer("🧈", Tool, RandomKey, 1, HitPart, HitPosition, HitDirection)
    Ragebot.MarkRageFeedbackDamagePacket(FeedbackAttack, HitPosition)
    if HitMarker and HitMarker:IsA("BindableEvent") then HitMarker:Fire(HitPart) end
    if HitFeedbackState.BulletTracerEnabled == true then
        Shared.SpawnDirectionalBulletTracer(ShootPosition, HitPosition, Tool, true, false)
        if type(FeedbackAttack) == "table" then FeedbackAttack.TracerSpawned = true end
    end
    local SentAt = Clock()
    Ragebot.Runtime.LastShot = SentAt
    Ragebot.Runtime.LastShotAt = SentAt
    Ragebot.LastTarget = Shot.Target
    Ragebot.TryAutoReloadAfterShot(Tool)
    if Ragebot.Runtime.ActiveShot
        == Shot then
        Ragebot.Runtime.ActiveShot = nil
    end
    return true
end

