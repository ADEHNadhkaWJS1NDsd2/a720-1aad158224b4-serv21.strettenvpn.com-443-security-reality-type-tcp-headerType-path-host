        return Results
    end
    local Seen = {}
    local function AddTextLabel(Object)
        if AtramentaExtraIsTextObject(Object) and not Seen[Object] then
            Seen[Object] = true
            Results[#Results + 1] = Object
        end
    end
    local Bar = Frame:FindFirstChild("Bar")
    AddTextLabel(Bar and Bar:FindFirstChild("Stat"))
    for _, Object in ipairs(Frame:GetDescendants()) do
        if AtramentaExtraIsTextObject(Object) then
            local Name = Lower(Object.Name)
            if Name == "stat" or Name == "xp" or Name == "xptext" or Name == "experience" or Name == "experiencetext" then AddTextLabel(Object) end
        end
    end
    return Results
end

