function FindJoint(Character, Names)
    if not Character then return nil end
    for _, Object in ipairs(Character:GetDescendants()) do
        if Object:IsA("Motor6D") then
            for _, Name in ipairs(Names) do
                if Object.Name == Name then return Object end
            end
        end
    end
end

function UpdateBodyHide()
    if not HideRunning() then
        return
    end
    local Character = LocalPlayer.Character
    if not Character or not Character.Parent then
        return
    end
    if BodyHide.Character ~= Character then
        RestoreBodyHide()
        BodyHide.Character = Character
        BodyHide.VisualSnapshot = nil
    end
    local Torso = Character:FindFirstChild("UpperTorso") or Character:FindFirstChild("Torso")
    local Head = Character:FindFirstChild("Head")
    if BodyHide.Head then
        local Neck = (Head and Head:FindFirstChild("Neck")) or (Torso and Torso:FindFirstChild("Neck")) or FindJoint(Character, {"Neck"})
        if Neck and Neck:IsA("Motor6D") then
            KeepJoint(Neck)
            Neck.C0 = HideBase.NeckC0
            Neck.C1 = HideBase.NeckC1
        end
    end
    if BodyHide.Hands and Torso then
        local Left = Torso:FindFirstChild("Left Shoulder") or Torso:FindFirstChild("LeftShoulder") or FindJoint(Character, {"Left Shoulder", "LeftShoulder"})
        local Right = Torso:FindFirstChild("Right Shoulder") or Torso:FindFirstChild("RightShoulder") or FindJoint(Character, {"Right Shoulder", "RightShoulder"})
        if Left and Left:IsA("Motor6D") then
            KeepJoint(Left)
            Left.C0 = HideBase.LShoulder
        end
        if Right and Right:IsA("Motor6D") then
            KeepJoint(Right)
            Right.C0 = HideBase.RShoulder
        end
        local Tool = Character:FindFirstChildOfClass("Tool")
        if Tool then
            for _, Object in ipairs(Tool:GetDescendants()) do
                if Object:IsA("Motor6D") then
                    if Object.Name == "Mag6D_Torso" then
                        KeepJoint(Object)
                        Object.C0 = HideBase.Mag6D
                    elseif Object.Name == "Tool6D_Torso" then
                        KeepJoint(Object)
                        Object.C0 = HideBase.Tool6D
                    end
                end
            end
        end
    end
    CaptureBodyHideVisual(Character)
end

function UpdateBodyHideLoop()
    if HideRunning() and not BodyHide.Connection then
        BodyHide.Connection = RunService.RenderStepped:Connect(UpdateBodyHide)
    elseif not HideRunning() and BodyHide.Connection then
        Shared.SafeDisconnect(BodyHide.Connection)
        BodyHide.Connection = nil
        BodyHide.Character = nil
        RestoreBodyHide()
    end
end

