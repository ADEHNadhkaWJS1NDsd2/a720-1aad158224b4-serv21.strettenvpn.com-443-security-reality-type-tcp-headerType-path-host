function HandleGunRequiredConfig(Module, Result)
    if typeof(Module) ~= "Instance" or not Module:IsA("ModuleScript") or Module.Name ~= "Config" then return end
    if type(Result) ~= "table" or not IsGunConfigTable(Result) then return end
    local Tool = Module:FindFirstAncestorOfClass("Tool")
    CaptureGunConfig(Result)
    AtramentaRageFireRate.Modules[Module] = Result
    if Tool then
        GunMods.ConfigTools[Result] = Tool
        GunMods.ToolConfigLookup[Tool] = Module
    end
    ApplyGunConfigTable(Result)
end

rawset(Environment, "AtramentaGunRequireHandler", HandleGunRequiredConfig)

function InstallGunRequireHook()
    GunRequireHook.Installed = AtramentaRageFireRate.HookVersion == 8 or GunRequireHook.Installed == true
    if GunRequireHook.OldRequire == nil then GunRequireHook.OldRequire = AtramentaRageFireRate.BaseRequire end
    return GunRequireHook.Installed == true
end

function GetGunConfigModule(Tool)
    if not Tool or not Tool:IsA("Tool") then return nil end
    local Cached = GunMods.ToolConfigLookup[Tool]
    if Cached and Cached.Parent and Cached:IsA("ModuleScript") and Cached.Name == "Config" then return Cached end
    local Config = Tool:FindFirstChild("Config")
    if Config and Config:IsA("ModuleScript") then
        GunMods.ToolConfigLookup[Tool] = Config
        return Config
    end
    return nil
end

function RegisterGun(Tool)
    local Module = GetGunConfigModule(Tool)
    if not Module then return false end
    local Success, Config = pcall(require, Module)
    if not Success or type(Config) ~= "table" or not IsGunConfigTable(Config) then return false end
    HandleGunRequiredConfig(Module, Config)
    return true
end

function GetGunClientScript(Tool)
    if not Tool or not Tool:IsA("Tool") then return nil end
    local Client = Tool:FindFirstChild("Client")
    if Client and Client:IsA("LocalScript") then return Client end
    for _, Object in ipairs(Tool:GetChildren()) do
        if Object:IsA("LocalScript") and Object.Name == "Client" then return Object end
    end
    return nil
end

function RestartGunClientRuntime(Tool)
    if not Tool or not Tool.Parent then return false end
    local Client = GetGunClientScript(Tool)
    if not Client or Client.Disabled == true then return false end
    local Success = pcall(function() Client.Disabled = true end)
    if not Success then return false end
    RunService.Heartbeat:Wait()
    if not Client.Parent or not Tool.Parent then return false end
    Success = pcall(function() Client.Disabled = false end)
    if Success then GunMods.ToolRuntimeDirty[Tool] = nil end
    return Success
end

function QueueGunRuntimeRefresh(Tool)
    if not Tool or not Tool.Parent or GunMods.ToolRuntimePending[Tool] == true then return false end
    local Now = Clock()
    local Last = GunMods.ToolRuntimeLastRefresh and GunMods.ToolRuntimeLastRefresh[Tool] or 0
    if Now - (tonumber(Last) or 0) < 2 then return false end
    GunMods.ToolRuntimePending[Tool] = true
    GunMods.ToolRuntimeLastRefresh = GunMods.ToolRuntimeLastRefresh or setmetatable({}, {__mode = "k"})
    Spawn(function()
        RunService.Heartbeat:Wait()
        if Tool and Tool.Parent then
            RegisterGun(Tool)
            GunMods.ToolRuntimeLastRefresh[Tool] = Clock()
            RestartGunClientRuntime(Tool)
        end
        GunMods.ToolRuntimePending[Tool] = nil
    end)
    return true
end
function MarkGunRuntimeDirty(Tool)
    if not Tool or not Tool:IsA("Tool") then return end
    if GetGunConfigModule(Tool) then GunMods.ToolRuntimeDirty[Tool] = true end
end

function MarkAllGunRuntimesDirty()
    local Character = LocalPlayer.Character
    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if Character then
        for _, Tool in ipairs(Character:GetChildren()) do
            if Tool:IsA("Tool") then MarkGunRuntimeDirty(Tool) end
        end
    end
    if Backpack then
        for _, Tool in ipairs(Backpack:GetChildren()) do
            if Tool:IsA("Tool") then MarkGunRuntimeDirty(Tool) end
        end
    end
    local Equipped = Character and Character:FindFirstChildOfClass("Tool")
    if Equipped and GunMods.ToolRuntimeDirty[Equipped] then QueueGunRuntimeRefresh(Equipped) end
end

function QueueEveryGunRuntimeRefresh()
    local Character = LocalPlayer.Character
    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    local Seen = setmetatable({}, {__mode = "k"})
    local function QueueContainer(Container)
        if not Container then return end
        for _, Tool in ipairs(Container:GetChildren()) do
            if Tool:IsA("Tool") and not Seen[Tool] and GetGunConfigModule(Tool) then
                Seen[Tool] = true
                GunMods.ToolRuntimeDirty[Tool] = true
                QueueGunRuntimeRefresh(Tool)
            end
        end
    end
    QueueContainer(Character)
    QueueContainer(Backpack)
end

