function TrackWorldESPObject(Object, Kind)
    if not Object or not Object.Parent then return nil end
    if Kind == "SAFE" then
        if Visuals.WorldESP.Safes ~= true or not IsWorldSafeObject(Object) then return nil end
    elseif Kind == "CASH" then
        if Visuals.WorldESP.Cash ~= true then return nil end
    elseif Kind == "DROPPED" then
        if Visuals.WorldESP.Dropped ~= true then return nil end
    else
        return nil
    end
    local Data = Visuals.WorldESP.Objects[Object]
    if Data and Data.Kind ~= Kind then
        RemoveWorldESPObject(Object)
        Data = nil
    end
    if not Data then Data = CreateWorldLabel(Object, Kind) end
    if Data then RefreshWorldESPEntry(Object, false) end
    return Data
end
function ClearWorldESPKind(Kind)
    local Objects = {}
    for Object, Data in pairs(Visuals.WorldESP.Objects) do
        if not Kind or (Data and Data.Kind == Kind) then Objects[#Objects + 1] = Object end
    end
    for Index = 1, #Objects do RemoveWorldESPObject(Objects[Index]) end
end
function DisconnectWorldESPEvents()
    local Connections = Visuals.WorldESP.Connections
    if type(Connections) == "table" then
        for Name, Connection in pairs(Connections) do
            if Connection and typeof(Connection) == "RBXScriptConnection" then Shared.SafeDisconnect(Connection) end
            Connections[Name] = nil
        end
    end
    Visuals.WorldESP.Connections = {}
    Visuals.WorldESP.BoundMap = nil
    Visuals.WorldESP.BoundFilter = nil
