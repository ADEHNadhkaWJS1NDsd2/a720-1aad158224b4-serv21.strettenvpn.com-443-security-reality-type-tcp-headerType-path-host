function Ragebot.GetWallbangScanTimeBudget()
    local Wallbang = Ragebot.Runtime.Wallbang
    local ScanRate = Clamp(Floor(tonumber(Wallbang and Wallbang.ScanRate) or 60), 10, 60)
    return Clamp(0.00220 + (60 - ScanRate) / 50 * 0.00180, 0.00220, 0.00400)
