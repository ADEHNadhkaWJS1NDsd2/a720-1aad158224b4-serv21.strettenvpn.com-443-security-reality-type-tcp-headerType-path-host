function Shared.SpawnWorldBeam(CameraObject)
    local Anchor = WorldEffectsState.Anchor if not Anchor or not Anchor.Parent then return end local Node = Shared.AcquireWorldBeamNode(Anchor)
    Shared.ConfigureWorldBeamNode(Node, WorldEffectsState.Effect, CameraObject)
    WorldEffectsState.WeatherActive = (WorldEffectsState.WeatherActive or 0) + 1
    WorldEffectsState.Active[#WorldEffectsState.Active + 1] = Node
end
function Shared.SpawnWorldBeamSplash(Position, Normal, ImpactVelocity, CameraObject)
    local Anchor = WorldEffectsState.Anchor if not Anchor or not Anchor.Parent or typeof(Position) ~= "Vector3" or not CameraObject then return end
    local SplashLimit = Clamp(tonumber(WorldEffectsState.SplashLimit) or 24, 8, 30)
    if (WorldEffectsState.SplashActive or 0) >= SplashLimit then return end
    local SurfaceNormal = typeof(Normal) == "Vector3" and Normal or NewVector3(0, 1, 0)
    if SurfaceNormal.Magnitude <= 0.01 then SurfaceNormal = NewVector3(0, 1, 0) else SurfaceNormal = SurfaceNormal.Unit end
    local ReferenceAxis = Abs(SurfaceNormal.Y) < 0.88 and NewVector3(0, 1, 0) or CameraObject.CFrame.RightVector local TangentA = SurfaceNormal:Cross(ReferenceAxis)
    if TangentA.Magnitude <= 0.01 then TangentA = SurfaceNormal:Cross(NewVector3(0, 0, 1)) end
    if TangentA.Magnitude <= 0.01 then TangentA = NewVector3(1, 0, 0) else TangentA = TangentA.Unit end
    local TangentB = SurfaceNormal:Cross(TangentA)
    if TangentB.Magnitude <= 0.01 then TangentB = NewVector3(0, 0, 1) else TangentB = TangentB.Unit end
    local IncidentVelocity = typeof(ImpactVelocity) == "Vector3" and ImpactVelocity or NewVector3(0, -110, 0) local IncidentSpeed = Clamp(IncidentVelocity.Magnitude, 45, 165)
    local Reflected = IncidentVelocity - SurfaceNormal * (2 * IncidentVelocity:Dot(SurfaceNormal))
    if Reflected.Magnitude <= 0.01 then Reflected = SurfaceNormal else Reflected = Reflected.Unit end
    local Ring = Shared.AcquireWorldBeamNode(Anchor)
    Ring.Effect = "RainSplash"
    Ring.IsSplash = true
    Ring.Age = 0
    Ring.Lifetime = 0.22
    Ring.Position = Position + SurfaceNormal * 0.028
    Ring.Velocity = NewVector3(0, 0, 0)
    Ring.Length = 0.14
    Ring.Phase = Math.random() * Pi * 2
    Ring.Sway = TangentA
    Ring.Frequency = 1
    Ring.SurfaceNormal = SurfaceNormal
    Ring.Core.Segments = 12
    Ring.Glow.Segments = 12
    Ring.Core.CurveSize0, Ring.Core.CurveSize1 = 0.46, -0.46
    Ring.Glow.CurveSize0, Ring.Glow.CurveSize1 = 0.46, -0.46
    Ring.Core.Width0, Ring.Core.Width1 = 0.018, 0.018
    Ring.Glow.Width0, Ring.Glow.Width1 = 0.058, 0.058
    Ring.Core.Color = ColorSequence.new(NewRGB(218, 240, 255))
    Ring.Glow.Color = ColorSequence.new(NewRGB(118, 188, 255))
    Ring.Core.Transparency = NumberSequence.new(0.14)
    Ring.Glow.Transparency = NumberSequence.new(0.82)
    Ring.Core.Brightness = 1
    Ring.Glow.Brightness = 0.58
    WorldEffectsState.SplashActive = (WorldEffectsState.SplashActive or 0) + 1
    WorldEffectsState.Active[#WorldEffectsState.Active + 1] = Ring
    local Intensity = Clamp(tonumber(WorldEffectsState.Intensity) or 70, 5, 250) local DropCount = Clamp(3 + Floor(Intensity / 72) + Math.random(0, 1), 3, 7)
    DropCount = Min(DropCount, SplashLimit - (WorldEffectsState.SplashActive or 0))
    local SpeedScale = Clamp((IncidentSpeed / 110) ^ 0.45, 0.72, 1.32)
    for Index = 1, DropCount do
        local Angle = (Index / Max(DropCount, 1)) * Pi * 2 + (Math.random() - 0.5) * 0.85 local Radial = TangentA * Cos(Angle) + TangentB * Sin(Angle)
        if Radial.Magnitude <= 0.01 then Radial = TangentA else Radial = Radial.Unit end
        local Drop = Shared.AcquireWorldBeamNode(Anchor)
        Drop.Effect = "RainSplashDrop"
        Drop.IsSplash = true
        Drop.Age = 0
        Drop.Lifetime = 0.24 + Math.random() * 0.24
        Drop.Position = Position + SurfaceNormal * 0.035 + Radial * (Math.random() * 0.07)
        Drop.Velocity = Radial * ((4.5 + Math.random() * 8.5) * SpeedScale) + SurfaceNormal * ((2.8 + Math.random() * 6.2) * SpeedScale) + Reflected * (0.65 + Math.random() * 1.7)
        Drop.Gravity = NewVector3(0, -(72 + Math.random() * 38), 0)
        Drop.Drag = 1.8 + Math.random() * 2.1
        Drop.SurfacePoint = Position
        Drop.SurfaceNormal = SurfaceNormal
        Drop.Bounces = 0
        Drop.Length = 0.08 + Math.random() * 0.18
        Drop.Phase = Math.random() * Pi * 2
        Drop.Sway = Radial
        Drop.Frequency = 1
        Drop.Core.Segments = 1
        Drop.Glow.Segments = 1
        Drop.Core.CurveSize0, Drop.Core.CurveSize1 = 0, 0
        Drop.Glow.CurveSize0, Drop.Glow.CurveSize1 = 0, 0
        Drop.BaseCoreWidth = 0.018 + Math.random() * 0.014
        Drop.BaseGlowWidth = Drop.BaseCoreWidth * 3.1
        Drop.Core.Width0, Drop.Core.Width1 = Drop.BaseCoreWidth, Drop.BaseCoreWidth * 0.18
        Drop.Glow.Width0, Drop.Glow.Width1 = Drop.BaseGlowWidth, Drop.BaseGlowWidth * 0.18
        Drop.Core.Color = ColorSequence.new(NewRGB(225, 244, 255), NewRGB(175, 218, 255))
        Drop.Glow.Color = ColorSequence.new(NewRGB(108, 180, 255), NewRGB(205, 235, 255))
        Drop.Core.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 0.76)})
        Drop.Glow.Transparency = NumberSequence.new(0.84)
        Drop.Core.Brightness = 1.25
        Drop.Glow.Brightness = 0.72
        WorldEffectsState.SplashActive = (WorldEffectsState.SplashActive or 0) + 1
        WorldEffectsState.Active[#WorldEffectsState.Active + 1] = Drop
    end
end
function UpdateWorldBeamNode(Node, Step, CameraObject, CameraPosition)
    if not Node or not Node.A0 or not Node.A1 or not Node.Core or not Node.Glow or not Node.A0.Parent or not Node.A1.Parent or not Node.Core.Parent or not Node.Glow.Parent then
        return true
    end
    Node.Age += Step
    local LifeAlpha = Clamp(Node.Age / Max(Node.Lifetime, 0.01), 0, 1) local Sine = Sin((Node.Phase or 0) + Node.Age * (Node.Frequency or 1)) local Direction
    if Node.Effect == "RainSplash" then
        Node.Length = 0.14 + LifeAlpha * 1.34
        Direction = typeof(Node.Sway) == "Vector3" and Node.Sway or CameraObject.CFrame.RightVector local Curve = 0.30 + LifeAlpha * 0.78
        Node.Core.CurveSize0, Node.Core.CurveSize1 = Curve, -Curve
        Node.Glow.CurveSize0, Node.Glow.CurveSize1 = Curve, -Curve
        Node.Core.Brightness = 1.0 * (1 - LifeAlpha)
        Node.Glow.Brightness = 0.58 * (1 - LifeAlpha)
    elseif Node.Effect == "RainSplashDrop" then
        local Gravity = typeof(Node.Gravity) == "Vector3" and Node.Gravity or NewVector3(0, -88, 0) local DragFactor = Exp(-(tonumber(Node.Drag) or 2.6) * Step)
        Node.Velocity = (Node.Velocity + Gravity * Step) * DragFactor local NextPosition = Node.Position + Node.Velocity * Step
        local SurfacePoint = Node.SurfacePoint local SurfaceNormal = Node.SurfaceNormal
        if typeof(SurfacePoint) == "Vector3" and typeof(SurfaceNormal) == "Vector3" and (Node.Bounces or 0) < 1 then
            local OldDistance = (Node.Position - SurfacePoint):Dot(SurfaceNormal) local NewDistance = (NextPosition - SurfacePoint):Dot(SurfaceNormal)
            local NormalSpeed = Node.Velocity:Dot(SurfaceNormal)
            if OldDistance > 0.002 and NewDistance <= 0.002 and NormalSpeed < 0 then
                local TangentialVelocity = Node.Velocity - SurfaceNormal * NormalSpeed
                Node.Velocity = TangentialVelocity * 0.46 + SurfaceNormal * (-NormalSpeed) * 0.24
                NextPosition = SurfacePoint + SurfaceNormal * 0.008 + TangentialVelocity * Step * 0.18
                Node.Bounces = (Node.Bounces or 0) + 1
                Node.Length *= 0.72
                Node.Lifetime = Min(Node.Lifetime, Node.Age + 0.15)
            end
        end
        Node.Position = NextPosition
        Direction = Node.Velocity
        local Fade = Max(1 - LifeAlpha, 0) local BaseCoreWidth = tonumber(Node.BaseCoreWidth) or 0.024 local BaseGlowWidth = tonumber(Node.BaseGlowWidth) or 0.074
        Node.Core.Width0, Node.Core.Width1 = BaseCoreWidth * (0.36 + Fade * 0.64), BaseCoreWidth * 0.12
        Node.Glow.Width0, Node.Glow.Width1 = BaseGlowWidth * (0.30 + Fade * 0.70), BaseGlowWidth * 0.10
        Node.Core.Brightness = 1.25 * Fade
        Node.Glow.Brightness = 0.72 * Fade
        if Node.Velocity.Magnitude < 1.1 and Node.Age > 0.12 then Node.Lifetime = Min(Node.Lifetime, Node.Age + 0.05) end
    elseif Node.Effect == "Sakura" then
        Node.Velocity += NewVector3(0, -0.28, 0) * Step
        Node.Position += (Node.Velocity + Node.Sway * Sine) * Step
        Direction = Node.Velocity + Node.Sway * Sine * 0.72
        local Curve = Sin((Node.Phase or 0) + Node.Age * 3.4) * 0.32
        Node.Core.CurveSize0, Node.Core.CurveSize1 = Curve, -Curve
        Node.Glow.CurveSize0, Node.Glow.CurveSize1 = Curve, -Curve
    elseif Node.Effect == "Snow" then
        Node.Position += (Node.Velocity + Node.Sway * Sine * 0.55) * Step
        Direction = Node.Velocity + Node.Sway * Sine * 0.38
        local Curve = Sin((Node.Phase or 0) + Node.Age * 1.8) * 0.10
        Node.Core.CurveSize0, Node.Core.CurveSize1 = Curve, -Curve
        Node.Glow.CurveSize0, Node.Glow.CurveSize1 = Curve, -Curve
    elseif Node.Effect == "Embers" then
        Node.Velocity += NewVector3(0, 1.35, 0) * Step
        Node.Position += (Node.Velocity + Node.Sway * Sine * 0.42) * Step
        Direction = Node.Velocity + Node.Sway * Sine * 0.35
    elseif Node.Effect == "Fireflies" then
        local Orbit = Node.Sway * Sine + NewVector3(0, Cos((Node.Phase or 0) + Node.Age * 1.6) * 0.75, 0)
        Node.Position += (Node.Velocity + Orbit) * Step
        Direction = CameraObject.CFrame.RightVector local Flicker = 0.38 + 0.62 * Abs(Sin((Node.Phase or 0) + Node.Age * 4.8))
        Node.Core.Brightness = 0.65 + Flicker * 1.1
        Node.Glow.Brightness = 0.35 + Flicker * 0.8
        Node.Core.Width0, Node.Core.Width1 = 0.075 + Flicker * 0.055, 0.035 + Flicker * 0.035
        Node.Glow.Width0, Node.Glow.Width1 = 0.22 + Flicker * 0.16, 0.10 + Flicker * 0.10
    else
        Node.Position += Node.Velocity * Step
        Direction = Node.Velocity
    end
    if Direction.Magnitude <= 0.01 then Direction = NewVector3(0, -1, 0) else Direction = Direction.Unit end
    Node.A0.Position = Node.Position
    Node.A1.Position = Node.Position - Direction * Node.Length
    if Node.Effect ~= "Fireflies" and Node.Effect ~= "RainSplash" and Node.Effect ~= "RainSplashDrop" then
        local Fade = 1 - Clamp((LifeAlpha - 0.72) / 0.28, 0, 1)
        Node.Core.Brightness = Max(0.08, Fade)
        Node.Glow.Brightness = Max(0.04, Fade * 0.55)
    end
    return LifeAlpha >= 1
end
function Shared.StartWorldTextureEffects()
    local CameraObject = Workspace.CurrentCamera
    if not CameraObject then return end
    local Generation = WorldEffectsState.Generation
    local Folder = NewInstance("Folder")
    Folder.Name = "AtramentaTextureWeather"
    Folder.Parent = workspace
    local Anchor = NewInstance("Part")
    Anchor.Name = "TextureAnchor"
    Anchor.Anchored = true
    Anchor.CanCollide = false
    Anchor.CanTouch = false
    Anchor.CanQuery = false
    Anchor.CastShadow = false
    Anchor.Transparency = 1
    Anchor.Size = NewVector3(40, 40, 85)
    Anchor.Parent = Folder
    local Emitter = NewInstance("ParticleEmitter")
    Emitter.Name = "Weather"
    Emitter.Shape = Enum.ParticleEmitterShape.Box
    Emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
    Emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
    Emitter.Parent = Anchor
    WorldEffectsState.Folder = Folder
    WorldEffectsState.Anchor = Anchor
    WorldEffectsState.TextureEmitter = Emitter
    local LastEffect = nil
    local function ApplyWorldEffectsPreset(Force)
        local Effect = tostring(WorldEffectsState.Effect or "Rain")
        local Preset = WorldTextureWeatherPresets[Effect] or WorldTextureWeatherPresets.Rain
        if Force or LastEffect ~= Effect then
            LastEffect = Effect
            Emitter.Texture = Preset.Texture or ""
            Emitter.Speed = Preset.Speed or NumberRange.new(10)
            Emitter.Lifetime = Preset.Lifetime or NumberRange.new(2)
            Emitter.Size = Preset.Size or NumberSequence.new(0.2)
            Emitter.SpreadAngle = Preset.SpreadAngle or EmptyVector2
            Emitter.LightEmission = tonumber(Preset.LightEmission) or 0
            Emitter.LightInfluence = tonumber(Preset.LightInfluence) or 0
            Emitter.Brightness = tonumber(Preset.Brightness) or 1
            Emitter.LockedToPart = Preset.LockedToPart == true
            Emitter.Orientation = Preset.Orientation or Enum.ParticleOrientation.FacingCamera
            Emitter.EmissionDirection = Preset.EmissionDirection or Enum.NormalId.Bottom
            Emitter.Transparency = Preset.Transparency or NumberSequence.new(0.1)
            Emitter.Rotation = Preset.Rotation or NumberRange.new(0)
            Emitter.RotSpeed = Preset.RotSpeed or NumberRange.new(0)
            Emitter.Squash = Preset.Squash or NumberSequence.new(0)
        end
        Emitter.Color = ColorSequence.new(typeof(WorldEffectsState.Color) == "Color3" and WorldEffectsState.Color or NewColor3(1, 1, 1))
        Emitter.Rate = Max(0, (tonumber(Preset.Rate) or 100) * Clamp((tonumber(WorldEffectsState.Intensity) or 70) / 100, 0.05, 2.5))
        local Wind = tonumber(WorldEffectsState.Wind) or 0
        if Effect == "Rain" or Effect == "Light Rain" then Emitter.Acceleration = NewVector3(Wind * 1.15, -4, 0)
        elseif Effect == "Snow" or Effect == "Sakura" then Emitter.Acceleration = NewVector3(Wind * 0.28, -2, 0)
        elseif Effect == "Embers" then Emitter.Acceleration = NewVector3(Wind * 0.18, 2.2, 0)
        else Emitter.Acceleration = NewVector3(Wind * 0.08, 0.15, 0) end
    end
    ApplyWorldEffectsPreset(true)
    WorldEffectsState.Connection = RunService.RenderStepped:Connect(function()
        if Generation ~= WorldEffectsState.Generation or not WorldEffectsState.Enabled or not Folder.Parent or not Anchor.Parent then return end
        local CurrentCamera = Workspace.CurrentCamera
        if not CurrentCamera then return end
        local Radius = Max(tonumber(WorldEffectsState.Radius) or 65, 15)
        local Height = Max(tonumber(WorldEffectsState.Height) or 42, 12)
        Anchor.Size = NewVector3(Radius * 1.25, Height, Radius * 1.85)
        Anchor.CFrame = NewCFrame(CurrentCamera.CFrame.Position + NewVector3(0, Height * 0.50, 0))
        ApplyWorldEffectsPreset(false)
    end)
end
function StartWorldEffects()
    Shared.DestroyWorldEffects()
    if not WorldEffectsState.Enabled then return end
    if tostring(WorldEffectsState.Renderer or "Beam") == "Textures" then Shared.StartWorldTextureEffects() return end
    local CameraObject = Workspace.CurrentCamera if not CameraObject then return end
    local Generation = WorldEffectsState.Generation local Folder = NewInstance("Folder")
    Folder.Name = "AtramentaBeamWeather"
    Folder.Parent = workspace
    local Anchor = NewInstance("Part")
    Anchor.Name = "BeamAnchor"
    Anchor.Anchored = true
    Anchor.CanCollide = false
    Anchor.CanTouch = false
    Anchor.CanQuery = false
    Anchor.CastShadow = false
    Anchor.Transparency = 1
    Anchor.Size = NewVector3(0.05, 0.05, 0.05)
    Anchor.CFrame = NewCFrame()
    Anchor.Parent = Folder
    WorldEffectsState.Folder = Folder
    WorldEffectsState.Anchor = Anchor WorldEffectsState.SpawnAccumulator = 0
    WorldEffectsState.StepAccumulator = 0
    WorldEffectsState.WeatherActive = 0
    WorldEffectsState.SplashActive = 0
    WorldEffectsState.Connection = RunService.Heartbeat:Connect(function(DeltaTime)
        if Generation ~= WorldEffectsState.Generation or not WorldEffectsState.Enabled or not Folder.Parent or not Anchor.Parent then return end
        WorldEffectsState.StepAccumulator += Min(Max(DeltaTime, 0), 0.1)
        local FixedStep = 1 / Max(tonumber(WorldEffectsState.UpdateRate) or 30, 15)
        if WorldEffectsState.StepAccumulator < FixedStep then return end
        local Step = Min(WorldEffectsState.StepAccumulator, FixedStep * 2)
        WorldEffectsState.StepAccumulator = 0
        local CurrentCamera = Workspace.CurrentCamera if not CurrentCamera then return end
        local CameraPosition = CurrentCamera.CFrame.Position local Profile = GetWorldEffectProfile()
        local Effect = Profile.Effect
        local Rate = Profile.Rate
        local ActiveLimit = Profile.ActiveLimit
        WorldEffectsState.SpawnAccumulator += Step * Rate
        local SpawnCount = Min(Floor(WorldEffectsState.SpawnAccumulator), 3)
        WorldEffectsState.SpawnAccumulator -= SpawnCount
        for _ = 1, SpawnCount do
            if (WorldEffectsState.WeatherActive or 0) >= ActiveLimit then break end
            Shared.SpawnWorldBeam(CurrentCamera)
        end
        local MaximumDistance = Max((tonumber(WorldEffectsState.Radius) or 65) * 2.4, 150) local MaximumDistanceSquared = MaximumDistance * MaximumDistance
        for Index = #WorldEffectsState.Active, 1, -1 do
            local Node = WorldEffectsState.Active[Index] local Expired = UpdateWorldBeamNode(Node, Step, CurrentCamera, CameraPosition)
            if not Expired and Node.Effect ~= "RainSplash" and Node.Effect ~= "RainSplashDrop" then
                local Offset = Node.Position - CameraPosition
                if Offset:Dot(Offset) > MaximumDistanceSquared then Expired = true end
            end
            if Expired then
                if Node.Effect == "Rain" and Node.ImpactPosition and (WorldEffectsState.SplashActive or 0) < Max((WorldEffectsState.SplashLimit or 24) - 3, 0) then
                    Shared.SpawnWorldBeamSplash(Node.ImpactPosition, Node.ImpactNormal, Node.Velocity, CurrentCamera)
                end
                local LastIndex = #WorldEffectsState.Active
                WorldEffectsState.Active[Index] = WorldEffectsState.Active[LastIndex]
                WorldEffectsState.Active[LastIndex] = nil
                Shared.ReleaseWorldBeamNode(Node)
            end
        end
    end)
end
