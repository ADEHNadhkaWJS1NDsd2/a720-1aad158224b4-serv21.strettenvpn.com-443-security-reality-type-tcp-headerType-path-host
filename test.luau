function GrenadeTrajectoryGetAimPoint(CameraObject, Character, Tool)
    CameraObject = CameraObject or Workspace.CurrentCamera
    if not CameraObject then
        return nil
    end
    Character = Character or LocalPlayer.Character
    local Head = Character and Character:FindFirstChild("Head")
    local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
    local FirstPerson = Head and (CameraObject.CFrame.Position - Head.Position).Magnitude <= 1.35 or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
    if not FirstPerson then
        local Handle = GrenadeTrajectoryGetHandle(Tool)
        local StartPosition = Handle and Handle.Position or RootPart and RootPart.Position or CameraObject.CFrame.Position
        local LookVector = RootPart and RootPart.CFrame.LookVector or CameraObject.CFrame.LookVector
        local Horizontal = NewVector3(LookVector.X, 0, LookVector.Z)
        if Horizontal.Magnitude <= 0.001 then Horizontal = NewVector3(CameraObject.CFrame.LookVector.X, 0, CameraObject.CFrame.LookVector.Z) end
        if Horizontal.Magnitude <= 0.001 then
            return StartPosition + NewVector3(0, 0, -1800)
        end
        return StartPosition + Horizontal.Unit * 1800
    end
    local Viewport = CameraObject.ViewportSize
    local Ray = CameraObject:ViewportPointToRay(Viewport.X * 0.5, Viewport.Y * 0.5)
    local Parameters = NewRaycastParams()
    Parameters.FilterType = Enum.RaycastFilterType.Exclude
    Parameters.IgnoreWater = false
    Parameters.RespectCanCollide = false
    local Ignore = {}
    if Character then Ignore[#Ignore + 1] = Character end
    if Tool then Ignore[#Ignore + 1] = Tool end
    Ignore[#Ignore + 1] = CameraObject
    Parameters.FilterDescendantsInstances = Ignore
    local Distance = 1800
    local Result = Workspace:Raycast(Ray.Origin, Ray.Direction * Distance, Parameters)
    if Result and typeof(Result.Position) == "Vector3" then
        return Result.Position
    end
    return Ray.Origin + Ray.Direction * Distance
end
function GrenadeTrajectoryGetPhysics(Part)
    if not Part or not Part:IsA("BasePart") then return nil end
    local Success, Properties = Shared.SafeCall(function() return Part.CurrentPhysicalProperties end)
    if Success and Properties then return Properties end
    return Part.CustomPhysicalProperties
end
function GrenadeTrajectoryGetProfile(Tool)
    local Profile = {ThrowSpeed = GrenadeTrajectoryState.ThrowSpeed,
        PredictionTime = GrenadeTrajectoryState.PredictionTime, GravityScale = GrenadeTrajectoryState.GravityScale, Friction = nil, FrictionWeight = nil,
        Elasticity = nil, ElasticityWeight = nil}
    if not Tool then return Profile end
    local Config = Tool:FindFirstChild("Config")
    if Config and Config:IsA("ModuleScript") then
        local Success, Settings = Shared.SafeCall(require, Config)
        if Success and type(Settings) == "table" then
            local Velocity = tonumber(Settings.VELOCITY or Settings.Velocity or Settings.ThrowVelocity or Settings.ThrowSpeed or Settings.ProjectileSpeed)
            local ExplodeTime = tonumber(Settings.ExplodeTime or Settings.FuseTime or Settings.Fuse or Settings.Timer)
            local GravityScale = tonumber(Settings.GravityScale or Settings.ProjectileGravityScale)
            local Gravity = tonumber(Settings.Gravity or Settings.ProjectileGravity)
            local Friction = tonumber(Settings.Friction or Settings.ProjectileFriction)
            local Elasticity = tonumber(Settings.Elasticity or Settings.Restitution or Settings.Bounce)
            if Velocity and Velocity > 0 then Profile.ThrowSpeed = Clamp(Velocity, 20, 450) end
            if ExplodeTime and ExplodeTime > 0 then Profile.PredictionTime = Clamp(ExplodeTime, 0.05, 8) end
            if GravityScale and GravityScale > 0 then
                Profile.GravityScale = Clamp(GravityScale, 0.05, 2)
            elseif Gravity and Gravity > 0 then
                Profile.GravityScale = Clamp(Gravity <= 5 and Gravity or Gravity / Max(Workspace.Gravity, 0.001), 0.05, 2)
            end
            if Friction then Profile.Friction = Clamp(Friction, 0, 2) end
            if Elasticity then Profile.Elasticity = Clamp(Elasticity, 0, 1) end
        end
    end
    local Values = Tool:FindFirstChild("Values")
    if Values then
        for _, Name in next, {"Velocity", "ThrowSpeed", "Speed", "ProjectileSpeed"} do
            local Object = Values:FindFirstChild(Name)
            if Object and (Object:IsA("NumberValue") or Object:IsA("IntValue")) and Object.Value > 0 then
                Profile.ThrowSpeed = Clamp(Object.Value, 20, 450)
                break
            end
        end
        for _, Name in next, {"Fuse", "FuseTime", "ExplodeTime", "Timer"} do
            local Object = Values:FindFirstChild(Name)
            if Object and (Object:IsA("NumberValue") or Object:IsA("IntValue")) and Object.Value > 0 then
                Profile.PredictionTime = Clamp(Object.Value, 0.05, 8)
                break
            end
        end
    end
    local Pin = Tool:FindFirstChild("PinPulled")
    local Timer = Pin and Pin:FindFirstChild("Timer")
    if Timer and (Timer:IsA("NumberValue") or Timer:IsA("IntValue")) and Timer.Value > 0 then Profile.PredictionTime = Clamp(Timer.Value, 0.05, 8) end
    local CollisionPart = GrenadeTrajectoryGetCollisionPart(Tool)
    local Properties = GrenadeTrajectoryGetPhysics(CollisionPart)
    if Properties then
        Profile.Friction = Profile.Friction or Properties.Friction
        Profile.FrictionWeight = Properties.FrictionWeight
        Profile.Elasticity = Profile.Elasticity or Properties.Elasticity
        Profile.ElasticityWeight = Properties.ElasticityWeight
    end
    local Observed = GrenadeTrajectoryState.ObservedProfiles[Lower(Tool.Name)]
    if type(Observed) == "table" and Clock() - (tonumber(Observed.Time) or 0) <= 180 and tonumber(Observed.Speed) then
        Profile.ThrowSpeed = Clamp(tonumber(Observed.Speed), 20, 450)
    end
    return Profile
end
