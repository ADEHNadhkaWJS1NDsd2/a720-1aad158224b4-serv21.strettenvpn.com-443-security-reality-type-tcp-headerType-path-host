function IsPlayerESPAnimationActive(Data)
    if Visuals.Player.Prediction.Enabled == true then return true end
    local Gradient = Visuals.Player.BoxGradient
    if Gradient and Gradient.Enabled == true and Gradient.Animated == true then return true end
    local Glow = Visuals.Player.BoxGlow
    if Glow and Glow.Enabled == true and Glow.Pulse == true then return true end
    local Health = Visuals.Player.Health
    local Humanoid = Data and Data.Humanoid
    if Humanoid and (Visuals.Player.HealthBar == true or Visuals.Player.HealthText == true) then
        local Target = Clamp(Humanoid.Health / Max(Humanoid.MaxHealth, 1), 0, 1)
        local Displayed = tonumber(Data.DisplayedHealthPercent)
