function ScoreCameraViewModelCandidate(Object)
    if not Object or not Object.Parent or (not Object:IsA("Model") and not Object:IsA("Folder")) then return -Infinite end
    local Name = Lower(tostring(Object.Name))
    local Score = 0
    if Name == "viewmodel" or Name == "view model" then
        Score += 100
    elseif Name == "arms" or Name == "armmodel" or Name == "viewarms" then
        Score += 78
    elseif Name:find("viewmodel", 1, true) then
        Score += 72
    elseif Name:find("arms", 1, true) then
        Score += 48
    end
    local BasePartCount = 0 local ArmCount = 0 local HolderCount = 0 local WeaponLikeCount = 0
    for _, Descendant in ipairs(Object:GetDescendants()) do
        if Descendant:IsA("BasePart") then
            BasePartCount += 1
            local DescendantName = Lower(Descendant.Name)
            if DescendantName == "right arm" or DescendantName == "left arm" or DescendantName == "rightarm" or DescendantName == "leftarm" then ArmCount += 1 end
            if DescendantName == "rarmholder" or DescendantName == "larmholder" then HolderCount += 1 end
            if DescendantName:find("handle", 1, true) or DescendantName:find("receiver", 1, true) or DescendantName:find("barrel", 1, true)
                or DescendantName:find("slide", 1, true) or DescendantName:find("mag", 1, true) then
                WeaponLikeCount += 1
            end
        end
    end
    Score += Min(BasePartCount, 18) * 0.75
    Score += ArmCount * 12 + HolderCount * 14 + Min(WeaponLikeCount, 8) * 2.5
    if ArmCount == 0 and HolderCount == 0 and WeaponLikeCount == 0 and Score < 60 then return -Infinite end
    return Score
end
function GetArmsViewModel()
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return nil end
    local Direct = CameraObject:FindFirstChild("ViewModel") or CameraObject:FindFirstChild("viewmodel") or CameraObject:FindFirstChild("Viewmodel")
    if Direct and (Direct:IsA("Model") or Direct:IsA("Folder")) then return Direct end
    local Best = nil local BestScore = -Infinite
    for _, Object in ipairs(CameraObject:GetChildren()) do
        if Object ~= LocalPlayer.Character and (Object:IsA("Model") or Object:IsA("Folder")) then
            local Score = ScoreCameraViewModelCandidate(Object)
            if Score > BestScore then
                BestScore = Score
                Best = Object
            end
        end
    end
    if Best and BestScore >= 48 then return Best end
    return nil
end
function IsViewModelFirstPerson()
    local CameraObject = Shared.GetCamera()
    if not CameraObject then return false end
    if LocalPlayer.CameraMode == Enum.CameraMode.LockFirstPerson then return true end
    local Character = LocalPlayer.Character local Head = Character and Character:FindFirstChild("Head")
    if Head and Head:IsA("BasePart") then
        local HeadDistance = (CameraObject.CFrame.Position - Head.Position).Magnitude
        if HeadDistance <= 1.65 then return true end
    end
    local FocusDistance = (CameraObject.CFrame.Position - CameraObject.Focus.Position).Magnitude
    return FocusDistance <= 1.25
end

function NormalizeChamsPerspective(Value)
    local Output = {}
    local Seen = {}
    local function Add(Name)
        Name = tostring(Name or "")
        if Name ~= "First Person" and Name ~= "Third Person" then
            return
        end
        if Seen[Name] then
            return
        end
        Seen[Name] = true
        Output[#Output + 1] = Name
    end
    if type(Value) == "string" then
        Add(Value)
    elseif type(Value) == "table" then
        for Index = 1, #Value do
            Add(Value[Index])
        end
        for Name, Enabled in pairs(Value) do
            if type(Name) == "string" and Enabled == true then Add(Name) end
        end
    end
    if #Output == 0 then
        Output[1] = "First Person"
        Output[2] = "Third Person"
    end
    return Output
end

function ChamsPerspectiveAllows(Settings, FirstPerson)
    if type(Settings) ~= "table" then
        return true
    end
    local Selected = NormalizeChamsPerspective(Settings.Perspective)
    Settings.Perspective = Selected
    local Wanted = FirstPerson and "First Person" or "Third Person"
    for Index = 1, #Selected do
        if Selected[Index] == Wanted then
            return true
        end
    end
    return false
end

ArmsChamsSettings.Perspective = NormalizeChamsPerspective(ArmsChamsSettings.Perspective)

WeaponChamsSettings.Perspective = NormalizeChamsPerspective(WeaponChamsSettings.Perspective)
function IsViewModelArmPart(Part)
    if not Part or not Part:IsA("BasePart") then return false end
    local Name = Part.Name
    return Name == "Right Arm" or Name == "Left Arm" or Name == "RightArm" or Name == "LeftArm"
end
function IsViewModelExcludedPart(Part, ViewModel)
    if not Part or not Part:IsA("BasePart") then return true end
    local Name = Part.Name
    if Name == "HumanoidRootPart" or Name == "RArmHolder" or Name == "LArmHolder" then return true end
    local Parent = Part.Parent
    while Parent and Parent ~= ViewModel do
        local ParentName = Parent.Name
        if ParentName == "RArmHolder" or ParentName == "LArmHolder" then return true end
        Parent = Parent.Parent
    end
    return false
end
function IsViewModelWeaponPart(Part, ViewModel)
    return Part and Part:IsA("BasePart") and not IsViewModelArmPart(Part) and not IsViewModelExcludedPart(Part, ViewModel)
end
function IsThirdPersonArmPart(Part)
    if not Part or not Part:IsA("BasePart") then return false end
    local Name = Part.Name
    return Name == "Right Arm" or Name == "Left Arm" or Name == "RightArm" or Name == "LeftArm" or Name == "RightUpperArm" or Name == "RightLowerArm" or Name == "RightHand"
        or Name == "LeftUpperArm" or Name == "LeftLowerArm" or Name == "LeftHand"
end
function IsThirdPersonWeaponPart(Part, Character)
    if not Part or not Part:IsA("BasePart") or not Character then return false end
    local Tool = Part:FindFirstAncestorOfClass("Tool")
    return Tool ~= nil and Tool.Parent == Character
end
function StoreViewModelPartOriginal(Part)
    if not Part or not Part:IsA("BasePart") or ViewModelChamsRuntime.Original[Part] then return end
    ViewModelChamsRuntime.Original[Part] = {Color = Part.Color, Material = Part.Material, MaterialVariant = Part.MaterialVariant, Reflectance = Part.Reflectance,
        Transparency = Part.Transparency, LocalTransparencyModifier = Part.LocalTransparencyModifier, UsePartColor = Part:IsA("UnionOperation") and Part.UsePartColor or nil}
end
function DestroyViewModelHighlight(Part)
    local Highlight = ViewModelChamsRuntime.Highlights[Part]
    if Highlight and Highlight.Parent then Highlight:Destroy() end
    ViewModelChamsRuntime.Highlights[Part] = nil
end
function RestoreViewModelPart(Part)
    local Original = ViewModelChamsRuntime.Original[Part]
    if Original and Part and Part.Parent then
        Part.Color = Original.Color
        Part.Material = Original.Material
        Part.MaterialVariant = Original.MaterialVariant or ""
        Part.Reflectance = Original.Reflectance
        Part.Transparency = Original.Transparency
        Part.LocalTransparencyModifier = Original.LocalTransparencyModifier
        if Part:IsA("UnionOperation") and Original.UsePartColor ~= nil then Part.UsePartColor = Original.UsePartColor end
    end
    DestroyViewModelHighlight(Part)
    ViewModelChamsRuntime.Original[Part] = nil
    ViewModelChamsRuntime.Categories[Part] = nil
end
function RestoreViewModelChams(Category)
    local Parts = {}
    for Part, CurrentCategory in pairs(ViewModelChamsRuntime.Categories) do
        if not Category or CurrentCategory == Category then Parts[#Parts + 1] = Part end
    end
    for Index = 1, #Parts do RestoreViewModelPart(Parts[Index]) end
    if not Category then ViewModelChamsRuntime.ViewModel = nil end
end
function EnsureViewModelHighlight(Part)
    local Highlight = ViewModelChamsRuntime.Highlights[Part]
    if Highlight and Highlight.Parent and Highlight.Adornee == Part then return Highlight end
    if Highlight and Highlight.Parent then Highlight:Destroy() end
    Highlight = NewInstance("Highlight")
    Highlight.Name = "AtramentaViewModelHighlight"
    Highlight:SetAttribute("AtramentaVisualLayer", true)
    Highlight.Adornee = Part
    Highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    Highlight.FillTransparency = 1
    Highlight.OutlineTransparency = 1
    Highlight.Enabled = false
    Highlight.Parent = Part
    ViewModelChamsRuntime.Highlights[Part] = Highlight
    return Highlight
end
function ResolveViewModelChamMaterial(Settings, Original)
    local Name = tostring(Settings and Settings.Material or "Neon")
    if Name == "Original" then return Original and Original.Material or Enum.Material.Plastic, true end
    return ViewModelChamsMaterials[Name] or Enum.Material.Neon, false
end
function ApplyViewModelChamPart(Part, ViewModel, Category, Settings)
    if not Part or not Part.Parent or type(Settings) ~= "table" then return end
    StoreViewModelPartOriginal(Part)
    local Original = ViewModelChamsRuntime.Original[Part]
    if type(Original) ~= "table" then return end
    ViewModelChamsRuntime.Categories[Part] = Category
    local Color = typeof(Settings.Color) == "Color3" and Settings.Color or NewRGB(0, 255, 255)
    local Transparency = Clamp(tonumber(Settings.Transparency) or 0.18, 0, 0.95)
    local Material, OriginalMaterial = ResolveViewModelChamMaterial(Settings, Original)
    Part.LocalTransparencyModifier = 0
    Part.Color = Color
    Part.Material = Material
    Part.MaterialVariant = OriginalMaterial and (Original.MaterialVariant or "") or ""
    Part.Reflectance = OriginalMaterial and (tonumber(Original.Reflectance) or 0) or 0
    if Part:IsA("UnionOperation") then Part.UsePartColor = true end
    Part.Transparency = (tonumber(Original.Transparency) or 0) >= 0.995 and Original.Transparency or Transparency
    local FillEnabled = Settings.FillEnabled == true
    local GlowEnabled = Settings.GlowEnabled == true
    local Highlight = EnsureViewModelHighlight(Part)
    Highlight.FillColor = Color
    Highlight.OutlineColor = Color
    Highlight.FillTransparency = FillEnabled and Clamp(tonumber(Settings.FillTransparency) or 0.74, 0, 1) or 1
    if GlowEnabled then
        local Strength = Clamp(tonumber(Settings.GlowStrength) or 1, 0.2, 2.5)
        Highlight.OutlineTransparency = Clamp(0.58 - Strength * 0.20, 0.06, 0.54)
    else
        Highlight.OutlineTransparency = 1
    end
    Highlight.Enabled = (tonumber(Original.Transparency) or 0) < 0.995 and (FillEnabled or GlowEnabled)
end
function SuspendViewModelArms() RestoreViewModelChams("Arms") end
function UpdateViewModelChams()
    local Runtime = ViewModelChamsRuntime
    local FirstPerson = IsViewModelFirstPerson()
    Runtime.LastFirstPerson = FirstPerson
    local ArmsAllowed = ArmsChamsEnabled == true and ChamsPerspectiveAllows(ArmsChamsSettings, FirstPerson)
    local WeaponAllowed = WeaponChamsEnabled == true and ChamsPerspectiveAllows(WeaponChamsSettings, FirstPerson)
    if not ArmsAllowed then RestoreViewModelChams("Arms") end
    if not WeaponAllowed then RestoreViewModelChams("Weapon") end
    if not ArmsAllowed and not WeaponAllowed then
        Runtime.ViewModel = nil
        return
    end
    local Root = FirstPerson and GetArmsViewModel() or LocalPlayer.Character
    if not Root or not Root.Parent then
        if Runtime.ViewModel then RestoreViewModelChams() end
        Runtime.ViewModel = nil
        return
    end
    if Runtime.ViewModel ~= Root then
        RestoreViewModelChams()
        Runtime.ViewModel = Root
    end
    local Active = setmetatable({}, {__mode = "k"})
    for _, Part in ipairs(Root:GetDescendants()) do
        if Part:IsA("BasePart") then
            local Category, Settings
            if FirstPerson then
                if ArmsAllowed and IsViewModelArmPart(Part) then
                    Category, Settings = "Arms", ArmsChamsSettings
                elseif WeaponAllowed and IsViewModelWeaponPart(Part, Root) then
                    Category, Settings = "Weapon", WeaponChamsSettings
                end
            else
                if ArmsAllowed and IsThirdPersonArmPart(Part) and not Part:FindFirstAncestorOfClass("Tool") then
                    Category, Settings = "Arms", ArmsChamsSettings
                elseif WeaponAllowed and IsThirdPersonWeaponPart(Part, Root) then
                    Category, Settings = "Weapon", WeaponChamsSettings
                end
            end
            if Category then
                ApplyViewModelChamPart(Part, Root, Category, Settings)
                Active[Part] = true
            end
        end
    end
    local Stale = {}
    for Part in pairs(Runtime.Categories) do
        if not Active[Part] or not Part or not Part.Parent or not Part:IsDescendantOf(Root) then Stale[#Stale + 1] = Part end
    end
    for Index = 1, #Stale do RestoreViewModelPart(Stale[Index]) end
end
function EnsureViewModelChamsRender()
    local Enabled = ArmsChamsEnabled or WeaponChamsEnabled
    local RenderName = ViewModelChamsRuntime.RenderName
    if not Enabled then
        if RenderName then Shared.SafeCall(function() RunService:UnbindFromRenderStep(RenderName) end) end
        ViewModelChamsRuntime.RenderName = nil
        ViewModelChamsRuntime.LastFirstPerson = nil
        RestoreViewModelChams()
        return
    end
    if RenderName then return end
    RenderName = "AtramentaViewModelChams_" .. tostring(LocalPlayer.UserId)
    ViewModelChamsRuntime.RenderName = RenderName
    Shared.SafeCall(function() RunService:UnbindFromRenderStep(RenderName) end)
    RunService:BindToRenderStep(RenderName, Enum.RenderPriority.Last.Value + 240, function()
        if not ArmsChamsEnabled and not WeaponChamsEnabled then return end
        Shared.SafeCall(UpdateViewModelChams)
    end)
end
